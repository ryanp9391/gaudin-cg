{
 "cells": [
  {
   "kind": 2,
   "value": "(*build representations of gl(n)*)\nps[rep_] :=\n    ps[rep] =\n    Block[\n        {res = (Prepend[rep, #]& /@ (Tuples[Table[Range[rep〚1, i + 1〛, rep〚1, i〛], {i, 1, Length[rep〚1〛] - 1}]]))},\n        If[Length[res〚1, 1〛] == 1, Reverse @ Sort @ res, Reverse @ Sort @ Flatten[ps /@ res, 1]]\n    ];\ndim[rep_] := dim[rep] = Length[ps[{rep}]];\nJ0[k_][pat_] := J0[k][pat] = Sum[pat〚k, i〛, {i, 1, k}] - Sum[pat〚k - 1, i〛, {i, 1, k - 1}];\nJp[k_][pat_] :=\n    Jp[k][pat] =\n    -Sum[\n        Product[pat〚k, i〛 - i - pat〚k + 1, j〛 + j, {j, Range[k + 1]}]\n        / Product[pat〚k, i〛 - i - pat〚k, j〛 + j, {j, Complement[Range[k], {i}]}] v[ReplacePart[pat, {k, i} → pat〚k, i〛 + 1]],\n        {i, 1, k}\n    ];\nJm[k_][pat_] :=\n    Jm[k][pat] =\n    Sum[\n        Product[pat〚k, i〛 - i - pat〚k - 1, j〛 + j, {j, Range[k - 1]}]\n        / Product[pat〚k, i〛 - i - pat〚k, j〛 + j, {j, Complement[Range[k], {i}]}] v[ReplacePart[pat, {k, i} → pat〚k, i〛 - 1]],\n        {i, 1, k}\n    ];\nJJ[k_, l_, rep_] :=\n    JJ[k, l, rep] =\n    Which[\n        k == l,\n        DiagonalMatrix[J0[k] /@ ps[{rep}]],\n        l == k + 1,\n        Transpose[Table[Coefficient[Jp[k][ps[{rep}]〚i〛], v[#]]& /@ ps[{rep}], {i, 1, Length[ps[{rep}]]}]],\n        l == k - 1,\n        Transpose[Table[Coefficient[Jm[l][ps[{rep}]〚i〛], v[#]]& /@ ps[{rep}], {i, 1, Length[ps[{rep}]]}]],\n        l > k + 1,\n        JJ[k, k + 1, rep].JJ[k + 1, l, rep] - JJ[k + 1, l, rep].JJ[k, k + 1, rep],\n        l < k - 1,\n        JJ[k, k - 1, rep].JJ[k - 1, l, rep] - JJ[k - 1, l, rep].JJ[k, k - 1, rep]\n    ];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*representations on sites 1 and 2*)\nClearAll[Lam];\nLam[1] = {1, 0};\nLam[2] = {1, 0};\nLam[3] = {1, 0};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Ee, LL, nu];\n\n(*Local Lie algebra generators on site n*)\nEe[n_][{i_, j_}] := Ee[n][{i, j}] = JJ[i, j, Lam[n]];\n\n(*Local Lax matrix on site n*)\nLL[n_][{i_, j_}][u_] := LL[n][{i, j}][u] = u IdentityMatrix[dim[Lam[n]]] KroneckerDelta[i, j] - h Ee[n][{j, i}];\n\n(*first Yangian weight*)\nnu[1][u_] = (u - w[1] - h Lam[1]〚1〛) (u - w[2] - h Lam[2]〚1〛) (u - w[3] - h Lam[3]〚1〛);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[G, T, Tt];\n\n(*twist matrix*)\nG = {{z[1] + z[2], -z[1] z[2]}, {1, 0}};\n\n(*monodromy matrix - polynomial*)\nT[{i_, j_}][u_] := T[{i, j}][u] = Sum[KroneckerProduct[LL[1][{i, k}][u - w[1]], LL[2][{k, l}][u - w[2]], LL[3][{l, j}][u - w[3]]], {k, 2}, {l, 2}];\n\n(*monodromy matrix normalized by first Yangian weight*)\nTt[{i_, j_}][u_] := Tt[{i, j}][u] = T[{i, j}][u] / nu[1][u];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[t];\n(*t[{a,s}] corresponds to transfer matrix with a rows and s columns*)\n\nt[{1, 0}][u_] = IdentityMatrix[dim[Lam[1]] dim[Lam[2]] dim[Lam[3]]];\nt[{1, 1}][u_] = (z[1] + z[2]) Tt[{1, 1}][u] - z[1] z[2] Tt[{2, 1}][u] + Tt[{1, 2}][u];\nt[{2, 1}][u_] = z[1] z[2] (Tt[{1, 1}][u].Tt[{2, 2}][u - h] - Tt[{2, 1}][u].Tt[{1, 2}][u - h]);\n\n(*building transfer matrices in higher reps by fusion*)\nt[{1, s_ /; s >= 2}][u_] = t[{1, s - 1}][u].t[{1, 1}][u + (s - 1) h] - t[{2, 1}][u + (s - 1) h].t[{1, s - 2}][u];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "vac[n_] := {Table[KroneckerDelta[i, dim[Lam[n]]], {i, dim[Lam[n]]}]};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "vac[2]",
   "languageId": "wolfram",
