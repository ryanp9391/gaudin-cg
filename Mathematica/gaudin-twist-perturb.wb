      {
       "data": "Out[55]= \\begin{pmatrix}0 & 2 & 3 & 5\\\\\\left\\{1\\right\\} & \\left\\{0,-1,1\\right\\} & \\left\\{0,0,0,1\\right\\} & \\left\\{0,0,0,0,-\\frac{5}{2},1\\right\\}\\end{pmatrix}",
