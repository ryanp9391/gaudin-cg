  {
   "kind": 2,
   "value": "(* Numeric-psi version of the exact solve: substituting psi BEFORE Solve makes the nonlinear\n   system tractable (the fully symbolic version blows up past the smallest reps). *)\nClearAll[MatteoSolveNum];\n\nMatteoSolveNum[SS_, PP_, mu_, psiv_] := Module[{Ms, op, eqs, unk, sol, pf, resid},\n   Ms = SS + PP - mu;\n   op = (BaxTw[{SS, SS, 0, 0}, {PP, PP, 0, 0}, mu] /. wsub) /. psiv;\n   eqs = {};\n   Do[pf[x_] := Evaluate[x^Ms[[k]] + Sum[cc[k, j] x^j, {j, 0, Ms[[k]] - 1}]];\n      resid = Expand[Cancel[Together[z^4 (z - 1)^4 conjResid[op, -eps (psi[k] /. psiv), pf]]]];\n      eqs = Join[eqs, DeleteCases[Expand[CoefficientList[resid, z]], 0]], {k, 4}];\n   unk = Join[Flatten[Table[cc[k, j], {k, 4}, {j, 0, Ms[[k]] - 1}]], hUnknowns];\n   sol = Solve[Thread[eqs == 0], unk];\n   {Ms, Length[sol], sol}];\n\npsiv = {psi[1] -> 1, psi[2] -> 1/3, psi[3] -> 1/5, psi[4] -> 1/7};\nAbsoluteTiming[exNum = MatteoSolveNum[2, 1, {3, 2, 1, 0}, psiv];]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"698091\" data-output-id=\"11\" data-out-n=\"147\" data-sub-idx=\"4\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"19\" data-sub-start=\"16\" data-sub-end=\"16\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[147]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"XGxlZnRcezAuMzczNzUyLFxtYXRocm17TnVsbH1ccmlnaHRcfQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0.373752</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">Null</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span></span></div></div></div>",
