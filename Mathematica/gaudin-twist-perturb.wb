pan class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.95em;\"><span></span></span></span></span></span><span class=\"mclose\"><span class=\"delimsizing mult\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.45em;\"><span style=\"top:-1.366em;\"><span class=\"pstrut\" style=\"height:4.416em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎭</span></span></span><span style=\"top:-1.358em;\"><span class=\"pstrut\" style=\"height:4.416em;\"></span><span style=\"height:2.416em;width:0.8889em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.8889em\" height=\"2.416em\" style=\"width:0.8889em\" viewBox=\"0 0 888.89 2416\" preserveAspectRatio=\"xMinYMin\"><path d=\"M384 0 H504 V2416 H384z M384 0 H504 V2416 H384z\"/></svg></span></span><span style=\"top:-4.416em;\"><span class=\"pstrut\" style=\"height:4.416em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎬</span></span></span><span style=\"top:-5.558em;\"><span class=\"pstrut\" style=\"height:4.416em;\"></span><span style=\"height:2.416em;width:0.8889em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.8889em\" height=\"2.416em\" style=\"width:0.8889em\" viewBox=\"0 0 888.89 2416\" preserveAspectRatio=\"xMinYMin\"><path d=\"M384 0 H504 V2416 H384z M384 0 H504 V2416 H384z\"/></svg></span></span><span style=\"top:-7.966em;\"><span class=\"pstrut\" style=\"height:4.416em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎫</span></span></span></s