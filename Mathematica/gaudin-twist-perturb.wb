      {
       "data": "Out[143]= \\begin{aligned}\n  &\\left\\{\\begin{array}{|c|c|c|c|c|}\\hline\\text{mu} & \\text{dim} & \\text{deg Q} & \\text{time (s)} & \\text{ok?}\\\\\\hline2,2,0,0 & 20 & 0,1,4,5 & \\text{2.190} & \\mathrm{True}\\\\\\hline2,1,1,0 & 15 & 0,2,3,5 & \\text{1.670} & \\mathrm{True}\\\\\\hline1,1,1,1 & 1 & 1,2,3,4 & \\text{1.519} & \\mathrm{True}\\\\\\hline\\end{array} \\right. \\\\\n  &\\left. ,\\begin{array}{|c|c|c|c|c|}\\hline\\text{mu} & \\text{dim} & \\text{deg Q} & \\text{time (s)} & \\text{ok?}\\\\\\hline3,3,0,0 & 50 & 0,1,5,6 & \\text{2.348} & \\mathrm{True}\\\\\\hline3,2,1,0 & 64 & 0,2,4,6 & \\text{2.182} & \\mathrm{False}\\\\\\hline2,2,1,1 & 6 & 1,2,4,5 & \\text{2.276} & \\mathrm{True}\\\\\\hline\\end{array} \\right. \\\\\n  &\\left. ,\\begin{array}{|c|c|c|c|c|}\\hline\\text{mu} & \\text{dim} & \\text{deg Q} & \\text{time (s)} & \\text{ok?}\\\\\\hline3,3,0,0 & 50 & 0,1,5,6 & \\text{2.413} & \\mathrm{True}\\\\\\hline3,2,1,0 & 64 & 0,2,4,6 & \\text{2.541} & \\mathrm{False}\\\\\\hline2,2,1,1 & 6 & 1,2,4,5 & \\text{2.676} & \\mathrm{True}\\\\\\hline\\end{array} \\right. \\\\\n  &\\left. ,\\begin{array}{|c|c|c|c|c|}\\hline\\text{mu} & \\text{dim} & \\text{deg Q} & \\text{time (s)} & \\text{ok?}\\\\\\hline4,4,0,0 & 105 & 0,1,6,7 & \\text{3.003} & \\mathrm{True}\\\\\\hline4,3,1,0 & 175 & 0,2,5,7 & \\tex… [latex truncated: 1509 chars total]",
