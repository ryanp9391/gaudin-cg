      {
       "data": "Out[199]= \\mathrm{OrthogRen}\\left[\\left\\{\\mathrm{e}^z\\,\\left(-\\frac{4213}{36}+\\frac{4213\\,z}{72}-\\frac{71\\,z^2}{6}+z^3\\right),\\mathrm{e}^{z/2},\\mathrm{e}^{z/5}\\,\\left(\\frac{10}{3}+z\\right),\\mathrm{e}^{z/7}\\,\\left(\\frac{14}{5}+z\\right)\\right\\},\\left\\{\\mathrm{e}^{-z},\\mathrm{e}^{-z/2}\\,\\left(10-5\\,z+z^2\\right),\\mathrm{e}^{-z/5}\\,\\left(\\frac{4525}{96}-\\frac{905\\,z}{24}+\\frac{113\\,z^2}{12}+z^3\\right),\\mathrm{e}^{-z/7}\\,\\left(\\frac{35}{9}-\\frac{10\\,z}{3}+z^2\\right)\\right\\},\\left\\{\\mathrm{e}^z\\,\\left(-\\frac{4213}{36}+\\frac{4213\\,z}{72}-\\frac{71\\,z^2}{6}+z^3\\right),\\mathrm{e}^{z/2},\\mathrm{e}^{z/5}\\,\\left(\\frac{10}{3}+z\\right),\\mathrm{e}^{z/7}\\,\\left(\\frac{14}{5}+z\\right)\\right\\},\\left\\{\\mathrm{e}^{-z},\\mathrm{e}^{-z/2}\\,\\left(10-5\\,z+z^2\\right),\\mathrm{e}^{-z/5}\\,\\left(\\frac{4525}{96}-\\frac{905\\,z}{24}+\\frac{113\\,z^2}{12}+z^3\\right),\\mathrm{e}^{-z/7}\\,\\left(\\frac{35}{9}-\\frac{10\\,z}{3}+z^2\\right)\\right\\},\\left\\{2,1,1,0\\right\\},\\left\\{1,0,0,0\\right\\}\\right]",
       "mime": "text/plain"
