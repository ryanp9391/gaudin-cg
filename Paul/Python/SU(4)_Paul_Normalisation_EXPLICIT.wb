  {
   "kind": 2,
   "value": "ClearAll[QBase1,T];\nQBase1[T_][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QBase1[T][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]=\nQ1[T][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];",
