   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Hamiltonians",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## H1",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Regulated Hamiltonian $\\operatorname{tr}\\left(L\\right)$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[H1];\nH1[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=H1[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=Sum[LIndex[a,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{a,1,Ng}]//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Definition Residue of H",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH1];\nResH1[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_]:=ResH1[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,w]=SeriesCoefficient[H1[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,-1}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Example of use",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "H1[FUNDAMENTAL,FUNDAMENTAL,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## H2",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Regulated Hamiltonian $\\frac{3}{2}*\\operatorname{tr}\\left(L'\\right)+\\mathrm{trA}\\left(L^2\\right)$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Antisymm. def",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[trAL2];\ntrAL2[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trAL2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(2)*(Sum[LIndex[a,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[b,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex[b,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[a,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{a,1,Ng},{b,1,Ng}]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Def. H2",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[H2];\nH2[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=H2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(trAL2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+(3)/(2)*Sum[D[LIndex[a,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z],{a,1,Ng}])//Simplify",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Definition Residue of H",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH2];\nResH2[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_]:=ResH2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,w]=SeriesCoefficient[H2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,-1}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH2O];\nResH2O[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_,o_]:=ResH2O[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,w,o]=SeriesCoefficient[H2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,o}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Example of use",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "H2[FUNDAMENTAL,FUNDAMENTAL,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## H3",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### H3 Unsimplified",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Regulated Hamiltonian $\\mathrm{trA}\\left(L^3\\right)+\\frac{4}{3}\\mathrm{trA}\\left(L\\cdot L'\\right)+\\frac{1}{2}\\mathrm{trA}\\left(L'\\cdot L\\right)+\\operatorname{tr}\\left(L''\\right)$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Antisymm. def",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[trAL3];\ntrAL3[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trAL3[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(6)*Sum[LIndex[i1,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i2,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i3,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex[i1,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i3,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i2,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex[i2,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i1,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i3,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+LIndex[i2,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i3,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i1,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+LIndex[i3,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i1,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i2,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex[i3,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i2,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i1,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{i1,1,Ng},{i2,1,Ng},{i3,1,Ng}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[trALpL,trALLp];\ntrALLp[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trALLp[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(2)*(Sum[LIndex[a,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[b,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z]-LIndex[b,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[a,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z],{a,1,Ng},{b,1,Ng}]);\ntrALpL[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trALpL[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(2)*(Sum[D[LIndex[a,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[b,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-D[LIndex[b,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[a,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{a,1,Ng},{b,1,Ng}]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Def H3",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[H3U];\nH3U[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=H3U[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=trAL3[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+(4)/(3)*trALLp[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+(2)/(3)*trALpL[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+Sum[D[LIndex[a,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{z,2}],{a,1,Ng}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### H3 Simplified",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[H3];\nH3[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=H3[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=H3U[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Definition Residue of H",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH3];\nResH3[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_]:=ResH3[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,w]=SeriesCoefficient[H3[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,-1}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH3O];\nResH3O[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_,o_]:=ResH3O[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,w,o]=SeriesCoefficient[H3[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,o}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Example of use",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "H3[FUNDAMENTAL,FUNDAMENTAL,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal//Simplify",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
