  {
   "kind": 1,
   "value": "## Left eigenvectors (row)",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[VecL,VecL1];\nVecL[rep1_,rep2_]:=VecL[rep1,rep2]=Transpose[VecR[rep1,rep2]];\nVecL1[rep1_]:=VecL1[rep1]=Transpose[VecR1[rep1]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[EigenL];\nEigenL[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=EigenL[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]=Table[Quiet[Flatten[VecL[rep1,rep2]/.Solve[\nCoefficientList[((VecL[rep1,rep2].H2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-HSpectrum[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z][[idx]]* VecL[rep1,rep2]))//Together//Numerator,z]==0&&\nCoefficientList[((VecL[rep1,rep2].H3[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-HSpectrum[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z][[idx]]* VecL[rep1,rep2]))//Together//Numerator,z]==0&&\nCoefficientList[((VecL[rep1,rep2].H4[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-HSpectrum[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z][[idx]]* VecL[rep1,rep2]))//Together//Numerator,z]==0,Flatten[VecL[rep1,rep2]]],1]],{idx,1,Dimensions[HSpectrum[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]][[1]]}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
