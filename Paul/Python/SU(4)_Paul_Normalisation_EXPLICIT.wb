  {
   "kind": 2,
   "value": "ClearAll[QHBase1,T,U];\nQHBase1[T_][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QHBase1[T][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]=Table[Hodge1[{QBase1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][[U]]},rep1,ϕ1,ϕ2,ϕ3,ϕ4,z,T],{U,1,Length[QBase1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]]}];\n\n(*Q1†[T][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAllh1†[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h1[3,3]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1],h1[4,3]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1],h1[4,5]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1]];*)\n\n(*With Hodge*)\n(*Table[Hodge[{QBase1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][[U]]},rep1,ϕ1,ϕ2,ϕ3,ϕ4,z,T],{U,1,Length[QBase1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]]}];*)",
