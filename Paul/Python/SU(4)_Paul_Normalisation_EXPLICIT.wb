      {
       "data": "Out[147]= \\left\\{c1\\dag \\left[0\\right]\\to \\frac{1}{\\left(\\phi1-\\phi2\\right)^2\\,\\left(\\phi1-\\phi3\\right)^2\\,\\left(\\phi1-\\phi4\\right)^2}\\left(-2\\,\\left(\\phi1-\\phi2\\right)\\,\\left(\\phi1-\\phi3\\right)\\,\\left(\\phi1-\\phi4\\right)\\,\\left(3\\,\\phi1-\\phi2-\\phi3-\\phi4\\right)+\\left(\\phi1^3+\\phi1\\,\\phi3\\,\\left(-4+\\phi4\\right)-\\phi2\\,\\phi3\\,\\left(-2+\\phi4\\right)-4\\,\\phi1\\,\\phi4+2\\,\\phi2\\,\\phi4+2\\,\\phi3\\,\\phi4+\\phi1\\,\\phi2\\,\\left(-4+\\phi3+\\phi4\\right)-\\phi1^2\\,\\left(-6+\\phi2+\\phi3+\\phi4\\right)\\right)\\,\\left(3\\,\\phi1^2+\\phi3\\,\\phi4+\\phi2\\,\\left(\\phi3+\\phi4\\right)-2\\,\\phi1\\,\\left(\\phi2+\\phi3+\\phi4\\right)\\right)\\right),c1\\dag \\left[1\\right]\\to \\frac{-\\phi1^3+\\phi2\\,\\left(\\phi3\\,\\left(-2+\\phi4\\right)-2\\,\\phi4\\right)-2\\,\\phi3\\,\\phi4+\\phi1^2\\,\\left(-6+\\phi2+\\phi3+\\phi4\\right)-\\phi1\\,\\left(\\phi3\\,\\left(-4+\\phi4\\right)-4\\,\\phi4+\\phi2\\,\\left(-4+\\phi3+\\phi4\\right)\\right)}{\\left(\\phi1-\\phi2\\right)\\,\\left(\\phi1-\\phi3\\right)\\,\\left(\\phi1-\\phi4\\right)}\\right\\}",
