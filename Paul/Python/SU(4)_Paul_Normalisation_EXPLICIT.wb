  {
   "kind": 1,
   "value": "### Correct normalisation",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### β without fixing α",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[βrT,α12,α13,α14,α23,α24,α34,ϕ1,ϕ2,ϕ3,ϕ4];\nβrT[12][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[12][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=(α23 (ϕ1-ϕ4))/(α13 (ϕ2-ϕ4));\nβrT[13][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[13][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=((ϕ2-ϕ3) (ϕ1-ϕ4))/(α13 (ϕ1-ϕ2) (ϕ3-ϕ4));\nβrT[14][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[14][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=-((ϕ1-ϕ3) (ϕ2-ϕ4))/(α14 (ϕ1-ϕ2) (ϕ3-ϕ4));\nβrT[23][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[23][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=-((ϕ1-ϕ3) (ϕ2-ϕ4))/(α23 (ϕ1-ϕ2) (ϕ3-ϕ4));\nβrT[24][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[24][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=(α13 (ϕ1-ϕ3) (ϕ2-ϕ4))/(α14 α23 (ϕ1-ϕ2) (ϕ3-ϕ4));\nβrT[34][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[34][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=(α13 (ϕ2-ϕ4))/(α14 (-ϕ2+ϕ3));",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### fixing α",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[αr,α12,α13,α14,α23,α24,α34,ϕ1,ϕ2,ϕ3,ϕ4];\nαr[12][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=(α13 (-ϕ1+ϕ3))/(α23 (ϕ2-ϕ3));\nαr[24][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=(α14 α23 (ϕ2-ϕ3) (ϕ1-ϕ4))/(α13 (ϕ1-ϕ3) (ϕ2-ϕ4));\nαr[34][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=(α14 (ϕ1-ϕ4))/(α13 (ϕ1-ϕ3));",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### β with fixed α",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[βr,α12,α13,α14,α23,α24,α34,ϕ1,ϕ2,ϕ3,ϕ4];\nβr[12][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[12][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[13][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[13][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[13][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[14][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[14][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[14][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[23][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[23][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[23][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[24][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[24][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[34][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[34][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Renormalised eigenvectors",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ReEigenR1,ReEigenL1];\nReEigenR1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=ReEigenR1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=ReNormR1[rep1,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],#]&/@EigenR1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4];\nReEigenL1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=ReEigenL1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=ReNormL1[rep1,βr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[13][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[14][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[23][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],#]&/@EigenL1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
