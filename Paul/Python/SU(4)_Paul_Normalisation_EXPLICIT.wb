  {
   "kind": 2,
   "value": "(*L^3*)\nClearAll[trALLLp,trALLpL,trALpLL];\ntrALLLp[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trALLLp[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(6)*Sum[LIndex[i1,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i2,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i3,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z]-LIndex[i1,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i3,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i2,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z]-LIndex[i2,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i1,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i3,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z]+LIndex[i2,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i3,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i1,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z]+LIndex[i3,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i1,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i2,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z]-LIndex[i3,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i2,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i1,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z],{i1,1,Ng},{i2,1,Ng},{i3,1,Ng}];\n\ntrALLpL[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trALLpL[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(6)*Sum[LIndex[i1,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i2,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i3,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex[i1,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i3,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i2,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex[i2,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i1,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i3,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+LIndex[i2,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i3,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i1,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+LIndex[i3,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i1,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i2,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex[i3,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[i2,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i1,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{i1,1,Ng},{i2,1,Ng},{i3,1,Ng}];\n\ntrALpLL[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trALpLL[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(6)*Sum[D[LIndex[i1,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i2,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i3,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-D[LIndex[i1,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i3,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i2,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-D[LIndex[i2,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i1,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i3,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+D[LIndex[i2,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i3,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i1,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+D[LIndex[i3,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i1,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i2,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-D[LIndex[i3,i1,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex[i2,i2,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex[i1,i3,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{i1,1,Ng},{i2,1,Ng},{i3,1,Ng}];",
