      }
     ],
     "id": "nbimport-56"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "# RUN: CREATE BASIS",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Q Base",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Q Base given repAll",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[QBase,T];\nQBase[T_][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QBase[T][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]=\nQ[T][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,1,1];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Q Hodge Base",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Q Hodge Base given repAll",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[QHBase,T,U];\nQHBase[T_][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QHBase[T][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]=Table[Hodge[{QBase[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]]},rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,z,T],{U,1,Length[QBase[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]]}];\n\n\n\n(*Q†[T][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAllh†[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,1,1];*)\n\n(*With Hodge*)\n(*Table[Hodge[{QBase[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]]},rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,z,T],{U,1,Length[QBase[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]]}];*)",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Q Vacuum",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[QVac2,QHVac2,QvQv2,QvQv2ωϕ];\n(*QvQv*)\n(*VACUUM STATES*)\nQVac2[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4]={QBase[1][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QBase[2][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QBase[3][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QBase[4][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]]};\nQHVac2[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QHVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4]={QHBase[1][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QHBase[2][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QHBase[3][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QHBase[4][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]]};\n\nQvQv2[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QvQv2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4]=OrthogRen[QHVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],QVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],QHVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],QVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],rep1,rep2];\n\nQvQv2ωϕ[rep1_,rep2_,ω1_,ω2_,ω3_,ω4_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QvQv2ωϕ[rep1,rep2,ω1,ω2,ω3,ω4,ϕ1,ϕ2,ϕ3,ϕ4]=OrthogRen[QHVac2[rep1,rep2,ω1,ω2,ω3,ω4],QVac2[rep1,rep2,ω1,ω2,ω3,ω4],QHVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],QVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],rep1,rep2];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "# RUN: Q space ONE SITE",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## With regulators",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## hs",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Cartan",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[h1];\nh1[rep1_][1,1]:=h1[rep1][1,1]=rep1[[1]]+rep1[[2]]+rep1[[3]]+rep1[[4]];\nh1[rep1_][2,1]:=h1[rep1][2,1]=rep1〚3〛 (-1+rep1〚4〛)+rep1〚2〛 (-2+rep1〚3〛+rep1〚4〛)+rep1〚1〛 (-3+rep1〚2〛+rep1〚3〛+rep1〚4〛);\nh1[rep1_][3,1]:=h1[rep1][3,1]=rep1〚2〛 (-1+rep1〚3〛) (-2+rep1〚4〛)+rep1〚1〛 ((-2+rep1〚3〛) (-3+rep1〚4〛)+rep1〚2〛 (-4+rep1〚3〛+rep1〚4〛));\nh1[rep1_][4,1]:=h1[rep1][4,1]=rep1〚1〛 (-1+rep1〚2〛) (-2+rep1〚3〛) (-3+rep1〚4〛);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### $z^0$ (dependence only on regulators)",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*H1*)\nh1[ϕ1_,ϕ2_,ϕ3_,ϕ4_][1,3]:=h1[ϕ1,ϕ2,ϕ3,ϕ4][1,3]=ϕ1+ϕ2+ϕ3+ϕ4;\n\n(*H2*)\nh1[ϕ1_,ϕ2_,ϕ3_,ϕ4_][2,5]:=h1[ϕ1,ϕ2,ϕ3,ϕ4][2,5]=ϕ1 ϕ2+ϕ1 ϕ3+ϕ2 ϕ3+ϕ1 ϕ4+ϕ2 ϕ4+ϕ3 ϕ4;\n\n(*H3*)\nh1[ϕ1_,ϕ2_,ϕ3_,ϕ4_][3,7]:=h1[ϕ1,ϕ2,ϕ3,ϕ4][3,7]=ϕ1 ϕ2 ϕ3+ϕ1 ϕ2 ϕ4+ϕ1 ϕ3 ϕ4+ϕ2 ϕ3 ϕ4;\n\n(*H4*)\nh1[ϕ1_,ϕ2_,ϕ3_,ϕ4_][4,9]:=h1[ϕ1,ϕ2,ϕ3,ϕ4][4,9]=ϕ1*ϕ2*ϕ3*ϕ4;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Relation (dependence on weight1)",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "By expanding at z=∞ and taking the coefficient of $\\frac{1}{z}$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*H2*)\nh1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][2,3]:=h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][2,3]=(ϕ2+ϕ3+ϕ4) (weight1[[1]])+(ϕ1+ϕ3+ϕ4) (weight1[[2]])+(ϕ1+ϕ2+ϕ4) (weight1[[3]])+(ϕ1+ϕ2+ϕ3) (weight1[[4]]);\n\n(*H3*)\nh1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][3,5]:=h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][3,5]=ϕ3 ϕ4 (weight1[[1]]+weight1[[2]])+ϕ2 ϕ4 (weight1[[1]]+weight1[[3]])+ϕ1 ϕ4 (weight1[[2]]+weight1[[3]])+ϕ2 ϕ3 (weight1[[1]]+weight1[[4]])+ϕ1 ϕ3 (weight1[[2]]+weight1[[4]])+ϕ1 ϕ2 (weight1[[3]]+weight1[[4]]);\n\n(*H4*)\nh1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][4,7]:=h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][4,7]=ϕ2 ϕ3 ϕ4 (weight1[[1]])+ϕ1 ϕ3 ϕ4 (weight1[[2]])+ϕ1 ϕ2 ϕ4 (weight1[[3]])+ϕ1 ϕ2 ϕ3 (weight1[[4]]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Hamiltonian in Q-space",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ϵ11,ϵ12,ϵ13];\nϵ11[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h1[rep1][1,1])/(z-w1)+h1[ϕ1,ϕ2,ϕ3,ϕ4][1,3];\nϵ12[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h1[rep1][2,1])/((z-w1)^2)+(h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][2,3])/((z-w1))+h1[ϕ1,ϕ2,ϕ3,ϕ4][2,5];\nϵ13[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ13[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h1[rep1][3,1])/((z-w1)^3)+(h1[3,3])/((z-w1)^2)+(h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][3,5])/(z-w1)+h1[ϕ1,ϕ2,ϕ3,ϕ4][3,7];\nϵ14[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ14[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h1[rep1][4,1])/((z-w1)^4)+(h1[4,3])/((z-w1)^3)+(h1[4,5])/((z-w1)^2)+(h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][4,7])/(z-w1)+h1[ϕ1,ϕ2,ϕ3,ϕ4][4,9];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Baxter equation with F",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[F1];\nF1[rep1_,C1_][z_]:=F1[rep1,C1][z]=(1)/((z-w1)^(rep1[[C1]]-C1+1));",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Definition of shifted Hamiltonian",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ϵ11S,ϵ12S,ϵ13S]\nϵ11S[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_][z_]:=ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]=ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]+(4 F1[rep1,C1]^(′)[z])/(F1[rep1,C1][z]);\nϵ12S[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_][z_]:=ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]=ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]+(3 ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z] F1[rep1,C1]^(′)[z])/(F1[rep1,C1][z])+(6 F1[rep1,C1]^(′′)[z])/(F1[rep1,C1][z]);\nϵ13S[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_][z_]:=ϵ13S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]=ϵ13[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]+2*ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]*(F1[rep1,C1]^(′)[z])/(F1[rep1,C1][z])+3*(ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z] F1[rep1,C1]^(′′)[z])/(F1[rep1,C1][z])+4*(F1[rep1,C1]^((3))[z])/(F1[rep1,C1][z]);\nϵ14S[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_][z_]:=ϵ14S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]=ϵ14[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]+ϵ13[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]*(F1[rep1,C1]^(′)[z])/(F1[rep1,C1][z])+(ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z] F1[rep1,C1]^(′′)[z])/(F1[rep1,C1][z])+ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]*(F1[rep1,C1]^((3))[z])/(F1[rep1,C1][z])+(F1[rep1,C1]^((4))[z])/(F1[rep1,C1][z]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[BaxOp1];\nBaxOp1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=D[#,{z,4}]+ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]*D[#,{z,3}]+ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]*D[#,{z,2}]+ϵ13S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]*D[#,z]+ϵ14S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]*#&;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Q functions",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[QPoly,Q1,c11,c12,c13,c14];\nQPoly[c_,M_,r_][z_]:=QPoly[c,M,r][z]=Exp[r z]*(z^M+Sum[c[k]*z^k,{k,0,M-1}]);\nQ1[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly[c11,rep1〚1〛-weight1〚1〛,-ϕ1][z];\nQ1[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly[c12,rep1〚1〛-weight1〚2〛,-ϕ2][z];\nQ1[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly[c13,rep1〚1〛-weight1〚3〛,-ϕ3][z];\nQ1[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly[c14,rep1〚1〛-weight1〚4〛,-ϕ4][z];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Baxter equations",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Baxter equations",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Bax1];\nBax1[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=Bax1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1]=((BaxOp1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][Q1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ1 z])//Simplify;\nBax1[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=Bax1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1]=((BaxOp1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][Q1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ2 z])//Simplify;\nBax1[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=Bax1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1]=((BaxOp1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][Q1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ3 z])//Simplify;\nBax1[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=Bax1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1]=((BaxOp1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][Q1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ3 z])//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Unknown coefficients",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Vars11,Vars12,Vars13,Vars14];\nVars11[rep1_,weight1_]:=Vars11[rep1,weight1]=Table[c11[n],{n,0,rep1〚1〛-weight1〚1〛-1}];\nVars12[rep1_,weight1_]:=Vars12[rep1,weight1]=Table[c12[n],{n,0,rep1〚1〛-weight1〚2〛-1}];\nVars13[rep1_,weight1_]:=Vars13[rep1,weight1]=Table[c13[n],{n,0,rep1〚1〛-weight1〚3〛-1}];\nVars14[rep1_,weight1_]:=Vars14[rep1,weight1]=Table[c14[n],{n,0,rep1〚1〛-weight1〚4〛-1}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Solve Baxter equation",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[SolveBaxAll1];\nSolveBaxAll1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,c1_]:=SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]=Solve[CoefficientList[Bax1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]//Together//Numerator,z]==0&&\nCoefficientList[Bax1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]//Together//Numerator,z]==0&&CoefficientList[Bax1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]//Together//Numerator,z]==0&&CoefficientList[Bax1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]//Together//Numerator,z]==0,Join[Vars11[rep1,weight1],Vars12[rep1,weight1],Vars13[rep1,weight1],Vars14[rep1,weight1],{h1[3,3],h1[4,3],h1[4,5]}]]//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Spectrum of Hamiltonian",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[HSpectrum1];\nHSpectrum1[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ13[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ14[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Shifted Spectrum of Hamiltonian",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[HSpectrum1S];\nHSpectrum1S[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1S[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1S[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1S[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1S[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1S[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ13S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1S[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1S[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ14S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Example of use",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Sol=SolveBaxAll1[FUNDAMENTAL,FUNDAMENTAL,1,(1)/(3),(1)/(5),(1)/(7),1]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-out-n=\"448\" data-sub-idx=\"0\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[448]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"0\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:2.4em;vertical-align:-0.95em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">{</span></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">{</span></span><span class=\"mord mathnormal\">c</span><span class=\"mord\">12</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">[</span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">]</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\">−</span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.3214em;\"><span style=\"top:-2.314em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span cla