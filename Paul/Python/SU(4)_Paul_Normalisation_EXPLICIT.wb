  {
   "kind": 2,
   "value": "rep1〚1〛 (-1+rep1〚2〛) (-2+rep1〚3〛) (-3+rep1〚4〛)\nrep2〚1〛 (-1+rep2〚2〛) (-2+rep2〚3〛) (-3+rep2〚4〛)",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-out-n=\"314\" data-sub-idx=\"0\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[314]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"0\" data-latex-b64=\"LTY=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">−</span><span class=\"mord\">6</span></span></span></span></span></div></div></div>",
