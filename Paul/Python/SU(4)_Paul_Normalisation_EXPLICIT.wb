   "kind": 2,
   "value": "ClearAll[rep1T,rep2T,repAllT]\nrep1T={3,0,0,0};\nrep2T={4,3,2,1};\nrepAllT[i_]:=FindGoodWeight2[rep1T,rep2T][[i]];\nϕ1T=1;\nϕ2T=(1)/(2);\nϕ3T=(1)/(3);\nϕ4T=(1)/(5);\n\n(*rep1T=ADJOINT;\nrep2T=ADJOINT;\nrepAllT[1]={4,2,0};\nrepAllT[2]={3,2,1};\nrepAllT[3]={2,2,2};\nϕ1T=3;\nϕ2T=5;\nϕ3T=7;*)\n\n(*rep1T={3,2,1};\nrep2T={2,0,0};\nrepAllT[1]={5,2,1};\nrepAllT[2]={4,3,1};\nrepAllT[3]={4,2,2};\nϕ1T=1;\nϕ2T=(1)/(2);\nϕ3T=(1)/(7);*)\n\n(*rep1T=FUNDAMENTAL;\nrep2T=FUNDAMENTAL;\nrepAllT[1]={1,1,0};\nrepAllT[2]={2,0,0};\nrepAllT[3]={1,1,0};*)\n\nTable[\nSolh=(SolveBaxAll[rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T,1,1]//Simplify)[[1]];\n\nQh[1]=Q[1][rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T][z]/.Solh;\nQh[2]=Q[2][rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T][z]/.Solh;\nQh[3]=Q[3][rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T][z]/.Solh;\nQh[4]=Q[4][rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T][z]/.Solh;\n\n(*SolveBaxh†[1][rep1T,rep2T,repAllT,ϕ1,ϕ2,ϕ3,h[2,5]/.Solh,h[3,5]/.Solh,h[3,7]/.Solh,h[3,9]/.Solh];\nSolveBaxh†[2][rep1T,rep2T,repAllT,ϕ1,ϕ2,ϕ3,h[2,5]/.Solh,h[3,5]/.Solh,h[3,7]/.Solh,h[3,9]/.Solh];\nSolveBaxh†[3][rep1T,rep2T,repAllT,ϕ1,ϕ2,ϕ3,h[2,5]/.Solh,h[3,5]/.Solh,h[3,7]/.Solh,h[3,9]/.Solh];*)\n\n\nPrint[\"\\<Hi\\>\"];\nSol†=SolveBaxAllh†[rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T,h[2,4]/.Solh,h[3,3]/.Solh,h[3,4]/.Solh,h[3,6]/.Solh,\nh[4,3]/.Solh,h[4,4]/.Solh,h[4,5]/.Solh,h[4,6]/.Solh,h[4,8]/.Solh];\n\nQH[1]=Q†[1][rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T][z]/.Sol†;\nQH[2]=Q†[2][rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T][z]/.Sol†;\nQH[3]=Q†[3][rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T][z]/.Sol†;\nQH[4]=Q†[4][rep1T,rep2T,repAllT[M],ϕ1T,ϕ2T,ϕ3T,ϕ4T][z]/.Sol†;\n\n(*Print[\"\\<Hodge\\>\"]\nHodge[{Qh[1],Qh[2],Qh[3]},rep1T,rep2T,ϕ1,ϕ2,ϕ3,z,2,1,1]//Simplify\n\nPrint[\"\\<\\!\\(\\*SuperscriptBox[\\(Q\\), \\(†\\)]\\)\\>\"]\nQH[2]//Simplify*)\n\nPrint[\"\\<M=\\>\",M,\"\\<, \\>\",Table[((1)/(QH[t])Hodge[{Qh[1],Qh[2],Qh[3],Qh[4]},rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T,z,t])//Simplify,{t,1,4}]],{M,1,4}];",
