  {
   "kind": 2,
   "value": "(*L^2*)\nClearAll[trALLpp,trALpLp,trALppL];\ntrALLpp[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trALLpp[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(2)*(Sum[LIndex[a,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[b,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{z,2}]-LIndex[b,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex[a,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{z,2}],{a,1,Ng},{b,1,Ng}]);\n\ntrALpLp[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trALpLp[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(2)*(Sum[D[LIndex[a,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].D[LIndex[b,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z]-D[LIndex[b,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z].D[LIndex[a,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],z],{a,1,Ng},{b,1,Ng}]);\n\ntrALppL[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trALppL[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(2)*(Sum[D[LIndex[a,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{z,2}].LIndex[b,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]-D[LIndex[b,a,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{z,2}].LIndex[a,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z],{a,1,Ng},{b,1,Ng}]);",
   "languageId": "wolfram",
   "outputs": [],
