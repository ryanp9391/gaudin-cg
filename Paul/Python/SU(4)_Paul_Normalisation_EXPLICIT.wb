  {
   "kind": 1,
   "value": "## Q Hodge",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Ng,SetN];\nNg=4;\nSetN=Range[Ng];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Hodge1];\nHodge1[Qfour_,rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,z_,i_]:=\n(Exp[z*(ϕ1+ϕ2+ϕ3+ϕ4)]*Signature[Join[Complement[SetN,{i}],{i}]]*Wronskian[{Qfour[[Complement[SetN,{i}]]][[1]],Qfour[[Complement[SetN,{i}]]][[2]],Qfour[[Complement[SetN,{i}]]][[3]]},z]*(((z)^(-(2*rep1[[1]]-rep1[[2]]-rep1[[3]]))))/((({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[1]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[2]]]]))*({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[1]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[3]]]])*({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[2]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[3]]]])))//Simplify;\n(*The Q argument should be Q1[z], not Q1!*)\n\n(**(((z)^(-2(rep1[[1]]-rep1[[2]]))*(z-1)^(-2(rep2[[1]]-rep2[[2]]))))*)\n(**)",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 1-site Scalar product",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Renormalised scalar product",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Input:\n$Q=\\left\\{Q_1,Q_2,Q_3\\right\\}$\n$\\mathrm{QH}=\\left\\{\\mathrm{QH}_1,\\mathrm{QH}_2,\\mathrm{QH}_3\\right\\}$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### rep1",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Normalisation1];\nNormalisation1[QHL_,QL_,QHR_,QR_,rep1_]:=Normalisation1[QHL,QL,QHR,QR,rep1]=(Limit[QHL[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QHL[[1]],QHL[[2]]},z]*(1)/(z^(rep1[[3]]-rep1[[4]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QL[[4]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QR[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z]*(1)/(z^(rep1[[1]]-rep1[[2]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QHR[[4]],z->0,Direction->\"\\<FromAbove\\>\"]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[RawOrthog1];\nRawOrthog1[QH_,Q_,rep1_,w_,α_,i_,j_]:=RawOrthog1[QH,Q,rep1,w,α,i,j]={MeanValue1[QH[[i]]*D[Q[[j]],{z,2}]*(1)/(z-w),α,rep1],MeanValue1[QH[[i]]*D[Q[[j]],{z,1}]*(1)/((z-w)^2),α,rep1],MeanValue1[QH[[i]]*D[Q[[j]],{z,1}]*(1)/(z-w),α,rep1],MeanValue1[QH[[i]]*Q[[j]]*(1)/((z-w)^3),α,rep1],MeanValue1[QH[[i]]*Q[[j]]*(1)/((z-w)^2),α,rep1],MeanValue1[QH[[i]]*Q[[j]]*(1)/(z-w),α,rep1]};\nClearAll[OrthogRen1];\nOrthogRen1[QHL_,QL_,QHR_,QR_,rep1_]:=OrthogRen1[QHL,QL,QHR,QR,rep1]=(1/Normalisation1[QHL,QL,QHR,QR,rep1])*Det[{RawOrthog1[QHL,QR,rep1,0,0,1,1],RawOrthog1[QHL,QR,rep1,0,0,1,2],RawOrthog1[QHL,QR,rep1,0,0,2,1],RawOrthog1[QHL,QR,rep1,0,0,2,2],RawOrthog1[QHL,QR,rep1,0,0,1,3],RawOrthog1[QHL,QR,rep1,0,0,3,1]}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### rep2",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Normalisation2];\nNormalisation2[QHL_,QL_,QHR_,QR_,rep2_]:=Normalisation2[QHL,QL,QHR,QR,rep2]=\n(Limit[QHL[[1]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QHL[[1]],QHL[[2]]},z]*(1)/((z-1)^(rep2[[3]]-rep2[[4]])),z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[QL[[4]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[QR[[1]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z]*(1)/((z-1)^(rep2[[1]]-rep2[[2]])),z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[QHR[[4]],z->1,Direction->\"\\<FromAbove\\>\"]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[RawOrthog2];\nRawOrthog2[QH_,Q_,rep2_,w_,α_,i_,j_]:=RawOrthog2[QH,Q,rep2,w,α,i,j]={MeanValue2[QH[[i]]*D[Q[[j]],{z,2}]*(1)/(z-w),α,rep2],MeanValue2[QH[[i]]*D[Q[[j]],{z,1}]*(1)/((z-w)^2),α,rep2],MeanValue2[QH[[i]]*D[Q[[j]],{z,1}]*(1)/(z-w),α,rep2],MeanValue2[QH[[i]]*Q[[j]]*(1)/((z-w)^3),α,rep2],MeanValue2[QH[[i]]*Q[[j]]*(1)/((z-w)^2),α,rep2],MeanValue2[QH[[i]]*Q[[j]]*(1)/(z-w),α,rep2]};\nClearAll[OrthogRen2];\nOrthogRen2[QHL_,QL_,QHR_,QR_,rep2_]:=OrthogRen2[QHL,QL,QHR,QR,rep2]=(1/Normalisation2[QHL,QL,QHR,QR,rep2])*Det[{RawOrthog2[QHL,QR,rep2,0,0,1,1],RawOrthog2[QHL,QR,rep2,0,0,1,2],RawOrthog2[QHL,QR,rep2,0,0,2,1],RawOrthog2[QHL,QR,rep2,0,0,2,2],RawOrthog2[QHL,QR,rep2,0,0,1,3],RawOrthog2[QHL,QR,rep2,0,0,3,1]}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "# RUN: Ψ space ONE SITE",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Definition Lax connection",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Lax connection",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Lax connection $L_{\\mathrm{ij}}$ with regulator ϕ",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[LIndex1];\nLIndex1[a_,b_,rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=LIndex1[a,b,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(z-w1)*EM[a,b,rep1]+KroneckerDelta[a,1]*KroneckerDelta[b,1]*ϕ1*Id[rep1]+KroneckerDelta[a,2]*KroneckerDelta[b,2]*ϕ2*Id[rep1]+KroneckerDelta[a,3]*KroneckerDelta[b,3]*ϕ3*Id[rep1]+KroneckerDelta[a,4]*KroneckerDelta[b,4]*ϕ4*Id[rep1];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Example of use",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[rep1T];\nrep1T=FUNDAMENTAL;\nLIndex[1,1,rep1T,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-out-n=\"516\" data-sub-idx=\"0\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[516]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"0\" data-latex-b64=\"XG1hdGhybXtMSW5kZXh9XGxlZnRbMSwxLFxsZWZ0XHsxLDAsMCwwXHJpZ2h0XH0sXHBoaTEsXHBoaTIsXHBoaTMsXHBoaTRccmlnaHRdXGxlZnRbelxyaWdodF0=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">LIndex</span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">[</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">ϕ</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">ϕ</span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">ϕ</span><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">ϕ</span><span class=\"mord\">4</span><span class=\"mclose delimcenter\" style=\"top:0em;\">]</span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">[</span><span class=\"mord mathnormal\" style=\"margin-right:0.04398em;\">z</span><span class=\"mclose delimcenter\" style=\"top:0em;\">]</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[516]= \\mathrm{LIndex}\\left[1,1,\\left\\{1,0,0,0\\right\\},\\phi1,\\phi2,\\phi3,\\phi4\\right]\\left[z\\right]",
       "mime": "text/plain"
      }
     ],
     "id": "nbimport-69"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Hamiltonians",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## H1",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Regulated Hamiltonian $\\operatorname{tr}\\left(L\\right)$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[H11];\nH11[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=H11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=Sum[LIndex1[a,a,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],{a,1,Ng}]//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Definition Residue of H",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH11];\nResH11[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_]:=ResH11[rep1,ϕ1,ϕ2,ϕ3,ϕ4,w]=SeriesCoefficient[H11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,-1}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Example of use",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "H11[FUNDAMENTAL,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## H2",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Regulated Hamiltonian $\\frac{3}{2}*\\operatorname{tr}\\left(L'\\right)+\\mathrm{trA}\\left(L^2\\right)$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Antisymm. def",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[trA1L2];\ntrA1L2[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trA1L2[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(2)*(Sum[LIndex1[a,a,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[b,b,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex1[b,a,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[a,b,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],{a,1,Ng},{b,1,Ng}]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Def. H2",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[H12];\nH12[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=H12[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(trA1L2[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]+(3)/(2)*Sum[D[LIndex1[a,a,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],z],{a,1,Ng}])//Simplify",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Definition Residue of H",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH12];\nResH12[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_]:=ResH12[rep1,ϕ1,ϕ2,ϕ3,ϕ4,w]=SeriesCoefficient[H12[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,-1}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH12O];\nResH12O[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_,o_]:=ResH12O[rep1,ϕ1,ϕ2,ϕ3,ϕ4,w,o]=SeriesCoefficient[H12[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,o}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Example of use",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "H12[FUNDAMENTAL,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## H3",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### H3 Unsimplified",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Regulated Hamiltonian $\\mathrm{trA}\\left(L^3\\right)+\\frac{4}{3}\\mathrm{trA}\\left(L\\cdot L'\\right)+\\frac{1}{2}\\mathrm{trA}\\left(L'\\cdot L\\right)+\\operatorname{tr}\\left(L''\\right)$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Antisymm. def",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[trA1L3];\ntrA1L3[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trA1L3[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(6)*Sum[LIndex1[i1,i1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i2,i2,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i3,i3,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex1[i1,i1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i3,i2,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i2,i3,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex1[i2,i1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i1,i2,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i3,i3,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]+LIndex1[i2,i1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i3,i2,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i1,i3,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]+LIndex1[i3,i1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i1,i2,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i2,i3,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]-LIndex1[i3,i1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i2,i2,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].LIndex1[i1,i3,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],{i1,1,Ng},{i2,1,Ng},{i3,1,Ng}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[trA1LpL,trA1LLp];\ntrA1LLp[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trA1LLp[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(2)*(Sum[LIndex1[a,a,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex1[b,b,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],z]-LIndex1[b,a,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z].D[LIndex1[a,b,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],z],{a,1,Ng},{b,1,Ng}]);\ntrA1LpL[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=trA1LpL[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(2)*(Sum[D[LIndex1[a,a,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex1[b,b,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]-D[LIndex1[b,a,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],z].LIndex1[a,b,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],{a,1,Ng},{b,1,Ng}]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### Def H3",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[H13U];\nH13U[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=H3U[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=trA1L3[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]+(4)/(3)*trA1LLp[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]+(2)/(3)*trA1LpL[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]+Sum[D[LIndex1[a,a,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z],{z,2}],{a,1,Ng}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### H3 Simplified",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[H13];\nH13[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=H13[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=H13U[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Definition Residue of H",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH13];\nResH13[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_]:=ResH13[rep1,ϕ1,ϕ2,ϕ3,ϕ4,w]=SeriesCoefficient[H13[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,-1}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Clear[ResH13O];\nResH13O[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,w_,o_]:=ResH13O[rep1,ϕ1,ϕ2,ϕ3,ϕ4,w,o]=SeriesCoefficient[H13[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal,{z,w,o}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Example of use",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "H13[FUNDAMENTAL,ϕ1,ϕ2,ϕ3,ϕ4][z]//Normal//Simplify",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
