  },
  {
   "kind": 1,
   "value": "## Renormalised scalar product",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Input:\n$Q=\\left\\{Q_1,Q_2,Q_3\\right\\}$\n$\\mathrm{QH}=\\left\\{\\mathrm{QH}_1,\\mathrm{QH}_2,\\mathrm{QH}_3\\right\\}$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### rep1",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Normalisation1];\nNormalisation1[QHL_,QL_,QHR_,QR_,rep1_]:=Normalisation1[QHL,QL,QHR,QR,rep1]=(Limit[QHL[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QHL[[1]],QHL[[2]]},z]*(1)/(z^(rep1[[3]]-rep1[[4]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QL[[4]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QR[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z]*(1)/(z^(rep1[[1]]-rep1[[2]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QHR[[4]],z->0,Direction->\"\\<FromAbove\\>\"]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[RawOrthog1];\nRawOrthog1[QH_,Q_,rep1_,w_,α_,i_,j_]:=RawOrthog1[QH,Q,rep1,w,α,i,j]={MeanValue1[QH[[i]]*D[Q[[j]],{z,2}]*(1)/(z-w),α,rep1],MeanValue1[QH[[i]]*D[Q[[j]],{z,1}]*(1)/((z-w)^2),α,rep1],MeanValue1[QH[[i]]*D[Q[[j]],{z,1}]*(1)/(z-w),α,rep1],MeanValue1[QH[[i]]*Q[[j]]*(1)/((z-w)^3),α,rep1],MeanValue1[QH[[i]]*Q[[j]]*(1)/((z-w)^2),α,rep1],MeanValue1[QH[[i]]*Q[[j]]*(1)/(z-w),α,rep1]};\nClearAll[OrthogRen1];\nOrthogRen1[QHL_,QL_,QHR_,QR_,rep1_]:=OrthogRen1[QHL,QL,QHR,QR,rep1]=(1/Normalisation1[QHL,QL,QHR,QR,rep1])*Det[{RawOrthog1[QHL,QR,rep1,0,0,1,1],RawOrthog1[QHL,QR,rep1,0,0,1,2],RawOrthog1[QHL,QR,rep1,0,0,2,1],RawOrthog1[QHL,QR,rep1,0,0,2,2],RawOrthog1[QHL,QR,rep1,0,0,1,3],RawOrthog1[QHL,QR,rep1,0,0,3,1]}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "#### rep2",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Normalisation2];\nNormalisation2[QHL_,QL_,QHR_,QR_,rep2_]:=Normalisation2[QHL,QL,QHR,QR,rep2]=\n(Limit[QHL[[1]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QHL[[1]],QHL[[2]]},z]*(1)/((z-1)^(rep2[[3]]-rep2[[4]])),z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[QL[[4]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[QR[[1]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z]*(1)/((z-1)^(rep2[[1]]-rep2[[2]])),z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[QHR[[4]],z->1,Direction->\"\\<FromAbove\\>\"]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[RawOrthog2];\nRawOrthog2[QH_,Q_,rep2_,w_,α_,i_,j_]:=RawOrthog2[QH,Q,rep2,w,α,i,j]={MeanValue2[QH[[i]]*D[Q[[j]],{z,2}]*(1)/(z-w),α,rep2],MeanValue2[QH[[i]]*D[Q[[j]],{z,1}]*(1)/((z-w)^2),α,rep2],MeanValue2[QH[[i]]*D[Q[[j]],{z,1}]*(1)/(z-w),α,rep2],MeanValue2[QH[[i]]*Q[[j]]*(1)/((z-w)^3),α,rep2],MeanValue2[QH[[i]]*Q[[j]]*(1)/((z-w)^2),α,rep2],MeanValue2[QH[[i]]*Q[[j]]*(1)/(z-w),α,rep2]};\nClearAll[OrthogRen2];\nOrthogRen2[QHL_,QL_,QHR_,QR_,rep2_]:=OrthogRen2[QHL,QL,QHR,QR,rep2]=(1/Normalisation2[QHL,QL,QHR,QR,rep2])*Det[{RawOrthog2[QHL,QR,rep2,0,0,1,1],RawOrthog2[QHL,QR,rep2,0,0,1,2],RawOrthog2[QHL,QR,rep2,0,0,2,1],RawOrthog2[QHL,QR,rep2,0,0,2,2],RawOrthog2[QHL,QR,rep2,0,0,1,3],RawOrthog2[QHL,QR,rep2,0,0,3,1]}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "# RUN: Ψ space",
