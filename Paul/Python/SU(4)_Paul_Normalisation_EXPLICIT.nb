Cell["From Dynkin (\[CapitalDelta],l) label of sl(2) to weights of gl(3)", \
"Subsection",
 CellChangeTimes->{{3.9779134727809057`*^9, 3.9779135131519938`*^9}, {
  3.979277375679048*^9, 
  3.979277382182849*^9}},ExpressionUUID->"9cc8c960-64b4-42c7-ba9b-\
3c31e379de55"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "WeightDynkin", ",", "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WeightDynkin", "[", 
    RowBox[{"\[CapitalDelta]_", ",", "l_"}], "]"}], ":=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Lambda]1", "-", "\[Lambda]2"}], "==", 
       RowBox[{"(", "\[CapitalDelta]", ")"}]}], "&&", 
      RowBox[{
       RowBox[{"\[Lambda]2", "-", "\[Lambda]3"}], "==", "l"}], "&&", 
      RowBox[{
       RowBox[{"\[Lambda]1", "+", "\[Lambda]2", "+", "\[Lambda]3"}], "==", 
       "0"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}]}], 
    "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", "Fundamental", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WeightDynkin", "[", 
   RowBox[{"1", ",", "0"}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "AntiFundamental", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WeightDynkin", "[", 
   RowBox[{"0", ",", "1"}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "Adjoint", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"WeightDynkin", "[", 
  RowBox[{"1", ",", "1"}], "]"}]}], "Input",
 CellChangeTimes->{{3.977913393649364*^9, 3.9779136900223503`*^9}, {
