Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "Normalisation1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Normalisation1", "[", 
    RowBox[{"QHL_", ",", "QL_", ",", "QHR_", ",", "QR_", ",", "rep1_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"Normalisation1", "[", 
     RowBox[{"QHL", ",", "QL", ",", "QHR", ",", "QR", ",", "rep1"}], "]"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{"QHL", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"z", "->", "0"}], ",", 
        RowBox[{"Direction", "->", "\"\<FromAbove\>\""}]}], "]"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Wronskian", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"QHL", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"QHL", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "z"}], "]"}], "*", 
         FractionBox["1", 
          SuperscriptBox["z", 
           RowBox[{
            RowBox[{"rep1", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "-", 
            RowBox[{"rep1", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}]]]}], ",", 
        RowBox[{"z", "->", "0"}], ",", 
        RowBox[{"Direction", "->", "\"\<FromAbove\>\""}]}], "]"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{"QL", "[", 
         RowBox[{"[", "4", "]"}], "]"}], ",", 
        RowBox[{"z", "->", "0"}], ",", 
        RowBox[{"Direction", "->", "\"\<FromAbove\>\""}]}], "]"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{"QR", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"z", "->", "0"}], ",", 
        RowBox[{"Direction", "->", "\"\<FromAbove\>\""}]}], "]"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Wronskian", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"QR", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"QR", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "z"}], "]"}], "*", 
         FractionBox["1", 
          SuperscriptBox["z", 
           RowBox[{
            RowBox[{"rep1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"rep1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]]]}], ",", 
        RowBox[{"z", "->", "0"}], ",", 
        RowBox[{"Direction", "->", "\"\<FromAbove\>\""}]}], "]"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{"QHR", "[", 
         RowBox[{"[", "4", "]"}], "]"}], ",", 
        RowBox[{"z", "->", "0"}], ",", 
        RowBox[{"Direction", "->", "\"\<FromAbove\>\""}]}], "]"}], 
      ")"}]}]}]}], ";"}]}], "Input",
