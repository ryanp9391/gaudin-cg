Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"JJH", ",", "PM", ",", "SolvePH", ",", "PH", ",", "PElement"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PM", "[", "rep_", "]"}], ":=", 
   RowBox[{
    RowBox[{"PM", "[", "rep", "]"}], "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"PElement", "[", "i", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"dim", "[", "rep", "]"}]}], "}"}]}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SolvePH", "[", "rep_", "]"}], ":=", 
    RowBox[{
     RowBox[{"SolvePH", "[", "rep", "]"}], "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"(", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"PM", "[", "rep", "]"}], ".", 
                 RowBox[{"JJ", "[", 
                  RowBox[{"k", ",", "l", ",", "rep"}], "]"}], ".", 
                 RowBox[{"Inverse", "[", 
                  RowBox[{"PM", "[", "rep", "]"}], "]"}]}], "-", 
                RowBox[{
                 RowBox[{"Inverse", "[", 
                  RowBox[{"PM", "[", "rep", "]"}], "]"}], ".", 
                 RowBox[{"ConjugateTranspose", "[", 
                  RowBox[{"JJ", "[", 
                   RowBox[{"l", ",", "k", ",", "rep"}], "]"}], "]"}], ".", 
                 RowBox[{"PM", "[", "rep", "]"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "1", ",", "Ng"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"l", ",", "1", ",", "Ng"}], "}"}]}], "]"}], "//", 
             "Flatten"}], "]"}], ")"}], "==", "0"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"PElement", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"dim", "[", "rep", "]"}]}], "}"}]}], "]"}]}], "]"}], 
       ")"}], "]"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"If", " ", "PM", " ", "is", " ", "real"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PH", "[", 
     RowBox[{"rep_", ",", 
      RowBox[{"Optional", "[", 
       RowBox[{"M_", ",", "1"}], "]"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"PH", "[", 
      RowBox[{"rep", ",", 
       RowBox[{"Optional", "[", 
