     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"PM", "[", "rep", "]"}], "/.", 
         RowBox[{"SolvePH", "[", "rep", "]"}]}], ")"}], "[", 
       RowBox[{"[", "M", "]"}], "]"}], "//", "Simplify"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"If", " ", "PM", " ", "is", " ", "complex"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"PM", "[", "rep", "]"}], ".", 
              RowBox[{"JJ", "[", 
               RowBox[{"k", ",", "l", ",", "rep"}], "]"}], ".", 
              RowBox[{"Inverse", "[", 
               RowBox[{"PM", "[", "rep", "]"}], "]"}]}], "-", 
             RowBox[{"ConjugateTranspose", "[", 
              RowBox[{
               RowBox[{"PM", "[", "rep", "]"}], ".", 
               RowBox[{"JJ", "[", 
                RowBox[{"l", ",", "k", ",", "rep"}], "]"}], ".", 
               RowBox[{"Inverse", "[", 
                RowBox[{"PM", "[", "rep", "]"}], "]"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
