 RowBox[{
  RowBox[{
   RowBox[{"SolveBaxAll", "[", 
    RowBox[{
    "rep1_", ",", "rep2_", ",", "repAll_", ",", "\[Phi]1_", ",", "\[Phi]2_", ",",
      "\[Phi]3_", ",", "\[Phi]4_", ",", "c1_", ",", "c2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"SolveBaxAll", "[", 
     RowBox[{
     "rep1", ",", "rep2", ",", "repAll", ",", "\[Phi]1", ",", "\[Phi]2", ",", 
      "\[Phi]3", ",", "\[Phi]4", ",", "c1", ",", "c2"}], "]"}], "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Bax", "[", "1", "]"}], "[", 
              RowBox[{
              "rep1", ",", "rep2", ",", "repAll", ",", "\[Phi]1", ",", 
               "\[Phi]2", ",", "\[Phi]3", ",", "\[Phi]4", ",", "c1", ",", 
               "c2"}], "]"}], "//", "Together"}], "//", "Numerator"}], ",", 
           "z"}], "]"}], "==", "0"}], "&&", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Bax", "[", "2", "]"}], "[", 
              RowBox[{
              "rep1", ",", "rep2", ",", "repAll", ",", "\[Phi]1", ",", 
               "\[Phi]2", ",", "\[Phi]3", ",", "\[Phi]4", ",", "c1", ",", 
               "c2"}], "]"}], "//", "Together"}], "//", "Numerator"}], ",", 
           "z"}], "]"}], "==", "0"}], "&&", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Bax", "[", "3", "]"}], "[", 
              RowBox[{
              "rep1", ",", "rep2", ",", "repAll", ",", "\[Phi]1", ",", 
               "\[Phi]2", ",", "\[Phi]3", ",", "\[Phi]4", ",", "c1", ",", 
               "c2"}], "]"}], "//", "Together"}], "//", "Numerator"}], ",", 
           "z"}], "]"}], "==", "0"}], "&&", 
        RowBox[{
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Bax", "[", "4", "]"}], "[", 
              RowBox[{
              "rep1", ",", "rep2", ",", "repAll", ",", "\[Phi]1", ",", 
               "\[Phi]2", ",", "\[Phi]3", ",", "\[Phi]4", ",", "c1", ",", 
               "c2"}], "]"}], "//", "Together"}], "//", "Numerator"}], ",", 
           "z"}], "]"}], "==", "0"}]}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Vars1", "[", 
          RowBox[{"rep1", ",", "rep2", ",", "repAll"}], "]"}], ",", 
         RowBox[{"Vars2", "[", 
          RowBox[{"rep1", ",", "rep2", ",", "repAll"}], "]"}], ",", 
         RowBox[{"Vars3", "[", 
          RowBox[{"rep1", ",", "rep2", ",", "repAll"}], "]"}], ",", 
         RowBox[{"Vars4", "[", 
          RowBox[{"rep1", ",", "rep2", ",", "repAll"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{"2", ",", "4"}], "]"}], ",", 
           RowBox[{"h", "[", 
            RowBox[{"3", ",", "3"}], "]"}], ",", 
           RowBox[{"h", "[", 
            RowBox[{"3", ",", "4"}], "]"}], ",", 
           RowBox[{"h", "[", 
            RowBox[{"3", ",", "6"}], "]"}], ",", 
           RowBox[{"h", "[", 
            RowBox[{"4", ",", "3"}], "]"}], ",", 
           RowBox[{"h", "[", 
            RowBox[{"4", ",", "4"}], "]"}], ",", 
           RowBox[{"h", "[", 
            RowBox[{"4", ",", "5"}], "]"}], ",", 
           RowBox[{"h", "[", 
            RowBox[{"4", ",", "6"}], "]"}], ",", 
           RowBox[{"h", "[", 
            RowBox[{"4", ",", "8"}], "]"}]}], "}"}]}], "]"}]}], "]"}], "//", 
     "Simplify"}]}]}], ";"}]}], "Input",
