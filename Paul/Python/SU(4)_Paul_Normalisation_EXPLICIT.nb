Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"e", ",", "EM", ",", "Id"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"e", "[", 
    RowBox[{"a_", ",", "b_", ",", "rep1_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"e", "[", 
     RowBox[{"a", ",", "b", ",", "rep1"}], "]"}], "=", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}], "->", "1"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dim", "[", "rep1", "]"}], ",", 
        RowBox[{"dim", "[", "rep1", "]"}]}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EM", "[", 
     RowBox[{"a_", ",", "b_", ",", "rep1_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"EM", "[", 
      RowBox[{"a", ",", "b", ",", "rep1"}], "]"}], "=", 
     RowBox[{"JJ", "[", 
      RowBox[{"a", ",", "b", ",", "rep1"}], "]"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Non", " ", "Hermitian", " ", "generators"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
