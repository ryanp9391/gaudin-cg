Cell[CellGroupData[{

Cell["Module to find good weights for the rep", "Subsection",
 CellChangeTimes->{{3.987146790859859*^9, 
  3.98714679699244*^9}},ExpressionUUID->"e6f546fb-dba0-490e-a081-\
55da7d263492"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"FindWeight", ",", "FindGoodWeight"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FindWeight", "[", "rep_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"EM", "[", 
         RowBox[{"1", ",", "1", ",", "rep"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"n", ",", "n"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"EM", "[", 
         RowBox[{"2", ",", "2", ",", "rep"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"n", ",", "n"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"EM", "[", 
         RowBox[{"3", ",", "3", ",", "rep"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"n", ",", "n"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"EM", "[", 
         RowBox[{"4", ",", "4", ",", "rep"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"n", ",", "n"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{"dim", "[", "rep", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FindGoodWeight", "[", "rep_", "]"}], ":=", 
  RowBox[{"Pick", "[", 
   RowBox[{
    RowBox[{"FindWeight", "[", "rep", "]"}], ",", 
    RowBox[{"Lookup", "[", 
     RowBox[{
      RowBox[{"Counts", "[", 
       RowBox[{"FindWeight", "[", "rep", "]"}], "]"}], ",", 
      RowBox[{"FindWeight", "[", "rep", "]"}]}], "]"}], ",", "1"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.990423742131592*^9, 3.990423747007349*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"45747ea9-5f1e-40c9-a308-374d23ec0d59"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"FindWeight2All", ",", "FindWeight2", ",", "FindGoodWeight2"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FindWeight2All", "[", 
    RowBox[{"rep1_", ",", "rep2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"FindWeight2All", "[", 
     RowBox[{"rep1", ",", "rep2"}], "]"}], "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"EM", "[", 
             RowBox[{"1", ",", "1", ",", "rep1"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "n"}], "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"EM", "[", 
             RowBox[{"1", ",", "1", ",", "rep2"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"m", ",", "m"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"EM", "[", 
             RowBox[{"2", ",", "2", ",", "rep1"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "n"}], "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"EM", "[", 
             RowBox[{"2", ",", "2", ",", "rep2"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"m", ",", "m"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"EM", "[", 
             RowBox[{"3", ",", "3", ",", "rep1"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "n"}], "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"EM", "[", 
             RowBox[{"3", ",", "3", ",", "rep2"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"m", ",", "m"}], "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"EM", "[", 
             RowBox[{"4", ",", "4", ",", "rep1"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "n"}], "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"EM", "[", 
             RowBox[{"4", ",", "4", ",", "rep2"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"m", ",", "m"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", 
          RowBox[{"dim", "[", "rep1", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", 
          RowBox[{"dim", "[", "rep2", "]"}]}], "}"}]}], "]"}], ",", "1"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FindWeight2", "[", 
    RowBox[{"rep1_", ",", "rep2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"FindWeight2", "[", 
     RowBox[{"rep1", ",", "rep2"}], "]"}], "=", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"FindWeight2All", "[", 
      RowBox[{"rep1", ",", "rep2"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FindGoodWeight2", "[", 
   RowBox[{"rep1_", ",", "rep2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"FindGoodWeight2", "[", 
    RowBox[{"rep1", ",", "rep2"}], "]"}], "=", 
   RowBox[{"Pick", "[", 
    RowBox[{
     RowBox[{"FindWeight2All", "[", 
      RowBox[{"rep1", ",", "rep2"}], "]"}], ",", 
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"Counts", "[", 
        RowBox[{"FindWeight2All", "[", 
         RowBox[{"rep1", ",", "rep2"}], "]"}], "]"}], ",", 
       RowBox[{"FindWeight2All", "[", 
        RowBox[{"rep1", ",", "rep2"}], "]"}]}], "]"}], ",", "1"}], 
    "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.987670471544533*^9, 3.987670566579391*^9}, {
