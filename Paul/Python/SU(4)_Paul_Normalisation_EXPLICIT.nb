Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ps", "[", "rep_", "]"}], ":=", 
   RowBox[{
    RowBox[{"ps", "[", "rep", "]"}], "=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"res", "=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{"rep", ",", "#"}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"Tuples", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{
                RowBox[{"rep", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", 
                   RowBox[{"i", "+", "1"}]}], "]"}], "]"}], ",", 
                RowBox[{"rep", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "i"}], "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"rep", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], "-", "1"}]}], 
               "}"}]}], "]"}], "]"}], ")"}]}], ")"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"res", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "==", "1"}], ",", 
        RowBox[{"Reverse", "@", 
         RowBox[{"Sort", "@", "res"}]}], ",", 
        RowBox[{"Reverse", "@", 
         RowBox[{"Sort", "@", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"ps", "/@", "res"}], ",", "1"}], "]"}]}]}]}], "]"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dim", "[", "rep_", "]"}], ":=", 
   RowBox[{
    RowBox[{"dim", "[", "rep", "]"}], "=", 
    RowBox[{"Length", "[", 
     RowBox[{"ps", "[", 
      RowBox[{"{", "rep", "}"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"J0", "[", "k_", "]"}], "[", "pat_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"J0", "[", "k", "]"}], "[", "pat", "]"}], "=", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"pat", "[", 
        RowBox[{"[", 
         RowBox[{"k", ",", "i"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "k"}], "}"}]}], "]"}], "-", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"pat", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"k", "-", "1"}], ",", "i"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Jp", "[", "k_", "]"}], "[", "pat_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Jp", "[", "k", "]"}], "[", "pat", "]"}], "=", 
    RowBox[{"-", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Product", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"pat", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "i"}], "]"}], "]"}], "-", "i", "-", 
            RowBox[{"pat", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"k", "+", "1"}], ",", "j"}], "]"}], "]"}], "+", "j"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Range", "[", 
              RowBox[{"k", "+", "1"}], "]"}]}], "}"}]}], "]"}], "/", 
         RowBox[{"Product", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"pat", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "i"}], "]"}], "]"}], "-", "i", "-", 
            RowBox[{"pat", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "j"}], "]"}], "]"}], "+", "j"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Complement", "[", 
              RowBox[{
               RowBox[{"Range", "[", "k", "]"}], ",", 
               RowBox[{"{", "i", "}"}]}], "]"}]}], "}"}]}], "]"}]}], " ", 
        RowBox[{"v", "[", 
         RowBox[{"ReplacePart", "[", 
          RowBox[{"pat", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"k", ",", "i"}], "}"}], "->", 
            RowBox[{
             RowBox[{"pat", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "i"}], "]"}], "]"}], "+", "1"}]}]}], "]"}], 
         "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "k"}], "}"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Jm", "[", "k_", "]"}], "[", "pat_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Jm", "[", "k", "]"}], "[", "pat", "]"}], "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"pat", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i"}], "]"}], "]"}], "-", "i", "-", 
           RowBox[{"pat", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"k", "-", "1"}], ",", "j"}], "]"}], "]"}], "+", "j"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Range", "[", 
             RowBox[{"k", "-", "1"}], "]"}]}], "}"}]}], "]"}], "/", 
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"pat", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "i"}], "]"}], "]"}], "-", "i", "-", 
           RowBox[{"pat", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "j"}], "]"}], "]"}], "+", "j"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Complement", "[", 
             RowBox[{
              RowBox[{"Range", "[", "k", "]"}], ",", 
              RowBox[{"{", "i", "}"}]}], "]"}]}], "}"}]}], "]"}]}], " ", 
       RowBox[{"v", "[", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"pat", ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"k", ",", "i"}], "}"}], "->", 
           RowBox[{
            RowBox[{"pat", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "i"}], "]"}], "]"}], "-", "1"}]}]}], "]"}], 
        "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "k"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JJ", "[", 
    RowBox[{"k_", ",", "l_", ",", "rep_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"JJ", "[", 
     RowBox[{"k", ",", "l", ",", "rep"}], "]"}], "=", 
    RowBox[{"Which", "[", 
     RowBox[{
      RowBox[{"k", "==", "l"}], ",", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{
        RowBox[{"J0", "[", "k", "]"}], "/@", 
        RowBox[{"ps", "[", 
         RowBox[{"{", "rep", "}"}], "]"}]}], "]"}], ",", 
      RowBox[{"l", "==", 
       RowBox[{"k", "+", "1"}]}], ",", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Jp", "[", "k", "]"}], "[", 
              RowBox[{
               RowBox[{"ps", "[", 
                RowBox[{"{", "rep", "}"}], "]"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
             RowBox[{"v", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"ps", "[", 
           RowBox[{"{", "rep", "}"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"ps", "[", 
             RowBox[{"{", "rep", "}"}], "]"}], "]"}]}], "}"}]}], "]"}], "]"}],
       ",", 
      RowBox[{"l", "==", 
       RowBox[{"k", "-", "1"}]}], ",", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Jm", "[", "l", "]"}], "[", 
              RowBox[{
               RowBox[{"ps", "[", 
                RowBox[{"{", "rep", "}"}], "]"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
             RowBox[{"v", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"ps", "[", 
           RowBox[{"{", "rep", "}"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"ps", "[", 
             RowBox[{"{", "rep", "}"}], "]"}], "]"}]}], "}"}]}], "]"}], "]"}],
       ",", 
      RowBox[{"l", ">", 
       RowBox[{"k", "+", "1"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"JJ", "[", 
         RowBox[{"k", ",", 
          RowBox[{"k", "+", "1"}], ",", "rep"}], "]"}], ".", 
        RowBox[{"JJ", "[", 
         RowBox[{
          RowBox[{"k", "+", "1"}], ",", "l", ",", "rep"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"JJ", "[", 
         RowBox[{
          RowBox[{"k", "+", "1"}], ",", "l", ",", "rep"}], "]"}], ".", 
        RowBox[{"JJ", "[", 
         RowBox[{"k", ",", 
          RowBox[{"k", "+", "1"}], ",", "rep"}], "]"}]}]}], ",", 
      RowBox[{"l", "<", 
       RowBox[{"k", "-", "1"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"JJ", "[", 
         RowBox[{"k", ",", 
          RowBox[{"k", "-", "1"}], ",", "rep"}], "]"}], ".", 
        RowBox[{"JJ", "[", 
         RowBox[{
          RowBox[{"k", "-", "1"}], ",", "l", ",", "rep"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"JJ", "[", 
         RowBox[{
          RowBox[{"k", "-", "1"}], ",", "l", ",", "rep"}], "]"}], ".", 
        RowBox[{"JJ", "[", 
         RowBox[{"k", ",", 
          RowBox[{"k", "-", "1"}], ",", "rep"}], "]"}]}]}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CC", "[", 
    RowBox[{"k_", ",", "set_", ",", "rep_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"CC", "[", 
     RowBox[{"k", ",", "set", ",", "rep"}], "]"}], "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Dot", "[", 
        RowBox[{"Sequence", "@@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"JJ", "[", 
            RowBox[{
             RowBox[{"j", "[", 
              RowBox[{"i", "+", "1"}], "]"}], ",", 
             RowBox[{"j", "[", "i", "]"}], ",", "rep"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "k"}], "}"}]}], "]"}]}], "]"}], "/.", 
       
       RowBox[{
        RowBox[{"j", "[", 
         RowBox[{"k", "+", "1"}], "]"}], "->", 
        RowBox[{"j", "[", "1", "]"}]}]}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{"Sequence", "@@", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"j", "[", "#", "]"}], ",", "set"}], "}"}], "&"}], ",", 
          "k"}], "]"}]}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CCDiag", "[", 
   RowBox[{"k_", ",", "set_", ",", "rep_"}], "]"}], ":=", 
