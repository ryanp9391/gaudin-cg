 RowBox[{
  RowBox[{"ClearAll", "[", "SolveBaxAll1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SolveBaxAll1", "[", 
    RowBox[{
    "rep1_", ",", "weight1_", ",", "\[Phi]1_", ",", "\[Phi]2_", ",", 
     "\[Phi]3_", ",", "\[Phi]4_", ",", "c1_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"SolveBaxAll1", "[", 
     RowBox[{
     "rep1", ",", "weight1", ",", "\[Phi]1", ",", "\[Phi]2", ",", "\[Phi]3", ",",
       "\[Phi]4", ",", "c1"}], "]"}], "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Bax1", "[", "1", "]"}], "[", 
              RowBox[{
              "rep1", ",", "weight1", ",", "\[Phi]1", ",", "\[Phi]2", ",", 
               "\[Phi]3", ",", "\[Phi]4", ",", "c1"}], "]"}], "//", 
             "Together"}], "//", "Numerator"}], ",", "z"}], "]"}], "==", 
         "0"}], "&&", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Bax1", "[", "2", "]"}], "[", 
              RowBox[{
              "rep1", ",", "weight1", ",", "\[Phi]1", ",", "\[Phi]2", ",", 
               "\[Phi]3", ",", "\[Phi]4", ",", "c1"}], "]"}], "//", 
             "Together"}], "//", "Numerator"}], ",", "z"}], "]"}], "==", 
         "0"}], "&&", 
        RowBox[{
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Bax1", "[", "3", "]"}], "[", 
              RowBox[{
              "rep1", ",", "weight1", ",", "\[Phi]1", ",", "\[Phi]2", ",", 
               "\[Phi]3", ",", "\[Phi]4", ",", "c1"}], "]"}], "//", 
             "Together"}], "//", "Numerator"}], ",", "z"}], "]"}], "==", 
         "0"}], "&&", 
        RowBox[{
         RowBox[{"CoefficientList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Bax1", "[", "4", "]"}], "[", 
              RowBox[{
              "rep1", ",", "weight1", ",", "\[Phi]1", ",", "\[Phi]2", ",", 
               "\[Phi]3", ",", "\[Phi]4", ",", "c1"}], "]"}], "//", 
             "Together"}], "//", "Numerator"}], ",", "z"}], "]"}], "==", 
         "0"}]}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Vars11", "[", 
          RowBox[{"rep1", ",", "weight1"}], "]"}], ",", 
         RowBox[{"Vars12", "[", 
          RowBox[{"rep1", ",", "weight1"}], "]"}], ",", 
         RowBox[{"Vars13", "[", 
          RowBox[{"rep1", ",", "weight1"}], "]"}], ",", 
         RowBox[{"Vars14", "[", 
          RowBox[{"rep1", ",", "weight1"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"h1", "[", 
            RowBox[{"3", ",", "3"}], "]"}], ",", 
           RowBox[{"h1", "[", 
            RowBox[{"4", ",", "3"}], "]"}], ",", 
           RowBox[{"h1", "[", 
            RowBox[{"4", ",", "5"}], "]"}]}], "}"}]}], "]"}]}], "]"}], "//", 
     "Simplify"}]}]}], ";"}]}], "Input",
