Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "EMAll", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EMAll", "[", 
    RowBox[{"a_", ",", "b_", ",", "rep1_", ",", "rep2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"EMAll", "[", 
     RowBox[{"a", ",", "b", ",", "rep1", ",", "rep2"}], "]"}], "=", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"EM", "[", 
        RowBox[{"a", ",", "b", ",", "rep1"}], "]"}], ",", 
       RowBox[{"Id", "[", "rep2", "]"}]}], "]"}], "+", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"Id", "[", "rep1", "]"}], ",", 
       RowBox[{"EM", "[", 
        RowBox[{"a", ",", "b", ",", "rep2"}], "]"}]}], "]"}]}]}]}], 
  ";"}]}], "Input",
