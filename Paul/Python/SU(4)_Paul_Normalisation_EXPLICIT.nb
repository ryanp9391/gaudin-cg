    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", "a_"}], "}"}], "->", "1"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dim", "[", "rep1", "]"}], ",", 
        RowBox[{"dim", "[", "rep1", "]"}]}], "}"}]}], "]"}]}]}], 
