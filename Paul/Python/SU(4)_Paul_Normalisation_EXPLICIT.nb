    RowBox[{"F", "[", 
     RowBox[{
     "rep1_", ",", "rep2_", ",", "C1_", ",", "\[IndentingNewLine]", "C2_"}], 
     "]"}], "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"rep1", ",", "rep2", ",", "C1", ",", "C2"}], "]"}], "[", "z", 
     "]"}], "=", 
    RowBox[{
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"C1", ",", "C2"}], "}"}], "}"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a_", ",", "b_"}], "}"}], ":>", 
        FractionBox["1", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"z", "-", "w1"}], ")"}], 
           RowBox[{
            RowBox[{"rep1", "[", 
             RowBox[{"[", "a", "]"}], "]"}], "-", "a", "+", "1"}]], "*", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"z", "-", "w2"}], ")"}], 
           RowBox[{
            RowBox[{"rep2", "[", 
             RowBox[{"[", "b", "]"}], "]"}], "-", "b", "+", "1"}]]}]]}]}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}]}], "Input",
