  RowBox[{"[", "M", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Imposing Cartan eigenvalues\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VacL", "[", 
   RowBox[{
   "rep1T", ",", "rep2T", ",", "\[Alpha]12", ",", "\[Alpha]13", ",", 
    "\[Alpha]14", ",", "\[Alpha]23", ",", "\[Alpha]24", ",", "\[Alpha]34"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SolCartNorm", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"EMAll", "[", 
        RowBox[{"1", ",", "1", ",", "rep1T", ",", "rep2T"}], "]"}], ".", 
       "vecT"}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{"repAllT", "[", 
         RowBox[{"[", "M", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "*", "vecT"}]}], "&&", 
     RowBox[{
      RowBox[{
       RowBox[{"EMAll", "[", 
        RowBox[{"2", ",", "2", ",", "rep1T", ",", "rep2T"}], "]"}], ".", 
       "vecT"}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{"repAllT", "[", 
         RowBox[{"[", "M", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], "*", "vecT"}]}], "&&", 
     RowBox[{
      RowBox[{
       RowBox[{"EMAll", "[", 
        RowBox[{"3", ",", "3", ",", "rep1T", ",", "rep2T"}], "]"}], ".", 
       "vecT"}], "==", 
      RowBox[{
       RowBox[{
