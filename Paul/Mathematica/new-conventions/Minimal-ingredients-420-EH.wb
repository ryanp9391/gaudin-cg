      {
       "data": "Out[555]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\mu  & \\text{mult} & \\text{dim sector clean (site 1)} & \\text{sector HW rel. sv, $\\varepsilon$=10\\^{}-4} & \\text{$\\varepsilon$=10\\^{}-5} & \\text{per-copy HW rel. sv ($\\varepsilon$=10\\^{}-5)} & \\text{end to end per copy: \\{space, rel. err ($\\varepsilon$=10\\^{}-5, $\\varphi$'), digits\\}}\\\\\\hline\\left\\{8,3,1\\right\\} & 1 & 3 & \\left\\{1.\\,\\right\\} & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}1.\\,\\end{pmatrix} & \\begin{pmatrix}\\text{sector} & 7.47\\times 10^{-8} & 198\\end{pmatrix}\\\\\\hline\\left\\{8,2,2\\right\\} & 1 & 3 & \\left\\{1.\\,\\right\\} & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}1.\\,\\end{pmatrix} & \\begin{pmatrix}\\text{sector} & 3.84\\times 10^{-6} & 192\\end{pmatrix}\\\\\\hline\\left\\{7,5,0\\right\\} & 1 & 3 & \\left\\{1.\\,\\right\\} & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}1.\\,\\end{pmatrix} & \\begin{pmatrix}\\text{sector} & 2.21\\times 10^{-7} & 200\\end{pmatrix}\\\\\\hline\\left\\{7,4,1\\right\\} & 2 & 2 & \\left\\{1.\\,,0.0437\\right\\} & \\left\\{1.\\,,0.0437\\right\\} & \\begin{pmatrix}1.\\, & 0.0000289\\\\1.\\, & 0.0000312\\end{pmatrix} & \\begin{pmatrix}\\text{sector} & 2.92\\times 10^{-7} & 189\\\\\\text{sector} & 1.14\\times 10^{-6} & 189\\end{pmatrix}\\\\\\hline\\left\\{7,3,2\\right\\} & 2 & 2 & \\left\\{1.\\… [latex truncated: 3167 chars total]",
