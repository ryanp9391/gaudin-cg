       "data": "Out[816]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{\\# HW states above} & \\text{‖K‖/‖S‖ (stacked)} & \\text{residual vs one-step nbrs} & \\text{residual vs all above, $\\varepsilon$=10\\^{}-6} & \\text{2$\\times$10\\^{}-6}\\\\\\hline\\left\\{8,3,1\\right\\} & 1 & 0 & 2.1\\times 10^{-8} & 1.\\, & 1.\\, & 1.\\,\\\\\\hline\\left\\{8,2,2\\right\\} & 1 & 1 & 1.4 & 0.053 & 0.053 & 0.053\\\\\\hline\\left\\{7,5,0\\right\\} & 1 & 0 & 1.8\\times 10^{-8} & 1.\\, & 1.\\, & 1.\\,\\\\\\hline\\left\\{7,4,1\\right\\} & 1 & 2 & 1.9\\times 10^{-6} & 0.63 & 0.63 & 0.63\\\\\\hline\\left\\{7,4,1\\right\\} & 2 & 2 & 5.5\\times 10^{-7} & 0.61 & 0.61 & 0.61\\\\\\hline\\left\\{7,3,2\\right\\} & 1 & 5 & 0.71 & 0.14 & 0.12 & 0.12\\\\\\hline\\left\\{7,3,2\\right\\} & 2 & 5 & 1.2 & 0.066 & 0.061 & 0.061\\\\\\hline\\left\\{6,6,0\\right\\} & 1 & 1 & 1.2 & 0.28 & 0.28 & 0.28\\\\\\hline\\left\\{6,5,1\\right\\} & 1 & 5 & 0.68 & 0.45 & 0.38 & 0.38\\\\\\hline\\left\\{6,5,1\\right\\} & 2 & 5 & 1.00 & 0.49 & 0.20 & 0.20\\\\\\hline\\left\\{6,4,2\\right\\} & 1 & 10 & 0.30 & 0.20 & 0.15 & 0.15\\\\\\hline\\left\\{6,4,2\\right\\} & 2 & 10 & 0.59 & 0.21 & 0.15 & 0.15\\\\\\hline\\left\\{6,4,2\\right\\} & 3 & 10 & 2.2 & 0.21 & 0.14 & 0.14\\\\\\hline\\left\\{6,3,3\\right\\} & 1 & 13 & 0.87 & 0.69 & 0.088 & 0.088\\\\\\hline\\left\\{5,5… [latex truncated: 1514 chars total]",
