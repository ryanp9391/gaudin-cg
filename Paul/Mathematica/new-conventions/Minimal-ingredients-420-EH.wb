      {
       "data": "Out[805]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\mu  & \\text{k\\textasciitilde{} (11, 22, 32, 42)} & \\text{s\\textasciitilde{} (11, 22, 32, 42)} & \\text{‖k($\\varepsilon$)-k(2$\\varepsilon$)‖ (size of O($\\varepsilon$) term)} & \\text{k\\textasciitilde{} rationalized} & \\text{s\\textasciitilde{} rationalized}\\\\\\hline\\left\\{8,3,1\\right\\} & \\left\\{0.\\times 10^{-226},0.\\times 10^{-226},-1.922751747\\times 10^{-14},4.858348969\\times 10^{-21}\\right\\} & \\left\\{0.\\times 10^{-226},0.\\times 10^{-226},-1.0000000000,1.\\,\\right\\} & 2.1\\times 10^{-8} & \\left\\{0,0,0,0\\right\\} & \\left\\{0,0,-1,1\\right\\}\\\\\\hline\\left\\{8,2,2\\right\\} & \\left\\{0.\\times 10^{-212},0.\\times 10^{-212},-0.7714285714,0.7714285714\\right\\} & \\left\\{0.\\times 10^{-213},0.\\times 10^{-213},0.\\times 10^{-213},1.\\,\\right\\} & 4.3\\times 10^{-8} & \\left\\{0,0,-\\frac{27}{35},\\frac{27}{35}\\right\\} & \\left\\{0,0,0,1\\right\\}\\\\\\hline\\left\\{7,5,0\\right\\} & \\left\\{-3.813051809\\times 10^{-14},-6.431655372\\times 10^{-14},3.215830163\\times 10^{-14},-2.841243712\\times 10^{-21}\\right\\} & \\left\\{1.0000000000,2.000000000,-2.000000000,1.\\,\\right\\} & 3.5\\times 10^{-8} & \\left\\{0,0,0,0\\right\\} & \\left\\{1,2,-2,1\\right\\}\\\\\\hline\\left\\{6,6,0\\right\\} & \\left\\{0.7714285714,1.54285… [latex truncated: 2454 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "5239d7a1-3565-4938-886f-8a26a30b9a6e"
