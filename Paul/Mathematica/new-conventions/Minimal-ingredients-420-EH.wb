   "kind": 2,
   "value": "(* fair test: clean vectors fitted at (εfit, φ, ω) are applied at ε = 10^-4, 10^-5 and to the states of a different ket direction φ' (states, eigenvalues and Q-numbers recomputed there). \"digits\" = correct digits of the relative error *)\nφp = {-2/5, 3/8, 7/11};\n{tF, fairTab} = AbsoluteTiming[Table[With[{vs = If[μc[[1]] === {6, 4, 2}, cleanOne[μc[[1]], μc[[2]]], cleanSpace[μc[[1]]]]},\n     Join[{μc[[1]], μc[[2]], If[μc[[1]] === {6, 4, 2}, \"per copy\", \"sector\"]}, reconHW[μc[[1]], μc[[2]], 10^-5, vs, φ], reconHW[μc[[1]], μc[[2]], 10^-4, vs, φp], reconHW[μc[[1]], μc[[2]], 10^-5, vs, φp]]], {μc, nonTop}]];\nGrid[Join[{{\"μ\", \"copy\", \"clean space\", \"rel. err, ε=10^-5, φ\", \"angle\", \"digits\", \"rel. err, ε=10^-4, φ'\", \"angle\", \"digits\", \"rel. err, ε=10^-5, φ'\", \"angle\", \"digits\"}}, fairTab, {{\"time (s)\", tF, \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
