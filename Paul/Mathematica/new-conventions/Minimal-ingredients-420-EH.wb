      {
       "data": "Out[764]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{p(‖$\\Psi$‖)} & \\text{p\\_S per insertion \\{1, 2, 3, 4, 5, 6, 7\\}} & \\text{p\\_K per insertion}\\\\\\hline\\left\\{8,3,1\\right\\} & 1 & -5.\\, & \\left\\{\\text{-},\\text{-},-4.\\,,-4.\\,,-4.\\,,-4.\\,,-4.\\,\\right\\} & \\left\\{\\text{-},\\text{-},-3.\\,,-3.\\,,-3.\\,,-3.\\,,-3.\\,\\right\\}\\\\\\hline\\left\\{8,2,2\\right\\} & 1 & -6.\\, & \\left\\{\\text{-},\\text{-},\\text{-},-4.\\,,\\text{-},-4.\\,,-4.\\,\\right\\} & \\left\\{\\text{-},\\text{-},-4.\\,,-4.\\,,-4.\\,,-4.\\,,-4.\\,\\right\\}\\\\\\hline\\left\\{7,5,0\\right\\} & 1 & -5.\\, & \\left\\{-4.\\,,-4.\\,,-4.\\,,-4.\\,,\\text{-},\\text{-},-4.\\,\\right\\} & \\left\\{-3.\\,,-3.\\,,-3.\\,,-3.\\,,\\text{-},\\text{-},-3.\\,\\right\\}\\\\\\hline\\left\\{7,4,1\\right\\} & 1 & -6.\\, & \\left\\{-5.\\,,-5.\\,,-5.\\,,-5.\\,,-5.\\,,-5.\\,,-5.\\,\\right\\} & \\left\\{-4.\\,,-4.\\,,-4.\\,,-4.\\,,-4.\\,,-4.\\,,-4.\\,\\right\\}\\\\\\hline\\left\\{7,4,1\\right\\} & 2 & -6.\\, & \\left\\{-5.\\,,-5.\\,,-5.\\,,-5.\\,,-5.\\,,-5.\\,,-5.\\,\\right\\} & \\left\\{-4.\\,,-4.\\,,-4.\\,,-4.\\,,-3.99,-3.99,-3.98\\right\\}\\\\\\hline\\left\\{7,3,2\\right\\} & 1 & -7.\\, & \\left\\{\\text{-},\\text{-},-5.\\,,-5.\\,,\\text{-},-5.\\,,-5.\\,\\right\\} & \\left\\{-5.\\,,-5.\\,,-5.\\,,-5.\\,,-5.\\,,-5.\\,,-5.\\,\\right\\}\\\\\\hline\\left\\{7,3,2\\right\\} & 2 & -7.\\, & \\left\\{… [latex truncated: 3507 chars total]",
