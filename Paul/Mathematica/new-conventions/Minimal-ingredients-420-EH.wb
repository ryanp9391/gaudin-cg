       "data": "Out[774]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{(a) $\\mu$} & \\text{copy} & \\text{spread of k, s over directions ($\\varepsilon$ = 10\\^{}-5)} &  & \\\\\\hline\\left\\{8,3,1\\right\\} & 1 & 0.0014 &  & \\\\\\hline\\left\\{8,2,2\\right\\} & 1 & 0.0014 &  & \\\\\\hline\\left\\{7,5,0\\right\\} & 1 & 0.00064 &  & \\\\\\hline\\left\\{7,4,1\\right\\} & 1 & 0.00013 &  & \\\\\\hline\\left\\{7,4,1\\right\\} & 2 & 0.00037 &  & \\\\\\hline\\left\\{7,3,2\\right\\} & 1 & 0.000062 &  & \\\\\\hline\\left\\{7,3,2\\right\\} & 2 & 0.00042 &  & \\\\\\hline\\left\\{6,6,0\\right\\} & 1 & 0.00019 &  & \\\\\\hline\\left\\{6,5,1\\right\\} & 1 & 0.000033 &  & \\\\\\hline\\left\\{6,5,1\\right\\} & 2 & 0.00017 &  & \\\\\\hline\\left\\{6,4,2\\right\\} & 1 & 0.000042 &  & \\\\\\hline\\left\\{6,4,2\\right\\} & 2 & 0.000074 &  & \\\\\\hline\\left\\{6,4,2\\right\\} & 3 & 0.00025 &  & \\\\\\hline\\left\\{6,3,3\\right\\} & 1 & 0.000052 &  & \\\\\\hline\\left\\{5,5,2\\right\\} & 1 & 0.000035 &  & \\\\\\hline\\left\\{5,4,3\\right\\} & 1 & 0.000047 &  & \\\\\\hline\\left\\{5,4,3\\right\\} & 2 & 0.000055 &  & \\\\\\hline\\left\\{4,4,4\\right\\} & 1 & 0.000060 &  & \\\\\\hline\\text{(b) $\\mu$} & \\text{mult} & \\text{dim clean space} & \\text{HW-restricted rel. sv, $\\varepsilon$=10\\^{}-4} & \\text{$\\varepsilon$=10\\^{}-5}\\\\\\hline\\left\\{8,3,1\\right\\} & 1 & 6 & \\left… [latex truncated: 2290 chars total]",
