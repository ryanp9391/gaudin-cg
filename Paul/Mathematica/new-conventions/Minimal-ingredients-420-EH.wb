      {
       "data": "Out[545]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{clean space} & \\text{rel. err, $\\varepsilon$=10\\^{}-5, $\\varphi$} & \\text{angle} & \\text{digits} & \\text{rel. err, $\\varepsilon$=10\\^{}-4, $\\varphi$'} & \\text{angle} & \\text{digits} & \\text{rel. err, $\\varepsilon$=10\\^{}-5, $\\varphi$'} & \\text{angle} & \\text{digits}\\\\\\hline\\left\\{8,3,1\\right\\} & 1 & \\text{sector} & 1.03\\times 10^{-13} & 0.\\times 10^{-105} & 197 & 8.77\\times 10^{-11} & 0.\\times 10^{-105} & 200 & 8.82\\times 10^{-13} & 0.\\times 10^{-104} & 197\\\\\\hline\\left\\{8,2,2\\right\\} & 1 & \\text{sector} & 1.66\\times 10^{-6} & 0.\\times 10^{-99} & 193 & 6.48\\times 10^{-6} & 0.\\times 10^{-100} & 195 & 8.14\\times 10^{-7} & 0.\\times 10^{-99} & 192\\\\\\hline\\left\\{7,5,0\\right\\} & 1 & \\text{sector} & 3.46\\times 10^{-13} & 0.\\times 10^{-104} & 196 & 1.25\\times 10^{-10} & 0.\\times 10^{-104} & 200 & 1.20\\times 10^{-12} & 0.\\times 10^{-104} & 197\\\\\\hline\\left\\{7,4,1\\right\\} & 1 & \\text{sector} & 6.07\\times 10^{-7} & 5.87\\times 10^{-7} & 192 & 4.93\\times 10^{-6} & 4.72\\times 10^{-6} & 194 & 4.93\\times 10^{-7} & 4.72\\times 10^{-7} & 192\\\\\\hline\\left\\{7,4,1\\right\\} & 2 & \\text{sector} & 7.58\\times 10^{-6} & 5.19\\times 10^{-6… [latex truncated: 3563 chars total]",
       "mime": "text/plain"
