       "data": "Out[874]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{$\\mu$ (mult 1)} & \\text{status} & \\text{quantity} & \\text{closed form in t} & \\text{total degree} & \\text{validation error}\\\\\\hline\\left\\{4,1,1\\right\\} & \\text{clean} & \\text{s\\{1, 1\\}} & 0 & 0 & 0\\\\\\hline\\left\\{4,1,1\\right\\} & \\text{clean} & \\text{s\\{2, 1\\}} & 1 & 0 & 0.\\times 10^{-171}\\\\\\hline\\left\\{3,3,0\\right\\} & \\text{clean} & \\text{s\\{1, 1\\}} & -1 & 0 & 1.25\\times 10^{-25}\\\\\\hline\\left\\{3,3,0\\right\\} & \\text{clean} & \\text{s\\{2, 1\\}} & 1 & 0 & 0.\\times 10^{-171}\\\\\\hline\\left\\{2,2,2\\right\\} & \\text{contaminated} & \\text{k\\{1, 1\\}} & -\\frac{T-1}{2\\,T-3} & 2 & 3.17\\times 10^{-24}\\\\\\hline\\left\\{2,2,2\\right\\} & \\text{contaminated} & \\text{k\\{2, 1\\}} & 1 & 0 & 0.\\times 10^{-141}\\\\\\hline\\left\\{2,2,2\\right\\} & \\text{contaminated} & \\text{s\\{1, 1\\}} & 0 & 0 & 0\\\\\\hline\\left\\{2,2,2\\right\\} & \\text{contaminated} & \\text{s\\{2, 1\\}} & 1 & 0 & 0.\\times 10^{-151}\\\\\\hline\\left\\{2,2,2\\right\\} & \\text{contaminated} & \\rho  & \\frac{1}{3}\\,\\left(2\\,T-3\\right) & 1 & 4.55\\times 10^{-24}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{$\\mu$ (mult 2)} & \\text{status} & \\text{quantity} & \\text{\\{A(t), B(t)\\} in a\\_c = A + B $\\lambda$\\_… [latex truncated: 2030 chars total]",
