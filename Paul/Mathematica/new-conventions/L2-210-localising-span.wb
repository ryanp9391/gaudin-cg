  {
   "kind": 2,
   "value": "(* exploratory: two-vacuum targets with and without the resolvent, (D2,D2) and (D2,D1) dimensions *)\nexplore6[zz_, ww_] := Module[{tc = tZexact[zz], om = oneSiteVac[zz, ww], w1 = ww[[1]], w2 = ww[[2]], Om2, vac, ys, pairsOf, dimOf, tgs},\n  Om2 = Flatten[KroneckerProduct[om, om]]; vac[y_] := oneSiteVac[zz, {w1, y, 1}]; ys = y0 w2;\n  dimOf[Phi_] := Table[t5solve[Om2, Phi, basisOf[tc, pq[[1]]], basisOf[tc, pq[[2]]]][\"dim\"], {pq, {{2, 1}, {2, 2}}}];\n  tgs = {\"vac(3) (x) vac(2)\" -> Flatten[Outer[Times, vac[3], vac[2]]], \"vac(3) (x) vac(y*)\" -> Flatten[Outer[Times, vac[3], vac[ys]]], \"vac(3) (x) om_w\" -> Flatten[Outer[Times, vac[3], om]], \"om_w (x) vac(3)\" -> Flatten[Outer[Times, om, vac[3]]],\n    \"vac(3) rho(1/(3/y0-z)) (x) vac(y*)\" -> Flatten[Outer[Times, vac[3] . ρdiag[1/(3/y0 - zz)], vac[ys]]], \"vac(3) rho(1/(3/y0-z)) (x) vac(3)\" -> Flatten[Outer[Times, vac[3] . ρdiag[1/(3/y0 - zz)], vac[3]]],\n    \"vac(y*) rho(1/(w2-z)) (x) vac(3)\" -> Flatten[Outer[Times, vac[ys] . ρdiag[1/(w2 - zz)], vac[3]]], \"vac(y*) rho(1/(w2-z)) (x) om_w\" -> Flatten[Outer[Times, vac[ys] . ρdiag[1/(w2 - zz)], om]],\n    \"vac(y*) (x) vac(y*) rho(1/(w2-z))\" -> Flatten[Outer[Times, vac[ys], vac[ys] . ρdiag[1/(w2 - zz)]]], \"om_w rho(1/z) (x) vac(3)\" -> Flatten[Outer[Times, om . ρdiag[1/zz], vac[3]]], \"vac(3) rho(1/z) (x) om_w\" -> Flatten[Outer[Times, vac[3] . ρdiag[1/zz], om]]};\n  Table[t[[1]] -> dimOf[t[[2]]], {t, tgs}]];\n{tX6, ex6P1} = AbsoluteTiming[explore6[zP1, wP1]];\nex6P1c = explore6[zP1c, wP1c];\nGrid[Join[{{\"time (s)\", tX6}, {\"entries {dim (D2,D1), dim (D2,D2)}; P1\", \"\"}}, Table[{t[[1]], ToString[t[[2]]]}, {t, ex6P1}], {{\"P1'\", \"\"}}, Table[{t[[1]], ToString[t[[2]]]}, {t, ex6P1c}]], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
