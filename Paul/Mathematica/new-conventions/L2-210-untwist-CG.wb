  {
   "kind": 2,
   "value": "(* finalRun[] works at the CURRENT chain point (hN, thN) with phi = phiP. Q-side inputs: Qnum(B) = R_Q(B)/R_Q(top) <v1(x)v2|e1(x)e1>/<x0|e1(x)e1> (vacuum Q's of (w1,w2,w3), dual Q's of the branches), the top-killing Q-number T(B) = delta^Lambda s <v2(x)v2|Psi>/<x0|Psi> (det6 with the vacuum Q's of (w1, y)), the closed forms kappa = 2(t-3)/(3(t-2)), Delta_c = (1-t^2) + t tau_c/(3(t+3)), and tau_c from the dual-Q dictionary t2(theta1+h) = chi3 nu1(theta1+h) nu2(theta1) Q^j(theta1-h)/Q^j(theta1) (j = 1,2,3). Chain side: P_HW Psi slices. eps = 1e-6, 2e-6, 4e-6. *)\nfm[x_] := With[{m = N[Re[x]]}, If[m == 0., \"0\", With[{e = Floor[Log10[Abs[m]]]}, ToString[N[Round[m/10^e, 0.001]]] <> \"e\" <> ToString[e]]]];\nscl = {2, 3, 3, 4, 4, 6};\nqPoint[ie_, om_] := Module[{R = reg[epsL5[[ie]], phiP, om[[1]], om[[2]]], B, zz, sts, vq, vq2, rq, rt, V, x0, topFac, v2, v2v2, topOv, qn, Tq},\n  zz = R[\"z\"]; B = branchesAt[zz]; sts = Table[brOf[B, hwList[[ib, 1]], hwList[[ib, 2]]][\"st\"], {ib, 6}];\n  vq = vacQs[{R[\"w1\"], R[\"w2\"], 1 + R[\"eps\"] 5/13}]; rq = Table[rQ[st, vq, R[\"y\"]], {st, sts}];\n  V = vecsAt[R]; x0 = x0Of[N[zz, pr]]; topFac = (V[\"v12\"] . u12e12)/(x0 . u12e12); qn = rq/rq[[1]] topFac;\n  v2 = u12v2[zz, R[\"w1\"], R[\"y\"]]; v2v2 = N[Flatten[KroneckerProduct[v2, v2]], pr]; topOv = (v2v2 . u12e12)/(x0 . u12e12);\n  vq2 = vacQs[{R[\"w1\"], R[\"y\"], 1 + R[\"eps\"] 5/13}]; rt = Table[det6[st, vq2[\"F\"]]/psiQ[st], {st, sts}];\n  Tq = deltaL[R] v2[[1]] rt/rt[[1]] topOv;\n  <|\"qnum\" -> qn, \"Tq\" -> Tq, \"dl\" -> deltaL[R], \"R\" -> R|>];\nfinalRun[] := Module[{tt = t12, qd, chBr, ph, chC, cq, rows = {}, idx201, idx120},\n  chBr = Table[branchesAt[reg[epsL5[[ie]], phiP, 1, 1][\"z\"]], {ie, 3}];\n  qd = Association[Join[Table[{1, io} -> qPoint[1, omGrid[[io]]], {io, 18}], Flatten[Table[{ie, io} -> qPoint[ie, omGrid[[io]]], {ie, 2, 3}, {io, 6}], 1]]];\n  idx201 = First[idxOf[{2, 0, 1}]]; idx120 = First[idxOf[{1, 2, 0}]];\n  ph[ie_, ib_] := With[{b = brOf[chBr[[ie]], hwList[[ib, 1]], hwList[[ib, 2]]]}, PHWc[b[\"mu\"]][b[\"psi\"]]];\n  chC[ie_, ib_] := Switch[ib, 1, ph[ie, 1][[1]], 2, ph[ie, 2][[(idx201 - 1) d1 + 1]], 3, ph[ie, 3][[(idx120 - 1) d1 + 1]], 4 | 5, (uV + upV) . ph[ie, ib][[(idx111 - 1) d1 + 1]], 6, ph[ie, 6][[(idx012s - 1) d1 + 1]]];\n  cq[ie_, io_, ib_] := With[{d = qd[{ie, io}], om = omGrid[[io]]}, Switch[ib, 1, d[\"qnum\"][[1]]/d[\"dl\"], 2, d[\"qnum\"][[2]]/(d[\"dl\"] c0G[phiP, om]), 3, d[\"qnum\"][[3]]/(d[\"dl\"] a0G[phiP, om]), 4 | 5, d[\"qnum\"][[ib]]/(d[\"dl\"] a0G[phiP, om] c0G[phiP, om]), 6, d[\"qnum\"][[6]]/(kapOf[tt] phi012[d[\"R\"]])]];\n  Table[Module[{err1, fq, fc, rq, rc, expo},\n    err1 = Max[Table[Abs[cq[1, io, ib]/chC[1, ib] - 1], {io, 18}]];\n    fq = Table[cq[ie, 1, ib] epsL5[[ie]]^scl[[ib]], {ie, 3}]; fc = Table[chC[ie, ib] epsL5[[ie]]^scl[[ib]], {ie, 3}];\n    rq = rich[fq][[3]]; rc = rich[fc][[3]];\n    expo = Log[Abs[chC[2, ib]/chC[1, ib]]]/Log[2];\n    AppendTo[rows, <|\"ib\" -> ib, \"err1\" -> err1, \"Qlim\" -> rq, \"Clim\" -> rc, \"agree\" -> Abs[rq/rc - 1], \"expo\" -> expo|>]], {ib, 6}];\n  Do[Module[{b3 = Table[brOf[chBr[[ie]], {3, 2, 1}, c], {ie, 3}], taus, tauQ, tauE, Fq, g, sl, Rc, Dl, Rq},\n     taus = Table[Table[(Times @@ b[\"st\"][\"z\"]) auditNu[hN, thN, 1, th1 + hN] auditNu[hN, thN, 2, th1] QUf[b[\"st\"], j, th1 - hN]/QUf[b[\"st\"], j, th1], {j, 3}], {b, b3}];\n     tauQ = Table[rich[taus[[All, j]]][[3]]/hN^4, {j, 3}];\n     tauE = rich[Table[b[\"tt\"][[2]] /. u -> th1 + hN, {b, b3}]][[3]]/hN^4;\n     Fq = Table[vandInv . Table[epsL5[[ie]]^4 (qd[{ie, io}][\"qnum\"][[3 + c]] - qd[{ie, io}][\"Tq\"][[3 + c]])/(qd[{ie, io}][\"dl\"] a0G[phiP, omGrid[[io]]] c0G[phiP, omGrid[[io]]]), {ie, 3}], {io, 6}];\n     g = Fq[[All, 2]]/Fq[[All, 1]]; sl = lineFit[om2s, g];\n     Rc = rich[Table[With[{C = PHWc[{3, 2, 1}][b[\"psi\"]][[(idx111 - 1) d1 + 1]]}, (uV . C)/((uV + upV) . C)], {b, b3}]][[3]];\n     Dl = (1 - tt^2) + tt tauQ[[1]]/(3 (tt + 3));\n     Rq = (Dl - sl[[1]])/(tt - 2);\n     AppendTo[rows, <|\"oct\" -> c, \"F0Q\" -> Fq[[1, 1]], \"slopeQ\" -> sl[[1]], \"lineRes\" -> sl[[3]], \"tauQ\" -> tauQ[[1]], \"tauSpreadj\" -> Max[Abs[tauQ/tauQ[[1]] - 1]], \"tauE\" -> tauE, \"tauDiff\" -> Abs[tauQ[[1]]/tauE - 1], \"Delta\" -> Dl, \"RQ\" -> Rq, \"Rchain\" -> Rc, \"RDiff\" -> Abs[Rq - Rc]|>]], {c, 2}];\n  <|\"rows\" -> rows, \"t\" -> tt|>];\nshowFinal[res_] := Module[{r = res[\"rows\"]},\n  Grid[Join[{{\"branch\", \"max err at eps=1e-6 (18 om)\", \"Q limit\", \"chain limit\", \"|Q/chain-1|\", \"chain eps-exponent\"}},\n    Table[{ToString[hwList[[i, 1]]] <> \"#\" <> ToString[hwList[[i, 2]]], fm[r[[i, \"err1\"]]], N[Re[r[[i, \"Qlim\"]]], 10], N[Re[r[[i, \"Clim\"]]], 10], fm[r[[i, \"agree\"]]], N[Re[r[[i, \"expo\"]]], 5]}, {i, 6}],\n    {{\"octet\", \"F0 (Q, 3 eps)\", \"slope_Q\", \"tau_Q (j=1)\", \"tau_eig\", \"|tau_Q/tau_eig-1|, j-spread\"}},\n    Table[{r[[6 + c, \"oct\"]], N[Re[r[[6 + c, \"F0Q\"]]], 10], N[Re[r[[6 + c, \"slopeQ\"]]], 10], N[Re[r[[6 + c, \"tauQ\"]]], 10], N[Re[r[[6 + c, \"tauE\"]]], 10], fm[r[[6 + c, \"tauDiff\"]]] <> \", \" <> fm[r[[6 + c, \"tauSpreadj\"]]]}, {c, 2}],\n    {{\"octet\", \"Delta_c closed form\", \"R_c^Q = (Delta-slope)/(t-2)\", \"R_c chain\", \"|R^Q - R^chain|\", \"line resid\"}},\n    Table[{r[[6 + c, \"oct\"]], N[Re[r[[6 + c, \"Delta\"]]], 10], N[Re[r[[6 + c, \"RQ\"]]], 10], N[Re[r[[6 + c, \"Rchain\"]]], 10], fm[r[[6 + c, \"RDiff\"]]], fm[r[[6 + c, \"lineRes\"]]]}, {c, 2}]], Frame -> All, Alignment -> Left]];\n(* P1 *)\nsetPoint[1/2, {2/7, -3/5}];\n{tF1, fin1} = AbsoluteTiming[finalRun[]];\nshowFinal[fin1]",
   "languageId": "wolfram",
   "outputs": [],
