  {
   "kind": 2,
   "value": "(* P3: h = 1/2, theta = (3/7, -1/4), t = 19/14 (NOT in any fit set); y0 finite, no om component equal to a phi component *)\nsetPoint[1/2, {3/7, -1/4}];\nchecks[\"P3 point: (h, theta, t, y0), no om component equals a phi component\"] = {hN, thN, t12, y0, And @@ Flatten[Table[! MemberQ[phiP, o], {o, Union[Flatten[omGrid]]}]], t12 =!= 2 && t12 =!= -3};\n{tF3, fin3} = AbsoluteTiming[finalRun[]];\nsetPoint[1/2, {2/7, -3/5}];\nshowFinal[fin3]",
