      {
       "data": "Out[410]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{rep} & \\text{states} & \\text{$\\delta$t: 3 unknowns} & \\text{max offdiag/diag (det N)} & \\text{\\# good row triples /84} & \\text{min sv (A=B)} & \\text{max sv (A$\\not=$B)}\\\\\\hline3,1,0 & 15 & \\mathrm{True} & 1.40\\times 10^{-45} & 77 & 1.04 & 6.37\\times 10^{-40}\\\\\\hline2,1,0 & 8 & \\mathrm{True} & 1.58\\times 10^{-54} & 77 & 1.09 & 1.66\\times 10^{-58}\\\\\\hline3,2,0 & 15 & \\mathrm{True} & 1.78\\times 10^{-47} & 77 & 1.12 & 4.28\\times 10^{-41}\\\\\\hline2,1,1 & 3 & \\mathrm{True} & 4.18\\times 10^{-69} & 77 & 1.05 & 0.\\times 10^{-29}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
