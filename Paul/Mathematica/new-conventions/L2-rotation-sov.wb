  {
   "kind": 2,
   "value": "(* w' = (7/4,-2/5,9/7) has a negative eigenvalue, so (-2/5)^(-x/h) makes its data complex and the real projective fit above stalls.\n   Redo with a second REAL positive twist w'' *)\nw3N = {9/4, 4/3, 5/7};\nGPw3 = Simplify[Paux . Gc[ws] . Inverse[Paux]] /. Join[Thread[zs -> zN], Thread[ws -> w3N]];\nrOm3 = {(w[1] - z[1])/(w[1] - z[2]), ((w[1] - z[1]) (-w[2] + z[1]) (z[2] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (w[2] - z[3])), ((w[1] - z[2]) (-w[2] + z[2]) (z[1] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (-w[2] + z[3]))} /. Join[Thread[zs -> zN], Thread[ws -> w3N]];\nΩ1c = First[{UnitVector[d1, 1]} . MatrixExp[rOm3[[1]] Ee[1, 2]] . MatrixExp[rOm3[[2]] Ee[1, 3]] . MatrixExp[rOm3[[3]] Ee[2, 3]]]; Ω2c = Flatten[KroneckerProduct[Ω1c, Ω1c]];\ntW3 = Table[tPoly[GPw3, a], {a, 3}];\ntauVac3 = Table[Expand[(Ω2c . tW3[[a]])[[kOm]]/Ω2c[[kOm]]], {a, 3}];\nqdVac3 = Table[solveQ[opDir, N[tauVac3, prec], w3N[[i]], -1], {i, 3}];\nFvac3 = Function[{i, x}, N[w3N[[i]]^(-x/hN), prec] (qdVac3[[i]] /. X -> x)];\nchecks[\"8: w'': Ω⊗Ω ∝ det6L[{Fvac'',Fvac''}]/Psi_Q\"] = constQ[Table[(Flatten[KroneckerProduct[Ωc[w3N], Ωc[w3N]]] . ketC[[B]])/(x0C . ketC[[B]])/(det6L[B, {Fvac3, Fvac3}]/psiQ[B]), {B, nS}]];\nTA3 = Table[(Flatten[KroneckerProduct[Ωc[w3N], uv[1]]] . ketC[[B]])/(x0C . ketC[[B]]), {B, nS}];\nGw3 = Gof[Fvac3];\nchecks[\"8: data real at w and w''\"] = {Max[Abs[Im[Flatten[{TA, TA3}]]]], Max[Abs[Im[Flatten[{Gw, Gw3}]]]]};\n(* projective joint fit, real: r_w = (det_w - T)/|T| (lambda = 1), r_w'' = P_perp det_w''/|det_w''| *)\nThat3 = TA3/Norm[TA3];\nresPJ3[w_] := Module[{W = ArrayReshape[w, {2, 3, 6}], d3}, d3 = detW[Gw3, W]; Join[(detW[Gw, W] - TA)/Norm[TA], (d3 - (That3 . d3) That3)/Norm[d3]]];\njacPJ3[w_] := Module[{W = ArrayReshape[w, {2, 3, 6}], d3, J3, n, g}, d3 = detW[Gw3, W]; J3 = jacW[Gw3, W]; n = Norm[d3]; g = (d3 - (That3 . d3) That3)/n;\n   Join[jacW[Gw, W]/Norm[TA], (J3 - Outer[Times, That3, That3 . J3])/n - Outer[Times, g, d3 . J3]/n^2]];\nlmPJ3[st_, nIt_] := Block[{$MinPrecision = 60, $MaxPrecision = 60}, Module[{w = SetPrecision[Re[st], 60], mu = 10^-3, r, J, dw, wn, rn, rc, traj = {}},\n    rc = Norm[resPJ3[w]];\n    Do[r = resPJ3[w]; J = jacPJ3[w];\n     dw = -LinearSolve[Transpose[J] . J + mu IdentityMatrix[36], Transpose[J] . r];\n     wn = w + dw; rn = Norm[resPJ3[wn]];\n     If[rn < rc, w = wn; rc = rn; mu = Max[mu/3, 10^-40], mu = 10 mu];\n     If[Mod[it, 100] == 0, AppendTo[traj, rc]];\n     If[rc < 10^-45, Break[]], {it, nIt}];\n    {rc, w, traj}]];\npj3Runs = Table[lmPJ3[s, 500], {s, {wCur[[2]], scaleW[SetPrecision[Flatten[Wnat], 60]]}}];\npj3Best = First[SortBy[pj3Runs, First]];\nchecks[\"8: projective joint (w, w'') fit: w part / w'' angle at best\"] = With[{r = resPJ3[pj3Best[[2]]]}, {Norm[r[[1 ;; 64]]], Norm[r[[65 ;; 128]]]}];\nN[{checks[\"8: w'': Ω⊗Ω ∝ det6L[{Fvac'',Fvac''}]/Psi_Q\"], checks[\"8: data real at w and w''\"], Table[{r[[1]], r[[3]]}, {r, pj3Runs}], checks[\"8: projective joint (w, w'') fit: w part / w'' angle at best\"]}, 3]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"485294\" data-output-id=\"177\" data-out-n=\"2235\" data-sub-idx=\"21\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"51\" data-sub-start=\"31\" data-sub-end=\"31\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[2235]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:5.7241em;vertical-align:-2.6121em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.1121em;\"><span style=\"top:-5.698em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3.588em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"></span></span><span style=\"top:-1.4979em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.6121em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.1121em;\"><span style=\"top:-5.698em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">{</span></span><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8641em;\"><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">51</span></span></span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span><span class=\"mclose nulldelimiter\"></span></span></span></span><span style=\"top:-3.588em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen nulldelimiter\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">(</span></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0.271</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0.137</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0.612</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.381</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.306</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.292</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.271</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0.385</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.230</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.181</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.145</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.137</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">)</span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span><span style=\"top:-1.4979em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen nulldelimiter\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0.0977</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0966</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.6121em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
