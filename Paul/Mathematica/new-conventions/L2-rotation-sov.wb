   "value": "(* 12.10 result table: per-weight ranks (numeric, exact in y, union over w1, control omega = y), untwisting orders, HW counts, closed forms *)\nu12rows = Table[{u12wts[[k]], u12dims[[k]], u12rkNum[[k]], u12rkSym[[k]], u12rkU[[k]], u12rkC[[k]], u12leads[[k, 1]]}, {k, Length[u12wts]}];\nu12bools = Select[Normal[KeyDrop[checks, \"12.10 every boolean 12.x check is True\"]], StringStartsQ[First[#], \"12.\"] && MemberQ[{True, False}, Last[#]] &];\nchecks[\"12.10 every boolean 12.x check is True\"] = And @@ Values[Association[u12bools]];\nGrid[Join[{{\"weight mu\", \"dim V_mu\", \"rank numeric (w1=-7/3, 12 y)\", \"rank exact in y\", \"rank union over 3 w1\", \"rank control omega = y\", \"untwisting leading eps-order\"}}, u12rows,\n  {{\"HW count (6 kets)\", \"rank per w1\", checks[\"12.8 HW-count rank per w1 (omega = w2(y)), expect 6\"], \"union over 3 w1\", checks[\"12.8 HW-count rank, union over the three w1\"], \"torus-completed\", checks[\"12.9b torus-completed HW rank (omega = w2(y)), expect 6\"]},\n   {\"HW count, control omega = y\", \"rank per w1\", checks[\"12.8 control (omega = y): HW-count rank per w1\"], \"\", \"\", \"torus-completed\", checks[\"12.9b torus-completed HW rank (control omega = y)\"]},\n   {\"closed forms\", \"b'/(a'c') - (y-omega)/(y-z2)\", checks[\"12.6 (ii) b'/(a'c') - (y - omega)/(y - z2) = 0 exactly\"], \"b' (omega -> y)\", checks[\"12.6 (i) b' numerator vanishes iff omega = y: b' (omega -> y control) = 0\"], \"(0,1,2) = 3b'(a'c'-b')\", checks[\"12.6b (0,1,2) component = 3 b'(a'c' - b') delta^Lambda, exact in y\"]},\n   {\"all boolean checks\", checks[\"12.10 every boolean 12.x check is True\"], \"\", \"\", \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
