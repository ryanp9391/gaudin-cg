  {
   "kind": 2,
   "value": "(* per-ladder brackets (Section 7 of L2-diagonal-frame-overlap.wb): same residue weights, restricted to ladder s; row block s may carry its own bra data F_s *)\nrowLad[B_, F_, {i_, j_}, s_] := Sum[If[p[[1]] == s, wgt[p] With[{x = xP[p]}, {-QU[B, j, x] F[i, x], -x QU[B, j, x] F[i, x], QU[B, j, x] F[i, x + hN], x QU[B, j, x] F[i, x + hN], QU[B, j, x - hN] F[i, x], x QU[B, j, x - hN] F[i, x]}], 0], {p, poles}];\ndet6L[B_, Fs_List] := Det[Flatten[Table[rowLad[B, Fs[[s]], ij, s], {s, nL}, {ij, prsL1}], 1]];\nchecks[\"per-ladder: Ω_w⊗Ω_w ∝ det6L[{Fvac,Fvac}]/Psi_Q\"] = constQ[Table[(Flatten[KroneckerProduct[Ωc[wN], Ωc[wN]]] . ketC[[B]])/(x0C . ketC[[B]])/(det6L[B, {Fvac, Fvac}]/psiQ[B]), {B, nS}]];\nchecks[\"per-ladder: x0 ∝ det6L[{F0,F0}]/Psi_Q\"] = constQ[Table[det6L[B, {F0, F0}]/psiQ[B], {B, nS}]];\nchecks[\"per-ladder: Ω_w⊗e1 ∝ det6L[{Fvac(L=2), F0}]/Psi_Q\"] = constQ[Table[TA[[B]]/(det6L[B, {Fvac, F0}]/psiQ[B]), {B, nS}]];\nFv1 = Function[{i, x}, QDv1[i, x]];\nchecks[\"per-ladder: Ω_w⊗e1 ∝ det6L[{Fvac(L=1), F0}]/Psi_Q\"] = constQ[Table[TA[[B]]/(det6L[B, {Fv1, F0}]/psiQ[B]), {B, nS}]];\nKeyTake[checks, Select[Keys[checks], StringStartsQ[#, \"per-ladder\"] &]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
