       "data": "Out[535]= \\begin{pmatrix}0.\\, & 0.7377515632835786 & 0.\\, & 0.\\, & 0.9739876256570964 & 0.8615326075109729 & 0.\\, & 0.9646931129475469\\\\\\left\\{\\left\\{2\\right\\},\\left\\{2,1\\right\\}\\right\\}\\to \\left\\{-\\frac{167}{35},-\\frac{132}{35},-3,-\\frac{97}{35},-2,-1\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{1,1\\right\\}\\right\\}\\to \\left\\{-\\frac{167}{35},-\\frac{132}{35},-3,-\\frac{97}{35},-1,-1\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\}\\right\\}\\to \\left\\{-\\frac{167}{35},-\\frac{132}{35},-\\frac{97}{35},-2,-1,-1\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{2,0\\right\\}\\right\\}\\to \\left\\{-\\frac{167}{35},-\\frac{132}{35},-3,-\\frac{97}{35},-2,0\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{1,0\\right\\}\\right\\}\\to \\left\\{-\\frac{167}{35},-\\frac{132}{35},-3,-\\frac{97}{35},-1,0\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{0,0\\right\\}\\right\\}\\to \\left\\{-\\frac{167}{35},-\\frac{132}{35},-3,-\\frac{97}{35},0,0\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{1,0\\right\\}\\right\\}\\to \\left\\{-\\frac{167}{35},-\\frac{132}{35},-\\frac{97}{35},-2,-1,0\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{0,0\\right\\}\\right\\}\\to \\left\\{-\\frac{167}{35},-\\frac{132}{35},-\\frac{97}{35},-2,0,0\\right\\}\\end{pmatrix}",
