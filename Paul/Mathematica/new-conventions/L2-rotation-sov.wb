      {
       "data": "Out[669]= \\begin{array}{|c|c|c|c|}\\hline\\text{weight} & \\text{dim V\\_mu} & \\text{rank (numeric, 12 y)} & \\text{rank (exact in y)}\\\\\\hline\\left\\{0,1,2\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{0,2,1\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{1,0,2\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{1,1,1\\right\\} & 2 & 2 & 2\\\\\\hline\\left\\{1,2,0\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{2,0,1\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{2,1,0\\right\\} & 1 & 1 & 1\\\\\\hline\\end{array}",
