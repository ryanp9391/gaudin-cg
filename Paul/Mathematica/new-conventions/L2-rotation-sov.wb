       "data": "Out[2215]= \\begin{aligned}\n  &\\left\\{\\begin{pmatrix}0.465 & \\left\\{0.465,0.465,0.465,0.465,0.465\\right\\}\\\\0.997 & \\left\\{0.997,0.997,0.997,0.997,0.997\\right\\}\\\\1.35 & \\left\\{1.35,1.35,1.35,1.35,1.35\\right\\}\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\left\\{0.355,0.301\\right\\}\\right\\}\n\\end{aligned}",
