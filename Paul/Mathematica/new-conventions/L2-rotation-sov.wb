      {
       "data": "Out[668]= \\begin{array}{|c|c|}\\hline\\text{seed = $\\S$10 state (rel dev)} & \\left\\{0,0\\right\\}\\\\\\hline\\text{site-2 column-space rank} & 8\\\\\\hline\\text{site-1 row-space rank} & 8\\\\\\hline\\text{ranks of $\\Phi$0, $\\Phi$0T10, $\\Phi$0T11, $\\Phi$0T20, $\\Phi$0T21} & \\left\\{1,4,3,8,8\\right\\}\\\\\\hline\\text{\\# quadrics, Solve time (s), \\# components} & \\left\\{784,9.10308,2\\right\\}\\\\\\hline\\text{components: \\{free params, rank1, site1 rot, site2 rot, site1 = v1?, site2 = v2?, c\\}} & \\\\\\hline\\left\\{1,\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\left\\{8,0,0,0,0\\right\\}\\right\\} & \\\\\\hline\\left\\{0,\\text{zero},,,,,\\left\\{0,0,0,0,0\\right\\}\\right\\} & \\\\\\hline\\end{array}",
