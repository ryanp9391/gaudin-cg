      {
       "data": "Out[586]= \\begin{aligned}\n  &\\left\\{0.\\times 10^{-48} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}\\left\\{\\left\\{2\\right\\},\\left\\{2,1\\right\\}\\right\\} & \\begin{pmatrix}\\begin{pmatrix}-3 & -2 & -1\\\\-3 & -2 & -1\\end{pmatrix} & 1\\end{pmatrix}\\\\\\left\\{\\left\\{2\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\begin{pmatrix}\\begin{pmatrix}-3 & -2 & -1\\\\-3 & -2 & 0\\end{pmatrix} & -\\frac{3395}{3348}\\\\\\begin{pmatrix}-3 & -1 & -1\\\\-3 & -2 & -1\\end{pmatrix} & \\frac{8}{27}\\\\\\begin{pmatrix}-3 & -2 & 0\\\\-3 & -2 & -1\\end{pmatrix} & -\\frac{35}{124}\\end{pmatrix}\\\\\\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\begin{pmatrix}\\begin{pmatrix}-2 & -1 & -1\\\\-3 & -2 & -1\\end{pmatrix} & -\\frac{4}{9}\\end{pmatrix}\\\\\\left\\{\\left\\{2\\right\\},\\left\\{2,0\\right\\}\\right\\} & \\begin{pmatrix}\\begin{pmatrix}-3 & -2 & 0\\\\-3 & -2 & -1\\end{pmatrix} & -\\frac{1}{2}\\end{pmatrix}\\\\\\left\\{\\left\\{2\\right\\},\\left\\{1,0\\right\\}\\right\\} & \\begin{pmatrix}\\begin{pmatrix}-3 & -2 & 0\\\\-3 & -2 & 0\\end{pmatrix} & \\frac{35}{54}\\\\\\begin{pmatrix}-3 & -1 & 0\\\\-3 & -2 & -1\\end{pmatrix} & -\\frac{4}{27}\\end{pmatrix}\\\\\\left\\{\\left\\{2\\right\\},\\left\\{0,0\\right\\}\\right\\} & \\begin{pmatrix}\\begin{pmatrix}-2 & -1 & 0\\\\-3 & -2 & -1\\end{pmatrix} & \\frac{35}{108}\\\\\\begin{pmatr… [latex truncated: 1748 chars total]",
