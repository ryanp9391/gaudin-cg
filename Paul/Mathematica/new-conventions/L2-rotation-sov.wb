      {
       "data": "Out[378]= \\text{\"{0$\\grave{ }$$\\grave{ }$41.64159184092224, {\\\"group 1: c.Kvac\\\" -> 0.1756035476089969889$\\grave{ }$3., \\\"group 2: c.K20\\\" -> 0.0139323619701497261$\\grave{ }$3., \\\"group 1: cL1.Kvac\\\" -> 0.3573843944804593522$\\grave{ }$3., \\\"group 2: cL1.K20\\\" -> 0.168104302307548195$\\grave{ }$3., \\\"resolvent-rotation group 1 (cres.Kvac)\\\" -> 0.3129181145517954769$\\grave{ }$3., \\\"local-family member (control, should fit)\\\" -> 9.520177726490639940476$\\grave{ }$3.*${}^{\\wedge}$-17}}\"}",
