  {
   "kind": 2,
   "value": "(* negative check: a 2x2 with a single Q^j (rows k = 1,2, any two of the four columns), over a product reference of Q^jr at one shift, does not reproduce the prefactor *)\ncolsF[B_, j_, y1_] := Module[{E1 = Function[x, N[y1^(-x/hN), prec]]}, Table[{-brG[Function[x, QU[B, j, x] E1[x]], k], -brG[Function[x, x QU[B, j, x] E1[x]], k], brG[Function[x, QU[B, j, x - hN] E1[x]], k], brG[Function[x, x QU[B, j, x - hN] E1[x]], k]}, {k, 2}]];\nsingle = Flatten[Table[Module[{r = Table[Det[colsF[B, j, -6/5][[All, cp]]]/(Product[QU[B, jr, thN[[s]] + m hN], {s, nL}] pref[B, -6/5]), {B, nS}]}, {j, cp, jr, m, Max[Abs[r/r[[1]] - 1]]}], {j, {2, 3}}, {cp, Subsets[Range[4], {2}]}, {jr, {1, 2, 3}}, {m, -3, 1}], 3];\nchecks[\"single-Q 2x2: best residual (nonzero = fails)\"] = Min[single[[All, -1]]];\nchecks[\"single-Q 2x2: best residual (nonzero = fails)\"]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607003\" data-output-id=\"34\" data-out-n=\"509\" data-sub-idx=\"4\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"10\" data-sub-start=\"4\" data-sub-end=\"4\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[509]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-line-broken=\"1\" data-latex-b64=\"XGJlZ2lue2FsaWduZWR9CiAgJjAuODY2NTE2ODQ5ODQyNDc3OTcwMzAyMTI5MjM2MDI3ODUzMTg0MTIyOXtcY29sb3J7Z3JheX1cdmRvdHN9IFxcCiAgJntcY29sb3J7Z3JheX1cdmRvdHN9ODUzMTA1MDY5OTI4OTU3ClxlbmR7YWxpZ25lZH0=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.32em;vertical-align:-1.91em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.41em;\"><span style=\"top:-4.41em;\"><span class=\"pstrut\" style=\"height:3.5em;\"></span><span class=\"mord\"></span></span><span style=\"top:-2.25em;\"><span class=\"pstrut\" style=\"height:3.5em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.91em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.41em;\"><span style=\"top:-4.5975em;\"><span class=\"pstrut\" style=\"height:3.6875em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mord\">0.8665168498424779703021292360278531841229</span><span class=\"mord\"><span class=\"mord\" style=\"color:gray;\"><span class=\"mord\" style=\"color:gray;\">⋮</span><span class=\"mord rule\" style=\"color:gray;border-right-width:0em;border-top-width:1.5em;bottom:0em;\"></span></span></span></span></span><span style=\"top:-2.4375em;\"><span class=\"pstrut\" style=\"height:3.6875em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mord\"><span class=\"mord\" style=\"color:gray;\"><span class=\"mord\" style=\"color:gray;\">⋮</span><span class=\"mord rule\" style=\"color:gray;border-right-width:0em;border-top-width:1.5em;bottom:0em;\"></span></span></span><span class=\"mord\">853105069928957</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.91em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
