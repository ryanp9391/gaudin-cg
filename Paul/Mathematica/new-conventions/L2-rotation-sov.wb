      {
       "data": "Out[619]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{w1} & \\text{y} & \\text{w2(y)} & \\text{max rel dev (64 states)} & \\text{v1 rotation?} & \\text{v2 rotation?} & \\text{rank\\{v1,v2\\}}\\\\\\hline-\\frac{7}{3} & \\frac{7}{5} & -\\frac{56}{135} & 0.\\times 10^{-51} & 0 & 0 & 2\\\\\\hline\\frac{9}{4} & -\\frac{2}{3} & \\frac{16}{81} & 0.\\times 10^{-50} & 0 & 0 & 2\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
