      {
       "data": "Out[684]= \\begin{array}{|c|c|}\\hline\\text{a'} & \\frac{1242}{43\\,\\left(32\\,\\mathrm{yS}+135\\right)}\\\\\\hline\\text{c'} & \\frac{1505\\,\\left(4\\,\\mathrm{yS}-5\\right)}{64\\,\\left(3\\,\\mathrm{yS}-2\\right)\\,\\left(4\\,\\mathrm{yS}+9\\right)}\\\\\\hline\\text{b'} & \\frac{28175\\,\\mathrm{yS}}{8\\,\\left(3\\,\\mathrm{yS}-2\\right)\\,\\left(4\\,\\mathrm{yS}+9\\right)\\,\\left(32\\,\\mathrm{yS}+135\\right)}\\\\\\hline\\text{b'/(a'c')} & \\frac{140\\,\\mathrm{yS}}{27\\,\\left(4\\,\\mathrm{yS}-5\\right)}\\\\\\hline\\text{(y-omega)/(y-z2)} & \\frac{140\\,\\mathrm{yS}}{27\\,\\left(4\\,\\mathrm{yS}-5\\right)}\\\\\\hline\\end{array}",
