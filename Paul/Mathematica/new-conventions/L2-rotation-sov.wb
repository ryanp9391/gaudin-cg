  {
   "kind": 2,
   "value": "checks[\"7: Jacobian = finite differences\"] = Module[{pr = SetPrecision[pW + RandomReal[{-1, 1}/10, 16], 60], d = 10^-20, fd}, fd = Transpose[Table[(detP[pr + d UnitVector[16, k]] - detP[pr - d UnitVector[16, k]])/(2 d), {k, 16}]]; Max[Abs[Flatten[fd - jacP[pr]]]]/Max[Abs[Flatten[fd]]]];\n(* Levenberg-damped Gauss-Newton with lambda = 1 (target fixed); fixed 60-digit arithmetic *)\nrelRes[p_] := Norm[detP[p] - TA]/Norm[TA];\nscaleStart[p_] := Module[{d = detP[p], a2, q = p}, a2 = (Conjugate[d] . TA)/(Conjugate[d] . d); q[[1 ;; 4]] = Sqrt[a2] q[[1 ;; 4]]; q];\nlmFit[p0_, nIt_ : 60] := Block[{$MinPrecision = 60, $MaxPrecision = 60}, Module[{p = SetPrecision[p0, 60], mu = 10^-3, r, J, dp, pn, rn, rc},\n    rc = relRes[p];\n    Do[r = detP[p] - TA; J = jacP[p];\n     dp = -LinearSolve[ConjugateTranspose[J] . J + mu IdentityMatrix[16], ConjugateTranspose[J] . r];\n     pn = p + dp; rn = relRes[pn];\n     If[rn < rc, p = pn; rc = rn; mu = Max[mu/3, 10^-40], mu = 10 mu];\n     If[rc < 10^-45, Break[]], {nIt}];\n    {rc, p}]];\nnatStarts = {pW, p0, pWF0, Join[vecOf[F0, 1], vecOf[Fvac, 2]]};\nSeedRandom[401];\nrandStarts = Table[SetPrecision[RandomReal[{-1, 1}, 16], 60], {40}];\n{tLM, lmRuns} = AbsoluteTiming[Table[With[{st = scaleStart[s]}, lmFit[st]], {s, Join[natStarts, randStarts]}]];\nlmBest = First[SortBy[lmRuns, First]];\nchecks[\"7: Direction 1 best residual (lambda = 1)\"] = lmBest[[1]];\nchecks[\"7: ||det||/||T|| at best\"] = Norm[detP[lmBest[[2]]]]/Norm[TA];\n{N[tLM, 3], N[Take[Sort[lmRuns[[All, 1]]], 8], 3], N[lmRuns[[1 ;; 4, 1]], 3], N[checks[\"7: ||det||/||T|| at best\"], 4]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"485294\" data-output-id=\"171\" data-out-n=\"2160\" data-sub-idx=\"12\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"43\" data-sub-start=\"19\" data-sub-end=\"19\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[2160]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.5em;vertical-align:-2em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.5em;\"><span style=\"top:-4.5em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span><span style=\"top:-1.5em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.5em;\"><span style=\"top:-4.66em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">127.303059</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-