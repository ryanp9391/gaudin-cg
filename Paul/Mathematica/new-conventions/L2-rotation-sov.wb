  {
   "kind": 2,
   "value": "maxc[e_, var_] := Max[Abs[Flatten[CoefficientList[Chop[Expand[e], 10^-40], var]]], 0];\nsectors = GatherBy[Range[d2], wtBasis[[#]] &];\nmixN = N[(tZ[[1]] + Pi tZ[[2]]) /. u -> 3/7, prec];\nstates = Flatten[Table[With[{es = Eigensystem[mixN[[sec, sec]]]}, Table[<|\"mu\" -> wtBasis[[sec[[1]]]], \"ev\" -> es[[1, r]], \"vec\" -> Normal[SparseArray[Thread[sec -> es[[2, r]]], {d2}]]|>, {r, Length[sec]}]], {sec, sectors}], 1];\nnS = Length[states]; muS = states[[All, \"mu\"]]; vecS = states[[All, \"vec\"]];\ntZn = N[tZ, prec];\nvals = Table[With[{k = Ordering[Abs[ψ], -1][[1]]}, Table[Chop[Expand[(tZn[[a]] . ψ)[[k]]/ψ[[k]]], 10^-40], {a, 3}]], {ψ, vecS}];\nchecks[\"64 eigenvectors of t1,t2,t3 (max residual)\"] = Max[Table[maxc[tZn[[a]] . vecS[[A]] - vals[[A, a]] vecS[[A]], u], {A, nS}, {a, 3}]];\n{nS, checks[\"64 eigenvectors of t1,t2,t3 (max residual)\"]}",
   "languageId": "wolfram",
   "outputs": [
