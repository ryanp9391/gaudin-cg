  {
   "kind": 2,
   "value": "bestRuns = Take[SortBy[lmRuns, First], 6];\nlongRuns = Table[lmFit[r[[2]], 300], {r, bestRuns}];\nchecks[\"7: Direction 1 best residual after 300 more LM steps\"] = Min[longRuns[[All, 1]]];\n(* X-relaxation: for fixed F1^(1), F1^(2), det = sum_{m,m'} X[m,m'] D[m,m'](B), with D = det at F2^(1) = δ_m, F2^(2) = δ_m' *)\nDten[f11_, f12_] := Table[detP[Join[f11, UnitVector[4, m], f12, UnitVector[4, mp]]], {m, 4}, {mp, 4}];   (* 4 x 4 x 64 *)\nxRelax[f11_, f12_] := Module[{D = Dten[f11, f12], A, X, res, sv}, A = Transpose[Flatten[D, 1]];   (* 64 x 16 *)\n   X = LeastSquares[A, TA]; res = Norm[A . X - TA]/Norm[TA]; sv = SingularValueList[Partition[X, 4], 4, Tolerance -> 0];\n   {res, sv/sv[[1]], MatrixRank[A, Tolerance -> 10^-35]}];\nf1W1 = vecOf[Fvac, 1][[1 ;; 4]]; f1W2 = vecOf[Fvac, 2][[1 ;; 4]]; f1Z = vecOf[F0, 1][[1 ;; 4]];\nxr = {\"Fw|F0\" -> xRelax[f1W1, f1Z], \"Fw|Fw\" -> xRelax[f1W1, f1W2], \"F0|F0\" -> xRelax[f1Z, f1Z], \"best LM\" -> xRelax[longRuns[[1, 2, 1 ;; 4]], longRuns[[1, 2, 9 ;; 12]]]};\nchecks[\"7: X-relaxation residuals (natural F1's)\"] = Min[Values[xr][[All, 1]]];\n{N[longRuns[[All, 1]], 4], N[xr, 3]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
