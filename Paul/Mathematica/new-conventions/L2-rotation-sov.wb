   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* lambda = 1 test is projective in F1 (c absorbs the F1 scale), so scan F1 over the 3-sphere and refine *)\nresM[f1_] := Module[{A = N[Afast[f1], 40], c}, c = LeastSquares[A, N[TA, 40]]; Norm[A . c - TA]/Norm[TA]];\nSeedRandom[5];\nscan = Table[With[{f = Normalize[RandomReal[NormalDistribution[], 4]]}, {resM[SetPrecision[f, 40]], f}], {600}];\nbest5 = Take[SortBy[scan, First], 5];\nresAng[a_?NumericQ, b_?NumericQ, c_?NumericQ] := resM[SetPrecision[{Cos[a], Sin[a] Cos[b], Sin[a] Sin[b] Cos[c], Sin[a] Sin[b] Sin[c]}, 40]];\ntoAng[f_] := Module[{a = ArcCos[f[[1]]], b, c}, b = ArcCos[f[[2]]/Sin[a]]; c = ArcTan[f[[3]], f[[4]]]; {a, b, c}];\nrefined = Table[Quiet[FindMinimum[resAng[aa, bb, cc], Transpose[{{aa, bb, cc}, toAng[s[[2]] Sign[s[[2, 1]]]]}], MaxIterations -> 200]], {s, best5}];\nchecks[\"6b: ladder1 = L=2 w-vac Q's: min residual over all ladder-2 data (nonzero = impossible)\"] = Min[refined[[All, 1]]];\n(* same with the L=1 w-vacuum Q's on ladder 1 *)\nCdiagV1 = Table[Amat[UnitVector[4, a], Fv1], {a, 4}];\nCoffV1 = Table[If[a < b, Amat[UnitVector[4, a] + UnitVector[4, b], Fv1] - CdiagV1[[a]] - CdiagV1[[b]], 0], {a, 4}, {b, 4}];\nAfastV1[f1_] := Sum[f1[[a]]^2 CdiagV1[[a]], {a, 4}] + Sum[f1[[a]] f1[[b]] CoffV1[[a, b]], {a, 4}, {b, a + 1, 4}];\nresM1[f1_] := Module[{A = N[AfastV1[f1], 40], c}, c = LeastSquares[A, N[TA, 40]]; Norm[A . c - TA]/Norm[TA]];\nSeedRandom[6];\nscan1 = Table[With[{f = Normalize[RandomReal[NormalDistribution[], 4]]}, {resM1[SetPrecision[f, 40]], f}], {600}];\nchecks[\"6b: ladder1 = L=1 w-vac Q's: min residual over 600 ladder-2 F1 samples\"] = Min[scan1[[All, 1]]];\nN[KeyTake[checks, Select[Keys[checks], StringStartsQ[#, \"6b\"] &]], 4]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
