      {
       "data": "Out[2180]= \\begin{aligned}\n  &\\left\\{\\left\\{0.\\times 10^{-50},0.\\times 10^{-51}\\right\\} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}\\left\\{1.\\,,0,0\\right\\} & \\left\\{0,1.\\,,1.\\,\\right\\} & 363000 & 3.46 & 0.\\times 10^{-51}\\\\\\left\\{0,1.\\,,1.\\,\\right\\} & \\left\\{1.\\,,1.\\,,1.\\,\\right\\} & 1.05\\times 10^{6} & 3.46 & 0.\\times 10^{-51}\\\\\\left\\{0,1.\\,,1.\\,\\right\\} & \\left\\{1.\\,,0,0\\right\\} & 458000 & 3.46 & 0.\\times 10^{-51}\\\\\\left\\{1.\\,,0,0\\right\\} & \\left\\{1.\\,,1.\\,,1.\\,\\right\\} & 564000 & 3.98 & 0.\\times 10^{-51}\\\\\\left\\{0,1.\\,,1.\\,\\right\\} & \\left\\{1.\\,,0,1.\\,\\right\\} & 2.92\\times 10^{6} & 4.03 & 0.\\times 10^{-51}\\\\\\left\\{0,1.\\,,0\\right\\} & \\left\\{1.\\,,0,1.\\,\\right\\} & 3.77\\times 10^{6} & 4.87 & 0.\\times 10^{-51}\\end{pmatrix}\\right\\}\n\\end{aligned}",
