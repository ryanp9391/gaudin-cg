      {
       "data": "Out[260]= \\text{\"{0$\\grave{ }$$\\grave{ }$44.27292479051534, 1.580739866409017798$\\grave{ }$3., 46.2321710553299700586$\\grave{ }$3., {64, 64}, {\\\"per-ladder det6L, {L2 vac(w), L2 vac(w')}\\\" -> 24.9278524844610681647$\\grave{ }$3., \\\"per-ladder det6L, {one-site(w), one-site(w')}\\\" -> 5.8102112966454017852$\\grave{ }$3.}}\"}",
