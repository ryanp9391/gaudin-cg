       "data": "Out[2121]= \\begin{aligned}\n  &\\left\\{0.\\times 10^{-51},\\left\\{0.766,0.818,\\mathrm{resFast}\\left(\\left\\{p1,p2,p3,p4\\right\\}\\right) \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{resFast}\\left(\\left\\{p1,p2,p3,p4\\right\\}\\right),\\mathrm{resFast}\\left(\\left\\{p1,p2,p3,p4\\right\\}\\right) \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{resFast}\\left(\\left\\{p1,p2,p3,p4\\right\\}\\right),\\mathrm{resFast}\\left(\\left\\{p1,p2,p3,p4\\right\\}\\right) \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{resFast}\\left(\\left\\{p1,p2,p3,p4\\right\\}\\right)\\right\\}\\right\\}\n\\end{aligned}",
