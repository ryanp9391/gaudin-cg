  {
   "kind": 2,
   "value": "(* companion-frame kets *)\nPinv2 = KroneckerProduct[PphInv1, PphInv1];\nketC = Table[N[Pinv2 . vecS[[B]], prec], {B, nS}];\nx0C = Flatten[KroneckerProduct[uv[1], uv[1]]];\nchecks[\"companion kets: <x0|Psi> = diag-frame <x0|Psi>\"] = Max[Abs[Table[x0C . ketC[[B]] - x0ovl[[B]], {B, nS}]]]/Min[Abs[x0ovl]];\n(* per-site SoV wavefunction: roots (units of h, relative to θ_s) sorted -> (x1, x21, x22) = (min, middle, max) *)\ncolV2[B_, s_, m_] := Table[QU[B, j, thN[[s]] + m hN], {j, 3}];\npsiSite[B_, s_, {m1_, m21_, m22_}, {a_, b_}, k_] := (colV2[B, s, m21][[a]] colV2[B, s, m1][[b]] - colV2[B, s, m21][[b]] colV2[B, s, m1][[a]]) colV2[B, s, m22][[k]];\npsiPred[B_, m_, rows_, k_] := Product[psiSite[B, s, lab[m][[s]], rows, k], {s, nL}];\npsiAt0[B_, rows_, k_] := Product[psiSite[B, s, {-3, -2, -1}, rows, k], {s, nL}];\n(* wavefunction ratios with the ket normalized by <x0|Psi> = 1 *)\nwfRatio[rows_, k_] := Table[Module[{r = Table[((vecB[[m]] . ketC[[B]])/(x0C . ketC[[B]]))/(psiPred[B, m, rows, k]/psiAt0[B, rows, k]), {B, nS}]}, Max[Abs[r/r[[1]] - 1]]], {m, 64}];\nwf12 = wfRatio[{1, 2}, 1];\nchecks[\"L=2 SoV wavefunction = prod_s det2[v(x21),v(x1)] v_k(x22): max over 64 SoV states\"] = Max[wf12];\nchecks[\"... other rows/k: (1,3),k=2 and (2,3),k=3\"] = Max[Join[wfRatio[{1, 3}, 2], wfRatio[{2, 3}, 3]]];\n{N[Max[wf12], 3], N[checks[\"... other rows/k: (1,3),k=2 and (2,3),k=3\"], 3], Length[Select[wf12, # > 10^-20 &]]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607003\" data-output-id=\"39\" data-out-n=\"568\" data-sub-idx=\"15\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"18\" data-sub-start=\"15\" data-sub-end=\"15\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[568]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"XGxlZnRcezAuXHRpbWVzIDEwXnstNDh9LDAuXHRpbWVzIDEwXnstNTF9LDBccmlnaHRcfQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.2141em;vertical-align:-0.35em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">{</span></span><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8641em;\"><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">48</span></span></span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8641em;\"><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">51</span></span></span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">}</span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[568]= \\left\\{0.\\times 10^{-48},0.\\times 10^{-51},0\\right\\}",
       "mime": "text/plain"
      }
     ],
     "id": "4429ec6f-7825-4480-a537-653b78cf5a7e"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* state-independent SoV normalizations N_m (rows {1,2}, k = 1) *)\nNm = Table[((vecB[[m]] . ketC[[1]])/(x0C . ketC[[1]]))/(psiPred[1, m, {1, 2}, 1]/psiAt0[1, {1, 2}, 1]), {m, 64}];\nCm = cSoV Nm (vecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}] &]]]] . x0C)/(cSoV . vecB . x0C) ;\n(* site-2 shift ratio: v(θ2) ∥ v(θ2-h), so lambda2(B) = v_k(θ2)/v_k(θ2-h) is k-independent *)\nchecks[\"v(θ_s) ∥ v(θ_s - h) at L=2\"] = Max[Table[Norm[Flatten[Minors[Transpose[{colV2[B, s, 0], colV2[B, s, -1]}], 2]]]/(Norm[colV2[B, s, 0]] Norm[colV2[B, s, -1]]), {B, nS}, {s, nL}]];\nλ2[B_] := colV2[B, 2, 0][[1]]/colV2[B, 2, -1][[1]];\n(* site-1 SoV wavefunction (normalized at vacuum) for site-1 pattern triple t *)\npsi1[B_, t_] := psiSite[B, 1, t, {1, 2}, 1]/psiSite[B, 1, {-3, -2, -1}, {1, 2}, 1];\n(* Q-representation of the site-1 rotation: sum over the 12 support states *)\nqRep[B_] := Sum[cSoV[[m]] Nm[[m]] psi1[B, lab[m][[1]]] If[lab[m][[2]] == {-3, -2, -1}, 1, λ2[B]], {m, supp}];\nqRepCheck = Table[(Φsite1 . ketC[[B]])/(x0C . ketC[[B]])/qRep[B], {B, nS}];\nchecks[\"site-1 rotation: <Φ|Psi>/<x0|Psi> = sum over 12 SoV states of Q-dets\"] = Max[Abs[qRepCheck - 1]];\n(* compare the 8 vacuum-site-2 coefficients with the L=1 SoV coefficients of e1^T rho(g) *)\nxL1mat = xL1; cL1 = (uv[1] . ρg) . Inverse[N[xL1mat, prec]];\ntrip = {{-3, -2, -1}, {-3, -1, -1}, {-2, -1, -1}, {-3, -2, 0}, {-3, -1, 0}, {-3, 0, 0}, {-2, -1, 0}, {-2, 0, 0}};\ncoefVac = Table[With[{m = First[Select[supp, lab[#] == {trip[[i]], {-3, -2, -1}} &, 1] /. {} -> {0}]}, If[m == 0, 0, cSoV[[m]] Nm[[m]]]], {i, 8}];\ncoefExt = Table[With[{m = Select[supp, lab[#] == {trip[[i]], {-3, -2, 0}} &]}, If[m === {}, 0, cSoV[[m[[1]]]] Nm[[m[[1]]]]]], {i, 8}];\n{N[checks[\"v(θ_s) ∥ v(θ_s - h) at L=2\"], 3], N[checks[\"site-1 rotation: <Φ|Psi>/<x0|Psi> = sum over 12 SoV states of Q-dets\"], 3], Thread[gtpats -> N[Chop[coefVac/(cL1 Nm[[1]] 0 + cL1), 10^-30], 6]], Thread[gtpats -> N[Chop[coefExt/cL1, 10^-30], 6]]}",
   "languageId": "wolfram",
   "outputs": [
    {
