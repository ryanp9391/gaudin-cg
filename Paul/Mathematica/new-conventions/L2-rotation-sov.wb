  {
   "kind": 2,
   "value": "(* the lambda'-free joint fit cheated: ||det_w'||/||T_w'|| -> 0.04 (near-trivial on w'). Projective joint fit instead:\n   r_w = det_w - T (lambda = 1), and r_w' = P_perp(T_w') det_w' / ||det_w'|| (sine of the angle; scale-free, no trivial branch) *)\nThat2 = TA2/Norm[TA2];\nprojRes2[d_] := (d - (That2 . d) That2)/Norm[d];\nprojJac2[d_, Jd_] := Module[{n = Norm[d], g = projRes2[d]}, (Jd - Outer[Times, That2, That2 . Jd])/n - Outer[Times, g, d . Jd]/n^2];\nresPJ[w_] := Module[{W = ArrayReshape[w, {2, 3, 6}]}, Join[(detW[Gw, W] - TA)/Norm[TA], projRes2[detW[Gw2, W]]]];\njacPJ[w_] := Module[{W = ArrayReshape[w, {2, 3, 6}], d2, J2}, d2 = detW[Gw2, W]; J2 = jacW[Gw2, W]; Join[jacW[Gw, W]/Norm[TA], projJac2[d2, J2]]];\nlmPJ[st_, nIt_] := Block[{$MinPrecision = 60, $MaxPrecision = 60}, Module[{w = SetPrecision[st, 60], mu = 10^-3, r, J, dw, wn, rn, rc, traj = {}},\n    rc = Norm[resPJ[w]];\n    Do[r = resPJ[w]; J = jacPJ[w];\n     dw = -LinearSolve[Transpose[J] . J + mu IdentityMatrix[36], Transpose[J] . r];\n     wn = w + dw; rn = Norm[resPJ[wn]];\n     If[rn < rc, w = wn; rc = rn; mu = Max[mu/3, 10^-40], mu = 10 mu];\n     If[Mod[it, 100] == 0, AppendTo[traj, rc]];\n     If[rc < 10^-45, Break[]], {it, nIt}];\n    {rc, w, traj}]];\npjStarts = {jwRuns[[1, 2, 1 ;; 36]], wCur[[2]], scaleW[SetPrecision[Flatten[Wnat], 60]]};\npjRuns = Table[lmPJ[s, 500], {s, pjStarts}];\npjBest = First[SortBy[pjRuns, First]];\nchecks[\"8: projective joint (w,w') fit: best combined residual\"] = pjBest[[1]];\nchecks[\"8: projective joint: w part / w' angle at best\"] = With[{r = resPJ[pjBest[[2]]]}, {Norm[r[[1 ;; 64]]], Norm[r[[65 ;; 128]]]}];\nN[{Table[{r[[1]], r[[3]]}, {r, pjRuns}], checks[\"8: projective joint: w part / w' angle at best\"]}, 3]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"485294\" data-output-id=\"176\" data-out-n=\"2215\" data-sub-idx=\"12\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"50\" data-sub-start=\"21\" data-sub-end=\"21\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[2215]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:5.4em;vertical-align:-2.45em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.95em;\"><span style=\"top:-4.95em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"></span></span><span style=\"top:-2.26em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.45em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.95em;\"><span style=\"top:-4.95em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen\"><span class=\"delimsizing mult\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:3.15em;\"></span><span class=\"delimsizinginne