  {
   "kind": 2,
   "value": "(* Stage 2 diagnostics: the w-only fit overfits (transfer to w' fails). Joint fit: one W for both twists; lambda = 1 at w, lambda' free at w' *)\nGw2 = Gof[Fvac2];\nresJW[w_, l2_] := Join[detW[Gw, ArrayReshape[w, {2, 3, 6}]] - TA, detW[Gw2, ArrayReshape[w, {2, 3, 6}]] - l2 TA2];\njacJW[w_] := Join[Map[Append[#, 0] &, jacW[Gw, ArrayReshape[w, {2, 3, 6}]]], Transpose[Append[Transpose[jacW[Gw2, ArrayReshape[w, {2, 3, 6}]]], -TA2]]];\nlmJW[st_, nIt_] := Block[{$MinPrecision = 60, $MaxPrecision = 60}, Module[{v = SetPrecision[st, 60], mu = 10^-3, r, J, dv, vn, rn, rc, nrm = Norm[Join[TA, TA2]], traj = {}},\n    rc = Norm[resJW[v[[1 ;; 36]], v[[37]]]]/nrm;\n    Do[r = resJW[v[[1 ;; 36]], v[[37]]]; J = jacJW[v[[1 ;; 36]]];\n     dv = -LinearSolve[ConjugateTranspose[J] . J + mu IdentityMatrix[37], ConjugateTranspose[J] . r];\n     vn = v + dv; rn = Norm[resJW[vn[[1 ;; 36]], vn[[37]]]]/nrm;\n     If[rn < rc, v = vn; rc = rn; mu = Max[mu/3, 10^-40], mu = 10 mu];\n     If[Mod[it, 100] == 0, AppendTo[traj, rc]];\n     If[rc < 10^-45, Break[]], {it, nIt}];\n    {rc, v, traj}]];\nwTr = wCur[[2]];\nlam2Start = With[{d = detW[Gw2, ArrayReshape[wTr, {2, 3, 6}]]}, (Conjugate[TA2] . d)/(Conjugate[TA2] . TA2)];\njwStarts = {Append[wTr, lam2Start], Append[scaleW[SetPrecision[Flatten[Wnat], 60]], 1]};\njwRuns = Table[lmJW[s, 800], {s, jwStarts}];\nchecks[\"8: joint (w,w') fit, one W: best residual\"] = Min[jwRuns[[All, 1]]];\nchecks[\"8: joint fit: ||det_w'||/||T_w'|| (nonzero check)\"] = With[{b = First[SortBy[jwRuns, First]]}, Norm[detW[Gw2, ArrayReshape[b[[2, 1 ;; 36]], {2, 3, 6}]]]/Norm[TA2]];\nN[{Table[{r[[1]], r[[3]]}, {r, jwRuns}], checks[\"8: joint fit: ||det_w'||/||T_w'|| (nonzero check)\"]}, 3]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"485294\" data-output-id=\"175\" data-out-n=\"2203\" data-sub-idx=\"11\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"49\" data-sub-start=\"19\" data-sub-end=\"19\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[2203]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.2em;vertical-align:-1.85em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.35em;\"><span style=\"top:-4.35em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"></span></span><span style=\"top:-2.26em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.85em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.35em;\"><span style=\"top:-4.35em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">{</span></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">(</span></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0.0239</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0.0413</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0.0292</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0283</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0274</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0270</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0262</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0256</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0247</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0239</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0.193</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.120</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.102</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0894</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0540</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0465</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0430</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0413</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">)</span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span><span style=\"top:-2.26em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen nulldelimiter\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0426</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.85em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[2203]= \\begin{aligned}\n  &\\left\\{\\begin{pmatrix}0.0239 & \\left\\{0.0292,0.0283,0.0274,0.0270,0.0262,0.0256,0.0247,0.0239\\right\\}\\\\0.0413 & \\left\\{0.193,0.120,0.102,0.0894,0.0540,0.0465,0.0430,0.0413\\right\\}\\end{pmatrix} \\right. \\\\\n  &\\left. ,0.0426\\right\\}\n\\end{aligned}",
