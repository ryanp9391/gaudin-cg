      {
       "data": "Out[402]= \\text{\"{\\\"group 1: ctar.Kvac\\\" -> 2.9112455173995009546373$\\grave{ }$3.*${}^{\\wedge}$-16, \\\"group 2: ctar.K20\\\" -> 9.3000242517116904$\\grave{ }$3.*${}^{\\wedge}$-22, \\\"group 1: cr1.Kvac\\\" -> 4.6035426370858727641799$\\grave{ }$3.*${}^{\\wedge}$-16, \\\"group 2: cr1.K20\\\" -> 1.9762997761819931780827$\\grave{ }$3.*${}^{\\wedge}$-16, \\\"random 8-vector\\\" -> 1.2771377458840944486649$\\grave{ }$3.*${}^{\\wedge}$-15, \\\"control: sum of two members\\\" -> 9.887383314559942713741$\\grave{ }$3.*${}^{\\wedge}$-17}\"}",
