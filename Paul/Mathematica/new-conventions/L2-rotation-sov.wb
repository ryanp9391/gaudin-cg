      {
       "data": "Out[2169]= \\begin{aligned}\n  &\\left\\{\\left\\{0.2794,0.2794,0.2794,0.2842,0.2730,0.2730\\right\\} \\right. \\\\\n  &\\left. ,\\left\\{\\text{Fw|F0}\\to \\left\\{0.918,\\left\\{1.\\,,0.0747,0.0165,0\\right\\},9.\\,\\right\\} \\right. \\right. \\\\\n  &\\left. \\left. ,\\text{Fw|Fw} \\right. \\right. \\\\\n  &\\left. \\left. \\to \\left\\{0.636,\\left\\{1.\\,,0.0239,0.00158,0\\right\\},9.\\,\\right\\} \\right. \\right. \\\\\n  &\\left. \\left. ,\\text{F0|F0}\\to \\left\\{0.611,\\left\\{1.\\,,0.103,0.00315,0\\right\\},9.\\,\\right\\} \\right. \\right. \\\\\n  &\\left. \\left. ,\\text{best LM}\\to \\left\\{0.269,\\left\\{1.\\,,0.158,0.140,0\\right\\},9.\\,\\right\\}\\right\\}\\right\\}\n\\end{aligned}",
