       "data": "Out[370]= \\text{\"{{{-6/5, {1.$\\grave{ }$3., 0.062377234014503004$\\grave{ }$3., 0}, 0, 0}, {3, {1.$\\grave{ }$3., 0.0885660584181637055$\\grave{ }$3., 0}, 0, 0}}, 0, 0, {{{{1, 0}, {0.1268536453819927752$\\grave{ }$3., 2.95806571403531174$\\grave{ }$3.*${}^{\\wedge}$-41}}, {{1, 1}, {6.90823103104727248$\\grave{ }$3.*${}^{\\wedge}$-41, 1.1267885702474098$\\grave{ }$3.*${}^{\\wedge}$-41}}, {{2, 0}, {0.1280738957280405182$\\grave{ }$3., 3.79660069956329367$\\grave{ }$3.*${}^{\\wedge}$-41}}, {{2, 1}, {3.369803567489356996$\\grave{ }$3.*${}^{\\wedge}$-59, 2.076204721214010747$\\grave{ }$3.*${}^{\\wedge}$-59}}}, {{{1, 0}, 0}, {{2, 0}, 0}}}}\"}",
