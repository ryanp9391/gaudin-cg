      {
       "data": "Out[555]= \\begin{aligned}\n  &\\left\\{9.58\\times 10^{-91},12,\\begin{pmatrix}-3 & -2 & -1\\\\-3 & -2 & 0\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}\\left\\{-3,-2,-1\\right\\} & 2\\\\\\left\\{-3,-1,-1\\right\\} & 1\\\\\\left\\{-2,-1,-1\\right\\} & 1\\\\\\left\\{-3,-2,0\\right\\} & 2\\\\\\left\\{-3,-1,0\\right\\} & 2\\\\\\left\\{-2,-1,0\\right\\} & 2\\\\\\left\\{-3,0,0\\right\\} & 1\\\\\\left\\{-2,0,0\\right\\} & 1\\end{pmatrix}\\right\\}\n\\end{aligned}",
