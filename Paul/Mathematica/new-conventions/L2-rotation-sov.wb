ord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen nulldelimiter\"></span><span class=\"minner\"><span class=\"mopen nulldelimiter\"></span><span class=\"minner\"><span class=\"mopen nulldelimiter\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">F</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">(</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mclose delimcenter\" style=\"top:0em;\">)</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">F</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">(</span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">−</span><span class=\"mord\">1</span><span class=\"mclose delimcenter\" style=\"top:0em;\">)</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:7.8621em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[334]= \\begin{aligned}\n  &\\left\\{0.\\times 10^{-49},10,6 \\right. \\\\\n  &\\left. ,\\left\\{\\left\\{F\\left(2,-1\\right)\\to \\frac{F\\left(1,-1\\right)\\,F\\left(2,-2\\right)}{F\\left(1,-2\\right)}\\right\\} \\right. \\right. \\\\\n  &\\left. \\left. ,\\left\\{F\\left(1,-2\\right)\\to 0,F\\left(1,-1\\right)\\to 0\\right\\} \\right. \\right. \\\\\n  &\\left. \\left. ,\\left\\{F\\left(1,-2\\right)\\to 0,F\\left(2,-2\\right)\\to 0\\right\\}, \\right. \\right. \\\\\n  &\\left. \\left. \\left\\{F\\left(1,-2\\right)\\to 0,F\\left(1,-1\\right)\\to 0,F\\left(1,0\\right)\\to 0,F\\left(1,1\\right)\\to 0\\right\\} \\right. \\right. \\\\\n  &\\left. \\left. , \\right. \\right. \\\\\n  &\\left. \\left. \\left\\{F\\left(1,-2\\right)\\to 0,F\\left(1,-1\\right)\\to 0,F\\left(1,0\\right)\\to 0,F\\left(1,1\\right)\\to 0\\right\\} \\right. \\right. \\\\\n  &\\left. \\left. , \\right. \\right. \\\\\n  &\\left. \\left. \\left\\{F\\left(1,-1\\right)\\to 0,F\\left(1,0\\right)\\to 0 \\right. \\right. \\right. \\\\\n  &\\left. \\left. \\left. ,F\\left(1,1\\right)\\to 0,F\\left(2,-1\\right)\\to 0\\right\\}\\right\\}\\right\\}\n\\end{aligned}",
