       "data": "Out[810]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{weight mu} & \\text{dim V\\_mu} & \\text{rank numeric (w1=-7/3, 12 y)} & \\text{rank exact in y} & \\text{rank union over 3 w1} & \\text{rank control omega = y} & \\text{untwisting leading eps-order}\\\\\\hline\\left\\{0,1,2\\right\\} & 1 & 1 & 1 & 1 & 0 & 4\\\\\\hline\\left\\{0,2,1\\right\\} & 1 & 1 & 1 & 1 & 1 & 3\\\\\\hline\\left\\{1,0,2\\right\\} & 1 & 1 & 1 & 1 & 0 & 3\\\\\\hline\\left\\{1,1,1\\right\\} & 2 & 2 & 2 & 2 & 1 & 2\\\\\\hline\\left\\{1,2,0\\right\\} & 1 & 1 & 1 & 1 & 1 & 1\\\\\\hline\\left\\{2,0,1\\right\\} & 1 & 1 & 1 & 1 & 1 & 1\\\\\\hline\\left\\{2,1,0\\right\\} & 1 & 1 & 1 & 1 & 1 & 0\\\\\\hline\\text{HW count (6 kets)} & \\text{rank per w1} & \\left\\{5,5,5\\right\\} & \\text{union over 3 w1} & 6 & \\text{torus-completed} & 6\\\\\\hline\\text{HW count, control omega = y} & \\text{rank per w1} & \\left\\{4,4,4\\right\\} &  &  & \\text{torus-completed} & 4\\\\\\hline\\text{closed forms} & \\text{b'/(a'c') - (y-omega)/(y-z2)} & 0 & \\text{b' (omega -> y)} & 0 & \\text{(0,1,2) = 3b'(a'c'-b')} & \\mathrm{True}\\\\\\hline\\text{all boolean checks} & \\mathrm{True} &  &  &  &  & \\\\\\hline\\end{array}",
