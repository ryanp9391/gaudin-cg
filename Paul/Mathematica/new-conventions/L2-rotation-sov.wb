      {
       "data": "Out[724]= \\begin{array}{|c|c|c|c|}\\hline\\text{weight} & \\text{leading eps order} & \\text{y-rank of leading coeff} & \\text{dim V\\_mu}\\\\\\hline\\left\\{0,1,2\\right\\} & 4 & 1 & 1\\\\\\hline\\left\\{0,2,1\\right\\} & 3 & 1 & 1\\\\\\hline\\left\\{1,0,2\\right\\} & 3 & 1 & 1\\\\\\hline\\left\\{1,1,1\\right\\} & 2 & 2 & 2\\\\\\hline\\left\\{1,2,0\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{2,0,1\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{2,1,0\\right\\} & 0 & 1 & 1\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
