      {
       "data": "Out[282]= \\begin{array}{|c|c|}\\hline\\text{$\\lambda$2\\^{}0 $\\lambda$1\\^{}0} & \\frac{4}{9}\\,\\alpha \\,c\\left(3\\right)+\\frac{8}{27}\\,\\beta \\,c\\left(2\\right)+c\\left(1\\right)\\\\\\hline\\text{$\\lambda$2\\^{}0 $\\lambda$1\\^{}1} & \\frac{1}{108}\\,\\alpha \\,\\left(-35\\,c\\left(6\\right)-24\\,c\\left(7\\right)\\right)-\\frac{4}{27}\\,\\beta \\,c\\left(5\\right)+\\frac{1}{124}\\,\\left(-35\\,c\\left(2\\right)-62\\,c\\left(4\\right)\\right)\\\\\\hline\\text{$\\lambda$2\\^{}0 $\\lambda$1\\^{}2} & \\frac{3}{62}\\,\\alpha \\,c\\left(8\\right)+\\frac{1}{31}\\,\\beta \\,c\\left(6\\right)\\\\\\hline\\text{$\\lambda$2\\^{}1 $\\lambda$1\\^{}0} & -\\frac{3395\\,c\\left(2\\right)}{3348}\\\\\\hline\\text{$\\lambda$2\\^{}1 $\\lambda$1\\^{}1} & \\frac{35}{558}\\,\\alpha \\,c\\left(8\\right)-\\frac{35}{124}\\,\\beta \\,c\\left(6\\right)+\\frac{35\\,c\\left(5\\right)}{54}\\\\\\hline\\text{$\\lambda$2\\^{}1 $\\lambda$1\\^{}2} & 0\\\\\\hline\\end{array}",
       "mime": "text/plain"
