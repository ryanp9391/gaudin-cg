      {
       "data": "Out[769]= \\begin{array}{|c|c|c|}\\hline\\text{HW rank per w1 / union} & \\left\\{5,5,5\\right\\} & 6\\\\\\hline\\text{per-irrep ranks (w1=-7/3), union over w1} & \\left\\{1,1,1,2,1\\right\\} & \\left\\{1,1,1,2,1\\right\\}\\\\\\hline\\text{irreps} & \\left\\{\\text{(4,2,0) 27},\\text{(4,1,1)},\\text{(3,3,0)},\\text{(3,2,1) octets},\\text{(2,2,2) singlet}\\right\\} & \\\\\\hline\\text{control omega = y: HW rank per w1, per-irrep ranks} & \\left\\{4,4,4\\right\\} & \\left\\{1,1,1,1,0\\right\\}\\\\\\hline\\text{per-weight ranks (w1 = -7/3, 9/4, 5/2), union} & \\begin{pmatrix}1 & 1 & 1 & 2 & 1 & 1 & 1\\\\1 & 1 & 1 & 2 & 1 & 1 & 1\\\\1 & 1 & 1 & 2 & 1 & 1 & 1\\end{pmatrix} & \\left\\{1,1,1,2,1,1,1\\right\\}\\\\\\hline\\text{control per-weight ranks} & \\begin{pmatrix}0 & 1 & 2\\\\0 & 2 & 1\\\\1 & 0 & 2\\\\1 & 1 & 1\\\\1 & 2 & 0\\\\2 & 0 & 1\\\\2 & 1 & 0\\end{pmatrix} & \\left\\{0,1,0,1,1,1,1\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "2c9aaa9f-85e5-4375-aeb7-7dbf69ff61a7"
    }
   ],
   "metadata": {}
