   "value": "(* gauge-fix the best fit: F1 -> F1/F1(-2); F2 -> F2 - F2(-2) F1; F2 -> F2/F2(0) *)\nbf = bestFit[[2]]; bF1 = bf[[1 ;; 4]]; bF2 = bf[[5 ;; 8]];\ngF1 = bF1/bF1[[1]]; gF2 = bF2 - (bF2[[1]]/bF1[[1]]) bF1; gF2 = gF2/gF2[[3]];\n(* Newton on gauge-fixed unknowns: F1(-1), F1(0), F1(1), F2(-1), F2(1), lambda *)\ngVals[{a1_, a2_, a3_, b1_, b3_}] := {1, a1, a2, a3, 0, b1, 1, b3};\nlamG = With[{d = d6sym /. Thread[unk -> gVals[{gF1[[2]], gF1[[3]], gF1[[4]], gF2[[2]], gF2[[4]]}]]}, (d . TA)/(TA . TA)];\npick = {1, 9, 17, 30, 41, 50, 63};\nsolN = FindRoot[Table[(d6sym[[B]] /. Thread[unk -> gVals[{A1, A2, A3, B1, B3}]]) == LL TA[[B]], {B, pick[[1 ;; 6]]}], {{A1, gF1[[2]]}, {A2, gF1[[3]]}, {A3, gF1[[4]]}, {B1, gF2[[2]]}, {B3, gF2[[4]]}, {LL, lamG}}, WorkingPrecision -> 50, MaxIterations -> 200];\nladder2F = gVals[{A1, A2, A3, B1, B3} /. solN];\nchecks[\"site-1 vacuum Ω_w⊗e1 = det6L[{F_vac,w ; F_lad2}]/Psi_Q (all 64)\"] = Max[Abs[(d6sym /. Thread[unk -> ladder2F])/((LL /. solN) TA) - 1]];\n{N[checks[\"site-1 vacuum Ω_w⊗e1 = det6L[{F_vac,w ; F_lad2}]/Psi_Q (all 64)\"], 3], N[ladder2F, 12]}",
