border-right-style:solid;margin:0 -0.02em;vertical-align:-8.15em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:10.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9001em;\"><span class=\"pstrut\" style=\"height:10.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-14.5001em;\"><span class=\"pstrut\" style=\"height:10.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-15.7001em;\"><span class=\"pstrut\" style=\"height:10.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-16.9001em;\"><span class=\"pstrut\" style=\"height:10.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-18.1001em;\"><span class=\"pstrut\" style=\"height:10.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-19.3001em;\"><span class=\"pstrut\" style=\"height:10.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.15em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
