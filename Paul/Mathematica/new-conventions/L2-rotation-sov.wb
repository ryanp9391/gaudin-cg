  {
   "kind": 2,
   "value": "(* Stage 2: all 36 weights free, lambda = 1. Jacobian: d det/dW[k,f,p] = sum_{rows r in block k, beta} adjT[r, (f,beta)] x_p^(beta-1) G[B, ij(r), p, f] *)\njacW[G_, W_] := Table[Module[{M = matW[G, B, W], adjT, g},\n    adjT = Det[M] Transpose[Inverse[M]];\n    g = Table[Sum[adjT[[3 (k - 1) + r, 2 (f - 1) + be]] xPv[[p]]^(be - 1) G[[B, r, p, f]], {r, 3}, {be, 2}], {k, 2}, {f, 3}, {p, 6}];\n    Flatten[g]/psiQv[[B]]], {B, nS}];\nchecks[\"8: jacW = finite differences\"] = Module[{W0 = SetPrecision[Wnat (1 + RandomReal[{-1, 1}/5, {2, 3, 6}]), 60], d = 10^-22, fd, k0 = 7},\n   fd = (detW[Gw, ArrayReshape[Flatten[W0] + d UnitVector[36, k0], {2, 3, 6}]] - detW[Gw, ArrayReshape[Flatten[W0] - d UnitVector[36, k0], {2, 3, 6}]])/(2 d);\n   Norm[fd - jacW[Gw, W0][[All, k0]]]/Norm[fd]];\nrelResW[G_, T_, w_] := Norm[detW[G, ArrayReshape[w, {2, 3, 6}]] - T]/Norm[T];\nlmW[w0_, nIt_ : 80] := Block[{$MinPrecision = 60, $MaxPrecision = 60}, Module[{w = SetPrecision[w0, 60], mu = 10^-3, r, J, dw, wn, rn, rc},\n    rc = relResW[Gw, TA, w];\n    Do[r = detW[Gw, ArrayReshape[w, {2, 3, 6}]] - TA; J = jacW[Gw, ArrayReshape[w, {2, 3, 6}]];\n     dw = -LinearSolve[ConjugateTranspose[J] . J + mu IdentityMatrix[36], ConjugateTranspose[J] . r];\n     wn = w + dw; rn = relResW[Gw, TA, wn];\n     If[rn < rc, w = wn; rc = rn; mu = Max[mu/3, 10^-40], mu = 10 mu];\n     If[rc < 10^-45, Break[]], {nIt}];\n    {rc, w}]];\n(* start from Wnat rescaled so det matches TA in least squares (scale the whole k=1 block: det ~ c^3) *)\nscaleW[w_] := Module[{d = detW[Gw, ArrayReshape[w, {2, 3, 6}]], c3, ww = ArrayReshape[w, {2, 3, 6}]}, c3 = (Conjugate[d] . TA)/(Conjugate[d] . d); ww[[1]] = CubeRoot[Re[c3]] ww[[1]]; Flatten[ww]];\nSeedRandom[503];\nwStarts = Join[{Flatten[Wnat]}, Table[Flatten[Wnat (1 + RandomReal[{-1, 1}, {2, 3, 6}])], {8}], Table[Flatten[Wnat RandomReal[{-2, 2}, {2, 3, 6}]], {8}]];\n{tW, wRuns} = AbsoluteTiming[Table[lmW[scaleW[SetPrecision[s, 60]]], {s, wStarts}]];\nwBest = First[SortBy[wRuns, First]];\nchecks[\"8: Stage 2 best residual (36 free weights, lambda = 1)\"] = wBest[[1]];\nchecks[\"8: Stage 2 ||det||/||T|| at best\"] = Norm[detW[Gw, ArrayReshape[wBest[[2]], {2, 3, 6}]]]/Norm[TA];\n{N[checks[\"8: jacW = finite differences\"], 3], N[tW, 3], N[Sort[wRuns[[All, 1]]], 3], N[checks[\"8: Stage 2 ||det||/||T|| at best\"], 4]}",
   "languageId": "wolfram",
   "outputs": [
