      {
       "data": "Out[702]= \\begin{array}{|c|c|c|c|}\\hline\\text{weight} & \\text{max residual} & \\text{\\#monomials} & \\text{fitted coefficients (monomials x basis)}\\\\\\hline\\left\\{0,1,2\\right\\} & 0 & 3 & \\left\\{-3,3,0\\right\\}\\\\\\hline\\left\\{0,2,1\\right\\} & 0 & 2 & \\left\\{2,-2\\right\\}\\\\\\hline\\left\\{1,0,2\\right\\} & 0 & 1 & \\left\\{3\\right\\}\\\\\\hline\\left\\{1,1,1\\right\\} & 0 & 2 & \\left\\{-1,3,2,0\\right\\}\\\\\\hline\\left\\{1,2,0\\right\\} & 0 & 1 & \\left\\{1\\right\\}\\\\\\hline\\left\\{2,0,1\\right\\} & 0 & 1 & \\left\\{1\\right\\}\\\\\\hline\\left\\{2,1,0\\right\\} & 0 & 1 & \\left\\{1\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
