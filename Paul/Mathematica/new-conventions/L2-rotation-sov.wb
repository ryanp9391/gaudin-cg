  {
   "kind": 2,
   "value": "(* (A) the new two-distinct-rotation state Φ* = <Ω|(c*.ops) at θ1-2h, exact *)\ncStar = {-2187/1600, -243/80, -27/43, 1, 320/1161};\nopsAll = {IdentityMatrix[d2], T2n[{1, 0}], T2n[{1, 1}], T2n[{2, 0}], T2n[{2, 1}]};\nΦStar = Ω2d . (cStar . opsAll); MStar = Partition[ΦStar, d1];\nchecks[\"Φ*: rank 1 (all 2x2 minors zero, exact)\"] = Union[Flatten[Minors[MStar, 2]]] === {0};\nvStar = vC /. Thread[cs5 -> cStar]; vpStar = vpC /. Thread[cs5 -> cStar];\nκStar = (vpStar . vStar)/(vStar . vStar);\nchecks[\"Φ* = v* ⊗ (Ω1 + κ* ω2) exactly\"] = (MStar === Outer[Times, vStar, Ω1 + κStar ω2]);\nchecks[\"v* and Ω1+κ*ω2 are rotations (exact)\"] = {Union[Flatten[Minors[Xdiag[vStar], 2]]] === {0}, Union[Flatten[Minors[Xdiag[Ω1 + κStar ω2], 2]]] === {0}};\nchecks[\"distinct: rank{v*,Ω1}, rank{v*, Ω1+κ*ω2}\"] = {MatrixRank[{vStar, Ω1}], MatrixRank[{vStar, Ω1 + κStar ω2}]};\nfStar = cStar . {ones, τ10, τ11, τ20, τ21};\novlΩd = Table[Ω2d . vecS[[B]], {B, nS}];\nchecks[\"<Φ*|Ψ_B> = f*(B) <Ω|Ψ_B> (max rel dev)\"] = Max[Table[Abs[(ΦStar . vecS[[B]])/(fStar[[B]] ovlΩd[[B]]) - 1], {B, nS}]];\n(* rotation data: X = a b^T for the two factors *)\nabOf[v_] := Module[{X = Xdiag[v], i, j}, i = First[FirstPosition[Total[Abs[X], {2}], _?(# != 0 &)]]; j = First[FirstPosition[Total[Abs[X], {1}], _?(# != 0 &)]]; {X[[All, j]]/X[[i, j]], X[[i, All]]}];\nStringReplace[ToString[{κStar, KeyTake[checks, {\"Φ*: rank 1 (all 2x2 minors zero, exact)\", \"Φ* = v* ⊗ (Ω1 + κ* ω2) exactly\", \"v* and Ω1+κ*ω2 are rotations (exact)\", \"distinct: rank{v*,Ω1}, rank{v*, Ω1+κ*ω2}\"}], N[checks[\"<Φ*|Ψ_B> = f*(B) <Ω|Ψ_B> (max rel dev)\"], 3], \"ab(v*)\" -> abOf[vStar], \"ab(site2)\" -> abOf[Ω1 + κStar ω2], \"ab(Ω1)\" -> abOf[Ω1]}, InputForm], \"\\n\" -> \" \"]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"368062\" data-output-id=\"34\" data-out-n=\"421\" data-sub-idx=\"15\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"92\" data-sub-start=\"15\" data-sub-end=\"15\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[421]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"14\" data-latex-b64=\"\"><span class=\"wolfbook-render-error\" style=\"color:#cc0000;font-family:monospace;white-space:pre-wrap\">[LaTeX error] KaTeX parse error: Undefined control sequence: \\[ at position 25: …1029/1606, &lt;|\\&quot;\\̲[̲CapitalPhi]*: r…<br><small>\\text{&quot;{-1029/1606, &lt;|\\&quot;\\[CapitalPhi]*: rank 1 (all 2x2 minors zero, exact)\\&quot; -&gt; True, \\&quot;\\[CapitalPhi]* = v* \\[CircleTimes] (\\[CapitalOmega]1 + \\[Kappa]* \\[Omega]2) exactly\\&quot; -&gt; True, \\&quot;v* and \\[CapitalOmega]1+\\[Kappa]*\\[Omega]2 are rotations (exact)\\&quot; -&gt; {True, True}, \\&quot;distinct: rank{v*,\\[CapitalOmega]1}, rank{v*, \\[CapitalOmega]1+\\[Kappa]*\\[Omega]2}\\&quot; -&gt; {2, 2}|&gt;, 0$\\grave{ }$$\\grave{ }$56.219735609026685, \\&quot;ab(v*)\\&quot; -&gt; {{1, -345/62, 453/62}, {876005037/53953900, 226012599/26976950, 56090718/13488475}}, \\&quot;ab(site2)\\&quot; -&gt; {{1, 43/8, -315/16}, {11232/8833, 22464/44165, 44928/220825}}, \\&quot;ab(\\[CapitalOmega]1)\\&quot; -&gt; {{1, -29/6, 35/6}, {-1296/121, -2592/605, -5184/3025}}}&quot;}</small></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[421]= \\text{\"{-1029/1606, <|\\\"\\[CapitalPhi]*: rank 1 (all 2x2 minors zero, exact)\\\" -> True, \\\"\\[CapitalPhi]* = v* \\[CircleTimes] (\\[CapitalOmega]1 + \\[Kappa]* \\[Omega]2) exactly\\\" -> True, \\\"v* and \\[CapitalOmega]1+\\[Kappa]*\\[Omega]2 are rotations (exact)\\\" -> {True, True}, \\\"distinct: rank{v*,\\[CapitalOmega]1}, rank{v*, \\[CapitalOmega]1+\\[Kappa]*\\[Omega]2}\\\" -> {2, 2}|>, 0$\\grave{ }$$\\grave{ }$56.219735609026685, \\\"ab(v*)\\\" -> {{1, -345/62, 453/62}, {876005037/53953900, 226012599/26976950, 56090718/13488475}}, \\\"ab(site2)\\\" -> {{1, 43/8, -315/16}, {11232/8833, 22464/44165, 44928/220825}}, \\\"ab(\\[CapitalOmega]1)\\\" -> {{1, -29/6, 35/6}, {-1296/121, -2592/605, -5184/3025}}}\"}",
