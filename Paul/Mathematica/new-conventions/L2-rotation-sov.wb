  {
   "kind": 2,
   "value": "opDir[tt_, Q_, x_] := nuP[1][x] nuP[1][x + hN] nuP[1][x + 2 hN] Q[x - hN] - (tt[[1]] /. u -> x) nuP[1][x + hN] nuP[1][x + 2 hN] Q[x] + (tt[[2]] /. u -> x + hN) nuP[1][x + 2 hN] Q[x + hN] - (tt[[3]] /. u -> x + 2 hN) Q[x + 2 hN];\nopDual[tt_, Q_, x_] := nuP[3][x] nuP[3][x - hN] nuP[3][x - 2 hN] Q[x + hN] - (tt[[1]] /. u -> x) nuP[3][x - hN] nuP[3][x - 2 hN] Q[x] + (tt[[2]] /. u -> x) nuP[3][x - 2 hN] Q[x - hN] - (tt[[3]] /. u -> x) Q[x - 2 hN];\n(* minimal-degree monic q with Q = zz^(s x/h) q solving op; {} if none up to degree 6 *)\nsolveQ[op_, tt_, zz_, s_] := Module[{c, eqs, ns, res = {}},\n  Do[If[res === {},\n    eqs = CoefficientList[Chop[Expand[op[tt, Function[yy, zz^(s (yy - X)/hN) Sum[c[j] yy^j, {j, 0, d}]], X]], 10^-40], X];\n    ns = If[eqs === {}, {UnitVector[d + 1, d + 1]}, NullSpace[N[Table[Coefficient[e, c[j]], {e, eqs}, {j, 0, d}], prec], Tolerance -> 10^-30]];\n    If[Length[ns] > 0, res = Expand[#/Coefficient[#, X, d]] &[Sum[ns[[1, j + 1]] X^j, {j, 0, d}]]]], {d, 0, 6}]; res];\n{qTime, {qd, qu}} = AbsoluteTiming[{Table[solveQ[opDir, vals[[A]], zN[[i]], -1], {A, nS}, {i, 3}], Table[solveQ[opDual, vals[[A]], zN[[j]], 1], {A, nS}, {j, 3}]}];\nchecks[\"all direct and dual Q's found\"] = FreeQ[{qd, qu}, {}];\nchecks[\"deg q^j = μ_j - Lλ3\"] = And @@ Flatten[Table[Exponent[qu[[A, j]], X] == muS[[A, j]] - nL Λ[[3]], {A, nS}, {j, 3}]];\n{qTime, checks[\"all direct and dual Q's found\"], checks[\"deg q^j = μ_j - Lλ3\"]}",
   "languageId": "wolfram",
