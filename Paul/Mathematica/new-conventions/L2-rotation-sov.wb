     "id": "c68ba646-83d0-4a5e-9091-823be4758a6a"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* self-contained pipeline in (z, w): rebuilds Ω1, the L=2 fused T's at θ1-2h and the diag->companion map for the given ket twist z; no Q's needed (y* read off from the site-2 factor Ω_{(w1, y*)}). Globals (zN, tZ, T2n, Pph1, ...) are NOT modified. NB: local names must not shadow globals used inside (ps = GT patterns). *)\nabOfX[X_] := Module[{i, j}, i = First[FirstPosition[Total[Abs[X], {2}], _?(# != 0 &)]]; j = First[FirstPosition[Total[Abs[X], {1}], _?(# != 0 &)]]; X[[All, j]]/X[[i, j]]];\noneSiteVac[zz_, ww_] := Module[{rOmx}, rOmx = {r1 -> (w[1] - z[1])/(w[1] - z[2]), r2 -> ((w[1] - z[1]) (-w[2] + z[1]) (z[2] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (w[2] - z[3])), r3 -> ((w[1] - z[2]) (-w[2] + z[2]) (z[1] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (-w[2] + z[3]))} /. Join[Thread[zs -> zz], Thread[ws -> ww]];\n  First[{UnitVector[d1, 1]} . MatrixExp[(r1 /. rOmx) Ee[1, 2]] . MatrixExp[(r2 /. rOmx) Ee[1, 3]] . MatrixExp[(r3 /. rOmx) Ee[2, 3]]]];\npipelineZ[zz_, ww_] := Module[{Ω1x, Zdx, tZx, tZvx, T2x, rsNx, Pppx, Pmpx, Pdpx, Pph1x, Xd, Ω2x, Ml, rb, ω2x, dec, vsx, vpsx, vCx, vpCx, pe, psol, comp, cst, vst, vpst, κst, s2, a2, ystar, Ωtest},\n  Ω1x = oneSiteVac[zz, ww];\n  Zdx = DiagonalMatrix[zz]; tZx = Table[tPoly[Zdx, a], {a, 3}];\n  tZvx[a_, v_] := tZx[[a]] /. u -> v;\n  T2x[{1, 0}, v_] := tZvx[1, v]; T2x[{1, 1}, v_] := tZvx[2, v]; T2x[{2, 0}, v_] := tZvx[1, v] . tZvx[1, v + hN] - tZvx[2, v + hN]; T2x[{2, 1}, v_] := tZvx[2, v] . tZvx[1, v + hN] - tZvx[3, v + hN];\n  rsNx = rsSol /. Thread[zs -> zz];\n  Pppx = MatrixExp[(1/zz[[1]]) Ee[1, 2]] . MatrixExp[-(1/(zz[[1]] zz[[2]])) Ee[1, 3]] . MatrixExp[((zz[[1]] + zz[[2]])/(zz[[1]] zz[[2]])) Ee[2, 3]];\n  Pmpx = MatrixExp[(r[1] /. rsNx) Ee[3, 2]] . MatrixExp[(r[2] /. rsNx) Ee[3, 1]] . MatrixExp[(r[3] /. rsNx) Ee[2, 1]];\n  Pdpx = DiagonalMatrix[Table[Product[(s[k] /. rsNx)^J0[k][p], {k, 3}], {p, ps[{Λ}]}]];\n  Pph1x = Pmpx . Pdpx . Pppx; Xd[v_] := Xmat[v . Pph1x];\n  Ω2x = Flatten[KroneckerProduct[Ω1x, Ω1x]];\n  Ml[l_] := Partition[Ω2x . T2x[l, v0], d1];\n  rb = DeleteCases[RowReduce[Ml[{1, 0}]], {0 ..}];\n  ω2x = Module[{cands = Select[rb, MatrixRank[{Ω1x, #}] == 2 &]}, cands[[1]]/cands[[1, Ordering[Abs[cands[[1]]], -1][[1]]]]];\n  dec[M_] := Module[{cs = Table[LinearSolve[Transpose[{Ω1x, ω2x}], M[[i]]], {i, d1}]}, {cs[[All, 1]], cs[[All, 2]]}];\n  vsx = Table[dec[Ml[l]][[1]], {l, lams}]; vpsx = Table[dec[Ml[l]][[2]], {l, lams}];\n  vCx = c0 Ω1x + c1 vsx[[1]] + c2 vsx[[2]] + c3 vsx[[3]] + c4 vsx[[4]]; vpCx = c1 vpsx[[1]] + c3 vpsx[[3]];\n  pe = DeleteCases[Union[Flatten[Minors[{vCx, vpCx}, 2]]], 0]; psol = Solve[pe == 0, cs5];\n  comp = First[Select[psol, FreeQ[#, c1 -> 0] && FreeQ[#, c3 -> 0] && Length[#] == 4 &]];\n  cst = (cs5 /. comp) /. c3 -> 1; vst = vCx /. Thread[cs5 -> cst]; vpst = vpCx /. Thread[cs5 -> cst]; κst = (vpst . vst)/(vst . vst);\n  s2 = Ω1x + κst ω2x; a2 = abOfX[Xd[s2]]; ystar = a2[[3]]/ww[[1]];\n  Ωtest = oneSiteVac[zz, {ww[[1]], ystar, ww[[3]]}];\n  {\"c*\" -> cst, \"κ*\" -> κst, \"a(site2)\" -> a2, \"y*\" -> ystar, \"-(y*/w2)\" -> -ystar/ww[[2]], \"site2 = Ω(w1,y*)?\" -> (MatrixRank[{s2, Ωtest}] == 1), \"a(v*)\" -> abOfX[Xd[vst]], \"v* rotation\" -> (Union[Flatten[Minors[Xd[vst], 2]]] === {0}), \"a(ω2)\" -> abOfX[Xd[ω2x]]}];\n(* control at the original point, then two new ket twists *)\nrunZ0 = pipelineZ[zN, wN];\nrunZ1 = pipelineZ[{3/2, 5/4, 3/7}, wN];\nrunZ2 = pipelineZ[{2, 5/4, 2/3}, wN];\nStringReplace[ToString[{\"z0\" -> runZ0, \"z1=(3/2,5/4,3/7)\" -> runZ1, \"z2=(2,5/4,2/3)\" -> runZ2}, InputForm], \"\\n\" -> \" \"]",
   "languageId": "wolfram",
