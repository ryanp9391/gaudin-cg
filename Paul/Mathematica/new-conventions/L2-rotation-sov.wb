  {
   "kind": 2,
   "value": "(* monodromy / fused T's with explicit h and θ (memoized on all arguments), so h and θ can be varied without touching the global Tm/tZ *)\nTmX[hh_, th_, v_] := TmX[hh, th, v] = Table[Sum[(KroneckerDelta[i, k] (v - th[[1]]) id2 + hh E1[i, k]) . (KroneckerDelta[k, j] (v - th[[2]]) id2 + hh E2[k, j]), {k, 3}], {i, 3}, {j, 3}];\nTMfX[hh_, th_, M_][i_, j_][v_] := Sum[TmX[hh, th, v][[i, l]] M[[l, j]], {l, 3}];\nqminorX[hh_, th_, M_][I_, J_][v_] := Sum[Signature[σ] Dot @@ Table[TMfX[hh, th, M][σ[[k]], J[[k]]][v - (k - 1) hh], {k, Length[J]}], {σ, Permutations[I]}];\ntAtX[hh_, th_, M_, a_, v_] := Sum[qminorX[hh, th, M][I, I][v], {I, Subsets[Range[3], {a}]}];\ntPolyX[hh_, th_, M_, a_] := Expand[Sum[tAtX[hh, th, M, a, uS[[k]]] Product[(u - uS[[l]])/(uS[[k]] - uS[[l]]), {l, DeleteCases[Range[7], k]}], {k, 7}]];\npipelineZH[zz_, ww_, hh_, th_] := Module[{Ω1x, Zdx, tZx, tZvx, T2x, v0x, rsNx, Pppx, Pmpx, Pdpx, Pph1x, Xd, Ω2x, Ml, rb, ω2x, dec, vsx, vpsx, vCx, vpCx, pe, psol, comp, cst, vst, vpst, κst, s2, a2, ystar},\n  Ω1x = oneSiteVac[zz, ww]; v0x = th[[1]] - 2 hh;\n  Zdx = DiagonalMatrix[zz]; tZx = Table[tPolyX[hh, th, Zdx, a], {a, 3}];\n  tZvx[a_, v_] := tZx[[a]] /. u -> v;\n  T2x[{1, 0}, v_] := tZvx[1, v]; T2x[{1, 1}, v_] := tZvx[2, v]; T2x[{2, 0}, v_] := tZvx[1, v] . tZvx[1, v + hh] - tZvx[2, v + hh]; T2x[{2, 1}, v_] := tZvx[2, v] . tZvx[1, v + hh] - tZvx[3, v + hh];\n  rsNx = rsSol /. Thread[zs -> zz];\n  Pppx = MatrixExp[(1/zz[[1]]) Ee[1, 2]] . MatrixExp[-(1/(zz[[1]] zz[[2]])) Ee[1, 3]] . MatrixExp[((zz[[1]] + zz[[2]])/(zz[[1]] zz[[2]])) Ee[2, 3]];\n  Pmpx = MatrixExp[(r[1] /. rsNx) Ee[3, 2]] . MatrixExp[(r[2] /. rsNx) Ee[3, 1]] . MatrixExp[(r[3] /. rsNx) Ee[2, 1]];\n  Pdpx = DiagonalMatrix[Table[Product[(s[k] /. rsNx)^J0[k][p], {k, 3}], {p, ps[{Λ}]}]];\n  Pph1x = Pmpx . Pdpx . Pppx; Xd[v_] := Xmat[v . Pph1x];\n  Ω2x = Flatten[KroneckerProduct[Ω1x, Ω1x]];\n  Ml[l_] := Partition[Ω2x . T2x[l, v0x], d1];\n  rb = DeleteCases[RowReduce[Ml[{1, 0}]], {0 ..}];\n  ω2x = Module[{cands = Select[rb, MatrixRank[{Ω1x, #}] == 2 &]}, cands[[1]]/cands[[1, Ordering[Abs[cands[[1]]], -1][[1]]]]];\n  dec[M_] := Module[{cs = Table[LinearSolve[Transpose[{Ω1x, ω2x}], M[[i]]], {i, d1}]}, {cs[[All, 1]], cs[[All, 2]]}];\n  vsx = Table[dec[Ml[l]][[1]], {l, lams}]; vpsx = Table[dec[Ml[l]][[2]], {l, lams}];\n  vCx = c0 Ω1x + c1 vsx[[1]] + c2 vsx[[2]] + c3 vsx[[3]] + c4 vsx[[4]]; vpCx = c1 vpsx[[1]] + c3 vpsx[[3]];\n  pe = DeleteCases[Union[Flatten[Minors[{vCx, vpCx}, 2]]], 0]; psol = Solve[pe == 0, cs5];\n  comp = First[Select[psol, FreeQ[#, c1 -> 0] && FreeQ[#, c3 -> 0] && Length[#] == 4 &]];\n  cst = (cs5 /. comp) /. c3 -> 1; vst = vCx /. Thread[cs5 -> cst]; vpst = vpCx /. Thread[cs5 -> cst]; κst = (vpst . vst)/(vst . vst);\n  s2 = Ω1x + κst ω2x; a2 = abOfX[Xd[s2]]; ystar = a2[[3]]/ww[[1]];\n  {\"c*\" -> cst, \"y*\" -> ystar, \"-(y*/w2)\" -> -ystar/ww[[2]], \"site2 = Ω(w1,y*)?\" -> (MatrixRank[{s2, oneSiteVac[zz, {ww[[1]], ystar, ww[[3]]}]}] == 1), \"v* rotation\" -> (Union[Flatten[Minors[Xd[vst], 2]]] === {0}), \"a(ω2)\" -> abOfX[Xd[ω2x]], \"a(v*)\" -> abOfX[Xd[vst]]}];\nrunH0 = pipelineZH[zN, wN, hN, thN];           (* control *)\nrunZ2b = pipelineZH[{3/2, 7/6, 2/3}, wN, hN, thN];   (* z2 changed *)\nrunH1 = pipelineZH[zN, wN, 1/3, thN];           (* h changed *)\nrunTh1 = pipelineZH[zN, wN, hN, {1/5, -4/9}];   (* θ changed *)\nStringReplace[ToString[{\"control\" -> runH0, \"z2=7/6\" -> runZ2b, \"h=1/3\" -> runH1, \"θ=(1/5,-4/9)\" -> runTh1}, InputForm], \"\\n\" -> \" \"]",
   "languageId": "wolfram",
