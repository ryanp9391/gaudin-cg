e=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˋ</span></span></span></span></span></span></span><span class=\"mord\">3.</span></span><span class=\"mord\">, </span><span class=\"mord\"><span class=\"mord\"><span class=\"mord\">2, 1</span></span><span class=\"mord\">, -31347/343000, 0</span></span></span><span class=\"mord\">, 3, </span><span class=\"mord\"><span class=\"mord\"><span class=\"mord\">c0 -&gt; 0, c1 -&gt; 0</span></span><span class=\"mord\">, </span><span class=\"mord\"><span class=\"mord\">c1 -&gt; 0, c2 -&gt; 0</span></span><span class=\"mord\">, </span><span class=\"mord\"><span class=\"mord\">c0 -&gt; 0, c1 -&gt; 0, c2 -&gt; 0</span></span></span><span class=\"mord\">, </span><span class=\"mord\"><span class=\"mord\"><span class=\"mord\">c0 -&gt; 0, c1 -&gt; 0</span></span><span class=\"mord\">, </span><span class=\"mord\"><span class=\"mord\">c1 -&gt; 0, c2 -&gt; 0</span></span></span></span><span class=\"mord\">&quot;</span></span></span></span></span></span></div></div></div>",
