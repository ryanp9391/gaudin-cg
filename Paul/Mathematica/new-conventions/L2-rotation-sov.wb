      {
       "data": "Out[2235]= \\begin{aligned}\n  &\\left\\{0.\\times 10^{-51},\\left\\{0,0\\right\\} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}0.271 & \\left\\{0.612,0.381,0.306,0.292,0.271\\right\\}\\\\0.137 & \\left\\{0.385,0.230,0.181,0.145,0.137\\right\\}\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\left\\{0.0977,0.0966\\right\\}\\right\\}\n\\end{aligned}",
