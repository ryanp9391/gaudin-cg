  {
   "kind": 2,
   "value": "(* closed-form state (companion frame): v2 = Ω_{(w1,y*)}, v1 = v2 . ρ((w2 - G(z)^T)^-1); y* = w2 (θ12 - h)/(θ12 - 2h) *)\nv2C = Ωc[{wN[[1]], yS, wN[[3]]}];\nv1C = v2C . ρG[Inverse[wN[[2]] IdentityMatrix[3] - Transpose[GzN]]];\nv1Calt = Ωc[{wN[[2]], yS, wN[[3]]}] . ρG[Inverse[wN[[1]] IdentityMatrix[3] - Transpose[GzN]]];\nchecks[\"v1: the two descriptions agree (rel dev)\"] = Last[cmpScale[N[v1C, 40], N[v1Calt, 40]]];\nchecks[\"v1, v2 are rotations (2nd/1st sv of X)\"] = {rank1dev[Xmat[v1C]], rank1dev[Xmat[v2C]]};\nΦcf = Flatten[KroneckerProduct[v1C, v2C]];\novlCF = Table[(Φcf . ketC[[B]])/(x0C . ketC[[B]]), {B, nS}];   (* normalized by <x0|Psi_B>, like det6/Psi_Q *)\n(* main identity: <v1⊗v2|Ψ_B>/<x0|Ψ_B> ∝ det6[Q_B, Q_vac,(w1,w2)]/Ψ_Q x det2^(1)[Q_B; y*]/minor1 *)\nratioMain = Table[ovlCF[[B]]/((det6[B, Fvac]/psiQ[B]) (su2det1[B, yS]/minor1[B])), {B, nS}];\nchecks[\"MAIN: <v1⊗v2|Ψ> ∝ det6(w) x ladder-1 det2(y*) (state-independence, 64 states)\"] = Max[Abs[ratioMain/ratioMain[[1]] - 1]];\nchecks[\"MAIN: the constant\"] = ratioMain[[1]];\n(* alternative (paper-like) labelling: det6 with the (w1,y*) vacuum Q's x ladder-1 det2 at w2 *)\nvacQ[ww_] := Module[{numx, GP, rO, O1, O2, tWx, kO, tau, qd}, numx = Join[Thread[zs -> zN], Thread[ws -> ww]]; GP = Simplify[Paux . Gc[ws] . Inverse[Paux]] /. numx;\n   rO = {r1 -> (w[1] - z[1])/(w[1] - z[2]), r2 -> ((w[1] - z[1]) (-w[2] + z[1]) (z[2] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (w[2] - z[3])), r3 -> ((w[1] - z[2]) (-w[2] + z[2]) (z[1] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (-w[2] + z[3]))} /. numx;\n   O1 = First[{UnitVector[d1, 1]} . MatrixExp[(r1 /. rO) Ee[1, 2]] . MatrixExp[(r2 /. rO) Ee[1, 3]] . MatrixExp[(r3 /. rO) Ee[2, 3]]]; O2 = Flatten[KroneckerProduct[O1, O1]];\n   tWx = Table[tPoly[GP, a], {a, 3}]; kO = Ordering[Abs[O2], -1][[1]]; tau = Table[Expand[(O2 . tWx[[a]])[[kO]]/O2[[kO]]], {a, 3}];\n   qd = Table[solveQ[opDir, N[tau, prec], ww[[i]], -1], {i, 3}];\n   If[FreeQ[qd, {}], With[{q = qd}, Function[{i, x}, N[ww[[i]]^(-x/hN), prec] (q[[i]] /. X -> x)]], $Failed]];\nFvacY = vacQ[{wN[[1]], yS, wN[[3]]}];\nratioAlt = If[FvacY === $Failed, $Failed, Table[ovlCF[[B]]/((det6[B, FvacY]/psiQ[B]) (su2det1[B, wN[[2]]]/minor1[B])), {B, nS}]];\nchecks[\"ALT: <v1⊗v2|Ψ> ∝ det6(w1,y*) x ladder-1 det2(w2)?\"] = If[ratioAlt === $Failed, \"vac Q's not found\", Max[Abs[ratioAlt/ratioAlt[[1]] - 1]]];\n(* sanity: the global vacuum Ω_{(w1,y*)}⊗Ω_{(w1,y*)} with its own Q's *)\nchecks[\"sanity: Ω(w1,y*)⊗Ω(w1,y*) ∝ det6[F_vac,(w1,y*)]\"] = If[FvacY === $Failed, \"n/a\", constQ[Table[(Flatten[KroneckerProduct[v2C, v2C]] . ketC[[B]])/(x0C . ketC[[B]])/(det6[B, FvacY]/psiQ[B]), {B, nS}]]];\nStringReplace[ToString[{N[checks[\"v1: the two descriptions agree (rel dev)\"], 3], N[checks[\"v1, v2 are rotations (2nd/1st sv of X)\"], 3], N[checks[\"MAIN: <v1⊗v2|Ψ> ∝ det6(w) x ladder-1 det2(y*) (state-independence, 64 states)\"], 3], N[checks[\"MAIN: the constant\"], 12], N[checks[\"ALT: <v1⊗v2|Ψ> ∝ det6(w1,y*) x ladder-1 det2(w2)?\"], 3], N[checks[\"sanity: Ω(w1,y*)⊗Ω(w1,y*) ∝ det6[F_vac,(w1,y*)]\"], 3]}, InputForm], \"\\n\" -> \" \"]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<details class=\"vscode-wolfram-message-output\" style=\"color:#f44;border-left:3px solid #f44;background:rgba(255,68,68,0.08);padding:2px 6px;margin:1px 0;border-radius:0 3px 3px 0;font-family:monospace;font-size:0.85em\"><summary style=\"cursor:pointer\">10 warnings</summary><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Syntax::sntxf: &quot;(* closed-form state (companion frame): v2 = Ω_{(w1,y*)&quot; cannot be followed by &quot;}, v1 = v2 . ρ((w2 - G(z)^T)^-1); y* = w2 (θ12 - h)/(θ12 - 2h) *)&quot;.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Syntax::sntxf: &quot;&quot; cannot be followed by &quot;(* closed-form state (companion frame): v2 = Ω_{(w1,y*)}, v1 = v2 . ρ((w2 - G(z)^T)^-1); y* = w2 (θ12 - h)/(θ12 - 2h) *)&quot;.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Syntax::sntxf: &quot;&quot; cannot be followed by &quot;e): v2 = Ω_{(w1,y*)}, v1 = v2 . ρ((w2 - G(z)^T)^-1); y* = w2 (θ12 - h)/(θ12 - 2h) *)&quot;.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Syntax::sntxf: &quot;&quot; cannot be followed by &quot;ion frame): v2 = Ω_{(w1,y*)}, v1 = v2 . ρ((w2 - G(z)^T)^-1); y* = w2 (θ12 - h)/(θ12 - 2h) *)&quot;.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Syntax::sntxf: &quot;&quot; cannot be followed by &quot; w2 (θ12 - h)/(θ12 - 2h) *)&quot;.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Syntax::sntxf: &quot;&quot; cannot be followed by &quot;v2 = Ω_{(w1,y*)}, v1 = v2 . ρ((w2 - G(z)^T)^-1); y* = w2 (θ12 - h)/(θ12 - 2h) *)&quot;.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Syntax::sntxf: &quot;&quot; cannot be followed by &quot;form state (companion frame): v2 = Ω_{(w1,y*)}, v1 = v2 . ρ((w2 - G(z)^T)^-1); y* = w2 (θ12 - h)/(θ12 - 2h) *)&quot;.</div><div style=\"padding:2px 0 2px 4px;bo