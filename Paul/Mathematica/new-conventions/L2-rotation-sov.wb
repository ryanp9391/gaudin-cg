   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* K matrices on the 8 site-1 triples: K^(vac) and K^(20) (rows ν = source L=1 covector, columns = site-1 triple) *)\nKmat[s2_] := Table[With[{sel = Select[Krat[ν], #[[1]] == {trip[[x]], s2} &]}, If[sel === {}, 0, sel[[1, 2]]]], {ν, 8}, {x, 8}];\nKvac = Kmat[{-3, -2, -1}]; K20 = Kmat[{-3, -2, 0}];\n(* the two group coefficient vectors for a rotation c, and their orbit test *)\nφgrp[cvec_] := {cvec . Kvac, cvec . K20};\norbitTest[cvec_] := rank1dev /@ Xc /@ φgrp[cvec];\n(* several generic rotations: random g = exp(ω), c = (e1.ρ(g)).xL1^-1 *)\nSeedRandom[11];\nrotC[ω_] := (uv[1] . MatrixExp[N[Sum[ω[[i, j]] Ee[i, j], {i, 3}, {j, 3}], prec]]) . Inverse[N[xL1, prec]];\nωs = Table[RandomReal[{-1, 1}, {3, 3}, WorkingPrecision -> prec], {4}];\norbitTab = Prepend[Table[orbitTest[rotC[ω]], {ω, ωs}], orbitTest[cL1]];\nchecks[\"φ^(1) = c.Kvac on the rotation orbit? (2nd/1st sv over 5 rotations)\"] = Max[orbitTab[[All, 1]]];\nchecks[\"φ^(2) = c.K20 on the rotation orbit? (2nd/1st sv over 5 rotations)\"] = Max[orbitTab[[All, 2]]];\n(* and the ranks of K^(vac), K^(20) themselves *)\nStringRiffle[{MatrixRank[Kvac], MatrixRank[K20], N[orbitTab, 3]}, \" | \"]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"368062\" data-output-id=\"25\" data-out-n=\"307\" data-sub-idx=\"14\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"63\" data-sub-start=\"14\" data-sub-end=\"14\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[307]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"14\" data-latex-b64=\"XHRleHR7OCB8IDQgfCBce1x7MC4wNjU3LCAwLjA1NFx9LCBcezAuMTM3LCAwLjA0OTFcfSwgXHswLjA2MDIsIDAuMDQ2NFx9LCBcezAuMDU4MywgMC4wNDk1XH0sIFx7MC4xOTcsIDAuMDExXH1cfX0=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\"><span class=\"mord\">8 | 4 | {{0.0657, 0.054}, {0.137, 0.0491}, {0.0602, 0.0464}, {0.0583, 0.0495}, {0.197, 0.011}}</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[307]= \\text{8 | 4 | \\{\\{0.0657, 0.054\\}, \\{0.137, 0.0491\\}, \\{0.0602, 0.0464\\}, \\{0.0583, 0.0495\\}, \\{0.197, 0.011\\}\\}}",
