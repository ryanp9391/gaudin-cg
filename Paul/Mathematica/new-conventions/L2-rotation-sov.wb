an style=\"top:-2.8801em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">Ω</span><span class=\"mord mathnormal\">ρ</span><span class=\"mord\">(D) = g (exact)</span></span></span></span><span style=\"top:-1.6399em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">D, w2(y)</span></span></span></span><span style=\"top:-0.4399em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">MAIN state-independence</span></span></span></span><span style=\"top:0.7601em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">partner rotation, rank{partner, g}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.5752em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:9.6503em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.5752em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.0752em;\"><span style=\"top:-7.6903em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-6.4903em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=