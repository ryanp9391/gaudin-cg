      {
       "data": "Out[220]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{per-ladder: $\\Omega$\\_w$\\otimes$$\\Omega$\\_w $\\propto$ det6L[\\{Fvac,Fvac\\}]/Psi\\_Q} \\\\\n  &\\to 0.\\times 10^{-51} \\\\\n  &,\\text{per-ladder: x0 $\\propto$ det6L[\\{F0,F0\\}]/Psi\\_Q} \\\\\n  &\\to 0.\\times 10^{-51} \\\\\n  &,\\text{per-ladder: $\\Omega$\\_w$\\otimes$e1 $\\propto$ det6L[\\{Fvac(L=2), F0\\}]/Psi\\_Q} \\\\\n  &\\to 91.12969026550718471964{\\color{gray}\\vdots} \\\\\n  &{\\color{gray}\\vdots}55908739114053095272219878227774 \\\\\n  &,\\text{per-ladder: $\\Omega$\\_w$\\otimes$e1 $\\propto$ det6L[\\{Fvac(L=1), F0\\}]/Psi\\_Q} \\\\\n  &\\to 141.10411526627724105250{\\color{gray}\\vdots} \\\\\n  &{\\color{gray}\\vdots}36815719430287689342{\\color{gray}\\vdots} \\\\\n  &{\\color{gray}\\vdots}08411991355\\rvert\\!\\rangle\n\\end{aligned}",
