  {
   "kind": 2,
   "value": "F0 = Fdelta[-2, 0];\nchecks[\"F0 = (δ_{θs-2h}, δ_{θs}) reproduces x0: det6[F0]/Psi_Q const\"] = constQ[Table[det6[B, F0]/psiQ[B], {B, nS}]];\n(* companion-frame one-site w-vacuum: Ω_w = e1^T Ppp(w) *)\nPppW[y_] := MatrixExp[(1/y[[1]]) Ee[1, 2]] . MatrixExp[-(1/(y[[1]] y[[2]])) Ee[1, 3]] . MatrixExp[((y[[1]] + y[[2]])/(y[[1]] y[[2]])) Ee[2, 3]];\nΩc[y_] := uv[1] . PppW[y];\nTA = Table[(Flatten[KroneckerProduct[Ωc[wN], uv[1]]] . ketC[[B]])/(x0C . ketC[[B]]), {B, nS}];\n(* sanity: both sites rotated reproduces the usual 6x6 *)\nchecks[\"Ω_w⊗Ω_w (companion) ∝ det6[F_vac,w]/Psi_Q\"] = constQ[Table[(Flatten[KroneckerProduct[Ωc[wN], Ωc[wN]]] . ketC[[B]])/(x0C . ketC[[B]])/(det6[B, Fvac]/psiQ[B]), {B, nS}]];\n(* L=1 w-vacuum direct Q's at site 1: q1 = 1, q2, q3 from the one-site Baxter equation with nu_n(x) = x - θ1 + h Λ_n *)\nnu1[n_][x_] := x - thN[[1]] + hN Λ[[n]];\ntVac1 = {Sum[wN[[j]] nu1[j][u], {j, 3}], Sum[wN[[i]] wN[[j]] nu1[i][u] nu1[j][u - hN], {i, 3}, {j, i + 1, 3}], (Times @@ wN) nu1[1][u] nu1[2][u - hN] nu1[3][u - 2 hN]};\nopDir1[tt_, Q_, x_] := nu1[1][x] nu1[1][x + hN] nu1[1][x + 2 hN] Q[x - hN] - (tt[[1]] /. u -> x) nu1[1][x + hN] nu1[1][x + 2 hN] Q[x] + (tt[[2]] /. u -> x + hN) nu1[1][x + 2 hN] Q[x + hN] - (tt[[3]] /. u -> x + 2 hN) Q[x + 2 hN];\nqdVac1 = Table[solveQ[opDir1, tVac1, wN[[i]], -1], {i, 3}];\nchecks[\"L=1 vacuum q's found, degrees (0,1,2)\"] = FreeQ[qdVac1, {}] && Exponent[qdVac1, X] === {0, 1, 2};\nQDv1[i_, x_] := N[wN[[i]]^(-x/hN), prec] (qdVac1[[i]] /. X -> x);\n(* mixed bra data: ladder 1 -> w-vacuum Q's (L=2 or L=1 version), ladder 2 -> F0 *)\nFmixL2 = Function[{i, x}, If[ladOf[x] == 1, QD[\"vac\", i, x], F0[i, x]]];\nFmixL1 = Function[{i, x}, If[ladOf[x] == 1, QDv1[i, x], F0[i, x]]];\nchecks[\"Ω_w⊗e1: ladder1 = L=2 vac Q's, ladder2 = F0\"] = constQ[Table[TA[[B]]/(det6[B, FmixL2]/psiQ[B]), {B, nS}]];\nchecks[\"Ω_w⊗e1: ladder1 = L=1 vac Q's, ladder2 = F0\"] = constQ[Table[TA[[B]]/(det6[B, FmixL1]/psiQ[B]), {B, nS}]];\nKeyTake[checks, {\"F0 = (δ_{θs-2h}, δ_{θs}) reproduces x0: det6[F0]/Psi_Q const\", \"Ω_w⊗Ω_w (companion) ∝ det6[F_vac,w]/Psi_Q\", \"L=1 vacuum q's found, degrees (0,1,2)\", \"Ω_w⊗e1: ladder1 = L=2 vac Q's, ladder2 = F0\", \"Ω_w⊗e1: ladder1 = L=1 vac Q's, ladder2 = F0\"}]",
   "languageId": "wolfram",
   "outputs": [
