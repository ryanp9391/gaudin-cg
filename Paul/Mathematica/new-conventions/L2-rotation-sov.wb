     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"368062\" data-output-id=\"31\" data-out-n=\"383\" data-sub-idx=\"15\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"89\" data-sub-start=\"15\" data-sub-end=\"15\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[383]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"14\" data-latex-b64=\"\"><span class=\"wolfbook-render-error\" style=\"color:#cc0000;font-family:monospace;white-space:pre-wrap\">[LaTeX error] KaTeX parse error: Undefined control sequence: \\[ at position 564: …, 8}, {{\\&quot;A=t2(\\̲[̲Theta]2+h)\\&quot;, 0…<br><small>\\text{&quot;{{{{{1, 0}, -3, 3}, {{1, 0}, -2, 2}, {{1, 0}, -1, 3}, {{1, 0}, 0, 3}, {{1, 0}, 1, 3}}, {{{1, 1}, -3, 3}, {{1, 1}, -2, 1}, {{1, 1}, -1, 3}, {{1, 1}, 0, 2}, {{1, 1}, 1, 3}}, {{{2, 0}, -3, 6}, {{2, 0}, -2, 2}, {{2, 0}, -1, 6}, {{2, 0}, 0, 6}, {{2, 0}, 1, 6}}, {{{2, 1}, -3, 6}, {{2, 1}, -2, 1}, {{2, 1}, -1, 8}, {{2, 1}, 0, 6}, {{2, 1}, 1, 8}}}, {{{1, -3, 3}, {1, -2, 2}, {1, -1, 3}, {1, 0, 3}, {1, 1, 3}}, {{2, -3, 3}, {2, -2, 1}, {2, -1, 3}, {2, 0, 2}, {2, 1, 3}}, {{3, -3, 1}, {3, -2, 0}, {3, -1, 1}, {3, 0, 0}, {3, 1, 1}}}, {1, 1}, {3, 3, 3, 8}, {{\\&quot;A=t2(\\[Theta]2+h)\\&quot;, 0, 0.010470064606790667$\\grave{ }$3.}, {\\&quot;B=t2(\\[Theta]2+h)t1(\\[Theta]2-h)\\&quot;, 0.9481913110037143852$\\grave{ }$3., 0.0031594264126092212$\\grave{ }$3.}}, 0}&quot;}</small></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[383]= \\text{\"{{{{{1, 0}, -3, 3}, {{1, 0}, -2, 2}, {{1, 0}, -1, 3}, {{1, 0}, 0, 3}, {{1, 0}, 1, 3}}, {{{1, 1}, -3, 3}, {{1, 1}, -2, 1}, {{1, 1}, -1, 3}, {{1, 1}, 0, 2}, {{1, 1}, 1, 3}}, {{{2, 0}, -3, 6}, {{2, 0}, -2, 2}, {{2, 0}, -1, 6}, {{2, 0}, 0, 6}, {{2, 0}, 1, 6}}, {{{2, 1}, -3, 6}, {{2, 1}, -2, 1}, {{2, 1}, -1, 8}, {{2, 1}, 0, 6}, {{2, 1}, 1, 8}}}, {{{1, -3, 3}, {1, -2, 2}, {1, -1, 3}, {1, 0, 3}, {1, 1, 3}}, {{2, -3, 3}, {2, -2, 1}, {2, -1, 3}, {2, 0, 2}, {2, 1, 3}}, {{3, -3, 1}, {3, -2, 0}, {3, -1, 1}, {3, 0, 0}, {3, 1, 1}}}, {1, 1}, {3, 3, 3, 8}, {{\\\"A=t2(\\[Theta]2+h)\\\", 0, 0.010470064606790667$\\grave{ }$3.}, {\\\"B=t2(\\[Theta]2+h)t1(\\[Theta]2-h)\\\", 0.9481913110037143852$\\grave{ }$3., 0.0031594264126092212$\\grave{ }$3.}}, 0}\"}",
