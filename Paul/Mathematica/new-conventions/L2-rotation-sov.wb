      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607003\" data-output-id=\"31\" data-out-n=\"482\" data-sub-idx=\"17\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"6\" data-sub-start=\"17\" data-sub-end=\"17\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[482]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-line-broken=\"1\" data-latex-b64=\"XGJlZ2lue2FsaWduZWR9CiAgJjAuMDAwMTQyNjY0Nzc5MjM4MDkyMDk5Mjk4MjcyOTg5MTQ5MjgxMzAxOXtcY29sb3J7Z3JheX1cdmRvdHN9IFxcCiAgJntcY29sb3J7Z3JheX1cdmRvdHN9MzczMDIxMTM5Nzg1MDc2MDQ0MQpcZW5ke2FsaWduZWR9\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.32em;vertical-align:-1.91em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.41em;\"><span style=\"top:-4.41em;\"><span class=\"pstrut\" style=\"height:3.5em;\"></span><span class=\"mord\"></span></span><span style=\"top:-2.25em;\"><span class=\"pstrut\" style=\"height:3.5em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.91em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.41em;\"><span style=\"top:-4.5975em;\"><span class=\"pstrut\" style=\"height:3.6875em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mord\">0.0001426647792380920992982729891492813019</span><span class=\"mord\"><span class=\"mord\" style=\"color:gray;\"><span class=\"mord\" style=\"color:gray;\">⋮</span><span class=\"mord rule\" style=\"color:gray;border-right-width:0em;border-top-width:1.5em;bottom:0em;\"></span></span></span></span></span><span style=\"top:-2.4375em;\"><span class=\"pstrut\" style=\"height:3.6875em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mord\"><span class=\"mord\" style=\"color:gray;\"><span class=\"mord\" style=\"color:gray;\">⋮</span><span class=\"mord rule\" style=\"color:gray;border-right-width:0em;border-top-width:1.5em;bottom:0em;\"></span></span></span><span class=\"mord\">3730211397850760441</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.91em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
