       "data": "Syntax::sntxf: \"ecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}\" cannot be followed by \"] &]]]] . x0C)/(cSoV . vecB . x0C) ;\".\nSyntax::sntxf: \"\" cannot be followed by \"m = cSoV Nm (vecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}] &]]]] . x0C)/(cSoV . vecB . x0C) ;\".\nSyntax::sntxf: \"\" cannot be followed by \"Cm = cSoV Nm (vecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}] &]]]] . x0C)/(cSoV . vecB . x0C) ;\".\nSyntax::sntxf: \"\" cannot be followed by \"Cm = cSoV Nm (vecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}] &]]]] . x0C)/(cSoV . vecB . x0C) ;\".\nSyntax::sntxf: \"\" cannot be followed by \"Cm = cSoV Nm (vecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}] &]]]] . x0C)/(cSoV . vecB . x0C) ;\".\nSyntax::sntxf: \"\" cannot be followed by \"Cm = cSoV Nm (vecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}] &]]]] . x0C)/(cSoV . vecB . x0C) ;\".\nSyntax::sntxf: \"\" cannot be followed by \"m = cSoV Nm (vecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}] &]]]] . x0C)/(cSoV . vecB . x0C) ;\".\nSyntax::sntxf: \"\" cannot be followed by \" cSoV Nm (vecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}] &]]]] . x0C)/(cSoV . vecB . x0C) ;\".\nSyntax::sntxf: \"\" cannot be followed by \"Cm = cSoV Nm (vecB[[First[Select[Range[64], lab[#] == {{-3, -2, -1}, {-3, -2, -1}] &]]]] . x0C)/(cSoV . vecB . x0C) ;\".",
