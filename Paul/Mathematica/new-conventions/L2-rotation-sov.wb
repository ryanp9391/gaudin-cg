  {
   "kind": 2,
   "value": "ee[i_, j_] := Table[KroneckerDelta[i, ii] KroneckerDelta[j, jj], {ii, 3}, {jj, 3}];\nzs = {z[1], z[2], z[3]}; ws = {w[1], w[2], w[3]};\nχ[tw_] := {tw[[1]] + tw[[2]] + tw[[3]], tw[[1]] tw[[2]] + tw[[1]] tw[[3]] + tw[[2]] tw[[3]], tw[[1]] tw[[2]] tw[[3]]};\nGc[tw_] := With[{c = χ[tw]}, {{c[[1]], -c[[2]], c[[3]]}, {1, 0, 0}, {0, 1, 0}}];\n(* auxiliary-space Gauss factors, verbatim from the clean L=1 notebook *)\nPpa = MatrixExp[-(1/z[1]) ee[2, 1]] . MatrixExp[(1/(z[1] z[2])) ee[3, 1]] . MatrixExp[-((z[1] + z[2])/(z[1] z[2])) ee[3, 2]];\nPma = MatrixExp[-r[1] ee[2, 3]] . MatrixExp[-r[2] ee[1, 3]] . MatrixExp[-r[3] ee[1, 2]];\nPda = MatrixExp[-Log[s[1]] ee[1, 1]] . MatrixExp[-Log[s[2]] ee[2, 2]] . MatrixExp[-Log[s[3]] ee[3, 3]];\nrsSol = {s[1] -> z[1]^2/((z[1] - z[2]) (z[1] - z[3])), s[2] -> -(z[2]/(z[1] (z[2] - z[3]))), s[3] -> 1/(z[1] z[2]), r[1] -> -(z[3]/z[2]), r[2] -> -(z[3]/z[1]), r[3] -> (z[2]^2 (-z[1] + z[3]))/(z[1]^2 (z[2] - z[3]))};\nPaux = Simplify[Pma . Pda . Ppa /. rsSol];\nnumZW = Join[Thread[zs -> zN], Thread[ws -> wN]];\nGPzw = Simplify[Paux . Gc[ws] . Inverse[Paux]] /. numZW;\nrOm = {r1 -> (w[1] - z[1])/(w[1] - z[2]), r2 -> ((w[1] - z[1]) (-w[2] + z[1]) (z[2] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (w[2] - z[3])), r3 -> ((w[1] - z[2]) (-w[2] + z[2]) (z[1] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (-w[2] + z[3]))} /. numZW;\nΩ1 = First[{UnitVector[d1, 1]} . MatrixExp[(r1 /. rOm) Ee[1, 2]] . MatrixExp[(r2 /. rOm) Ee[1, 3]] . MatrixExp[(r3 /. rOm) Ee[2, 3]]];\nΩ2 = Flatten[KroneckerProduct[Ω1, Ω1]];\ntW = Table[tPoly[GPzw, a], {a, 3}];\nkOm = Ordering[Abs[Ω2], -1][[1]];\ntauVac = Table[Expand[(Ω2 . tW[[a]])[[kOm]]/Ω2[[kOm]]], {a, 3}];\nchecks[\"Ωzw⊗Ωzw left eigenvector of t_a(G') (exact)\"] = And @@ Table[Union[Flatten[Expand[Ω2 . tW[[a]] - tauVac[[a]] Ω2]]] === {0}, {a, 3}];\nqdVac = Table[solveQ[opDir, N[tauVac, prec], wN[[i]], -1], {i, 3}];\nchecks[\"vacuum direct q's found, degrees (0,2,4)\"] = FreeQ[qdVac, {}] && Exponent[qdVac, X] === {0, 2, 4};\nKeyTake[checks, {\"Ωzw⊗Ωzw left eigenvector of t_a(G') (exact)\", \"vacuum direct q's found, degrees (0,2,4)\"}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607003\" data-output-id=\"30\" data-out-n=\"466\" data-sub-idx=\"21\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"5\" data-sub-start=\"21\" data-sub-end=\"21\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[466]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.5em;vertical-align:-2em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.5em;\"><span style=\"top:-4.5em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span><span style=\"top:-1.5em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.5em;\"><span style=\"top:-4.66em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mopen\">⟨</span><span class=\"mspace\" style=\"margin-right:-0.1667em;\"></span><span class=\"mopen\">∣</span><span class=\"mord text\"><span class=\"mord\">Ωzw</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⊗</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">Ωzw left eigenvector of t_a(G’) (exact)</span></span></span></span><span style=\"top:-3.16em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord\">vacuum direct q’s found, degrees (0,2,4)</span></span></span></span><span style=\"top:-1.66em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mclose\">∣</span><span class=\"mspace\" style=\"margin-right:-0.1667em;\"></span><span class=\"mclose\">⟩</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[466]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{$\\Omega$zw$\\otimes$$\\Omega$zw left eigenvector of t\\_a(G') (exact)} \\\\\n  &\\to \\mathrm{True},\\text{vacuum direct q's found, degrees (0,2,4)} \\\\\n  &\\to \\mathrm{True}\\rvert\\!\\rangle\n\\end{aligned}",
       "mime": "text/plain"
