   "value": "(* 3. ε-scaling of the nonzero overlaps (the localized u stay O(1)); x0 via its factorized inverse, since Inverse[P_phys] is badly conditioned at small ε *)\nrsSol[zv_] := {s1 -> zv[[1]]^2/((zv[[1]] - zv[[2]]) (zv[[1]] - zv[[3]])), s2 -> -(zv[[2]]/(zv[[1]] (zv[[2]] - zv[[3]]))), s3 -> 1/(zv[[1]] zv[[2]]), ρ1 -> -(zv[[3]]/zv[[2]]), ρ2 -> -(zv[[3]]/zv[[1]]), ρ3 -> (zv[[2]]^2 (zv[[3]] - zv[[1]]))/(zv[[1]]^2 (zv[[2]] - zv[[3]]))};\nx0One[zv_] := With[{q = rsSol[zv]}, e1 . nexp[-((zv[[1]] + zv[[2]])/(zv[[1]] zv[[2]])) EN[2, 3]] . nexp[(1/(zv[[1]] zv[[2]])) EN[1, 3]] . nexp[-(1/zv[[1]]) EN[1, 2]] . DiagonalMatrix[Table[Product[({s1, s2, s3}[[k]] /. q)^(-J0[k][p]), {k, 3}], {p, ps[{Λ}]}]] . nexp[-(ρ3 /. q) EN[2, 1]] . nexp[-(ρ2 /. q) EN[3, 1]] . nexp[-(ρ1 /. q) EN[3, 2]]];\nscal = Table[With[{zv = N[Exp[ε φ], pr], wv = N[Exp[ε ω], pr]}, {ε, N[Max[Norm /@ uAll[zv, wv]], 3], N[Max[Norm /@ ovl[zv, wv, {5, 4, 3}]], 3], N[Norm[ovl[zv, wv, {4, 4, 4}][[4]]], 3], N[Norm[x0One[zv]]^2, 3]}], {ε, {10^-4, 10^-5, 10^-6}}];\nGrid[Join[{{\"ε\", \"max ‖u‖\", \"max ‖c·h‖ on HW_[5,4,3]\", \"‖c_T(4,2)·h_[4,4,4]‖\", \"‖x0‖ (two-site)\"}}, scal,\n   {{\"ε-power (last two ε)\", \"\", N[Log10[scal[[3, 3]]/scal[[2, 3]]]/(-1), 3], N[Log10[scal[[3, 4]]/scal[[2, 4]]]/(-1), 3], N[Log10[scal[[3, 5]]/scal[[2, 5]]]/(-1), 3]}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"942214\" data-output-id=\"37\" data-out-n=\"385\" data-sub-idx=\"4\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"4\" data-sub-start=\"4\" data-sub-end=\"5\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[385]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"26\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:6.0553em;vertical-align:-2.7577em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.2977em;\"><span style=\"top:-5.2577em;\"><span class=\"pstrut\" style=\"height:5.2577em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6.0153em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.7577em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.2577em;\"><span style=\"top:-5.4177em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">ε</span></span></span><span style=\"top:-4.2126em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"m