       "data": "Out[373]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{site weight $\\nu$} & \\text{mult} & \\text{site1 T\\{1, 1\\}} & \\text{site1 T\\{2, 2\\}} & \\text{site1 T\\{3, 2\\}} & \\text{site1 T\\{4, 2\\}} & \\text{site2 t2($\\theta$2+h)} & \\text{site2 T(2,2)($\\theta$2)}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & 0.97\\text{ | }1.00 & 0.87\\text{ | }1.00 & 0.61\\text{ | }1.00 & 0.30\\text{ | }1.00 & 0.89\\text{ | }1.00 & 0.67\\text{ | }1.00\\\\\\hline\\left\\{4,1,1\\right\\} & 1 & 0\\text{ | }0 & 0\\text{ | }0 & 0.56\\text{ | }4.7\\times 10^{-6} & 0.55\\text{ | }9.4\\times 10^{-6} & 0.44\\text{ | }4.7\\times 10^{-6} & 0.65\\text{ | }9.4\\times 10^{-6}\\\\\\hline\\left\\{4,0,2\\right\\} & 1 & 0\\text{ | }0 & 0\\text{ | }0 & 0\\text{ | }0 & 0.50\\text{ | }4.4\\times 10^{-11} & 0\\text{ | }0 & 0.32\\text{ | }4.4\\times 10^{-11}\\\\\\hline\\left\\{3,3,0\\right\\} & 1 & 0.11\\text{ | }0.000018 & 0.20\\text{ | }0.000035 & 0.14\\text{ | }0.000035 & 0.068\\text{ | }0.000035 & 0\\text{ | }0 & 0\\text{ | }0\\\\\\hline\\left\\{3,2,1\\right\\} & 2 & 0.24\\text{ | }0.000011 & 0.43\\text{ | }0.000021 & 0.40\\text{ | }0.000029 & 0.25\\text{ | }0.000039 & 0.097\\text{ | }0.000011 & 0.14\\text{ | }0.000021\\\\\\hline\\left\\{3,1,2\\right\\} & 2 & 0\\text{ | }0 & 0\\text{ | }0 & 0.32\\text{ | }1.2\\times 10^{-10… [latex truncated: 3552 chars total]",
