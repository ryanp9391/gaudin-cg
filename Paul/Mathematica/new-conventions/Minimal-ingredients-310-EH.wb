       "data": "Out[662]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{spread over directions} & \\text{k = K\\_j/S\\_ref, j = \\{\\{1, 1\\}, \\{2, 2\\}, \\{3, 2\\}, A, B\\}} & \\text{s = S\\_j/S\\_ref}\\\\\\hline\\left\\{6,1,1\\right\\} & 1 & 0.000014 & \\left\\{0.\\times 10^{-106},0.\\times 10^{-100},-1.4276\\times 10^{-6},8.1813\\times 10^{-7},9.3501\\times 10^{-8}\\right\\} & \\left\\{0.\\times 10^{-107},0.\\times 10^{-108},1.\\,,0.57306,0.065493\\right\\}\\\\\\hline\\left\\{5,3,0\\right\\} & 1 & 0.000014 & \\left\\{2.3583\\times 10^{-7},3.5374\\times 10^{-7},-1.7687\\times 10^{-7},0.\\times 10^{-112},5.7918\\times 10^{-9}\\right\\} & \\left\\{-1.3333,-2.0000,1.\\,,0.\\times 10^{-105},0.032746\\right\\}\\\\\\hline\\left\\{5,2,1\\right\\} & 1 & 0.000017 & \\left\\{-1.2187\\times 10^{-6},-1.8280\\times 10^{-6},8.8366\\times 10^{-7},-2.0221\\times 10^{-8},2.7170\\times 10^{-8}\\right\\} & \\left\\{-0.29305,-0.43958,1.\\,,-0.017312,0.031757\\right\\}\\\\\\hline\\left\\{5,2,1\\right\\} & 2 & 0.000015 & \\left\\{-1.0056\\times 10^{-6},-1.5084\\times 10^{-6},8.7660\\times 10^{-7},1.6364\\times 10^{-8},1.7965\\times 10^{-8}\\right\\} & \\left\\{-0.94350,-1.4153,1.\\,,0.26225,0.047732\\right\\}\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & 3.6\\times 10^{-6} & \\left\\{-1.0286,-1.5428,0.77143,0.\\times 10^{-105},… [latex truncated: 2239 chars total]",
