      {
       "data": "Out[652]= \\begin{matrix}\\begin{array}{|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{$\\kappa$(v1), $\\varepsilon$=10\\^{}-3} & \\text{$\\varepsilon$=10\\^{}-4}\\\\\\hline\\left\\{6,2,0\\right\\} & 1 & \\text{0 = 0} & \\text{0 = 0}\\\\\\hline\\left\\{6,1,1\\right\\} & 1 & \\text{0 = 0} & \\text{0 = 0}\\\\\\hline\\left\\{5,3,0\\right\\} & 1 & 0.999982 & 0.999998\\\\\\hline\\left\\{5,2,1\\right\\} & 1 & 1.00042 & 1.00004\\\\\\hline\\left\\{5,2,1\\right\\} & 2 & 1.00011 & 1.00001\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & 1.00037 & 1.00004\\\\\\hline\\left\\{4,3,1\\right\\} & 1 & 1.00080 & 1.00008\\\\\\hline\\left\\{4,3,1\\right\\} & 2 & 1.00010 & 1.00001\\\\\\hline\\left\\{4,2,2\\right\\} & 1 & 1.00059 & 1.00006\\\\\\hline\\left\\{3,3,2\\right\\} & 1 & \\text{CG = 0} & \\text{CG = 0}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{functionals} & \\text{rel. singular values, $\\varepsilon$=10\\^{}-4} & \\text{$\\varepsilon$=10\\^{}-5}\\\\\\hline\\text{[5,2,1]: d11, d22, d32, five w} & \\left\\{1.\\,,0.130\\right\\} & \\left\\{1.\\,,0.130\\right\\}\\\\\\hline\\text{[5,2,1]: d11 only, five w} & \\left\\{1.\\,,0\\right\\} & \\left\\{1.\\,,0\\right\\}\\\\\\hline\\text{[4,3,1]: v1 only, five w} & \\left\\{1.\\,,0\\right\\} & \\left\\{1.\\,,0\\right\\}\\\\\\hline\\text{time (s)} & 8.67234 & \\\\\\hline\\end{array}\\end{matrix}",
       "mime": "text/plain"
      }
