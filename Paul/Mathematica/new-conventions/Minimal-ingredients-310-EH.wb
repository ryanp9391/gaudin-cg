      {
       "data": "Out[697]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{mult} & \\text{dim sector clean (site 1)} & \\text{sector HW rel. sv ($\\varepsilon$=10\\^{}-5)} & \\text{per copy: \\{space, \\{rel. err, digits\\} at (10\\^{}-4, $\\varphi$), at (10\\^{}-5, $\\varphi$')\\}}\\\\\\hline\\left\\{6,1,1\\right\\} & 1 & 3 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & \\left\\{0.0000143,88\\right\\} & \\left\\{5.04\\times 10^{-7},84\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{5,3,0\\right\\} & 1 & 3 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & \\left\\{1.77\\times 10^{-6},91\\right\\} & \\left\\{2.21\\times 10^{-7},88\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{5,2,1\\right\\} & 2 & 3 & \\left\\{1.\\,,0.130\\right\\} & \\begin{pmatrix}\\text{sector} & \\left\\{0.0000356,89\\right\\} & \\left\\{2.98\\times 10^{-7},84\\right\\}\\\\\\text{sector} & \\left\\{0.0000556,91\\right\\} & \\left\\{1.26\\times 10^{-6},86\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & 2 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & \\left\\{0.0000395,82\\right\\} & \\left\\{1.40\\times 10^{-6},75\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{4,3,1\\right\\} & 2 & 1 & \\left\\{1.\\,,5.94\\times 10^{-12}\\right\\} & \\begin{pmatrix}\\text{per copy} & \\left\\{5.88\\times 10^{-6},78\\right\\} & \\left\\{4.28\\times 10^{-7… [latex truncated: 1716 chars total]",
