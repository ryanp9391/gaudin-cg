      {
       "data": "Out[638]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{$\\kappa$ raw c\\{1, 1\\} ($\\varepsilon$=10\\^{}-4)} & \\text{$\\kappa$ top-killed d\\{1, 1\\} (10\\^{}-3)} & \\text{(10\\^{}-4)} & \\text{$\\kappa$ raw c\\{2, 2\\} ($\\varepsilon$=10\\^{}-4)} & \\text{$\\kappa$ top-killed d\\{2, 2\\} (10\\^{}-3)} & \\text{(10\\^{}-4)} & \\text{$\\kappa$ raw c\\{3, 2\\} ($\\varepsilon$=10\\^{}-4)} & \\text{$\\kappa$ top-killed d\\{3, 2\\} (10\\^{}-3)} & \\text{(10\\^{}-4)}\\\\\\hline\\left\\{6,2,0\\right\\} & 1 & 1.\\, & \\text{0 = 0} & \\text{0 = 0} & 1.\\, & \\text{0 = 0} & \\text{0 = 0} & 1.\\, & \\text{0 = 0} & \\text{0 = 0}\\\\\\hline\\left\\{6,1,1\\right\\} & 1 & \\text{CG = 0} & \\text{0 = 0} & \\text{0 = 0} & \\text{CG = 0} & \\text{0 = 0} & \\text{0 = 0} & 1.38571 & 0.999857 & 0.999986\\\\\\hline\\left\\{5,3,0\\right\\} & 1 & 0.885716 & 0.999982 & 0.999998 & 0.942857 & 0.999982 & 0.999998 & 0.942857 & 0.999982 & 0.999998\\\\\\hline\\left\\{5,2,1\\right\\} & 1 & 0.859993 & 1.00042 & 1.00004 & 0.930017 & 1.00042 & 1.00004 & 0.984618 & 1.00009 & 1.00001\\\\\\hline\\left\\{5,2,1\\right\\} & 2 & 0.168625 & 1.00011 & 1.00001 & 0.584318 & 1.00011 & 1.00001 & 0.705854 & 1.00009 & 1.00001\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & \\text{CG = 0} & \\text{CG = 0} & \\text{CG =… [latex truncated: 2130 chars total]",
