      {
       "data": "Out[643]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{directions} & \\varepsilon  & \\text{K\\_j/S\\_ref  (j = \\{\\{1, 1\\}, \\{2, 2\\}, \\{3, 2\\}\\})} & \\text{S\\_j/S\\_ref}\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & \\text{$\\varphi$, $\\omega$} & \\frac{1}{10000} & \\left\\{-1.02847,-1.54278,0.771427\\right\\} & \\left\\{0.\\times 10^{-105},-1.99991,1.\\,\\right\\}\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & \\text{$\\varphi$, $\\omega$} & \\frac{1}{100000} & \\left\\{-1.02856,-1.54285,0.771428\\right\\} & \\left\\{0.\\times 10^{-102},-1.99999,1.\\,\\right\\}\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & \\text{$\\varphi$', $\\omega$} & \\frac{1}{10000} & \\left\\{-1.02844,-1.54276,0.771431\\right\\} & \\left\\{0.\\times 10^{-106},-1.99987,1.\\,\\right\\}\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & \\text{$\\varphi$', $\\omega$} & \\frac{1}{100000} & \\left\\{-1.02856,-1.54285,0.771429\\right\\} & \\left\\{0.\\times 10^{-103},-1.99999,1.\\,\\right\\}\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & \\text{$\\varphi$, $\\omega$'} & \\frac{1}{10000} & \\left\\{-1.02847,-1.54278,0.771427\\right\\} & \\left\\{0.\\times 10^{-105},-1.99991,1.\\,\\right\\}\\\\\\hline\\left\\{4,4,0\\right\\} & 1 & \\text{$\\varphi$, $\\omega$'} & \\frac{1}{100000} & \\left\\{-1.02856,-1.54285,0.771428\\right\\} & \\left\\{0.\\times 10^{-102},-1.9999… [latex truncated: 5551 chars total]",
