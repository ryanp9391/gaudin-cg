      {
       "data": "Out[628]= \\begin{array}{|c|c|c|c|}\\hline\\text{twist} & \\text{T\\_\\{1, 1\\}} & \\text{T\\_\\{2, 2\\}} & \\text{T\\_\\{3, 2\\}}\\\\\\hline\\text{finite test twist} & 0.\\times 10^{-115} & 0.\\times 10^{-113} & 0.\\times 10^{-109}\\\\\\hline\\text{$\\varepsilon$ = 10\\^{}-3} & 0.\\times 10^{-113} & 0.\\times 10^{-112} & 0.\\times 10^{-106}\\\\\\hline\\text{time (s)} & 1.060447 &  & \\\\\\hline\\end{array}",
