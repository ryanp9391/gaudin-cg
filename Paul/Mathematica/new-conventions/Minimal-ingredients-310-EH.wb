       "data": "Out[708]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\mu  & \\text{dual Baxter residual} & \\text{parallel: max |det2[v($\\theta$1), v($\\theta$1-nh)]|, n$\\le$$\\Lambda$2 (rel.)} & \\text{plane: max |det3| of consecutive v in [$\\theta$1-($\\Lambda$1+1)h, $\\theta$1-$\\Lambda$2 h] (rel.)} & \\text{|det3[v($\\theta$1-$\\Lambda$1h), v(-($\\Lambda$1+1)h), v(-($\\Lambda$1+2)h)]| (rel., should be $\\not=$ 0)} & \\text{formula vs eigenvalue, all $\\lambda$₁$\\le$$\\Lambda$₁ shapes and row pairs (max rel.)}\\\\\\hline\\left\\{5,2,1\\right\\} & \\text{0.}\\times 10^{\\text{-106}} & \\text{0.}\\times 10^{\\text{-110}} & \\text{6.96}\\times 10^{\\text{-124}} & \\text{4.89}\\times 10^{\\text{-11}} & \\text{0.}\\times 10^{\\text{-78}}\\\\\\hline\\left\\{5,2,1\\right\\} & \\text{0.}\\times 10^{\\text{-105}} & \\text{0.}\\times 10^{\\text{-111}} & \\text{8.42}\\times 10^{\\text{-127}} & \\text{7.88}\\times 10^{\\text{-15}} & \\text{0.}\\times 10^{\\text{-75}}\\\\\\hline\\left\\{5,2,1\\right\\} & \\text{0.}\\times 10^{\\text{-105}} & \\text{0.}\\times 10^{\\text{-108}} & \\text{5.27}\\times 10^{\\text{-124}} & \\text{9.59}\\times 10^{\\text{-11}} & \\text{0.}\\times 10^{\\text{-75}}\\\\\\hline\\left\\{5,2,1\\right\\} & \\text{0.}\\times 10^{\\text{-101}} & \\text{0.}\\times 10^{\\text{-105}} & \\text{1.08}\\times … [latex truncated: 7475 chars total]",
       "mime": "text/plain"
      }
