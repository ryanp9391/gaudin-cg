       "data": "Out[623]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{dim weight space} & \\text{HW multiplicity} & \\text{HW-limit states found} & \\text{largest ‖P\\_HW $\\Psi$‖/‖$\\Psi$‖ ($\\varepsilon$ = 10\\^{}-3)}\\\\\\hline\\left\\{6,2,0\\right\\} & 1 & 1 & 1 & \\left\\{1.\\,\\right\\}\\\\\\hline\\left\\{6,1,1\\right\\} & 2 & 1 & 1 & \\left\\{1.0000,0.0005129\\right\\}\\\\\\hline\\left\\{5,3,0\\right\\} & 2 & 1 & 1 & \\left\\{1.0000,0.0002918\\right\\}\\\\\\hline\\left\\{5,2,1\\right\\} & 6 & 2 & 2 & \\left\\{1.0000,1.0000,0.0003975\\right\\}\\\\\\hline\\left\\{4,4,0\\right\\} & 3 & 1 & 1 & \\left\\{1.0000,0.0007004\\right\\}\\\\\\hline\\left\\{4,3,1\\right\\} & 10 & 2 & 2 & \\left\\{1.0000,1.0000,0.0005402\\right\\}\\\\\\hline\\left\\{4,2,2\\right\\} & 14 & 1 & 1 & \\left\\{1.0000,0.0004890\\right\\}\\\\\\hline\\left\\{3,3,2\\right\\} & 18 & 1 & 1 & \\left\\{1.0000,0.0007428\\right\\}\\\\\\hline\\text{time (s)} & 0.089302 &  &  & \\\\\\hline\\end{array}",
