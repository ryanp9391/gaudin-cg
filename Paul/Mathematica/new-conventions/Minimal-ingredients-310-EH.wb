yle=\"height:11.8501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:11.8501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5001em;\"><span class=\"pstrut\" style=\"height:11.8501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9001em;\"><span class=\"pstrut\" style=\"height:11.8501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-13.3001em;\"><span class=\"pstrut\" style=\"height:11.8501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-15.7001em;\"><span class=\"pstrut\" style=\"height:11.8501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-18.1002em;\"><span class=\"pstrut\" style=\"height:11.8501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-20.5002em;\"><span class=\"pstrut\" style=\"height:11.8501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-21.7002em;\"><span class=\"pstrut\" style=\"height:11.8501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.3501em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
