       "data": "Out[1782]= \\begin{array}{|c|c|}\\hline\\text{statement} & \\text{value}\\\\\\hline\\text{Cz\\^{}dag = $\\Sigma$ z\\_k E1\\_ik E2\\_ki} & \\mathrm{True}\\\\\\hline\\text{[t1(u),t1(v)\\^{}dag] = -h\\^{}3 $\\theta$12 $\\Sigma$(z\\_i-z\\_k)\\^{}2 E1\\_ik E2\\_ki + h\\^{}4 [Cz,Cz\\^{}dag]} & \\mathrm{True}\\\\\\hline\\text{[Cz,Cz\\^{}dag] has cubic (3-generator) words} & \\mathrm{True}\\\\\\hline\\text{untwisted (all z equal): [t1,t1\\^{}dag] = 0} & \\mathrm{True}\\\\\\hline\\text{z1 = z2 != z3: [t1,t1\\^{}dag] = 0?} & \\mathrm{False}\\\\\\hline\\text{unitary twist zb = 1/z: [t1,t1\\^{}dag] = 0?} & \\mathrm{False}\\\\\\hline\\end{array}",
