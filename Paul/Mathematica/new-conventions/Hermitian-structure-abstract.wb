      {
       "data": "Out[1767]= \\begin{array}{|c|c|}\\hline\\Delta 1\\text{, L=}1 & 0\\\\\\hline\\Delta 2\\text{, L=}1 & 0\\\\\\hline\\Delta 1\\text{, L=}2 & \\begin{array}{|c|c|}\\hline\\text{word} & \\text{coefficient}\\\\\\hline\\mathrm{nc}\\left(\\mathrm{gen}\\left(1,1,2\\right),\\mathrm{gen}\\left(2,2,1\\right)\\right) & -\\mathrm{hb}^2\\,\\left(\\mathrm{zb}\\left(1\\right)-\\mathrm{zb}\\left(2\\right)\\right)\\\\\\hline\\mathrm{nc}\\left(\\mathrm{gen}\\left(1,1,3\\right),\\mathrm{gen}\\left(2,3,1\\right)\\right) & -\\mathrm{hb}^2\\,\\left(\\mathrm{zb}\\left(1\\right)-\\mathrm{zb}\\left(3\\right)\\right)\\\\\\hline\\mathrm{nc}\\left(\\mathrm{gen}\\left(1,2,1\\right),\\mathrm{gen}\\left(2,1,2\\right)\\right) & \\mathrm{hb}^2\\,\\left(\\mathrm{zb}\\left(1\\right)-\\mathrm{zb}\\left(2\\right)\\right)\\\\\\hline\\mathrm{nc}\\left(\\mathrm{gen}\\left(1,2,3\\right),\\mathrm{gen}\\left(2,3,2\\right)\\right) & -\\mathrm{hb}^2\\,\\left(\\mathrm{zb}\\left(2\\right)-\\mathrm{zb}\\left(3\\right)\\right)\\\\\\hline\\mathrm{nc}\\left(\\mathrm{gen}\\left(1,3,1\\right),\\mathrm{gen}\\left(2,1,3\\right)\\right) & \\mathrm{hb}^2\\,\\left(\\mathrm{zb}\\left(1\\right)-\\mathrm{zb}\\left(3\\right)\\right)\\\\\\hline\\mathrm{nc}\\left(\\mathrm{gen}\\left(1,3,2\\right),\\mathrm{gen}\\left(2,2,3\\right)\\right) & \\mathrm{hb}^2\\,\\left(\\mathrm{zb}\\left(2\\right)-\\mathrm{… [latex truncated: 16517 chars total]",
