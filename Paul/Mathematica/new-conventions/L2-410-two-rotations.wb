      {
       "data": "Out[151]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{w2} & \\text{y-star} & \\text{y1 (site 1)} & \\text{y2 (site 2)} & \\text{rotRank} & \\text{f1 = e1 R rho(Delta\\_w2)} & \\text{beta/alpha (E23)}\\\\\\hline\\frac{7}{3} & -\\frac{63}{43} & \\begin{pmatrix}-\\frac{63}{43} & 2 & \\frac{20}{13}\\end{pmatrix} & \\text{none} & \\left\\{4,5\\right\\} & \\mathrm{True} & -\\frac{343}{484}\\\\\\hline-\\frac{8}{9} & \\frac{24}{43} & \\begin{pmatrix}\\frac{24}{43} & \\frac{28}{43} & \\frac{8}{11}\\end{pmatrix} & \\text{none} & \\left\\{4,5\\right\\} & \\mathrm{True} & -\\frac{125}{22}\\\\\\hline\\frac{4}{27} & -\\frac{4}{43} & \\begin{pmatrix}-\\frac{4}{43} & \\frac{28}{73} & \\frac{8}{17}\\end{pmatrix} & \\text{none} & \\left\\{4,5\\right\\} & \\mathrm{True} & \\frac{125}{308}\\\\\\hline3 & -\\frac{81}{43} & \\begin{pmatrix}-\\frac{81}{43} & \\frac{14}{9} & \\frac{4}{3}\\end{pmatrix} & \\text{none} & \\left\\{4,5\\right\\} & \\mathrm{True} & -\\frac{1125}{2068}\\\\\\hline-\\frac{1}{2} & \\frac{27}{86} & \\begin{pmatrix}\\frac{27}{86} & \\frac{7}{12} & \\frac{2}{3}\\end{pmatrix} & \\text{none} & \\left\\{4,5\\right\\} & \\mathrm{True} & -\\frac{375}{286}\\\\\\hline\\frac{11}{7} & -\\frac{297}{301} & \\begin{pmatrix}-\\frac{297}{301} & \\frac{38}{3} & \\frac{76}{27}\\end{pmatrix} & \\text{none} & \\lef… [latex truncated: 1324 chars total]",
