       "data": "Out[1165]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{P} & \\text{in span? (res)} & \\text{support} & \\text{y-degrees} & \\text{y hitting c\\_P} & \\text{rank Phi at y=2,-5/3,7/5} & \\text{y with Phi rank<=1: nonzero roots \\{y, rank, local?, ||cP?\\}}\\\\\\hline\\left\\{0,1\\right\\} & 0 & \\{\\} & \\left\\{\\infty ,-\\infty \\right\\} & \\left\\{\\mathrm{ySym}\\right\\} & \\left\\{0,0,0\\right\\} & \\text{all y (localizing span)}\\\\\\hline\\left\\{0,2\\right\\} & 3.0186803101213056\\times 10^{-46} & \\left\\{\\text{T11},\\text{T31}\\right\\} & \\left\\{2,4\\right\\} & \\text{none} & \\left\\{1,1,1\\right\\} & \\text{all y (localizing span)}\\\\\\hline\\left\\{0,3\\right\\} & 4.038079458068968\\times 10^{-46} & \\left\\{\\text{1},\\text{T21},\\text{T30}\\right\\} & \\left\\{3,6\\right\\} & \\text{none} & \\left\\{2,2,2\\right\\} & \\{\\}\\\\\\hline\\left\\{1,2\\right\\} & 3.2160435046144456\\times 10^{-46} & \\left\\{\\text{T11},\\text{T21}\\right\\} & \\left\\{3,4\\right\\} & \\text{none} & \\left\\{1,1,1\\right\\} & \\text{all y (localizing span)}\\\\\\hline\\left\\{1,3\\right\\} & 4.047937950506561\\times 10^{-46} & \\left\\{\\text{1},\\text{T11},\\text{T20}\\right\\} & \\left\\{4,6\\right\\} & \\text{none} & \\left\\{2,2,2\\right\\} & \\{\\}\\\\\\hline\\left\\{2,3\\right\\} & 1.4606831233516448\\times 10^{-45} & \\left\\{\\text{… [latex truncated: 2495 chars total]",
