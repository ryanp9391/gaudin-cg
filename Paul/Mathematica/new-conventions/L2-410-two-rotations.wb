  {
   "kind": 2,
   "value": "(* HW count, fixed torus: M[i,nu] = <φ(w2_i) x e1|HW> over the six w2 (times the number of points in the variant), per-irrep column ranks, and the per-irrep verdict 'fully determined' = rank of φ at the weight nu - Λ equals its dimension (HW frame). 14 HW kets = 11 irreps (multiplicities 2 for [7,2,1], [6,3,1], [5,4,1]). *)\nu21irreps = Union[u21HWwt]; u21colsOf[ν_] := Flatten[Position[u21HWwt, ν, {1}, Heads -> False]];\nu21perIrrep[M_] := Table[{ν, Length[u21colsOf[ν]], MatrixRank[M[[All, u21colsOf[ν]]]], Union[Flatten[M[[All, u21colsOf[ν]]]]] =!= {0}}, {ν, u21irreps}];\nu21Mfix[v_] := Table[kron[u21PhiV[v][[i]], e1] . u21HW, {i, Length[u21PhiV[v]]}];\nu21hwFix = Association[Table[v -> {MatrixRank[u21Mfix[v]], u21perIrrep[u21Mfix[v]]}, {v, u21variants}]];\nu21rkOfHW[v_, μ_] := Cases[u21ranks[v], {μ, dm_, rk_, _} :> {dm, rk}][[1]];\nu21verdictHW = Association[Table[v -> Table[Module[{μH = ν - Λ, rh}, rh = u21rkOfHW[v, μH]; {ν, Count[u21HWwt, ν], μH, rh, rh[[1]] == rh[[2]]}], {ν, u21irreps}], {v, u21variants}]];\nchecks[\"u21 HW rank fixed torus (rows = 6 per point): k=2, 3, 4, {2,3}, {2,3,4}\"] = (u21hwFix[#][[1]] & /@ u21variants);\nchecks[\"u21 # irreps (of 11) fully determined per variant\"] = Table[v -> Count[u21verdictHW[v][[All, 5]], True], {v, u21variants}];\nchecks[\"u21 undetermined irreps per variant: {nu, site-1 wt, {dim, rank}}\"] = Table[v -> Cases[u21verdictHW[v], {ν_, _, μ_, r_, False} :> {ν, μ, r}], {v, u21variants}];\nGrid[Join[{{\"irrep ν\", \"mult\", \"site-1 wt ν-Λ\", \"k=2 {dim,rank}\", \"k=3\", \"k=4\", \"k={2,3}\", \"k={2,3,4}\"}}, Table[{u21verdictHW[{2}][[i, 1]], u21verdictHW[{2}][[i, 2]], u21verdictHW[{2}][[i, 3]], u21verdictHW[{2}][[i, 4]], u21verdictHW[{3}][[i, 4]], u21verdictHW[{4}][[i, 4]], u21verdictHW[{2, 3}][[i, 4]], u21verdictHW[{2, 3, 4}][[i, 4]]}, {i, Length[u21irreps]}], {{\"# determined (of 11 irreps)\", \"\", \"\", Sequence @@ (Count[u21verdictHW[#][[All, 5]], True] & /@ u21variants)}, {\"HW rank fixed torus (6 rows per point)\", \"\", \"\", Sequence @@ checks[\"u21 HW rank fixed torus (rows = 6 per point): k=2, 3, 4, {2,3}, {2,3,4}\"]}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
