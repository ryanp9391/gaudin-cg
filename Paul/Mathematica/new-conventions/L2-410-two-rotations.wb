      {
       "data": "{\n\t\"name\": \"WolframKernelMessage\",\n\t\"message\": \"Solve::fulldim: The solution set contains a full-dimensional component; use Reduce for complete solution information.\",\n\t\"stack\": \"\"\n}",
       "mime": "application/vnd.code.notebook.error"
