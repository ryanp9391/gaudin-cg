      {
       "data": "Out[1124]= \\begin{array}{|c|c|}\\hline\\text{t\\_a(u) interpolation time (s)} & 0.737742\\\\\\hline\\text{qdet symbolic exact} & \\mathrm{True}\\\\\\hline\\text{deg\\_u t\\_a} & \\left\\{2,4,6\\right\\}\\\\\\hline\\text{\\# states, eigensystem time (s), eigenvalue-polynomial time (s)} & \\left\\{225,0.088499,1.20987\\right\\}\\\\\\hline\\text{eigen-residual (60 digits)} & 4.40392912260080229\\times 10^{-60}\\\\\\hline\\text{min sector gap (simple spectrum)} & 0.0213\\\\\\hline\\text{state 1 ($\\mu$ = \\{6, 4, 0\\}): deg q\\_i, deg q\\^{}j; time (s)} & \\left\\{\\begin{pmatrix}0 & 2 & 6\\\\6 & 4 & 0\\end{pmatrix},0.01949\\right\\}\\\\\\hline\\text{all 225 states: Q time (s)} & 3.533226\\\\\\hline\\text{\\# states with all six Q's} & 225\\\\\\hline\\text{deg q\\^{}j = $\\mu$\\_j / deg q\\_i = 6 - $\\mu$\\_i} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{max Baxter residual} & 4.549122573192215\\times 10^{-43}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "594df06d-4ad1-405c-a217-8a3b7c1d09e8"
    }
