      {
       "data": "Out[1132]= \\begin{array}{|c|c|c|}\\hline\\text{triple (n1,n21,n22): points th - n h} & \\text{max |ratio/ratio[1] - 1| over 225 states} & \\text{min |Psi\\_Q|}\\\\\\hline\\left\\{4,3,1\\right\\} & 22.3 & 0.0000939\\\\\\hline\\left\\{4,2,1\\right\\} & 73.8 & 0.000112\\\\\\hline\\left\\{3,2,1\\right\\} & 86.5 & 9.89\\times 10^{-7}\\\\\\hline\\left\\{4,3,2\\right\\} & 1.24740432372543\\times 10^{-44} & 0.0000239\\\\\\hline\\left\\{4,2,0\\right\\} & 225 & 0.000269\\\\\\hline\\left\\{3,2,0\\right\\} & 129 & 2.37\\times 10^{-6}\\\\\\hline\\left\\{4,1,0\\right\\} & 3170 & 0.00105\\\\\\hline\\end{array}",
