      {
       "data": "Out[200]= \\begin{array}{|c|c|}\\hline\\text{HW rank, fixed torus, six w2: (a), (b), (c), (c0)} & \\left\\{6,6,6,6\\right\\}\\\\\\hline\\text{per irrep \\{irrep, mult, rank, nonzero\\}, (a) fixed torus} & \\begin{matrix}\\left\\{\\left\\{4,3,3\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,4,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,3,2\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,4,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,5,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,2,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,3,1\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,4,0\\right\\},1,1,\\mathrm{True}\\right\\}\\end{matrix}\\\\\\hline\\text{per irrep, (c0) fixed torus} & \\begin{matrix}\\left\\{\\left\\{4,3,3\\right\\},1,0,\\mathrm{False}\\right\\}\\\\\\left\\{\\left\\{4,4,2\\right\\},1,0,\\mathrm{False}\\right\\}\\\\\\left\\{\\left\\{5,3,2\\right\\},2,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,4,1\\right\\},2,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,5,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,2,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,3,1\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,4,0\\right\\},1,1,\\mathrm{True}\\right\\}\\end{matrix}\\\\\\hline\\text{verdict (a): \\{irrep, mult, w… [latex truncated: 2204 chars total]",
