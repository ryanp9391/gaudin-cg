      {
       "data": "Out[1077]= \\begin{array}{|c|c|}\\hline\\text{Paux diagonalizes G(z)} & \\mathrm{True}\\\\\\hline\\text{$\\Omega$$\\otimes$$\\Omega$ eigenvector of t\\_a(G') (exact)} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{rotRank \\{e1, $\\Omega$1, x01, $\\Omega$1$\\rho$(D), $\\Omega$(z,w')\\} (4 = rotation)} & \\left\\{4,4,4,4,4\\right\\}\\\\\\hline\\text{rotRank random (10 = generic; 9 here, the trace relation removes one)} & 9\\\\\\hline\\text{<x0|$\\Omega$> nonzero} & \\mathrm{True}\\\\\\hline\\end{array}",
