       "data": "Out[175]= \\begin{array}{|c|c|}\\hline\\text{ket e1 annihilated by (norms of E12.e1, E21.e1, E23.e1, E32.e1)} & \\left\\{0,1,0,1\\right\\}\\\\\\hline\\text{raising pairs used} & \\begin{pmatrix}1 & 2\\\\2 & 3\\end{pmatrix}\\\\\\hline\\text{\\# HW kets} & 10\\\\\\hline\\text{HW weights \\{wt, mult\\}} & \\begin{matrix}\\left\\{\\left\\{4,3,3\\right\\},1\\right\\}\\\\\\left\\{\\left\\{4,4,2\\right\\},1\\right\\}\\\\\\left\\{\\left\\{5,3,2\\right\\},2\\right\\}\\\\\\left\\{\\left\\{5,4,1\\right\\},2\\right\\}\\\\\\left\\{\\left\\{5,5,0\\right\\},1\\right\\}\\\\\\left\\{\\left\\{6,2,2\\right\\},1\\right\\}\\\\\\left\\{\\left\\{6,3,1\\right\\},1\\right\\}\\\\\\left\\{\\left\\{6,4,0\\right\\},1\\right\\}\\end{matrix}\\\\\\hline\\text{HW killed by total raising} & \\mathrm{True}\\\\\\hline\\text{site factors reproduced (f1 $\\|$ e1.$\\rho$(n'), f2 $\\|$ (e1+b e1.E23).$\\rho$(n))} & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True}\\end{pmatrix}\\\\\\hline\\text{($\\rho$(n')$\\otimes$$\\rho$(n')).HW == HW  (w2 = 7/3, -1/2)} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{<v1$\\otimes$v2|HW> == <e1$\\otimes$$\\varphi$|HW>} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{Tru… [latex truncated: 1271 chars total]",
