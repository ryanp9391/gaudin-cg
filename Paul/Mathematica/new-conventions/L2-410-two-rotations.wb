      {
       "data": "Out[1155]= \\begin{array}{|c|c|}\\hline\\text{item} & \\text{value}\\\\\\hline\\text{eigen-residual of T on states} & 5\\times 10^{-59}\\\\\\hline\\text{max |tau22|,|tau32|,|tau33|} & \\left\\{0,0,0\\right\\}\\\\\\hline\\text{basis: \\# sv, min/max} & \\left\\{7.\\,,0.0883\\right\\}\\\\\\hline\\text{minor W(a,b)} & \\text{max span residual}\\\\\\hline\\left\\{3,4\\right\\} & 1.4606831233516448\\times 10^{-45}\\\\\\hline\\left\\{2,3\\right\\} & 0.597\\\\\\hline\\left\\{2,4\\right\\} & 0.977\\\\\\hline\\left\\{3,5\\right\\} & 0.978\\\\\\hline\\text{best 4 among all pairs 0<=a<b<=5} & \\left\\{\\left\\{3.\\,,4.\\,\\right\\}\\to 1.4606831233516448\\times 10^{-45},\\left\\{1.\\,,3.\\,\\right\\}\\to 0.591,\\left\\{2.\\,,3.\\,\\right\\}\\to 0.597,\\left\\{0,3.\\,\\right\\}\\to 0.680\\right\\}\\\\\\hline\\text{time (s)} & 0.801193\\\\\\hline\\end{array}",
