pan style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:7.0877em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9126em;\"><span class=\"pstrut\" style=\"height:7.0877em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1251em;\"><span class=\"pstrut\" style=\"height:7.0877em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3377em;\"><span class=\"pstrut\" style=\"height:7.0877em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5502em;\"><span class=\"pstrut\" style=\"height:7.0877em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7628em;\"><span class=\"pstrut\" style=\"height:7.0877em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9753em;\"><span class=\"pstrut\" style=\"height:7.0877em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.1753em;\"><span class=\"pstrut\" style=\"height:7.0877em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.5877em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
