       "data": "Out[1127]= \\begin{array}{|c|c|}\\hline\\text{$\\Omega$$\\otimes$$\\Omega$ eigen-covector (exact)} & \\mathrm{True}\\\\\\hline\\text{vacuum q degrees} & \\left\\{0,2,6\\right\\}\\\\\\hline\\text{vacuum Baxter residual} & 9.026240293179764\\times 10^{-52}\\\\\\hline\\text{det6 time: one state, 225 states (s)} & \\left\\{0.002721,0.373873\\right\\}\\\\\\hline\\text{min |<x0|$\\psi$>|, |<$\\Omega$|$\\psi$>|, |det6|, |$\\Psi$\\_Q|} & \\left\\{3.97\\times 10^{-6},0.000125,0.149,0.0000939\\right\\}\\\\\\hline\\text{max |ratio6/ratio6[1] - 1| (225 states)} & 22.3\\\\\\hline\\text{ratio6[1]} & 0.0000402339354178+0.000107202937546\\,\\mathrm{i}\\\\\\hline\\end{array}",
