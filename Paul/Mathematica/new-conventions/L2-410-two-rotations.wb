       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607004\" data-output-id=\"97\" data-out-n=\"175\" data-sub-idx=\"24\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"11\" data-sub-start=\"24\" data-sub-end=\"24\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[175]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:25.2401em;vertical-align:-12.35em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:12.89em;\"><span style=\"top:-14.85em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:25.2001em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-12.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:12.85em;\"><span style=\"top:-19.06em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">ket e1 annihilated by (norms of E12.e1, E21.e1, E23.e1, E32.e1)</span></span></span></span><span style=\"top:-17.25em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">raising pairs used</span></span></span></span><span style=\"top:-15.46em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\"># HW kets</span></span></span></span><span style=\"top:-10.05em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">HW weights {wt, mult}</span></span></span></span><span style=\"top:-4.66em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">HW killed by total raising</span></span></span></span><span style=\"top:-0.45em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">site factors reproduced (f1 ∥ e1.</span><span class=\"mord mathnormal\">ρ</span><span class=\"mord\">(n’), f2 ∥ (e1+b e1.E23).</span><span class=\"mord mathnormal\">ρ</span><span class=\"mord\">(n))</span></span></span></span><span style=\"top:3.74em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">(</span><span class=\"mord mathnormal\">ρ</span><span class=\"mord\">(n’)</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⊗</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">ρ</span><span class=\"mord\">(n’)).HW == HW (w2 = 7/3, -1/2)</span></span></span></span><span style=\"top:4.94em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">&lt;v1</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⊗</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">v2|HW&gt; == &lt;e1</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⊗</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">φ</span><span class=\"mord\">|HW&gt;</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"v