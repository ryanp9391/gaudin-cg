       "data": "Out[215]= \\begin{array}{|c|c|}\\hline\\text{HW rank torus-completed (12 random (w2,D)): (a), (b), (c), (c0)} & \\left\\{10,10,10,6\\right\\}\\\\\\hline\\text{HW rank fixed torus D = 1, 12 random w2 (a)} & 7\\\\\\hline\\text{per irrep \\{irrep, mult, rank, nonzero\\}: (a) torus-completed} & \\begin{matrix}\\left\\{\\left\\{4,3,3\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,4,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,3,2\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,4,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,5,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,2,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,3,1\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,4,0\\right\\},1,1,\\mathrm{True}\\right\\}\\end{matrix}\\\\\\hline\\text{(c0) torus-completed} & \\begin{matrix}\\left\\{\\left\\{4,3,3\\right\\},1,0,\\mathrm{False}\\right\\}\\\\\\left\\{\\left\\{4,4,2\\right\\},1,0,\\mathrm{False}\\right\\}\\\\\\left\\{\\left\\{5,3,2\\right\\},2,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,4,1\\right\\},2,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,5,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,2,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,3,1\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,4,0\\right\\},1,1,… [latex truncated: 1287 chars total]",
