      {
       "data": "Out[1108]= \\begin{array}{|c|c|}\\hline\\text{joint site-2 span dim} & 2\\\\\\hline\\text{extras: \\{index, rotRank, rotRank($\\Omega$1+$\\kappa$$\\omega$) at 3 $\\kappa$, = $\\Omega$\\_(p,q)?\\}} & \\begin{pmatrix}2 & 5 & \\left\\{5,5,5\\right\\} & \\{\\}\\end{pmatrix}\\\\\\hline\\text{live shapes (c-indices; c0 = identity)} & \\left\\{0,1,2,3,4,6,7\\right\\}\\\\\\hline\\text{\\# quadrics, Solve time (s), \\# raw Solve components} & \\left\\{105,5.462643,55\\right\\}\\\\\\hline\\end{array}",
