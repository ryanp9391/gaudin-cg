   "value": "(* per-weight ranks of the undone covectors φ_k(w2_i) over the six w2, for each product point k = 2, 3, 4 and the unions {2,3}, {2,3,4}; 'identically vanishing' = zero at all six sample points. dim V_μ from the GT patterns. Position uses Heads -> False. *)\nu21wts = Table[Table[J0[k][p], {k, 3}], {p, ps[{Λ}]}]; u21wtList = Union[u21wts]; u21idx = Association[Table[μ -> Flatten[Position[u21wts, μ, {1}, Heads -> False]], {μ, u21wtList}]];\nu21PhiK = Association[Table[k -> Table[u21phi[k, w2c], {w2c, u21w2s}], {k, u21ks}]];\nu21variants = {{2}, {3}, {4}, {2, 3}, {2, 3, 4}};\nu21PhiV = Association[Table[v -> Join @@ (u21PhiK /@ v), {v, u21variants}]];\nu21rankTab[v_] := Table[With[{M = u21PhiV[v][[All, u21idx[μ]]]}, {μ, Length[u21idx[μ]], MatrixRank[M], Flatten[Position[Transpose[M], _?(Union[#] === {0} &), {1}, Heads -> False]] // Map[u21idx[μ][[#]] &]}], {μ, u21wtList}];\nu21ranks = Association[Table[v -> u21rankTab[v], {v, u21variants}]];\nchecks[\"u21 # distinct weights of [4,1,0]\"] = Length[u21wtList];\nchecks[\"u21 weight-space dims (multiset)\"] = Tally[Length /@ Values[u21idx]];\nchecks[\"u21 per-weight ranks: all = dim V_mu? per variant\"] = Table[v -> (And @@ (#[[2]] == #[[3]] & /@ u21ranks[v])), {v, u21variants}];\nu21vanWts[v_] := Select[u21ranks[v], #[[4]] =!= {} &][[All, {1, 4}]];\nu21deficit[v_] := Select[u21ranks[v], #[[2]] > #[[3]] &][[All, {1, 2, 3}]];\nchecks[\"u21 weights with rank < dim, per variant\"] = Table[v -> u21deficit[v], {v, u21variants}];\nGrid[Join[{{\"weight μ\", \"dim V_μ\", \"rank k=2\", \"rank k=3\", \"rank k=4\", \"rank k=2,3\", \"rank k=2,3,4\"}}, Table[{u21ranks[{2}][[i, 1]], u21ranks[{2}][[i, 2]], u21ranks[{2}][[i, 3]], u21ranks[{3}][[i, 3]], u21ranks[{4}][[i, 3]], u21ranks[{2, 3}][[i, 3]], u21ranks[{2, 3, 4}][[i, 3]]}, {i, Length[u21wtList]}], {{\"identically vanishing\", \"\", ToString[u21vanWts[{2}]], ToString[u21vanWts[{3}]], ToString[u21vanWts[{4}]], ToString[u21vanWts[{2, 3}]], ToString[u21vanWts[{2, 3, 4}]]}, {\"weights with rank < dim\", \"\", ToString[u21deficit[{2}]], ToString[u21deficit[{3}]], ToString[u21deficit[{4}]], ToString[u21deficit[{2, 3}]], ToString[u21deficit[{2, 3, 4}]]}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
