      {
       "data": "Out[292]= \\begin{array}{|c|c|}\\hline\\text{\\# components: localizing / nontrivial} & \\left\\{2,0\\right\\}\\\\\\hline\\text{\\# free parameters of the localizing / nontrivial components} & \\left\\{\\left\\{3,1\\right\\},\\{\\}\\right\\}\\\\\\hline\\text{c of localizing components on \\{1, T\\{2, 0\\}@$\\theta$2-1h, T\\{1, 0\\}@$\\theta$2+0h, T\\{2, 2\\}@$\\theta$2+0h, T\\{3, 2\\}@$\\theta$2+0h, T\\{1, 1\\}@$\\theta$2+1h\\}} & \\begin{matrix}\\left\\{1,0,0,1,0,1\\right\\}\\\\\\left\\{0,0,0,1,0,0\\right\\}\\end{matrix}\\\\\\hline\\text{c of nontrivial components} & \\begin{matrix}\\end{matrix}\\\\\\hline\\end{array}",
