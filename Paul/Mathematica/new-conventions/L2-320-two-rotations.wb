{7,7,7\\right\\}\\\\\\hline\\text{per irrep \\{nu, mult, HW determined, LW determined\\}} &amp; \\begin{matrix}\\left\\{\\left\\{4,3,3\\right\\},1,\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,4,2\\right\\},1,\\mathrm{False},\\mathrm{False}\\right\\}\\\\\\left\\{\\left\\{5,3,2\\right\\},2,\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,4,1\\right\\},2,\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,5,0\\right\\},1,\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,2,2\\right\\},1,\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,3,1\\right\\},1,\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,4,0\\right\\},1,\\mathrm{True},\\mathrm{True}\\right\\}\\end{matrix}\\\\\\hline\\text{3x3 identity (b&#39;&#39;-a&#39;&#39;c&#39;&#39;)/(a&#39;&#39;c&#39;&#39;) = (w2-y-star)/(y-star-z2), symbolic z} &amp; \\left\\{0,\\mathrm{True},0\\right\\}\\\\\\hline\\text{&quot;all Boolean checks in $\\grave{ }$checks$\\grave{ }$ True? (# checks)&quot;} &amp; \\left\\{\\mathrm{True},56\\right\\}\\\\\\hline\\end{array}</small></span></div></div></div>",
