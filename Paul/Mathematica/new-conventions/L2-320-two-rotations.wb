  {
   "kind": 2,
   "value": "(* enlarged spans: all shapes at a set of points. u17locus[opKeys, tmax] takes keys {shape, m}, builds Mt = Transpose[<Omega|T] for each, drops the operators with <Omega|T = 0 and (greedily) the ones whose matrix is a linear combination of the earlier ones (they add nothing to the span of states Phi(c); the c-vector below lives on the independent ones), builds the joint site-1 span and the quadrics and does the exact Solve (capped at tmax seconds). Returns an Association with sizes, timing, localizing / nontrivial components. *)\nu17locus[keys_, tmax_] := Module[{mats, keep = {}, names, beta, r, Ac, cs, aOfC, eqs, sol, t, all, locP, nonP, fOf, flat, full},\n  full = Join[{{\"1\", Transpose[Partition[Ω2, d1]]}}, Table[{\"T\" <> ToString[k[[1]]] <> \"@m=\" <> ToString[k[[2]]], Transpose[u17M @@ k]}, {k, keys}]];\n  flat = Flatten[Normal[#[[2]]]] & /@ full;\n  Do[If[Union[flat[[i]]] =!= {0} && (keep === {} || MatrixRank[flat[[Append[keep, i]]]] > Length[keep]), AppendTo[keep, i]], {i, Length[full]}];\n  mats = full[[keep, 2]]; names = full[[keep, 1]];\n  beta = Module[{b = {Ω1}}, Do[If[MatrixRank[Append[b, row]] > Length[b], AppendTo[b, row/row[[Ordering[Abs[row], -1][[1]]]]]], {row, Flatten[Rest[mats], 1]}]; b]; r = Length[beta];\n  Ac = Table[Transpose[Table[LinearSolve[Transpose[beta], M[[i]]], {i, d1}]], {M, mats}];\n  cs = Array[u17cc, Length[mats], 0]; aOfC = Sum[cs[[k]] Ac[[k]], {k, Length[mats]}];\n  eqs = DeleteCases[Union[Flatten[Minors[aOfC, 2]]], 0];\n  {t, sol} = AbsoluteTiming[TimeConstrained[Solve[eqs == 0, cs], tmax, $Failed]];\n  fOf[s_] := Module[{cc = cs /. s, free, M, rowi, colj}, free = Variables[cc]; cc = cc /. Thread[free -> 1]; M = Sum[cc[[k]] mats[[k]], {k, Length[mats]}];\n    If[Union[Flatten[M]] === {0}, {\"zero\"}, rowi = First[FirstPosition[Total[Abs[M], {2}], _?(# != 0 &)]]; colj = First[FirstPosition[Total[Abs[M], {1}], _?(# != 0 &)]]; {cc, M[[rowi, All]]/M[[rowi, colj]], M[[All, colj]]/M[[rowi, colj]], Length[free]}]];\n  If[sol === $Failed, Return[<|\"names\" -> names, \"r\" -> r, \"# ops\" -> Length[mats], \"# quadrics\" -> Length[eqs], \"time\" -> t, \"status\" -> \"timeout\"|>]];\n  all = DeleteCases[fOf /@ sol, {\"zero\"}]; locP = Select[all, MatrixRank[{#[[2]], Ω1}] == 1 &]; nonP = Select[all, MatrixRank[{#[[2]], Ω1}] > 1 &];\n  <|\"names\" -> names, \"r\" -> r, \"# ops\" -> Length[mats], \"# quadrics\" -> Length[eqs], \"time\" -> t, \"status\" -> \"ok\", \"# raw\" -> Length[sol], \"loc\" -> locP, \"non\" -> nonP|>];\nu17keysH = Table[{λ, 1}, {λ, shapes}];\n{u17tH, u17resH} = AbsoluteTiming[u17locus[u17keysH, 120]];\nchecks[\"u17 locus all shapes at theta2+h: {# ops, site-1 span dim, # quadrics, status, # nontrivial comps}\"] = {u17resH[\"# ops\"], u17resH[\"r\"], u17resH[\"# quadrics\"], u17resH[\"status\"], If[u17resH[\"status\"] === \"ok\", Length[u17resH[\"non\"]], None]};\nGrid[{{\"ops kept (independent, nonzero)\", u17resH[\"names\"]}, {\"site-1 span dim, # quadrics, Solve time\", {u17resH[\"r\"], u17resH[\"# quadrics\"], N[u17resH[\"time\"], 3]}}, {\"status, # raw / localizing / nontrivial\", {u17resH[\"status\"], If[u17resH[\"status\"] === \"ok\", {u17resH[\"# raw\"], Length[u17resH[\"loc\"]], Length[u17resH[\"non\"]]}, None]}}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607004\" data-output-id=\"109\" data-out-n=\"297\" data-sub-idx=\"5\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"25\" data-sub-start=\"19\" data-sub-end=\"19\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[297]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:3.64em;vertical-align:-1.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.09em;\"><span style=\"top:-4.05em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">ops kept (independent, nonzero)</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">site-1 span dim, # quadrics, Solve time</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">status, # raw / localizing / nontrivial</span></span></span></span>