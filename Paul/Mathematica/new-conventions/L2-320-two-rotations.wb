       "data": "Out[253]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{weight $\\mu$} & \\text{dim V\\_$\\mu$} & \\text{rank phi' (LW frame)} & \\text{identically vanishing indices} & \\text{rank phi (HW frame, a)}\\\\\\hline\\left\\{0,2,3\\right\\} & 1 & 1 & \\{\\} & 0\\\\\\hline\\left\\{0,3,2\\right\\} & 1 & 1 & \\{\\} & 0\\\\\\hline\\left\\{1,1,3\\right\\} & 1 & 1 & \\{\\} & 1\\\\\\hline\\left\\{1,2,2\\right\\} & 2 & 2 & \\{\\} & 1\\\\\\hline\\left\\{1,3,1\\right\\} & 1 & 1 & \\{\\} & 1\\\\\\hline\\left\\{2,0,3\\right\\} & 1 & 1 & \\{\\} & 1\\\\\\hline\\left\\{2,1,2\\right\\} & 2 & 2 & \\{\\} & 2\\\\\\hline\\left\\{2,2,1\\right\\} & 2 & 1 & \\left\\{7\\right\\} & 2\\\\\\hline\\left\\{2,3,0\\right\\} & 1 & 0 & \\left\\{4\\right\\} & 1\\\\\\hline\\left\\{3,0,2\\right\\} & 1 & 1 & \\{\\} & 1\\\\\\hline\\left\\{3,1,1\\right\\} & 1 & 1 & \\{\\} & 1\\\\\\hline\\left\\{3,2,0\\right\\} & 1 & 0 & \\left\\{1\\right\\} & 1\\\\\\hline\\text{total rank (15)} &  & 6 &  & 6\\\\\\hline\\text{LW count torus-completed; per irrep \\{irrep, mult, rank\\}} & 10 & \\begin{matrix}\\left\\{\\left\\{4,3,3\\right\\},1,1\\right\\}\\\\\\left\\{\\left\\{4,4,2\\right\\},1,1\\right\\}\\\\\\left\\{\\left\\{5,3,2\\right\\},2,2\\right\\}\\\\\\left\\{\\left\\{5,4,1\\right\\},2,2\\right\\}\\\\\\left\\{\\left\\{5,5,0\\right\\},1,1\\right\\}\\\\\\left\\{\\left\\{6,2,2\\right\\},1,1\\right\\}\\\\\\left\\{\\left\\{6,3,1\\right\\},1,1\\right\\}\\\\\\… [latex truncated: 1275 chars total]",
