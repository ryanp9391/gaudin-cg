       "data": "Out[301]= \\begin{array}{|c|c|}\\hline\\text{ops kept} & \\left\\{\\text{1},\\text{T\\{1, 0\\}@m=1},\\text{T\\{1, 1\\}@m=1},\\text{T\\{2, 0\\}@m=1},\\text{T\\{2, 1\\}@m=1},\\text{T\\{2, 2\\}@m=1},\\text{T\\{3, 0\\}@m=1},\\text{T\\{3, 1\\}@m=1},\\text{T\\{3, 2\\}@m=1},\\text{T\\{3, 3\\}@m=1}\\right\\}\\\\\\hline\\text{status, time (s)} & \\left\\{\\text{ok},3.685834\\right\\}\\\\\\hline\\text{\\# quadrics / raw / discarded / localizing / nontrivial} & \\left\\{36,1,0,1,0\\right\\}\\\\\\hline\\end{array}",
