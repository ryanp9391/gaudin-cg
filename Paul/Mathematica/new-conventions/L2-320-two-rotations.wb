  },
  {
   "kind": 2,
   "value": "(* lowest-weight frame (cross-check, as for [3,1,0]): e_low = lowest GT pattern (weight (0,2,3)); the rotated site 1 is also s e_low.ρ(m) with m lower unipotent (3x3 factorization w0^-1 n' = b+ . m, ρ(m) = exp(m21 E21) exp(m31 E31) exp(m32 E32)); LW kets of V x V = joint null space of the total lowering generators per sector; <f1 x f2|LW> = s <e_low x phi'|LW> with phi' = f2.ρ(m)^-1 (again at site 2). The site-2 weight that fixes the irrep nu (LW weight Reverse[nu]) is Reverse[nu] - (0,2,3). *)\nu16low = First[Flatten[Position[u15wts, {0, 2, 3}]]]; u16elow = UnitVector[d1, u16low];\nu16rhoM[m_] := MatrixExp[m[[1]] Normal[Ee[2, 1]]] . MatrixExp[m[[2]] Normal[Ee[3, 1]]] . MatrixExp[m[[3]] Normal[Ee[3, 2]]];\nu16w0 = Reverse[IdentityMatrix[3]];\nu16m3[w2c_] := Module[{M = Inverse[u16w0] . u15np[w2c], bb, mm, sol}, bb = {{b11, b12, b13}, {0, b22, b23}, {0, 0, b33}}; mm = {{1, 0, 0}, {m21, 1, 0}, {m31, m32, 1}}; sol = Solve[Flatten[bb . mm - M] == 0, {b11, b12, b13, b22, b23, b33, m21, m31, m32}]; {m21, m31, m32} /. sol[[1]]];\nu16mv = Association[Table[w2c -> u16m3[w2c], {w2c, u15w2s}]]; u16rho = Association[Table[w2c -> u16rhoM[u16mv[w2c]], {w2c, u15w2s}]];\nu16s = Association[Table[w2c -> u15v1[w2c][[1]]/(u16elow . u16rho[w2c])[[1]], {w2c, u15w2s}]];\nchecks[\"u16 e_low weight (0,2,3); covector killed by E_ij (i<j), ket killed by E_ij (i>j)\"] = {u15wts[[u16low]], Union[Flatten[Table[Norm[u16elow . Normal[Ee[i, j]]], {i, 3}, {j, i + 1, 3}]]], Union[Flatten[Table[Norm[Normal[Ee[i, j]] . u16elow], {i, 3}, {j, 1, i - 1}]]]};\nchecks[\"u16 site 1 == s e_low.rho(m) exactly, all w2\"] = Table[u15v1[w2c] == u16s[w2c] Normal[u16elow . u16rho[w2c]], {w2c, u15w2s}];\nu16lower = {{2, 1}, {3, 2}}; u16Elow = Normal[(E1 @@ # + E2 @@ #)] & /@ u16lower;\nu16LWlist = Flatten[Table[Module[{idx = secOf[μ], A, ns}, A = Join @@ (#[[All, idx]] & /@ u16Elow); ns = NullSpace[A]; Table[<|\"wt\" -> μ, \"vec\" -> ReplacePart[ConstantArray[0, d2], Thread[idx -> n]]|>, {n, ns}]], {μ, u15sectors}], 1];\nu16LW = Transpose[u16LWlist[[All, \"vec\"]]]; u16LWwt = u16LWlist[[All, \"wt\"]];\nchecks[\"u16 # LW kets (expect 10), weights = reverses of HW weights\"] = {Length[u16LWlist], Sort[u16LWwt] === Sort[Reverse /@ u15HWwt]};\nchecks[\"u16 (rho(m) x rho(m)).LW == LW (all w2)\"] = Table[With[{R = u16rho[w2c]}, KroneckerProduct[R, R] . u16LW == u16LW], {w2c, u15w2s}];\nu16phi[w2c_] := u15v2[w2c, u15bt[w2c]] . Inverse[u16rho[w2c]];\nchecks[\"u16 <v1 x v2|LW> == s <e_low x phi'|LW> (all w2, all LW)\"] = Table[kron[u15v1[w2c], u15v2[w2c, u15bt[w2c]]] . u16LW == u16s[w2c] kron[u16elow, u16phi[w2c]] . u16LW, {w2c, u15w2s}];\nu16Phi = Table[u16phi[w2c], {w2c, u15w2s}];\nu16rankTab = Table[With[{M = u16Phi[[All, u15idx[μ]]]}, {μ, Length[u15idx[μ]], MatrixRank[M], Flatten[Position[Transpose[M], _?(Union[#] === {0} &), {1}, Heads -> False]] // Map[u15idx[μ][[#]] &]}], {μ, u15wtList}];\nchecks[\"u16 LW-frame per-weight ranks {mu, dim, rank}\"] = u16rankTab[[All, 1 ;; 3]];\nu16rkOfLW[μ_] := Cases[u16rankTab, {μ, dm_, rk_, _} :> {dm, rk}][[1]];\nu16verdict = Table[Module[{μL = Reverse[ν] - {0, 2, 3}, rl}, rl = u16rkOfLW[μL]; {ν, Count[u15HWwt, ν], μL, rl, rl[[1]] == rl[[2]]}], {ν, u15irreps}];\nu16MT = Table[With[{c0 = u15rndW2[[i]], D = u15rndD[[i]]}, With[{rD = ρdiag[D]}, kron[Normal[u15rndB[c0][\"f1\"]] . rD, Normal[u15rndB[c0][\"f2\"]] . rD] . u16LW]], {i, 12}];\nu16colsOf[ν_] := Flatten[Position[u16LWwt, Reverse[ν], {1}, Heads -> False]];\nu16lwCount = {MatrixRank[u16MT], Table[{ν, Length[u16colsOf[ν]], MatrixRank[u16MT[[All, u16colsOf[ν]]]]}, {ν, u15irreps}]};\nchecks[\"u16 LW count torus-completed (12 random (w2,D); expect 10)\"] = u16lwCount[[1]];\nGrid[Join[{{\"weight μ\", \"dim V_μ\", \"rank phi' (LW frame)\", \"identically vanishing indices\", \"rank phi (HW frame, a)\"}}, Table[{u16rankTab[[k, 1]], u16rankTab[[k, 2]], u16rankTab[[k, 3]], u16rankTab[[k, 4]], u15ra[[k, 3]]}, {k, Length[u15wtList]}], {{\"total rank (15)\", \"\", MatrixRank[u16Phi], \"\", MatrixRank[u15Phi[\"a\"]]}, {\"LW count torus-completed; per irrep {irrep, mult, rank}\", u16lwCount[[1]], Column[u16lwCount[[2]]], \"\", \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
