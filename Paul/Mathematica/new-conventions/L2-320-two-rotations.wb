       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607004\" data-output-id=\"95\" data-out-n=\"139\" data-sub-idx=\"5\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"8\" data-sub-start=\"29\" data-sub-end=\"29\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[139]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.6826em;vertical-align:-4.5713em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.1113em;\"><span style=\"top:-7.0713em;\"><span class=\"pstrut\" style=\"height:7.0713em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:9.6426em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.5713em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.0713em;\"><span style=\"top:-7.2313em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">time (s)</span></span></span></span><span style=\"top:-6.0213em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">site-2 span dim, # Solve components, y-star</span></span></span></span><span style=\"top:-4.8213em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\"># nontrivial points</span></span></span></span><span style=\"top: