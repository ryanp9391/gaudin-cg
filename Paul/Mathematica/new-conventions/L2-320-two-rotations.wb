       "data": "Out[260]= \\begin{array}{|c|c|}\\hline\\text{localizing shapes at $\\theta$1-3h; shapes with <$\\Omega$|T = 0; joint site-2 span dim} & \\left\\{\\begin{pmatrix}1 & 1\\\\2 & 1\\\\3 & 1\\end{pmatrix},\\begin{pmatrix}2 & 2\\\\3 & 2\\\\3 & 3\\end{pmatrix},2\\right\\}\\\\\\hline\\text{product locus: raw Solve components / localizing (site 2 = $\\Omega$1) / isolated nontrivial points} & \\left\\{53,1\\right\\}\\\\\\hline\\text{nontrivial point: c on (1,T10,T11,T20,T21,T22,T30,T31,T32,T33), c(T20) = 1} & \\left\\{\\frac{81}{1075},\\frac{36}{215},\\frac{4}{39},1,\\frac{860}{1053},0,-\\frac{860}{729},-\\frac{92450}{85293},0,0\\right\\}\\\\\\hline\\text{site 1 = e1 R(w1,y-star) $\\rho$(Dy[w2]), rotRank 4, y = w2($\\theta$12-h)/($\\theta$12-3h) (k = 3), torus Dy[w2]} & \\left\\{\\begin{pmatrix}-\\frac{63}{43} & 2 & \\frac{20}{13}\\end{pmatrix},-\\frac{63}{43}\\right\\}\\\\\\hline\\text{site 2 = e1 (1 + b E23) R(w1,y-star), rotRank 5, no torus, b = $\\beta$/$\\alpha$ = (6125/5676) w2/((w2-z3)(y-star-z3)) (w1 = 5/2)} & \\left\\{\\left\\{\\mathrm{True},-\\frac{343}{484}\\right\\},-\\frac{18375\\,\\mathrm{xx}}{44\\,\\left(3\\,\\mathrm{xx}-2\\right)\\,\\left(81\\,\\mathrm{xx}+86\\right)}\\right\\}\\\\\\hline\\text{per-weight ranks over six w2: \\{$\\mu$, dim, (a) point, (b) $\\beta$=0, (c) resolvent … [latex truncated: 3632 chars total]",
