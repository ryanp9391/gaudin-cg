       "data": "Out[308]= \\begin{array}{|c|c|}\\hline\\text{setting} & \\text{\\# ops, \\# quadrics, time, \\# raw, \\# discarded, \\# localizing, \\# nontrivial}\\\\\\hline\\text{all shapes at theta2 (m=0)} & \\left\\{10,36,3.412566,1,0,1,0\\right\\}\\\\\\hline\\text{all shapes at theta2, theta2+h} & \\left\\{\\text{timeout},19,120.010161\\right\\}\\\\\\hline\\text{theta2+h, second seed} & \\left\\{10,36,3.71614,1,0,1,0\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
