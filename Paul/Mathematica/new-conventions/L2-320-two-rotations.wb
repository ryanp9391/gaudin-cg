  {
   "kind": 2,
   "value": "(* HW count, fixed torus: M[i,nu] = <e1 x phi(w2_i)|HW_nu> over the six w2 (rank saturates at the 6 rows), per-irrep column ranks, and the per-irrep verdict 'fully determined' = rank of phi at the weight nu - Lambda equals its dimension (HW frame). Also draw the 12 random (w2, D) pairs for the torus-completed count (pipeline runs follow in the next two cells, 6 each). *)\nu15irreps = Union[u15HWwt]; u15colsOf[ν_] := Flatten[Position[u15HWwt, ν, {1}, Heads -> False]];\nu15perIrrep[M_] := Table[{ν, Length[u15colsOf[ν]], MatrixRank[M[[All, u15colsOf[ν]]]], Union[Flatten[M[[All, u15colsOf[ν]]]]] =!= {0}}, {ν, u15irreps}];\nu15Mfix[t_] := Table[kron[e1, u15Phi[t][[i]]] . u15HW, {i, Length[u15w2s]}];\nu15hwFix = Association[Table[t -> {MatrixRank[u15Mfix[t]], u15perIrrep[u15Mfix[t]]}, {t, {\"a\", \"b\", \"c\", \"c0\"}}]];\nu15rkOfHW[μ_] := Cases[u15ra, {μ, dm_, rk_, _} :> {dm, rk}][[1]];\nu15verdictHW = Table[Module[{μH = ν - Λ, rh}, rh = u15rkOfHW[μH]; {ν, Count[u15HWwt, ν], μH, rh, rh[[1]] == rh[[2]]}], {ν, u15irreps}];\nSeedRandom[1515]; u15rndW2 = {}; While[Length[u15rndW2] < 12, With[{c0 = RandomInteger[{-9, 9}]/RandomInteger[{2, 9}]}, If[! MemberQ[Join[zN, {0, u15w1, u15w3, 31/35, thN, hN}, u15rndW2, u15w2s], c0] && FreeQ[zN, u15ystar[c0]] && u15ystar[c0] =!= c0, AppendTo[u15rndW2, c0]]]];\nu15rndD = Table[RandomSample[Select[Range[-9, 9], # != 0 &], 3]/RandomSample[Range[2, 9], 3], {12}];\nchecks[\"u15 HW rank fixed torus, six w2: (a), (b), (c), (c0)\"] = (u15hwFix[#][[1]] & /@ {\"a\", \"b\", \"c\", \"c0\"});\nchecks[\"u15 per-irrep verdict (HW frame): {irrep, mult, site-2 weight nu-Lambda, {dim, rank}, fully determined}\"] = u15verdictHW;\nGrid[{{\"HW rank, fixed torus, six w2: (a), (b), (c), (c0)\", checks[\"u15 HW rank fixed torus, six w2: (a), (b), (c), (c0)\"]}, {\"per irrep {irrep, mult, rank, nonzero}, (a) fixed torus\", Column[u15hwFix[\"a\"][[2]]]}, {\"per irrep, (c0) fixed torus\", Column[u15hwFix[\"c0\"][[2]]]}, {\"verdict (a): {irrep, mult, wt nu-Lambda, {dim, rank}, determined?}\", Column[u15verdictHW]}, {\"random w2\", u15rndW2}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
