      {
       "data": "Out[271]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{m (x = $\\theta$2 + m h)} & \\text{shape} & \\text{rank} & \\text{$\\Omega$1 outside site-1 span? (0 = inside)} & \\text{site-2 local} & \\text{<$\\Omega$|T = 0}\\\\\\hline-1 & \\left\\{1,0\\right\\} & 3 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline-1 & \\left\\{1,1\\right\\} & 3 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline-1 & \\left\\{2,0\\right\\} & 2 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline-1 & \\left\\{2,1\\right\\} & 6 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline-1 & \\left\\{2,2\\right\\} & 6 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline-1 & \\left\\{3,0\\right\\} & 6 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline-1 & \\left\\{3,1\\right\\} & 11 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline-1 & \\left\\{3,2\\right\\} & 12 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline-1 & \\left\\{3,3\\right\\} & 0 & 1 & \\mathrm{False} & \\mathrm{True}\\\\\\hline0 & \\left\\{1,0\\right\\} & 2 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline0 & \\left\\{1,1\\right\\} & 3 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline0 & \\left\\{2,0\\right\\} & 6 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline0 & \\left\\{2,1\\right\\} & 8 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline0 & \\left\\{2,2\\right\\} & 1 & 0 & \\mathrm{True} & \\mat… [latex truncated: 3797 chars total]",
