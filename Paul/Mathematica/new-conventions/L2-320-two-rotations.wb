       "data": "Out[1179]= \\begin{array}{|c|c|}\\hline\\text{Phi\\_P rank (1 = product)} & 1\\\\\\hline\\text{y-star} & -\\frac{63}{43}\\\\\\hline\\text{MAIN: max |ratio/ratio1 - 1| (225 states), triple (4,3,2)} & 1.2486892487452006\\times 10^{-44}\\\\\\hline\\text{other triples (4,3,1),(4,2,1),(3,2,1)} & \\left\\{22.3,73.8,86.5\\right\\}\\\\\\hline\\text{controls y = -63/8, 2} & \\left\\{77.4,1690\\right\\}\\\\\\hline\\text{curve parallel to cP at y-star} & \\mathrm{True}\\\\\\hline\\text{ratio constant} & 3.87919445880\\times 10^{-7}+1.03360766720\\times 10^{-6}\\,\\mathrm{i}\\\\\\hline\\end{array}",
