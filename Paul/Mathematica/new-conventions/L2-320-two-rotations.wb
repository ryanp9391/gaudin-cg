  {
   "kind": 2,
   "value": "(* enlarged spans, step 2: all shapes at theta2 (m = 0), at theta2 and theta2+h (m = 0, 1), and the theta2+h run repeated with an independent seed (completeness check of the compressions). *)\nu17summ[res_] := If[res[\"status\"] === \"ok\", {res[\"# ops\"], res[\"# quadrics\"], N[res[\"time\"], 3], res[\"# raw\"], res[\"# discarded (rank > 1 or zero)\"], Length[res[\"loc\"]], Length[res[\"non\"]]}, {res[\"status\"], res[\"# ops\"], N[res[\"time\"], 3]}];\nu17keys0 = Table[{λ, 0}, {λ, shapes}]; u17keys01 = Join[u17keys0, u17keysH];\nu17res0 = u17locusC[u17keys0, 120, 4, 21];\nu17res01 = u17locusC[u17keys01, 120, 4, 31];\nu17resH3 = u17locusC[u17keysH, 120, 4, 77];\nchecks[\"u17 compressed locus (# ops, # quadrics, time, # raw, # discarded, # localizing, # nontrivial): m=0 | m=0,1 | m=1 second seed\"] = {u17summ[u17res0], u17summ[u17res01], u17summ[u17resH3]};\nGrid[{{\"setting\", \"# ops, # quadrics, time, # raw, # discarded, # localizing, # nontrivial\"}, {\"all shapes at theta2 (m=0)\", u17summ[u17res0]}, {\"all shapes at theta2, theta2+h\", u17summ[u17res01]}, {\"theta2+h, second seed\", u17summ[u17resH3]}}, Frame -> All, Alignment -> Left]",
