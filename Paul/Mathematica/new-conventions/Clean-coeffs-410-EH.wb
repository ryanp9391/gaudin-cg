     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"485294\" data-output-id=\"72\" data-out-n=\"1019\" data-sub-idx=\"37\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"2\" data-sub-start=\"42\" data-sub-end=\"42\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1019]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:16.8401em;vertical-align:-8.1501em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.69em;\"><span style=\"top:-10.65em;\"><span class=\"pstrut\" style=\"height:10.65em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:16.8001em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-8.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.65em;\"><span style=\"top:-16.66em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">[t1, t2] residual</span></span></span></span><span style=\"top:-15.46em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">HW-limit states found / HW states</span></span></span></span><span style=\"top:-8.25em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">HW sectors (multiplicity)</span></span></span></span><span style=\"top:-1.0599em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">time (s)</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.1501em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:16.8001em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-8.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.65em;\"><span style=\"top:-16.66em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"mord\"><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">239</span></span></span></span></span></span></span></span></span></span></span><span style=\"top:-15.46em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">14</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">14</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span styl