       "data": "Out[1061]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{$\\mu$ (mult 1)} & \\text{status} & \\text{quantity} & \\text{closed form in t} & \\text{total degree} & \\text{validation error}\\\\\\hline\\left\\{8,1,1\\right\\} & \\text{clean} & \\text{s\\{1, 1\\}} & 0 & 0 & 0\\\\\\hline\\left\\{8,1,1\\right\\} & \\text{clean} & \\text{s\\{2, 2\\}} & 0 & 0 & 0\\\\\\hline\\left\\{8,1,1\\right\\} & \\text{clean} & \\text{s\\{3, 3\\}} & 0 & 0 & 0\\\\\\hline\\left\\{8,1,1\\right\\} & \\text{clean} & \\text{s\\{4, 3\\}} & 1 & 0 & 0.\\times 10^{-202}\\\\\\hline\\left\\{7,3,0\\right\\} & \\text{clean} & \\text{s\\{1, 1\\}} & -\\frac{1}{72} & 0 & 9.21\\times 10^{-27}\\\\\\hline\\left\\{7,3,0\\right\\} & \\text{clean} & \\text{s\\{2, 2\\}} & -\\frac{2}{9} & 0 & 7.18\\times 10^{-26}\\\\\\hline\\left\\{7,3,0\\right\\} & \\text{clean} & \\text{s\\{3, 3\\}} & -1 & 0 & 1.25\\times 10^{-25}\\\\\\hline\\left\\{7,3,0\\right\\} & \\text{clean} & \\text{s\\{4, 3\\}} & 1 & 0 & 0.\\times 10^{-202}\\\\\\hline\\left\\{6,4,0\\right\\} & \\text{contaminated} & \\text{k\\{1, 1\\}} & -\\frac{1}{72} & 0 & 2.15\\times 10^{-26}\\\\\\hline\\left\\{6,4,0\\right\\} & \\text{contaminated} & \\text{k\\{2, 2\\}} & -\\frac{2}{9} & 0 & 1.35\\times 10^{-25}\\\\\\hline\\left\\{6,4,0\\right\\} & \\text{contaminated} & \\text{k\\{3, 3\\}} & -1 & 0 & 1.25\\times 10^{-2… [latex truncated: 12308 chars total]",
