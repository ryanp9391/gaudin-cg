       "data": "Out[1088]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{contaminated state} & \\text{rank of k-hat(t)} & \\text{t-independent clean combinations (exact)} & \\text{log10 |v2$\\cdot$k-hat|} & \\text{log10 |v2$\\cdot$s-hat| (min over t)} & \\text{rank of signals above} & \\text{log10 dist(k-hat, span of signals above)}\\\\\\hline\\left\\{\\left\\{6,4,0\\right\\},1\\right\\} & 1 & \\begin{pmatrix}\\frac{6570732}{44227901} & 1 & -\\frac{3099403}{27637999} & \\frac{3099403}{27637999}\\\\1 & -\\frac{1797017}{12268617} & \\frac{337886}{36213857} & -\\frac{337886}{36213857}\\\\0 & 0 & 1 & 1\\end{pmatrix} & -24 & -25 & 1 & -25\\\\\\hline\\left\\{\\left\\{6,3,1\\right\\},1\\right\\} & 2 & \\begin{pmatrix}\\frac{5142903}{37289308} & 1 & -\\frac{8049765}{35914363} & 0\\\\1 & -\\frac{3217842}{23952845} & \\frac{663863}{41583440} & 0\\end{pmatrix} & -23 & -26 & 3 & -99\\\\\\hline\\left\\{\\left\\{6,3,1\\right\\},2\\right\\} & 2 & \\begin{pmatrix}\\frac{3434856}{26693543} & 1 & -\\frac{8608109}{38427444} & 0\\\\1 & -\\frac{3432203}{27339665} & \\frac{277704}{19823627} & 0\\end{pmatrix} & -22 & -25 & 3 & -99\\\\\\hline\\left\\{\\left\\{6,2,2\\right\\},1\\right\\} & 2 & \\begin{pmatrix}\\frac{4271190}{33500107} & 1 & -\\frac{4607175}{20568386} & 0\\\\1 & -\\frac{1581885}{12714496} & … [latex truncated: 2517 chars total]",
