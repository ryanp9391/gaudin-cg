yle=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1058.655823</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:2.4em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.95em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:72.5784em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div></div>\n<div style=\"margin-top:3px;padding:2px 8px;display:flex;align-items:center;gap:6px;border-left:2px solid rgba(128,128,128,0.3);\"\n     data-truncated-uuid=\"79\" data-session-epoch=\"485294\">\n  <span style=\"font-size:11px;color:var(--vscode-descriptionForeground,#888);flex:1;\">&#128230; Large output &#8212; 2,766 atoms (skeleton shown, full value in kernel)</span>\n  <button data-action=\"expand\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Show full output\">&#9654;</button>\n  <button data-action=\"expand-more\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Show +20 more lines\">&#43;&#8230;</button>\n  <button data-action=\"open-text\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Open as text file\">&#128196;</button>\n</div>",
