  {
   "kind": 2,
   "value": "(* Q machinery (used by the HW-limit branches and by Task 5) and the eigenstates. A state is an association st = <|\"qu\" -> {q1,q2,q3} (monic dual polynomials in X, degrees mu_j), \"z\" -> ket twist|>; Q^j(x) = z_j^(x/h) q^j(x). Vacuum direct Q_i^vac(x) = w_i^(-x/h) q_i^vac(x), degrees vacDeg, given as the function F[i, x]. det6 poles {s, n}, n = lambda3..lambda1 on each ladder; Psi_Q with the vacuum triple (lambda1+1, lambda1, lambda2). *)\npoles = Flatten[Table[{s, n}, {s, nL}, {n, Λ[[3]], Λ[[1]]}], 1];\nxP[{s_, n_}] := thN[[s]] - n hN;\nwgt[p_] := wgt[p] = 1/Product[xP[p] - xP[q], {q, DeleteCases[poles, p]}];\nins[1][x_] := 1; ins[2][x_] := Exp[2 Pi I x/hN];\nprsL1 = {{1, 3}, {1, 2}, {2, 3}};\nQUf[st_, j_, x_] := st[\"z\"][[j]]^(x/hN) (st[\"qu\"][[j]] /. X -> x);\nrowG[st_, F_, {i_, j_}, k_] := Sum[N[wgt[p] ins[k][xP[p]], pr] With[{x = xP[p]}, {-QUf[st, j, x] F[i, x], -x QUf[st, j, x] F[i, x], QUf[st, j, x] F[i, x + hN], x QUf[st, j, x] F[i, x + hN], QUf[st, j, x - hN] F[i, x], x QUf[st, j, x - hN] F[i, x]}], {p, poles}];\ndet6[st_, F_] := Det[Flatten[Table[rowG[st, F, ij, k], {k, 2}, {ij, prsL1}], 1]];\npsiQ[st_] := Product[With[{t = thN[[s]]}, (QUf[st, 2, t - Λ[[1]] hN] QUf[st, 3, t - (Λ[[1]] + 1) hN] - QUf[st, 3, t - Λ[[1]] hN] QUf[st, 2, t - (Λ[[1]] + 1) hN]) QUf[st, 3, t - Λ[[2]] hN]], {s, nL}];\nmakeFvac[ww_, qv_] := Function[{i, x}, ww[[i]]^(-x/hN) (qv[[i]] /. X -> x)];\n(* fixed-degree monic Baxter solver (overdetermined least squares, no Chop), verbatim from L2-diagonal-frame-overlap-EH.wb cell 95 *)\nauditVac[zz_, hh_, ths_] := Table[Sum[Times @@ Table[zz[[ii[[k]]]] auditNu[hh, ths, ii[[k]], u - (k - 1) hh], {k, a}], {ii, Subsets[Range[3], {a}]}], {a, 3}];\nauditQdet[zz_, hh_, ths_, x_] := (Times @@ zz) auditNu[hh, ths, 1, x] auditNu[hh, ths, 2, x - hh] auditNu[hh, ths, 3, x - 2 hh];\nauditOp[tt_, q_, zz_, sgn_, hh_, ths_, x_] := If[sgn == 1,\n  auditNu[hh, ths, 3, x] auditNu[hh, ths, 3, x - hh] auditNu[hh, ths, 3, x - 2 hh] zz (q /. X -> x + hh)\n  - (tt[[1]] /. u -> x) auditNu[hh, ths, 3, x - hh] auditNu[hh, ths, 3, x - 2 hh] (q /. X -> x)\n  + (tt[[2]] /. u -> x) auditNu[hh, ths, 3, x - 2 hh] (q /. X -> x - hh)/zz\n  - (tt[[3]] /. u -> x) (q /. X -> x - 2 hh)/zz^2,\n  auditNu[hh, ths, 1, x] auditNu[hh, ths, 1, x + hh] auditNu[hh, ths, 1, x + 2 hh] zz (q /. X -> x - hh)\n  - (tt[[1]] /. u -> x) auditNu[hh, ths, 1, x + hh] auditNu[hh, ths, 1, x + 2 hh] (q /. X -> x)\n  + (tt[[2]] /. u -> x + hh) auditNu[hh, ths, 1, x + 2 hh] (q /. X -> x + hh)/zz\n  - (tt[[3]] /. u -> x + 2 hh) (q /. X -> x + 2 hh)/zz^2];\nauditMonicQ[tt_, zz_, sgn_, deg_, hh_, ths_, prc_] := Module[{vars, eq, ar, sol},\n  If[deg == 0, Return[1]]; vars = Array[aq, deg]; eq = CoefficientList[Expand[auditOp[tt, X^deg + Sum[vars[[k + 1]] X^k, {k, 0, deg - 1}], zz, sgn, hh, ths, X]], X];\n  ar = CoefficientArrays[eq, vars]; sol = LeastSquares[N[Normal[ar[[2]]], prc], -N[Normal[ar[[1]]], prc]];\n  Expand[X^deg + Sum[sol[[k + 1]] X^k, {k, 0, deg - 1}]]];\n(* Baxter residual in exact arithmetic on the stored numbers (the naive norm of tracked approximate zeros prints an exact 0 with Precision Infinity, Clean-CG-combinations trap) *)\nbaxRes[tt_, qq_, zz_, sgn_] := Module[{t1 = SetPrecision[tt, Infinity], q1 = SetPrecision[qq, Infinity], z1 = SetPrecision[zz, Infinity]}, N[Max[Table[Norm[CoefficientList[Expand[auditOp[t1, q1[[j]], z1[[j]], sgn, hN, thN, X]], X]]/Max[1, Norm[CoefficientList[q1[[j]], X]]], {j, 3}]], 6]];\nvacDeg = {0, 2 (Λ[[1]] - Λ[[2]]), 2 (Λ[[1]] - Λ[[3]])};\nvacQs[ww_] := Module[{wn = N[ww, pr], tt, qv}, tt = auditVac[wn, hN, thN]; qv = Table[auditMonicQ[tt, wn[[j]], -1, vacDeg[[j]], hN, thN, pr], {j, 3}]; <|\"tt\" -> tt, \"q\" -> qv, \"F\" -> makeFvac[wn, qv], \"res\" -> baxRes[tt, qv, wn, -1], \"w\" -> wn|>];\n(* eigenstates of one total-weight sector mu at the ket twist zz (exact rational list in, numeric pr inside), normalized <x0|Psi> = 1; each state carries its transfer eigenvalue polynomials t1,t2 (read off at the largest component; coefficients above the true degrees 2a are dropped and the dropped size is reported), t3 = quantum determinant, its dual Q's (degrees mu_j), the exact-arithmetic Baxter residual, the raising residual rr = ||(E12+E12, E23+E23) Psi||/||Psi|| (rr ~ 0 marks the HW-limit states), and for the HW sectors ||P_HW Psi||/||Psi|| in the invariant G-norm. Memoized on (zz, mu): purge with literal symbols only. *)\nraiseSec[mu_] := raiseSec[mu] = With[{sec = secOf[mu]}, Normal[Join[(E1[1, 2] + E2[1, 2])[[All, sec]], (E1[2, 3] + E2[2, 3])[[All, sec]]]]];\nstatesCore[zz_, mu_] := statesCore[zz, mu] = Module[{zn = N[zz, pr], tc, x0, sec = secOf[mu], mix, es, rr, isHW = MemberQ[hwSecs, mu], out = {}},\n  tc = tZof[zn]; x0 = x0Of[zn];\n  mix = Normal[(tEval[tc, 1, 3/7] + N[Pi, pr] tEval[tc, 2, 3/7])[[sec, sec]]];\n  es = Eigensystem[mix];\n  rr = Table[Norm[raiseSec[mu] . v]/Norm[v], {v, es[[2]]}];\n  Do[Module[{psiS, psi, km, tt, qq, st, dropped},\n    psiS = es[[2, k]]/(x0[[sec]] . es[[2, k]]);\n    psi = Normal[SparseArray[Thread[sec -> psiS], {d2}]];\n    km = First@Ordering[Abs[psiS], -1];\n    tt = Table[Sum[u^(j - 1) ((tc[[a, j]][[sec, sec]] . psiS)[[km]]/psiS[[km]]), {j, 1 + 2 a}], {a, 2}];\n    dropped = Max[Table[Abs[(tc[[a, j]][[sec, sec]] . psiS)[[km]]/psiS[[km]]], {a, 2}, {j, 2 a + 2, 7}]];\n    tt = Append[tt, auditQdet[zn, hN, thN, u]];\n    qq = Table[auditMonicQ[tt, zn[[j]], 1, mu[[j]], hN, thN, pr], {j, 3}];\n    st = <|\"qu\" -> qq, \"z\" -> zn|>;\n    AppendTo[out, <|\"mu\" -> mu, \"k\" -> k, \"psi\" -> psi, \"ev\" -> es[[1, k]], \"rr\" -> rr[[k]], \"tt\" -> tt, \"qu\" -> qq, \"st\" -> st, \"bax\" -> baxRes[tt, qq, zn, 1], \"dropped\" -> dropped, \"x0ov\" -> (x0[[sec]] . es[[2, k]]), \"hwFrac\" -> If[isHW, gNorm[PHWc[mu][psi]]/gNorm[psi], Indeterminate]|>]], {k, Length[sec]}];\n  out];\n(* all states of the HW sectors at zz; the HW-limit branches = the dim(HW_mu) states of each sector with the smallest rr, copies ordered by Re of the eigenvalue of t1 + Pi t2 at u = 3/7 *)\nbranchesAt[zz_] := branchesAt[zz] = Module[{out = {}},\n  Do[Module[{ss = statesCore[zz, mu], nHW = Length[hwKets[mu]], pick},\n    pick = SortBy[Ordering[ss[[All, \"rr\"]], nHW], Re[ss[[#, \"ev\"]]] &];\n    Do[AppendTo[out, Append[ss[[k]], <|\"branch\" -> MemberQ[pick, k], \"copy\" -> If[MemberQ[pick, k], Position[pick, k][[1, 1]], 0]|>]], {k, Length[ss]}]], {mu, hwSecs}];\n  <|\"states\" -> out, \"zz\" -> zz|>];\nbrOf[B_, mu_, copy_] := First@Select[B[\"states\"], #[\"mu\"] === mu && #[\"copy\"] === copy &];\nbrList[B_] := brOf[B, #[[1]], #[[2]]] & /@ hwList;\n(* purge of every memoized point-dependent definition, LITERAL symbols only (DownValues is HoldAll: a Do over a symbol list purges nothing) *)\npurge[] := (DownValues[Tm] = Select[DownValues[Tm], ! FreeQ[#[[1]], Pattern] &]; DownValues[tBasisC] = Select[DownValues[tBasisC], ! FreeQ[#[[1]], Pattern] &]; DownValues[tBasisN] = Select[DownValues[tBasisN], ! FreeQ[#[[1]], Pattern] &]; DownValues[tZof] = Select[DownValues[tZof], ! FreeQ[#[[1]], Pattern] &]; DownValues[wgt] = Select[DownValues[wgt], ! FreeQ[#[[1]], Pattern] &]; DownValues[statesCore] = Select[DownValues[statesCore], ! FreeQ[#[[1]], Pattern] &]; DownValues[branchesAt] = Select[DownValues[branchesAt], ! FreeQ[#[[1]], Pattern] &]; DownValues[raiseSec] = Select[DownValues[raiseSec], ! FreeQ[#[[1]], Pattern] &];);\n(* one eps: all states of all HW sectors, the HW-limit branches *)\nzTest = reg2[10^-6, phiP, {3/4, -1/5}, {-12/5, 1/8}][\"z\"];\n{tBr, B0} = AbsoluteTiming[branchesAt[zTest]];\nchecks[\"branches: # states, # HW-limit branches (= # HW kets)\"] = {Length[B0[\"states\"]], Count[B0[\"states\"], s_ /; s[\"branch\"]]};\nchecks[\"branches: top branch = e1 (x) e1 (rel dev)\"] = With[{p = brOf[B0, hwSecs[[1]], 1][\"psi\"]}, N[Norm[p/p[[1]] - kron[e1, e1]], 5]];\nchecks[\"rr separation per sector (max branch rr / min other rr)\"] = Table[With[{s = Select[B0[\"states\"], #[\"mu\"] === mu &]}, {mu, N[Max[Select[s, #[\"branch\"] &][[All, \"rr\"]]], 3], If[Length[Select[s, ! #[\"branch\"] &]] == 0, \"-\", N[Min[Select[s, ! #[\"branch\"] &][[All, \"rr\"]]], 3]]}], {mu, hwSecs}];\nGrid[{{\"time (s), all HW-sector states at eps = 1e-6\", tBr}, {\"#states, #branches\", ToString[checks[\"branches: # states, # HW-limit branches (= # HW kets)\"], InputForm]}, {\"top = e1 (x) e1, rel dev\", checks[\"branches: top branch = e1 (x) e1 (rel dev)\"]}, {\"dropped high coeffs of t1,t2 (max abs)\", ScientificForm[sz[Max[B0[\"states\"][[All, \"dropped\"]]]], 3]}, {\"max exact Baxter residual (dual Q's)\", ScientificForm[Max[B0[\"states\"][[All, \"bax\"]]], 3]}, {\"hwFrac of the branches (min)\", ScientificForm[N[Min[Select[B0[\"states\"], #[\"branch\"] &][[All, \"hwFrac\"]]], 4]]}, {\"rr separation {mu, max branch, min other}\", ToString[checks[\"rr separation per sector (max branch rr / min other rr)\"], InputForm]}, {\"Precision of psi (min over states)\", Min[Precision /@ B0[\"states\"][[All, \"psi\"]]]}}, Frame -> All]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
