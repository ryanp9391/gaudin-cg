   "kind": 1,
   "value": "*Printed output of the code cell `c09_t2_weights` (evaluated in the shared kernel from exactly the saved source; not a native notebook output).*\n\n**[2,1,0] run** (rows of the printed `Grid`, InputForm; first entry = cell id, second = time in s):\n\n```\n{\"c09_t2_weights\", 0.2, {{\"weight\", \"dim\", \"min order\", \"max order\", \"rank eps^0\", \"rank eps^0+eps^1\"}, {{0, 1, 2}, 1, 0, 0, 1, 1}, {{0, 2, 1}, 1, 0, 0, 1, 1}, {{1, 0, 2}, 1, 0, 0, 1, 1}, \n  {{1, 1, 1}, 2, 0, 0, 2, 2}, {{1, 2, 0}, 1, 0, 0, 1, 1}, {{2, 0, 1}, 1, 0, 0, 1, 1}, {{2, 1, 0}, 1, 0, 0, 1, 1}, {\"main, phi' control: identical table?\", \"True\", \"\", \"\", \"\", \"\"}, \n  {\"main: every slice weight at order 0 with rank = dim?\", \"True\", \"\", \"\", \"\", \"\"}, {\"CONTROL w' fixed (6 points)\", \"\", \"\", \"\", \"\", \"\"}, {{0, 1, 2}, 1, 0, 0, 1, 1}, {{0, 2, 1}, 1, 0, 0, 1, 1}, \n  {{1, 0, 2}, 1, 0, 0, 1, 1}, {{1, 1, 1}, 2, 0, 0, 2, 2}, {{1, 2, 0}, 1, 0, 0, 1, 1}, {{2, 0, 1}, 1, 0, 0, 1, 1}, {{2, 1, 0}, 1, 0, 0, 1, 1}, \n  {\"control: every slice weight at order 0 with full rank?\", \"True\", \"\", \"\", \"\", \"\"}, {\"EXTRA w2 = w2' = Infinity (12 points)\", \"\", \"\", \"\", \"\", \"\"}, {{0, 1, 2}, 1, 0, 0, 1, 1}, \n  {{0, 2, 1}, 1, 0, 0, 1, 1}, {{1, 0, 2}, 1, 0, 0, 1, 1}, {{1, 1, 1}, 2, 0, 0, 2, 2}, {{1, 2, 0}, 1, 0, 0, 1, 1}, {{2, 0, 1}, 1, 0, 0, 1, 1}, {{2, 1, 0}, 1, 0, 0, 1, 1}, \n  {\"inf2: every slice weight at order 0 with full rank?\", \"True\", \"\", \"\", \"\", \"\"}, {\"EXTRA w2' = Infinity only (12 points)\", \"\", \"\", \"\", \"\", \"\"}, {{0, 1, 2}, 1, 0, 0, 1, 1}, \n  {{0, 2, 1}, 1, 0, 0, 1, 1}, {{1, 0, 2}, 1, 0, 0, 1, 1}, {{1, 1, 1}, 2, 0, 0, 2, 2}, {{1, 2, 0}, 1, 0, 0, 1, 1}, {{2, 0, 1}, 1, 0, 0, 1, 1}, {{2, 1, 0}, 1, 0, 0, 1, 1}, \n  {\"inf1: every slice weight at order 0 with full rank?\", \"True\", \"\", \"\", \"\", \"\"}, {\"EXTRA common w1' = w1 (12 points)\", \"\", \"\", \"\", \"\", \"\"}, {{0, 1, 2}, 1, Infinity, Infinity, 0, 0}, \n  {{0, 2, 1}, 1, Infinity, Infinity, 0, 0}, {{1, 0, 2}, 1, Infinity, Infinity, 0, 0}, {{1, 1, 1}, 2, Infinity, Infinity, 0, 0}, {{1, 2, 0}, 1, Infinity, Infinity, 0, 0}, {{2, 0, 1}, 1, 0, 0, 1, 1}, \n  {{2, 1, 0}, 1, 0, 0, 1, 1}, {\"common1: every slice weight at order 0 with full rank?\", \"False\", \"\", \"\", \"\", \"\"}, {\"time (s) main phi\", 0.0402293, \"\", \"\", \"\", \"\"}}}\n```\n\n**[3,1,0] run** (rows of the printed `Grid`, InputForm; first entry = cell id, second = time in s):\n\n```\n{\"c09_t2_weights\", 0.33, {{\"weight\", \"dim\", \"min order\", \"max order\", \"rank eps^0\", \"rank eps^0+eps^1\"}, {{0, 1, 3}, 1, 0, 0, 1, 1}, {{0, 2, 2}, 1, 0, 0, 1, 1}, {{0, 3, 1}, 1, 0, 0, 1, 1}, \n  {{1, 0, 3}, 1, 0, 0, 1, 1}, {{1, 1, 2}, 2, 0, 0, 2, 2}, {{1, 2, 1}, 2, 0, 0, 2, 2}, {{1, 3, 0}, 1, 0, 0, 1, 1}, {{2, 0, 2}, 1, 0, 0, 1, 1}, {{2, 1, 1}, 2, 0, 0, 2, 2}, {{2, 2, 0}, 1, 0, 0, 1, 1}, \n  {{3, 0, 1}, 1, 0, 0, 1, 1}, {{3, 1, 0}, 1, 0, 0, 1, 1}, {\"main, phi' control: identical table?\", \"True\", \"\", \"\", \"\", \"\"}, \n  {\"main: every slice weight at order 0 with rank = dim?\", \"True\", \"\", \"\", \"\", \"\"}, {\"CONTROL w' fixed (6 points)\", \"\", \"\", \"\", \"\", \"\"}, {{0, 1, 3}, 1, 0, 0, 1, 1}, {{0, 2, 2}, 1, 0, 0, 1, 1}, \n  {{0, 3, 1}, 1, 0, 0, 1, 1}, {{1, 0, 3}, 1, 0, 0, 1, 1}, {{1, 1, 2}, 2, 0, 0, 2, 2}, {{1, 2, 1}, 2, 0, 0, 2, 2}, {{1, 3, 0}, 1, 0, 0, 1, 1}, {{2, 0, 2}, 1, 0, 0, 1, 1}, {{2, 1, 1}, 2, 0, 0, 2, 2}, \n  {{2, 2, 0}, 1, 0, 0, 1, 1}, {{3, 0, 1}, 1, 0, 0, 1, 1}, {{3, 1, 0}, 1, 0, 0, 1, 1}, {\"control: every slice weight at order 0 with full rank?\", \"True\", \"\", \"\", \"\", \"\"}, \n  {\"EXTRA w2 = w2' = Infinity (12 points)\", \"\", \"\", \"\", \"\", \"\"}, {{0, 1, 3}, 1, 0, 0, 1, 1}, {{0, 2, 2}, 1, 0, 0, 1, 1}, {{0, 3, 1}, 1, 0, 0, 1, 1}, {{1, 0, 3}, 1, 0, 0, 1, 1}, \n  {{1, 1, 2}, 2, 0, 0, 2, 2}, {{1, 2, 1}, 2, 0, 0, 2, 2}, {{1, 3, 0}, 1, 0, 0, 1, 1}, {{2, 0, 2}, 1, 0, 0, 1, 1}, {{2, 1, 1}, 2, 0, 0, 2, 2}, {{2, 2, 0}, 1, 0, 0, 1, 1}, {{3, 0, 1}, 1, 0, 0, 1, 1}, \n  {{3, 1, 0}, 1, 0, 0, 1, 1}, {\"inf2: every slice weight at order 0 with full rank?\", \"True\", \"\", \"\", \"\", \"\"}, {\"EXTRA w2' = Infinity only (12 points)\", \"\", \"\", \"\", \"\", \"\"}, \n  {{0, 1, 3}, 1, 0, 0, 1, 1}, {{0, 2, 2}, 1, 0, 0, 1, 1}, {{0, 3, 1}, 1, 0, 0, 1, 1}, {{1, 0, 3}, 1, 0, 0, 1, 1}, {{1, 1, 2}, 2, 0, 0, 2, 2}, {{1, 2, 1}, 2, 0, 0, 2, 2}, {{1, 3, 0}, 1, 0, 0, 1, 1}, \n  {{2, 0, 2}, 1, 0, 0, 1, 1}, {{2, 1, 1}, 2, 0, 0, 2, 2}, {{2, 2, 0}, 1, 0, 0, 1, 1}, {{3, 0, 1}, 1, 0, 0, 1, 1}, {{3, 1, 0}, 1, 0, 0, 1, 1}, \n  {\"inf1: every slice weight at order 0 with full rank?\", \"True\", \"\", \"\", \"\", \"\"}, {\"EXTRA common w1' = w1 (12 points)\", \"\", \"\", \"\", \"\", \"\"}, {{0, 1, 3}, 1, Infinity, Infinity, 0, 0}, \n  {{0, 2, 2}, 1, Infinity, Infinity, 0, 0}, {{0, 3, 1}, 1, Infinity, Infinity, 0, 0}, {{1, 0, 3}, 1, Infinity, Infinity, 0, 0}, {{1, 1, 2}, 2, Infinity, Infinity, 0, 0}, \n  {{1, 2, 1}, 2, Infinity, Infinity, 0, 0}, {{1, 3, 0}, 1, Infinity, Infinity, 0, 0}, {{2, 0, 2}, 1, Infinity, Infinity, 0, 0}, {{2, 1, 1}, 2, Infinity, Infinity, 0, 0}, \n  {{2, 2, 0}, 1, Infinity, Infinity, 0, 0}, {{3, 0, 1}, 1, 0, 0, 1, 1}, {{3, 1, 0}, 1, 0, 0, 1, 1}, {\"common1: every slice weight at order 0 with full rank?\", \"False\", \"\", \"\", \"\", \"\"}, \n  {\"time (s) main phi\", 0.0529482, \"\", \"\", \"\", \"\"}}}\n```",
