\"-2., -2., -3., -3.\", \"1.1382628014221171389e96 + 3.0328903882901901221e96*I\"}, \n  {{5, 2, 1}, 1, \"3.518e18\", \"4.745e18\", \"5.228e26\", \"-8.329e26\", \"-3., -3., -4., -4.\", \"1.1382628014221171389e96 + 3.0328903882901901221e96*I\"}, \n  {{5, 2, 1}, 2, \"-2.289e19\", \"-3.087e19\", \"-2.415e26\", \"2.2e26\", \"-3., -3., -4., -4.\", \"1.1382628014221171389e96 + 3.0328903882901901221e96*I\"}, \n  {{4, 4, 0}, 1, \"4.223e11\", \"4.361e12\", \"-1.837e26\", \"-1.837e26\", \"-2., -2., -4., -4.\", \"1.1382628014221171389e96 + 3.0328903882901901221e96*I\"}, \n  {{4, 3, 1}, 1, \"3.21e18\", \"1.391e19\", \"-6.569e33\", \"-8.23e33\", \"-3., -3., -5., -5.\", \"1.1382628014221171389e96 + 3.0328903882901901221e96*I\"}, \n  {{4, 3, 1}, 2, \"-6.094e18\", \"-2.641e19\", \"-2.607e33\", \"-2.316e33\", \"-3., -3., -5., -5.\", \"1.1382628014221171389e96 + 3.0328903882901901221e96*I\"}, \n  {{4, 2, 2}, 1, \"-4.719e25\", \"-8.582e25\", \"-2.431e40\", \"-2.431e40\", \"-4., -4., -6., -6.\", \"1.1382628014221171389e96 + 3.0328903882901901221e96*I\"}, \n  {{3, 3, 2}, 1, \"-3.419e25\", \"-1.998e26\", \"1.089e47\", \"-1.089e47\", \"-4., -4., -7., -7.\", \"1.1382628014221171389e96 + 3.0328903882901901221e96*I\"}, \n  {\"w2 = w2' = Inf: {6, 2, 0} #1\", \"\", \"2.609e12\", \"2.609e12\", \"2.609e12\", \"2.609e12\", \"-2., -2., -2., -2.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {6, 1, 1} #1\", \"\", \"9.147e12\", \"1.933e12\", \"-2.527e19\", \"2.527e19\", \"-2., -2., -3., -3.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {5, 3, 0} #1\", \"\", \"1.05e12\", \"3.374e12\", \"6.569e19\", \"-6.569e19\", \"-2., -2., -3., -3.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {5, 2, 1} #1\", \"\", \"3.68e12\", \"2.499e12\", \"-8.264e26\", \"-1.022e27\", \"-2., -2., -4., -4.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {5, 2, 1} #2\", \"\", \"3.68e12\", \"2.499e12\", \"-9.737e25\", \"-3.092e25\", \"-2., -2., -4., -4.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {4, 4, 0} #1\", \"\", \"4.223e11\", \"4.361e12\", \"-1.837e26\", \"-1.837e26\", \"-2., -2., -4., -4.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {4, 3, 1} #1\", \"\", \"1.48e12\", \"3.23e12\", \"3.884e33\", \"-6.015e33\", \"-2., -2., -5., -5.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {4, 3, 1} #2\", \"\", \"1.48e12\", \"3.23e12\", \"-1.222e33\", \"5.132e32\", \"-2., -2., -5., -5.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {4, 2, 2} #1\", \"\", \"5.19e12\", \"2.393e12\", \"3.814e39\", \"3.814e39\", \"-2., -2., -6., -6.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {3, 3, 2} #1\", \"\", \"2.088e12\", \"3.093e12\", \"-1.708e46\", \"1.708e46\", \"-2., -2., -7., -7.\", \"(no det6 identity)\"}, \n  {\"vacuum Q degrees (w, w'), exact Baxter residuals\", \"{{{0, 4, 6}, {0, 4, 6}}, {7.3806339499451958750234e-190, 9.2260751994104091218582e-190}}\", \"\", \"\", \"\", \"\", \"\", \"\"}, \n  {\"dual Q degrees = mu_j (all states)\", \"True\", \"\", \"\", \"\", \"\", \"\", \"\"}, {\"<Om Om|Psi>/(det6/Psi_Q) state-independent over all HW-sector states: dev (w, w')\", \"{6.35e-77, 1.46e-85}\", \"\", \"\", \"\", \"\", \n   \"\", \"\"}, {\"# states checked, constants c_w, c_w'\", \"{56, 1.1382628014221171389e96 + 3.0328903882901901221e96*I, \\\n4.500339892422135601462041678107e88 + 1.1991112761229863890216905453434e89*I}\", \"\", \"\", \"\", \"\", \"\", \"\"}, \n  {\"time (s)\", \"{0.0032451, 0.141905, 1.75868}\", \"\", \"\", \"\", \"\", \"\", \"\"}}}\n```",
