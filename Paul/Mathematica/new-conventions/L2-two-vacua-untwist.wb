  {
   "kind": 2,
   "value": "(* Task 2. eps-structure of the undone covector phi_u(eps) = e1 rho(n'(eps)) on V in the regime z = 1+eps phi. A family = a list of direction points plus the map (eps, omega, omega') -> (w, w'); w2 or w2' = Infinity is allowed (rGauss limit). Per grid point the three Gauss parameters of n' are exact rational functions of eps; the 8 (resp. 15) components of phi_u are exact rational functions (Together); per weight of V: the leading eps-order over the grid and the ranks of the eps^0 coefficient vectors over the grid, and of the eps^0 together with the eps^1 coefficient vectors (second directions). Families: main (24 points), control w' fixed (no w' untwisting), and two extra sub-families (w2 = w2' = Infinity; w2' = Infinity only). *)\nfamMain = <|\"name\" -> \"main (w, w' untwisted)\", \"pts\" -> omGrid, \"wOf\" -> Function[{ee, om, omp}, {{1 + ee om[[1]], 1 + ee om[[2]]}, {1 + ee omp[[1]], 1 + ee omp[[2]]}}]|>;\nfamFixed = <|\"name\" -> \"control: w' = (7/4, -2/5) fixed\", \"pts\" -> Flatten[Table[{{o1, o2}, {0, 0}}, {o1, {3/4, -5/3}}, {o2, {-1/5, 9/7, 5/3}}], 1], \"wOf\" -> Function[{ee, om, omp}, {{1 + ee om[[1]], 1 + ee om[[2]]}, {7/4, -2/5}}]|>;\nfamInf2 = <|\"name\" -> \"extra: w2 = w2' = Infinity (w1, w1' untwisted)\", \"pts\" -> Flatten[Table[{{o1, 0}, {p1, 0}}, {o1, {3/4, -5/3, 7/2}}, {p1, {-12/5, 1/8, -3/4, 9/7}}], 1], \"wOf\" -> Function[{ee, om, omp}, {{1 + ee om[[1]], Infinity}, {1 + ee omp[[1]], Infinity}}]|>;\nfamInf1 = <|\"name\" -> \"extra: w2' = Infinity only\", \"pts\" -> Flatten[Table[{{o1, o2}, {p1, 0}}, {o1, {3/4, -5/3}}, {o2, {-1/5, 9/7, 5/3}}, {p1, {-12/5, 7/2}}], 2], \"wOf\" -> Function[{ee, om, omp}, {{1 + ee om[[1]], 1 + ee om[[2]]}, {1 + ee omp[[1]], Infinity}}]|>;\nfamCommon1 = <|\"name\" -> \"extra: common w1' = w1 (w2' untwisted)\", \"pts\" -> Flatten[Table[{{o1, o2}, {o1, p2}}, {o1, {3/4, -5/3}}, {o2, {-1/5, 9/7, 5/3}}, {p2, {1/8, -3/4}}], 2], \"wOf\" -> Function[{ee, om, omp}, {{1 + ee om[[1]], 1 + ee om[[2]]}, {1 + ee omp[[1]], 1 + ee omp[[2]]}}]|>;\nfams = <|\"main\" -> famMain, \"fixed\" -> famFixed, \"inf2\" -> famInf2, \"inf1\" -> famInf1, \"common1\" -> famCommon1|>;\n(* exact eps-series data of phi_u at one direction point *)\nphiSeries[fam_, ph_, pt_] := Module[{zS = 1 + ep ph, ws = fam[\"wOf\"][ep, pt[[1]], pt[[2]]], np, par, comps},\n  np = Map[Together, nPrime[zS, ws[[1]], ws[[2]]], {2}];\n  par = {np[[1, 2]], np[[1, 3]] - np[[1, 2]] np[[2, 3]], np[[2, 3]]};\n  comps = Together /@ coverG[par];\n  <|\"ord\" -> (ordEps /@ comps), \"c0\" -> (SeriesCoefficient[#, {ep, 0, 0}] & /@ comps), \"c1\" -> (SeriesCoefficient[#, {ep, 0, 1}] & /@ comps), \"par\" -> par|>];\nweightTab[fam_, ph_] := Module[{ser = phiSeries[fam, ph, #] & /@ fam[\"pts\"]},\n  {Table[With[{ix = u12idx[[m]]}, {u12wts[[m]], u12dims[[m]], Min[Table[Min[s[\"ord\"][[ix]]], {s, ser}]], Max[Table[Min[s[\"ord\"][[ix]]], {s, ser}]], MatrixRank[Table[s[\"c0\"][[ix]], {s, ser}]], MatrixRank[Join[Table[s[\"c0\"][[ix]], {s, ser}], Table[s[\"c1\"][[ix]], {s, ser}]]]}], {m, Length[u12wts]}], ser}];\n{tims[\"Task 2 main phi\"], {tabMain, serMain}} = AbsoluteTiming[weightTab[famMain, phiP]];\n{tabMainC, serMainC} = weightTab[famMain, phiC];\n{tabFixed, serFixed} = weightTab[famFixed, phiP];\n{tabInf2, serInf2} = weightTab[famInf2, phiP];\n{tabInf1, serInf1} = weightTab[famInf1, phiP];\n{tabCom1, serCom1} = weightTab[famCommon1, phiP];\nchecks[\"T2 main: minimal order over the grid >= 0 and identical tables for phi and phi'\"] = {Min[tabMain[[All, 3]]], tabMain === tabMainC};\nslicesNeeded = sliceNu;\nsliceOK[tab_] := And @@ Table[With[{r = First[Select[tab, #[[1]] === nu &]]}, r[[3]] == 0 && r[[5]] == r[[2]]], {nu, slicesNeeded}];\nGrid[Join[{{\"weight\", \"dim\", \"min order\", \"max order\", \"rank eps^0\", \"rank eps^0+eps^1\"}}, tabMain, {{\"main, phi' control: identical table?\", ToString[tabMain === tabMainC], \"\", \"\", \"\", \"\"}, {\"main: every slice weight at order 0 with rank = dim?\", ToString[sliceOK[tabMain]], \"\", \"\", \"\", \"\"}, {\"CONTROL w' fixed (6 points)\", \"\", \"\", \"\", \"\", \"\"}}, tabFixed, {{\"control: every slice weight at order 0 with full rank?\", ToString[sliceOK[tabFixed]], \"\", \"\", \"\", \"\"}, {\"EXTRA w2 = w2' = Infinity (12 points)\", \"\", \"\", \"\", \"\", \"\"}}, tabInf2, {{\"inf2: every slice weight at order 0 with full rank?\", ToString[sliceOK[tabInf2]], \"\", \"\", \"\", \"\"}, {\"EXTRA w2' = Infinity only (12 points)\", \"\", \"\", \"\", \"\", \"\"}}, tabInf1, {{\"inf1: every slice weight at order 0 with full rank?\", ToString[sliceOK[tabInf1]], \"\", \"\", \"\", \"\"}, {\"EXTRA common w1' = w1 (12 points)\", \"\", \"\", \"\", \"\", \"\"}}, tabCom1, {{\"common1: every slice weight at order 0 with full rank?\", ToString[sliceOK[tabCom1]], \"\", \"\", \"\", \"\"}, {\"time (s) main phi\", tims[\"Task 2 main phi\"], \"\", \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
