   "value": "*Printed output of the code cell `c12_t5_qdata` (evaluated in the shared kernel from exactly the saved source; not a native notebook output).*\n\n**[2,1,0] run** (rows of the printed `Grid`, InputForm; first entry = cell id, second = time in s):\n\n```\n{\"c12_t5_qdata\", 0.76, {{\"mu\", \"copy\", \"<w w|Psi> (mantissa e exp)\", \"<w' w'|Psi>\", \"<w w'|Psi>\", \"<w' w|Psi>\", \"eps-exponents (ww, pp, wp, pw)\", \"<w w|Psi>/(det6_w/Psi_Q) = c_w (constant)\"}, \n  {{4, 2, 0}, 1, \"2.609e12\", \"2.609e12\", \"2.609e12\", \"2.609e12\", \"-2., -2., -2., -2.\", \n   \"9.803047306524094625793506880437e69 + 2.6120126138502536255419540875827e70*I\"}, \n  {{4, 1, 1}, 1, \"-1.198e12\", \"-2.409e12\", \"-4.241e18\", \"4.241e18\", \"-2., -2., -3., -3.\", \n   \"9.803047306524094625793506880437e69 + 2.6120126138502536255419540875827e70*I\"}, \n  {{3, 3, 0}, 1, \"1.05e12\", \"3.374e12\", \"-9.732e18\", \"9.732e18\", \"-2., -2., -3., -3.\", \n   \"9.803047306524094625793506880437e69 + 2.6120126138502536255419540875827e70*I\"}, \n  {{3, 2, 1}, 1, \"4.367e18\", \"5.889e18\", \"-1.515e26\", \"2.066e26\", \"-3., -3., -4., -4.\", \n   \"9.803047306524094625793506880437e69 + 2.6120126138502536255419540875827e70*I\"}, \n  {{3, 2, 1}, 2, \"-1.153e19\", \"-1.555e19\", \"-1.585e26\", \"1.411e26\", \"-3., -3., -4., -4.\", \n   \"9.803047306524094625793506880437e69 + 2.6120126138502536255419540875827e70*I\"}, \n  {{2, 2, 2}, 1, \"-4.533e25\", \"-8.244e25\", \"5.02e39\", \"5.02e39\", \"-4., -4., -6., -6.\", \n   \"9.803047306524094625793506880437e69 + 2.6120126138502536255419540875827e70*I\"}, \n  {\"w2 = w2' = Inf: {4, 2, 0} #1\", \"\", \"2.609e12\", \"2.609e12\", \"2.609e12\", \"2.609e12\", \"-2., -2., -2., -2.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {4, 1, 1} #1\", \"\", \"9.147e12\", \"1.933e12\", \"-2.527e19\", \"2.527e19\", \"-2., -2., -3., -3.\", \"(no det6 identity)\"}, \n  {\"w2 = w2' = Inf: {3, 3, 0} #1\", \"\", \"1.05e12\", \"3.374e12\", \"-9.732e18\", \"9.73