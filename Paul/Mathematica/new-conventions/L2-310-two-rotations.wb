       "data": "Out[537]= \\begin{array}{|c|c|}\\hline\\text{joint site-2 span dim} & 2\\\\\\hline\\text{extras: \\{index, rotRank, rotRank($\\Omega$1+$\\kappa$$\\omega$) at 3 $\\kappa$, = $\\Omega$\\_(p,q)?\\}} & \\mathrm{TerminatedEvaluation}\\left[\\text{RecursionLimit}\\right]\\\\\\hline\\text{\\# quadrics, Solve time (s), \\# components} & \\left\\{105,0.384558,3\\right\\}\\\\\\hline\\text{components: \\{free params, rank1, rotRank site1, rotRank site2, rank\\{site1,$\\Omega$1\\}, rank\\{site2,$\\Omega$1\\}, c\\}} & \\\\\\hline\\left\\{5,\\mathrm{True},8,4,2,1,\\left\\{4,0,8,0,0,7,0,0,2,4\\right\\}\\right\\} & \\\\\\hline\\left\\{2,\\mathrm{True},6,4,2,2,\\left\\{0,0,-\\frac{6561}{1600},0,-\\frac{729}{80},-\\frac{81}{43},0,3,\\frac{320}{387},5\\right\\}\\right\\} & \\\\\\hline\\left\\{2,\\mathrm{True},5,4,2,2,\\left\\{\\frac{486}{1075},\\frac{216}{215},\\frac{8}{13},6,\\frac{1720}{351},\\frac{8600}{3159},-\\frac{1720}{243},-\\frac{184900}{28431},-\\frac{3698000}{767637},3\\right\\}\\right\\} & \\\\\\hline\\end{array}",
