      {
       "data": "Out[1127]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{weight $\\mu$} & \\text{dim V\\_$\\mu$} & \\text{rank A} & \\text{rank B} & \\text{rank A+B} & \\text{vanishing idx A}\\\\\\hline\\left\\{0,1,3\\right\\} & 1 & 1 & 0 & 1 & \\{\\}\\\\\\hline\\left\\{0,2,2\\right\\} & 1 & 1 & 1 & 1 & \\{\\}\\\\\\hline\\left\\{0,3,1\\right\\} & 1 & 1 & 1 & 1 & \\{\\}\\\\\\hline\\left\\{1,0,3\\right\\} & 1 & 1 & 0 & 1 & \\{\\}\\\\\\hline\\left\\{1,1,2\\right\\} & 2 & 2 & 1 & 2 & \\{\\}\\\\\\hline\\left\\{1,2,1\\right\\} & 2 & 2 & 2 & 2 & \\{\\}\\\\\\hline\\left\\{1,3,0\\right\\} & 1 & 1 & 1 & 1 & \\{\\}\\\\\\hline\\left\\{2,0,2\\right\\} & 1 & 1 & 1 & 1 & \\{\\}\\\\\\hline\\left\\{2,1,1\\right\\} & 2 & 2 & 2 & 2 & \\{\\}\\\\\\hline\\left\\{2,2,0\\right\\} & 1 & 1 & 1 & 1 & \\{\\}\\\\\\hline\\left\\{3,0,1\\right\\} & 1 & 1 & 1 & 1 & \\{\\}\\\\\\hline\\left\\{3,1,0\\right\\} & 1 & 1 & 1 & 1 & \\{\\}\\\\\\hline\\text{total rank (15)} &  & 6 & 6 & 12 & \\\\\\hline\\end{array}",
