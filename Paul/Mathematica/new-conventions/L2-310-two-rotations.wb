       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607004\" data-output-id=\"162\" data-out-n=\"989\" data-sub-idx=\"12\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"61\" data-sub-start=\"12\" data-sub-end=\"12\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[989]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:6.05em;vertical-align:-2.755em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.295em;\"><span style=\"top:-5.255em;\"><span class=\"pstrut\" style=\"height:5.255em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6.01em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.755em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.255em;\"><span style=\"top:-5.415em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">time (s)</span></span></span></span><span style=\"top:-4.215em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">usable points, rank of log design</span></span></span></span><span style=\"top:-3.005em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">fit exponents of {h, t, t-h, t-2h, t-3h, t-4h, z1-z2, z1-z3, z2-z3, z1, z2, z3, w1-z1, w1-z2, w1-z3}</span></span></span></span><span style=\"top:-1.805em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max log residual</span></span></span></span><span style=\"top:-0.605em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">K12 formula holds at all random points</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.755em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6.01em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.755em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.255em;\"><span style=\"top:-5.415em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">27.795671</span></span></span><span style=\"top:-4.215em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">28</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">16</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-3.005em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">{</span></span><span class=\"mord\">−</span><span class=\"mord\">1.386</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord