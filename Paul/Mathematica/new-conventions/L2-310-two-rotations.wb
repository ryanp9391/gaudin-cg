      {
       "data": "Out[674]= \\begin{array}{|c|c|}\\hline\\text{f\\_y in span at fresh y = 2, -5/3} & \\left\\{0.\\times 10^{-46},0.\\times 10^{-47}\\right\\}\\\\\\hline\\text{grading ratio test} & 0.\\times 10^{-47}\\\\\\hline\\text{a\\_$\\lambda$ from fresh y vs rationalized} & 0.\\times 10^{-47}\\\\\\hline\\text{end-to-end control y = 2 (should fail)} & 322\\\\\\hline\\end{array}",
