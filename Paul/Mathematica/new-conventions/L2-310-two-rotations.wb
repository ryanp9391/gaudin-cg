      {
       "data": "Out[755]= \\begin{array}{|c|c|c|}\\hline\\text{subset containing g (all w2)} &  & \\\\\\hline\\left\\{\\text{e1},\\text{e1E12},\\text{e1E13},\\text{e1E12E23}\\right\\} & \\mathrm{True} & \\\\\\hline\\left\\{\\text{e1},\\text{e1E12},\\text{e1E13},\\text{e1E23E12}\\right\\} & \\mathrm{True} & \\\\\\hline\\left\\{\\text{e1},\\text{e1E12},\\text{e1E12E23},\\text{e1E23E12}\\right\\} & \\mathrm{True} & \\\\\\hline\\text{w2} & \\text{y\\_A} & \\text{(1, beta12, gamma13, delta12.23)}\\\\\\hline\\frac{7}{3} & -\\frac{63}{8} & \\left\\{1,\\frac{28}{125},\\frac{9261}{45100},\\frac{9261}{90200}\\right\\}\\\\\\hline-\\frac{8}{9} & 3 & \\left\\{1,\\frac{32}{1075},\\frac{18}{473},\\frac{9}{473}\\right\\}\\\\\\hline\\frac{4}{27} & -\\frac{1}{2} & \\left\\{1,-\\frac{16}{1825},-\\frac{3}{803},-\\frac{3}{1606}\\right\\}\\\\\\hline3 & -\\frac{81}{8} & \\left\\{1,\\frac{4}{25},\\frac{243}{1628},\\frac{243}{3256}\\right\\}\\\\\\hline-\\frac{1}{2} & \\frac{27}{16} & \\left\\{1,\\frac{1}{50},\\frac{81}{2464},\\frac{81}{4928}\\right\\}\\\\\\hline\\frac{11}{7} & -\\frac{297}{56} & \\left\\{1,\\frac{44}{25},\\frac{6237}{4012},\\frac{6237}{8024}\\right\\}\\\\\\hline\\end{array}",
