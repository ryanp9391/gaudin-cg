       "data": "Out[655]= \\begin{array}{|c|c|}\\hline\\text{fit vs rationalized} & 1.58\\times 10^{-53}\\\\\\hline\\text{c\\_$\\lambda$(y) = a\\_$\\lambda$ y\\^{}(6-|$\\lambda$|)} & \\mathrm{True}\\\\\\hline\\text{c(y) (1, T10, T11, T20, T21, T22, T30, T31, T32)} & \\left\\{\\frac{16\\,\\mathrm{ySym}^6}{9},-\\frac{2240\\,\\mathrm{ySym}^5}{387},\\frac{78400\\,\\mathrm{ySym}^4}{15093},\\frac{19600\\,\\mathrm{ySym}^4}{387},-\\frac{2744000\\,\\mathrm{ySym}^3}{45279},\\frac{96040000\\,\\mathrm{ySym}^2}{1946997},\\frac{2744000\\,\\mathrm{ySym}^3}{31347},-\\frac{48020000\\,\\mathrm{ySym}^2}{407511},\\frac{6722800000\\,\\mathrm{ySym}}{52568919}\\right\\}\\\\\\hline\\text{a\\_$\\lambda$ factored} & \\left\\{\\begin{pmatrix}2 & 4\\\\3 & -2\\end{pmatrix},\\begin{pmatrix}-1 & 1\\\\2 & 6\\\\3 & -2\\\\5 & 1\\\\7 & 1\\\\43 & -1\\end{pmatrix},\\begin{pmatrix}2 & 6\\\\3 & -3\\\\5 & 2\\\\7 & 2\\\\13 & -1\\\\43 & -1\\end{pmatrix},\\begin{pmatrix}2 & 4\\\\3 & -2\\\\5 & 2\\\\7 & 2\\\\43 & -1\\end{pmatrix},\\begin{pmatrix}-1 & 1\\\\2 & 6\\\\3 & -4\\\\5 & 3\\\\7 & 3\\\\13 & -1\\\\43 & -1\\end{pmatrix},\\begin{pmatrix}2 & 6\\\\3 & -4\\\\5 & 4\\\\7 & 4\\\\13 & -1\\\\43 & -2\\end{pmatrix},\\begin{pmatrix}2 & 6\\\\3 & -6\\\\5 & 3\\\\7 & 3\\\\43 & -1\\end{pmatrix},\\begin{pmatrix}-1 & 1\\\\2 & 5\\\\3 & -6\\\\5 & 4\\\\7 & 4\\\\13 & -1\\\\43 & -1\\end{pmatrix},\\begin{pmatrix}2 &… [latex truncated: 1639 chars total]",
