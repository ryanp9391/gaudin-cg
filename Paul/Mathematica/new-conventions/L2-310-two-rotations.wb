       "data": "Out[1009]= \\begin{array}{|c|c|c|}\\hline\\text{variant} & \\text{HW rank torus-completed} & \\text{per irrep \\{irrep, mult, rank, nonzero\\}}\\\\\\hline\\text{a} & 10 & \\begin{matrix}\\left\\{\\left\\{3,3,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,2,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,3,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,4,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,2,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,3,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,1,1\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,2,0\\right\\},1,1,\\mathrm{True}\\right\\}\\end{matrix}\\\\\\hline\\text{b} & 10 & \\begin{matrix}\\left\\{\\left\\{3,3,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,2,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,3,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,4,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,2,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,3,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,1,1\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,2,0\\right\\},1,1,\\mathrm{True}\\right\\}\\end{matrix}\\\\\\hline\\text{c} & 10 & \\begin{matrix}\\left\\{\\left\\{3,3,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\… [latex truncated: 2188 chars total]",
