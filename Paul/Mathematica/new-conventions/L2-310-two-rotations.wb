  {
   "kind": 2,
   "value": "(* scan of the 11 pole subsets: (1) fit of every y-power coefficient vector to basisT (60 digits), (2) for subsets in span the exact rational curve cyx(y) on (1,T10,T11,T20,T21,T22,T30,T31,T32), (3) exact y with cyx(y) parallel to cP3 (B) / cP2 (A), (4) rank of Phi(c(y)) = sum c_k allMats_k at three generic y, (5) all y with Phi(c(y)) of rank 1 (gcd of the 2x2 minors of the r x 15 decomposition Acoef of cell 6, TimeConstrained 120 s) *)\nu19shapeNames = {\"1\", \"T10\", \"T11\", \"T20\", \"T21\", \"T22\", \"T30\", \"T31\", \"T32\"};\nu19gen = {2, -5/3, 7/5};\nu19analyze[P_] := Module[{co, dg, cp, resP, inSpan, rat, cyx, par3, parA, supp, ranks, aOf, mins, g, rts, rk1, lowdeg, out},\n  co = u19coefs[P]; dg = Length[co] - 1;\n  cp = Table[If[nrmQ[co[[p + 1]]] < 10^-40, ConstantArray[0, 9], LeastSquares[basisT, co[[p + 1]]]], {p, 0, dg}];\n  resP = Table[If[nrmQ[co[[p + 1]]] < 10^-40, 0, nrmQ[basisT . cp[[p + 1]] - co[[p + 1]]]/nrmQ[co[[p + 1]]]], {p, 0, dg}];\n  inSpan = sizeQ[Max[resP]] < 10^-30;\n  If[! inSpan, Return[<|\"P\" -> P, \"inSpan\" -> False, \"res\" -> sizeQ[Max[resP]], \"resByPower\" -> (sizeQ /@ resP)|>]];\n  rat = Rationalize[Chop[cp, 10^-40], 10^-30];\n  cyx = Factor /@ (ySym^Range[0, dg] . rat);\n  supp = Pick[u19shapeNames, Unitize[cyx /. ySym -> 3], 1];\n  par3 = Solve[Join[Thread[Flatten[Minors[{cyx, cP3[[1 ;; 9]]}, 2]] == 0], {ySym != 0}], ySym];\n  parA = Solve[Join[Thread[Flatten[Minors[{cyx, cP2[[1 ;; 9]]}, 2]] == 0], {ySym != 0}], ySym];\n  ranks = Table[MatrixRank[Sum[(cyx[[k]] /. ySym -> yv) allMats[[k]], {k, 9}]], {yv, u19gen}];\n  aOf = Sum[cyx[[k]] Acoef[[k]], {k, 9}];\n  mins = DeleteCases[Union[Flatten[Expand[Minors[aOf, 2]]]], 0];\n  g = If[mins === {}, 0, PolynomialGCD @@ mins];\n  rts = If[g === 0, \"all y\", If[PolynomialQ[g, ySym] && Exponent[g, ySym] == 0, {}, ySym /. Solve[g == 0, ySym]]];\n  <|\"P\" -> P, \"inSpan\" -> True, \"res\" -> sizeQ[Max[resP]], \"ratErr\" -> sizeQ[Max[Abs[cp - rat]]], \"cyx\" -> cyx, \"support\" -> supp, \"yDegs\" -> {Min[Select[Range[0, dg], nrmQ[co[[# + 1]]] > 10^-40 &]], Max[Select[Range[0, dg], nrmQ[co[[# + 1]]] > 10^-40 &]]}, \"yB\" -> If[par3 === {}, \"none\", ySym /. par3], \"yA\" -> If[parA === {}, \"none\", ySym /. parA], \"genRanks\" -> ranks, \"rank1gcd\" -> g, \"rank1roots\" -> rts|>];\n{u19tScan, u19res} = AbsoluteTiming[Association[Table[P -> TimeConstrained[u19analyze[P], 120, \"timeout\"], {P, u19subsets}]]];\nchecks[\"u19: pole-subset scan done (time s)\"] = u19tScan;\nGrid[Join[{{\"P\", \"in span? (max rel res)\", \"support\", \"y-degrees\", \"y hitting B\", \"y hitting A\", \"rank of Phi at y=2,-5/3,7/5\", \"y with Phi rank<=1 (gcd of minors roots)\"}}, Table[With[{r = u19res[P]}, If[r === \"timeout\", {P, \"timeout\", \"\", \"\", \"\", \"\", \"\", \"\"}, If[r[\"inSpan\"], {P, {True, N[r[\"res\"], 2]}, r[\"support\"], r[\"yDegs\"], r[\"yB\"], r[\"yA\"], r[\"genRanks\"], r[\"rank1roots\"]}, {P, {False, N[r[\"res\"], 2]}, \"\", \"\", \"\", \"\", \"\", \"\"}]]], {P, u19subsets}], {{\"time (s)\", u19tScan, \"\", \"\", \"\", \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607004\" data-output-id=\"167\" data-out-n=\"1011\" data-sub-idx=\"6\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"67\" data-sub-start=\"22\" data-sub-end=\"22\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1011]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:15.75em;vertical-align:-7.605em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.145em;\"><span style=\"top:-10.105em;\"><span class=\"pstrut\" style=\"height:10.105em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:15.71em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-7.605em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.105em;\"><span style=\"top:-10.265em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">P</span></span></span></span><span style=\"top:-9.055em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-7.845em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-6.635em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">3</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-5.425em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-4.215em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">3</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-3.005em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">3</spa