  {
   "kind": 2,
   "value": "(* Task 2. Vacuum Q's of the bra twist w (direct Baxter equation with w_i in place of z_i, eigenvalues of t_a(G') on Ω⊗Ω interpolated exactly) and the vacuum overlap determinant: det6 with all 8 poles {s, n}, n = λ3..λ1 = 0..3, insertions 1 and e^{2πix/h} (adjoint cells 7-8); reference factor = first guess with the vacuum SoV triple (θ-4h, θ-3h, θ-h) *)\ntWp = Table[Sum[lagQ[m] tL2[a, uPts[[m]], GP], {m, 7}], {a, 3}];\nkOm = Ordering[Abs[Ω2], -1][[1]];\ntauVac = Table[Expand[Sum[lagQ[m] (Ω2 . tL2[a, uPts[[m]], GP])[[kOm]]/Ω2[[kOm]], {m, 7}]], {a, 3}];\nchecks[\"Q2: Ω⊗Ω eigen-covector of t_a(u, G') with the interpolated τ_a (exact, nodes and 2/9)\"] = And @@ Flatten[Table[SubsetQ[{0}, Union[Normal[Ω2 . tL2[a, x, GP] - (tauVac[[a]] /. uQ -> x) Ω2]]], {a, 3}, {x, Append[uPts, 2/9]}]];\nqdVac = Table[solveQ[opDir, N[tauVac, precQ], wN[[i]], -1], {i, 3}];\nchecks[\"Q2: vacuum direct q's degrees (expect 0,4,6)\"] = If[FreeQ[qdVac, {}], Exponent[qdVac, xQ], \"not found\"];\nchecks[\"Q2: vacuum Baxter residual\"] = sizeQ[Max[Table[qResid[opDir, N[tauVac, precQ], wN[[i]], -1, qdVac[[i]]], {i, 3}]]];\n(* full Q's at rational points, memoized; A = state index, \"vac\" = the w-vacuum *)\nQU[A_, j_, x_] := QU[A, j, x] = N[zN[[j]]^(x/hN), precQ] (quS[[A, j]] /. xQ -> x);\nQD[A_Integer, i_, x_] := QD[A, i, x] = N[zN[[i]]^(-x/hN), precQ] (qdS[[A, i]] /. xQ -> x);\nQD[\"vac\", i_, x_] := QD[\"vac\", i, x] = N[wN[[i]]^(-x/hN), precQ] (qdVac[[i]] /. xQ -> x);\npoles = Flatten[Table[{s, n}, {s, nL}, {n, Λ[[3]], Λ[[1]]}], 1];\nxP[{s_, n_}] := thN[[s]] - n hN;\nwgt[p_] := wgt[p] = 1/Product[xP[p] - xP[q], {q, DeleteCases[poles, p]}];\nins[1][x_] := 1; ins[2][x_] := Exp[2 Pi I x/hN];\nprsL1 = {{1, 3}, {1, 2}, {2, 3}};\nrowG[B_, F_, {i_, j_}, k_] := Sum[N[wgt[p] ins[k][xP[p]], precQ] With[{x = xP[p]}, {-QU[B, j, x] F[i, x], -x QU[B, j, x] F[i, x], QU[B, j, x] F[i, x + hN], x QU[B, j, x] F[i, x + hN], QU[B, j, x - hN] F[i, x], x QU[B, j, x - hN] F[i, x]}], {p, poles}];\ndet6[B_, F_] := Det[Flatten[Table[rowG[B, F, ij, k], {k, 2}, {ij, prsL1}], 1]];\nFvac = Function[{i, x}, QD[\"vac\", i, x]];\n(* reference factor Ψ_Q(x0) with a general triple (x1, x21, x22) = θ_s - (n1, n21, n22) h; first guess (4, 3, 1) *)\npsiQg[B_, {n1_, n21_, n22_}] := Product[With[{t = thN[[s]]}, (QU[B, 2, t - n21 hN] QU[B, 3, t - n1 hN] - QU[B, 3, t - n21 hN] QU[B, 2, t - n1 hN]) QU[B, 3, t - n22 hN]], {s, nL}];\npsiQ[B_] := psiQg[B, {4, 3, 1}];\novl = Table[Ω2 . vecSt[[B]], {B, nSt}]; x0ovl = Table[x02 . vecSt[[B]], {B, nSt}];\nconstDev[l_List] := Max[Abs[l/l[[1]] - 1]];\n{d6Time1, d6one} = AbsoluteTiming[det6[1, Fvac]];\n{d6Time, det6List} = AbsoluteTiming[Table[det6[B, Fvac], {B, nSt}]];\nratio6 = Table[(ovl[[B]]/x0ovl[[B]])/(det6List[[B]]/psiQ[B]), {B, nSt}];\nchecks[\"Q2: min |<x0|ψ>|, min |<Ω|ψ>|, min |det6|, min |Ψ_Q| (nonzero, not zero tests)\"] = N[{Min[Abs[x0ovl]], Min[Abs[ovl]], Min[Abs[det6List]], Min[Abs[psiQ /@ Range[nSt]]]}, 3];\nchecks[\"Q2: 6x6: <Ω|ψ>/<x0|ψ> ∝ det6[B, vac]/Ψ_Q(x0) (max |ratio/ratio[1] - 1|)\"] = sizeQ[constDev[ratio6]];\nchecks[\"Q2: the constant ratio6[1]\"] = N[ratio6[[1]], 12];\nGrid[{{\"Ω⊗Ω eigen-covector (exact)\", checks[\"Q2: Ω⊗Ω eigen-covector of t_a(u, G') with the interpolated τ_a (exact, nodes and 2/9)\"]}, {\"vacuum q degrees\", checks[\"Q2: vacuum direct q's degrees (expect 0,4,6)\"]}, {\"vacuum Baxter residual\", checks[\"Q2: vacuum Baxter residual\"]}, {\"det6 time: one state, 225 states (s)\", {d6Time1, d6Time}}, {\"min |<x0|ψ>|, |<Ω|ψ>|, |det6|, |Ψ_Q|\", checks[\"Q2: min |<x0|ψ>|, min |<Ω|ψ>|, min |det6|, min |Ψ_Q| (nonzero, not zero tests)\"]}, {\"max |ratio6/ratio6[1] - 1| (225 states)\", checks[\"Q2: 6x6: <Ω|ψ>/<x0|ψ> ∝ det6[B, vac]/Ψ_Q(x0) (max |ratio/ratio[1] - 1|)\"]}, {\"ratio6[1]\", checks[\"Q2: the constant ratio6[1]\"]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607004\" data-output-id=\"131\" data-out-n=\"605\" data-sub-idx=\"31\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"16\" data-sub-start=\"31\" data-sub-end=\"31\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[605]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:8.45em;vertical-align:-3.955em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.495em;\"><span style=\"top:-6.455em;\"><span class=\"pstrut\" style=\"height:6.455em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:8.41em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.955em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.455em;\"><span style=\"top:-6.615em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">Ω</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⊗</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">Ω eigen-covector (exact)</span></span></span></span><span style=\"top:-5.415em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">vacuum q degrees</span></span></span></span><span style=\"top:-4.215em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">vacuum Baxter residual</span></span></span></span><span style=\"top:-3.015em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">det6 time: one state, 225 states (s)</span></span></span></span><span style=\"top:-1.805em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">min |&lt;x0|</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">ψ</span><span class=\"mord\">&gt;|, |&lt;Ω|</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">ψ</span><span class=\"mord\">&gt;|, |det6|, |Ψ_Q|</span></span></span></span><span style=\"top:-0.605em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max |ratio6/ratio6[1] - 1| (225 states)</span></span></span></span><span style=\"top:0.595em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">ratio6[1]</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.955em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:8.41em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.955em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.455em;\"><span style=\"top:-6.615em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-5.415em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">4</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">6</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-4.215em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">4.802492607968365</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">49</span></span></span></span></span></span></span></span></span></span></span><span style=\"top:-3.015em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0.004358</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.339325</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-1.805em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">{</span></span><span class=\"mord\">4.26</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">6</span></span></span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0000307</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1.65</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.000741</span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">}</span></span></span></span></span><span style=\"top:-0.605em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">5.143902434990437</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">45</span></span></span></span></span></span></span></span></span></span></span><span style=\"top:0.595em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0.000291705556858</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">0.000777246676691</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathrm\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.955em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:8.41em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.955em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:6.455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:6.455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:6.455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.11em;\"><span class=\"pstrut\" style=\"height:6.455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.31em;\"><span class=\"pstrut\" style=\"height:6.455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.51em;\"><span class=\"pstrut\" style=\"height:6.455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.71em;\"><span class=\"pstrut\" style=\"height:6.455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.91em;\"><span class=\"pstrut\" style=\"height:6.455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.955em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[605]= \\begin{array}{|c|c|}\\hline\\text{$\\Omega$$\\otimes$$\\Omega$ eigen-covector (exact)} & \\mathrm{True}\\\\\\hline\\text{vacuum q degrees} & \\left\\{0,4,6\\right\\}\\\\\\hline\\text{vacuum Baxter residual} & 4.802492607968365\\times 10^{-49}\\\\\\hline\\text{det6 time: one state, 225 states (s)} & \\left\\{0.004358,0.339325\\right\\}\\\\\\hline\\text{min |<x0|$\\psi$>|, |<$\\Omega$|$\\psi$>|, |det6|, |$\\Psi$\\_Q|} & \\left\\{4.26\\times 10^{-6},0.0000307,1.65,0.000741\\right\\}\\\\\\hline\\text{max |ratio6/ratio6[1] - 1| (225 states)} & 5.143902434990437\\times 10^{-45}\\\\\\hline\\text{ratio6[1]} & 0.000291705556858+0.000777246676691\\,\\mathrm{i}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "ca81ba06-de03-4062-9dc7-4c1056db2c77"
