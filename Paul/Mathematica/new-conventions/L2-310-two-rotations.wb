       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607003\" data-output-id=\"7\" data-out-n=\"113\" data-sub-idx=\"10\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"8\" data-sub-start=\"10\" data-sub-end=\"10\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[113]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:6.0602em;vertical-align:-2.7601em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.3001em;\"><span style=\"top:-5.2601em;\"><span class=\"pstrut\" style=\"height:5.2601em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6.0202em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.7601em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.2601em;\"><span style=\"top:-5.2601em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">site-2 y(g): comp 2, comp 3</span></span></span></span><span style=\"top:-3.455em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">adjoint y* formula w2(</span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord\">12-h)/(</span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord\">12-2h) and w2(</span><span