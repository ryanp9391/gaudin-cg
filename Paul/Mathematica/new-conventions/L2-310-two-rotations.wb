      {
       "data": "Out[955]= \\begin{array}{|c|c|}\\hline\\text{v2 == e1.rho(n)} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{rho(n) == Rrot} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{3x3 n = product of exponentials} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{v1 reconstruction parallel to pipeline f1} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{s = e1-component of v2} & \\left\\{1,1,1,1,1,1\\right\\}\\\\\\hline\\text{r\\_k for w2 = 7/3} & \\left\\{\\frac{4}{5},-\\frac{1071}{605},\\frac{1401}{484}\\right\\}\\\\\\hline\\end{array}",
