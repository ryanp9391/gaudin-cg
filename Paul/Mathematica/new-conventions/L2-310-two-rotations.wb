      {
       "data": "Out[667]= \\begin{array}{|c|c|}\\hline\\text{$\\Phi$\\_B rank (1 = product)} & 1\\\\\\hline\\text{y*} & -\\frac{63}{43}\\\\\\hline\\text{MAIN: max |ratio4/ratio4[1] - 1|} & 5.1449608800184316\\times 10^{-45}\\\\\\hline\\text{ratio4[1], ratio4[1]/ratio6[1]} & \\left\\{1.25000347539\\times 10^{-6}+3.33062234933\\times 10^{-6}\\,\\mathrm{i},0.00428515482821+0.\\times 10^{-15}\\,\\mathrm{i}\\right\\}\\\\\\hline\\text{ratio4/ratio6 = 1/$\\kappa$} & 4.57085800594307\\times 10^{-47}\\\\\\hline\\text{control y = -63/8} & 77.2\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "ea3785e5-225e-4d73-bd5e-f011ced98c45"
    }
