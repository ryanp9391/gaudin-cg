      {
       "data": "Out[989]= \\begin{array}{|c|c|}\\hline\\text{time (s)} & 27.795671\\\\\\hline\\text{usable points, rank of log design} & \\left\\{28,16\\right\\}\\\\\\hline\\text{fit exponents of \\{h, t, t-h, t-2h, t-3h, t-4h, z1-z2, z1-z3, z2-z3, z1, z2, z3, w1-z1, w1-z2, w1-z3\\}} & \\left\\{-1.386,1.857\\times 10^{-42},-6.146\\times 10^{-43},1.\\,,-1.\\,,2.571\\times 10^{-42},-3.579\\times 10^{-42},-1.413\\times 10^{-43},1.\\,,1.\\,,1.814\\times 10^{-42},-1.\\,,-1.\\,,1.\\,,2.276\\times 10^{-42},-1.\\,\\right\\}\\\\\\hline\\text{max log residual} & 0.\\times 10^{-29}\\\\\\hline\\text{K12 formula holds at all random points} & \\mathrm{True}\\\\\\hline\\end{array}",
