18tx, \\\"\\\"}}], Frame -> All, Alignment -> Left]\\\".\\nSyntax::sntxf: \\\"\\\" cannot be followed by \\\"quantity\\\", \\\"fit: {log K, exponents of \\\" <> ToString[u18facNames]}, \\\"max log residual\\\"}}, Table[{{\\\"beta12\\\", \\\"gamma13\\\", \\\"delta\\\"}[[i]], N[u18fits[[i, 1]], 6], N[u18fits[[i, 2]], 3]}, {i, 3}], {{\\\"time (s)\\\", u18tx, \\\"\\\"}}], Frame -> All, Alignment -> Left]\\\".\\nSyntax::sntxf: \\\"\\\" cannot be followed by \\\"ity\\\", \\\"fit: {log K, exponents of \\\" <> ToString[u18facNames]}, \\\"max log residual\\\"}}, Table[{{\\\"beta12\\\", \\\"gamma13\\\", \\\"delta\\\"}[[i]], N[u18fits[[i, 1]], 6], N[u18fits[[i, 2]], 3]}, {i, 3}], {{\\\"time (s)\\\", u18tx, \\\"\\\"}}], Frame -> All, Alignment -> Left]\\\".\",\n\t\"stack\": \"\"\n}",
