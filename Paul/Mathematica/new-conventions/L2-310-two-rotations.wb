  {
   "kind": 2,
   "value": "(* (a, w2-dependence) more samples of the point-A pipeline (12 extra w2, w1 = 5/2 fixed), then the coefficients (beta12, gamma13, delta) of g = f1.D^-1.R^-1 = e1 (1 + beta E12 + gamma E13 + delta E12E23).  Log-linear fit of each against monomials in {w2, w2-z_k, yA-z_k, w2-w1, yA-w1} (exact data, real least squares of the logs, then exponents rounded and the constant read off as a rational). *)\nSeedRandom[1818];\nu18w2x = {}; While[Length[u18w2x] < 12, With[{c = RandomInteger[{-9, 9}]/RandomInteger[{2, 9}]}, If[! MemberQ[Join[zN, {0, u13w1, u13w3, 31/35, hN}, thN, u18w2x, u13w2s], c] && FreeQ[zN, u14yA[c]] && u14yA[c] =!= c, AppendTo[u18w2x, c]]]];\n{u18tx, u18runsX} = AbsoluteTiming[Association[Table[c -> u14pipe[zN, {u13w1, c, u13w3}, hN, thN], {c, u18w2x}]]];\nu18Ax = Association[Table[c -> Select[\"nontrivial points\" /. u18runsX[c], ListQ[\"y(site2)\" /. #] && (\"y(site2)\" /. #)[[1]] == u14yA[c] &], {c, u18w2x}]];\nchecks[\"u18(a) extra w2: point A found exactly once\"] = Values[Length /@ u18Ax];\nu18allW2 = Join[u13w2s, u18w2x];\nu18f1all = Join[u14Af1, Association[Table[c -> Normal[\"f1\" /. u18Ax[c][[1]]], {c, u18w2x}]]];\nu18gAll[w2_] := u18f1all[w2] . Inverse[ρdiag[Dy[w2]]] . Inverse[u18Rm[w2]];\nu18coefAll[w2_] := Module[{s = LinearSolve[Transpose[u18wv[[{1, 2, 3, 4}]]], u18gAll[w2]]}, s/s[[1]]];\nu18cfs = Association[Table[w2 -> u18coefAll[w2], {w2, u18allW2}]];\nchecks[\"u18(a) gamma = 2 delta at all 18 w2\"] = And @@ Table[u18cfs[w2][[3]] == 2 u18cfs[w2][[4]], {w2, u18allW2}];\nchecks[\"u18(a) g in span{e1,e1E12,e1E13,e1E12E23} at the 12 extra w2\"] = Table[MatrixRank[Append[u18wv[[{1, 2, 3, 4}]], u18gAll[w2]]] == 4, {w2, u18w2x}];\nu18facs[w2_] := {w2, w2 - zN[[1]], w2 - zN[[2]], w2 - zN[[3]], u14yA[w2] - zN[[1]], u14yA[w2] - zN[[2]], u14yA[w2] - zN[[3]], w2 - u13w1, u14yA[w2] - u13w1};\nu18facNames = {\"w2\", \"w2-z1\", \"w2-z2\", \"w2-z3\", \"yA-z1\", \"yA-z2\", \"yA-z3\", \"w2-w1\", \"yA-w1\"};\nu18logfit[vals_] := Module[{A = Table[Join[{1}, Log[Abs[u18facs[w2]]]], {w2, u18allW2}], b = Log[Abs[vals]], sol}, sol = LeastSquares[N[A, 30], N[b, 30]]; {sol, Max[Abs[N[A, 30] . sol - N[b, 30]]]}];\nu18fits = Table[u18logfit[Table[u18cfs[w2][[k]], {w2, u18allW2}]], {k, {2, 3, 4}}];\nGrid[Join[{{\"quantity\", \"fit: {log K, exponents of \" <> ToString[u18facNames]}, \"max log residual\"}}, Table[{{\"beta12\", \"gamma13\", \"delta\"}[[i]], N[u18fits[[i, 1]], 6], N[u18fits[[i, 2]], 3]}, {i, 3}], {{\"time (s)\", u18tx, \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
