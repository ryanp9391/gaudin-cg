      {
       "data": "Out[982]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{weight $\\mu$} & \\text{dim V\\_$\\mu$} & \\text{rank (a) point B} & \\text{rank (b) beta=0} & \\text{rank (c) resolvent y-star, beta} & \\text{rank (c0) resolvent y-star, beta=0}\\\\\\hline\\left\\{0,1,3\\right\\} & 1 & 0 & 1 & 0 & 0\\\\\\hline\\left\\{0,2,2\\right\\} & 1 & 1 & 1 & 1 & 0\\\\\\hline\\left\\{0,3,1\\right\\} & 1 & 1 & 1 & 1 & 1\\\\\\hline\\left\\{1,0,3\\right\\} & 1 & 0 & 1 & 0 & 0\\\\\\hline\\left\\{1,1,2\\right\\} & 2 & 1 & 2 & 1 & 0\\\\\\hline\\left\\{1,2,1\\right\\} & 2 & 2 & 2 & 2 & 1\\\\\\hline\\left\\{1,3,0\\right\\} & 1 & 1 & 1 & 1 & 1\\\\\\hline\\left\\{2,0,2\\right\\} & 1 & 1 & 1 & 1 & 0\\\\\\hline\\left\\{2,1,1\\right\\} & 2 & 2 & 2 & 2 & 1\\\\\\hline\\left\\{2,2,0\\right\\} & 1 & 1 & 1 & 1 & 1\\\\\\hline\\left\\{3,0,1\\right\\} & 1 & 1 & 1 & 1 & 1\\\\\\hline\\left\\{3,1,0\\right\\} & 1 & 1 & 1 & 1 & 1\\\\\\hline\\text{identically vanishing weight sectors / basis indices} &  & \\text{(a) \\{\\{\\{0, 1, 3\\}, \\{15\\}\\}, \\{\\{1, 0, 3\\}, \\{12\\}\\}, \\{\\{1, 1, 2\\}, \\{11\\}\\}\\}} & \\text{(b) \\{\\}} & \\text{(c) \\{\\{\\{0, 1, 3\\}, \\{15\\}\\}, \\{\\{1, 0, 3\\}, \\{12\\}\\}, \\{\\{1, 1, 2\\}, \\{11\\}\\}\\}} & \\text{(c0) \\{\\{\\{0, 1, 3\\}, \\{15\\}\\}, \\{\\{0, 2, 2\\}, \\{14\\}\\}, \\{\\{1, 0, 3\\}, \\{12\\}\\}, \\{\\{1, 1, 2\\}, \\{10, 11\\}\\}, \\{\\{1, 2, 1\\}, \\{9\\}\\},… [latex truncated: 1323 chars total]",
