       "data": "Out[1075]= \\begin{array}{|c|c|}\\hline\\text{\\# LW kets} & 10\\\\\\hline\\text{LW weights} & \\begin{matrix}\\left\\{\\left\\{0,2,6\\right\\},1\\right\\}\\\\\\left\\{\\left\\{0,3,5\\right\\},1\\right\\}\\\\\\left\\{\\left\\{0,4,4\\right\\},1\\right\\}\\\\\\left\\{\\left\\{1,1,6\\right\\},1\\right\\}\\\\\\left\\{\\left\\{1,2,5\\right\\},2\\right\\}\\\\\\left\\{\\left\\{1,3,4\\right\\},2\\right\\}\\\\\\left\\{\\left\\{2,2,4\\right\\},1\\right\\}\\\\\\left\\{\\left\\{2,3,3\\right\\},1\\right\\}\\end{matrix}\\\\\\hline\\text{weights = reverses of HW} & \\mathrm{True}\\\\\\hline\\text{LW killed by lowering, e\\_low x e\\_low is LW} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{(rho(m) x rho(m)).LW == LW} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{f1 parallel to pipeline f1} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{<f1 x v2|LW> == s <phi' x e\\_low|LW>} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\end{array}",
