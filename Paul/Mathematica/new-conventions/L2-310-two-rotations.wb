       "data": "Out[961]= \\begin{array}{|c|c|c|}\\hline\\text{shape} & \\text{C\\_lambda (h, t12 = th1 - th2)} & \\text{max rel |closed form - basisT|}\\\\\\hline\\left\\{1,0\\right\\} & 3\\,\\mathrm{hS}\\,\\left(3\\,\\mathrm{hS}-t12S\\right) & 2.0283287949170876\\times 10^{-46}\\\\\\hline\\left\\{1,1\\right\\} & 12\\,\\mathrm{hS}^2\\,\\left(3\\,\\mathrm{hS}-t12S\\right)\\,\\left(4\\,\\mathrm{hS}-t12S\\right) & 9.359965432363321\\times 10^{-48}\\\\\\hline\\left\\{2,0\\right\\} & 6\\,\\mathrm{hS}^2\\,\\left(2\\,\\mathrm{hS}-t12S\\right)\\,\\left(3\\,\\mathrm{hS}-t12S\\right) & 7.742741959021659\\times 10^{-48}\\\\\\hline\\left\\{2,1\\right\\} & 24\\,\\mathrm{hS}^3\\,\\left(2\\,\\mathrm{hS}-t12S\\right)\\,\\left(3\\,\\mathrm{hS}-t12S\\right)\\,\\left(4\\,\\mathrm{hS}-t12S\\right) & 7.528808696896531\\times 10^{-48}\\\\\\hline\\left\\{2,2\\right\\} & 72\\,\\mathrm{hS}^4\\,\\left(2\\,\\mathrm{hS}-t12S\\right)\\,\\left(3\\,\\mathrm{hS}-t12S\\right)^2\\,\\left(4\\,\\mathrm{hS}-t12S\\right) & 7.412561884159131\\times 10^{-48}\\\\\\hline\\left\\{3,0\\right\\} & 6\\,\\mathrm{hS}^3\\,\\left(\\mathrm{hS}-t12S\\right)\\,\\left(2\\,\\mathrm{hS}-t12S\\right)\\,\\left(3\\,\\mathrm{hS}-t12S\\right) & 7.735971006055681\\times 10^{-48}\\\\\\hline\\left\\{3,1\\right\\} & 24\\,\\mathrm{hS}^4\\,\\left(\\mathrm{hS}-t12S\\right)\\,\\left(2\\,\\mathrm{hS}-t12S\\right)\\,\\left(3\\,\\… [latex truncated: 1779 chars total]",
