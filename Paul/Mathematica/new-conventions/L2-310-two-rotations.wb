  {
   "kind": 2,
   "value": "(* HW count. M[i,nu] = <phi(w2_i) x e1|HW_nu> over the six w2 (fixed torus), per-irrep column ranks, and the torus-completed version: 12 random (w2, D) pairs, rows <v1 rho(D) x v2 rho(D)|HW_nu> built directly (fresh pipeline run for each random w2 to get its beta/alpha). Irreps of the 10 HW kets: u13HWwt. *)\nu13Mfix[t_] := Table[kron[u13Phi[t][[i]], e1] . u13HW, {i, Length[u13w2s]}];\nu13irreps = Union[u13HWwt];\nu13colsOf[ν_] := Flatten[Position[u13HWwt, ν]];\nu13perIrrep[M_] := Table[{ν, Length[u13colsOf[ν]], MatrixRank[M[[All, u13colsOf[ν]]]], Union[Flatten[M[[All, u13colsOf[ν]]]]] =!= {0}}, {ν, u13irreps}];\nu13MF = Association[Table[t -> u13Mfix[t], {t, {\"a\", \"b\", \"c\"}}]];\nu13hwFix = Association[Table[t -> {MatrixRank[u13MF[t]], u13perIrrep[u13MF[t]]}, {t, {\"a\", \"b\", \"c\"}}]];\n(* torus-completed: random (w2, D) pairs *)\nSeedRandom[1313];\nu13rndW2 = {}; While[Length[u13rndW2] < 12, With[{c = RandomInteger[{-9, 9}]/RandomInteger[{2, 9}]}, If[! MemberQ[Join[zN, {0, u13w1, u13w3, 31/35, thN, hN}, u13rndW2, u13w2s], c] && FreeQ[zN, u13ystar[c]] && u13ystar[c] =!= c, AppendTo[u13rndW2, c]]]];\n{u13tRnd, u13rndRuns} = AbsoluteTiming[Association[Table[c -> u13pipe[zN, {u13w1, c, u13w3}, hN, thN], {c, u13rndW2}]]];\nu13rndB = Association[Table[c -> Select[\"nontrivial points\" /. u13rndRuns[c], ListQ[\"y(site2)\" /. #] && (\"y(site2)\" /. #)[[1]] == u13ystar[c] &], {c, u13rndW2}]];\nchecks[\"u13 torus: point B found for all 12 random w2\"] = Values[Length /@ u13rndB];\nu13rndBeta = Association[Table[c -> (\"β/α\" /. (\"site1 in span{e1RD, e1E12RD}\" /. u13rndB[c][[1]])), {c, u13rndW2}]];\nu13rndD = Table[RandomSample[Select[Range[-9, 9], # != 0 &], 3]/RandomSample[Range[2, 9], 3], {12}];\nu13rotN[w2_] := u13rhoN[w2];\nu13torusRow[c_, D_, t_] := Module[{v2 = u13v2[c], v1 = u13v1[c, u13rndBeta[c], If[t === \"c\", u13ystar[c], c]], rD = ρdiag[D]}, kron[v1 . rD, v2 . rD] . u13HW];\nu13MT = Association[Table[t -> Table[u13torusRow[u13rndW2[[i]], u13rndD[[i]], t], {i, 12}], {t, {\"a\", \"c\"}}]];\nu13hwTor = Association[Table[t -> {MatrixRank[u13MT[t]], u13perIrrep[u13MT[t]]}, {t, {\"a\", \"c\"}}]];\nchecks[\"u13 HW rank fixed torus (a, b, c)\"] = (u13hwFix[#][[1]] & /@ {\"a\", \"b\", \"c\"});\nchecks[\"u13 HW rank torus-completed (a, c)\"] = (u13hwTor[#][[1]] & /@ {\"a\", \"c\"});\nu13rowTab[h_] := Table[{h[[2, k, 1]], h[[2, k, 2]], h[[2, k, 3]], h[[2, k, 4]]}, {k, Length[u13irreps]}];\nGrid[{{\"HW rank, fixed torus (six w2): (a) point B, (b) beta=0, (c) resolvent y-star\", checks[\"u13 HW rank fixed torus (a, b, c)\"]}, {\"HW rank, torus-completed (12 random (w2,D)): (a), (c)\", checks[\"u13 HW rank torus-completed (a, c)\"]}, {\"per-irrep {irrep, mult, rank, nonzero}: (a) fixed\", Column[u13rowTab[u13hwFix[\"a\"]]]}, {\"(b) fixed\", Column[u13rowTab[u13hwFix[\"b\"]]]}, {\"(c) fixed\", Column[u13rowTab[u13hwFix[\"c\"]]]}, {\"(a) torus-completed\", Column[u13rowTab[u13hwTor[\"a\"]]]}, {\"(c) torus-completed\", Column[u13rowTab[u13hwTor[\"c\"]]]}, {\"pipeline time for 12 random w2 (s)\", u13tRnd}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
