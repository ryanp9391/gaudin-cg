  {
   "kind": 2,
   "value": "(* diagnostics of the two nontrivial product points (components 2 and 3 of solProd; component 1 is the localizing span). Site-2 factor: position κ in the pencil Ω1 + κ ω2 (ω2 = βbasis[[2]]). Site-1 factor: not a rotation (rotRank 6 resp. 5 instead of 4) — compare with the rotRank of descendants of e1 (one or two lowering steps: the orbit type is fixed by the stabilizer dimension 10 - rotRank). Also the exact c-vectors. *)\nω2 = βbasis[[2]];\nfactorsOf[sol_] := Module[{cc, free, M, rowi, colj}, cc = cs /. sol; free = Variables[cc]; cc = cc /. Thread[free -> 1];\n   M = Sum[cc[[k]] allMats[[k]], {k, Length[allMats]}]; rowi = First[FirstPosition[Total[Abs[M], {2}], _?(# != 0 &)]]; colj = First[FirstPosition[Total[Abs[M], {1}], _?(# != 0 &)]];\n   {cc, M[[All, colj]]/M[[rowi, colj]], M[[rowi, All]]/M[[rowi, colj]]}];\n{cP2, f1P2, f2P2} = factorsOf[solProd[[2]]]; {cP3, f1P3, f2P3} = factorsOf[solProd[[3]]];\nκOf[f2_] := Module[{s = LinearSolve[Transpose[{Ω1, ω2}], f2]}, s[[2]]/s[[1]]];\ndescTab = Table[{nm, rotRank[vec]}, {nm, {\"e1\", \"e1.E12\", \"e1.E23\", \"e1.E13\", \"e1.E12.E12\", \"e1.E12.E23\", \"e1.E23.E12\", \"e1.E12.E12.E12\", \"e1.E12 + e1.E23\", \"e1 + e1.E12\"}}, {vec, Normal /@ {e1, e1 . Ee[1, 2], e1 . Ee[2, 3], e1 . Ee[1, 3], e1 . Ee[1, 2] . Ee[1, 2], e1 . Ee[1, 2] . Ee[2, 3], e1 . Ee[2, 3] . Ee[1, 2], e1 . Ee[1, 2] . Ee[1, 2] . Ee[1, 2], e1 . Ee[1, 2] + e1 . Ee[2, 3], e1 + e1 . Ee[1, 2]}}] // Transpose[{#[[All, 1]], #[[All, 2]]}] &;\ndescTab = Table[{{\"e1\", \"e1.E12\", \"e1.E23\", \"e1.E13\", \"e1.E12.E12\", \"e1.E12.E23\", \"e1.E23.E12\", \"e1.E12.E12.E12\", \"e1.E12 + e1.E23\", \"e1 + e1.E12\"}[[k]], rotRank[{e1, e1 . Ee[1, 2], e1 . Ee[2, 3], e1 . Ee[1, 3], e1 . Ee[1, 2] . Ee[1, 2], e1 . Ee[1, 2] . Ee[2, 3], e1 . Ee[2, 3] . Ee[1, 2], e1 . Ee[1, 2] . Ee[1, 2] . Ee[1, 2], e1 . Ee[1, 2] + e1 . Ee[2, 3], e1 + e1 . Ee[1, 2]}[[k]]]}, {k, 10}];\nchecks[\"components 2,3: c (c33 irrelevant), κ of site 2, rotRank site 1, site-2 rotation?\"] = {{cP2, κOf[f2P2], rotRank[f1P2], rotRank[f2P2]}, {cP3, κOf[f2P3], rotRank[f1P3], rotRank[f2P3]}};\nchecks[\"adjoint c* reproduced on shapes (1,1),(2,1),(2,2),(3,1),(3,2)?\"] = (cP2[[{3, 5, 6, 8, 9}]]/cP2[[8]] == {-2187/1600, -243/80, -27/43, 1, 320/1161});\nGrid[Join[{{\"adjoint c* on the shifted shapes (component 2)?\", checks[\"adjoint c* reproduced on shapes (1,1),(2,1),(2,2),(3,1),(3,2)?\"]}, {\"component 2: c\", cP2}, {\"component 2: κ(site 2), rotRank site 1, rotRank site 2\", {κOf[f2P2], rotRank[f1P2], rotRank[f2P2]}}, {\"component 3: c\", cP3}, {\"component 3: κ(site 2), rotRank site 1, rotRank site 2\", {κOf[f2P3], rotRank[f1P3], rotRank[f2P3]}}, {\"rotRank of descendants of e1 (10 - stabilizer dim)\", \"\"}}, descTab], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
