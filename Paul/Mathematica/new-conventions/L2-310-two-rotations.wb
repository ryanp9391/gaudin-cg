       "data": "Out[1003]= \\begin{array}{|c|c|}\\hline\\text{HW rank, fixed torus (six w2): (a) point B, (b) beta=0, (c) resolvent y-star} & \\left\\{6,6,6\\right\\}\\\\\\hline\\text{HW rank, torus-completed (12 random (w2,D)): (a), (c)} & \\left\\{10,10\\right\\}\\\\\\hline\\text{per-irrep \\{irrep, mult, rank, nonzero\\}: (a) fixed} & \\begin{matrix}\\left\\{\\left\\{3,3,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,2,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,3,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,4,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,2,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,3,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,1,1\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,2,0\\right\\},1,1,\\mathrm{True}\\right\\}\\end{matrix}\\\\\\hline\\text{(b) fixed} & \\begin{matrix}\\left\\{\\left\\{3,3,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,2,2\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,3,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{4,4,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,2,1\\right\\},2,2,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{5,3,0\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,1,1\\right\\},1,1,\\mathrm{True}\\right\\}\\\\\\left\\{\\left\\{6,2,… [latex truncated: 2820 chars total]",
