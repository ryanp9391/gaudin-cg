      {
       "data": "Out[825]= \\begin{array}{|c|c|c|c|}\\hline\\text{x} & \\text{dual pair (i,j)} & \\text{max rel |t1 - t1\\_true|} & \\text{max rel |t2 - t2\\_true|}\\\\\\hline\\text{generic 3/11} & \\left\\{2,3\\right\\} & 2.035956075427279\\times 10^{-48} & 2.032970757841707\\times 10^{-48}\\\\\\hline\\text{generic 3/11} & \\left\\{1,3\\right\\} & 6.512759941317331\\times 10^{-49} & 6.455831530802142\\times 10^{-49}\\\\\\hline\\text{generic 3/11} & \\left\\{1,2\\right\\} & 1.7066143577630274\\times 10^{-43} & 1.7050893305883593\\times 10^{-43}\\\\\\hline\\text{th1-3h} & \\left\\{2,3\\right\\} & 2.0283301792801134\\times 10^{-46} & 9.359965589597504\\times 10^{-48}\\\\\\hline\\text{th1-3h} & \\left\\{1,3\\right\\} & 1.8309956949706736\\times 10^{-46} & 2.0188548714676616\\times 10^{-47}\\\\\\hline\\text{th1-3h} & \\left\\{1,2\\right\\} & 9.432954029972635\\times 10^{-44} & 2.8687472201246763\\times 10^{-44}\\\\\\hline\\text{th1-2h} & \\left\\{2,3\\right\\} & 3.169120135419306\\times 10^{-48} & 2.6747086551207703\\times 10^{-48}\\\\\\hline\\text{th1-2h} & \\left\\{1,3\\right\\} & 3.4139393934184025\\times 10^{-48} & 3.19081131426409\\times 10^{-48}\\\\\\hline\\text{th1-2h} & \\left\\{1,2\\right\\} & 3.2474412662186034\\times 10^{-44} & 2.72860503245096\\times 10^{-44}\\\\\\hline\\text{th1-h} & \\left\\{2,3\\righ… [latex truncated: 1516 chars total]",
