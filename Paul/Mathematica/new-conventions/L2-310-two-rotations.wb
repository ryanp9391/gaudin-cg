       "data": "Out[706]= \\begin{array}{|c|c|c|c|}\\hline\\text{w2} & \\text{y\\_A} & \\text{rotRank (site1, site2)} & \\text{c (1,T10,T11,T20,T21,T22,T30,T31,T32)}\\\\\\hline\\frac{7}{3} & -\\frac{63}{8} & \\left\\{6,4\\right\\} & \\left\\{0,0,-\\frac{2187}{1600},0,-\\frac{243}{80},-\\frac{27}{43},0,1,\\frac{320}{1161}\\right\\}\\\\\\hline-\\frac{8}{9} & 3 & \\left\\{6,4\\right\\} & \\left\\{0,0,-\\frac{243}{1225},0,\\frac{81}{70},-\\frac{27}{43},0,1,-\\frac{280}{387}\\right\\}\\\\\\hline\\frac{4}{27} & -\\frac{1}{2} & \\left\\{6,4\\right\\} & \\left\\{0,0,-\\frac{27}{4900},0,-\\frac{27}{140},-\\frac{27}{43},0,1,\\frac{560}{129}\\right\\}\\\\\\hline3 & -\\frac{81}{8} & \\left\\{6,4\\right\\} & \\left\\{0,0,-\\frac{177147}{78400},0,-\\frac{2187}{560},-\\frac{27}{43},0,1,\\frac{2240}{10449}\\right\\}\\\\\\hline-\\frac{1}{2} & \\frac{27}{16} & \\left\\{6,4\\right\\} & \\left\\{0,0,-\\frac{19683}{313600},0,\\frac{729}{1120},-\\frac{27}{43},0,1,-\\frac{4480}{3483}\\right\\}\\\\\\hline\\frac{11}{7} & -\\frac{297}{56} & \\left\\{6,4\\right\\} & \\left\\{0,0,-\\frac{2381643}{3841600},0,-\\frac{8019}{3920},-\\frac{27}{43},0,1,\\frac{15680}{38313}\\right\\}\\\\\\hline\\text{time (s)} & 5.66534 &  & \\\\\\hline\\end{array}",
