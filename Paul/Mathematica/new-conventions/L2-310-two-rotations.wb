      {
       "data": "Out[113]= \\begin{array}{|c|c|}\\hline\\text{site-2 y(g): comp 2, comp 3} & \\begin{pmatrix}-\\frac{63}{8}\\\\-\\frac{63}{43}\\end{pmatrix}\\\\\\hline\\text{adjoint y* formula w2($\\theta$12-h)/($\\theta$12-2h) and w2($\\theta$12-2h)/($\\theta$12-3h), w2($\\theta$12-h)/($\\theta$12-3h)} & \\left\\{-\\frac{63}{8},\\frac{56}{129},-\\frac{63}{43}\\right\\}\\\\\\hline\\text{site-1 orbit tests \\{name, rotRank, \\{seed -> \\# solutions\\}\\}} & \\begin{matrix}\\left\\{\\text{site1 of comp 2},6,\\left\\{\\text{e1.E12}\\to 0,\\text{e1.(E12+E23)}\\to 0,\\text{e1.E13}\\to 0,\\text{e1.(1+E12)}\\to 0\\right\\}\\right\\}\\\\\\left\\{\\text{site1 of comp 3},5,\\left\\{\\text{e1.E12}\\to 2,\\text{e1.(E12+E23)}\\to 0,\\text{e1.E13}\\to 0,\\text{e1.(1+E12)}\\to 2\\right\\}\\right\\}\\end{matrix}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
