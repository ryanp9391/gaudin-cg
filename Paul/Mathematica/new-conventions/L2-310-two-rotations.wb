      {
       "data": "Out[626]= \\begin{array}{|c|c|}\\hline\\text{T eigen-residual} & 4\\times 10^{-59}\\\\\\hline\\text{T\\_(3,3)($\\theta$1-3h) = 0 identically (exact)} & \\mathrm{True}\\\\\\hline\\text{basis \\{1, $\\tau$\\_$\\lambda$\\}: \\# sv, min/max sv} & \\left\\{9.\\,,0.0241\\right\\}\\\\\\hline\\text{controls (random combo, <x0|$\\psi$>/<$\\Omega$|$\\psi$>)} & \\left\\{5.491766786047208\\times 10^{-55},0.910\\right\\}\\\\\\hline\\text{span test: \\{y, rel residual\\}; time (s)} & 0.18662\\\\\\hline-\\frac{6}{5} & 8.309420770826507\\times 10^{-48}\\\\\\hline3 & 5.545020708370476\\times 10^{-47}\\\\\\hline\\frac{7}{4} & 1.8567201490381013\\times 10^{-46}\\\\\\hline-\\frac{63}{43} & 8.366739801076223\\times 10^{-48}\\\\\\hline\\end{array}",
       "mime": "text/plain"
