       "data": "Out[1023]= \\begin{array}{|c|c|}\\hline\\text{$\\beta$/$\\alpha$(w2), w2 = 7/3, -8/9, 4/27, 3, -1/2, 11/7} & \\begin{matrix}\\left\\{\\frac{7}{3},-\\frac{63}{43},\\frac{392}{2335}\\right\\}\\\\\\left\\{-\\frac{8}{9},\\frac{24}{43},\\frac{64}{731}\\right\\}\\\\\\left\\{\\frac{4}{27},-\\frac{4}{43},-\\frac{32}{2409}\\right\\}\\\\\\left\\{3,-\\frac{81}{43},\\frac{8}{77}\\right\\}\\\\\\left\\{-\\frac{1}{2},\\frac{27}{86},\\frac{1}{23}\\right\\}\\\\\\left\\{\\frac{11}{7},-\\frac{297}{301},\\frac{4312}{2693}\\right\\}\\end{matrix}\\\\\\hline\\text{per-weight ranks over six w2: \\{$\\mu$, dim V\\_$\\mu$, (a) point B, (b) $\\beta$=0, (c) resolvent y-star with $\\beta$, (c0) resolvent y-star $\\beta$=0\\}} & \\begin{matrix}\\left\\{\\left\\{0,1,3\\right\\},1,0,1,0,0\\right\\}\\\\\\left\\{\\left\\{0,2,2\\right\\},1,1,1,1,0\\right\\}\\\\\\left\\{\\left\\{0,3,1\\right\\},1,1,1,1,1\\right\\}\\\\\\left\\{\\left\\{1,0,3\\right\\},1,0,1,0,0\\right\\}\\\\\\left\\{\\left\\{1,1,2\\right\\},2,1,2,1,0\\right\\}\\\\\\left\\{\\left\\{1,2,1\\right\\},2,2,2,2,1\\right\\}\\\\\\left\\{\\left\\{1,3,0\\right\\},1,1,1,1,1\\right\\}\\\\\\left\\{\\left\\{2,0,2\\right\\},1,1,1,1,0\\right\\}\\\\\\left\\{\\left\\{2,1,1\\right\\},2,2,2,2,1\\right\\}\\\\\\left\\{\\left\\{2,2,0\\right\\},1,1,1,1,1\\right\\}\\\\\\left\\{\\left\\{3,0,1\\right\\},1,1,1,1,1\\right\\}\\\\\\left\\{\\left\\{3,1,0\\right\\},1,1,1,1,1\\rig… [latex truncated: 3262 chars total]",
