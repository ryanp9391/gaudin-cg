       "data": "Out[128]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{k} & \\text{free} & \\text{rotRank s1} & \\text{rotRank s2} & \\text{rank\\{s1,$\\Omega$1\\}} & \\text{rank\\{s2,$\\Omega$1\\}} & \\text{support}\\\\\\hline1 & 5 & 8 & 4 & 2 & 1 & \\left\\{\\text{1},\\text{T\\{1, 1\\}@-3},\\text{T\\{2, 2\\}@-3},\\text{T\\{3, 2\\}@-3},\\text{T\\{3, 3\\}@-3}\\right\\}\\\\\\hline2 & 4 & 8 & 4 & 2 & 1 & \\left\\{\\text{1},\\text{T\\{1, 1\\}@-3},\\text{T\\{2, 2\\}@-3},\\text{T\\{3, 2\\}@-3},\\text{T\\{3, 3\\}@-3}\\right\\}\\\\\\hline3 & 4 & 8 & 4 & 2 & 1 & \\left\\{\\text{1},\\text{T\\{1, 1\\}@-3},\\text{T\\{2, 2\\}@-3},\\text{T\\{3, 2\\}@-3},\\text{T\\{3, 3\\}@-3}\\right\\}\\\\\\hline4 & 4 & 8 & 4 & 2 & 1 & \\left\\{\\text{1},\\text{T\\{1, 1\\}@-3},\\text{T\\{2, 2\\}@-3},\\text{T\\{3, 2\\}@-3},\\text{T\\{3, 3\\}@-3}\\right\\}\\\\\\hline5 & 4 & 7 & 4 & 2 & 1 & \\left\\{\\text{1},\\text{T\\{1, 1\\}@-3},\\text{T\\{2, 2\\}@-3},\\text{T\\{3, 3\\}@-3}\\right\\}\\\\\\hline6 & 3 & 8 & 4 & 2 & 1 & \\left\\{\\text{1},\\text{T\\{1, 1\\}@-3},\\text{T\\{2, 2\\}@-3},\\text{T\\{3, 2\\}@-3},\\text{T\\{3, 3\\}@-3}\\right\\}\\\\\\hline7 & 3 & 8 & 4 & 2 & 1 & \\left\\{\\text{1},\\text{T\\{1, 1\\}@-3},\\text{T\\{2, 2\\}@-3},\\text{T\\{3, 2\\}@-3},\\text{T\\{3, 3\\}@-3}\\right\\}\\\\\\hline8 & 3 & 8 & 4 & 2 & 1 & \\left\\{\\text{1},\\text{T\\{1, 1\\}@-3},\\text{T\\{2, 2\\}@-3},\\text{T\\{3, … [latex truncated: 2646 chars total]",
