ss=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-15.7001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-16.9001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-18.1001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-19.3001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-20.5001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-21.7001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-22.9001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-24.1001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-25.3001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-26.5001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-27.7001em;\"><span class=\"pstrut\" style=\"height:14.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:12.35em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
