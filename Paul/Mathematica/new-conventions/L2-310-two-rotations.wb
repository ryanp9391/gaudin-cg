  {
   "kind": 2,
   "value": "(* second and third numeric points for the two product points: rebuild the vacuum and the nine T_λ(θ1-3h) with explicit (h, θ, z, w) (fresh definitions, no shared memo), redo the exact product locus, and for every nontrivial component return the torus invariant y of the site-2 factor, the rotRank of both factors, the c-vector, and the decomposition of the site-1 factor in span{e1 R D, e1 E12 R D} with R = Rrot(z,(w1,y)), D = ρdiag[1/(w2 - z)] (ratio β/α). Compare y with w2(θ12-h)/(θ12-3h) (point B) and w2(θ12-h)/(θ12-2h) (point A, the adjoint's y-star). *)\npipeline310[zz_, ww_, hh_, th_] := Module[{lax1x, lax2x, twR, mono2x, tqx, tL2x, cbrx, TL2x, Zdx, v0x, Ω1x, Ω2x, mats, β, Ac, cv, eqs, sol, out, solveVacX, DyX, decomp},\n  lax1x[s_, x_] := Table[KroneckerDelta[i, j] (x - th[[s]]) id1 + hh Ee[i, j], {i, 3}, {j, 3}];\n  lax2x[x_] := lax2x[x] = With[{L1 = lax1x[1, x], L2 = lax1x[2, x]}, Table[Sum[KroneckerProduct[L1[[i, k]], L2[[k, j]]], {k, 3}], {i, 3}, {j, 3}]];\n  twR[T_, M_] := Table[Sum[T[[i, l]] M[[l, j]], {l, 3}], {i, 3}, {j, 3}];\n  mono2x[M_][x_] := mono2x[M][x] = twR[lax2x[x], M];\n  tqx[mono_, a_, x_] := Sum[Sum[Signature[σ] Dot @@ Table[mono[x - (k - 1) hh][[σ[[k]], rows[[k]]]], {k, a}], {σ, Permutations[rows]}], {rows, Subsets[Range[3], {a}]}];\n  tL2x[a_, x_, M_] := tL2x[a, x, M] = tqx[mono2x[M], a, x];\n  cbrx[tf_, λ_, x_, idm_] := With[{lc = conj[λ], n = Max[λ]}, Sum[With[{as = Table[lc[[σ[[i]]]] + i - σ[[i]], {i, n}]}, If[Min[as] < 0 || Max[as] > 3, 0, Signature[σ] Dot @@ Table[If[as[[i]] == 0, idm, tf[as[[i]], x + (i - 1) hh]], {i, n}]]], {σ, Permutations[Range[n]]}]];\n  TL2x[λ_, x_, M_] := cbrx[tL2x[#1, #2, M] &, λ, x, id2];\n  Zdx = DiagonalMatrix[zz]; v0x = th[[1]] - Λ[[1]] hh;\n  Ω1x = Om1[zz, ww]; Ω2x = kron[Ω1x, Ω1x];\n  mats = Join[{Partition[Ω2x, d1]}, Table[Partition[Normal[Ω2x . TL2x[λ, v0x, Zdx]], d1], {λ, shapes}]];\n  β = Module[{b = {Ω1x}}, Do[If[MatrixRank[Append[b, row]] > Length[b], AppendTo[b, row/row[[Ordering[Abs[row], -1][[1]]]]]], {row, Flatten[mats, 1]}]; b];\n  Ac = Table[Transpose[Table[LinearSolve[Transpose[β], M[[i]]], {i, d1}]], {M, mats}];\n  cv = Array[cc, Length[mats]]; eqs = DeleteCases[Union[Flatten[Minors[Sum[cv[[k]] Ac[[k]], {k, Length[mats]}], 2]]], 0];\n  sol = Solve[eqs == 0, cv];\n  solveVacX[g_] := Module[{s}, s = Select[Solve[Thread[(Om1[zz, {-7/3, yv, 3/5}] . ρdiag[{d1v, d2v, 1}]) == sv g], {yv, d1v, d2v, sv}], (sv /. #) =!= 0 &]; If[s === {}, \"none\", yv /. s]];\n  DyX = Table[1/(ww[[2]] - zz[[i]]), {i, 3}];\n  decomp[f1_, y_] := Module[{u, v}, u = Normal[e1 . Rrot[zz, {ww[[1]], y, 1}] . ρdiag[DyX]]; v = Normal[e1 . Ee[1, 2] . Rrot[zz, {ww[[1]], y, 1}] . ρdiag[DyX]]; If[MatrixRank[{u, v, f1}] == 2, With[{ab = LinearSolve[Transpose[{u, v}], f1]}, \"β/α\" -> ab[[2]]/ab[[1]]], \"not in span\"]];\n  out = Table[Module[{c1 = cv /. s, free, M, rowi, colj, f1, f2, yy}, free = Variables[c1]; c1 = c1 /. Thread[free -> 1]; M = Sum[c1[[k]] mats[[k]], {k, Length[mats]}];\n     If[Union[Flatten[M]] === {0}, Nothing, rowi = First[FirstPosition[Total[Abs[M], {2}], _?(# != 0 &)]]; colj = First[FirstPosition[Total[Abs[M], {1}], _?(# != 0 &)]]; f1 = M[[All, colj]]; f2 = M[[rowi, All]];\n      If[MatrixRank[{f2, Ω1x}] == 1, Nothing, yy = solveVacX[f2]; {\"y(site2)\" -> yy, \"rotRank\" -> {rotRank[f1], rotRank[f2]}, \"site1 in span{e1RD, e1E12RD}\" -> If[ListQ[yy], decomp[f1, First[yy]], \"n/a\"], \"c\" -> c1[[1 ;; 9]]}]]], {s, sol}];\n  {\"site-2 span dim\" -> Length[β], \"y_B = w2(θ12-h)/(θ12-3h), y_A = w2(θ12-h)/(θ12-2h)\" -> {ww[[2]] (th[[1]] - th[[2]] - hh)/(th[[1]] - th[[2]] - 3 hh), ww[[2]] (th[[1]] - th[[2]] - hh)/(th[[1]] - th[[2]] - 2 hh)}, \"nontrivial points\" -> out}];\n{tP, runs} = AbsoluteTiming[{\"control P1\" -> pipeline310[zN, wN, hN, thN], \"h=1/3\" -> pipeline310[zN, wN, 1/3, thN], \"θ=(1/5,-4/9), z=(3/2,7/6,2/3), w'\" -> pipeline310[{3/2, 7/6, 2/3}, {7/4, -2/5, 9/7}, hN, {1/5, -4/9}]}];\nchecks[\"pipeline310 at three points\"] = runs;\nGrid[Join[Table[{r[[1]], Column[r[[2]]]}, {r, runs}], {{\"time (s)\", tP}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
