      {
       "data": "Out[837]= \\begin{array}{|c|c|}\\hline\\text{W\\_ij(th1, th1-h) vanishes (max rel)} & 9.265796600248059\\times 10^{-51}\\\\\\hline\\text{kappa j-independent} & 1.8567091579344335\\times 10^{-50}\\\\\\hline\\text{t3(th1) = 0 exactly} & \\mathrm{True}\\\\\\hline\\text{t2(th1) = kappa nu3(th1-h) t1(th1)} & 9.779674772765197\\times 10^{-51}\\\\\\hline\\text{t2(th1+h) = chi3 nu1(th1+h) nu2(th1)/kappa} & 9.779689669710126\\times 10^{-51}\\\\\\hline\\text{zero factors at th1+h: nu3(th1)=0, nu3(x-h)=0, nu3(x-2h) != 0, nu3(x) != 0} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{limits \\{x=th1: t1, t2\\}, \\{x=th1+h: t1, t2\\}} & \\begin{pmatrix}2.4517639437816538\\times 10^{-32} & 2.4517639437816538\\times 10^{-32}\\\\1.4264106749298535\\times 10^{-32} & 6.33\\times 10^{-35}\\end{pmatrix}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
