   "kind": 2,
   "value": "(* checks on the scan: (a) the trivial roots: c(0) = 0 for every curve (so Phi(0) = 0, not a product point); (b) P = {0,1}: Phi(c(y)) is rank 1 for ALL y because its support {T22,T32} is the localizing span (site-2 factor = Omega1 at generic y, so not a new product point); (c) y_B, y_A recovered where predicted, and Phi at those roots is rank 1 and nonzero *)\nu19c0zero = And @@ Table[Union[(u19res[P][\"cyx\"] /. ySym -> 0)] === {0}, {P, u19subsets}];\nu19loc01 = Module[{cy = u19res[{0, 1}][\"cyx\"], M, f2, rowi}, Table[M = Sum[(cy[[k]] /. ySym -> yv) allMats[[k]], {k, 9}]; rowi = First[FirstPosition[Total[Abs[M], {2}], _?(# != 0 &)]]; {MatrixRank[M], MatrixRank[{M[[rowi]], Ω1}]}, {yv, u19gen}]];\nu19atRoot = {Table[With[{cy = u19res[{0, 1, 2, 3}][\"cyx\"] /. ySym -> -63/43}, {MatrixRank[Sum[cy[[k]] allMats[[k]], {k, 9}]], cy/cy[[4]] === cP3[[1 ;; 9]]}], 1], With[{cy = u19res[{0, 1, 2}][\"cyx\"] /. ySym -> -63/8}, {MatrixRank[Sum[cy[[k]] allMats[[k]], {k, 9}]], cy[[{3, 5, 6, 8, 9}]]/cy[[8]] === cP2[[{3, 5, 6, 8, 9}]]/cP2[[8]]}]};\nchecks[\"u19: c(0)=0 for all 11 curves\"] = u19c0zero;\nchecks[\"u19: P={0,1}: {rank Phi, rank{site-2 row, Omega1}} at y = 2,-5/3,7/5\"] = u19loc01;\nchecks[\"u19: Phi at y_B (P={0..3}), y_A (P={0,1,2}): {rank, curve == product point}\"] = u19atRoot;\nchecks[\"u19: max in-span residual over the 11 subsets\"] = Max[u19res[#][\"res\"] & /@ u19subsets];\nchecks[\"u19: max Rationalize error of the curves\"] = Max[u19res[#][\"ratErr\"] & /@ u19subsets];\nGrid[Join[{{\"P\", \"in span? (res)\", \"support\", \"y-degrees\", \"y hitting B\", \"y hitting A\", \"rank Phi at y=2,-5/3,7/5\", \"nonzero y with Phi rank 1\"}}, Table[With[{r = u19res[P]}, {P, N[r[\"res\"], 2], r[\"support\"], r[\"yDegs\"], r[\"yB\"], r[\"yA\"], r[\"genRanks\"], If[r[\"rank1roots\"] === \"all y\", \"all y (localizing span)\", DeleteCases[r[\"rank1roots\"], 0]]}], {P, u19subsets}], {{\"c(0)=0 all curves\", u19c0zero, \"\", \"\", \"\", \"\", \"\", \"\"}, {\"P={0,1} localizing: {rank Phi, rank{row,Omega1}}\", u19loc01, \"\", \"\", \"\", \"\", \"\", \"\"}, {\"Phi at y_B, y_A\", u19atRoot, \"\", \"\", \"\", \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
