       "data": "Out[1020]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{P} & \\text{in span? (res)} & \\text{support} & \\text{y-degrees} & \\text{y hitting B} & \\text{y hitting A} & \\text{rank Phi at y=2,-5/3,7/5} & \\text{nonzero y with Phi rank 1}\\\\\\hline\\left\\{0,1\\right\\} & 8.525418370514713\\times 10^{-48} & \\left\\{\\text{T22},\\text{T32}\\right\\} & \\left\\{1,2\\right\\} & \\text{none} & \\text{none} & \\left\\{1,1,1\\right\\} & \\text{all y (localizing span)}\\\\\\hline\\left\\{0,2\\right\\} & 1.0506743508456234\\times 10^{-47} & \\left\\{\\text{T11},\\text{T22},\\text{T31}\\right\\} & \\left\\{2,4\\right\\} & \\text{none} & \\text{none} & \\left\\{2,2,2\\right\\} & \\{\\}\\\\\\hline\\left\\{0,3\\right\\} & 4.310049567125537\\times 10^{-47} & \\left\\{\\text{1},\\text{T21},\\text{T30}\\right\\} & \\left\\{3,6\\right\\} & \\text{none} & \\text{none} & \\left\\{2,2,2\\right\\} & \\{\\}\\\\\\hline\\left\\{1,2\\right\\} & 1.0294106050453306\\times 10^{-47} & \\left\\{\\text{T11},\\text{T21},\\text{T22}\\right\\} & \\left\\{2,4\\right\\} & \\text{none} & \\text{none} & \\left\\{2,2,2\\right\\} & \\{\\}\\\\\\hline\\left\\{1,3\\right\\} & 1.5044883811374512\\times 10^{-47} & \\left\\{\\text{1},\\text{T11},\\text{T20},\\text{T22}\\right\\} & \\left\\{2,6\\right\\} & \\text{none} & \\text{none} & \\left\\{2,2,2\\right\\} & \\{\\}\\\\\\hline… [latex truncated: 2994 chars total]",
