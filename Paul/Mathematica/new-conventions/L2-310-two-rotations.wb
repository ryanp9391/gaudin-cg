      {
       "data": "Out[488]= \\begin{array}{|c|c|}\\hline\\text{qdet exact} & \\mathrm{True}\\\\\\hline\\text{commutativity exact} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{time (s): t1, t2, t3 at v0 and shifts} & 0.132558\\\\\\hline\\text{nonzeros in t2(v0)} & 15831\\\\\\hline\\end{array}",
