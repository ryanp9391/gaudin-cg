   "kind": 2,
   "value": "(* result tables for section 13 *)\nu13wtRows = Table[{u13ranks[\"a\"][[k, 1]], u13ranks[\"a\"][[k, 2]], u13ranks[\"a\"][[k, 3]], u13ranks[\"b\"][[k, 3]], u13ranks[\"c\"][[k, 3]], u13ranks[\"c0\"][[k, 3]]}, {k, Length[u13wtList]}];\nGrid[{{\"β/α(w2), w2 = 7/3, -8/9, 4/27, 3, -1/2, 11/7\", Column[Table[{w2, u13ystar[w2], \"β/α\" /. u13beta[w2]}, {w2, u13w2s}]]}, {\"per-weight ranks over six w2: {μ, dim V_μ, (a) point B, (b) β=0, (c) resolvent y-star with β, (c0) resolvent y-star β=0}\", Column[u13wtRows]}, {\"identically vanishing basis indices (a)\", u13vanWts[\"a\"]}, {\"(b)\", u13vanWts[\"b\"]}, {\"(c)\", u13vanWts[\"c\"]}, {\"(c0)\", u13vanWts[\"c0\"]}, {\"HW rank fixed torus: six w2 (a,b,c; saturates at 6 rows), twelve random w2 (a, c0)\", {checks[\"u13 HW rank fixed torus (a, b, c)\"], checks[\"u13 HW rank fixed torus, 12 random w2 (a), (c0)\"]}}, {\"HW rank torus-completed (12 random (w2,D)): (a), (b), (c), (c0)\", {u13hwTor[\"a\"][[1]], u13hwTor[\"b\"][[1]], u13hwTor[\"c\"][[1]], u13hwTor[\"c0\"][[1]]}}, {\"per irrep {irrep, mult, rank}, (a) torus-completed\", Column[u13hwTor[\"a\"][[2, All, 1 ;; 3]]]}, {\"per irrep, (c0) torus-completed\", Column[u13hwTor[\"c0\"][[2, All, 1 ;; 3]]]}, {\"[4,2,2] and [3,3,2] reached by (a)?\", {u13hwTor[\"a\"][[2, 1, 3]] > 0, u13hwTor[\"a\"][[2, 2, 3]] > 0}}, {\"3x3 identity b'/(a'c') = (y-star - w2)/(y-star - z2)\", checks[\"u13 3x3 identity, fully symbolic z\"]}}, Frame -> All, Alignment -> Left]",
