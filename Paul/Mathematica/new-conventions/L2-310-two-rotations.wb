       "data": "Out[808]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{family} & \\text{in span?} & \\text{residual} & \\text{y-degree range} & \\text{c(y) on (1,T10,T11,T20,T21,T22,T30,T31,T32)} & \\text{y (nonzero) with c(y) || c\\_A} &  &  &  &  &  &  &  &  & \\\\\\hline\\text{(i) n=0..2, minus, W(3,4)} & \\text{in span} & 1.0294106050449432\\times 10^{-47} & 0 & 4 & 0 & 0 & \\frac{9800\\,\\mathrm{ySym}^4}{5031} & 0 & -\\frac{171500\\,\\mathrm{ySym}^3}{5031} & \\frac{12005000\\,\\mathrm{ySym}^2}{216333} & 0 & -\\frac{12005000\\,\\mathrm{ySym}^2}{135837} & \\frac{3361400000\\,\\mathrm{ySym}}{17522973} & -\\frac{63}{8}\\\\\\hline\\text{(i') n=0..2, minus, W(2,3)} & \\text{not in span} & 0.952 & 0 & 4 &  &  &  &  &  &  &  &  &  & \\\\\\hline\\text{(ii) n=1..3, minus, W(3,4)} & \\text{in span} & 3.065993622949266\\times 10^{-46} & 2 & 6 & 4\\,\\mathrm{ySym}^6 & -\\frac{1120\\,\\mathrm{ySym}^5}{129} & \\frac{9800\\,\\mathrm{ySym}^4}{1677} & \\frac{4900\\,\\mathrm{ySym}^4}{129} & -\\frac{171500\\,\\mathrm{ySym}^3}{5031} & \\frac{12005000\\,\\mathrm{ySym}^2}{648999} & 0 & 0 & 0 & \\text{none}\\\\\\hline\\text{(iii-b) n=0..3, x Q, W(3,4)} & \\text{in span} & 1.6762481063430332\\times 10^{-47} & 0 & 6 & 0 & 0 & \\frac{19600\\,\\mathrm{ySym}^5}{15093} & 0 & -\\frac{3… [latex truncated: 1476 chars total]",
