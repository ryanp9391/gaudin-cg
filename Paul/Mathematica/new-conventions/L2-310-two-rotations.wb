       "data": "Out[944]= \\begin{array}{|c|c|}\\hline\\text{shape} & \\text{tau\\_lambda(th1-3h), symbolic in h, t12 = th1-th2, chi3 (Wp[0,1] = 0)}\\\\\\hline\\left\\{1,0\\right\\} & \\frac{3\\,\\mathrm{hS}\\,\\mathrm{Wp}\\left(2,4\\right)\\,\\left(3\\,\\mathrm{hS}-t12S\\right)}{\\mathrm{Wp}\\left(3,4\\right)}\\\\\\hline\\left\\{1,1\\right\\} & \\frac{12\\,\\mathrm{hS}^2\\,\\mathrm{Wp}\\left(2,3\\right)\\,\\left(3\\,\\mathrm{hS}-t12S\\right)\\,\\left(4\\,\\mathrm{hS}-t12S\\right)}{\\mathrm{Wp}\\left(3,4\\right)}\\\\\\hline\\left\\{2,0\\right\\} & -\\frac{6\\,\\mathrm{hS}^2\\,\\left(\\mathrm{Wp}\\left(1,2\\right)\\,\\mathrm{Wp}\\left(3,4\\right)-\\mathrm{Wp}\\left(1,3\\right)\\,\\mathrm{Wp}\\left(2,4\\right)\\right)\\,\\left(2\\,\\mathrm{hS}-t12S\\right)\\,\\left(3\\,\\mathrm{hS}-t12S\\right)}{\\mathrm{Wp}\\left(2,3\\right)\\,\\mathrm{Wp}\\left(3,4\\right)}\\\\\\hline\\left\\{2,1\\right\\} & \\frac{24\\,\\mathrm{hS}^3\\,\\mathrm{Wp}\\left(1,3\\right)\\,\\left(2\\,\\mathrm{hS}-t12S\\right)\\,\\left(3\\,\\mathrm{hS}-t12S\\right)\\,\\left(4\\,\\mathrm{hS}-t12S\\right)}{\\mathrm{Wp}\\left(3,4\\right)}\\\\\\hline\\left\\{2,2\\right\\} & \\frac{72\\,\\mathrm{hS}^4\\,\\mathrm{Wp}\\left(1,2\\right)\\,\\left(2\\,\\mathrm{hS}-t12S\\right)\\,\\left(3\\,\\mathrm{hS}-t12S\\right)^2\\,\\left(4\\,\\mathrm{hS}-t12S\\right)}{\\mathrm{Wp}\\left(3,4\\right)}\\\\\\hline\\left\\{3,0\\right\\} … [latex truncated: 2521 chars total]",
