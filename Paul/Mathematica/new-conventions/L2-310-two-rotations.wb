   "value": "(* per-weight ranks of the undone site-1 covectors phi(w2_i) over the six w2: variant (a) actual point-B family (beta/alpha, resolvent Dy[w2]); (b) beta = 0 (rotation part only); (c) control, resolvent point = y-star (Dy[y-star]) with beta/alpha, (c0) the same with beta = 0. 'identically vanishing' = zero at all six sample points. *)\nu13wts = Table[Table[J0[k][p], {k, 3}], {p, ps[{Λ}]}];\nu13wtList = Union[u13wts];\nu13idx = Association[Table[μ -> Flatten[Position[u13wts, μ]], {μ, u13wtList}]];\nu13variant[tag_] := Table[Switch[tag, \"a\", u13phi[w2, u13bt[w2], w2], \"b\", u13phi[w2, 0, w2], \"c\", u13phi[w2, u13bt[w2], u13ystar[w2]], \"c0\", u13phi[w2, 0, u13ystar[w2]]], {w2, u13w2s}];\nu13Phi = Association[Table[t -> u13variant[t], {t, {\"a\", \"b\", \"c\", \"c0\"}}]];\nu13rankTab[t_] := Table[With[{M = u13Phi[t][[All, u13idx[μ]]]}, {μ, Length[u13idx[μ]], MatrixRank[M], Flatten[Position[Transpose[M], _?(Union[#] === {0} &)]] // Map[u13idx[μ][[#]] &]}], {μ, u13wtList}];\nu13ranks = Association[Table[t -> u13rankTab[t], {t, {\"a\", \"b\", \"c\", \"c0\"}}]];\nchecks[\"u13 per-weight ranks (a): all = dim V_mu\"] = And @@ (#[[2]] == #[[3]] & /@ u13ranks[\"a\"]);\nchecks[\"u13 per-weight ranks (b): all = dim V_mu\"] = And @@ (#[[2]] == #[[3]] & /@ u13ranks[\"b\"]);\nchecks[\"u13 total phi-span rank (a),(b),(c),(c0) out of 15\"] = Table[MatrixRank[u13Phi[t]], {t, {\"a\", \"b\", \"c\", \"c0\"}}];\nu13vanWts[t_] := Select[u13ranks[t], #[[4]] =!= {} &][[All, {1, 4}]];\nGrid[Join[{{\"weight μ\", \"dim V_μ\", \"rank (a) point B\", \"rank (b) beta=0\", \"rank (c) resolvent y-star, beta\", \"rank (c0) resolvent y-star, beta=0\"}}, Table[{u13ranks[\"a\"][[k, 1]], u13ranks[\"a\"][[k, 2]], u13ranks[\"a\"][[k, 3]], u13ranks[\"b\"][[k, 3]], u13ranks[\"c\"][[k, 3]], u13ranks[\"c0\"][[k, 3]]}, {k, Length[u13wtList]}], {{\"identically vanishing weight sectors / basis indices\", \"\", \"(a) \" <> ToString[u13vanWts[\"a\"]], \"(b) \" <> ToString[u13vanWts[\"b\"]], \"(c) \" <> ToString[u13vanWts[\"c\"]], \"(c0) \" <> ToString[u13vanWts[\"c0\"]]}, {\"total rank in V (15)\", \"\", Sequence @@ checks[\"u13 total phi-span rank (a),(b),(c),(c0) out of 15\"][[1 ;; 4]]}}], Frame -> All, Alignment -> Left]",
