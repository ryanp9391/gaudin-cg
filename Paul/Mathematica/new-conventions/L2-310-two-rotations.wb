      {
       "data": "Out[912]= \\begin{array}{|c|c|c|c|}\\hline\\text{shape} & \\text{t\\_a(v0+kh) used \\{a,k\\}} & \\text{ladder points n (Q at th1 - n h) used} & \\text{max rel |tau\\_dict - tau\\_basisT|}\\\\\\hline\\left\\{1,0\\right\\} & \\{\\} & \\left\\{2,3,4\\right\\} & 2.0283287949170876\\times 10^{-46}\\\\\\hline\\left\\{1,1\\right\\} & \\{\\} & \\left\\{2,3,4\\right\\} & 9.359965432363321\\times 10^{-48}\\\\\\hline\\left\\{2,0\\right\\} & \\begin{pmatrix}1 & 0\\\\1 & 1\\\\2 & 1\\end{pmatrix} & \\left\\{1,2,3,4\\right\\} & 1.188304376221425\\times 10^{-47}\\\\\\hline\\left\\{2,1\\right\\} & \\begin{pmatrix}1 & 1\\\\2 & 0\\end{pmatrix} & \\left\\{1,3,4\\right\\} & 8.33185271040048\\times 10^{-48}\\\\\\hline\\left\\{2,2\\right\\} & \\begin{pmatrix}1 & 0\\\\2 & 0\\\\2 & 1\\end{pmatrix} & \\left\\{1,2,3,4\\right\\} & 8.005103943668658\\times 10^{-48}\\\\\\hline\\left\\{3,0\\right\\} & \\begin{pmatrix}1 & 0\\\\1 & 1\\\\1 & 2\\\\2 & 1\\\\2 & 2\\end{pmatrix} & \\left\\{0,1,2,3,4\\right\\} & 6.1066769228251855\\times 10^{-47}\\\\\\hline\\left\\{3,1\\right\\} & \\begin{pmatrix}1 & 1\\\\1 & 2\\\\2 & 0\\\\2 & 2\\end{pmatrix} & \\left\\{0,1,2,3,4\\right\\} & 3.508326607424545\\times 10^{-46}\\\\\\hline\\left\\{3,2\\right\\} & \\begin{pmatrix}1 & 0\\\\1 & 2\\\\2 & 0\\\\2 & 1\\end{pmatrix} & \\left\\{0,1,2,3,4\\right\\} & 2.6913851985031067\\times 10^{-47}\\\\\\hline\\… [latex truncated: 1410 chars total]",
