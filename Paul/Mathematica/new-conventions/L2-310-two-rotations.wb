       "data": "Out[941]= \\begin{array}{|c|c|c|c|}\\hline\\text{w2} & \\text{y-star} & \\text{$\\beta$/$\\alpha$} & \\text{rotRank (site1, site2)}\\\\\\hline\\frac{7}{3} & -\\frac{63}{43} & \\frac{392}{2335} & \\left\\{5,4\\right\\}\\\\\\hline-\\frac{8}{9} & \\frac{24}{43} & \\frac{64}{731} & \\left\\{5,4\\right\\}\\\\\\hline\\frac{4}{27} & -\\frac{4}{43} & -\\frac{32}{2409} & \\left\\{5,4\\right\\}\\\\\\hline3 & -\\frac{81}{43} & \\frac{8}{77} & \\left\\{5,4\\right\\}\\\\\\hline-\\frac{1}{2} & \\frac{27}{86} & \\frac{1}{23} & \\left\\{5,4\\right\\}\\\\\\hline\\frac{11}{7} & -\\frac{297}{301} & \\frac{4312}{2693} & \\left\\{5,4\\right\\}\\\\\\hline\\text{time first call (s)} & 1.073049 &  & \\\\\\hline\\text{$\\beta$/$\\alpha$(7/3) = 392/2335?} & \\mathrm{True} &  & \\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
