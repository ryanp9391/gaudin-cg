       "data": "Out[1142]= \\begin{array}{|c|c|}\\hline\\text{(a) per-weight ranks over six w2: \\{$\\mu$, dim V\\_$\\mu$, HW-frame B, LW-frame B, HW-frame A, HW-frame A∪B\\}} & \\begin{matrix}\\left\\{\\left\\{0,1,3\\right\\},1,0,1,1,1\\right\\}\\\\\\left\\{\\left\\{0,2,2\\right\\},1,1,1,1,1\\right\\}\\\\\\left\\{\\left\\{0,3,1\\right\\},1,1,1,1,1\\right\\}\\\\\\left\\{\\left\\{1,0,3\\right\\},1,0,1,1,1\\right\\}\\\\\\left\\{\\left\\{1,1,2\\right\\},2,1,2,2,2\\right\\}\\\\\\left\\{\\left\\{1,2,1\\right\\},2,2,2,2,2\\right\\}\\\\\\left\\{\\left\\{1,3,0\\right\\},1,1,1,1,1\\right\\}\\\\\\left\\{\\left\\{2,0,2\\right\\},1,1,1,1,1\\right\\}\\\\\\left\\{\\left\\{2,1,1\\right\\},2,2,1,2,2\\right\\}\\\\\\left\\{\\left\\{2,2,0\\right\\},1,1,1,1,1\\right\\}\\\\\\left\\{\\left\\{3,0,1\\right\\},1,1,0,1,1\\right\\}\\\\\\left\\{\\left\\{3,1,0\\right\\},1,1,0,1,1\\right\\}\\end{matrix}\\\\\\hline\\text{(a') per irrep \\{$\\nu$, mult, HW wt, HW (dim,rank), LW wt, LW (dim,rank), HW det., LW det., HW or LW det., rank A at HW wt, rank A∪B at HW wt\\}} & \\begin{matrix}\\left\\{\\left\\{3,3,2\\right\\},1,\\left\\{0,2,2\\right\\},\\left\\{1,1\\right\\},\\left\\{2,2,0\\right\\},\\left\\{1,1\\right\\},\\text{yes},\\text{yes},\\text{yes},1,1\\right\\}\\\\\\left\\{\\left\\{4,2,2\\right\\},1,\\left\\{1,1,2\\right\\},\\left\\{2,1\\right\\},\\left\\{2,1,1\\right\\},\\left\\{2,1\\right\\},\\text{no},\\text{no},\\text{NO… [latex truncated: 2620 chars total]",
