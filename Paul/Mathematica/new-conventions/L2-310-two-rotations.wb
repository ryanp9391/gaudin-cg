       "data": "Out[896]= \\begin{array}{|c|c|}\\hline\\text{max |ratio/ratio1 - 1|} & 5.144960835312085\\times 10^{-45}\\\\\\hline\\text{constant} & 8.43402703626\\times 10^{-9}+2.24723846733\\times 10^{-8}\\,\\mathrm{i}\\\\\\hline\\text{det2 Wp-sum form agrees} & 2.1522734073863648\\times 10^{-48}\\\\\\hline\\text{controls y = -63/43, 2} & \\left\\{5.40,95.6\\right\\}\\\\\\hline\\end{array}",
