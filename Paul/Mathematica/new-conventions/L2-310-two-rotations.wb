      {
       "data": "Out[576]= \\begin{array}{|c|c|}\\hline\\text{t\\_a(u) interpolation time (s)} & 0.734058\\\\\\hline\\text{qdet symbolic exact} & \\mathrm{True}\\\\\\hline\\text{deg\\_u t\\_a} & \\left\\{2,4,6\\right\\}\\\\\\hline\\text{\\# states, eigensystem time (s), eigenvalue-polynomial time (s)} & \\left\\{225,0.091196,1.197222\\right\\}\\\\\\hline\\text{eigen-residual (60 digits)} & 7.206851360917656\\times 10^{-54}\\\\\\hline\\text{min sector gap (simple spectrum)} & 0.00639\\\\\\hline\\text{state 1 ($\\mu$ = \\{6, 2, 0\\}): deg q\\_i, deg q\\^{}j; time (s)} & \\left\\{\\begin{pmatrix}0 & 4 & 6\\\\6 & 2 & 0\\end{pmatrix},0.019218\\right\\}\\\\\\hline\\text{all 225 states: Q time (s)} & 3.405337\\\\\\hline\\text{\\# states with all six Q's} & 225\\\\\\hline\\text{deg q\\^{}j = $\\mu$\\_j / deg q\\_i = 6 - $\\mu$\\_i} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{max Baxter residual} & 1.4952878613440013\\times 10^{-43}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
