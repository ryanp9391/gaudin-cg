      {
       "data": "Out[520]= \\begin{array}{|c|c|c|c|}\\hline\\text{shape} & \\text{rank of <$\\Omega$|T\\_$\\lambda$ (15x15)} & \\text{$\\Omega$1 outside its site-2 span? (0 = inside)} & \\text{site-1 local}\\\\\\hline\\left\\{1,0\\right\\} & 2 & 0 & \\mathrm{False}\\\\\\hline\\left\\{1,1\\right\\} & 1 & 0 & \\mathrm{True}\\\\\\hline\\left\\{2,0\\right\\} & 2 & 0 & \\mathrm{False}\\\\\\hline\\left\\{2,1\\right\\} & 2 & 0 & \\mathrm{False}\\\\\\hline\\left\\{2,2\\right\\} & 1 & 0 & \\mathrm{True}\\\\\\hline\\left\\{3,0\\right\\} & 2 & 0 & \\mathrm{False}\\\\\\hline\\left\\{3,1\\right\\} & 2 & 0 & \\mathrm{False}\\\\\\hline\\left\\{3,2\\right\\} & 1 & 0 & \\mathrm{True}\\\\\\hline\\left\\{3,3\\right\\} & 0 & 1 & \\mathrm{False}\\\\\\hline\\text{localizing shapes} & \\begin{pmatrix}1 & 1\\\\2 & 2\\\\3 & 2\\end{pmatrix} &  & \\\\\\hline\\text{joint site-2 span dim ($\\Omega$1 + all shapes)} & 2 &  & \\\\\\hline\\text{dim($\\Omega$1 + span of each non-local shape)} & \\begin{pmatrix}\\left\\{1,0\\right\\} & 2\\\\\\left\\{2,0\\right\\} & 2\\\\\\left\\{2,1\\right\\} & 2\\\\\\left\\{3,0\\right\\} & 2\\\\\\left\\{3,1\\right\\} & 2\\\\\\left\\{3,3\\right\\} & 1\\end{pmatrix} &  & \\\\\\hline\\text{T time (s)} & 0.522503 &  & \\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
