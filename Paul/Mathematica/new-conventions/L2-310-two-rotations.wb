  {
   "kind": 2,
   "value": "(* (c) the two points where the Cramer denominator or a coefficient degenerates.\n x = th1 (nu3(x) = 0, nu2(x-h) = prod_s (x - th_s) = 0, hence t3(th1) = 0): the three dual Q-vectors satisfy W_ij(th1, th1-h) = 0 for all pairs, i.e. Q(th1) = kappa Q(th1-h); the dual Baxter equation reduces to the single relation t2(th1) = kappa nu3(th1-h) t1(th1) (nu3(x-2h) cancels); t1, t2 separately only as limits of the Cramer formulas (symmetric difference, eps = 10^-18).\n x = th1 + h (nu3(x-h) = nu3(th1) = 0, so B = A = 0 and t1 drops out of the equation): t2(th1+h) = chi3 nu1(th1+h) nu2(th1) Q^j(th1-h)/Q^j(th1) for any j; t1(th1+h) only as a limit. *)\nu18kap[B_, j_] := QU[B, j, th1]/QU[B, j, th1 - hN];\nu18rel = sizeQ[Max[Table[Max[Abs[Table[u18Wd[B, i, j, th1, th1 - hN], {i, 1, 3}, {j, i + 1, 3}]]]/Max[Abs[Table[QU[B, i, th1] QU[B, j, th1 - hN], {i, 1, 3}, {j, i + 1, 3}]]], {B, nSt}]]];\nchecks[\"u18(c) x=th1: max rel W_ij(th1, th1-h) over pairs and states\"] = u18rel;\nchecks[\"u18(c) x=th1: kappa independent of j (max rel spread)\"] = sizeQ[Max[Table[Abs[u18kap[B, 2]/u18kap[B, 1] - 1] + Abs[u18kap[B, 3]/u18kap[B, 1] - 1], {B, nSt}]]];\nchecks[\"u18(c) x=th1: t3(th1) = 0 exactly\"] = (u18t3[th1] == 0);\nchecks[\"u18(c) x=th1: t2(th1) = kappa nu3(th1-h) t1(th1) (max rel residual)\"] = sizeQ[Max[Table[Abs[u18tTrue[B, 2, th1] - u18kap[B, 2] nuP[3][th1 - hN] u18tTrue[B, 1, th1]]/Abs[u18tTrue[B, 2, th1]], {B, nSt}]]];\nchecks[\"u18(c) x=th1+h: t2(th1+h) = chi3 nu1(th1+h) nu2(th1)/kappa (max rel residual; j = 1,2,3)\"] = sizeQ[Max[Table[Abs[u18tTrue[B, 2, th1 + hN] - u18t3[th1 + hN]/nuP[3][th1 - hN]/u18kap[B, j]]/Abs[u18tTrue[B, 2, th1 + hN]], {B, nSt}, {j, 3}]]];\nchecks[\"u18(c) x=th1+h: zero factors\"] = {nuP[3][th1] == 0, nuP[3][th1 + hN - hN] == 0, nuP[3][th1 + hN - 2 hN] =!= 0, nuP[3][th1 + hN] =!= 0};\nu18eps = 10^-18;\nu18lim[f_, x0_] := (f[x0 + u18eps] + f[x0 - u18eps])/2;\nchecks[\"u18(c) limits: t1(th1), t2(th1), t1(th1+h) via symmetric difference of the Cramer formulas (max rel residual, 225 states)\"] = Table[sizeQ[Max[Table[With[{tr = u18tTrue[B, a, x0]}, Abs[u18lim[If[a == 1, u18t1[B, #, {2, 3}] &, u18t2[B, #, {2, 3}] &], x0] - tr]/Abs[tr]], {B, nSt}]]], {x0, {th1, th1 + hN}}, {a, {1, 2}}];\nGrid[{{\"W_ij(th1, th1-h) vanishes (max rel)\", u18rel}, {\"kappa j-independent\", checks[\"u18(c) x=th1: kappa independent of j (max rel spread)\"]}, {\"t3(th1) = 0 exactly\", checks[\"u18(c) x=th1: t3(th1) = 0 exactly\"]}, {\"t2(th1) = kappa nu3(th1-h) t1(th1)\", checks[\"u18(c) x=th1: t2(th1) = kappa nu3(th1-h) t1(th1) (max rel residual)\"]}, {\"t2(th1+h) = chi3 nu1(th1+h) nu2(th1)/kappa\", checks[\"u18(c) x=th1+h: t2(th1+h) = chi3 nu1(th1+h) nu2(th1)/kappa (max rel residual; j = 1,2,3)\"]}, {\"zero factors at th1+h: nu3(th1)=0, nu3(x-h)=0, nu3(x-2h) != 0, nu3(x) != 0\", checks[\"u18(c) x=th1+h: zero factors\"]}, {\"limits {x=th1: t1, t2}, {x=th1+h: t1, t2}\", checks[\"u18(c) limits: t1(th1), t2(th1), t1(th1+h) via symmetric difference of the Cramer formulas (max rel residual, 225 states)\"]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"607004\" data-output-id=\"149\" data-out-n=\"837\" data-sub-idx=\"12\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"53\" data-sub-start=\"14\" data-sub-end=\"14\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[837]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.64em;vertical-align:-4.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.09em;\"><span style=\"top:-7.05em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:9.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.66em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">W_ij(th1, th1-h) vanishes (max rel)</span></span></span></span><span style=\"top:-6.46em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">kappa j-independent</span></span></span></span><span style=\"top:-5.26em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">t3(th1) = 0 exactly</span></span></span></span><span style=\"top:-4.06em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">t2(th1) = kappa nu3(th1-h) t1(th1)</span></span></span></span><span style=\"top:-2.86em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">t2(th1+h) = chi3 nu1(th1+h) nu2(th1)/kappa</span></span></span></span><span style=\"top:-1.66em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">zero factors at th1+h: nu3(th1)=0, nu3(x-h)=0, nu3(x-2h) != 0, nu3(x) != 0</span></span></span></span><span style=\"top:0.15em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">limits {x=th1: t1, t2}, {x=th1+h: t1, t2}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:9.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.66em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">9.265796600248059</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\