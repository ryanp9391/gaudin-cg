      {
       "data": "Out[816]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{point} & \\text{\\# A found} & \\text{other 4 entries zero} & \\text{c\\_A[5 shapes] $\\|$ F(h,t12,yA)} & \\text{exactly equal after T20-normalization}\\\\\\hline\\text{P1} & 1 & \\mathrm{True} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{h=1/3} & 1 & \\mathrm{True} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{theta=(1/5,-4/9), z', w'} & 1 & \\mathrm{True} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{entrywise ratio curve/F at P1 (constants = scale)} & \\left\\{\\frac{840350000}{5840991},\\frac{840350000}{5840991},\\frac{840350000}{5840991},\\frac{840350000}{5840991},\\frac{840350000}{5840991}\\right\\} &  &  & \\\\\\hline\\end{array}",
