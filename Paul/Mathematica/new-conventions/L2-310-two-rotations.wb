      {
       "data": "Out[1005]= \\begin{array}{|c|c|}\\hline\\text{time (s) for one subset} & 0.090672\\\\\\hline\\text{agreement with cell 19} & 5.254258524305324\\times 10^{-45}\\\\\\hline\\end{array}",
