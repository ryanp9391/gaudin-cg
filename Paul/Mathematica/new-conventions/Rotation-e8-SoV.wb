      {
       "data": "Out[1449]= \\begin{pmatrix}\\left\\{3,\\left\\{2.25,1.5,1.\\,\\right\\},\\begin{pmatrix}0 & 2 & 1\\\\0 & 1 & 2\\end{pmatrix}\\right\\} & 18\\\\\\left\\{3,\\left\\{1.5625,1.25,1.\\,\\right\\},\\begin{pmatrix}2 & 0 & 1\\\\1 & 0 & 2\\end{pmatrix}\\right\\} & 18\\\\\\left\\{3,\\left\\{0.444444,0.666667,1.\\,\\right\\},\\begin{pmatrix}2 & 1 & 0\\\\1 & 2 & 0\\end{pmatrix}\\right\\} & 18\\\\\\left\\{1,\\mathrm{None},\\mathrm{None}\\right\\} & 18\\end{pmatrix}",
