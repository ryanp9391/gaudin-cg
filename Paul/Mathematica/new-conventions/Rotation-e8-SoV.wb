      {
       "data": "Out[1687]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{10: $\\Omega$v[w] $\\propto$ w-vacuum bra (braW)}\\to 0 \\\\\n  &,\\text{10: <x0|M(y) = $\\Omega$\\_y}\\to 0 \\\\\n  &,\\text{10: [M(w), M(y)] = 0}\\to 0.\\times 10^{-56} \\\\\n  &,\\text{10: y = $\\sigma$(z): rank 1} \\\\\n  &\\to 6.746031860385682369252151120663668540519878636114288541 \\\\\n  &\\times 10^{-59},\\text{10: y = $\\sigma$(z): $\\propto$ $\\Omega$\\_\\{$\\sigma$ z\\}} \\\\\n  &\\to 0,\\text{10: random y: min defect (nonzero)} \\\\\n  &\\to 0.006286366893176104097343902511191153855426360602843243196 \\\\\n  &,\\text{10: y = w: defect} \\\\\n  &\\to 0.001686179523135247891172690761{\\color{gray}\\vdots} \\\\\n  &{\\color{gray}\\vdots}7892529645141868566791167407\\rvert\\!\\rangle\n\\end{aligned}",
