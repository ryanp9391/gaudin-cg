      {
       "data": "Out[1367]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{quadrics on generic orbit points (nonzero)} \\\\\n  &\\to 0.003921005210492652269555322771076558260252926762806 \\\\\n  &,\\text{quadrics on (I): b on moment curve} \\\\\n  &\\to 0.\\times 10^{-49} \\\\\n  &,\\text{quadrics on (II): a $\\perp$ (1,z1,z1\\^{}2)} \\\\\n  &\\to 0.\\times 10^{-49},\\text{random a: all solutions on (I)} \\\\\n  &\\to 0.\\times 10^{-40}\\rvert\\!\\rangle\n\\end{aligned}",
       "mime": "text/plain"
      }
