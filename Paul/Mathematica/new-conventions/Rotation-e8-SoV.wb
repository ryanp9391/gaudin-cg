      {
       "data": "Out[1612]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{6c: e1 $\\in$ span\\{1, t1 coeffs\\}}\\to 0 \\\\\n  &,\\text{6c: e2 $\\in$ span\\{1, t1, t2 coeffs\\}} \\\\\n  &\\to 0.030030989306030389926606834431271176605461651570604819509 \\\\\n  &,\\text{6c: e3 $\\in$ span\\{1, t1, t2 coeffs\\}} \\\\\n  &\\to 0.095399993516647517534622339507244693702250834767182141593 \\\\\n  &,\\text{6c: dim span\\{1, e1, t2 coeffs, e1\\^{}2\\} (5 < 8)}\\to 5 \\\\\n  &,\\text{6c: e2 $\\in$ span\\{1, e1, t2 coeffs, e1\\^{}2\\}}\\to 0 \\\\\n  &,\\text{6c: e3 vs single T\\_$\\lambda$($\\theta$+kh): best residual (nonzero)} \\\\\n  &\\to 0.181392905178331914493231617132{\\color{gray}\\vdots} \\\\\n  &{\\color{gray}\\vdots}532108780078204563581513646\\rvert\\!\\rangle\n\\end{aligned}",
