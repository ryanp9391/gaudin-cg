      {
       "data": "Out[1626]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{8: e1\\^{}T O\\_mu = <x\\_mu|} \\\\\n  &\\to 1.3258050586788090632169997336831304522675931601728313695807 \\\\\n  &\\times 10^{-78},\\text{8: $\\Omega$ is rank 1 (on the e8 orbit)} \\\\\n  &\\to 2.5017661350119634296267677020105428356519735746933427546389 \\\\\n  &\\times 10^{-76} \\\\\n  &,\\text{8: <$\\Omega$ O\\_mu|Psi\\_B> = o\\_mu(B) <$\\Omega$|Psi\\_B>} \\\\\n  &\\to 0.\\times 10^{-56},\\text{8: rank of \\{$\\Omega$ O\\_mu\\}}\\to 8 \\\\\n  &,\\text{8: smallest |$\\Omega$.Psi\\_B| (not a zero test)} \\\\\n  &\\to 0.018021380099349456387905952915{\\color{gray}\\vdots} \\\\\n  &{\\color{gray}\\vdots}0071353005826439978030036183\\rvert\\!\\rangle\n\\end{aligned}",
