      {
       "data": "Out[1772]= \\begin{aligned}\n  &\\left\\{\\left\\{\\left\\{\\left\\{2\\right\\},\\left\\{2,1\\right\\}\\right\\}\\to 1,\\left\\{\\left\\{2\\right\\},\\left\\{1,1\\right\\}\\right\\}\\to \\frac{s1}{h} \\right. \\right. \\\\\n  &\\left. \\left. ,\\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\}\\right\\}\\to \\frac{s1^2}{2\\,h^2},\\left\\{\\left\\{2\\right\\},\\left\\{2,0\\right\\}\\right\\}\\to 0 \\right. \\right. \\\\\n  &\\left. \\left. ,\\left\\{\\left\\{2\\right\\},\\left\\{1,0\\right\\}\\right\\}\\to \\frac{s1^2}{2\\,h^2},\\left\\{\\left\\{2\\right\\},\\left\\{0,0\\right\\}\\right\\}\\to 0 \\right. \\right. \\\\\n  &\\left. \\left. ,\\left\\{\\left\\{1\\right\\},\\left\\{1,0\\right\\}\\right\\}\\to \\frac{s1^3}{3\\,h^3},\\left\\{\\left\\{1\\right\\},\\left\\{0,0\\right\\}\\right\\}\\to 0\\right\\},\\langle\\! \\right. \\\\\n  &\\left. \\lvert \\text{10c: c(y) free of z}\\to \\mathrm{True},\\text{10c: resolvent identity, z and z', several s} \\right. \\\\\n  &\\left. \\to 2.0710007128769559\\times 10^{-60}\\rvert\\!\\rangle \\right\\}\n\\end{aligned}",
