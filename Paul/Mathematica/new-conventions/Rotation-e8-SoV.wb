     ],
     "id": "86c6acea-c538-4a03-9b32-18fbee2c482b"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* B, C and the SoV bases, verbatim from the clean notebook *)\nQMu = qminor[T];\nBop[u_] = T[1, 1][u] . QMu[{1, 2}, {1, 2}][u + h] + T[2, 1][u] . QMu[{1, 2}, {1, 3}][u + h];\nCop[u_] = T[1, 1][u] . QMu[{1, 2}, {1, 2}][u] + T[2, 1][u] . QMu[{1, 2}, {1, 3}][u];\ngtpats = {{{2}, {2, 1}}, {{2}, {1, 1}}, {{1}, {1, 1}}, {{2}, {2, 0}}, {{2}, {1, 0}}, {{2}, {0, 0}}, {{1}, {1, 0}}, {{1}, {0, 0}}};\nx0pat = {{2}, {2, 1}}; ylowpat = {{1}, {0, 0}};\nxm2 = θ - 2 h;\nxB[{{2}, {2, 1}}] = {UnitVector[8, 1]};\nxB[{{2}, {1, 1}}] = xB[{{2}, {2, 1}}] . tF[{1, 0}, xm2];\nxB[{{1}, {1, 1}}] = xB[{{2}, {2, 1}}] . tF[{1, 1}, xm2];\nxB[{{2}, {2, 0}}] = xB[{{2}, {2, 1}}] . tF[{2, 0}, xm2] . Inverse[tF[{1, 0}, xm2]];\nxB[{{2}, {1, 0}}] = xB[{{2}, {2, 0}}] . tF[{1, 0}, xm2];\nxB[{{2}, {0, 0}}] = xB[{{2}, {2, 0}}] . tF[{2, 0}, xm2];\nxB[{{1}, {1, 0}}] = xB[{{2}, {2, 0}}] . tF[{1, 1}, xm2];\nxB[{{1}, {0, 0}}] = xB[{{2}, {2, 0}}] . tF[{2, 1}, xm2];\ntS[{1, 0}, v_] := tF[{1, 0}, v]; tS[{1, 1}, v_] := tF[{1, 1}, v + h]; tS[{2, 0}, v_] := tF[{2, 0}, v - h];\ntS[{2, 1}, v_] := tGt[zs, 2, v + h] . tGt[zs, 1, v - h] - tGt[zs, 3, v + h];\nyB[{{1}, {0, 0}}] = Transpose[{UnitVector[8, 8]}];\nyB[{{2}, {0, 0}}] = Simplify[tS[{2, 0}, θ] . Inverse[tF[{1, 0}, θ]] . yB[{{1}, {0, 0}}]];\nyB[{{1}, {1, 0}}] = tS[{1, 0}, θ] . yB[{{1}, {0, 0}}];\nyB[{{2}, {1, 0}}] = tS[{1, 0}, θ] . yB[{{2}, {0, 0}}];\nyB[{{2}, {2, 0}}] = tS[{2, 0}, θ] . yB[{{2}, {0, 0}}];\nyB[{{1}, {1, 1}}] = tS[{1, 1}, θ] . yB[{{1}, {0, 0}}];\nyB[{{2}, {1, 1}}] = tS[{1, 1}, θ] . yB[{{2}, {0, 0}}];\nyB[{{2}, {2, 1}}] = tS[{2, 1}, θ] . yB[{{2}, {0, 0}}];\nchecks[\"<x_mu| are B eigencovectors\"] = Union[Flatten[Simplify[Table[xB[μ] . Bop[u] - xB[μ] (u - θ + h μ[[1, 1]] + h) (u - θ + h μ[[2, 1]]) (u - θ + h μ[[2, 2]]), {μ, gtpats}]]]] === {0};\nchecks[\"|y_mu> are C eigenvectors\"] = Union[Flatten[Simplify[Table[Cop[u] . yB[μ] - yB[μ] (u - θ + h μ[[1, 1]]) (u - θ + h μ[[2, 1]]) (u - θ + h μ[[2, 2]] - h), {μ, gtpats}]]]] === {0};\ngramXY = Table[Simplify[(xB[a1] . yB[a2])[[1, 1]]], {a1, gtpats}, {a2, gtpats}];\nchecks",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"485294\" data-output-id=\"90\" data-out-n=\"1276\" data-sub-idx=\"28\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"3\" data-sub-start=\"28\" data-sub-end=\"28\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1276]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.5em;vertical-align:-2em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.5em;\"><span style=\"top:-4.5em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span><span style=\"top:-1.5em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.5em;\"><span style=\"top:-4.66em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mopen\">⟨</span><span class=\"mspace\" style=\"margin-right:-0.1667em;\"></span><span class=\"mopen\">∣</span><span class=\"mord text\"><span class=\"mord\">qdet t3 = </span><span class=\"mord mathnormal\">χ</span><span class=\"mord\">3 </span><span class=\"mord mathnormal\" style=\"margin-right:0.06366em;\">ν</span><span class=\"mord\">1(u)</span><span class=\"mord mathnormal\" style=\"margin-right:0.06366em;\">ν</span><span class=\"mord\">2(u-h)</span><span class=\"mord mathnormal\" style=\"margin-right:0.06366em;\">ν</span><span class=\"mord\">3(u-2h)</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-3.16em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord\">&lt;x_mu| are B eigencovectors</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-1.66em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord\">|y_mu&gt; are C eigenvectors</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mclose\">∣</span><span class=\"mspace\" style=\"margin-right:-0.1667em;\"></span><span class=\"mclose\">⟩</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[1276]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{qdet t3 = $\\chi$3 $\\nu$1(u)$\\nu$2(u-h)$\\nu$3(u-2h)}\\to \\mathrm{True} \\\\\n  &,\\text{<x\\_mu| are B eigencovectors}\\to \\mathrm{True} \\\\\n  &,\\text{|y\\_mu> are C eigenvectors}\\to \\mathrm{True}\\rvert\\!\\rangle\n\\end{aligned}",
       "mime": "text/plain"
      }
     ],
     "id": "2c4bb4cf-902e-45be-ba82-bf245a0413aa"
