      {
       "data": "Out[1344]= \\begin{aligned}\n  &\\left\\{0 \\right. \\\\\n  &\\left. ,\\begin{array}{|c|c|}\\hline\\left\\{2,1,0\\right\\} & \\left\\{7.6070476166629107507258614394128193176057868886016127328606,0,0\\right\\}\\\\\\hline\\left\\{1,2,0\\right\\} & \\left\\{7.7084199563339960748616939335730345060392610432203336960944,0,0\\right\\}\\\\\\hline\\left\\{0,2,1\\right\\} & \\left\\{14.293921969719860592330886750808025145608429432015391130120,0,0\\right\\}\\\\\\hline\\left\\{1,1,1\\right\\} & \\left\\{14.085105349547607189211097898508214643711675858946556372334,0.0014895602149282842099107808941313125738879261220547453580534,0.00047237512470291040173329075238520022213319382413393999188914\\right\\}\\\\\\hline\\left\\{2,0,1\\right\\} & \\left\\{13.883438745764948539477359185746847275867351216527760674260,0,0\\right\\}\\\\\\hline\\left\\{0,1,2\\right\\} & \\left\\{43.920311371307452164386763958563995628181500672797592068899,0,0\\right\\}\\\\\\hline\\left\\{1,0,2\\right\\} & \\left\\{43.227516399381916087204408397504933090917912325166045166128,0,0\\right\\}\\\\\\hline\\left\\{1,1,1\\right\\} & \\left\\{18.3594011227566850388869849929526268898813478015295349534,1.24247604062483533523746339203096717396497208694481758190,0.562867957015054021405701453361425220517611234913469324694\\right\\}\\\\\\hline\\end{a… [latex truncated: 1227 chars total]",
