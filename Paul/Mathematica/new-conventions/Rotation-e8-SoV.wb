      {
       "data": "Out[1405]= \\begin{aligned}\n  &\\left\\{\\begin{pmatrix}0 & 2 & 1\\\\0 & 2 & 1\\\\0 & 2 & 1\\end{pmatrix},\\langle\\! \\right. \\\\\n  &\\left. \\lvert \\text{(I): a $\\propto$ (1, -($\\beta$+$\\gamma$), $\\beta$$\\gamma$)}\\to 0.\\times 10^{-59},\\text{(I): eigen-bra of t(G($\\alpha$,$\\beta$,$\\gamma$)), any $\\alpha$}\\to 0,\\text{(I): det N with Q's of ($\\alpha$,$\\beta$,$\\gamma$) reproduces it, any $\\alpha$}\\to 0 \\right. \\\\\n  &\\left. ,\\text{(II): kills the mu=(2,1,0),(1,2,0) kets}\\to 0.\\times 10^{-59},\\text{(II): smallest other overlap (not a zero test)} \\right. \\\\\n  &\\left. \\to 0.042204135550224150287607353253 \\right.{\\color{gray}\\vdots} \\\\\n  &\\left. {\\color{gray}\\vdots}65774867523967409017066477448\\rvert\\!\\rangle \\right\\}\n\\end{aligned}",
