       "data": "Out[1653]= \\begin{array}{|c|c|}\\hline\\text{check} & \\text{value}\\\\\\hline\\text{qdet t3 = $\\chi$3 $\\nu$1(u)$\\nu$2(u-h)$\\nu$3(u-2h)} & \\mathrm{True}\\\\\\hline\\text{<x\\_mu| are B eigencovectors} & \\mathrm{True}\\\\\\hline\\text{|y\\_mu> are C eigenvectors} & \\mathrm{True}\\\\\\hline\\text{raising E\\_ij (i<j) kill e8\\^{}T} & \\mathrm{True}\\\\\\hline\\text{<x\\_mu| free of z and $\\theta$} & \\mathrm{True}\\\\\\hline\\text{sum\\_mu c\\_mu <x\\_mu| = e8\\^{}T rho(n\\_-)} & \\mathrm{True}\\\\\\hline\\text{intertwiner unique up to scale} & \\mathrm{True}\\\\\\hline\\text{X(e8\\^{}T) = e13} & \\mathrm{True}\\\\\\hline\\text{X(e8\\^{}T rho(n\\_-)) = a b\\^{}T, b.a = 0} & \\mathrm{True}\\\\\\hline\\text{X(sum c(a,b) <x|) = a b\\^{}T when b.a = 0} & \\mathrm{True}\\\\\\hline\\text{c(a,b) reproduces c\\_mu(n\\_-)} & \\mathrm{True}\\\\\\hline\\text{full GL(3): X(e8\\^{}T rho(g)) $\\propto$ g\\^{}-1 e13 g} & \\text{0.}\\times 10^{\\text{-49}}\\\\\\hline\\text{full GL(3): c = s c(a,b) with a = g\\^{}-1 e1, b = e3\\^{}T g} & \\text{0.}\\times 10^{\\text{-50}}\\\\\\hline\\text{full GL(3): rank X = 1 (2nd singular value)} & \\text{0}\\\\\\hline\\text{all Q's found} & \\mathrm{True}\\\\\\hline\\text{det N[Q\\_z, Q\\_w,A] gives the w eigen-bra A (all 8)} & \\text{0}\\\\\\hline\\text{rank of F -> $\\varphi$\\_F (6)… [latex truncated: 6457 chars total]",
