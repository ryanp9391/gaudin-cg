      {
       "data": "Out[1764]= \\begin{aligned}\n  &\\left\\{\\begin{pmatrix}3.80364-1.23118\\,\\mathrm{i} & 0.965510+0.413276\\,\\mathrm{i} & -0.236081-0.0805096\\,\\mathrm{i}\\\\-0.589109+0.13012\\,\\mathrm{i} & 1.29401-0.770716\\,\\mathrm{i} & 5.68752-3.18063\\,\\mathrm{i}\\\\0.19724-1.44034\\,\\mathrm{i} & 0.289017+0.683211\\,\\mathrm{i} & 1.67444+1.56922\\,\\mathrm{i}\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\langle\\! \\right. \\\\\n  &\\left. \\lvert \\text{10b: (p,q,r) -> coords rank 3}\\to 3,\\text{10b: (w1,w2,y1) -> coords rank (3 = generic)}\\to 3,\\text{10b: (w1,w2) only -> coords rank (2)} \\right. \\\\\n  &\\left. \\to 2,\\text{10b: random raising exponentials reached (max residual)}\\to 0 \\right. \\\\\n  &\\left. ,\\text{10b: reached covector $\\propto$ target (projective distance)} \\right. \\\\\n  &\\left. \\to 0\\rvert\\!\\rangle \\right\\}\n\\end{aligned}",
