  {
   "kind": 2,
   "value": "KeyDropFrom[checks, {\"6c: e3 ∈ span{1, t1, t2 coeffs} (expect no)\", \"6c: rank of span{1, all T_λ coeffs} (8 = all diagonal ops)\", \"6c: e3 ∈ span{1, all T_λ coeffs, λ ⊆ 3x3}\", \"6c: rank of span{1, all T_λ coeffs}\"}];\nt2c = Select[coefVecs[{{1, 1, 0}}], Norm[#] > 10^-30 &]; e1v = eVec[[2]]; one = eVec[[1]];\n(* e2 is quadratic in the t's: it lies in a 5-dim subspace of the 8-dim diagonal algebra *)\nchecks[\"6c: dim span{1, e1, t2 coeffs, e1^2} (5 < 8)\"] = MatrixRank[Join[{one, e1v}, t2c, {e1v^2}], Tolerance -> 10^-30];\nchecks[\"6c: e2 ∈ span{1, e1, t2 coeffs, e1^2}\"] = inSpan[eVec[[3]], Join[{one, e1v}, t2c, {e1v^2}]];\n(* e3 = prod z_i^mu_i: not a single fused T_λ at θ + k h *)\npropTo[v_, w_] := If[Norm[w] < 10^-30, Infinity, Norm[w - (w . v/(v . v)) v]/Norm[w]];\nchecks[\"6c: e3 vs single T_λ(θ+kh): best residual (nonzero)\"] = Min[Flatten[Table[propTo[eVec[[4]], Table[cbrT[SZ[\"vals\"][[B]], lam, thN + k hN], {B, nS}]], {lam, lamList}, {k, -4, 3}]]];\nKeyTake[checks, Select[Keys[checks], StringStartsQ[#, \"6c: e\"] || StringStartsQ[#, \"6c: dim\"] &]]",
   "languageId": "wolfram",
   "outputs": [
