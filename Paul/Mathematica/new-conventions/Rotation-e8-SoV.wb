  {
   "kind": 2,
   "value": "(* the y2 = ∞ line (s2 = 0): M(y1, ∞) ∝ ρ((y1 - G(z)^T)^-1), the resolvent of the ket twist *)\nMs0[sv1_] := (((Ωs /. {s1 -> sv1, s2 -> 0}) . Inverse[XmatN]) . Olist);\nresolv[y1_] := ρG[Inverse[y1 IdentityMatrix[3] - Transpose[Gz]]];\nresCheck = Table[Module[{M = Ms0[1/y1], R = resolv[y1], k}, k = (Flatten[M] . Conjugate[Flatten[R]])/(Flatten[R] . Conjugate[Flatten[R]]); Max[Abs[Flatten[M - k R]]]/Max[Abs[Flatten[M]]]], {y1, {3, -10/7, 5/6, 2 + I}}];\nchecks[\"10: M(y1, ∞) ∝ ρ((y1 - G(z)^T)^-1) (operator identity)\"] = Max[resCheck];\nSeedRandom[61];\nrandRot := Module[{b = RandomComplex[{-1 - I, 1 + I}, 3, WorkingPrecision -> 60]}, φAB[Cross[b, RandomComplex[{-1 - I, 1 + I}, 3, WorkingPrecision -> 60]], b]];\nchecks[\"10: y2 = ∞: any rotation . M stays rank 1\"] = Max[Table[defect[randRot . Ms0[RandomReal[{-2, 2}, WorkingPrecision -> 60]]], {4}]];\nchecks[\"10: y2 = ∞: <x0|M(w)M(y) rank 1, several w and y1\"] = Max[Table[defect[Ωv[w] . Ms0[sv]], {w, wTests}, {sv, {1/3, -7/10, 2 - I}}]];\n(* finite y2 off the lines y1 = z_k: not rank 1 *)\nSeedRandom[71];\nchecks[\"10: finite y2, y1 != z_k: min defect (nonzero)\"] = Min[Table[defect[Φwy[wN, RandomComplex[{-2 - 2 I, 2 + 2 I}, 3, WorkingPrecision -> 60]]], {30}]];\nKeyTake[checks, Select[Keys[checks], StringStartsQ[#, \"10: M(y1\"] || StringStartsQ[#, \"10: y2\"] || StringStartsQ[#, \"10: finite\"] &]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
