      {
       "data": "Out[1314]= \\begin{array}{|c|c|}\\hline\\text{qdet t3 = $\\chi$3 $\\nu$1(u)$\\nu$2(u-h)$\\nu$3(u-2h)} & \\mathrm{True}\\\\\\hline\\text{<x\\_mu| are B eigencovectors} & \\mathrm{True}\\\\\\hline\\text{|y\\_mu> are C eigenvectors} & \\mathrm{True}\\\\\\hline\\text{raising E\\_ij (i<j) kill e8\\^{}T} & \\mathrm{True}\\\\\\hline\\text{<x\\_mu| free of z and $\\theta$} & \\mathrm{True}\\\\\\hline\\text{sum\\_mu c\\_mu <x\\_mu| = e8\\^{}T rho(n\\_-)} & \\mathrm{True}\\\\\\hline\\text{intertwiner unique up to scale} & \\mathrm{True}\\\\\\hline\\text{X(e8\\^{}T) = e13} & \\mathrm{True}\\\\\\hline\\text{X(e8\\^{}T rho(n\\_-)) = a b\\^{}T, b.a = 0} & \\mathrm{True}\\\\\\hline\\text{X(sum c(a,b) <x|) = a b\\^{}T when b.a = 0} & \\mathrm{True}\\\\\\hline\\text{c(a,b) reproduces c\\_mu(n\\_-)} & \\mathrm{True}\\\\\\hline\\text{full GL(3): X(e8\\^{}T rho(g)) $\\propto$ g\\^{}-1 e13 g} & 0.\\times 10^{-49}\\\\\\hline\\text{full GL(3): c = s c(a,b) with a = g\\^{}-1 e1, b = e3\\^{}T g} & 0.\\times 10^{-50}\\\\\\hline\\text{full GL(3): rank X = 1 (2nd singular value)} & 0\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
