      {
       "data": "Out[1712]= \\begin{aligned}\n  &\\left\\{\\begin{pmatrix}1 & \\begin{pmatrix}2 & 0 & 1\\\\2 & 1 & 0\\end{pmatrix}\\\\2 & \\begin{pmatrix}0 & 2 & 1\\\\1 & 2 & 0\\end{pmatrix}\\\\3 & \\begin{pmatrix}0 & 1 & 2\\\\1 & 0 & 2\\end{pmatrix}\\end{pmatrix} \\right. \\\\\n  &\\left. ,9,\\begin{pmatrix}-1.45440 & 0\\end{pmatrix}\\right\\}\n\\end{aligned}",
