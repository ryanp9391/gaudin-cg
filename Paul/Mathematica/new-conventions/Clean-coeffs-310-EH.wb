  {
   "kind": 2,
   "value": "ratFit[ys_] := Module[{ts = tFit, yf = Take[ys, Length[tFit]], yv = Drop[ys, Length[tFit]], nf = Length[tFit]},\n   If[Max[Abs[ys]] < 10^-20, Return[{0, 0, 0}]];\n   Catch[Do[Do[With[{n = dg - m}, Module[{A, b, sol, r, f},\n         A = Table[Join[Table[ts[[i]]^k, {k, 0, m}], Table[-yf[[i]] ts[[i]]^k, {k, 0, n - 1}]], {i, nf}];\n         b = yf ts^n; sol = LeastSquares[A, b]; r = Max[Abs[A . sol - b]]/Max[1, Max[Abs[b]]];\n         If[r < 10^-18, sol = Rationalize[sol, 10^-15];\n          f = Function[x, Evaluate[Sum[sol[[k + 1]] x^k, {k, 0, m}]/(x^n + Sum[sol[[m + 2 + k]] x^k, {k, 0, n - 1}])]];\n          Throw[{Factor[f[T]], dg, N[Max[Abs[(f /@ tVal) - yv]], 3]}]]]], {m, 0, dg}], {dg, 0, nf - 3}]; {\"no fit\", 99, -1}]];\ntargets = {{{4, 3, 1}, 1, \"k(1,1)\"}, {{4, 3, 1}, nL + 2, \"s(2,2)\"}, {{4, 3, 1}, 2 nL + 1, \"ρ\"}, {{5, 2, 1}, nL + 1, \"s(1,1)\"}, {{5, 2, 1}, nL + 2, \"s(2,2)\"}};\nyc[μ_, j_, c_] := Table[d[{μ, c}][[j]], {d, dataE}];\nEc[μ_, i_, c_] := Table[d[{μ, c}][[offE + i]], {d, dataE}];\nspread[a_, b_] := Max[Abs[a - b]/MapThread[Max, {Abs[a], Abs[b]}]];\n(* tests 1 and 2: copy-independent y E'/E, E' = 1 or another separating candidate *)\nhitTab = Flatten[Table[Module[{μ = tg[[1]], j = tg[[2]], sep = sepE[tg[[1]]], hits},\n     hits = Flatten[Table[With[{r1 = yc[μ, j, 1] If[i2 == 0, 1, Ec[μ, i2, 1]]/Ec[μ, i, 1], r2 = yc[μ, j, 2] If[i2 == 0, 1, Ec[μ, i2, 2]]/Ec[μ, i, 2]},\n         If[spread[r1, r2] < 10^-15, {{i, i2, ratFit[r1]}}, {}]], {i, sep}, {i2, Join[{0}, DeleteCases[sep, i]]}], 2];\n     Table[{μ, tg[[3]], \"y = r(t) · \" <> candLabels[[h[[1]]]] <> If[h[[2]] == 0, \"\", \" / \" <> candLabels[[h[[2]]]]], h[[3, 1]], h[[3, 2]]}, {h, SortBy[hits, #[[3, 2]] &][[1 ;; UpTo[4]]]}]], {tg, targets}], 1];\n(* test 3: the simplest affine relation y = a(t) + b(t) E *)\naffTab = Table[Module[{μ = tg[[1]], j = tg[[2]], best},\n    best = SortBy[Table[With[{B = (yc[μ, j, 1] - yc[μ, j, 2])/(Ec[μ, i, 1] - Ec[μ, i, 2])}, With[{A = yc[μ, j, 1] - B Ec[μ, i, 1]}, With[{fa = ratFit[A], fb = ratFit[B]}, {i, fa[[2]] + fb[[2]], fa[[1]], fb[[1]]}]]], {i, sepE[μ]}], #[[2]] &];\n    {μ, tg[[3]], Table[{candLabels[[b[[1]]]], b[[2]], b[[3]], b[[4]]}, {b, best[[1 ;; UpTo[3]]]}]}], {tg, targets}];\nColumn[{Grid[Join[{{\"sector\", \"target\", \"copy-independent form found\", \"r(t)\", \"degree of r\"}}, If[hitTab === {}, {{\"none\", \"\", \"\", \"\", \"\"}}, hitTab]], Frame -> All, Alignment -> Left],\n  Grid[Join[{{\"sector\", \"target\", \"three simplest affine forms {E, deg(a)+deg(b), a(t), b(t)}\"}}, affTab], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
