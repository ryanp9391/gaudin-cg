      {
       "data": "Out[959]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{$\\mu$ (mult 1)} & \\text{status} & \\text{quantity} & \\text{closed form in t} & \\text{total degree} & \\text{validation error}\\\\\\hline\\left\\{6,1,1\\right\\} & \\text{clean} & \\text{s\\{1, 1\\}} & 0 & 0 & 0\\\\\\hline\\left\\{6,1,1\\right\\} & \\text{clean} & \\text{s\\{2, 2\\}} & 0 & 0 & 0\\\\\\hline\\left\\{6,1,1\\right\\} & \\text{clean} & \\text{s\\{3, 2\\}} & 1 & 0 & 0.\\times 10^{-162}\\\\\\hline\\left\\{5,3,0\\right\\} & \\text{clean} & \\text{s\\{1, 1\\}} & -\\frac{1}{6} & 0 & 5.38\\times 10^{-26}\\\\\\hline\\left\\{5,3,0\\right\\} & \\text{clean} & \\text{s\\{2, 2\\}} & -1 & 0 & 1.25\\times 10^{-25}\\\\\\hline\\left\\{5,3,0\\right\\} & \\text{clean} & \\text{s\\{3, 2\\}} & 1 & 0 & 0.\\times 10^{-162}\\\\\\hline\\left\\{4,4,0\\right\\} & \\text{contaminated} & \\text{k\\{1, 1\\}} & -\\frac{1}{6} & 0 & 2.14\\times 10^{-25}\\\\\\hline\\left\\{4,4,0\\right\\} & \\text{contaminated} & \\text{k\\{2, 2\\}} & -1 & 0 & 1.25\\times 10^{-25}\\\\\\hline\\left\\{4,4,0\\right\\} & \\text{contaminated} & \\text{k\\{3, 2\\}} & 1 & 0 & 0.\\times 10^{-161}\\\\\\hline\\left\\{4,4,0\\right\\} & \\text{contaminated} & \\text{s\\{1, 1\\}} & 0 & 0 & 0\\\\\\hline\\left\\{4,4,0\\right\\} & \\text{contaminated} & \\text{s\\{2, 2\\}} & -1 & 0 & 1.25\\times 10^{-25}\\\\\\hline… [latex truncated: 5996 chars total]",
