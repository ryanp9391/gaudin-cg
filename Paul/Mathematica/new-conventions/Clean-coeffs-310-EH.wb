      {
       "data": "Out[962]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{D = $\\delta$\\_c\\^{}2} & \\text{quantity} & \\text{P(t)} & \\text{Q(t)}\\\\\\hline\\left\\{5,2,1\\right\\} & \\frac{1}{4}\\,\\left(105\\,T^2+256\\right) & \\text{s\\{1, 1\\}} & -\\frac{35\\,T-16}{336\\,T} & -\\frac{1}{168\\,T}\\\\\\hline\\left\\{5,2,1\\right\\} & \\frac{1}{4}\\,\\left(105\\,T^2+256\\right) & \\text{s\\{2, 2\\}} & -\\frac{35\\,T-16}{56\\,T} & -\\frac{1}{28\\,T}\\\\\\hline\\left\\{5,2,1\\right\\} & \\frac{1}{4}\\,\\left(105\\,T^2+256\\right) & \\text{s\\{3, 2\\}} & 1 & 0\\\\\\hline\\left\\{4,3,1\\right\\} & 16\\,\\left(3\\,T^2+1\\right) & \\text{k\\{1, 1\\}} & -\\frac{35\\,T^2-104\\,T+53}{12\\,\\left(25\\,T^2-65\\,T+24\\right)} & -\\frac{5\\,T-13}{48\\,\\left(25\\,T^2-65\\,T+24\\right)}\\\\\\hline\\left\\{4,3,1\\right\\} & 16\\,\\left(3\\,T^2+1\\right) & \\text{k\\{2, 2\\}} & -\\frac{35\\,T^2-104\\,T+53}{2\\,\\left(25\\,T^2-65\\,T+24\\right)} & -\\frac{5\\,T-13}{8\\,\\left(25\\,T^2-65\\,T+24\\right)}\\\\\\hline\\left\\{4,3,1\\right\\} & 16\\,\\left(3\\,T^2+1\\right) & \\text{k\\{3, 2\\}} & 1 & 0\\\\\\hline\\left\\{4,3,1\\right\\} & 16\\,\\left(3\\,T^2+1\\right) & \\text{s\\{1, 1\\}} & 0 & 0\\\\\\hline\\left\\{4,3,1\\right\\} & 16\\,\\left(3\\,T^2+1\\right) & \\text{s\\{2, 2\\}} & -\\frac{3\\,T-1}{6\\,T} & -\\frac{1}{24\\,T}\\\\\\hline\\left\\{4,3,1\\right\\} & 16\\,\\left(3\\,T^2… [latex truncated: 1733 chars total]",
