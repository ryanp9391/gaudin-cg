       "data": "Out[1176]= \\begin{array}{|c|c|}\\hline\\text{data time (s)} & 66.694135\\\\\\hline\\text{candidates} & 39\\\\\\hline\\text{refs \\{K\\_ref, S\\_ref\\}} & \\left\\{\\left\\{4,3,1\\right\\}\\to \\left\\{3,3\\right\\},\\left\\{5,2,1\\right\\}\\to \\left\\{3,3\\right\\}\\right\\}\\\\\\hline\\text{copy-separating candidates [4,3,1]} & \\left\\{\\text{t2($\\theta$1-5)},\\text{t2($\\theta$1-4)},\\text{t2($\\theta$1-3)},\\text{t2($\\theta$1-2)},\\text{t2($\\theta$1-1)},\\text{t2($\\theta$1+0)},\\text{t2($\\theta$1+1)},\\text{t2($\\theta$1+2)},\\text{t2($\\theta$1+3)},\\text{t2($\\theta$2-5)},\\text{t2($\\theta$2-4)},\\text{t2($\\theta$2-3)},\\text{t2($\\theta$2-2)},\\text{t2($\\theta$2-1)},\\text{t2($\\theta$2+0)},\\text{t2($\\theta$2+1)},\\text{t2($\\theta$2+2)},\\text{t2($\\theta$2+3)},\\text{T\\{1, 1\\}($\\theta$1-3)},\\text{T\\{2, 2\\}($\\theta$1-3)},\\text{T\\{3, 2\\}($\\theta$1-3)}\\right\\}\\\\\\hline\\text{copy-separating candidates [5,2,1]} & \\left\\{\\text{t2($\\theta$1-5)},\\text{t2($\\theta$1-4)},\\text{t2($\\theta$1-3)},\\text{t2($\\theta$1-2)},\\text{t2($\\theta$1-1)},\\text{t2($\\theta$1+0)},\\text{t2($\\theta$1+1)},\\text{t2($\\theta$1+2)},\\text{t2($\\theta$1+3)},\\text{t2($\\theta$2-5)},\\text{t2($\\theta$2-4)},\\text{t2($\\theta$2-3)},\\text{t2($\\theta$2-2)},\\text{t2($\\theta$2-1)},\\text{t2($\\theta$2+0… [latex truncated: 1388 chars total]",
