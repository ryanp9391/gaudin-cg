       "data": "Out[1159]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{state \\{$\\mu$, copy\\}} & \\text{K\\_ref insertion} & \\text{$\\rho$ = K\\_ref/S\\_ref (t = 5/2)} & \\text{max |lead($\\varepsilon$0) - lead($\\varepsilon$0/2)|} & \\text{digits}\\\\\\hline\\left\\{\\left\\{6,1,1\\right\\},1\\right\\} & \\left\\{3,2\\right\\} & 5.00725\\times 10^{-25} & 6.29\\times 10^{-25} & 0\\\\\\hline\\left\\{\\left\\{5,3,0\\right\\},1\\right\\} & \\left\\{3,2\\right\\} & -1.40547\\times 10^{-26} & 1.52\\times 10^{-25} & 137\\\\\\hline\\left\\{\\left\\{5,2,1\\right\\},1\\right\\} & \\left\\{3,2\\right\\} & -1.10935\\times 10^{-25} & 2.39\\times 10^{-26} & 138\\\\\\hline\\left\\{\\left\\{5,2,1\\right\\},2\\right\\} & \\left\\{3,2\\right\\} & -1.19690\\times 10^{-26} & 1.76\\times 10^{-25} & 136\\\\\\hline\\left\\{\\left\\{4,4,0\\right\\},1\\right\\} & \\left\\{3,2\\right\\} & 1.5 & 6.59\\times 10^{-25} & 0\\\\\\hline\\left\\{\\left\\{4,3,1\\right\\},1\\right\\} & \\left\\{3,2\\right\\} & 0.711502 & 2.90\\times 10^{-25} & 0\\\\\\hline\\left\\{\\left\\{4,3,1\\right\\},2\\right\\} & \\left\\{3,2\\right\\} & 0.184794 & 9.50\\times 10^{-26} & 0\\\\\\hline\\left\\{\\left\\{4,2,2\\right\\},1\\right\\} & \\left\\{2,2\\right\\} & -0.075 & 1.16\\times 10^{-23} & 0\\\\\\hline\\left\\{\\left\\{3,3,2\\right\\},1\\right\\} & \\left\\{3,2\\right\\} & 1.5875 & 8.80\\times 10^{-26} & 0\\\\\\hline\\tex… [latex truncated: 1314 chars total]",
