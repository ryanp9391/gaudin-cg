  {
   "kind": 2,
   "value": "lax1[s_, x_] := Table[KroneckerDelta[i, j] (x - thN[[s]]) id1 + hN EN[i, j], {i, 3}, {j, 3}];\ntwistR[T_, M_] := Table[Sum[T[[i, l]] M[[l, j]], {l, 3}], {i, 3}, {j, 3}];\nlax2[x_] := lax2[x] = With[{L1 = lax1[1, x], L2 = lax1[2, x]}, Table[Sum[KroneckerProduct[SparseArray[L1[[i, k]]], SparseArray[L2[[k, j]]]], {k, 3}], {i, 3}, {j, 3}]];\nmono2[M_][x_] := twistR[lax2[x], M];\nmono1[s_, M_][x_] := twistR[lax1[s, x], M];\ntq[mono_, a_, x_] := Sum[Sum[Signature[σ] Dot @@ Table[mono[x - (k - 1) hN][[σ[[k]], rows[[k]]]], {k, a}], {σ, Permutations[rows]}], {rows, Subsets[Range[3], {a}]}];\ntL2[a_, x_, M_] := tL2[a, x, M] = tq[mono2[M], a, x];\ntL1[s_, a_, x_, M_] := tq[mono1[s, M], a, x];\nconj[λ_] := Table[Count[λ, y_ /; y >= j], {j, Max[λ]}];\ncbr[tf_, λ_, x_, idm_] := With[{lc = conj[λ], n = Max[λ]}, Sum[With[{as = Table[lc[[σ[[i]]]] + i - σ[[i]], {i, n}]},\n     If[Min[as] < 0 || Max[as] > 3, 0, Signature[σ] Dot @@ Table[If[as[[i]] == 0, idm, tf[as[[i]], x + (i - 1) hN]], {i, n}]]], {σ, Permutations[Range[n]]}]];\nTL1[s_, λ_, x_, M_] := cbr[tL1[s, #1, #2, M] &, λ, x, id1];\nnu[n_][x_] := Product[x - thN[[s]] + hN Λ[[n]], {s, 2}];\nqdetS[zv_, x_] := (Times @@ zv) nu[1][x] nu[2][x - hN] nu[3][x - 2 hN];\nmaxAbs[m_] := Max[Abs[Flatten[{Normal[m]}]]];\ntEv[Ψ_, a_, x_, zv_] := Which[a == 0, 1, a == 3, qdetS[zv, x], True, With[{k = Ordering[Abs[Ψ], -1][[1]]}, (tL2[a, x, DiagonalMatrix[zv]] . Ψ)[[k]]/Ψ[[k]]]];\n(* Ω, R, x0 as in the Minimal-ingredients notebooks *)\nrOm[zv_, wv_] := {(wv[[1]] - zv[[1]])/(wv[[1]] - zv[[2]]),\n   ((wv[[1]] - zv[[1]]) (zv[[1]] - wv[[2]]) (zv[[2]] - zv[[3]]))/((zv[[1]] - zv[[2]]) (wv[[1]] - zv[[3]]) (wv[[2]] - zv[[3]])),\n   ((wv[[1]] - zv[[2]]) (zv[[2]] - wv[[2]]) (zv[[1]] - zv[[3]]))/((zv[[1]] - zv[[2]]) (wv[[1]] - zv[[3]]) (zv[[3]] - wv[[2]]))};\nRrot[zv_, wv_] := With[{r = rOm[zv, wv]}, nexp[r[[1]] EN[1, 2]] . nexp[r[[2]] EN[1, 3]] . nexp[r[[3]] EN[2, 3]]];\nRrotInv[zv_, wv_] := With[{r = rOm[zv, wv]}, nexp[-r[[3]] EN[2, 3]] . nexp[-r[[2]] EN[1, 3]] . nexp[-r[[1]] EN[1, 2]]];\nOm1[zv_, wv_] := e1 . Rrot[zv, wv];\nrsSol[zv_] := {s1 -> zv[[1]]^2/((zv[[1]] - zv[[2]]) (zv[[1]] - zv[[3]])), s2 -> -(zv[[2]]/(zv[[1]] (zv[[2]] - zv[[3]]))), s3 -> 1/(zv[[1]] zv[[2]]), ρ1 -> -(zv[[3]]/zv[[2]]), ρ2 -> -(zv[[3]]/zv[[1]]), ρ3 -> (zv[[2]]^2 (zv[[3]] - zv[[1]]))/(zv[[1]]^2 (zv[[2]] - zv[[3]]))};\nPphys[zv_] := With[{q = rsSol[zv]}, nexp[(ρ1 /. q) EN[3, 2]] . nexp[(ρ2 /. q) EN[3, 1]] . nexp[(ρ3 /. q) EN[2, 1]] . DiagonalMatrix[Table[Product[({s1, s2, s3}[[k]] /. q)^J0[k][p], {k, 3}], {p, ps[{Λ}]}]] . nexp[(1/zv[[1]]) EN[1, 2]] . nexp[-(1/(zv[[1]] zv[[2]])) EN[1, 3]] . nexp[((zv[[1]] + zv[[2]])/(zv[[1]] zv[[2]])) EN[2, 3]]];\nx0[zv_] := With[{x = e1 . Inverse[Pphys[zv]]}, kron[x, x]];\n(* states at small twist; HW content as before *)\nφ = {1/3, -2/7, 5/11}; ω = {3/4, -1/5, 2/9};\nzOf[ε_, φv_] := N[Exp[ε φv], pr]; wOf[ε_, ωv_] := N[Exp[ε ωv], pr];\nhwB[μ_] := hwB[μ] = With[{sec = secOf[μ]}, With[{ns = NullSpace[Normal[Join[EtotN[1, 2][[All, sec]], EtotN[2, 3][[All, sec]]]]]}, If[ns === {}, {}, Orthogonalize[Table[Normal[SparseArray[Thread[sec -> n], {d2}]], {n, ns}]]]]];\nprojHW[μ_, v_] := If[hwB[μ] === {}, 0 v, (hwB[μ] . v) . hwB[μ]];\nhwSecs = Select[Reverse[Sort[Select[Union[wtBasis], #[[1]] >= #[[2]] >= #[[3]] &]]], Length[hwB[#]] > 0 &];\nhwList = Flatten[Table[{μ, k}, {μ, hwSecs}, {k, Length[hwB[μ]]}], 1]; nonTop = Rest[hwList];\nstatesAt[zv_] := statesAt[zv] = Module[{mix = tL2[1, 3/7, DiagonalMatrix[zv]] + N[Pi, pr] tL2[2, 3/7, DiagonalMatrix[zv]], x = x0[zv]},\n   Flatten[Table[With[{sec = secOf[μ]}, With[{es = Eigensystem[Normal[mix[[sec, sec]]]]}, Table[With[{ψ = Normal[SparseArray[Thread[sec -> es[[2, k]]], {d2}]]}, With[{Ψ = ψ/(x . ψ)},\n          <|\"mu\" -> μ, \"ev\" -> es[[1, k]], \"psi\" -> Ψ, \"hwFrac\" -> Norm[projHW[μ, Ψ]]/Norm[Ψ]|>]], {k, Length[sec]}]]], {μ, hwSecs}], 1]];\npickState[μ_, copy_, zv_] := SortBy[Select[statesAt[zv], #[\"mu\"] === μ && #[\"hwFrac\"] > 9/10 &], Re[#[\"ev\"]] &][[copy]];\n(* move the chain point: θ = (t, 0) with h = 1, and drop every θ-dependent cache (keeps the pattern definitions) *)\nclearMemo[f_] := (DownValues[f] = Select[DownValues[f], ! FreeQ[First[#], Pattern] &]);\nsetPoint[t_] := (thN = {t, 0}; clearMemo /@ {lax2, tL2, statesAt};);\nsetPoint[5/2];\n{tq0, chk} = AbsoluteTiming[With[{zv = zOf[10^-3, φ]}, {maxAbs[With[{A = tL2[1, 1/3, DiagonalMatrix[zv]], B = tL2[2, -2/5, DiagonalMatrix[zv]]}, A . B - B . A]], Length[Select[statesAt[zv], #[\"hwFrac\"] > 9/10 &]], Length[hwList]}]];\nGrid[{{\"[t1, t2] residual\", N[chk[[1]], 3]}, {\"HW-limit states found / HW states\", chk[[2 ;; 3]]}, {\"HW sectors (multiplicity)\", Table[{μ, Length[hwB[μ]]}, {μ, hwSecs}]}, {\"time (s)\", tq0}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
