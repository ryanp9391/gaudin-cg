      {
       "data": "Out[1184]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|}\\hline\\text{sector} & \\text{target} & \\text{copy-independent form found} & \\text{r(t)} & \\text{degree of r}\\\\\\hline\\text{none} &  &  &  & \\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{sector} & \\text{target} & \\text{three simplest affine forms \\{E, deg(a)+deg(b), a(t), b(t)\\}}\\\\\\hline\\left\\{4,3,1\\right\\} & \\text{k(1,1)} & \\begin{pmatrix}\\text{t2($\\theta$1-5)} & 8 & \\frac{115\\,T^3-1264\\,T^2+3995\\,T-3902}{24\\,\\left(25\\,T^2-65\\,T+24\\right)} & -\\frac{5\\,T-13}{48\\,\\left(25\\,T^2-65\\,T+24\\right)}\\\\\\text{t2($\\theta$1-4)} & 8 & \\frac{\\left(T-1\\right)\\,\\left(15\\,T^2-124\\,T+215\\right)}{6\\,\\left(25\\,T^2-65\\,T+24\\right)} & -\\frac{5\\,T-13}{48\\,\\left(25\\,T^2-65\\,T+24\\right)}\\\\\\text{t2($\\theta$1-3)} & 8 & \\frac{5\\,T^3-43\\,T^2+72\\,T+6}{6\\,\\left(25\\,T^2-65\\,T+24\\right)} & -\\frac{5\\,T-13}{48\\,\\left(25\\,T^2-65\\,T+24\\right)}\\end{pmatrix}\\\\\\hline\\left\\{4,3,1\\right\\} & \\text{s(2,2)} & \\begin{pmatrix}\\text{t2($\\theta$1+1)} & 2 & \\frac{T-1}{6} & -\\frac{1}{24\\,T}\\\\\\text{t2($\\theta$2+1)} & 2 & \\frac{T-5}{6} & -\\frac{1}{24\\,T}\\\\\\text{t2($\\theta$1-5)} & 4 & \\frac{23\\,T^2-185\\,T+294}{12\\,T} & -\\frac{1}{24\\,T}\\end{pmatrix}\\\\\\hline\\left\\{4,3,1\\right\\} & \\rho  & \\be… [latex truncated: 2143 chars total]",
