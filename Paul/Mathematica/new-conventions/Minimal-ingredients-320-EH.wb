       "data": "Out[102]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{mult} & \\text{dim sector clean space} & \\text{sector HW rel. sv ($\\varepsilon$=10\\^{}-5)} & \\text{per copy: \\{space, dim, \\{rel. err, digits\\} at (10\\^{}-4, $\\varphi$), at (10\\^{}-5, $\\varphi$')\\}}\\\\\\hline\\left\\{6,3,1\\right\\} & 1 & 3 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & 3 & \\left\\{2.12\\times 10^{-6},113\\right\\} & \\left\\{7.47\\times 10^{-8},107\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{6,2,2\\right\\} & 1 & 2 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & 2 & \\left\\{5.86\\times 10^{-6},107\\right\\} & \\left\\{3.25\\times 10^{-6},102\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{5,5,0\\right\\} & 1 & 3 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & 3 & \\left\\{0.0000119,128\\right\\} & \\left\\{1.49\\times 10^{-6},125\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{5,4,1\\right\\} & 2 & 3 & \\left\\{1.\\,,0.0622\\right\\} & \\begin{pmatrix}\\text{sector} & 3 & \\left\\{0.0000352,120\\right\\} & \\left\\{1.78\\times 10^{-6},115\\right\\}\\\\\\text{sector} & 3 & \\left\\{0.0000560,121\\right\\} & \\left\\{1.29\\times 10^{-6},117\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{5,3,2\\right\\} & 2 & 1 & \\left\\{1.\\,,5.67\\times 10^{-9}\\right\\} & \\begin{pmatrix}\\text{per copy} & 2 & \\left\\{0.0000104,1… [latex truncated: 1768 chars total]",
