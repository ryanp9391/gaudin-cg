      {
       "data": "Out[92]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{S\\_ref insertion} & \\text{spread over directions ($\\varepsilon$=10\\^{}-5)} & \\text{k = K\\_j/S\\_ref, j = \\{\\{1, 1\\}, \\{2, 1\\}, \\{3, 1\\}\\}} & \\text{s = S\\_j/S\\_ref}\\\\\\hline\\left\\{6,3,1\\right\\} & 1 & \\left\\{2,1\\right\\} & 7.0\\times 10^{-7} & \\left\\{0,2.1150\\times 10^{-7},-8.1580\\times 10^{-8}\\right\\} & \\left\\{0,1.\\,,-0.38572\\right\\}\\\\\\hline\\left\\{6,2,2\\right\\} & 1 & \\left\\{3,1\\right\\} & 8.8\\times 10^{-6} & \\left\\{0,-2.0000,0.77143\\right\\} & \\left\\{0,0,1.\\,\\right\\}\\\\\\hline\\left\\{5,5,0\\right\\} & 1 & \\left\\{1,1\\right\\} & 2.7\\times 10^{-6} & \\left\\{1.1939\\times 10^{-6},1.3644\\times 10^{-7},-2.6314\\times 10^{-8}\\right\\} & \\left\\{1.\\,,0.11429,-0.022041\\right\\}\\\\\\hline\\left\\{5,4,1\\right\\} & 1 & \\left\\{2,1\\right\\} & 0.000021 & \\left\\{-8.9351\\times 10^{-7},6.0389\\times 10^{-7},-2.5262\\times 10^{-7}\\right\\} & \\left\\{-0.54514,1.\\,,-0.39773\\right\\}\\\\\\hline\\left\\{5,4,1\\right\\} & 2 & \\left\\{1,1\\right\\} & 0.000011 & \\left\\{4.4563\\times 10^{-7},1.2141\\times 10^{-7},-3.7008\\times 10^{-8}\\right\\} & \\left\\{1.\\,,0.18201,-0.048164\\right\\}\\\\\\hline\\left\\{5,3,2\\right\\} & 1 & \\left\\{3,1\\right\\} & 0.000012 & \\left\\{0.35361,-0.85517,0.33765\\right\\} & \\… [latex truncated: 1796 chars total]",
