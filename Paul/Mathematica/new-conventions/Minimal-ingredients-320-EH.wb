       "data": "Out[24]= \\begin{array}{|c|c|}\\hline\\Lambda  & \\left\\{3,2,0\\right\\}\\\\\\hline\\text{one-site, two-site dimension} & \\left\\{15,225\\right\\}\\\\\\hline\\text{precision} & 150\\\\\\hline\\text{EH\\^{}T = EH\\_ji} & \\mathrm{True}\\\\\\hline\\end{array}",
