      {
       "data": "Out[967]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{v($\\theta$) || v($\\theta$-h)} \\\\\n  &\\to 1.15487179038876676007103959138582583797912123948764608609 \\\\\n  &\\times 10^{-66},\\text{v($\\theta$-3h), v($\\theta$-2h), v($\\theta$-h) dependent} \\\\\n  &\\to 1.5195484585818794607536262025171406407234946474435487926 \\\\\n  &\\times 10^{-67} \\\\\n  &,\\text{T\\_$\\lambda$($\\theta$-2h): 2x2 formula or 0, all $\\lambda$, all row pairs} \\\\\n  &\\to 1.311924184257601207715616587371{\\color{gray}\\vdots} \\\\\n  &{\\color{gray}\\vdots}6443244536038063212763640\\times 10^{-65}\\rvert\\!\\rangle\n\\end{aligned}",
       "mime": "text/plain"
      }
