  {
   "kind": 2,
   "value": "Λ = {2, 1, 0}; dimΛ = dim[Λ];\nν[n_][u_] := u - θ + h Λ[[n]];\nzs = {z[1], z[2], z[3]}; ws = {w[1], w[2], w[3]};\nχ[tw_] := {tw[[1]] + tw[[2]] + tw[[3]], tw[[1]] tw[[2]] + tw[[1]] tw[[3]] + tw[[2]] tw[[3]], tw[[1]] tw[[2]] tw[[3]]};\nGc[tw_] := With[{c = χ[tw]}, {{c[[1]], -c[[2]], c[[3]]}, {1, 0, 0}, {0, 1, 0}}];\nEe[i_, j_] := Ee[i, j] = JJ[i, j, Λ];\nℒ[i_, j_][u_] := u IdentityMatrix[dimΛ] KroneckerDelta[i, j] + h Ee[i, j];\nT[i_, j_][u_] := ℒ[i, j][u - θ];\nTG[tw_][i_, j_][u_] := Sum[ℒ[i, k][u - θ] Gc[tw][[k, j]], {k, 3}];\n(* quantum minor of a monodromy Tf: rows antisymmetrized, column k at u-(k-1)h *)\nqminor[Tf_][I_, J_][u_] := Sum[Signature[σ] Dot @@ Table[Tf[σ[[k]], J[[k]]][u - (k - 1) h], {k, Length[J]}], {σ, Permutations[I]}];\ntGz = Table[Expand[Sum[qminor[TG[zs]][I, I][u], {I, Subsets[Range[3], {a}]}]], {a, 3}];\n(* t_a for any twist tw at argument v *)\ntGt[tw_, a_, v_] := tGz[[a]] /. Join[Thread[zs -> tw], {u -> v}];\n(* fused (CBR) transfer matrices T_{(a,b)} used to build the SoV bases *)\ntF[{1, 0}, v_] := tGt[zs, 1, v];\ntF[{1, 1}, v_] := tGt[zs, 2, v];\ntF[{2, 0}, v_] := tGt[zs, 1, v] . tGt[zs, 1, v + h] - tGt[zs, 2, v + h];\ntF[{2, 1}, v_] := tGt[zs, 2, v] . tGt[zs, 1, v + h] - tGt[zs, 3, v + h];\ntF[{2, 2}, v_] := tGt[zs, 2, v] . tGt[zs, 2, v + h] - tGt[zs, 3, v + h] . tGt[zs, 1, v];\n(* quantum determinant: t3 = χ3 ν1(u)ν2(u-h)ν3(u-2h) · 1 *)\nchecks[\"qdet t3 = χ3 ν1(u)ν2(u-h)ν3(u-2h)\"] = Union[Flatten[Expand[tGz[[3]] - χ[zs][[3]] ν[1][u] ν[2][u - h] ν[3][u - 2 h] IdentityMatrix[dimΛ]]]] === {0};\nchecks[\"qdet t3 = χ3 ν1(u)ν2(u-h)ν3(u-2h)\"]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"758596\" data-output-id=\"126\" data-out-n=\"878\" data-sub-idx=\"22\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"3\" data-sub-start=\"22\" data-sub-end=\"22\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[878]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"XG1hdGhybXtUcnVlfQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span></span></div></div></div>",
