      {
       "data": "Out[1002]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{c0 = 1/(4h\\^{}6), same on all four (x0,y0) monomials}\\to \\mathrm{True} \\\\\n  &,\\text{<Psi\\_A|Psi\\_B> diagonal (same twist)} \\\\\n  &\\to 0.\\times 10^{-54} \\\\\n  &,\\text{det N\\^{}\\{AB\\} diagonal (same twist)} \\\\\n  &\\to 6.801642148512331523547042033148060890976527701416589417 \\\\\n  &\\times 10^{-63} \\\\\n  &,\\text{norm formula, same twist}\\to 0.\\times 10^{-53}\\rvert\\!\\rangle\n\\end{aligned}",
       "mime": "text/plain"
      }
