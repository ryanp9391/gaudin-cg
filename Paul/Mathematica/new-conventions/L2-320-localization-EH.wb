       "data": "Out[181]= \\begin{array}{|c|c|}\\hline\\text{dim [3,2,0]} & 15\\\\\\hline\\text{R = sqrt(M) for [3,2,0]} & \\left\\{1,\\sqrt{2},2,1,2,2\\,\\sqrt{3},2\\,\\sqrt{2},2\\,\\sqrt{6},8,2\\,\\sqrt{2},4\\,\\sqrt{3},2\\,\\sqrt{6},8\\,\\sqrt{2},12,16\\right\\}\\\\\\hline\\text{EH\\^{}T = EH\\_ji} & \\mathrm{True}\\\\\\hline\\text{gl(3) relations} & \\mathrm{True}\\\\\\hline\\end{array}",
