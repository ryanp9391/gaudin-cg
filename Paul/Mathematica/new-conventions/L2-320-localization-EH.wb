      {
       "data": "Out[205]= \\begin{array}{|c|c|c|c|}\\hline\\Lambda  & \\text{qdet rel. err} & \\text{[t1,t2] rel. err} & \\text{$\\Omega$ eigencovector of t\\_a(G') resid}\\\\\\hline\\left\\{2,1,0\\right\\} & 9.098695122460241\\times 10^{-15} & 1.8581303921426077\\times 10^{-16} & 7.529876283061674\\times 10^{-14}\\\\\\hline\\left\\{3,2,0\\right\\} & 1.788306727051725\\times 10^{-15} & 1.4188296571304438\\times 10^{-16} & 1.842743884616415\\times 10^{-14}\\\\\\hline\\end{array}",
       "mime": "text/plain"
