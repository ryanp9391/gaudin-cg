       "data": "Out[217]= \\begin{array}{|c|c|c|c|}\\hline\\text{scan time (s)} & 1.374095 &  & \\\\\\hline\\left\\{2,1,0\\right\\} & \\text{near $\\theta$1} & \\text{hits \\{$\\lambda$, c, label\\}:} & \\begin{pmatrix}\\left\\{1,1\\right\\} & -2 & \\text{site 1}\\\\\\left\\{2,1\\right\\} & -2 & \\text{site 1}\\end{pmatrix}\\\\\\hline\\left\\{2,1,0\\right\\} & \\text{near $\\theta$2} & \\text{hits \\{$\\lambda$, c, label\\}:} & \\begin{pmatrix}\\left\\{1,1\\right\\} & 1 & \\text{SITE 2}\\end{pmatrix}\\\\\\hline\\left\\{3,2,0\\right\\} & \\text{near $\\theta$1} & \\text{hits \\{$\\lambda$, c, label\\}:} & \\begin{pmatrix}\\left\\{1,1\\right\\} & -3 & \\text{site 1}\\\\\\left\\{2,1\\right\\} & -3 & \\text{site 1}\\\\\\left\\{3,1\\right\\} & -3 & \\text{site 1}\\end{pmatrix}\\\\\\hline\\left\\{3,2,0\\right\\} & \\text{near $\\theta$2} & \\text{hits \\{$\\lambda$, c, label\\}:} & \\begin{pmatrix}\\left\\{1,1\\right\\} & 1 & \\text{SITE 2}\\\\\\left\\{2,2\\right\\} & 0 & \\text{SITE 2}\\end{pmatrix}\\\\\\hline\\end{array}",
