      {
       "data": "Out[249]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{site} & \\text{factors} & \\text{local (exact)} & \\text{f} & \\text{g} & \\text{v = f w + g $\\Omega$ exact}\\\\\\hline1 & \\begin{pmatrix}\\text{T} & \\left\\{1,1\\right\\} & -3\\end{pmatrix} & \\mathrm{True} & -\\frac{1053}{2450} & 0 & \\mathrm{True}\\\\\\hline1 & \\begin{pmatrix}\\text{T} & \\left\\{2,1\\right\\} & -3\\end{pmatrix} & \\mathrm{True} & \\frac{2106}{42875} & 0 & \\mathrm{True}\\\\\\hline1 & \\begin{pmatrix}\\text{T} & \\left\\{3,1\\right\\} & -3\\end{pmatrix} & \\mathrm{True} & \\frac{28431}{1500625} & 0 & \\mathrm{True}\\\\\\hline1 & \\begin{pmatrix}\\text{T} & \\left\\{1,1\\right\\} & -3\\\\\\text{t} & 1 & -2\\end{pmatrix} & \\mathrm{True} & \\frac{2106}{42875} & -\\frac{3159}{7840} & \\mathrm{True}\\\\\\hline1 & \\begin{pmatrix}\\text{T} & \\left\\{3,1\\right\\} & -3\\\\\\text{t} & 2 & 1\\end{pmatrix} & \\mathrm{True} & \\frac{189521046}{1838265625} & 0 & \\mathrm{True}\\\\\\hline2 & \\begin{pmatrix}\\text{t} & 2 & 1\\end{pmatrix} & \\mathrm{True} & \\frac{156}{1225} & 0 & \\mathrm{True}\\\\\\hline2 & \\begin{pmatrix}\\text{T} & \\left\\{2,2\\right\\} & 0\\end{pmatrix} & \\mathrm{True} & -\\frac{45279}{1500625} & 0 & \\mathrm{True}\\\\\\hline2 & \\begin{pmatrix}\\text{T} & \\left\\{2,2\\right\\} & 0\\\\\\text{t} & 1 & -2\\end{pmatri… [latex truncated: 1320 chars total]",
