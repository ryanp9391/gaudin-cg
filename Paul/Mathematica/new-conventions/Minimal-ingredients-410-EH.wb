       "data": "Out[126]= \\begin{array}{|c|c|}\\hline\\Lambda  & \\left\\{4,1,0\\right\\}\\\\\\hline\\text{one-site, two-site dimension} & \\left\\{24,576\\right\\}\\\\\\hline\\text{precision} & 200\\\\\\hline\\text{EH\\^{}T = EH\\_ji} & \\mathrm{True}\\\\\\hline\\end{array}",
