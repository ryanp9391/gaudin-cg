       "data": "Out[211]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{mult} & \\text{dim sector clean space} & \\text{sector HW rel. sv ($\\varepsilon$=10\\^{}-5)} & \\text{per copy: \\{space, dim, \\{rel. err, digits\\} at (10\\^{}-4, $\\varphi$), at (10\\^{}-5, $\\varphi$')\\}}\\\\\\hline\\left\\{8,1,1\\right\\} & 1 & 4 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & 4 & \\left\\{0.0000143,170\\right\\} & \\left\\{5.04\\times 10^{-7},166\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{7,3,0\\right\\} & 1 & 4 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & 4 & \\left\\{6.34\\times 10^{-6},176\\right\\} & \\left\\{7.93\\times 10^{-7},173\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{7,2,1\\right\\} & 2 & 4 & \\left\\{1.\\,,0.00689\\right\\} & \\begin{pmatrix}\\text{sector} & 4 & \\left\\{0.0000767,170\\right\\} & \\left\\{1.32\\times 10^{-6},165\\right\\}\\\\\\text{sector} & 4 & \\left\\{0.0000835,170\\right\\} & \\left\\{1.49\\times 10^{-6},165\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{6,4,0\\right\\} & 1 & 3 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & 3 & \\left\\{6.70\\times 10^{-6},165\\right\\} & \\left\\{1.13\\times 10^{-6},159\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{6,3,1\\right\\} & 2 & 2 & \\left\\{1.\\,,2.84\\times 10^{-11}\\right\\} & \\begin{pmatrix}\\text{per copy} & 3 & \\left\\{0.0000108… [latex truncated: 2380 chars total]",
