      {
       "data": "Out[201]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{S\\_ref insertion} & \\text{spread over directions ($\\varepsilon$=10\\^{}-5)} & \\text{k = K\\_j/S\\_ref, j = \\{\\{1, 1\\}, \\{2, 2\\}, \\{3, 3\\}, \\{4, 3\\}\\}} & \\text{s = S\\_j/S\\_ref}\\\\\\hline\\left\\{8,1,1\\right\\} & 1 & \\left\\{4,3\\right\\} & 9.2\\times 10^{-7} & \\left\\{0,0,0,-1.4276\\times 10^{-6}\\right\\} & \\left\\{0,0,0,1.\\,\\right\\}\\\\\\hline\\left\\{7,3,0\\right\\} & 1 & \\left\\{1,1\\right\\} & 4.3\\times 10^{-6} & \\left\\{-6.3379\\times 10^{-7},-3.2284\\times 10^{-7},8.6056\\times 10^{-8},-1.6597\\times 10^{-8}\\right\\} & \\left\\{1.\\,,0.50939,-0.13578,0.026186\\right\\}\\\\\\hline\\left\\{7,2,1\\right\\} & 1 & \\left\\{1,1\\right\\} & 0.000044 & \\left\\{4.7420\\times 10^{-6},2.4155\\times 10^{-6},-6.4388\\times 10^{-7},1.2442\\times 10^{-7}\\right\\} & \\left\\{1.\\,,0.50939,-0.13578,0.097181\\right\\}\\\\\\hline\\left\\{7,2,1\\right\\} & 2 & \\left\\{1,1\\right\\} & 0.000014 & \\left\\{1.3641\\times 10^{-6},6.9486\\times 10^{-7},-1.8522\\times 10^{-7},3.8424\\times 10^{-8}\\right\\} & \\left\\{1.\\,,0.50939,-0.13578,0.034721\\right\\}\\\\\\hline\\left\\{6,4,0\\right\\} & 1 & \\left\\{2,2\\right\\} & 4.5\\times 10^{-6} & \\left\\{-0.44872,-0.22857,0.060927,-0.011750\\right\\} & \\left\\{0,1.\\,,-0.53311,0.10282\\right\\}… [latex truncated: 2583 chars total]",
