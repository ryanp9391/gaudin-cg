      },
      {
       "data": "Out[171]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{dim weight space} & \\text{HW multiplicity} & \\text{HW-limit states found} & \\text{largest ‖P\\_HW $\\Psi$‖/‖$\\Psi$‖ ($\\varepsilon$ = 10\\^{}-3)}\\\\\\hline\\left\\{8,2,0\\right\\} & 1 & 1 & 1 & \\left\\{1.\\,\\right\\}\\\\\\hline\\left\\{8,1,1\\right\\} & 2 & 1 & 1 & \\left\\{1.0000,0.0005129\\right\\}\\\\\\hline\\left\\{7,3,0\\right\\} & 2 & 1 & 1 & \\left\\{1.0000,0.0002461\\right\\}\\\\\\hline\\left\\{7,2,1\\right\\} & 6 & 2 & 2 & \\left\\{1.0000,1.0000,0.0004242\\right\\}\\\\\\hline\\left\\{6,4,0\\right\\} & 3 & 1 & 1 & \\left\\{1.0000,0.0004521\\right\\}\\\\\\hline\\left\\{6,3,1\\right\\} & 10 & 2 & 2 & \\left\\{1.0000,1.0000,0.0004142\\right\\}\\\\\\hline\\left\\{6,2,2\\right\\} & 14 & 1 & 1 & \\left\\{1.0000,0.0006429\\right\\}\\\\\\hline\\left\\{5,5,0\\right\\} & 4 & 1 & 1 & \\left\\{1.0000,0.0009591\\right\\}\\\\\\hline\\left\\{5,4,1\\right\\} & 14 & 2 & 2 & \\left\\{1.0000,1.0000,0.0007461\\right\\}\\\\\\hline\\left\\{5,3,2\\right\\} & 22 & 1 & 1 & \\left\\{1.0000,0.0004765\\right\\}\\\\\\hline\\left\\{4,4,2\\right\\} & 26 & 1 & 1 & \\left\\{1.0000,0.001070\\right\\}\\\\\\hline\\text{time (s)} & 0.319938 &  &  & \\\\\\hline\\end{array}",
