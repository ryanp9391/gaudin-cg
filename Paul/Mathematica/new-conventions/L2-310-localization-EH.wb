       "data": "Out[2809]= \\begin{array}{|c|c|c|}\\hline\\text{check} & \\text{value} & \\\\\\hline\\text{EH\\^{}T = EH\\_ji for [2,1,0] and [3,1,0]} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{gl(3) relations [E\\_ij,E\\_kl] = $\\delta$\\_jk E\\_il - $\\delta$\\_li E\\_kj for [3,1,0]} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{qdet: t3 = $\\chi$3 $\\nu$1(v)$\\nu$2(v-h)$\\nu$3(v-2h) (max rel. err, machine)} & \\text{1.6}\\times 10^{\\text{-14}} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{[t1, t2] = 0 (max rel. err, machine)} & \\text{1.95}\\times 10^{\\text{-16}} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{$\\Omega$zw$\\otimes$$\\Omega$zw left eigenvector of t\\_a(G') (max rel. resid, machine)} & \\text{2.39}\\times 10^{\\text{-13}} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{control [2,1,0]: CBR site-1 hits = T11, T21 at $\\theta$1-2h} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{control [2,1,0]: CBR site-2 hits = T11 at $\\theta$2+h} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{[3,1,0]: CBR site-1 hits = T11, T22, T32 at $\\theta$1-3h; site-2 = T11 at $\\theta$2+h} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{control [2,1,0] site 2: de… [latex truncated: 2698 chars total]",
