      {
       "data": "Out[2725]= \\begin{array}{|c|c|c|c|}\\hline\\Lambda  & \\text{qdet rel. err} & \\text{[t1,t2] rel. err} & \\text{$\\Omega$ eigencovector of t\\_a(G') resid}\\\\\\hline\\left\\{2,1,0\\right\\} & 9.098695122460241\\times 10^{-15} & 1.8581303921426077\\times 10^{-16} & 7.529876283061674\\times 10^{-14}\\\\\\hline\\left\\{3,1,0\\right\\} & 1.5967560358853874\\times 10^{-14} & 1.954857681189747\\times 10^{-16} & 2.3901083057471273\\times 10^{-13}\\\\\\hline\\end{array}",
