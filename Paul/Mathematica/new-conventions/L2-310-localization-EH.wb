      {
       "data": "Out[2701]= \\begin{array}{|c|c|}\\hline\\text{dim [3,1,0]} & 15\\\\\\hline\\text{R = sqrt(M) for [3,1,0]} & \\left\\{1,1,\\sqrt{2},\\sqrt{3},2\\,\\sqrt{6},4\\,\\sqrt{2},2,2\\,\\sqrt{3},2\\,\\sqrt{6},8,12\\,\\sqrt{2},24,6,8\\,\\sqrt{2},24\\right\\}\\\\\\hline\\text{EH\\^{}T = EH\\_ji} & \\mathrm{True}\\\\\\hline\\text{gl(3) relations} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
