       "data": "Out[2801]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{max locality residual, $\\varepsilon$ = 1/3, 20 w} & \\text{0} &  &  &  &  &  & \\\\\\hline\\mu  & \\text{dim} & \\text{site1} & \\text{site1+$\\Omega$} & \\text{site2} & \\text{site2+$\\Omega$} & \\text{site1+site2} & \\text{site1+site2+$\\Omega$}\\\\\\hline\\left\\{3,3,2\\right\\} & 18 & 10 & 12 & 7 & 9 & 16 & 18\\\\\\hline\\left\\{4,2,2\\right\\} & 14 & 10 & 12 & 7 & 9 & 14 & 14\\\\\\hline\\left\\{4,3,1\\right\\} & 10 & 7 & 8 & 5 & 6 & 10 & 10\\\\\\hline\\left\\{4,4,0\\right\\} & 3 & 3 & 3 & 2 & 2 & 3 & 3\\\\\\hline\\left\\{5,2,1\\right\\} & 6 & 6 & 6 & 5 & 6 & 6 & 6\\\\\\hline\\left\\{5,3,0\\right\\} & 2 & 2 & 2 & 2 & 2 & 2 & 2\\\\\\hline\\left\\{6,1,1\\right\\} & 2 & 2 & 2 & 2 & 2 & 2 & 2\\\\\\hline\\left\\{6,2,0\\right\\} & 1 & 1 & 1 & 1 & 1 & 1 & 1\\\\\\hline\\text{time (s)} & 1.816773 &  &  &  &  &  & \\\\\\hline\\end{array}",
