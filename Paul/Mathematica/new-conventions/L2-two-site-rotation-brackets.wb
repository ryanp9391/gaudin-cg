  {
   "kind": 2,
   "value": "(* Task 4b: the (infinity, infinity) family with w1 != w1': Phi = gaussCov[{a,0,a}] (x) gaussCov[{a',0,a'}], the w2, w2' -> infinity limit of Omega_c on each site (checked symbolically). Blocks, ranks, counts at three rational pairs (a, a') with a != a', identities on all states, the symbolic 2-parameter plane (generic ranks, rank-drop loci), comparison lines, and the explicit wedge decomposition at one point. *)\ncInf[a_] := Normal[gaussCov[{a, 0, a}]];\nchecks[\"limit: Omega_c = gaussVac[{a,s}] at s = 0 equals gaussCov[{a,0,a}] (symbolic, exact)\"] = (Expand /@ Normal[gaussVac[{aa, ss}]] /. ss -> 0) === Expand /@ Normal[gaussCov[{aa, 0, aa}]];\nchecks[\"limit: numerically, Omega_c[{w1, w2}] -> gaussCov[{1/w1,0,1/w1}] as w2 -> infinity (rel dev at w2 = 10^6, w1 = 3/2)\"] = Max[Abs[N[Ωc[{3/2, 10^6}] - cInf[2/3]]]]/Max[Abs[N[cInf[2/3]]]];\npts4b = {{2/3, -5/7}, {3/2, 1/4}, {-4/5, 7/3}};\nrowFor[name_, Φ_] := Module[{ph = phiMat[Φ], bg, info},\n  bg = blockOf[ph]; info = Association[Table[k -> blockInfo[bg[k]], {k, Keys[bg]}]];\n  <|\"name\" -> name, \"slots\" -> Table[info[k][\"slots\"], {k, Keys[bg]}], \"r\" -> Table[info[k][\"r\"], {k, Keys[bg]}], \"P\" -> Table[info[k][\"P\"], {k, Keys[bg]}], \"Prows\" -> Table[info[k][\"Prows\"], {k, Keys[bg]}], \"Pcols\" -> Table[info[k][\"Pcols\"], {k, Keys[bg]}],\n   \"exact\" -> Table[info[k][\"P\"] == info[k][\"r\"], {k, Keys[bg]}], \"sumR\" -> Total[#[\"r\"] & /@ Values[info]], \"sumP\" -> Total[#[\"P\"] & /@ Values[info]], \"bg\" -> bg|>];\nrowsInf = Table[rowFor[\"(inf,inf) a = \" <> ToString[p[[1]]] <> \", a' = \" <> ToString[p[[2]]], kron[cInf[p[[1]]], cInf[p[[2]]]]], {p, pts4b}];\nrowsCmp = {rowFor[\"gaussCov[{a,0,a}] x Om_c[w'] (a = 2/3)\", kron[cInf[2/3], Ωc[wP]]], rowFor[\"Om_c[w] x gaussCov[{a',0,a'}] (a' = -5/7)\", kron[Ωc[wN], cInf[-5/7]]], rowFor[\"vacuum Om_c[w] x Om_c[w]\", kron[Ωc[wN], Ωc[wN]]], rowFor[\"generic pair\", kron[covGen, covGen1]], rowFor[\"global rotation a = a' = 2/3 (w1' = w1, both w2 -> inf)\", kron[cInf[2/3], cInf[2/3]]]};\nidChk = With[{Φ = kron[cInf[pts4b[[1, 1]]], cInf[pts4b[[1, 2]]]]}, {idFull[Φ], idBlock[Φ, rowsInf[[1]][\"bg\"]]}];\n(* the symbolic 2-parameter plane *)\ncS1 = Expand /@ Normal[gaussCov[{aS, 0, aS}]]; cS2 = Expand /@ Normal[gaussCov[{bS, 0, bS}]];\nphPl = phiSym[cS1, cS2]; bgPl = blockOf[phPl];\nSeedRandom[71];\nrkPl = Max /@ Transpose[Table[Table[MatrixRank[bgPl[k] /. {aS -> rr[], bS -> rr[]}], {k, Keys[bgPl]}], {3}]];\ndropPl[A_, rk_] := Module[{tmp, f1, f2}, If[rk >= nMin, Return[{\"full rank\", {}}]];\n  tmp = Table[Module[{P = RandomInteger[{-3, 3}, {rk, nMin}], Q = RandomInteger[{-3, 3}, {nMin, rk}]}, TimeConstrained[Factor[Det[P . A . Q]], 200, $Failed]], {2}];\n  If[MemberQ[tmp, $Failed], Return[{\"timeout\", {}}]];\n  {f1, f2} = (DeleteCases[FactorList[#][[All, 1]], _?NumberQ] & /@ tmp);\n  {\"common factors\", Select[f1, MemberQ[f2, #] || MemberQ[f2, -#] &]}];\ndropRes = Table[k -> dropPl[bgPl[k], rkPl[[i]]], {i, Length[rkPl]}, {k, {Keys[bgPl][[i]]}}] // Flatten;\n(* rank / count on the lines a = a' (global rotation) and a = 0, a' = 0 *)\ncntPl[pt_] := Total[#[\"P\"] & /@ Values[Association[Table[k -> blockInfo[bgPl[k] /. pt], {k, Keys[bgPl]}]]]];\nplaneLines = {{\"a = a'\", Table[With[{v = rr[]}, cntPl[{aS -> v, bS -> v}]], {2}]}, {\"a = 0\", Table[cntPl[{aS -> 0, bS -> rr[]}], {2}]}, {\"a' = 0\", Table[cntPl[{aS -> rr[], bS -> 0}], {2}]}, {\"generic a != a'\", Table[cntPl[{aS -> rr[], bS -> rr[]}], {2}]}};\n(* explicit wedge decomposition at the first point if cheap *)\nwedgeList[bg_] := Table[k -> Module[{bc = blockCount[bg[k]]}, If[bc[[2]] == 0, {}, Table[{\"term \" <> ToString[kk], \"ladder-1 wedges (F,G)\" -> decompForm[bc[[4, All, kk]]], \"ladder-2 wedges (F,G)\" -> decompForm[bc[[5, kk]]]}, {kk, Length[bc[[5]]]}]]], {k, Keys[bg]}];\nwedges1 = If[rowsInf[[1]][\"sumP\"] <= 25, wedgeList[rowsInf[[1]][\"bg\"]], \"not computed (sum P > 25)\"];\nfmt[r_] := {r[\"name\"], r[\"slots\"], r[\"r\"], r[\"P\"], {r[\"Prows\"], r[\"Pcols\"]}, r[\"exact\"], r[\"sumR\"], r[\"sumP\"]};\nGrid[Join[{{\"case\", \"slots per block\", \"r per block\", \"P per block (min orientation)\", \"P rows / cols orientation\", \"P = r (all wedges)?\", \"sum r\", \"sum P\"}}, fmt /@ rowsInf, fmt /@ rowsCmp, {{\"identity at the first point: phi-form rel dev; block form {# products, rel dev}\", {N[idChk[[1]], 3], {idChk[[2, 1]], N[idChk[[2, 2]], 3]}}}, {\"limit checks\", {checks[\"limit: Omega_c = gaussVac[{a,s}] at s = 0 equals gaussCov[{a,0,a}] (symbolic, exact)\"], N[checks[\"limit: numerically, Omega_c[{w1, w2}] -> gaussCov[{1/w1,0,1/w1}] as w2 -> infinity (rel dev at w2 = 10^6, w1 = 3/2)\"], 3]}}, {\"plane (a, a'): generic ranks per block (max of 3 points)\", rkPl}, {\"plane: rank-drop hypersurface components per block (common factors of det(PAQ))\", dropRes}, {\"plane: sum P on the lines {a = a', a = 0, a' = 0} (2 random members each)\", planeLines}, {\"explicit wedge decomposition at (2/3, -5/7), per block (c,c'): terms k with ladder-1 / ladder-2 wedges {F, G} over the ladder points m = \" <> ToString[mPts], wedges1}}], Frame -> All, Alignment -> Left]",
