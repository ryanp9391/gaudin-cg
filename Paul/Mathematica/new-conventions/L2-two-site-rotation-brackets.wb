  {
   "kind": 2,
   "value": "(* Task 2: supports of Phi = c1 (x) c2 in the SoV basis (exact zero tests: phi is an exact rational matrix). The list phis is reused by Task 3 (and extended there by the R-dressed covectors). Vacuum family of the labels: F1 = F2 = {(lambda1|lambda1 c), c = 0..lambda2}. *)\nfamIdx = Table[First[Flatten[Position[labRule, grp[c]]]], {c, 0, Λ[[2]]}];\nphis = <||>;\nphis[\"a: generic pair g1 x g2\"] = kron[covGen, covGen1];\nphis[\"b: random covectors\"] = kron[covRnd, covRnd2];\nphis[\"c1: Om[w] x Om[w]\"] = kron[Ωc[wN], Ωc[wN]];\nphis[\"c2: Om[w'] x Om[w']\"] = kron[Ωc[wP], Ωc[wP]];\nphis[\"d1: Om[w] x Om[w']\"] = kron[Ωc[wN], Ωc[wP]];\nphis[\"d2: Om[w'] x Om[w]\"] = kron[Ωc[wP], Ωc[wN]];\nphis[\"e1: Om[w] x e1\"] = kron[Ωc[wN], e1];\nphis[\"e2: e1 x Om[w']\"] = kron[e1, Ωc[wP]];\nphis[\"f1: c1(g1) x e1\"] = kron[covGen, e1];\nphis[\"f2: e1 x c2(g2)\"] = kron[e1, covGen1];\nsuppSet[ph_] := Position[ph, x_ /; x =!= 0, {2}, Heads -> False];\ninfoSupp[ph_] := Module[{S = suppSet[ph], bg = blockOf[ph], X1, X2, U},\n  X1 = Table[Union[Select[S, #[[2]] == x2 &][[All, 1]]], {x2, d1}];\n  X2 = Table[Union[Select[S, #[[1]] == x1 &][[All, 2]]], {x1, d1}];\n  <|\"n\" -> Length[S], \"slots\" -> Table[Count[Flatten[bg[{c, cp}]], x_ /; x =!= 0], {c, 0, Λ[[2]]}, {cp, 0, Λ[[2]]}], \"nx1\" -> Length[Union[S[[All, 1]]]], \"nx2\" -> Length[Union[S[[All, 2]]]],\n   \"inF1\" -> Count[S, {x1_, _} /; MemberQ[famIdx, x1]], \"inF2\" -> Count[S, {_, x2_} /; MemberQ[famIdx, x2]],\n   \"x1sets\" -> {Length[Union[X1]], Min[Length /@ X1], Max[Length /@ X1]}, \"x2sets\" -> {Length[Union[X2]], Min[Length /@ X2], Max[Length /@ X2]},\n   \"inUnionFam\" -> AllTrue[S, MemberQ[famIdx, #[[1]]] || MemberQ[famIdx, #[[2]]] &], \"S\" -> S|>];\nsuppTab = Association[Table[k -> infoSupp[phiMat[phis[k]]], {k, Keys[phis]}]];\n(* is the support of c1 (x) c2 the union of the two one-site supports? *)\nSone = Union[suppTab[\"f1: c1(g1) x e1\"][\"S\"], suppTab[\"f2: e1 x c2(g2)\"][\"S\"]];\nchecks[\"support of the generic pair vs the union of the two one-site supports: {|S|, |S1 u S2|, S1 u S2 subset of S?, d2}\"] = {suppTab[\"a: generic pair g1 x g2\"][\"n\"], Length[Sone], SubsetQ[suppTab[\"a: generic pair g1 x g2\"][\"S\"], Sone], d2};\nchecks[\"one-site supports: c1 (x) e1 only x2 in F2? e1 (x) c2: n, # with x1 in F1\"] = {AllTrue[suppTab[\"f1: c1(g1) x e1\"][\"S\"], MemberQ[famIdx, #[[2]]] &], suppTab[\"f2: e1 x c2(g2)\"][\"n\"], suppTab[\"f2: e1 x c2(g2)\"][\"inF1\"]};\nGrid[Join[{{\"Phi\", \"# support pairs / d2\", \"populated slots per block (c rows, c' cols)\", \"# distinct x1, x2\", \"# pairs with x1 in F1, x2 in F2\", \"{# distinct x1-sets, min, max size} over x2\", \"{# distinct x2-sets, min, max size} over x1\", \"all pairs have x1 in F1 or x2 in F2\"}}, Table[{k, {suppTab[k][\"n\"], d2}, suppTab[k][\"slots\"], {suppTab[k][\"nx1\"], suppTab[k][\"nx2\"]}, {suppTab[k][\"inF1\"], suppTab[k][\"inF2\"]}, suppTab[k][\"x1sets\"], suppTab[k][\"x2sets\"], suppTab[k][\"inUnionFam\"]}, {k, Keys[phis]}], {{\"union of one-site supports check\", checks[\"support of the generic pair vs the union of the two one-site supports: {|S|, |S1 u S2|, S1 u S2 subset of S?, d2}\"], \"\", \"\", \"\", \"\", \"\", \"\"}, {\"one-site support structure\", checks[\"one-site supports: c1 (x) e1 only x2 in F2? e1 (x) c2: n, # with x1 in F1\"], \"\", \"\", \"\", \"\", \"\", \"\"}, {\"size of the family union {x1 in F1} u {x2 in F2} (pairs)\", 2 d1 (Λ[[2]] + 1) - (Λ[[2]] + 1)^2, \"\", \"\", \"\", \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
