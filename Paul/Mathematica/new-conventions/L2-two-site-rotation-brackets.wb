  {
   "kind": 2,
   "value": "(* Task 4: rank / count tables on the sub-families of the 4-parameter family (rational points; rank at a point of a sub-family is exact, \"generic on the sub-family\" is read off 4 random members each), a sampling of the generic family for the minimal count, and the hypersurface components of the rank-drop loci: for every block of generic rank r < nMin, det(P.A.Q) with random integer P (r x nMin), Q (nMin x r) vanishes on the drop locus; the common irreducible factors of two such determinants (up to scale) are the hypersurface components of the locus (codimension >= 2 pieces are only probed by the sub-family tables). Coordinates: a = 1/w1, s = 1/w2 (a1, s1 for w; a2, s2 for w'). *)\nSeedRandom[43];\nrr[] := Module[{x = 0}, While[x == 0, x = RandomInteger[{-40, 40}]/RandomInteger[{1, 9}]]; x];\nrrDistinct[n_] := Module[{v = Table[rr[], {n}]}, While[Length[DeleteDuplicates[Join[v, -v]]] < 2 n, v = Table[rr[], {n}]]; v];\nrandPt2[] := Thread[famVars -> rrDistinct[4]];\nptOn[rules_] := Module[{p = Association[randPt2[]]}, Do[p[r[[1]]] = If[MemberQ[famVars, r[[2]]], p[r[[2]]], r[[2]]], {r, rules}]; Normal[p]];\nfamSpecs = {{\"generic (4 parameters)\", {}}, {\"w' = w (a2=a1, s2=s1)\", {a2 -> a1, s2 -> s1}}, {\"w1' = w1 (a2=a1)\", {a2 -> a1}}, {\"w2' = w2 (s2=s1)\", {s2 -> s1}}, {\"w1' = w2 (a2=s1)\", {a2 -> s1}}, {\"w2' = w1 (s2=a1)\", {s2 -> a1}}, {\"w1' = w2 and w2' = w1 (swap)\", {a2 -> s1, s2 -> a1}}, {\"w1 = w2 (s1=a1)\", {s1 -> a1}}, {\"w1' = w2' (s2=a2)\", {s2 -> a2}}, {\"w2 -> inf (s1 = 0)\", {s1 -> 0}}, {\"w2' -> inf (s2 = 0)\", {s2 -> 0}}, {\"w2, w2' -> inf (s1 = s2 = 0)\", {s1 -> 0, s2 -> 0}}, {\"w1' = w1, w2 -> inf (a2=a1, s1=0)\", {a2 -> a1, s1 -> 0}}, {\"w1' = w1, w2' -> inf (a2=a1, s2=0)\", {a2 -> a1, s2 -> 0}}, {\"w1' = w1, w2, w2' -> inf (a2=a1, s1=s2=0)\", {a2 -> a1, s1 -> 0, s2 -> 0}}, {\"w1' = w1 = w2' (a2=a1, s2=a1)\", {a2 -> a1, s2 -> a1}}, {\"w2' -> inf, w1' = w2 (s2=0, a2=s1)\", {s2 -> 0, a2 -> s1}}, {\"w2' -> inf, w1 = w2 (s2=0, s1=a1)\", {s2 -> 0, s1 -> a1}}, {\"w1 -> inf, w1' -> inf (a1 = a2 = 0, trivial: both covectors = e1 up to E23)\", {a1 -> 0, a2 -> 0}}};\nblocksAt[pt_] := Association[Table[k -> blockInfo[bgFam[k] /. pt], {k, Keys[bgFam]}]];\n{tims[\"family: sub-family tables\"], famTab} = AbsoluteTiming[Table[Module[{samp = Table[blocksAt[ptOn[spec[[2]]]], {4}]}, {spec[[1]], Table[{Min[#], Max[#]} &[Table[samp[[i]][k][\"r\"], {i, 4}]], {k, Keys[bgFam]}], {Min[#], Max[#]} &[Table[Total[#[\"r\"] & /@ Values[samp[[i]]]], {i, 4}]], {Min[#], Max[#]} &[Table[Total[#[\"P\"] & /@ Values[samp[[i]]]], {i, 4}]], Table[Table[samp[[i]][k][\"P\"], {i, 4}], {k, Keys[bgFam]}]}], {spec, famSpecs}]];\n(* sampling the generic family for the minimal count *)\n{tims[\"family: 40 generic samples\"], genSamp} = AbsoluteTiming[Tally[Table[Total[#[\"P\"] & /@ Values[blocksAt[randPt2[]]]], {40}]]];\n(* hypersurface components of the rank-drop loci *)\nrkMax = Max /@ Transpose[rkGenFam];\n(* compact display of a factor: short ones verbatim, long ones as {total degree, # terms, variables} *)\nfmtF[f_, vars_] := If[LeafCount[f] < 40, f, {\"degree \" <> ToString[Max[Total /@ CoefficientRules[f, vars][[All, 1]]]], ToString[Length[CoefficientRules[f, vars]]] <> \" terms\", Select[vars, Not[FreeQ[f, #]] &]}];\ndropData[A_, rk_, vars_] := Module[{f1, f2, tmp, line, Ax, xx, degs},\n  If[rk >= nMin, Return[{\"full rank\", {}}]];\n  If[rk > 7,\n   (* large rank: the determinant of the polynomial matrix is too big; restrict to a random line (x -> base + x dir) and report the degrees of the common factors of two det(P A Q) (degree of the drop hypersurface section) *)\n   line = Thread[vars -> (RandomInteger[{-4, 4}, Length[vars]] + xx RandomInteger[{-3, 3}, Length[vars]])];\n   Ax = A /. line;\n   tmp = Table[Module[{P = RandomInteger[{-3, 3}, {rk, nMin}], Q = RandomInteger[{-3, 3}, {nMin, rk}]}, TimeConstrained[Factor[Det[P . Ax . Q]], 150, $Failed]], {2}];\n   If[MemberQ[tmp, $Failed], Return[{\"timeout (line section)\", {}}]];\n   {f1, f2} = (DeleteCases[FactorList[#][[All, 1]], _?NumberQ] & /@ tmp);\n   Return[{\"line section: degrees of common factors (the line meets the drop hypersurface in these points)\", Exponent[#, xx] & /@ Select[f1, MemberQ[f2, #] || MemberQ[f2, -#] &]}]];\n  tmp = Table[Module[{P = RandomInteger[{-3, 3}, {rk, nMin}], Q = RandomInteger[{-3, 3}, {nMin, rk}]}, TimeConstrained[Factor[Det[P . A . Q]], 150, $Failed]], {2}];\n  If[MemberQ[tmp, $Failed], Return[{\"timeout\", {}}]];\n  {f1, f2} = (DeleteCases[FactorList[#][[All, 1]], _?NumberQ] & /@ tmp);\n  {\"common factors\", fmtF[#, vars] & /@ Select[f1, MemberQ[f2, #] || MemberQ[f2, -#] &]}];\n{tims[\"family: drop loci\"], dropTab} = AbsoluteTiming[Table[k -> dropData[bgFam[k], rkMax[[i]], famVars], {i, Length[rkMax]}, {k, {Keys[bgFam][[i]]}}] // Flatten];\nGrid[Join[{{\"sub-family\", \"r_cc' (min, max over 4 members) per block\", \"sum r (min, max)\", \"sum P (min, max)\", \"P per block, 4 members\"}}, famTab, {{\"generic family, 40 samples: Tally of sum P\", genSamp, \"\", \"\", \"\"}, {\"hypersurface components of the rank-drop loci per block: common factors of det(P A Q)\", dropTab, \"\", \"\", \"\"}, {\"times (s): tables, samples, drop loci\", {tims[\"family: sub-family tables\"], tims[\"family: 40 generic samples\"], tims[\"family: drop loci\"]}, \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
