   "value": "*Printed output of the code cell `c22_driver` (evaluated in the shared kernel from exactly the saved source; not a native notebook output).*\n\n**[2,1,0] run** (rows of the printed `Grid`, InputForm; first entry = cell id, second = time in s):\n\n```\n{\"c22_driver\", 8.72, {{\"point\", \"t = theta12/h\", \"Kt identical to the base one (z-test points)\", \"# support states of the nu1 = 1 slice\", \"dim of R solution space\", \n   \"conic constants of the dressed locus; cc1(-t)\", \"dressed conic count points {cc, ., ., count}\", \"dressed generic count; undressed generic count\", \"sum P: generic pair, vacuum, Om[w] x Om[w']\", \n   \"max |R - 1|\", \"time (s)\"}, {\"base\", 62/35, \"-\", 64, 1, {{167/264}, 167/264, True}, {{167/264, {\"cc1(-t)\"}, {4, -326/33, 5}, 4}}, {5, 17}, {23, 18, 22}, 0.8593727626053027328, 1.458186}, \n  {\"z' = (3/2,5/4,3/7)\", 62/35, True, 64, 1, {{167/264}, 167/264, True}, {{167/264, {\"cc1(-t)\"}, {4, -326/33, 5}, 4}}, {5, 17}, {23, 18, 22}, 0.8593727626053027328, 1.4362553}, \n  {\"z'' = (2,5/4,2/3)\", 62/35, True, 64, 1, {{167/264}, 167/264, True}, {{167/264, {\"cc1(-t)\"}, {4, -326/33, 5}, 4}}, {5, 17}, {23, 18, 22}, 0.8593727626053027328, 1.4531769}, \n  {\"h=1/3, th=(1/5,-4/9)\", 29/15, \"-\", 64, 1, {{37/59}, 37/59, True}, {{37/59, {\"cc1(-t)\"}, {4, -588/59, 5}, 4}}, {5, 17}, {23, 18, 22}, 0.8327981907527362073, 1.4383304}, \n  {\"h=1/2, th=(3/7,-1/4)\", 19/14, \"-\", 64, 1, {{61/94}, 61/94, True}, {{61/94, {\"cc1(-t)\"}, {4, -452/47, 5}, 4}}, {5, 17}, {23, 18, 22}, 0.9327853798792695961, 1.4503674}, \n  {\"th2 = -100 (large t: R -> 1 check)\", 1404/7, \"-\", 64, 1, {{1425/2836}, 1425/2836, True}, {{1425/2836, {\"cc1(-t)\"}, {4, -8480/709, 5}, 4}}, {5, 17}, {23, 18, 22}, 0.0196732509331372925, \n   1.4685102}, {\"total (s)\", 8.7090583, \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"}}}\n```\n\n**[3,1,0] run** (rows of the printed `Grid`, InputForm; first entry = cell id, second = time in s):\n\n```\n{\"c22_driver\", 123.96000000000001, {{\"point\", \"t = theta12/h\", \"Kt identical to the base one (z-test points)\", \"# support states of the nu1 = 1 slice\", \"dim of R solution space\", \n   \"conic constants of the dressed locus; cc1(-t)\", \"dressed conic count points {cc, ., ., count}\", \"dressed generic count; undressed generic count\", \"sum P: generic pair, vacuum, Om[w] x Om[w']\", \n   \"max |R - 1|\", \"time (s)\"}, {\"base\", 62/35, \"-\", 225, 1, {{1, 404/501, 167/264, 3371/7348, 101/66}, 167/264, True}, \n   {{1, {\"vacuum family cc = 1\"}, {4, -4, 5}, 5}, {404/501, {}, {4, -3556/501, 5}, 7}, {167/264, {\"cc1(-t)\"}, {4, -326/33, 5}, 7}, {3371/7348, {}, {4, -23256/1837, 5}, 7}, \n    {101/66, {}, {4, 148/33, 5}, 6}}, {7, 40}, {54, 40, 54}, 1.0168697282099343955, 17.3858384}, {\"z' = (3/2,5/4,3/7)\", 62/35, True, 225, 1, \n   {{1, 404/501, 167/264, 3371/7348, 101/66}, 167/264, True}, {{1, {\"vacuum family cc = 1\"}, {4, -4, 5}, 5}, {404/501, {}, {4, -3556/501, 5}, 7}, {167/264, {\"cc1(-t)\"}, {4, -326/33, 5}, 7}, \n    {3371/7348, {}, {4, -23256/1837, 5}, 7}, {101/66, {}, {4, 148/33, 5}, 6}}, {7, 40}, {54, 40, 54}, 1.0168697282099343955, 17.2852844}, \n  {\"z'' = (2,5/4,2/3)\", 62/35, True, 225, 1, {{1, 404/501, 167/264, 3371/7348, 101/66}, 167/264, True}, {{1, {\"vacuum family cc = 1\"}, {4, -4, 5}, 5}, {404/501, {}, {4, -3556/501, 5}, 7}, \n    {167/264, {\"cc1(-t)\"}, {4, -326/33, 5}, 7}, {3371/7348, {}, {4, -23256/1837, 5}, 7}, {101/66, {}, {4, 148/33, 5}, 6}}, {7, 40}, {54, 40, 54}, 1.0168697282099343955, 17.2332214}, \n  {\"h=1/3, th=(1/5,-4/9)\", 29/15, \"-\", 225, 1, {{1, 89/111, 37/59, 2963/6549, 89/59}, 37/59, True}, {{1, {\"vacuum family cc = 1\"}, {4, -4, 5}, 5}, {89/111, {}, {4, -796/111, 5}, 7}, \n    {37/59, {\"cc1(-t)\"}, {4, -588/59, 5}, 7}, {2963/6549, {}, {4, -83572/6549, 5}, 7}, {89/59, {}, {4, 244/59, 5}, 6}}, {7, 40}, {54, 40, 54}, 1.0053929121725731895, 17.5460908}, \n  {\"h=1/2, th=(3/7,-1/4)\", 19/14, \"-\", 225, 1, {{1, 50/61, 61/94, 1371/2867, 75/47}, 61/94, True}, {{1, {\"vacuum family cc = 1\"}, {4, -4, 5}, 5}, {50/61, {}, {4, -420/61, 5}, 7}, \n    {61/94, {\"cc1(-t)\"}, {4, -452/47, 5}, 7}, {1371/2867, {}, {4, -35404/2867, 5}, 7}, {75/47, {}, {4, 260/47, 5}, 6}}, {7, 40}, {54, 40, 54}, 1.1641365297071293203, 19.8421197}, \n  {\"th2 = -100 (large t: R -> 1 check)\", 1404/7, \"-\", 225, 1, {{1, 2864/4275, 1425/2836, 2030723/6061950, 716/709}, 1425/2836, True}, \n   {{1, {\"vacuum family cc = 1\"}, {4, -4, 5}, 5}, {2864/4275, {}, {4, -39676/4275, 5}, 7}, {1425/2836, {\"cc1(-t)\"}, {4, -8480/709, 5}, 7}, {2030723/6061950, {}, {4, -44373716/3030975, 5}, 7}, \n    {716/709, {}, {4, -2724/709, 5}, 6}}, {7, 40}, {54, 40, 54}, 0.0437283764733808004, 34.6637099}, {\"total (s)\", 123.9526858, \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"}}}\n```",
