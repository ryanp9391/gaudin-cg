  {
   "kind": 2,
   "value": "(* DRIVER: z-independence of the two-site K tensor and (h, theta)-dependence of the R-dressed data. RUN LAST: this cell wipes Global`* (it re-runs the setup, K, tools, R and dressed-locus cells with other parameter lines, read from this notebook's own file); all data live in the context Dr`. Afterwards re-run the cells above to restore the base state of the chosen rep. Each point is under a 600 s guard. *)\nDr`nbFile = \"C:/Users/pryan/git-projects/gaudin-cg/Paul/Mathematica/new-conventions/L2-two-site-rotation-brackets.wb\";\nDr`tmp = StringReplace[Dr`nbFile, \".wb\" -> \"-driver-tmp.wl\"];\nDr`codeCells := Dr`codeCells = Select[Import[Dr`nbFile, \"RawJSON\"][\"cells\"], #[\"kind\"] == 2 &][[All, \"value\"]];\nDr`pick[s_String] := First[Select[Dr`codeCells, StringContainsQ[#, s] &]];\nDr`seq = {\"the ONLY rep switch\", \"eigenstates of the twisted chain\", \"dual Q's: Q^j(x)\", \"physical-space Gauss factors\", \"untwisted L=2 B(u)\", \"Task 1: SoV wavefunction rule\", \"Task 0: the one-site vacuum covector\", \"Task 1: the two-site K tensor\", \"Task 1 regression: the slices\", \"Tools for Tasks 2-5\", \"Task 2: supports of Phi\", \"Task 2b: the Yangian R-matrix\", \"Task 2b test: the R-dressed\", \"Task 2b, loci of the dressed covector\"};\nDr`ev[txt_String] := (Export[Dr`tmp, txt, \"Text\", CharacterEncoding -> \"UTF-8\"]; Get[Dr`tmp, CharacterEncoding -> \"UTF-8\"]);\nDr`lamStr = ToString[Λ, InputForm];\n(* NB: no Module locals here: the first setup cell wipes Global` and with it every Module variable *)\nDr`run[hs_String, ths_String, zs_String] := (Dr`t0 = AbsoluteTime[];\n  Dr`subs = {\"Λ = {2, 1, 0};\" -> \"Λ = \" <> Dr`lamStr <> \";\", \"hN = 1/2; thN = {2/7, -3/5}; zN = {3/2, 5/4, 2/3};\" -> \"hN = \" <> hs <> \"; thN = \" <> ths <> \"; zN = \" <> zs <> \";\"};\n  Scan[Dr`ev[StringReplace[Dr`pick[#], Dr`subs]] &, Dr`seq];\n  <|\"t\" -> ToExpression[\"tPar\"], \"Kt\" -> ToExpression[\"Kt\"], \"nR\" -> ToExpression[\"Length[nsR]\"], \"conic\" -> ToExpression[\"conicTabD[[All, 2]]\"], \"cc1m\" -> ToExpression[\"cc1[-tPar]\"], \"cntConic\" -> ToExpression[\"cntConic\"], \"cntGenD\" -> ToExpression[\"cntGenD\"],\n    \"supp\" -> ToExpression[\"Length[Select[Range[nS], Max[Abs[Normal[Kt[[All, #]]]]] > 0 &]]\"],\n    \"pairs\" -> ToExpression[\"Table[Total[#[\\\"P\\\"] & /@ Values[Association[Table[k -> blockInfo[blockOf[phiMat[ph]][k]], {k, Keys[blockOf[phiMat[ph]]]}]]]], {ph, {kron[covGen, covGen1], kron[Ωc[wN], Ωc[wN]], kron[Ωc[wN], Ωc[wP]]}}]\"],\n    \"dressedGen\" -> ToExpression[\"perLabelCount[phiMat[kron[e1, covGen1] . Rm], 2]\"], \"undressedGen\" -> ToExpression[\"perLabelCount[phiMat[kron[e1, covGen1]], 2]\"],\n    \"RmId\" -> ToExpression[\"N[Max[Abs[Normal[Rm - id2]]], 4]\"], \"time\" -> AbsoluteTime[] - Dr`t0|>);\n(* parameter points: (h, theta, z); the first is the base point of the notebook *)\nDr`pts = {{\"base\", \"1/2\", \"{2/7, -3/5}\", \"{3/2, 5/4, 2/3}\"}, {\"z' = (3/2,5/4,3/7)\", \"1/2\", \"{2/7, -3/5}\", \"{3/2, 5/4, 3/7}\"}, {\"z'' = (2,5/4,2/3)\", \"1/2\", \"{2/7, -3/5}\", \"{2, 5/4, 2/3}\"}, {\"h=1/3, th=(1/5,-4/9)\", \"1/3\", \"{1/5, -4/9}\", \"{3/2, 5/4, 2/3}\"}, {\"h=1/2, th=(3/7,-1/4)\", \"1/2\", \"{3/7, -1/4}\", \"{3/2, 5/4, 2/3}\"}, {\"th2 = -100 (large t: R -> 1 check)\", \"1/2\", \"{2/7, -100}\", \"{3/2, 5/4, 2/3}\"}};\nDr`runSafe[i_] := With[{r = TimeConstrained[AbsoluteTiming[Dr`run[Dr`pts[[i, 2]], Dr`pts[[i, 3]], Dr`pts[[i, 4]]]], 600, $Failed]}, If[r === $Failed, Nothing, Dr`pts[[i, 1]] -> r[[2]]]];\n{Dr`tAll, Dr`res} = AbsoluteTiming[Association[Table[Dr`runSafe[i], {i, Length[Dr`pts]}]]];\nDr`KtBase = Dr`res[\"base\"][\"Kt\"];\nDr`zTest = Table[{k, Dr`res[k][\"Kt\"] === Dr`KtBase}, {k, {\"z' = (3/2,5/4,3/7)\", \"z'' = (2,5/4,2/3)\"}}];\nGrid[Join[{{\"point\", \"t = theta12/h\", \"Kt identical to the base one (z-test points)\", \"# support states of the nu1 = 1 slice\", \"dim of R solution space\", \"conic constants of the dressed locus; cc1(-t)\", \"dressed conic count points {cc, ., ., count}\", \"dressed generic count; undressed generic count\", \"sum P: generic pair, vacuum, Om[w] x Om[w']\", \"max |R - 1|\", \"time (s)\"}}, Table[{k, Dr`res[k][\"t\"], If[StringStartsQ[k, \"z\"], Dr`res[k][\"Kt\"] === Dr`KtBase, \"-\"], Dr`res[k][\"supp\"], Dr`res[k][\"nR\"], {Dr`res[k][\"conic\"], Dr`res[k][\"cc1m\"], MemberQ[Dr`res[k][\"conic\"], Dr`res[k][\"cc1m\"]]}, Dr`res[k][\"cntConic\"], {Dr`res[k][\"dressedGen\"], Dr`res[k][\"undressedGen\"]}, Dr`res[k][\"pairs\"], Dr`res[k][\"RmId\"], N[Dr`res[k][\"time\"], 3]}, {k, Keys[Dr`res]}], {{\"total (s)\", Dr`tAll, \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
