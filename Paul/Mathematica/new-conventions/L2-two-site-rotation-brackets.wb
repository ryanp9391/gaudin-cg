   "kind": 1,
   "value": "*Printed output of the code cell `c12_t2_supports` (evaluated in the shared kernel from exactly the saved source; not a native notebook output).*\n\n**[2,1,0] run** (rows of the printed `Grid`, InputForm; first entry = cell id, second = time in s):\n\n```\n{\"c12_t2_supports\", 0.06, {{\"Phi\", \"# support pairs / d2\", \"populated slots per block (c rows, c' cols)\", \"# distinct x1, x2\", \"# pairs with x1 in F1, x2 in F2\", \n   \"{# distinct x1-sets, min, max size} over x2\", \"{# distinct x2-sets, min, max size} over x1\", \"all pairs have x1 in F1 or x2 in F2\"}, \n  {\"a: generic pair g1 x g2\", {64, 64}, {{25, 15}, {15, 9}}, {8, 8}, {16, 16}, {1, 8, 8}, {1, 8, 8}, False}, {\"b: random covectors\", {64, 64}, {{25, 15}, {15, 9}}, {8, 8}, {16, 16}, {1, 8, 8}, \n   {1, 8, 8}, False}, {\"c1: Om[w] x Om[w]\", {64, 64}, {{25, 15}, {15, 9}}, {8, 8}, {16, 16}, {1, 8, 8}, {1, 8, 8}, False}, \n  {\"c2: Om[w'] x Om[w']\", {64, 64}, {{25, 15}, {15, 9}}, {8, 8}, {16, 16}, {1, 8, 8}, {1, 8, 8}, False}, {\"d1: Om[w] x Om[w']\", {64, 64}, {{25, 15}, {15, 9}}, {8, 8}, {16, 16}, {1, 8, 8}, {1, 8, 8}, \n   False}, {\"d2: Om[w'] x Om[w]\", {64, 64}, {{25, 15}, {15, 9}}, {8, 8}, {16, 16}, {1, 8, 8}, {1, 8, 8}, False}, {\"e1: Om[w] x e1\", {12, 64}, {{3, 5}, {1, 3}}, {8, 2}, {4, 12}, {3, 0, 8}, {2, 1, 2}, \n   True}, {\"e2: e1 x Om[w']\", {35, 64}, {{8, 10}, {10, 7}}, {8, 8}, {15, 15}, {8, 1, 8}, {7, 1, 8}, False}, {\"f1: c1(g1) x e1\", {12, 64}, {{3, 5}, {1, 3}}, {8, 2}, {4, 12}, {3, 0, 8}, {2, 1, 2}, \n   True}, {\"f2: e1 x c2(g2)\", {35, 64}, {{8, 10}, {10, 7}}, {8, 8}, {15, 15}, {8, 1, 8}, {7, 1, 8}, False}, {\"union of one-site supports check\", {64, 35, True, 64}, \"\", \"\", \"\", \"\", \"\", \"\"}, \n  {\"one-site support structure\", {True, 35, 15}, \"\", \"\", \"\", \"\", \"\", \"\"}, {\"size of the family union {x1 in F1} u {x2 in F2} (pairs)\", 28, \"\", \"\", \"\", \"\", \"\", \"\"}}}\n```\n\n**[3,1,0] run** (rows of the printed `Grid`, InputForm; first entry = cell id, second = time in s):\n\n```\n{\"c12_t2_supports\", 0.07, {{\"Phi\", \"# support pairs / d2\", \"populated slots per block (c rows, c' cols)\", \"# distinct x1, x2\", \"# pairs with x1 in F1, x2 in F2\", \n   \"{# distinct x1-sets, min, max size} over x2\", \"{# distinct x2-sets, min, max size} over x1\", \"all pairs have x1 in F1 or x2 in F2\"}, \n  {\"a: generic pair g1 x g2\", {225, 225}, {{81, 54}, {54, 36}}, {15, 15}, {30, 30}, {1, 15, 15}, {1, 15, 15}, False}, {\"b: random covectors\", {225, 225}, {{81, 54}, {54, 36}}, {15, 15}, {30, 30}, \n   {1, 15, 15}, {1, 15, 15}, False}, {\"c1: Om[w] x Om[w]\", {225, 225}, {{81, 54}, {54, 36}}, {15, 15}, {30, 30}, {1, 15, 15}, {1, 15, 15}, False}, \n  {\"c2: Om[w'] x Om[w']\", {225, 225}, {{81, 54}, {54, 36}}, {15, 15}, {30, 30}, {1, 15, 15}, {1, 15, 15}, False}, {\"d1: Om[w] x Om[w']\", {225, 225}, {{81, 54}, {54, 36}}, {15, 15}, {30, 30}, \n   {1, 15, 15}, {1, 15, 15}, False}, {\"d2: Om[w'] x Om[w]\", {225, 225}, {{81, 54}, {54, 36}}, {15, 15}, {30, 30}, {1, 15, 15}, {1, 15, 15}, False}, \n  {\"e1: Om[w] x e1\", {24, 225}, {{6, 9}, {3, 6}}, {15, 2}, {4, 24}, {3, 0, 15}, {2, 1, 2}, True}, {\"e2: e1 x Om[w']\", {101, 225}, {{25, 27}, {27, 22}}, {15, 15}, {28, 28}, {13, 1, 14}, {11, 1, 14}, \n   False}, {\"f1: c1(g1) x e1\", {24, 225}, {{6, 9}, {3, 6}}, {15, 2}, {4, 24}, {3, 0, 15}, {2, 1, 2}, True}, {\"f2: e1 x c2(g2)\", {103, 225}, {{25, 28}, {28, 22}}, {15, 15}, {29, 29}, {13, 1, 15}, \n   {11, 1, 15}, False}, {\"union of one-site supports check\", {225, 103, True, 225}, \"\", \"\", \"\", \"\", \"\", \"\"}, {\"one-site support structure\", {True, 103, 29}, \"\", \"\", \"\", \"\", \"\", \"\"}, \n  {\"size of the family union {x1 in F1} u {x2 in F2} (pairs)\", 56, \"\", \"\", \"\", \"\", \"\", \"\"}}}\n```",
