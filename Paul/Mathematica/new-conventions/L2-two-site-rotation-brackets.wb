  {
   "kind": 2,
   "value": "(* Task 1: SoV wavefunction rule. <x_m|Psi_B>/<x0|Psi_B> = N_m prod_s M^(s)_m / (vacuum), M_(a|bc) = det2[v(theta - (1+a)h), v(theta - b h)]_rows . v_k(theta - c h), N_m state independent. All 225 states, three (rows, k) conventions. *)\n{tims[\"SoV overlaps with kets\"], ovlM} = AbsoluteTiming[vecB . Transpose[ketC]];\nratioM = Table[ovlM[[m, A]]/(x0C . ketC[[A]]), {m, nS}, {A, nS}];\nlabIdx[l_] := First[Flatten[Position[labRule, l]]];\nsiteIdx = Table[{labIdx[allLabs[[m, 1]]], labIdx[allLabs[[m, 2]]]}, {m, nS}];\n(* det2[v(m21), v(m1)] v_k(m22) on rows {a,b}: one value per state, site, label *)\nsiteMono[rows_, k_] := Table[Table[With[{m1 = l[[1]], m21 = l[[2]], m22 = l[[3]]}, (vm[A, s, m21][[rows[[1]]]] vm[A, s, m1][[rows[[2]]]] - vm[A, s, m21][[rows[[2]]]] vm[A, s, m1][[rows[[1]]]]) vm[A, s, m22][[k]]], {l, labRule}], {A, nS}, {s, nL}];\nwfTest[rows_, k_] := Module[{sm = siteMono[rows, k], pred, rr, mask, worst, nExcl, bestA, Nrow},\n  pred = Table[Product[sm[[A, s, siteIdx[[m, s]]]], {s, nL}], {m, nS}, {A, nS}];\n  pred = Table[pred[[m, A]]/pred[[vacIdx, A]], {m, nS}, {A, nS}];\n  rr = ratioM/pred;\n  bestA = Table[Ordering[Abs[pred[[m]]], -1][[1]], {m, nS}];\n  Nrow = Table[rr[[m, bestA[[m]]]], {m, nS}];\n  worst = Table[Max[Abs[rr[[m]]/Nrow[[m]] - 1]], {m, nS}];\n  {Max[worst], Min[Abs[pred]], Nrow}];\n{tims[\"wavefunction tests (3 conventions)\"], wfRes} = AbsoluteTiming[Table[wfTest @@ rk, {rk, {{{1, 2}, 1}, {{2, 3}, 3}, {{1, 3}, 2}}}]];\nchecks[\"wavefunction rule M_x (rows {1,2},k=1; {2,3},3; {1,3},2): max rel dev over 225 labels x 225 states\"] = wfRes[[All, 1]];\nNm = wfRes[[2, 3]];\nchecks[\"N_m the same for all three conventions (max rel diff)\"] = Max[Abs[wfRes[[1, 3]]/wfRes[[2, 3]] - 1], Abs[wfRes[[3, 3]]/wfRes[[2, 3]] - 1]];\nGrid[{{\"max rel dev of <x_m|Psi_B>/<x0|Psi_B> vs N_m prod M (rows12 k1, rows23 k3, rows13 k2)\", N[wfRes[[All, 1]], 3]}, {\"min |predicted ratio| (zero-division guard)\", N[wfRes[[All, 2]], 3]}, {\"N_m identical across conventions (max rel diff)\", N[checks[\"N_m the same for all three conventions (max rel diff)\"], 3]}, {\"N_m: min, max abs\", N[{Min[Abs[Nm]], Max[Abs[Nm]]}, 4]}, {\"time (s): overlaps, tests\", {tims[\"SoV overlaps with kets\"], tims[\"wavefunction tests (3 conventions)\"]}}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [],
