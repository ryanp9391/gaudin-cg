  },
  {
   "kind": 2,
   "value": "(* Task 5: one-site-fixed slices. (A) site 2 fixed at Omega_c[w'], site 1 free: g1 = (gA, gB, gC) in the Gauss chart; the blocks are polynomial matrices in 3 variables (linear in the GT components of c1). (B) site 1 fixed at Omega_c[w], site 2 free. Rank-drop hypersurfaces per block (common factors of det(P A Q) for two random integer P, Q; coordinate hyperplanes are the trivial ones), then rank and count tables at 3 random members of named loci: the vacuum family b3 = alpha^2 (beta + alpha gamma = alpha^2), b3 = 0, the conics (beta + alpha gamma) = cc alpha^2 with cc = cc1(t) (adjoint site-1 quadric), cc1(-t) (dressed site 2), cc1(1-t) (undressed site 2, Stage A), beta = 0, and the cross loci alpha = alpha' (common w1, resp. w1) with and without the vacuum condition. *)\nSeedRandom[53];\nc2N = Ωc[wP]; c1N = Ωc[wN];\n{tims[\"one-site-fixed: symbolic phi (A) and (B)\"], {phA, phB}} = AbsoluteTiming[{phiSym[gaussCovS, c2N], phiSym[c1N, gaussCovS]}];\nbgA = blockOf[phA]; bgB = blockOf[phB];\nchecks[\"one-site-fixed: symbolic phi (A) at a rational point = numeric phi of (g1, Omega_c[w']) (exact)\"] = (phA /. Thread[gVars -> gen0]) === phiMat[kron[covGen, c2N]];\nchecks[\"one-site-fixed: symbolic phi (B) at a rational point = numeric phi of (Omega_c[w], g2) (exact)\"] = (phB /. Thread[gVars -> gen1]) === phiMat[kron[c1N, covGen1]];\naP = 1/wP[[1]]; aN = 1/wN[[1]];\nccList = DeleteDuplicates[{cc1[tPar], cc1[-tPar], cc1[1 - tPar]}];\nlocSpecsA = {{\"generic g1\", {}}, {\"vacuum family b3 = alpha^2\", {gB -> gA^2 - gA gC}}, {\"b3 = 0\", {gB -> -gA gC}}, {\"conic cc1(t)\", {gB -> cc1[tPar] gA^2 - gA gC}}, {\"conic cc1(-t)\", {gB -> cc1[-tPar] gA^2 - gA gC}}, {\"conic cc1(1-t)\", {gB -> cc1[1 - tPar] gA^2 - gA gC}}, {\"beta = 0\", {gB -> 0}}, {\"alpha = alpha' (surface)\", {gA -> aP}}, {\"alpha = alpha' and vacuum family\", {gA -> aP, gB -> aP^2 - aP gC}}, {\"alpha = alpha', beta = 0\", {gA -> aP, gB -> 0}}};\nlocSpecsB = {{\"generic g2\", {}}, {\"vacuum family b3 = alpha^2\", {gB -> gA^2 - gA gC}}, {\"b3 = 0\", {gB -> -gA gC}}, {\"conic cc1(t)\", {gB -> cc1[tPar] gA^2 - gA gC}}, {\"conic cc1(-t)\", {gB -> cc1[-tPar] gA^2 - gA gC}}, {\"conic cc1(1-t)\", {gB -> cc1[1 - tPar] gA^2 - gA gC}}, {\"beta = 0\", {gB -> 0}}, {\"alpha = alpha (w1' = w1, surface)\", {gA -> aN}}, {\"alpha = alpha and vacuum family\", {gA -> aN, gB -> aN^2 - aN gC}}, {\"alpha = alpha, beta = 0\", {gA -> aN, gB -> 0}}};\nptOnG[rules_] := Module[{p = Association[Thread[gVars -> rrDistinct[3]]]}, Do[p[r[[1]]] = r[[2]] /. Normal[p], {r, rules}]; Normal[p]];\nblocksAtG[bg_, pt_] := Association[Table[k -> blockInfo[bg[k] /. pt], {k, Keys[bg]}]];\ntableFor[bg_, specs_] := Table[Module[{samp = Table[blocksAtG[bg, ptOnG[spec[[2]]]], {3}]}, {spec[[1]], Table[{Min[#], Max[#]} &[Table[samp[[i]][k][\"r\"], {i, 3}]], {k, Keys[bg]}], {Min[#], Max[#]} &[Table[Total[#[\"P\"] & /@ Values[samp[[i]]]], {i, 3}]]}], {spec, specs}];\n{tims[\"one-site-fixed: loci tables\"], {tabA, tabB}} = AbsoluteTiming[{tableFor[bgA, locSpecsA], tableFor[bgB, locSpecsB]}];\nrkGenA = Max /@ Transpose[Table[Table[MatrixRank[bgA[k] /. ptOnG[{}]], {k, Keys[bgA]}], {3}]];\nrkGenB = Max /@ Transpose[Table[Table[MatrixRank[bgB[k] /. ptOnG[{}]], {k, Keys[bgB]}], {3}]];\n{tims[\"one-site-fixed: drop loci\"], {dropA, dropB}} = AbsoluteTiming[{Table[Keys[bgA][[i]] -> dropData[bgA[Keys[bgA][[i]]], rkGenA[[i]], gVars], {i, Length[rkGenA]}], Table[Keys[bgB][[i]] -> dropData[bgB[Keys[bgB][[i]]], rkGenB[[i]], gVars], {i, Length[rkGenB]}]}];\nGrid[{{\"symbolic phi (A), (B) agree with numerics\", {checks[\"one-site-fixed: symbolic phi (A) at a rational point = numeric phi of (g1, Omega_c[w']) (exact)\"], checks[\"one-site-fixed: symbolic phi (B) at a rational point = numeric phi of (Omega_c[w], g2) (exact)\"]}}, {\"(A) site 2 = Omega_c[w'] fixed, g1 free: generic ranks per block (0,0),(0,1),(1,0),(1,1)\", rkGenA}, {\"(A) rank-drop hypersurfaces per block (common factors of det(PAQ))\", dropA}, {\"(A) locus tables {locus, r per block (min,max), sum P (min, max)}\", Column[tabA]}, {\"(B) site 1 = Omega_c[w] fixed, g2 free: generic ranks per block\", rkGenB}, {\"(B) rank-drop hypersurfaces per block\", dropB}, {\"(B) locus tables\", Column[tabB]}, {\"cc1(t), cc1(-t), cc1(1-t)\", {cc1[tPar], cc1[-tPar], cc1[1 - tPar]}}, {\"times (s): symbolic phi, tables, drop loci\", {tims[\"one-site-fixed: symbolic phi (A) and (B)\"], tims[\"one-site-fixed: loci tables\"], tims[\"one-site-fixed: drop loci\"]}}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
