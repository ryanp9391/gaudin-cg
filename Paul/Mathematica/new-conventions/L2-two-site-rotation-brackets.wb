  {
   "kind": 2,
   "value": "(* Task 3: block ranks and bracket-product counts at numeric points. For each Phi: the (c, c') blocks A^(c,c') (nMin x nMin), populated slots, lower bound r = MatrixRank, upper bound P = sum over the pivot rank decomposition of (rank u_k/2)(rank w_k/2) (smaller of the two orientations; both reported), totals, and the overlap identity on all states, both from phi (exact block data) and with explicit bracket products. Items (g), (h): the R-dressed covectors with the side R found in Task 2b. *)\nrhoG[g_] := Normal[nexp[g[[1]] Ee[1, 2]] . nexp[g[[2]] Ee[1, 3]] . nexp[g[[3]] Ee[2, 3]]];\ngPar1 = gaussParOf[Take[wN, 2]]; gPar2 = gaussParOf[Take[wP, 2]];\nphis[\"g: (e1 x Om[w']) R\"] = kron[e1, Ωc[wP]] . Rm;\nphis[\"h1: (e1 x Om[w']) R (rho(g1) x 1), g1 = Om[w]\"] = kron[e1, Ωc[wP]] . Rm . Normal[KroneckerProduct[rhoG[gPar1], id1]];\nphis[\"h2: (Om[w] x e1) R (1 x rho(g2)), g2 = Om[w']\"] = kron[Ωc[wN], e1] . Rm . Normal[KroneckerProduct[id1, rhoG[gPar2]]];\nphis[\"h3: (e1 x c2(g2)) R (rho(g1) x 1), generic g1, g2\"] = kron[e1, covGen1] . Rm . Normal[KroneckerProduct[rhoG[gen0], id1]];\nsite1Best = Which[Λ === {2, 1, 0}, {4, 23, 5}, Λ === {3, 1, 0}, {-3, 3, -2}, True, {1, 559/280, 403/140}];\ndressedBest = Which[Λ === {2, 1, 0}, {4, 16 (tPar + 3)/(2 (tPar + 2)) - 20, 5}, True, {-3, 3, -2}];\nphis[\"e3: c1(best locus, site 1) x e1\"] = kron[Normal[gaussCov[site1Best]], e1];\nphis[\"g2: (e1 x c2(best locus, dressed)) R\"] = kron[e1, Normal[gaussCov[dressedBest]]] . Rm;\nphis[\"g3: (e1 x c2(gen1)) R\"] = kron[e1, covGen1] . Rm;\nchecks[\"rho(g) of the Gauss parameters reproduces gaussCov: e1 rho(g) = gaussCov (exact)\"] = e1 . rhoG[gen0] === covGen;\nblockRow[name_] := Module[{Φ = phis[name], ph, bg, info, idF, idB},\n  ph = phiMat[Φ]; bg = blockOf[ph];\n  info = Association[Table[k -> blockInfo[bg[k]], {k, Keys[bg]}]];\n  idF = idFull[Φ]; idB = idBlock[Φ, bg];\n  <|\"name\" -> name, \"info\" -> info, \"sumR\" -> Total[#[\"r\"] & /@ Values[info]], \"sumP\" -> Total[#[\"P\"] & /@ Values[info]], \"sumProws\" -> Total[#[\"Prows\"] & /@ Values[info]], \"sumPcols\" -> Total[#[\"Pcols\"] & /@ Values[info]], \"idF\" -> idF, \"idB\" -> idB, \"n\" -> Length[suppSet[ph]]|>];\n{tims[\"Task 3: all block tables\"], blkTab} = AbsoluteTiming[Association[Table[k -> blockRow[k], {k, Keys[phis]}]]];\n(* regression: for Phi = c1 (x) e1 the blocks have rank <= 1 and P(c,c') = (rank of column c of the one-site tensor of group c2 = c')/2, the one-site automatic count; for e1 (x) c2 the Stage A per-label tables *)\noneSiteCols[cov_] := Table[Table[MatrixRank[amat[tensorOf[Table[cov . Kg[c2][[All, x]], {x, d1}]][[All, c + 1]]]]/2, {c2, 0, Λ[[2]]}, {c, 0, Λ[[2]]}], {1}][[1]];\ncolRanksSite1[cov_] := Table[Table[MatrixRank[amat[tensorOf[cov . Kg[c2]][[All, c + 1]]]]/2, {c, 0, Λ[[2]]}], {c2, 0, Λ[[2]]}];\nregChk[name_, cov_] := With[{P = Table[blkTab[name][\"info\"][{c, cp}][\"P\"], {c, 0, Λ[[2]]}, {cp, 0, Λ[[2]]}], R = Table[blkTab[name][\"info\"][{c, cp}][\"r\"], {c, 0, Λ[[2]]}, {cp, 0, Λ[[2]]}]}, {Max[R] <= 1, P === Transpose[colRanksSite1[cov]], Total[Flatten[P]], Total[Flatten[colRanksSite1[cov]]]}];\nregE = {regChk[\"e1: Om[w] x e1\", Ωc[wN]], regChk[\"f1: c1(g1) x e1\", covGen]};\nfmtBlocks[name_] := Table[With[{b = blkTab[name][\"info\"][{c, cp}]}, {c, cp} -> {b[\"slots\"], b[\"r\"], b[\"P\"], b[\"Prows\"], b[\"Pcols\"]}], {c, 0, Λ[[2]]}, {cp, 0, Λ[[2]]}] // Flatten;\nGrid[Join[{{\"Phi\", \"# support pairs\", \"blocks (c,c') -> {slots, r, P, P(rows), P(cols)}\", \"sum r (lower bound)\", \"sum P (upper bound)\", \"sum P rows / cols orientation\", \"phi-form identity (rel dev)\", \"block bracket identity {# products, rel dev}\"}}, Table[{k, blkTab[k][\"n\"], fmtBlocks[k], blkTab[k][\"sumR\"], blkTab[k][\"sumP\"], {blkTab[k][\"sumProws\"], blkTab[k][\"sumPcols\"]}, N[blkTab[k][\"idF\"], 3], {blkTab[k][\"idB\"][[1]], N[blkTab[k][\"idB\"][[2]], 3]}}, {k, Keys[blkTab]}], {{\"regression, site 2 = e1: {all blocks r <= 1, P(c,c') = one-site column 2-form half-ranks (group c2 = c', column c), sum P, one-site automatic count}: Om[w] x e1, c1(g1) x e1\", regE, \"\", \"\", \"\", \"\", \"\", \"\"}, {\"rho(g) check\", checks[\"rho(g) of the Gauss parameters reproduces gaussCov: e1 rho(g) = gaussCov (exact)\"], \"\", \"\", \"\", \"\", \"\", \"\"}, {\"time (s)\", tims[\"Task 3: all block tables\"], \"\", \"\", \"\", \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
