       "data": "Out[2289]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|c|c|}\\hline\\mu  & \\text{(1,1) id. resid} & \\text{(1,1) \\# c$\\cdot$RR$\\Psi$} & \\text{(1,1) \\# c$\\cdot$P\\_HW$\\Psi$} & \\text{(1,1) \\# T} & \\text{(2,1) id. resid} & \\text{(2,1) \\# c$\\cdot$RR$\\Psi$} & \\text{(2,1) \\# c$\\cdot$P\\_HW$\\Psi$} & \\text{(2,1) \\# T} & \\text{\\# <$\\Omega$|$\\Psi$>} & \\text{\\# <x0|$\\Psi$>} & \\text{\\# <x0|P\\_HW$\\Psi$>}\\\\\\hline\\left\\{4,2,0\\right\\} & \\text{0.}\\times 10^{\\text{-178}} & 0.\\, & 0.\\, & 0.\\, & \\text{0.}\\times 10^{\\text{-168}} & 0.\\, & 0.\\, & 0.\\, & 0.\\, & 2.\\, & 2.\\,\\\\\\hline\\left\\{4,1,1\\right\\} & \\text{0.}\\times 10^{\\text{-168}} & 1.\\, & \\mathrm{Indeterminate} & 0.\\, & \\text{0.}\\times 10^{\\text{-159}} & 1.\\, & 1.\\, & 0.\\, & 1.\\, & 3.\\, & \\mathrm{Indeterminate}\\\\\\hline\\left\\{3,3,0\\right\\} & \\text{0.}\\times 10^{\\text{-169}} & 1.\\, & 1.\\, & 0.\\, & \\text{0.}\\times 10^{\\text{-159}} & 1.\\, & 1.\\, & 0.\\, & 1.\\, & 3.\\, & \\mathrm{Indeterminate}\\\\\\hline\\left\\{3,2,1\\right\\} & \\text{0.}\\times 10^{\\text{-168}} & 1.\\, & 1.\\, & 0.\\, & \\text{0.}\\times 10^{\\text{-158}} & 1.\\, & 1.\\, & 0.\\, & 1.\\, & 4.\\, & -\\infty \\\\\\hline\\left\\{3,2,1\\right\\} & \\text{0.}\\times 10^{\\text{-168}} & 1.\\, & 1.\\, & 0.\\, & \\text{0.}\\times 10^{\\text{-158}} & 1.\\, & … [latex truncated: 1452 chars total]",
