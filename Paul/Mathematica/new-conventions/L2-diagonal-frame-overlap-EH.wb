       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"758596\" data-output-id=\"191\" data-out-n=\"1739\" data-sub-idx=\"20\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"25\" data-sub-start=\"20\" data-sub-end=\"20\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1739]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:7.7341em;vertical-align:-3.5971em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.1371em;\"><span style=\"top:-6.0971em;\"><span class=\"pstrut\" style=\"height:6.0971em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:7.6941em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.5971em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.0971em;\"><span style=\"top:-6.366em;\"><span class=\"pstrut\" style=\"height:3.1089em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">orthogonality A</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\"><span class=\"mord vbox\"><span class=\"thinbox\"><span class=\"rlap\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"inner\"><span class=\"mord\"><span class=\"mrel\"></span></span></span><span class=\"fix\"></span></span></span></span></span><span class=\"mspace nobreak\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\">B</span></span></span></span><span style=\"top:-5.166em;\"><span class=\"pstrut\" style=\"height:3.1089em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">A=B (not zero)</span></span></span></span><span style=\"top:-3.6971em;\"><span class=\"pstrut\" style=\"height:3.1089em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">c0</span></span></span></span><span style=\"top:-2.2719em;\"><span class=\"pstrut\" style=\"height:3.1089em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">c0 same on 16 monomials</span></span></span></span><span style=\"top:-1.0719em;\"><span class=\"pstrut\" style=\"height:3.1089em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">c0 = (</span><span class=\"mord mathnormal\">ε</span><span class=\"mord\">2-</span><span class=\"mord mathnormal\">ε</span><span class=\"mord\">1)</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">3 c0(per-ladder)</span></span></span></span><span style=\"top:0.1281em;\"><span class=\"pstrut\" style=\"height:3.1089em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">full formula, all 64</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.5971em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:7.6941em;bor