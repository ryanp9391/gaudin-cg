      {
       "data": "Out[1988]= \\begin{array}{|c|c|c|}\\hline\\mu  & \\text{$\\lambda$ = (1,1)} & \\text{$\\lambda$ = (2,1)}\\\\\\hline\\left\\{4,2,0\\right\\} & \\left\\{3\\,ħh^2\\,z\\left(2\\right)\\,z\\left(3\\right)\\right\\} & \\left\\{-3\\,ħh^3\\,z\\left(2\\right)\\,z\\left(3\\right)^2\\right\\}\\\\\\hline\\left\\{4,1,1\\right\\} & \\left\\{0\\right\\} & \\left\\{-\\frac{3\\,ħh^3\\,z\\left(2\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)\\,\\left(z\\left(2\\right)-z\\left(3\\right)\\right)\\,z\\left(3\\right)\\,\\left(z\\left(2\\right)-w\\left(1\\right)\\right)\\,\\left(z\\left(2\\right)-w\\left(2\\right)\\right)}{\\sqrt{2}\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,\\left(w\\left(1\\right)-z\\left(3\\right)\\right)\\,\\left(w\\left(2\\right)-z\\left(3\\right)\\right)}\\right\\}\\\\\\hline\\left\\{3,3,0\\right\\} & \\left\\{\\frac{3\\,ħh^2\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,z\\left(3\\right)\\,\\left(w\\left(1\\right)-z\\left(1\\right)\\right)}{\\sqrt{2}\\,\\left(w\\left(1\\right)-z\\left(2\\right)\\right)}\\right\\} & \\left\\{-\\frac{3\\,ħh^3\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,z\\left(3\\right)^2\\,\\left(w\\left(1\\right)-z\\left(1\\right)\\right)}{\\sqrt{2}\\,\\left(w\\left(1\\right)-z\\left(2\\right)\\right)}\\right\\}\\\\\\hline\\left\\{3,2,1\\right\\} & \\left\\{-\\frac{2\\,\\sqrt{\\frac{3}{7}}\\,ħh^2\\,w\\left(2\\right)\\,\\le… [latex truncated: 2784 chars total]",
