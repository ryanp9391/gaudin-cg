       "data": "Out[1942]= \\begin{array}{|c|c|}\\hline\\text{[3,2,1] rank 2} & \\mathrm{True}\\\\\\hline\\text{(2,1) reaches all irreps} & \\mathrm{True}\\\\\\hline\\end{array}",
