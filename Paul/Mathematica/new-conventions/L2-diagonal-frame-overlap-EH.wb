      {
       "data": "Out[2307]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{$\\kappa$\\_C ($\\varphi$T,$\\omega$T)} & \\text{$\\kappa$\\_C ($\\varphi$T,$\\omega$')} & \\text{$\\kappa$\\_C ($\\varphi$',$\\omega$'')} & \\text{$\\kappa$\\_C at h=1/3, $\\theta$=(1/5,-4/9)}\\\\\\hline\\left\\{4,2,0\\right\\} & \\text{both 0} & \\text{both 0} & \\text{both 0} & \\text{both 0}\\\\\\hline\\left\\{4,1,1\\right\\} & 1.00000000 & 1.00000000 & 1.0000000 & 1.00000000\\\\\\hline\\left\\{3,3,0\\right\\} & \\text{both 0} & \\text{both 0} & \\text{both 0} & \\text{both 0}\\\\\\hline\\left\\{3,2,1\\right\\} & 1.00000000 & 1.0000000 & 1.00000000 & 1.00000000\\\\\\hline\\left\\{3,2,1\\right\\} & 1.00000000 & 1.0000000 & 1.00000000 & 1.00000000\\\\\\hline\\left\\{2,2,2\\right\\} & 0.92380952 & 0.92380952 & 0.92380952 & 0.97777778\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
