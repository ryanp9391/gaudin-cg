      {
       "data": "Out[1690]= \\begin{array}{|c|c|}\\hline\\text{check} & \\text{value}\\\\\\hline\\text{per-ladder orthogonality: max $\\sigma$min/$\\sigma$max over A$\\not=$B (18x6)} & \\text{2.26}\\times 10^{\\text{-63}}\\\\\\hline\\text{per-ladder: min $\\sigma$min/$\\sigma$max over A=B (not a zero test)} & \\text{2.33}\\times 10^{\\text{-7}}\\\\\\hline\\text{per-ladder det N off-diag/diag (same twist)} & \\text{2.58}\\times 10^{\\text{-43}}\\\\\\hline\\text{per-ladder det N: pair-choice ratio state-independent (B vs vac)} & \\text{5.96}\\times 10^{\\text{3}}\\\\\\hline\\text{per-ladder: R\\_B state-independent, site-product $\\Psi$\\_Q(x0)} & \\text{0.}\\times 10^{\\text{-51}}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "a15e9759-6283-49ed-aa03-82b4f9c104ec"
