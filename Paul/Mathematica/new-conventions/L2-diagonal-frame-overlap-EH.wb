      {
       "data": "Out[807]= \\begin{array}{|c|c|}\\hline\\text{quantity} & \\text{value}\\\\\\hline\\text{Q-overlap absolute residual (64 states)} & \\text{0.}\\times 10^{\\text{-50}}\\\\\\hline\\text{Q-overlap relative residual (64 states)} & \\text{0.}\\times 10^{\\text{-51}}\\\\\\hline\\text{t1,t2 recovered from dual Q, coefficient residual} & \\text{0.}\\times 10^{\\text{-51}}\\\\\\hline\\text{number of w} & \\text{ranks in 420,411,330,321,222}\\\\\\hline1 & \\left\\{1,2,2,5,5\\right\\}\\\\\\hline2 & \\left\\{1,2,2,6,8\\right\\}\\\\\\hline3 & \\left\\{1,2,2,6,10\\right\\}\\\\\\hline4 & \\left\\{1,2,2,6,10\\right\\}\\\\\\hline5 & \\left\\{1,2,2,6,10\\right\\}\\\\\\hline6 & \\left\\{1,2,2,6,10\\right\\}\\\\\\hline\\end{array}",
