  {
   "kind": 2,
   "value": "(* reconstruction: data = W_λ(w)·Ψ for λ, many w (= Q side, used here via the vectors) plus <x0|Ψ> = 1. Solve on the weight-μ space; fix the null directions by minimizing the part of Ψ orthogonal to HW_μ (the limit is HW). Compare the HW direction (and, for full rank, Ψ itself) with the true eigenstate *)\npsiStates[eps_, φv_, pr_] := Module[{zE = N[Exp[eps φv], pr], tt, mix, x0, out = {}}, tt = Table[tPoly[DiagonalMatrix[zE], a], {a, 2}]; mix = (tt[[1]] + N[Pi, pr] tt[[2]]) /. u -> 3/7; x0 = x0Cov[eps, φv, pr];\n  Do[With[{sec = Flatten[Position[wtBasis, Λw]]}, With[{es = Eigensystem[mix[[sec, sec]]]}, Do[With[{ψ0 = Normal[SparseArray[Thread[sec -> es[[2, k]]], {d2}]]}, If[(Norm[EtotS[1, 2] . ψ0] + Norm[EtotS[2, 3] . ψ0])/Norm[ψ0] < 10^-3, AppendTo[out, <|\"mu\" -> Λw, \"ev\" -> es[[1, k]], \"ψ\" -> ψ0/(x0 . ψ0)|>]]], {k, Length[sec]}]]], {Λw, hwSecs}];\n  SortBy[out, {Position[hwSecs, #[\"mu\"]][[1, 1]], Re[#[\"ev\"]]} &]];\nrecon[eps_, φv_, ωs_, pr_] := Module[{sts = psiStates[eps, φv, pr], covs = Table[wCov[eps, φv, ωv, pr], {ωv, ωs}], x0 = x0Cov[eps, φv, pr]},\n  Table[With[{μ = st[\"mu\"], sec = Flatten[Position[wtBasis, st[\"mu\"]]]}, Module[{M, b, sv, U, S, V, r, ψp, Nn, hb, Pperp, α, ψr, ψt, dirErr},\n      M = Append[Flatten[covs[[All, All, sec]], 1], x0[[sec]]]; ψt = st[\"ψ\"][[sec]]; b = M . ψt;\n      {U, S, V} = SingularValueDecomposition[M]; sv = Diagonal[S]; r = Count[sv, x_ /; x > 10^-80 First[sv]];\n      ψp = V[[All, 1 ;; r]] . ((ConjugateTranspose[U[[All, 1 ;; r]]] . b)/sv[[1 ;; r]]);\n      Nn = Transpose[V[[All, r + 1 ;;]]];\n      hb = hwB[μ][[All, sec]]; Pperp = IdentityMatrix[Length[sec]] - Transpose[hb] . Conjugate[hb];\n      α = If[Nn === {}, {}, LeastSquares[Pperp . Transpose[Nn], -Pperp . ψp]];\n      ψr = ψp + If[Nn === {}, 0, α . Nn];\n      dirErr = With[{a = hb . ψr, c = hb . ψt}, 1 - Abs[Conjugate[a] . c]/(Norm[a] Norm[c])];\n      {μ, Length[sec], r, N[dirErr, 3], N[Norm[hb . ψr - hb . ψt]/Norm[hb . ψt], 3]}]], {st, sts}]];\nreconTab = Table[{e, Sequence @@ #} & /@ recon[e, φT, ωMany[[1 ;; 20]], 200], {e, {10^-6, 10^-9}}];\nGrid[Join[{{\"ε\", \"μ\", \"dim\", \"rank (with x0)\", \"1 - |cos| HW direction\", \"rel. error of HW part (incl. scale)\"}}, Flatten[reconTab, 1]], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
