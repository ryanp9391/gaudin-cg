      {
       "data": "Out[717]= \\begin{array}{|c|c|}\\hline\\text{t\\_a\\^{}T = t\\_a(reversed sites)} & \\mathrm{True}\\\\\\hline\\text{t\\_a symmetric? (a=1,2,3; info only)} & \\left\\{\\mathrm{False},\\mathrm{False},\\mathrm{True}\\right\\}\\\\\\hline\\end{array}",
