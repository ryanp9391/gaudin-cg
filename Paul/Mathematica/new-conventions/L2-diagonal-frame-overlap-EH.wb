      {
       "data": "Out[2035]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{total weight} & \\text{site-1 GT states} & \\text{dim} & \\text{\\# (1,1)} & \\text{\\# (2,1)} & \\text{rank (1,1)} & \\text{rank (2,1)} & \\text{rank both}\\\\\\hline\\left\\{4,2,0\\right\\} & \\left\\{1\\right\\} & 1 & \\left\\{0\\right\\} & \\left\\{0\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{4,1,1\\right\\} & \\left\\{2\\right\\} & 1 & \\left\\{\\infty \\right\\} & \\left\\{1\\right\\} & 0 & 1 & 1\\\\\\hline\\left\\{3,3,0\\right\\} & \\left\\{3\\right\\} & 1 & \\left\\{1\\right\\} & \\left\\{1\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{3,2,1\\right\\} & \\left\\{4,5\\right\\} & 2 & \\left\\{1\\right\\} & \\left\\{1\\right\\} & 1 & 1 & 2\\\\\\hline\\left\\{3,1,2\\right\\} & \\left\\{6\\right\\} & 1 & \\left\\{\\infty \\right\\} & \\left\\{2\\right\\} & 0 & 1 & 1\\\\\\hline\\left\\{2,3,1\\right\\} & \\left\\{7\\right\\} & 1 & \\left\\{\\infty \\right\\} & \\left\\{2\\right\\} & 0 & 1 & 1\\\\\\hline\\left\\{2,2,2\\right\\} & \\left\\{8\\right\\} & 1 & \\left\\{\\infty \\right\\} & \\left\\{2\\right\\} & 0 & 1 & 1\\\\\\hline\\text{all sectors spanned} & \\mathrm{True} &  &  &  &  &  & \\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
