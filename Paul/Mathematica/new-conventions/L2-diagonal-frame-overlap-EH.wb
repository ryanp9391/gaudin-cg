      {
       "data": "Out[1984]= \\begin{array}{|c|c|}\\hline\\text{check} & \\text{value}\\\\\\hline\\text{symbolic r's reproduce Section 4 at the numeric point} & \\mathrm{True}\\\\\\hline\\text{symbolic <v\\_(1,1)|R\\^{}-1 = numeric at the point} & \\mathrm{True}\\\\\\hline\\text{symbolic <v\\_(2,1)|R\\^{}-1 = numeric at the point} & \\mathrm{True}\\\\\\hline\\text{symbolic: <v\\_(1,1)|R\\^{}-1 = e1\\^{}T T\\_(1,1)[g\\^{}-T z g\\^{}T]} & \\mathrm{True}\\\\\\hline\\text{symbolic: <v\\_(2,1)|R\\^{}-1 = e1\\^{}T T\\_(2,1)[g\\^{}-T z g\\^{}T]} & \\mathrm{True}\\\\\\hline\\end{array}",
