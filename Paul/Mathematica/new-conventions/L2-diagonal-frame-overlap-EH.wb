       "data": "Out[2230]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{state} & \\text{max log-resid} & \\text{e\\^{}const} & \\text{$\\varphi$12} & \\text{$\\varphi$13} & \\text{$\\varphi$23} & \\text{$\\omega$1-$\\varphi$1} & \\text{$\\omega$1-$\\varphi$2} & \\text{$\\omega$1-$\\varphi$3} & \\text{$\\omega$2-$\\varphi$1} & \\text{$\\omega$2-$\\varphi$2} & \\text{$\\omega$2-$\\varphi$3} & \\text{$\\omega$3-$\\varphi$1} & \\text{$\\omega$3-$\\varphi$2} & \\text{$\\omega$3-$\\varphi$3} & \\text{$\\omega$12} & \\text{$\\omega$13} & \\text{$\\omega$23}\\\\\\hline\\text{[4,2,0]} & \\text{5.76}\\times 10^{\\text{-14}} & 28.44444444 & 0.\\, & 0.\\, & 0.\\, & 0.\\, & 2.\\, & 4.\\, & 0.\\, & 0.\\, & 2.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\,\\\\\\hline\\text{[4,1,1]} & \\text{5.35}\\times 10^{\\text{-14}} & 28.44444444 & 0.\\, & 0.\\, & 0.\\, & 0.\\, & 3.\\, & 3.\\, & 0.\\, & 1.\\, & 1.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\,\\\\\\hline\\text{[3,3,0]} & \\text{4.66}\\times 10^{\\text{-14}} & 28.44444444 & 0.\\, & 0.\\, & 0.\\, & 1.\\, & 1.\\, & 4.\\, & 0.\\, & 0.\\, & 2.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\,\\\\\\hline\\text{[3,2,1]a} & \\text{8.06}\\times 10^{\\text{-14}} & 22.09339512 & 0.\\, & 0.\\, & 0.\\, & 1.\\, & 2.\\, & 3.\\, & 0.\\, & 0.\\, & 1.\\, & 0.\\, & 0.\\, & 0.\\, & 0.\\… [latex truncated: 1672 chars total]",
