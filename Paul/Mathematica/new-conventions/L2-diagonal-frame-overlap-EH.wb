      {
       "data": "Out[774]= \\begin{array}{|c|c|}\\hline\\text{twists} & \\begin{pmatrix}\\frac{3}{2} & \\frac{5}{4} & \\frac{2}{3}\\\\\\frac{5}{2} & \\frac{7}{3} & \\frac{3}{5}\\end{pmatrix}\\\\\\hline\\text{site-2 A, symbolic d} & \\mathrm{True}\\\\\\hline\\text{site-2 B coefficients \\{alpha,beta\\}, h=1} & \\left\\{-\\left(\\left(\\mathrm{dd}-3\\right)\\,\\left(\\mathrm{dd}-1\\right)^2\\right),\\frac{15}{2}\\,\\left(\\mathrm{dd}-3\\right)\\,\\left(\\mathrm{dd}-1\\right)\\right\\}\\\\\\hline\\text{old beta at h=1} & \\frac{15}{4}\\,\\left(\\mathrm{dd}-3\\right)\\,\\left(\\mathrm{dd}-1\\right)\\\\\\hline\\end{array}",
       "mime": "text/plain"
