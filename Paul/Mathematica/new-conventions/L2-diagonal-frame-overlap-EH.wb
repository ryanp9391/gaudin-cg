\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-31.3002em;\"><span class=\"pstrut\" style=\"height:22.6651em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-33.7002em;\"><span class=\"pstrut\" style=\"height:22.6651em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-36.1002em;\"><span class=\"pstrut\" style=\"height:22.6651em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-38.5003em;\"><span class=\"pstrut\" style=\"height:22.6651em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-39.7103em;\"><span class=\"pstrut\" style=\"height:22.6651em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-40.9203em;\"><span class=\"pstrut\" style=\"height:22.6651em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-42.1303em;\"><span class=\"pstrut\" style=\"height:22.6651em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-43.3303em;\"><span class=\"pstrut\" style=\"height:22.6651em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:20.1651em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
