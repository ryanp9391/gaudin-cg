      {
       "data": "Out[2313]= \\begin{array}{|c|c|c|c|}\\hline\\mu  & \\text{dim weight space} & \\text{rank \\{W\\_$\\lambda$(w)\\}} & \\text{rank with x0}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{4,1,1\\right\\} & 2 & 2 & 2\\\\\\hline\\left\\{3,3,0\\right\\} & 2 & 1 & 2\\\\\\hline\\left\\{3,2,1\\right\\} & 6 & 4 & 5\\\\\\hline\\left\\{2,2,2\\right\\} & 10 & 6 & 7\\\\\\hline\\end{array}",
