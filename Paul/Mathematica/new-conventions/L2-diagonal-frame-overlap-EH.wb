      {
       "data": "Out[949]= \\begin{array}{|c|c|c|}\\hline\\text{weight} & \\text{Baxter solutions} & \\text{physical weight dimension}\\\\\\hline\\left\\{0,2,4\\right\\} & 1 & 1\\\\\\hline\\left\\{0,3,3\\right\\} & 2 & 2\\\\\\hline\\left\\{0,4,2\\right\\} & 1 & 1\\\\\\hline\\left\\{1,1,4\\right\\} & 2 & 2\\\\\\hline\\left\\{1,2,3\\right\\} & 6 & 6\\\\\\hline\\left\\{1,3,2\\right\\} & 6 & 6\\\\\\hline\\left\\{1,4,1\\right\\} & 2 & 2\\\\\\hline\\left\\{2,0,4\\right\\} & 1 & 1\\\\\\hline\\left\\{2,1,3\\right\\} & 6 & 6\\\\\\hline\\left\\{2,2,2\\right\\} & 10 & 10\\\\\\hline\\left\\{2,3,1\\right\\} & 6 & 6\\\\\\hline\\left\\{2,4,0\\right\\} & 1 & 1\\\\\\hline\\left\\{3,0,3\\right\\} & 2 & 2\\\\\\hline\\left\\{3,1,2\\right\\} & 6 & 6\\\\\\hline\\left\\{3,2,1\\right\\} & 6 & 6\\\\\\hline\\left\\{3,3,0\\right\\} & 2 & 2\\\\\\hline\\left\\{4,0,2\\right\\} & 1 & 1\\\\\\hline\\left\\{4,1,1\\right\\} & 2 & 2\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & 1\\\\\\hline\\text{total states} & 64 & \\\\\\hline\\text{spectral solve time (s)} & 1.528481 & \\\\\\hline\\text{max Baxter equation residual} & 3.3333\\times 10^{-95} & \\\\\\hline\\text{max reconstruction data residual} & 0 & \\\\\\hline\\text{max transfer eigenvector residual / vector norm} & 4.0158\\times 10^{-92} & \\\\\\hline\\text{max normalization residual} & 9.5641\\times 10^{-93} & \\\\\\hline\\end{array}",
