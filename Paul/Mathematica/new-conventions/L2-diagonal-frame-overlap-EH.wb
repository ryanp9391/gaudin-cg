      {
       "data": "Out[2301]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{case} & \\mu  & \\text{(1,1) \\# chain} & \\text{(1,1) \\# CG} & \\text{(1,1) $\\kappa$} & \\text{(2,1) \\# chain} & \\text{(2,1) \\# CG} & \\text{(2,1) $\\kappa$}\\\\\\hline\\text{$\\omega$₁=$\\varphi$₁} & \\left\\{4,2,0\\right\\} & 0.\\, & 0.\\, & 1.\\, & 0.\\, & 0.\\, & 1.\\,\\\\\\hline\\text{$\\omega$₁=$\\varphi$₁} & \\left\\{4,1,1\\right\\} & 1.\\, & \\text{0} & \\text{CG=0} & 1.\\, & 1.\\, & 1.38571\\\\\\hline\\text{$\\omega$₁=$\\varphi$₁} & \\left\\{3,3,0\\right\\} & \\text{0} & \\text{0} & \\text{CG=0} & \\text{0} & \\text{0} & \\text{CG=0}\\\\\\hline\\text{$\\omega$₁=$\\varphi$₁} & \\left\\{3,2,1\\right\\} & \\text{0} & \\text{0} & \\text{CG=0} & \\text{0} & \\text{0} & \\text{CG=0}\\\\\\hline\\text{$\\omega$₁=$\\varphi$₁} & \\left\\{3,2,1\\right\\} & \\text{0} & \\text{0} & \\text{CG=0} & \\text{0} & \\text{0} & \\text{CG=0}\\\\\\hline\\text{$\\omega$₁=$\\varphi$₁} & \\left\\{2,2,2\\right\\} & \\text{0} & \\text{0} & \\text{CG=0} & \\text{0} & \\text{0} & \\text{CG=0}\\\\\\hline\\text{$\\omega$₂=$\\varphi$₁} & \\left\\{4,2,0\\right\\} & 0.\\, & 0.\\, & 1.\\, & 0.\\, & 0.\\, & 1.\\,\\\\\\hline\\text{$\\omega$₂=$\\varphi$₁} & \\left\\{4,1,1\\right\\} & 1.\\, & \\text{0} & \\text{CG=0} & 1.\\, & 1.\\, & 1.38571\\\\\\hline\\text{$\\omega$₂=$\\varphi$₁} & \\left\\{3,3,0\\right\\}… [latex truncated: 2259 chars total]",
       "mime": "text/plain"
