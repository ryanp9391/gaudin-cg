       "data": "Out[1709]= \\begin{array}{|c|c|}\\hline\\text{<x0|y0> per site} & \\left\\{-\\frac{1}{4}\\,\\sqrt{\\frac{3}{2}}\\,\\left(-\\frac{1728}{245}\\,\\sqrt{6}\\,\\left(\\frac{320256\\,\\sqrt{6}\\,\\left(-\\frac{15\\,\\sqrt{\\frac{3}{2}}}{128}+\\frac{3649}{512\\,\\sqrt{6}}\\right)}{4515863}-\\frac{21170163}{72253808}\\right)-\\frac{10656}{245}\\,\\left(\\frac{29904\\,\\sqrt{2}\\,\\left(\\frac{8405}{1024\\,\\sqrt{3}}-\\frac{445\\,\\sqrt{3}}{2048}\\right)}{110143}-\\frac{503136\\,\\left(-\\frac{75\\,\\sqrt{\\frac{3}{2}}}{512}+\\frac{18245}{2048\\,\\sqrt{6}}\\right)}{4515863}-\\frac{358848\\,\\left(-\\frac{75\\,\\sqrt{\\frac{3}{2}}}{1024}+\\frac{146285}{6144\\,\\sqrt{6}}\\right)}{4515863}+\\frac{126144\\,\\left(-\\frac{1025\\,\\sqrt{\\frac{3}{2}}}{2048}+\\frac{314615}{12288\\,\\sqrt{6}}\\right)}{4515863}-\\frac{188643905\\,\\sqrt{\\frac{3}{2}}}{289015232}\\right)\\right)-\\frac{17\\,\\left(-\\frac{19872}{245}\\,\\sqrt{2}\\,\\left(\\frac{320256\\,\\sqrt{6}\\,\\left(-\\frac{15\\,\\sqrt{\\frac{3}{2}}}{128}+\\frac{3649}{512\\,\\sqrt{6}}\\right)}{4515863}-\\frac{21170163}{72253808}\\right)-\\frac{10944}{245}\\,\\sqrt{3}\\,\\left(\\frac{29904\\,\\sqrt{2}\\,\\left(\\frac{8405}{1024\\,\\sqrt{3}}-\\frac{445\\,\\sqrt{3}}{2048}\\right)}{110143}-\\frac{503136\\,\\left(-\\frac{75\\,\\sqrt{\\frac{3}{2}}}{512}+\\frac{18245}{2048\\,\\sqrt{6}}\\right)}{… [latex truncated: 11688 chars total]",
