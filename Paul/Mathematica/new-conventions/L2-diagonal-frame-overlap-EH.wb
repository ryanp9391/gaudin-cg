       "data": "Out[856]= \\begin{array}{|c|c|c|}\\hline\\text{mu} & \\text{site2 A HW components} & \\text{site2 B HW components}\\\\\\hline\\left\\{4,2,0\\right\\} & \\left\\{3\\,\\mathrm{hh}^2\\,\\mathrm{za}\\,\\mathrm{zb}\\right\\} & \\left\\{3\\,\\mathrm{hh}^3\\,\\mathrm{za}\\,\\mathrm{zb}\\,\\left(\\mathrm{za}-\\mathrm{zc}\\right)\\right\\}\\\\\\hline\\left\\{4,1,1\\right\\} & \\left\\{-\\frac{3\\,\\mathrm{bc}\\,\\mathrm{hh}^2\\,\\mathrm{za}}{\\sqrt{2}}\\right\\} & \\left\\{-\\frac{3\\,\\mathrm{bc}\\,\\mathrm{hh}^3\\,\\mathrm{za}^2}{\\sqrt{2}}\\right\\}\\\\\\hline\\left\\{3,3,0\\right\\} & \\left\\{0\\right\\} & \\left\\{-\\frac{3\\,\\mathrm{ab}\\,\\mathrm{hh}^3\\,\\mathrm{za}\\,\\mathrm{zb}}{\\sqrt{2}}\\right\\}\\\\\\hline\\left\\{3,2,1\\right\\} & \\left\\{2\\,\\sqrt{\\frac{3}{7}}\\,\\mathrm{hh}^2\\,\\left(\\mathrm{ab}\\,\\mathrm{bc}-\\mathrm{ac}\\,\\mathrm{zb}\\right),-\\sqrt{\\frac{3}{35}}\\,\\mathrm{hh}^2\\,\\left(\\mathrm{ab}\\,\\mathrm{bc}-\\mathrm{ac}\\,\\mathrm{zb}\\right)\\right\\} & \\left\\{3\\,\\sqrt{\\frac{3}{7}}\\,\\mathrm{hh}^3\\,\\mathrm{za}\\,\\left(\\mathrm{ab}\\,\\mathrm{bc}-\\mathrm{ac}\\,\\mathrm{zb}\\right),\\sqrt{\\frac{3}{35}}\\,\\mathrm{hh}^3\\,\\mathrm{za}\\,\\left(2\\,\\mathrm{ab}\\,\\mathrm{bc}+5\\,\\mathrm{ac}\\,\\mathrm{zb}\\right)\\right\\}\\\\\\hline\\left\\{2,2,2\\right\\} & \\left\\{0\\right\\} & \\left\\{-\\frac{3\\,\\mathrm{ac}\\,\\mathrm{hh}^3\\,\\… [latex truncated: 1561 chars total]",
