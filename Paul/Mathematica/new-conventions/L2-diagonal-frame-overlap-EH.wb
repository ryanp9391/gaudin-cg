      {
       "data": "Out[2453]= \\begin{array}{|c|c|c|}\\hline\\text{check} & \\text{value} & \\\\\\hline\\text{EH[i,j]\\^{}T = EH[j,i]} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{qdet: t3 = $\\chi$3 $\\nu$1(u)$\\nu$2(u-h)$\\nu$3(u-2h)} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{deg t\\_a = 2a} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{[t\\_a(u1), t\\_b(u2)] = 0} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{t\\_a conserve the weight} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{t\\_a(u)\\^{}T = t\\_a of site-reversed chain (a=1,2,3)} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{64 eigenvectors of t1,t2,t3 (max residual)} & \\text{0} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{simple spectrum within sectors (min gap)} & \\text{3.22}\\times 10^{\\text{-3}} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{all direct and dual Q's found} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{deg q\\_i = L$\\lambda$1 - $\\mu$\\_i} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{deg q\\^{}j = $\\mu$\\_j - L$\\lambda$3} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{QQ: Q\\_a Q\\_b\\^{}[2] - … [latex truncated: 4526 chars total]",
