       "data": "Out[814]= \\begin{array}{|c|c|}\\hline\\text{number of states reconstructed} & 64\\\\\\hline\\text{w values} & 3\\\\\\hline\\text{working precision} & 60\\\\\\hline\\text{max relative vector error} & \\text{0}\\\\\\hline\\text{minimum retained vector precision} & 47.86376931057301\\\\\\hline\\end{array}",
