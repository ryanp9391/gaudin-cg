      {
       "data": "Out[780]= \\begin{array}{|c|c|c|}\\hline\\text{point} & \\text{all four corrected identities (exact)} & \\text{old beta holds?}\\\\\\hline\\left\\{\\frac{1}{2},\\left\\{\\frac{2}{7},-\\frac{3}{5}\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\left\\{\\frac{1}{3},\\left\\{\\frac{1}{5},-\\frac{4}{9}\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{False}\\\\\\hline\\left\\{\\frac{2}{5},\\left\\{-\\frac{2}{3},\\frac{3}{8}\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{False}\\\\\\hline\\text{row action vs original t1,t2} & \\mathrm{True} & \\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "b2ebf28b-8d54-4ad1-82d9-b2dabdbf4c4a"
    }
