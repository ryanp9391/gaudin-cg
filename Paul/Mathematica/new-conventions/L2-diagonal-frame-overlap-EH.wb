      {
       "data": "Out[1668]= \\begin{array}{|c|c|}\\hline\\text{Pphys check (L=1)} & \\mathrm{True}\\\\\\hline\\text{min |<x0|Psi\\_B>|} & \\text{6.09}\\times 10^{\\text{-5}}\\\\\\hline\\text{max |R\\_B/R\\_1 - 1|} & \\text{2.30}\\times 10^{\\text{8}}\\\\\\hline\\text{R\\_1} & 2.3066535\\\\\\hline\\end{array}",
