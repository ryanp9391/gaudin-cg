      {
       "data": "Out[2280]= \\begin{array}{|c|c|}\\hline\\text{R\\_[3,3,0] = (w1-z1)/(w1-z2), R\\_[4,1,1] = (w1-z2)(w2-z2)/((w1-z3)(w2-z3)) at $\\varepsilon$ = 1/3: max rel. dev} & \\text{0.}\\times 10^{\\text{-54}}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "b60377a7-cf30-4d39-a01c-2d0f33ae3322"
