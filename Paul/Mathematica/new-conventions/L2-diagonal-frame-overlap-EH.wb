      {
       "data": "Out[907]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{weight} & \\text{unknowns} & \\text{equations} & \\text{solutions} & \\text{seconds}\\\\\\hline\\text{\\{4, 2, 0\\}} & 10 & 21 & 1 & 0.055162\\\\\\hline\\text{\\{4, 1, 1\\}} & 10 & 21 & 2 & 0.057304\\\\\\hline\\text{\\{3, 3, 0\\}} & 10 & 21 & 2 & 0.036053\\\\\\hline\\text{\\{3, 2, 1\\}} & 10 & 21 & 6 & 0.073666\\\\\\hline\\text{\\{2, 2, 2\\}} & 10 & 21 & 10 & 0.10579\\\\\\hline\\end{array}",
