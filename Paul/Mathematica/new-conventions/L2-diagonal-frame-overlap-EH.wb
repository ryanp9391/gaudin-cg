       "data": "Out[1992]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{(1,1): \\#} & \\text{(1,1): leading coeff} & \\text{(2,1): \\#} & \\text{(2,1): leading coeff}\\\\\\hline\\left\\{4,2,0\\right\\} & 0 & \\left\\{3\\,ħh^2\\right\\} & 0 & \\left\\{-3\\,ħh^3\\right\\}\\\\\\hline\\left\\{4,1,1\\right\\} & \\text{$\\infty$ (vanishes)} & 0 & 1 & \\left\\{-\\frac{3\\,ħh^3\\,\\left(\\varphi \\left(1\\right)-\\varphi \\left(3\\right)\\right)\\,\\left(\\varphi \\left(2\\right)-\\varphi \\left(3\\right)\\right)\\,\\left(\\varphi \\left(2\\right)-\\omega \\left(1\\right)\\right)\\,\\left(\\varphi \\left(2\\right)-\\omega \\left(2\\right)\\right)}{\\sqrt{2}\\,\\left(\\varphi \\left(1\\right)-\\varphi \\left(2\\right)\\right)\\,\\left(\\varphi \\left(3\\right)-\\omega \\left(1\\right)\\right)\\,\\left(\\varphi \\left(3\\right)-\\omega \\left(2\\right)\\right)}\\right\\}\\\\\\hline\\left\\{3,3,0\\right\\} & 1 & \\left\\{\\frac{3\\,ħh^2\\,\\left(\\varphi \\left(1\\right)-\\varphi \\left(2\\right)\\right)\\,\\left(\\varphi \\left(1\\right)-\\omega \\left(1\\right)\\right)}{\\sqrt{2}\\,\\left(\\varphi \\left(2\\right)-\\omega \\left(1\\right)\\right)}\\right\\} & 1 & \\left\\{-\\frac{3\\,ħh^3\\,\\left(\\varphi \\left(1\\right)-\\varphi \\left(2\\right)\\right)\\,\\left(\\varphi \\left(1\\right)-\\omega \\left(1\\right)\\right)}{\\sqrt{2}\\,\\left(\\varphi \\left(2\\right)-\\omega \\left(1\\… [latex truncated: 3054 chars total]",
