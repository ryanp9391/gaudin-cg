  {
   "kind": 2,
   "value": "(* leading power: ρ(ε) ≈ C ε^#, # read off from ε = 10^-6 and 10^-9 (also 10^-12 as a check); keep only the states whose limit is HW *)\nepsL = {10^-6, 10^-9, 10^-12};\nsmallData = Table[smallTw[e, φT, ωT, 160], {e, epsL}];\nhwIdx = Flatten[Position[smallData[[2]][\"states\"], x_ /; x[\"hwRes\"] < 10^-5, {1}, Heads -> False]];\nexpo[f_] := Table[Log[Abs[f[smallData[[k + 1]]]/f[smallData[[k]]]]]/Log[epsL[[k + 1]]/epsL[[k]]], {k, 2}];\nhwRows = Table[With[{f = Function[d, d[\"states\"][[b]][\"ρ\"]], g = Function[d, d[\"states\"][[b]][\"Ωψ/x0ψ\"]]}, {smallData[[2]][\"states\"][[b]][\"mu\"], N[expo[f], 6], N[expo[g], 6]}], {b, hwIdx}];\nGrid[Join[{{\"μ (HW limit)\", \"# of ρ (two fits)\", \"# of <Ω|Ψ>/<x0|Ψ>\"}}, hwRows, {{\"<Ω|y0>\", N[expo[#[\"Ωy0\"] &], 6], \"\"}, {\"<x0|y0>\", N[expo[#[\"x0y0\"] &], 6], \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
