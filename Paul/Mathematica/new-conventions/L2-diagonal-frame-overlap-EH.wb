      {
       "data": "Out[835]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{h} & \\text{epsilon} & \\text{working digits} & \\text{states} & \\text{max absolute vector error} & \\text{max relative vector error} & \\text{Q overlap relative error} & \\text{Q-to-transfer coefficient error}\\\\\\hline\\frac{1}{2} & \\frac{1}{1000000} & 240 & 6 & 1.668\\times 10^{-121} & 3.840\\times 10^{-162} & 6.113\\times 10^{-174} & 1.580\\times 10^{-187}\\\\\\hline\\frac{1}{3} & \\frac{1}{1000000} & 240 & 6 & 1.123\\times 10^{-120} & 3.479\\times 10^{-161} & 4.961\\times 10^{-173} & 7.423\\times 10^{-188}\\\\\\hline\\frac{1}{2} & \\frac{1}{1000000000} & 300 & 6 & 5.437\\times 10^{-134} & 1.252\\times 10^{-192} & 1.435\\times 10^{-210} & 6.008\\times 10^{-222}\\\\\\hline\\frac{1}{3} & \\frac{1}{1000000000} & 300 & 6 & 5.806\\times 10^{-134} & 2.568\\times 10^{-191} & 1.207\\times 10^{-208} & 1.643\\times 10^{-223}\\\\\\hline\\frac{1}{2} & \\frac{1}{1000000} & 160 & 6 & 3.354\\times 10^{-37} & 7.722\\times 10^{-78} & 1.783\\times 10^{-89} & 1.897\\times 10^{-108}\\\\\\hline\\text{160 vs 240 digit reconstructed vectors} & 7.722\\times 10^{-78} &  &  &  &  &  & \\\\\\hline\\text{transfer templates agree with original matrices} & \\mathrm{True} &  &  &  &  &  & \\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
