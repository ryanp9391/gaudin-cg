       "data": "Out[2214]= \\begin{array}{|c|c|c|c|}\\hline\\text{time (s)} & 5.088361 &  & \\\\\\hline\\mu  & \\text{hw residual} & \\text{t1(0)} & \\rho \\\\\\hline\\left\\{4,2,0\\right\\} & 0 & 1.20714 & 1.15016\\times 10^{-53}\\\\\\hline\\left\\{4,1,1\\right\\} & 1.41 & 1.20714 & 1.98814\\times 10^{-52}\\\\\\hline\\left\\{4,1,1\\right\\} & 2.02\\times 10^{-7} & 0.707143 & 1.98814\\times 10^{-52}\\\\\\hline\\left\\{3,3,0\\right\\} & 1.41 & 1.20714 & 1.11821\\times 10^{-54}\\\\\\hline\\left\\{3,3,0\\right\\} & 1.69\\times 10^{-7} & 0.707143 & 1.11821\\times 10^{-54}\\\\\\hline\\left\\{3,2,1\\right\\} & 3.16 & 1.20714 & 1.32592\\times 10^{-53}\\\\\\hline\\left\\{3,2,1\\right\\} & 1.41 & 1.20714 & -1.13849\\times 10^{-53}\\\\\\hline\\left\\{3,2,1\\right\\} & 1.73 & 0.707143 & 8.20023\\times 10^{-54}\\\\\\hline\\left\\{3,2,1\\right\\} & 2.88\\times 10^{-7} & -0.0428570 & -3.50311\\times 10^{-47}\\\\\\hline\\left\\{3,2,1\\right\\} & 1.73 & 0.707143 & 1.00225\\times 10^{-53}\\\\\\hline\\left\\{3,2,1\\right\\} & 3.23\\times 10^{-7} & -0.0428573 & 9.25223\\times 10^{-47}\\\\\\hline\\left\\{2,2,2\\right\\} & 3.96 & 1.20714 & -2.65416\\times 10^{-56}\\\\\\hline\\left\\{2,2,2\\right\\} & 3.46 & 1.20714 & -1.34562\\times 10^{-53}\\\\\\hline\\left\\{2,2,2\\right\\} & 2.00 & 1.20714 & 1.10139\\times 10^{-53}\\\\\\hline\\left\\{2,2,2\\right\\} & 2.83… [latex truncated: 1709 chars total]",
