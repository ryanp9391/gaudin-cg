       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[2451]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{$\\mu$  (|projection onto HW\\_$\\mu$|)} & \\text{site1 (1,1)} & \\text{site1 (2,1)} & \\text{site2 A} & \\text{site2 B}\\\\\\hline\\left\\{4,2,0\\right\\} & 0.625 & 0.20833 & 1.4063 & 0.58594\\\\\\hline\\left\\{4,1,1\\right\\} & 0 & 0.19042 & 0.68551 & 0.51413\\\\\\hline\\left\\{3,3,0\\right\\} & 0.070711 & 0.023570 & 0 & 0.099437\\\\\\hline\\left\\{3,2,1\\right\\} & 0.12451 & 0.062787 & 0.12451 & 0.14127\\\\\\hline\\left\\{2,2,2\\right\\} & 0 & 0.0078299 & 0 & 0.0078299\\\\\\hline\\text{identity at $\\theta$2 (A, B)} & \\mathrm{True} & \\mathrm{True} & \\text{[3,2,1] rank} & 2\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
