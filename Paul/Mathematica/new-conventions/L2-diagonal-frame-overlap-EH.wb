       "data": "Out[1939]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\mu  & \\text{dim V\\_$\\mu$} & \\text{mult} & \\text{$\\lambda$ = $\\emptyset$: overlaps} & \\text{$\\lambda$ = (1,1): overlaps} & \\text{|proj|} & \\text{$\\lambda$ = (2,1): overlaps} & \\text{|proj|}\\\\\\hline\\left\\{4,2,0\\right\\} & 27 & 1 & \\left\\{1\\right\\} & \\left\\{\\frac{5}{8}\\right\\} & \\frac{5}{8} & \\left\\{-\\frac{5}{24}\\right\\} & \\frac{5}{24}\\\\\\hline\\left\\{4,1,1\\right\\} & 10 & 1 & \\left\\{0\\right\\} & \\left\\{0\\right\\} & 0 & \\left\\{-\\frac{2275}{8448\\,\\sqrt{2}}\\right\\} & \\frac{2275}{8448\\,\\sqrt{2}}\\\\\\hline\\left\\{3,3,0\\right\\} & 10 & 1 & \\left\\{0\\right\\} & \\left\\{\\frac{1}{10\\,\\sqrt{2}}\\right\\} & \\frac{1}{10\\,\\sqrt{2}} & \\left\\{-\\frac{1}{30\\,\\sqrt{2}}\\right\\} & \\frac{1}{30\\,\\sqrt{2}}\\\\\\hline\\left\\{3,2,1\\right\\} & 8 & 2 & \\left\\{0,0\\right\\} & \\left\\{\\frac{7\\,\\sqrt{\\frac{7}{3}}}{88},-\\frac{7\\,\\sqrt{\\frac{7}{15}}}{176}\\right\\} & \\frac{49}{176\\,\\sqrt{5}} & \\left\\{-\\frac{7\\,\\sqrt{\\frac{7}{3}}}{176},\\frac{49\\,\\sqrt{\\frac{7}{15}}}{2112}\\right\\} & \\frac{7\\,\\sqrt{\\frac{5383}{15}}}{2112}\\\\\\hline\\left\\{2,2,2\\right\\} & 1 & 1 & \\left\\{0\\right\\} & \\left\\{0\\right\\} & 0 & \\left\\{\\frac{343}{30976\\,\\sqrt{2}}\\right\\} & \\frac{343}{30976\\,\\sqrt{2}}\\\\\\hline\\text{$\\Sigma$ mult$\\cdot… [latex truncated: 1263 chars total]",
