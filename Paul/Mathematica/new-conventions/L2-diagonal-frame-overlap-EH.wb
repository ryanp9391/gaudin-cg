      },
      {
       "data": "Out[1930]= \\begin{array}{|c|c|c|c|}\\hline\\text{GT pattern} & \\text{weight} & \\text{<v\\_(1,1)|R\\^{}-1} & \\text{<v\\_(2,1)|R\\^{}-1}\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{2,1\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & \\left\\{2,1,0\\right\\} & \\frac{5}{8} & -\\frac{5}{24}\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{2,0\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & \\left\\{2,0,1\\right\\} & 0 & -\\frac{2275}{8448}\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{2,1\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & \\left\\{1,2,0\\right\\} & \\frac{1}{10} & -\\frac{1}{30}\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{2,0\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & \\left\\{1,1,1\\right\\} & 0 & \\frac{7}{1056\\,\\sqrt{2}}\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & \\left\\{1,1,1\\right\\} & \\frac{49}{88\\,\\sqrt{6}} & -\\frac{49}{176\\,\\sqrt{6}}\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{1,0\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & \\left\\{1,0,2\\right\\} & 0 & -\\frac{22295}{185856}\\\\\\hline\\left\\{\\left\\{0\\right\\},\\left\\{2,0\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & \\left\\{0,2,1\\right\\} & 0 & \\frac{7}{880}\\\\\\hline\\left\\{\\left\\{0\\right\\},\\left\\{1,0\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & \\left\\{0,1,2\\right\\} & 0 & \\frac{343}{15488}\\\\\\hline\\text{helper che… [latex truncated: 1542 chars total]",
