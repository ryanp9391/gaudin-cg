  {
   "kind": 2,
   "value": "auditExp[a_] := IdentityMatrix[Length[a]]+Sum[MatrixPower[a,k]/k!,{k,1,4}];\nauditX0[zz_] := Module[{rs,ppinv,pminv,dinv,x},\nrs=rsSol/.Thread[zs->zz];\nppinv=auditExp[-((zz[[1]]+zz[[2]])/(zz[[1]]zz[[2]]))Ee[2,3]] . auditExp[(1/(zz[[1]]zz[[2]]))Ee[1,3]] . auditExp[-(1/zz[[1]])Ee[1,2]];\npminv=auditExp[-(r[3]/.rs)Ee[2,1]] . auditExp[-(r[2]/.rs)Ee[3,1]] . auditExp[-(r[1]/.rs)Ee[3,2]];\ndinv=DiagonalMatrix[Table[Product[(s[k]/.rs)^(-J0[k][p]),{k,3}],{p,ps[{Λ}]}]];\nx=UnitVector[d1,1] . ppinv . dinv . pminv; Flatten[Outer[Times,x,x]]];\nauditRows[zz_,ww_,hh_,ths_] := Module[{om,dt,f,v11,v21,vA,vB},\nom=UnitVector[d1,1] . auditR[zz,ww];dt=ths[[1]]-ths[[2]];f=(dt-hh)(dt-3 hh);\nv11=om . auditOneT[2,-2 hh,hh,zz];v21=v11 . auditOneT[1,-hh,hh,zz]-om . auditOneT[3,-hh,hh,zz];\nvA=om . auditOneT[2,hh,hh,zz];vB=vA . auditOneT[1,-hh,hh,zz];\n{f Flatten[Outer[Times,v11,om]],(dt-hh)f Flatten[Outer[Times,v21,om]],f Flatten[Outer[Times,om,vA]],Flatten[Outer[Times,om,-(dt-hh)f vB+6 hh^4(Times@@zz)f om]]}];\nauditEigenRows[tt_,hh_,ths_] := With[{x=ths[[1]]-2 hh,y=ths[[2]]+hh},\n{tt[[2]]/.u->x,((tt[[2]]/.u->x)(tt[[1]]/.u->x+hh)-(tt[[3]]/.u->x+hh)),tt[[2]]/.u->y,(tt[[2]]/.u->y)(tt[[1]]/.u->y-2 hh)}];\nauditWList={wN,{11/5,5/3,3/7},{9/4,7/4,2/5},{13/7,12/5,5/9},{7/3,8/5,1/3},{19/8,13/6,5/11}};\nauditXFixed=auditX0[N[zN,prec]];\nauditOverlapTruth=Table[(N[Ω2,prec] . vecS[[b]])/(auditXFixed . vecS[[b]]),{b,nS}];\nauditOverlapAbs=Max[Abs[auditQFixed-auditOverlapTruth]];\nauditOverlapRel=Max[Abs[auditQFixed/auditOverlapTruth-1]];\nauditFullRows=Flatten[Table[auditRows[N[zN,prec],N[ww,prec],hN,thN],{ww,auditWList}],1];\nauditRanks=Table[With[{m=Append[Take[auditFullRows,4 k],auditXFixed]}, {k,Table[With[{sec=Flatten[Position[wtBasis,mu]]},MatrixRank[N[Map[#/Norm[#]&,m[[All,sec]]],40],Tolerance->10^-25]],{mu,{{4,2,0},{4,1,1},{3,3,0},{3,2,1},{2,2,2}}}]}],{k,1,6}];\nauditTFixed=Table[auditFromQ[qu[[b]],N[zN,prec],hN,thN,prec],{b,nS}];\nauditTResidual=Max[Flatten[Table[Abs[CoefficientList[Expand[auditTFixed[[b,a]]-vals[[b,a]]],u]],{b,nS},{a,2}]]];\nGrid[Join[{{\"quantity\",\"value\"}},{{\"Q-overlap absolute residual (64 states)\",ScientificForm[auditOverlapAbs,4]},{\"Q-overlap relative residual (64 states)\",ScientificForm[auditOverlapRel,4]},{\"t1,t2 recovered from dual Q, coefficient residual\",ScientificForm[auditTResidual,4]}},{{\"number of w\",\"ranks in 420,411,330,321,222\"}},auditRanks],Frame->All,Alignment->Left]",
