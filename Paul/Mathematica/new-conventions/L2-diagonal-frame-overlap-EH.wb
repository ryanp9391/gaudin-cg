       "data": "Out[862]= \\begin{array}{|c|c|c|}\\hline\\text{check} & \\text{evidence / tolerance} & \\text{PASS}\\\\\\hline\\text{generic triangular-twist localization} & \\text{symbolic identity} & \\mathrm{True}\\\\\\hline\\text{three independent rational localization tests} & \\text{independently validated} & \\mathrm{True}\\\\\\hline\\text{original row-action implementation} & \\text{exact} & \\mathrm{True}\\\\\\hline\\text{transfer coefficient templates} & \\text{exact} & \\mathrm{True}\\\\\\hline\\text{vacuum transfer formula} & \\text{exact} & \\mathrm{True}\\\\\\hline\\text{three w give full HW-weight ranks} & \\text{exact} & \\mathrm{True}\\\\\\hline\\text{all 64 baseline Q overlaps} & \\text{60 digits; threshold 1e-40} & \\mathrm{True}\\\\\\hline\\text{all 64 baseline Q reconstructions} & \\text{60 digits; threshold 1e-40} & \\mathrm{True}\\\\\\hline\\text{six branches in each small-twist run} & \\text{independently validated} & \\mathrm{True}\\\\\\hline\\text{small-twist relative reconstruction error} & \\text{160-300 digits; threshold 1e-70} & \\mathrm{True}\\\\\\hline\\text{Q-only overlap residuals} & \\text{160-300 digits; threshold 1e-80} & \\mathrm{True}\\\\\\hline\\text{Q-to-transfer coefficient residuals} & \\text{160-300 digits; threshold 1e-100} & \\mathrm{Tru… [latex truncated: 1549 chars total]",
