      {
       "data": "Out[2220]= \\begin{array}{|c|c|c|}\\hline\\text{$\\mu$ (HW limit)} & \\text{\\# of $\\rho$ (two fits)} & \\text{\\# of <$\\Omega$|$\\Psi$>/<x0|$\\Psi$>}\\\\\\hline\\left\\{4,2,0\\right\\} & \\left\\{8.00000,8.00000\\right\\} & \\left\\{-2.00000,-2.00000\\right\\}\\\\\\hline\\left\\{4,1,1\\right\\} & \\left\\{8.00000,8.00000\\right\\} & \\left\\{-2.00000,-2.00000\\right\\}\\\\\\hline\\left\\{3,3,0\\right\\} & \\left\\{8.00000,8.00000\\right\\} & \\left\\{-2.00000,-2.00000\\right\\}\\\\\\hline\\left\\{3,2,1\\right\\} & \\left\\{7.00000,7.00000\\right\\} & \\left\\{-3.00000,-3.00000\\right\\}\\\\\\hline\\left\\{3,2,1\\right\\} & \\left\\{7.00000,7.00000\\right\\} & \\left\\{-3.00000,-3.00000\\right\\}\\\\\\hline\\left\\{2,2,2\\right\\} & \\left\\{6.00000,6.00000\\right\\} & \\left\\{-4.00000,-4.00000\\right\\}\\\\\\hline\\text{<$\\Omega$|y0>} & \\left\\{-10.00000,-10.00000\\right\\} & \\\\\\hline\\text{<x0|y0>} & \\left\\{0.\\times 10^{-71},0.\\times 10^{-44}\\right\\} & \\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
