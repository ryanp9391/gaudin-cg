      {
       "data": "Out[1720]= \\begin{array}{|c|c|}\\hline\\text{c0(h, $\\theta$1, $\\theta$2)} & -\\frac{1}{16\\,ħ^{12}\\,\\left(\\vartheta1-\\vartheta2\\right)^3\\,\\left(ħ+\\vartheta1-\\vartheta2\\right)^4\\,\\left(2\\,ħ+\\vartheta1-\\vartheta2\\right)^2\\,\\left(ħ-\\vartheta1+\\vartheta2\\right)^4\\,\\left(2\\,ħ-\\vartheta1+\\vartheta2\\right)^2}\\\\\\hline\\text{matches numeric} & \\mathrm{True}\\\\\\hline\\text{closed form} & \\mathrm{True}\\\\\\hline\\text{max |R\\_B/Rpred - 1| (all 64)} & \\text{0.}\\times 10^{\\text{-51}}\\\\\\hline\\end{array}",
