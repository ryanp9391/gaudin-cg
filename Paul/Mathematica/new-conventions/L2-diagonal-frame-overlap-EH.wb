   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* leading coefficient C_B(φ,ω) = lim ρ_B/ε^#; fit log|C_B| to integer powers of φ_ij, ω_i-φ_j, ω_ij over random twist directions (degenerate directions with a vanishing factor rejected). The two [3,2,1] states are ordered by Re ev (t1+πt2 at 3/7) so copies match across points *)\nsharpL = {8, 8, 8, 7, 7, 6};\nleadC[φv_, ωv_] := With[{sts = Select[smallTw[10^-14, φv, ωv, 200][\"states\"], #[\"hwRes\"] < 10^-8 &]}, With[{o = Join[sts[[1 ;; 3]], SortBy[sts[[4 ;; 5]], Re[#[\"ev\"]] &], sts[[6 ;;]]]}, Table[o[[b]][\"ρ\"]/10^(-14 sharpL[[b]]), {b, 6}]]];\nfacs[φv_, ωv_] := Join[{φv[[1]] - φv[[2]], φv[[1]] - φv[[3]], φv[[2]] - φv[[3]]}, Flatten[Table[ωv[[i]] - φv[[j]], {i, 3}, {j, 3}]], {ωv[[1]] - ωv[[2]], ωv[[1]] - ωv[[3]], ωv[[2]] - ωv[[3]]}];\nfacNames = Join[{\"φ12\", \"φ13\", \"φ23\"}, Flatten[Table[\"ω\" <> ToString[i] <> \"-φ\" <> ToString[j], {i, 3}, {j, 3}]], {\"ω12\", \"ω13\", \"ω23\"}];\nSeedRandom[11]; fitPts = Select[Table[{RandomInteger[{-30, 30}, 3]/RandomChoice[{7, 11, 13}], RandomInteger[{-30, 30}, 3]/RandomChoice[{9, 17, 19}]}, 40], FreeQ[facs @@ #, 0] &][[1 ;; 26]];\n{fitTime, Cdat} = AbsoluteTiming[leadC @@@ fitPts];\nAm = Table[Join[{1}, Log[Abs[facs @@ p]]], {p, fitPts}];\nfitExp = Table[LeastSquares[N[Am, 40], N[Log[Abs[Cdat[[All, b]]]], 40]], {b, 6}];\nfitRes = Table[Max[Abs[N[Am, 40] . fitExp[[b]] - Log[Abs[Cdat[[All, b]]]]]], {b, 6}];\nGrid[Join[{Join[{\"state\", \"max log-resid\", \"e^const\"}, facNames]}, Table[Join[{{\"[4,2,0]\", \"[4,1,1]\", \"[3,3,0]\", \"[3,2,1]a\", \"[3,2,1]b\", \"[2,2,2]\"}[[b]], ScientificForm[N[fitRes[[b]], 3], 3], N[Exp[fitExp[[b, 1]]], 10]}, N[Round[fitExp[[b, 2 ;;]], 10^-6]]], {b, 6}], {{\"time (s)\", fitTime}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
