   "kind": 2,
   "value": "(* Task B, [4,3,1] symmetric functions of the kappa_1 slopes (kslope_a, kslope_b): S(t) D^m = polynomial of degree <= dP (14 fit points, 6 held out). *)\npolyLS[vals_, m_, dP_] := Module[{A = Table[tsAll[[k]]^i, {k, fitIx}, {i, 0, dP}], b = Table[D431[tsAll[[k]]]^m vals[[k]], {k, fitIx}], co},\n  co = LeastSquares[N[A, 40], N[b, 40]]; {Max[Abs[A . co - b]/Max[Abs[b]]], Max[Table[Abs[Sum[co[[i + 1]] tsAll[[k]]^i, {i, 0, dP}] - D431[tsAll[[k]]]^m vals[[k]]]/Max[Abs[b]], {k, testIx}]], co}];\nsymTab = Flatten[Table[Table[{nm, m, dP, With[{r = polyLS[vals, m, dP]}, {ScientificForm[N[r[[1]], 3]], ScientificForm[N[r[[2]], 3]]}]}, {m, 1, 4}, {dP, {6, 8, 10, 12}}], {nm, {\"kslope_a+b\", \"kslope_a kslope_b\", \"R_a+R_b (control, rational (3,3) known)\", \"kappa_a+kappa_b (control)\"}}, {vals, {{Re[Total[ks431, {2}]], Re[ks431[[All, 1]] ks431[[All, 2]]], Re[Total[Rm, {2}]], Re[Total[kap431sorted, {2}]]}[[Position[{\"kslope_a+b\", \"kslope_a kslope_b\", \"R_a+R_b (control, rational (3,3) known)\", \"kappa_a+kappa_b (control)\"}, nm][[1, 1]]]]}}], 3];\nGrid[Join[{{\"function\", \"m (times D^m)\", \"deg P\", \"{fit set rel resid, held-out rel resid}\"}}, symTab /. {a_, b_, c_, d_} :> {a, b, c, ToString[d]}], Frame -> All, Alignment -> Left]",
