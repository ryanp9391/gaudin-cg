   "kind": 1,
   "value": "Output of the cell above (kernel K1, cell source run via Get; VS Code did not execute this new file):\n\n```\n{\"variant\", \"branch\", \"R\", \"g slope\", \"g fit resid\", \"s1 slope (a'+b' R)\", \"rem slope\", \"rem intercept\", \"F0\", \"F0 spread\"}\n{\"phiP, om1 = 3/4\", \"431a\", -0.09326743729024677952427559065009665043`10., -1.0162824575291510028368255682941426015`10., \n ScientificForm[2.99679552542872870781829`3.*^-15], -0.34280915676588336995873108226991830296`10., -0.67347330076326763287809448602422429854`10., \n -0.29845362275639254427698678696107284043`10., -3737.7254553327093526682`8., ScientificForm[3.27285702880457775`3.*^-21]}\n{\"phiP, om1 = 3/4\", \"431b\", 0.54710616702260777213359686074108471521`10., 0.79408528025922653375249106584630597684`10., \n ScientificForm[1.47275181543932709416833`3.*^-15], -0.25189619238939644740048796788907184083`10., 1.04598147264862298115297903373537781766`10., \n 0.23614732882369195851879749799895702756`10., 1028.5631832822858481035`8., ScientificForm[1.29277676422469454`3.*^-21]}\n{\"phiP, om1 = 3/4\", \"422\", -0.4858757062146892655367231638418079096`10., -0.1527827011697983196453667805462145514`10., \n ScientificForm[4.32099415374616884002718`3.*^-15], 0.37239709443099273607748184019370460048`10., -0.52517979560079105572284862073991915188`10., \n 0.60481577779576286894999650562167911437`10., 4355.5434858944960289802`8., ScientificForm[4.03831342093092806`3.*^-21]}\n{\"phiP, om1 = 7/2\", \"431a\", -0.09326743729024677952427559065009665043`10., -1.0162824575291510028368255682941426015`10., \n ScientificForm[2.99679552542872870781829`3.*^-15], -0.34280915676588336995873108226991830296`10., -0.67347330076326763287809448602422429854`10., \n -0.29845362275639254427698678696107284043`10., -3737.7254553327093526682`8., ScientificForm[3.27285702880457775`3.*^-21]}\n{\"phiP, om1 = 7/2\", \"431b\", 0.54710616702260777213359686074108471521`10., 0.79408528025922653375249106584630597684`10., \n ScientificForm[1.47275181543932709416833`3.*^-15], -0.25189619238939644740048796788907184083`10., 1.04598147264862298115297903373537781766`10., \n 0.23614732882369195851879749799895702756`10., 1028.5631832822858481035`8., ScientificForm[1.29277676422469454`3.*^-21]}\n{\"phiP, om1 = 7/2\", \"422\", -0.4858757062146892655367231638418079096`10., -0.1527827011697983196453667805462145514`10., \n ScientificForm[4.32099415374616884002718`3.*^-15], 0.37239709443099273607748184019370460048`10., -0.52517979560079105572284862073991915188`10., \n 0.60481577779576286894999650562167911437`10., 4355.5434858944960289802`8., ScientificForm[4.03831342093092806`3.*^-21]}\n{\"phi' , om1 = 3/4\", \"431a\", -0.09326743729024677952427573985443502229`10., -1.01628245752915122486578068607081507224`10., \n ScientificForm[2.49977022562804357833166`3.*^-15], -0.34280915676588336995873110345225406424`10., -0.673473300763267854907049582618561008`10., \n 0.90366962690519778634560676339247287367`10., 631.0260895608262320608`8., ScientificForm[2.51364194677111171`3.*^-21]}\n{\"phi' , om1 = 3/4\", \"431b\", 0.54710616702260777213359706621131174169`10., 0.79408528025922632805728334293917269053`10., \n ScientificForm[1.81614476500579768586555`3.*^-15], -0.25189619238939644740048793871874485627`10., 1.0459814726486227754577712816579175468`10., \n -0.20866636303079548675480002693126570008`10., -173.6484423934453407747`8., ScientificForm[1.88346702853193427`3.*^-21]}\n{\"phi' , om1 = 3/4\", \"422\", -0.4858757062146892655367231638418079096`10., -0.15278270116979828055782870842021519937`10., \n ScientificForm[4.20378978339207452794439`3.*^-15], 0.37239709443099273607748184019370460048`10., -0.52517979560079101663531054861391979986`10., \n 1.47757512669209420144964210208898165595`10., 304.9529002397582773115`8., ScientificForm[3.8783191674003613`3.*^-21]}\n{\"phi3, om1 = 3/4\", \"431a\", -0.09326743729024677952427564488277318368`10., -1.01628245752915159552208420160911373677`10., \n ScientificForm[1.8746250065986770043485`3.*^-15], -0.34280915676588336995873108996925718342`10., -0.67347330076326822556335311163985655335`10., \n 0.71107809170508180097444816700162654356`10., -5048.6589698905686494228`8., ScientificForm[1.43967647623949463`3.*^-21]}\n{\"phi3, om1 = 3/4\", \"431b\", 0.54710616702260777213359697981566072337`10., 0.79408528025922653001497273066826916595`10., \n ScientificForm[1.40562891752353654755611`3.*^-15], -0.25189619238939644740048795098421721555`10., 1.0459814726486229774154606816524863815`10., \n 0.73163149198711021548493893204851877414`10., 1389.3114417937024538303`8., ScientificForm[1.23870348432166371`3.*^-21]}\n{\"phi3, om1 = 3/4\", \"422\", -0.4858757062146892655367231638418079096`10., -0.15278270116979825581208736706761289561`10., \n ScientificForm[4.16032975934841126450341`3.*^-15], 0.37239709443099273607748184019370460048`10., -0.52517979560079099188956920726131749609`10., \n 0.03271780279694339649501315881400145887`10., 438.2969187111513285439`8., ScientificForm[3.80565661602392417`3.*^-21]}\n{\"phi4, om1 = 3/4\", \"431a\", -0.09326743729024677952427567458361248205`10., -1.01628245752915119738671845258701929878`10., \n ScientificForm[2.58175194552647741187921`3.*^-15], -0.34280915676588336995873109418584469874`10., -0.67347330076326782742798735840117460005`10., \n -0.0947231451576192166199805934541020257`10., 514.8812646945215461226`8., ScientificForm[2.62290775727623425`3.*^-21]}\n{\"phi4, om1 = 3/4\", \"431b\", 0.54710616702260777213359699189850973913`10., 0.79408528025922661469980248418533665015`10., \n ScientificForm[1.35492025720398902007838`3.*^-15], -0.25189619238939644740048794926883167383`10., 1.04598147264862306210029043345416832398`10., \n 0.65499172072197880902124790315187391036`10., -141.6872156490331729886`8., ScientificForm[1.07601576282969563`3.*^-21]}\n{\"phi4, om1 = 3/4\", \"422\", -0.4858757062146892655367231638418079096`10., -0.15278270116979823401941440652263002118`10., \n ScientificForm[4.17064599634421124764305`3.*^-15], 0.37239709443099273607748184019370460048`10., -0.52517979560079097009689624671633462167`10., \n 0.34468527960504724193038386314208764672`10., 397.3665100265148264045`8., ScientificForm[3.78815804259685189`3.*^-21]}\n{\"time (s)\", \"{1.1301, 22.4857, 39.3035, 39.4659, 39.3985}\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"}\n```",
