  {
   "kind": 2,
   "value": "(* all 8 directions for the two [5,2,1] copies: slope, signal slope, structural remainder Delta_c = slope - slope_sig (phi-independent if structural), F0 (phi-dependent CG slice, om-independent), line residuals, om1-shift. Copies are the eps-ordered copies of the branch list (copy label may permute between phi; the comparison is by sorted Delta). *)\n{tT5, t5res} = AbsoluteTiming[Table[t5Phi[ph], {ph, phis8}]];\nd5 = Table[Table[Re[t5res[[i, \"rows\", c, \"Delta\"]]], {c, 2}], {i, 8}];\nGrid[Join[{{\"phi\", \"copy\", \"F0\", \"F0 spread\", \"slope\", \"intercept\", \"line resid (om1=3/4)\", \"|slope diff om1=7/2|\", \"|icpt diff|\", \"R_c = (u.C)/(u'.C)\", \"slope_sig\", \"Delta_c\"}}, Flatten[Table[Table[{phis8[[i]], c, N[Re[t5res[[i, \"rows\", c, \"F0\"]]], 8], ScientificForm[N[t5res[[i, \"rows\", c, \"F0spread\"]], 3]], N[Re[t5res[[i, \"rows\", c, \"slope\"]]], 10], N[Re[t5res[[i, \"rows\", c, \"icpt\"]]], 10], ScientificForm[N[t5res[[i, \"rows\", c, \"lineRes\"]], 3]], ScientificForm[N[Abs[t5res[[i, \"rows\", c, \"dSlope\"]]], 3]], ScientificForm[N[Abs[t5res[[i, \"rows\", c, \"dIcpt\"]]], 3]], N[Re[t5res[[i, \"rows\", c, \"R\"]]], 10], N[Re[t5res[[i, \"rows\", c, \"slopeSig\"]]], 10], N[d5[[i, c]], 10]}, {c, 2}], {i, 8}], 1], {{\"time (s)\", tT5, \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"}, {\"Delta_c over 8 phi: copy 1 (min, max), copy 2 (min, max)\", ToString[{MinMax[d5[[All, 1]]], MinMax[d5[[All, 2]]]}], \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
