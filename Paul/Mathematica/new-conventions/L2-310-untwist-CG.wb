  {
   "kind": 2,
   "value": "(* Gauss factors of the physical frame, the SoV vacuum x0 with the FACTORIZED inverse (never Inverse[Pph1] at small eps), one-site vacuum rotation Omega, rho(diag), and the point-A undo machinery: site 2 v2 = e1 rho(n_A), site 1 v1 = e1 g(beta,gamma) rho(n_A) rho(Delta) with the exact closed-form dressing g = 1 + beta E12 + gamma (E13 + E12.E23/2) (Undo-site2-rotation-notes 5.3, cell 63 of L2-310-two-rotations.wb). expN is exact for the nilpotent root generators (E_ij^4 = 0, checked) and keeps the precision of a numeric argument. *)\nzs = {z[1], z[2], z[3]}; ws = {w[1], w[2], w[3]};\nrsSol = {s[1] -> z[1]^2/((z[1] - z[2]) (z[1] - z[3])), s[2] -> -(z[2]/(z[1] (z[2] - z[3]))), s[3] -> 1/(z[1] z[2]), r[1] -> -(z[3]/z[2]), r[2] -> -(z[3]/z[1]), r[3] -> (z[2]^2 (-z[1] + z[3]))/(z[1]^2 (z[2] - z[3]))};\nexpN[a_] := With[{A = Normal[a]}, IdentityMatrix[Length[A]] + A + A . A/2 + A . A . A/6];\nchecks[\"expN = MatrixExp on root generators (exact, 3 test values)\"] = And @@ Flatten[Table[If[i == j, True, expN[c Ee[i, j]] === MatrixExp[c Normal[Ee[i, j]]]], {i, 3}, {j, 3}, {c, {3/7, -5/2, 2}}]];\nx0Of[zz_] := Module[{rs, ppinv, pminv, dinv, x},\n  rs = rsSol /. Thread[zs -> zz];\n  ppinv = expN[-((zz[[1]] + zz[[2]])/(zz[[1]] zz[[2]])) Ee[2, 3]] . expN[(1/(zz[[1]] zz[[2]])) Ee[1, 3]] . expN[-(1/zz[[1]]) Ee[1, 2]];\n  pminv = expN[-(r[3] /. rs) Ee[2, 1]] . expN[-(r[2] /. rs) Ee[3, 1]] . expN[-(r[1] /. rs) Ee[3, 2]];\n  dinv = DiagonalMatrix[Table[Product[(s[k] /. rs)^(-J0[k][p]), {k, 3}], {p, ps[{Λ}]}]];\n  x = UnitVector[d1, 1] . ppinv . dinv . pminv; Flatten[KroneckerProduct[x, x]]];\n(* control: factorized x0 = (e1^T Pph^-1)^(x)2 against the plain Inverse at an exact point *)\nx0Control[zz_] := Module[{rs = rsSol /. Thread[zs -> zz], Ppp, Pmp, Pdp, x},\n  Ppp = MatrixExp[(1/zz[[1]]) Normal[Ee[1, 2]]] . MatrixExp[-(1/(zz[[1]] zz[[2]])) Normal[Ee[1, 3]]] . MatrixExp[((zz[[1]] + zz[[2]])/(zz[[1]] zz[[2]])) Normal[Ee[2, 3]]];\n  Pmp = MatrixExp[(r[1] /. rs) Normal[Ee[3, 2]]] . MatrixExp[(r[2] /. rs) Normal[Ee[3, 1]]] . MatrixExp[(r[3] /. rs) Normal[Ee[2, 1]]];\n  Pdp = DiagonalMatrix[Table[Product[(s[k] /. rs)^J0[k][p], {k, 3}], {p, ps[{Λ}]}]];\n  x = First[{UnitVector[d1, 1]} . Inverse[Pmp . Pdp . Ppp]]; Flatten[KroneckerProduct[x, x]]];\nchecks[\"x0Of (factorized inverse) = x0 from Inverse[Pph1] (exact, z = (3/2,5/4,2/3))\"] = x0Of[{3/2, 5/4, 2/3}] === x0Control[{3/2, 5/4, 2/3}];\nρdiag[d_] := DiagonalMatrix[Table[Product[d[[k]]^J0[k][p], {k, 3}], {p, ps[{Λ}]}]];\nDy[y1_, zz_] := Table[1/(y1 - zz[[i]]), {i, 3}];\n(* one-site vacuum rotation Omega_{(w1,w2,w3)} for ket twist zz (first row of exp(r1 E12) exp(r2 E13) exp(r3 E23)); w3 drops out *)\noneSiteVac[zz_, ww_] := Module[{rOmx}, rOmx = {r1 -> (w[1] - z[1])/(w[1] - z[2]), r2 -> ((w[1] - z[1]) (-w[2] + z[1]) (z[2] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (w[2] - z[3])), r3 -> ((w[1] - z[2]) (-w[2] + z[2]) (z[1] - z[3]))/((z[1] - z[2]) (w[1] - z[3]) (-w[2] + z[3]))} /. Join[Thread[zs -> zz], Thread[ws -> ww]];\n  First[{UnitVector[d1, 1]} . expN[(r1 /. rOmx) Ee[1, 2]] . expN[(r2 /. rOmx) Ee[1, 3]] . expN[(r3 /. rOmx) Ee[2, 3]]]];\n(* point-A machinery, parametrized by the twist zz, w1 and w2; the site-2 insertion y_A = w2 y0 (y0 = (th12-h)/(th12-2h), the regime of the spec) *)\nth12 = thN[[1]] - thN[[2]]; t12 = th12/hN; y0 = (th12 - hN)/(th12 - 2 hN);\nyAOf[w2_] := w2 y0;\nu12e1 = UnitVector[d1, 1];\nu12rs[zz_, w1_, y_] := {(w1 - zz[[1]])/(w1 - zz[[2]]), ((w1 - zz[[1]]) (zz[[1]] - y) (zz[[2]] - zz[[3]]))/((zz[[1]] - zz[[2]]) (w1 - zz[[3]]) (y - zz[[3]])), ((w1 - zz[[2]]) (zz[[2]] - y) (zz[[1]] - zz[[3]]))/((zz[[1]] - zz[[2]]) (w1 - zz[[3]]) (zz[[3]] - y))};\nu12nMat[zz_, w1_, y_] := With[{rv = u12rs[zz, w1, y]}, {{1, rv[[1]], rv[[2]] + rv[[1]] rv[[3]]}, {0, 1, rv[[3]]}, {0, 0, 1}}];\nu12rN[zz_, w1_, y_] := With[{rv = u12rs[zz, w1, y]}, expN[rv[[1]] Ee[1, 2]] . expN[rv[[2]] Ee[1, 3]] . expN[rv[[3]] Ee[2, 3]]];\nu12rNinv[zz_, w1_, y_] := With[{rv = u12rs[zz, w1, y]}, expN[-rv[[3]] Ee[2, 3]] . expN[-rv[[2]] Ee[1, 3]] . expN[-rv[[1]] Ee[1, 2]]];\n(* exact closed-form dressing constants (spec 0) *)\ndressBeta[zz_, w1_, w2_] := (zz[[1]] - zz[[2]]) (w1 - zz[[1]]) w2/(2 zz[[2]] (w1 - zz[[2]]) (w2 - zz[[1]]));\ndressGamma[zz_, w1_, w2_] := (th12 - hN) (zz[[1]] - zz[[3]]) (zz[[2]] - zz[[3]]) (w1 - zz[[1]]) w2^2/(4 (th12 - 2 hN) zz[[2]] zz[[3]] (w1 - zz[[3]]) (w2 - zz[[1]]) (yAOf[w2] - zz[[3]]));\ndressMat[b_, g_] := IdentityMatrix[d1] + b Normal[Ee[1, 2]] + g (Normal[Ee[1, 3]] + Normal[Ee[1, 2] . Ee[2, 3]]/2);\nvA2[zz_, w1_, w2_] := u12e1 . u12rN[zz, w1, yAOf[w2]];\nvA1[zz_, w1_, w2_] := u12e1 . dressMat[dressBeta[zz, w1, w2], dressGamma[zz, w1, w2]] . u12rN[zz, w1, yAOf[w2]] . ρdiag[Dy[w2, zz]];\nphiA[zz_, w1_, w2_] := vA1[zz, w1, w2] . u12rNinv[zz, w1, yAOf[w2]];\n(* the regime of the spec: z = 1+eps phi, w1 = 1+eps om1, w2 = 1+eps om2 (exact rationals); w3 = 1+eps 5/13 (w3 drops out of the identity; the adjoint's 2/9 collides with om2 = 2/9) *)\nreg[eps_, ph_, om1_, om2_] := <|\"eps\" -> eps, \"z\" -> 1 + eps ph, \"w1\" -> 1 + eps om1, \"w2\" -> 1 + eps om2, \"y\" -> (1 + eps om2) y0, \"w\" -> {1 + eps om1, 1 + eps om2, 1 + eps 5/13}|>;\nphiP = {1/3, -2/7, 5/11}; phiC = {-2/5, 3/8, 7/11}; om1s = {3/4, -5/3, 7/2}; om2s = {-1/5, 9/7, -12/5, 5/3, 2/9, -7/4};\nomGrid = Flatten[Table[{o1, o2}, {o1, om1s}, {o2, om2s}], 1];\nchecks[\"y0 = -27/8, t12 = 62/35\"] = (y0 === -27/8) && (t12 === 62/35);\nchecks[\"v2 = e1^T rho(n_A) exactly (oneSiteVac vs Gauss element, regime point eps=10^-6)\"] = With[{R = reg[10^-6, phiP, 3/4, -1/5]}, oneSiteVac[R[\"z\"], {R[\"w1\"], R[\"y\"], 1}] === vA2[R[\"z\"], R[\"w1\"], R[\"w2\"]]];\n(* regime behaviour of the dressing constants: beta -> beta0 = (phi1-phi2)(om1-phi1)/(2(om1-phi2)(om2-phi1)), gamma = O(eps) *)\nchecks[\"dressing in the regime: beta(eps=1e-6)/beta0 - 1, gamma(1e-6)/gamma(2e-6) (expect ~ 1/2)\"] = With[{R = reg[10^-6, phiP, 3/4, -1/5], R2 = reg[2 10^-6, phiP, 3/4, -1/5]}, {N[dressBeta[R[\"z\"], R[\"w1\"], R[\"w2\"]]/((phiP[[1]] - phiP[[2]]) (3/4 - phiP[[1]])/(2 (3/4 - phiP[[2]]) (-1/5 - phiP[[1]]))) - 1, 5], N[dressGamma[R[\"z\"], R[\"w1\"], R[\"w2\"]]/dressGamma[R2[\"z\"], R2[\"w1\"], R2[\"w2\"]], 8]}];\nshowChecks[{\"expN\", \"x0Of\", \"y0\", \"v2\", \"dressing\"}]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
