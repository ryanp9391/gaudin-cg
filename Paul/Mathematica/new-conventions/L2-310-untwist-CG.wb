n)\", 3, 6, \"          -4\\n{3.92 × 10  , 2.53}\"}\n{\"R_a+R_b (control, rational (3,3) known)\", 3, 8, \"          -8           -2\\n{4.81 × 10  , 1.37 × 10  }\"}\n{\"R_a+R_b (control, rational (3,3) known)\", 3, 10, \"          -22           -17\\n{1.10 × 10   , 5.87 × 10   }\"}\n{\"R_a+R_b (control, rational (3,3) known)\", 3, 12, \"          -23           -14\\n{1.73 × 10   , 1.67 × 10   }\"}\n{\"R_a+R_b (control, rational (3,3) known)\", 4, 6, \"          -3           1\\n{4.36 × 10  , 4.30 × 10 }\"}\n{\"R_a+R_b (control, rational (3,3) known)\", 4, 8, \"          -5\\n{1.54 × 10  , 4.99}\"}\n{\"R_a+R_b (control, rational (3,3) known)\", 4, 10, \"          -9           -2\\n{2.64 × 10  , 5.41 × 10  }\"}\n{\"R_a+R_b (control, rational (3,3) known)\", 4, 12, \"          -26           -17\\n{6.00 × 10   , 5.70 × 10   }\"}\n{\"kappa_a+kappa_b (control)\", 1, 6, \"          -13           -11\\n{3.16 × 10   , 3.46 × 10   }\"}\n{\"kappa_a+kappa_b (control)\", 1, 8, \"          -13           -9\\n{2.36 × 10   , 2.76 × 10  }\"}\n{\"kappa_a+kappa_b (control)\", 1, 10, \"          -13           -7\\n{2.01 × 10   , 1.07 × 10  }\"}\n{\"kappa_a+kappa_b (control)\", 1, 12, \"          -14           -5\\n{3.18 × 10   , 3.06 × 10  }\"}\n{\"kappa_a+kappa_b (control)\", 2, 6, \"          -15           -13\\n{1.18 × 10   , 1.30 × 10   }\"}\n{\"kappa_a+kappa_b (control)\", 2, 8, \"          -16           -11\\n{8.83 × 10   , 1.04 × 10   }\"}\n{\"kappa_a+kappa_b (control)\", 2, 10, \"          -16           -10\\n{7.53 × 10   , 4.02 × 10   }\"}\n{\"kappa_a+kappa_b (control)\", 2, 12, \"          -16           -7\\n{1.19 × 10   , 1.15 × 10  }\"}\n{\"kappa_a+kappa_b (control)\", 3, 6, \"          -4           -1\\n{1.48 × 10  , 9.30 × 10  }\"}\n{\"kappa_a+kappa_b (control)\", 3, 8, \"          -8           -3\\n{1.28 × 10  , 3.65 × 10  }\"}\n{\"kappa_a+kappa_b (control)\", 3, 10, \"          -18           -12\\n{2.71 × 10   , 1.54 × 10   }\"}\n{\"kappa_a+kappa_b (control)\", 3, 12, \"          -19           -10\\n{4.42 × 10   , 4.19 × 10   }\"}\n{\"kappa_a+kappa_b (control)\", 4, 6, \"          -3           1\\n{2.90 × 10  , 2.49 × 10 }\"}\n{\"kappa_a+kappa_b (control)\", 4, 8, \"          -6\\n{5.84 × 10  , 1.86}\"}\n{\"kappa_a+kappa_b (control)\", 4, 10, \"          -10           -2\\n{7.45 × 10   , 1.53 × 10  }\"}\n{\"kappa_a+kappa_b (control)\", 4, 12, \"          -25           -16\\n{4.96 × 10   , 4.71 × 10   }\"}\n```",
