  {
   "kind": 2,
   "value": "(* Task B: the natural constant is the omega2-slope of the O(eps) correction kappa_1 of R_C/S = kappa_0 + eps kappa_1 + ..., kslope = kappa_0 x (rem slope) (F1/F0 = s1 + kappa_1/kappa_0). Fits: [4,2,2] rational in t (t = 7/3 excluded); [4,3,1]: kslope_c D^m = P(t) + Q(t) tau_c, m = 0,1,2, polynomial degrees up to 7. *)\nkap431sorted = Table[{kapA[[k]], kapB2[[k]]}, {k, 20}];\nks431 = Re[kap431sorted remS]; ks422 = Re[Table[kapAll[[k, 4]], {k, 20}] rem422];\naffLS2[vals_, m_, dP_, dQ_] := Module[{rows, co, resFit, resTest, row},\n  row[k_, c_] := Join[Table[tsAll[[k]]^i, {i, 0, dP}], Table[tsAll[[k]]^j tau431s[[k, c]], {j, 0, dQ}]];\n  rows = Flatten[Table[{row[k, c], D431[tsAll[[k]]]^m vals[[k, c]]}, {k, fitIx}, {c, 2}], 1];\n  co = LeastSquares[N[rows[[All, 1]], 40], N[rows[[All, 2]], 40]];\n  resFit = Max[Abs[rows[[All, 1]] . co - rows[[All, 2]]]]; resTest = Max[Flatten[Table[Abs[row[k, c] . co - D431[tsAll[[k]]]^m vals[[k, c]]], {k, testIx}, {c, 2}]]];\n  {co, resFit, resTest}];\naffTab2 = Flatten[Table[Table[{m, dP, dQ, With[{r = affLS2[ks431, m, dP, dQ]}, {ScientificForm[N[r[[2]], 3]], ScientificForm[N[r[[3]], 3]]}]}, {dP, {3 + 2 m, 4 + 2 m}}, {dQ, {1 + m, 2 + m, 3 + m}}], {m, 0, 2}], 2];\nrows422 = {fitWithout[{4}, Function[showFit[\"[4,2,2] kslope = kappa_0 x rem slope\", ks422]]], fitWithout[{4}, Function[showFit[\"[4,2,2] kappa_1 slope check: rem slope\", rem422]]]};\nrows431s = {showFit[\"[4,3,1] kslope_a + kslope_b\", Re[Total[ks431, {2}]]], showFit[\"[4,3,1] kslope_a kslope_b\", Re[ks431[[All, 1]] ks431[[All, 2]]]], showFit[\"[4,3,1] g slope (F1/F0 slope) copy a\", Re[Table[lsB[[k]][sortedCopies[k][[1]]][\"gSlope\"], {k, 20}]]]};\nGrid[Join[{{\"[4,3,1] kslope_c D^m = P + Q tau_c: m, deg P, deg Q\", \"max resid fit set / held-out\"}}, Table[{ToString[a[[1 ;; 3]]], ToString[a[[4]]]}, {a, affTab2}], {{\"fits\", \"\", \"\", \"\", \"\"}}, rows422, rows431s], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [],
