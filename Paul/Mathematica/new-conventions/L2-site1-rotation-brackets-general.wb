  {
   "kind": 2,
   "value": "(* 6c-3: explicit F(u), G(u) for the columns that have a class structure, and the full overlap identity. (0,1): 3-point support S3 = {-4,-3,-2}, P = wgt3 Pol_1 / (m (tv + m + 1)); (0,0): 4-point support S4 = {-4..-1}, P = wgt4 Pol_1 / nu with nu = (tv + m + 1) except at the end point m = -1 where nu carries the factor 1/om1, om1 = 3 (sR - 1)/(3 sR - 2). wgt_S(m) = 1/prod_{m' in S, m' != m}(x_m' - x_m) = (-1)^(|S|-1)/P_S'(x_m) with P_S(u) = prod (u - x_m'), so F(u) is a gA^((u - theta1)/h) times a rational function of u with poles at u = theta1, theta2 - h and at the support nodes (through 1/P_S'). *)\nClearAll[uNode, uDer, uFu01, uGu01, uFu00, uGu00, uLam01, uLam00, uVec, uOm1, uOvlDev];\nuX1 = thN[[1]]; uX2 = thN[[2]]; uH = hN; uS3 = {-4, -3, -2}; uS4 = {-4, -3, -2, -1};\nuNode[m_] := uX1 + m uH;\nuDer[S_][u_] := Sum[Product[u - uNode[mm2], {mm2, DeleteCases[S, mm]}], {mm, S}];\nuFu01[a_][u_] := uH^4 a^((u - uX1)/uH)/(uDer[uS3][u] (u - uX1) (u - uX2 + uH));\nuGu01[a_][u_] := uH^3 a^((u - uX1)/uH)/(uDer[uS3][u] (u - uX2 + uH));\nuOm1[a_, g_] := 3 (g/a - 1)/(3 g/a - 2);\nuFu00[a_, g_][u_] := -uH^4 a^((u - uX1)/uH)/(uDer[uS4][u] (u - uX2 + uH)) (1 + (uOm1[a, g] - 1) KroneckerDelta[u, uNode[-1]]);\nuGu00[a_, g_][u_] := uFu00[a, g][u] (u - uX1)/uH;\nuLam01[tv_] := 48 (tv - 3) (tv + 1)/tv;\nuLam00[a_, g_, tv_] := -12 (tv - 3) (3 g/a - 2);\nuVec[fun_, S_] := Table[If[MemberQ[S, m], fun[uNode[m]], 0], {m, uPts}];\n(* exact wedge identities at t = 62/35, symbolic in (gA, gC): A^(0,1) = lam01 gA^8 F^G and A^(0,0) = lam00 gA^9 F^G *)\nuWedChk = {Together[uA[tPar, gA, gC][{0, 1}] - uLam01[tPar] gA^8 uWed[uVec[uFu01[gA], uS3], uVec[uGu01[gA], uS3]]] === ConstantArray[0, {5, 5}], Together[uA[tPar, gA, gC][{0, 0}] - uLam00[gA, gC, tPar] gA^9 uWed[uVec[uFu00[gA, gC], uS4], uVec[uGu00[gA, gC], uS4]]] === ConstantArray[0, {5, 5}]};\n(* the same identities symbolic in tv in the m-frame (h = 1): F = wgt/(m (tv + m + 1)), G = wgt/(tv + m + 1); and the natural 4-point wedge (no end-point factor) splits A^(0,0) as -12 (tv - 3) gA^9 [(3 sR - 2) (F^G on S3 pairs) + 3 (sR - 1) (F^G on pairs containing -1)] *)\nuWm[S_, m_] := If[MemberQ[S, m], 1/Product[mm - m, {mm, DeleteCases[S, m]}], 0];\nuF01m = Table[If[MemberQ[uS3, m], uWm[uS3, m]/(m (tv + m + 1)), 0], {m, uPts}];\nuG01m = Table[If[MemberQ[uS3, m], uWm[uS3, m]/(tv + m + 1), 0], {m, uPts}];\nuF00m = Table[If[MemberQ[uS4, m], uWm[uS4, m]/(tv + m + 1), 0], {m, uPts}];\nuG00m = Table[If[MemberQ[uS4, m], uWm[uS4, m] m/(tv + m + 1), 0], {m, uPts}];\nuNat00 = Together /@ uWed[uF00m, uG00m];\nuSplit00 = Table[If[uPts[[i]] == -1 || uPts[[j]] == -1, 3 (sR - 1), 3 sR - 2] uNat00[[i, j]], {i, 5}, {j, 5}];\nuPw2 = Table[gA^(uPts[[i]] + uPts[[j]]), {i, 5}, {j, 5}];\nuSymChk = {Together[uA[tv, gA, sR gA][{0, 1}] - uLam01[tv] gA^8 uPw2 Together /@ uWed[uF01m, uG01m]] === ConstantArray[0, {5, 5}], Together[uA[tv, gA, sR gA][{0, 0}] + 12 (tv - 3) gA^9 uPw2 uSplit00] === ConstantArray[0, {5, 5}]};\n(* full overlap identity <Phi|Psi>/<x0|Psi> M1_vac = sum_c2 lambda2^(c2) sum_c Bk2[F, G] Q^3(theta1 - c h) on all states, with the (0,1) and/or (0,0) wedges replaced by the u-function forms; the other columns are the 6b-5 closed forms *)\nuOvlDev[pt_, mode_] := Module[{a = gA /. pt, g = gC /. pt, cov, decs, lhs, rhs, d01, d00},\n  cov = Normal[gaussCov[{a, a^2 - a g, g}]];\n  decs = Flatten[Table[Map[{c2, c, #[[1]] /. pt, #[[2]] /. pt} &, uHand[tPar, gA, gC][{c2, c}]], {c2, 0, 1}, {c, 0, 1}], 2];\n  d01 = {0, 1, uLam01[tPar] a^8 uVec[uFu01[a], uS3], uVec[uGu01[a], uS3]};\n  d00 = {0, 0, uLam00[a, g, tPar] a^9 uVec[uFu00[a, g], uS4], uVec[uGu00[a, g], uS4]};\n  decs = Which[mode == \"6b\", decs, mode == \"(0,1)\", Append[DeleteCases[decs, {0, 1, __}], d01], mode == \"(0,0)\", Append[DeleteCases[decs, {0, 0, __}], d00], True, Join[DeleteCases[decs, {0, 1, __} | {0, 0, __}], {d01, d00}]];\n  lhs = Table[ovlExact[cov, A] sm23[[A, 1, vacL]], {A, nS}];\n  rhs = Table[Sum[facL[A, d[[1]]] bk2N[A, d[[3]], d[[4]]] vm[A, 1, -d[[2]]][[3]], {d, decs}], {A, nS}];\n  Max[Abs[lhs - rhs]]/Max[Abs[lhs]]];\nuPtsFresh = {{gA -> 5/2, gC -> -3/7}, {gA -> -4/3, gC -> 2/5}};\n{uTimeOvl, uOvl} = AbsoluteTiming[Table[Table[uOvlDev[pt, md], {md, {\"6b\", \"(0,1)\", \"(0,0)\", \"both\"}}], {pt, uPtsFresh}]];\nGrid[{{\"exact wedge identities at t = 62/35 ((0,1), (0,0)), symbolic in gA, gC\", uWedChk}, {\"symbolic in tv (h = 1 frame) ((0,1); (0,0) split)\", uSymChk}, {\"overlap deviation over 225 states, rows: 2 fresh points; columns: 6b forms, (0,1) u-form, (0,0) u-form, both\", N[uOvl, 3]}, {\"time (s)\", uTimeOvl}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
