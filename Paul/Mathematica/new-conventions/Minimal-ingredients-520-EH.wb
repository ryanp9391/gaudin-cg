       "data": "Out[647]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{S\\_ref insertion} & \\text{spread over directions ($\\varepsilon$=10\\^{}-5)} & \\text{k = K\\_j/S\\_ref, j = \\{\\{1, 1\\}, \\{2, 2\\}, \\{3, 3\\}, \\{4, 3\\}, \\{5, 3\\}\\}} & \\text{s = S\\_j/S\\_ref}\\\\\\hline\\left\\{10,3,1\\right\\} & 1 & \\left\\{4,3\\right\\} & 7.0\\times 10^{-7} & \\left\\{0,0,0,2.1150\\times 10^{-7},-8.1580\\times 10^{-8}\\right\\} & \\left\\{0,0,0,1.\\,,-0.38572\\right\\}\\\\\\hline\\left\\{10,2,2\\right\\} & 1 & \\left\\{5,3\\right\\} & 8.8\\times 10^{-6} & \\left\\{0,0,0,-2.0000,0.77143\\right\\} & \\left\\{0,0,0,0,1.\\,\\right\\}\\\\\\hline\\left\\{9,5,0\\right\\} & 1 & \\left\\{1,1\\right\\} & 0.000010 & \\left\\{-6.3379\\times 10^{-7},-5.8464\\times 10^{-7},3.7691\\times 10^{-7},4.3076\\times 10^{-8},0\\right\\} & \\left\\{1.\\,,0.92245,-0.59470,-0.067966,0.013108\\right\\}\\\\\\hline\\left\\{9,4,1\\right\\} & 1 & \\left\\{1,1\\right\\} & 0.000049 & \\left\\{2.1003\\times 10^{-6},1.9374\\times 10^{-6},-1.2491\\times 10^{-6},-1.5657\\times 10^{-7},3.2859\\times 10^{-8}\\right\\} & \\left\\{1.\\,,0.92245,-0.59470,0.47700,-0.19710\\right\\}\\\\\\hline\\left\\{9,4,1\\right\\} & 2 & \\left\\{1,1\\right\\} & 0.000013 & \\left\\{5.2155\\times 10^{-7},4.8111\\times 10^{-7},-3.1017\\times 10^{-7},-4.3025\\times 10^{-8},0\\righ… [latex truncated: 5128 chars total]",
