      {
       "data": "Out[657]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{mult} & \\text{dim sector clean space} & \\text{sector HW rel. sv ($\\varepsilon$=10\\^{}-5)} & \\text{per copy: \\{space, dim, \\{rel. err, digits\\} at (10\\^{}-4, $\\varphi$), at (10\\^{}-5, $\\varphi$')\\}}\\\\\\hline\\left\\{10,3,1\\right\\} & 1 & 5 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & 5 & \\left\\{2.12\\times 10^{-6},259\\right\\} & \\left\\{7.47\\times 10^{-8},253\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{10,2,2\\right\\} & 1 & 4 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & 4 & \\left\\{5.86\\times 10^{-6},253\\right\\} & \\left\\{3.25\\times 10^{-6},248\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{9,5,0\\right\\} & 1 & 5 & \\left\\{1.\\,\\right\\} & \\begin{pmatrix}\\text{sector} & 5 & \\left\\{6.34\\times 10^{-6},275\\right\\} & \\left\\{7.93\\times 10^{-7},272\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{9,4,1\\right\\} & 2 & 5 & \\left\\{1.\\,,0.0100\\right\\} & \\begin{pmatrix}\\text{sector} & 5 & \\left\\{0.0000407,268\\right\\} & \\left\\{1.30\\times 10^{-6},263\\right\\}\\\\\\text{sector} & 5 & \\left\\{0.0000957,270\\right\\} & \\left\\{1.31\\times 10^{-6},265\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{9,3,2\\right\\} & 2 & 3 & \\left\\{1.\\,,8.87\\times 10^{-9}\\right\\} & \\begin{pmatrix}\\text{per copy} & 4 & \\left\\{… [latex truncated: 4318 chars total]",
