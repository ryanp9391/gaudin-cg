      {
       "data": "Out[665]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{sector $\\sigma$\\_min} & \\text{sector: log10 err (10\\^{}-5, $\\varphi$')} & \\text{(10\\^{}-6, $\\varphi$')} & \\text{per copy: log10 err (10\\^{}-5, $\\varphi$')} & \\text{(10\\^{}-6, $\\varphi$')}\\\\\\hline\\left\\{9,4,1\\right\\} & 1 & 0.01 & -5.9 & -6.9 & -5.9 & -6.9\\\\\\hline\\left\\{9,4,1\\right\\} & 2 & 0.01 & -5.9 & -6.9 & -5.9 & -6.9\\\\\\hline\\left\\{7,6,1\\right\\} & 1 & 0.0247 & -5.7 & -7.7 & -5.4 & -7.1000000000000005\\\\\\hline\\left\\{7,6,1\\right\\} & 2 & 0.0247 & -4.800000000000001 & -5.1000000000000005 & -5.300000000000001 & -6.2\\\\\\hline\\left\\{7,4,3\\right\\} & 1 & 0.019200000000000002 & -5.\\, & -5.9 & -5.\\, & -5.9\\\\\\hline\\left\\{7,4,3\\right\\} & 2 & 0.019200000000000002 & -3.3000000000000003 & -4.3 & -4.5 & -5.7\\\\\\hline\\text{time (s)} & 67.252815 &  &  &  &  & \\\\\\hline\\end{array}",
