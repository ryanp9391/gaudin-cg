      {
       "data": "Out[617]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{dim weight space} & \\text{HW multiplicity} & \\text{HW-limit states found} & \\text{largest ‖P\\_HW $\\Psi$‖/‖$\\Psi$‖ ($\\varepsilon$ = 10\\^{}-3)}\\\\\\hline\\left\\{10,4,0\\right\\} & 1 & 1 & 1 & \\left\\{1.\\,\\right\\}\\\\\\hline\\left\\{10,3,1\\right\\} & 2 & 1 & 1 & \\left\\{1.0000,0.0003490\\right\\}\\\\\\hline\\left\\{10,2,2\\right\\} & 3 & 1 & 1 & \\left\\{1.0000,0.0008376\\right\\}\\\\\\hline\\left\\{9,5,0\\right\\} & 2 & 1 & 1 & \\left\\{1.0000,0.0002461\\right\\}\\\\\\hline\\left\\{9,4,1\\right\\} & 6 & 2 & 2 & \\left\\{1.0000,1.0000,0.0003251\\right\\}\\\\\\hline\\left\\{9,3,2\\right\\} & 10 & 2 & 2 & \\left\\{1.0000,1.0000,0.0006658\\right\\}\\\\\\hline\\left\\{8,6,0\\right\\} & 3 & 1 & 1 & \\left\\{1.0000,0.0004521\\right\\}\\\\\\hline\\left\\{8,5,1\\right\\} & 10 & 2 & 2 & \\left\\{1.0000,1.0000,0.0004132\\right\\}\\\\\\hline\\left\\{8,4,2\\right\\} & 20 & 3 & 3 & \\left\\{1.0000,1.0000,1.0000,0.0005369\\right\\}\\\\\\hline\\left\\{8,3,3\\right\\} & 24 & 1 & 1 & \\left\\{1.0000,0.0009207\\right\\}\\\\\\hline\\left\\{7,7,0\\right\\} & 4 & 1 & 1 & \\left\\{1.0000,0.0009591\\right\\}\\\\\\hline\\left\\{7,6,1\\right\\} & 14 & 2 & 2 & \\left\\{1.0000,1.0000,0.0007441\\right\\}\\\\\\hline\\left\\{7,5,2\\right\\} & 30 & 3 & 3 & \\left\\{1.0000,1.0000,1.0000,0.0006158\\right\\… [latex truncated: 1651 chars total]",
