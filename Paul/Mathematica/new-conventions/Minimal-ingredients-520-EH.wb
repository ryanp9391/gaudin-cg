       "data": "Out[662]= \\begin{array}{|c|c|}\\hline\\mu  & \\text{per copy: \\{copy, space, log10 rel. err at (10\\^{}-5, $\\varphi$'), at (10\\^{}-6, $\\varphi$'), digits\\}}\\\\\\hline\\left\\{10,3,1\\right\\} & \\begin{pmatrix}1 & \\text{sector} & -7.1000000000000005 & -8.1 & 246\\end{pmatrix}\\\\\\hline\\left\\{10,2,2\\right\\} & \\begin{pmatrix}1 & \\text{sector} & -5.4 & -6.5 & 240\\end{pmatrix}\\\\\\hline\\left\\{9,5,0\\right\\} & \\begin{pmatrix}1 & \\text{sector} & -6.1000000000000005 & -7.1000000000000005 & 268\\end{pmatrix}\\\\\\hline\\left\\{9,4,1\\right\\} & \\begin{pmatrix}1 & \\text{sector} & -5.9 & -6.9 & 258\\\\2 & \\text{sector} & -5.9 & -6.9 & 260\\end{pmatrix}\\\\\\hline\\left\\{9,3,2\\right\\} & \\begin{pmatrix}1 & \\text{per copy} & -5.6000000000000005 & -6.7 & 242\\\\2 & \\text{per copy} & -5.\\, & -5.9 & 244\\end{pmatrix}\\\\\\hline\\left\\{8,6,0\\right\\} & \\begin{pmatrix}1 & \\text{sector} & -5.7 & -6.9 & 253\\end{pmatrix}\\\\\\hline\\left\\{8,5,1\\right\\} & \\begin{pmatrix}1 & \\text{per copy} & -6.2 & -7.5 & 242\\\\2 & \\text{per copy} & -4.9 & -5.800000000000001 & 246\\end{pmatrix}\\\\\\hline\\left\\{8,4,2\\right\\} & \\begin{pmatrix}1 & \\text{per copy} & -5.9 & -6.7 & 232\\\\2 & \\text{per copy} & -5.1000000000000005 & -6.\\, & 237\\\\3 & \\text{per copy} & -4.600000000000000… [latex truncated: 2482 chars total]",
