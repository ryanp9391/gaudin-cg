       "data": "Out[102]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|}\\hline\\text{P2: directions} & \\varepsilon  & \\text{K\\_b/S} & \\text{K\\_c/S} & \\text{$\\beta$ = -K\\_c/K\\_b}\\\\\\hline\\text{$\\varphi$, $\\omega$} & \\frac{1}{10000} & -0.93334787 & 0.28893725 & 0.30957080\\\\\\hline\\text{$\\varphi$, $\\omega$} & \\frac{1}{100000} & -0.93333479 & 0.28889372 & 0.30952851\\\\\\hline\\text{$\\varphi$' = (-2/5, 3/8, 7/11), $\\omega$} & \\frac{1}{10000} & -0.93336703 & 0.28894953 & 0.30957761\\\\\\hline\\text{$\\varphi$' = (-2/5, 3/8, 7/11), $\\omega$} & \\frac{1}{100000} & -0.93333670 & 0.28889495 & 0.30952919\\\\\\hline\\text{$\\varphi$, $\\omega$' = (1/9, 5/4, -3/7)} & \\frac{1}{10000} & -0.93321254 & 0.28875036 & 0.30941543\\\\\\hline\\text{$\\varphi$, $\\omega$' = (1/9, 5/4, -3/7)} & \\frac{1}{100000} & -0.93332125 & 0.28887504 & 0.30951297\\\\\\hline\\text{candidate closed form} &  & -0.93333333 & 0.28888889 & 0.30952381\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{$\\kappa$(v*) at P1, $\\varepsilon$=10\\^{}-3} & \\text{$\\varepsilon$=10\\^{}-4} & \\text{$\\kappa$(v*) at P2, $\\varepsilon$=10\\^{}-3} & \\text{$\\varepsilon$=10\\^{}-4}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & \\text{0 = 0} & \\text{0 = 0} & \\text{0 = 0} & \\text{0 = 0}\\\\\\hlin… [latex truncated: 1674 chars total]",
