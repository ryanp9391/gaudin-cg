       "data": "Out[90]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{$\\kappa$, (b,c)=(1,0), $\\varepsilon$=10\\^{}-3} & \\text{$\\varepsilon$=10\\^{}-4} & \\text{$\\kappa$, (b,c)=(0,1), $\\varepsilon$=10\\^{}-3} & \\text{$\\varepsilon$=10\\^{}-4} & \\text{chain residual}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & \\text{0 = 0} & \\text{0 = 0} & \\text{0 = 0} & \\text{0 = 0} & 0.\\times 10^{-67}\\\\\\hline\\left\\{4,1,1\\right\\} & 1 & \\text{0 = 0} & \\text{0 = 0} & 0.99985724 & 0.99998572 & 0.\\times 10^{-71}\\\\\\hline\\left\\{3,3,0\\right\\} & 1 & 1.0001194 & 1.0000119 & 1.0001194 & 1.0000119 & 0.\\times 10^{-70}\\\\\\hline\\left\\{3,2,1\\right\\} & 1 & 1.0003816 & 1.0000382 & 1.0000938 & 1.0000094 & 0.\\times 10^{-65}\\\\\\hline\\left\\{3,2,1\\right\\} & 2 & 1.0000735 & 1.0000074 & 1.0000737 & 1.0000074 & 0.\\times 10^{-65}\\\\\\hline\\left\\{2,2,2\\right\\} & 1 & \\text{CG = 0} & \\text{CG = 0} & 1.1813958 & 1.1809967 & 0.\\times 10^{-56}\\\\\\hline\\text{a formula vs c\\_$\\lambda$$\\cdot$e1e1} & 0.\\times 10^{-67} &  &  &  &  & \\\\\\hline\\text{time (s)} & 0.270721 &  &  &  &  & \\\\\\hline\\end{array}",
