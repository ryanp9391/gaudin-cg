       "data": "Out[62]= \\begin{array}{|c|c|c|c|c|}\\hline\\mu  & \\text{dim weight space} & \\text{dim HW space} & \\text{HW-limit states} & \\text{‖P\\_HW $\\Psi$‖/‖$\\Psi$‖ ($\\varepsilon$ = 10\\^{}-3)}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & 1 & 1 & \\left\\{1.\\,\\right\\}\\\\\\hline\\left\\{4,1,1\\right\\} & 2 & 1 & 1 & \\left\\{1.0000,0.0005129\\right\\}\\\\\\hline\\left\\{3,3,0\\right\\} & 2 & 1 & 1 & \\left\\{1.0000,0.0004289\\right\\}\\\\\\hline\\left\\{3,2,1\\right\\} & 6 & 2 & 2 & \\left\\{1.0000,1.0000,0.0003816,0.0003191,0.0002123,0.00005340\\right\\}\\\\\\hline\\left\\{2,2,2\\right\\} & 10 & 1 & 1 & \\left\\{1.0000,0.0005321,0.0001245,0.0001203,0.00002815,5.580\\times 10^{-8},2.340\\times 10^{-8},2.337\\times 10^{-9},0,0\\right\\}\\\\\\hline\\text{time (s)} & 0.290073 &  &  & \\\\\\hline\\end{array}",
