       "data": "Out[21]= \\begin{array}{|c|c|}\\hline\\text{one-site, two-site dimension} & \\left\\{8,64\\right\\}\\\\\\hline\\text{Rd} & \\left\\{1,1,1,\\sqrt{2},\\sqrt{6},3,2,3\\right\\}\\\\\\hline\\text{EH\\^{}T = EH\\_ji} & \\mathrm{True}\\\\\\hline\\text{weight sectors} & 19\\\\\\hline\\end{array}",
