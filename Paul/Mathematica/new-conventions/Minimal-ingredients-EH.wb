      {
       "data": "Out[36]= \\begin{array}{|c|c|}\\hline\\text{qdet residual} & 0.\\times 10^{-78}\\\\\\hline\\text{[t1(1/3), t2(-2/5)]} & 0.\\times 10^{-78}\\\\\\hline\\text{off-weight entries of T21} & 0\\\\\\hline\\text{time (s)} & 1.219749\\\\\\hline\\end{array}",
