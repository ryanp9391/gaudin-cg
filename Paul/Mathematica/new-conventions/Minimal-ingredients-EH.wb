      {
       "data": "Out[78]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\mu  & \\text{copy} & \\text{covector} & \\text{chain residual} & \\text{$\\kappa$ at $\\varepsilon$ = 10\\^{}-3} & \\text{$\\kappa$ at $\\varepsilon$ = 10\\^{}-4}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & \\text{11} & 0.\\times 10^{-69} & 1.\\, & 1.\\,\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & \\text{21} & 0.\\times 10^{-64} & 1.\\, & 1.\\,\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & \\text{C} & 0.\\times 10^{-59} & \\left\\{\\text{CG = 0},0.\\times 10^{-70}\\right\\} & \\left\\{\\text{CG = 0},0.\\times 10^{-68}\\right\\}\\\\\\hline\\left\\{4,1,1\\right\\} & 1 & \\text{11} & 0.\\times 10^{-69} & \\left\\{\\text{CG = 0},-0.0000181409\\right\\} & \\left\\{\\text{CG = 0},-1.81469\\times 10^{-6}\\right\\}\\\\\\hline\\left\\{4,1,1\\right\\} & 1 & \\text{21} & 0.\\times 10^{-65} & 1.385714257 & 1.385714285\\\\\\hline\\left\\{4,1,1\\right\\} & 1 & \\text{C} & 0.\\times 10^{-60} & 0.9998572356 & 0.9999857236\\\\\\hline\\left\\{3,3,0\\right\\} & 1 & \\text{11} & 0.\\times 10^{-68} & 1.385714266 & 1.385714286\\\\\\hline\\left\\{3,3,0\\right\\} & 1 & \\text{21} & 0.\\times 10^{-64} & 1.385714266 & 1.385714286\\\\\\hline\\left\\{3,3,0\\right\\} & 1 & \\text{C} & 0.\\times 10^{-59} & \\left\\{\\text{CG = 0},0.\\times 10^{-66}\\right\\} & \\left\\{\\text{CG = 0},0.\\times 10^{-63}\\right\\}\\\\\\h… [latex truncated: 2286 chars total]",
