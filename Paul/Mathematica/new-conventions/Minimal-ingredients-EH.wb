      {
       "data": "Out[96]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{directions} & \\varepsilon  & \\text{K\\_b/S} & \\text{K\\_c/S} & \\text{$\\beta$ = -K\\_c/K\\_b}\\\\\\hline\\text{$\\varphi$, $\\omega$} & \\frac{1}{10000} & -0.51429338 & 0.18099673 & 0.35193283\\\\\\hline\\text{$\\varphi$, $\\omega$} & \\frac{1}{100000} & -0.51428648 & 0.18095682 & 0.35185995\\\\\\hline\\text{$\\varphi$' = (-2/5, 3/8, 7/11), $\\omega$} & \\frac{1}{10000} & -0.51430554 & 0.18100825 & 0.35194693\\\\\\hline\\text{$\\varphi$' = (-2/5, 3/8, 7/11), $\\omega$} & \\frac{1}{100000} & -0.51428770 & 0.18095797 & 0.35186136\\\\\\hline\\text{$\\varphi$, $\\omega$' = (1/9, 5/4, -3/7)} & \\frac{1}{10000} & -0.51421881 & 0.18082549 & 0.35165087\\\\\\hline\\text{$\\varphi$, $\\omega$' = (1/9, 5/4, -3/7)} & \\frac{1}{100000} & -0.51427902 & 0.18093969 & 0.35183176\\\\\\hline\\text{candidate closed form} &  & -0.51428571 & 0.18095238 & 0.35185185\\\\\\hline\\text{time (s)} & 1.21408 &  &  & \\\\\\hline\\end{array}",
