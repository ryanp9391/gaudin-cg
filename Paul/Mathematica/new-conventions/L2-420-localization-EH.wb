      {
       "data": "Out[453]= \\begin{array}{|c|c|c|c|}\\hline\\text{(a) $\\mu$} & \\text{dim null space} & \\text{overlap sv of HW\\_$\\mu$ with null space} & \\\\\\hline\\left\\{5,4,3\\right\\} & 4 & \\left\\{1.\\,,1.000\\right\\} & \\\\\\hline\\left\\{4,4,4\\right\\} & 11 & \\left\\{1.\\,\\right\\} & \\\\\\hline\\text{(b) $\\mu$} & \\text{dim} & \\text{rank: localized + $\\Omega$} & \\text{rank: + generic t rows}\\\\\\hline\\left\\{4,4,4\\right\\} & 45 & 34 & 45\\\\\\hline\\left\\{5,4,3\\right\\} & 36 & 32 & 36\\\\\\hline\\left\\{5,5,2\\right\\} & 24 & 24 & 24\\\\\\hline\\left\\{6,3,3\\right\\} & 24 & 24 & 24\\\\\\hline\\text{reconstruction with + generic rows} & \\text{\\# states} & 19 & \\text{4.29}\\times 10^{\\text{-37}}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "ccee3b24-d624-4f22-8821-ab5e24feb06d"
