       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"758597\" data-output-id=\"319\" data-out-n=\"334\" data-sub-idx=\"25\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"1\" data-sub-start=\"30\" data-sub-end=\"30\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[334]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.9072em;vertical-align:-2.1836em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.7236em;\"><span style=\"top:-4.6836em;\"><span class=\"pstrut\" style=\"height:4.6836em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:4.8672em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.1836em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.6836em;\"><span style=\"top:-4.8436em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">dim [4,2,0]</span></span></span></span><span style=\"top:-3.5764em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">R = sqrt(M) for [4,2,0]</span></span></span></span><span style=\"top:-2.3764em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">EH</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist