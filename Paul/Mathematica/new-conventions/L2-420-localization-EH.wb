       "data": "Out[438]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{max locality residual, $\\varepsilon$ = 1/3, 20 w} & \\text{0} &  &  &  &  &  & \\\\\\hline\\mu  & \\text{dim} & \\text{site1} & \\text{site1+$\\Omega$} & \\text{site2} & \\text{site2+$\\Omega$} & \\text{site1+site2} & \\text{site1+site2+$\\Omega$}\\\\\\hline\\left\\{4,4,4\\right\\} & 45 & 21 & 25 & 16 & 20 & 30 & 34\\\\\\hline\\left\\{5,4,3\\right\\} & 36 & 17 & 20 & 13 & 16 & 29 & 32\\\\\\hline\\left\\{5,5,2\\right\\} & 24 & 13 & 15 & 10 & 12 & 22 & 24\\\\\\hline\\left\\{6,3,3\\right\\} & 24 & 13 & 15 & 10 & 12 & 22 & 24\\\\\\hline\\left\\{6,4,2\\right\\} & 20 & 13 & 15 & 10 & 12 & 20 & 20\\\\\\hline\\left\\{6,5,1\\right\\} & 10 & 7 & 8 & 6 & 6 & 10 & 10\\\\\\hline\\left\\{6,6,0\\right\\} & 3 & 3 & 3 & 2 & 2 & 3 & 3\\\\\\hline\\left\\{7,3,2\\right\\} & 10 & 8 & 8 & 7 & 8 & 10 & 10\\\\\\hline\\left\\{7,4,1\\right\\} & 6 & 6 & 6 & 6 & 6 & 6 & 6\\\\\\hline\\left\\{7,5,0\\right\\} & 2 & 2 & 2 & 2 & 2 & 2 & 2\\\\\\hline\\left\\{8,2,2\\right\\} & 3 & 3 & 3 & 3 & 3 & 3 & 3\\\\\\hline\\left\\{8,3,1\\right\\} & 2 & 2 & 2 & 2 & 2 & 2 & 2\\\\\\hline\\left\\{8,4,0\\right\\} & 1 & 1 & 1 & 1 & 1 & 1 & 1\\\\\\hline\\text{time (s)} & 12.121597 &  &  &  &  &  & \\\\\\hline\\end{array}",
