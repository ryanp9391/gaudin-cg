em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-48.289em;\"><span class=\"pstrut\" style=\"height:26.3471em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-49.4941em;\"><span class=\"pstrut\" style=\"height:26.3471em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-50.6941em;\"><span class=\"pstrut\" style=\"height:26.3471em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:23.8471em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[443]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\varepsilon  & \\text{data} & \\mu  & \\text{dim} & \\text{rank (+x0)} & \\text{rel. error $\\Psi$} & \\text{rel. error HW part}\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{4,4,4\\right\\} & 45 & 30 & 1.\\, & 1.\\,\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{5,4,3\\right\\} & 36 & 29 & 1.000 & 1.000\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{5,4,3\\right\\} & 36 & 29 & 1.000 & 1.000\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{5,5,2\\right\\} & 24 & 22 & 0.688 & 0.474\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{6,3,3\\right\\} & 24 & 22 & 0.417 & 0.174\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{6,4,2\\right\\} & 20 & 20 & 6.03\\times 10^{-122} & 6.03\\times 10^{-122}\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{6,4,2\\right\\} & 20 & 20 & 4.55\\times 10^{-121} & 4.55\\times 10^{-121}\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{6,4,2\\right\\} & 20 & 20 & 2.30\\times 10^{-121} & 2.30\\times 10^{-121}\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{6,5,1\\right\\} & 10 & 10 & 1.5\\times 10^{-141} & 1.43\\times 10^{-141}\\\\\\hline\\frac{1}{1000000} & \\text{site1+site2} & \\left\\{6,5,1\\right\\} &… [latex truncated: 4385 chars total]",
       "mime": "text/plain"
      }
