      {
       "data": "Out[334]= \\begin{array}{|c|c|}\\hline\\text{dim [4,2,0]} & 27\\\\\\hline\\text{R = sqrt(M) for [4,2,0]} & \\left\\{1,\\sqrt{2},2,\\sqrt{2},\\sqrt{6},4,\\sqrt{30},4\\,\\sqrt{5},10\\,\\sqrt{2},2,2\\,\\sqrt{6},4\\,\\sqrt{6},\\sqrt{30},4\\,\\sqrt{10},10\\,\\sqrt{6},4\\,\\sqrt{30},8\\,\\sqrt{30},80,6\\,\\sqrt{2},24,8\\,\\sqrt{5},20\\,\\sqrt{6},8\\,\\sqrt{30},80\\,\\sqrt{2},48,60\\,\\sqrt{2},160\\right\\}\\\\\\hline\\text{EH\\^{}T = EH\\_ji} & \\mathrm{True}\\\\\\hline\\text{gl(3) relations} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
