       "data": "Out[455]= \\begin{array}{|c|c|c|}\\hline\\text{check} & \\text{value} & \\\\\\hline\\text{EH\\^{}T = EH\\_ji for [2,1,0] and [4,2,0]} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{gl(3) relations [E\\_ij,E\\_kl] = $\\delta$\\_jk E\\_il - $\\delta$\\_li E\\_kj for [4,2,0]} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{qdet: t3 = $\\chi$3 $\\nu$1(v)$\\nu$2(v-h)$\\nu$3(v-2h) (max rel. err, machine)} & \\text{9.1}\\times 10^{\\text{-15}} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{[t1, t2] = 0 (max rel. err, machine)} & \\text{1.86}\\times 10^{\\text{-16}} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{$\\Omega$zw$\\otimes$$\\Omega$zw left eigenvector of t\\_a(G') (max rel. resid, machine)} & \\text{7.53}\\times 10^{\\text{-14}} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{control [2,1,0]: CBR site-1 hits = T11, T21 at $\\theta$1-2h} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{control [2,1,0]: CBR site-2 hits = T11 at $\\theta$2+h} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{[4,2,0]: CBR site-1 hits = T11, T22, T32, T42 at $\\theta$1-4h; site-2 = T11($\\theta$2+h), T22($\\theta$2)} & \\mathrm{True} & \\textcolor{#00ff00}{\\text{PASS}}\\\\\\hline\\text{control… [latex truncated: 2970 chars total]",
