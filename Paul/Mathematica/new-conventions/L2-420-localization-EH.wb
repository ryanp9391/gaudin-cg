       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"758597\" data-output-id=\"323\" data-out-n=\"403\" data-sub-idx=\"27\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"9\" data-sub-start=\"35\" data-sub-end=\"35\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[403]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:17.5241em;vertical-align:-8.4921em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.0321em;\"><span style=\"top:-10.9921em;\"><span class=\"pstrut\" style=\"height:10.9921em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:17.4841em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-8.4921em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.9921em;\"><span style=\"top:-11.6021em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">site</span></span></span></span><span style=\"top:-10.2881em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:-8.9741em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:-7.66em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">1</sp