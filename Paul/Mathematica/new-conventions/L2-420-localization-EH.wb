      {
       "data": "Out[381]= \\begin{array}{|c|c|c|c|c|}\\hline\\Lambda  & \\text{site} & \\text{\\# local covectors at depth 0,1,2} & \\text{span rank \\{$\\Omega$, v\\} (cumulative)} & \\text{depth-1 products \\{\\{t, a, c\\}, \\{T, $\\lambda$, c\\}\\}}\\\\\\hline\\left\\{2,1,0\\right\\} & 1 & \\left\\{2,2,1\\right\\} & \\left\\{3,3,3\\right\\} & \\begin{pmatrix}\\left\\{\\text{t},1,-1\\right\\} & \\left\\{\\text{T},\\left\\{1,1\\right\\},-2\\right\\}\\\\\\left\\{\\text{t},2,1\\right\\} & \\left\\{\\text{T},\\left\\{2,1\\right\\},-2\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{2,1,0\\right\\} & 2 & \\left\\{1,1,0\\right\\} & \\left\\{2,3,3\\right\\} & \\begin{pmatrix}\\left\\{\\text{t},1,-1\\right\\} & \\left\\{\\text{T},\\left\\{1,1\\right\\},1\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & \\left\\{4,2,0\\right\\} & \\left\\{5,5,5\\right\\} & \\begin{pmatrix}\\left\\{\\text{t},1,-2\\right\\} & \\left\\{\\text{T},\\left\\{2,2\\right\\},-4\\right\\}\\\\\\left\\{\\text{t},2,1\\right\\} & \\left\\{\\text{T},\\left\\{4,2\\right\\},-4\\right\\}\\end{pmatrix}\\\\\\hline\\left\\{4,2,0\\right\\} & 2 & \\left\\{2,1,0\\right\\} & \\left\\{3,4,4\\right\\} & \\begin{pmatrix}\\left\\{\\text{t},1,-2\\right\\} & \\left\\{\\text{T},\\left\\{2,2\\right\\},0\\right\\}\\end{pmatrix}\\\\\\hline\\text{time (s)} & 0.339312 &  &  & \\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "5302d9fe-f3f2-4b7b-a993-3386af22a4c4"
