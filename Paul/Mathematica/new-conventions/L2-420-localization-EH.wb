  {
   "kind": 1,
   "value": "## 1. Transfer matrices at sample points (machine precision) and the vacuum check",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* auxiliary-space Gauss factors and G' = Paux G(w) Paux^-1, verbatim from the adjoint notebook (Section 4) *)\nee[i_, j_] := Table[KroneckerDelta[i, ii] KroneckerDelta[j, jj], {ii, 3}, {jj, 3}];\nzs = {z[1], z[2], z[3]}; ws = {w[1], w[2], w[3]};\nχ[tw_] := {tw[[1]] + tw[[2]] + tw[[3]], tw[[1]] tw[[2]] + tw[[1]] tw[[3]] + tw[[2]] tw[[3]], tw[[1]] tw[[2]] tw[[3]]};\nGc[tw_] := With[{c = χ[tw]}, {{c[[1]], -c[[2]], c[[3]]}, {1, 0, 0}, {0, 1, 0}}];\nPpa = MatrixExp[-(1/z[1]) ee[2, 1]] . MatrixExp[(1/(z[1] z[2])) ee[3, 1]] . MatrixExp[-((z[1] + z[2])/(z[1] z[2])) ee[3, 2]];\nPma = MatrixExp[-r[1] ee[2, 3]] . MatrixExp[-r[2] ee[1, 3]] . MatrixExp[-r[3] ee[1, 2]];\nPda = MatrixExp[-Log[s[1]] ee[1, 1]] . MatrixExp[-Log[s[2]] ee[2, 2]] . MatrixExp[-Log[s[3]] ee[3, 3]];\nrsSol = {s[1] -> z[1]^2/((z[1] - z[2]) (z[1] - z[3])), s[2] -> -(z[2]/(z[1] (z[2] - z[3]))), s[3] -> 1/(z[1] z[2]), r[1] -> -(z[3]/z[2]), r[2] -> -(z[3]/z[1]), r[3] -> (z[2]^2 (-z[1] + z[3]))/(z[1]^2 (z[2] - z[3]))};\nPaux = Simplify[Pma . Pda . Ppa /. rsSol];\nnumZW = Join[Thread[zs -> zN], Thread[ws -> wN]];\nGPzw = Simplify[Paux . Gc[ws] . Inverse[Paux]] /. numZW;\n(* machine-precision two-site objects; d^2 x d^2 dense *)\nLaxN[Λ_, s_, v_] := LaxN[Λ, s, v] = Table[KroneckerDelta[a, b] (v - thN[[s]]) IdentityMatrix[dim[Λ]] + hN N[EH[Λ][a, b]], {a, 3}, {b, 3}];\nTmN[Λ_, v_] := TmN[Λ, v] = Table[Sum[KroneckerProduct[LaxN[Λ, 1, v][[i, k]], LaxN[Λ, 2, v][[k, j]]], {k, 3}], {i, 3}, {j, 3}];\nTMN[Λ_, M_, v_] := TMN[Λ, M, v] = Table[Sum[TmN[Λ, v][[i, l]] M[[l, j]], {l, 3}], {i, 3}, {j, 3}];\ntMN[Λ_, M_, a_, v_] := tMN[Λ, M, a, v] = Sum[Sum[Signature[σ] Dot @@ Table[TMN[Λ, M, v - (k - 1) hN][[σ[[k]], I[[k]]]], {k, a}], {σ, Permutations[I]}], {I, Subsets[Range[3], {a}]}];\nZn = N[DiagonalMatrix[zN]]; Gpn = N[GPzw];\nrelErr[a_, b_] := Norm[Flatten[a - b]]/Max[Norm[Flatten[b]], 10^-300];\nΩ2N[Λ_] := Ω2N[Λ] = N[Flatten[KroneckerProduct[Ω1[Λ], Ω1[Λ]]]];\neigRes[c_, Ω_] := Norm[c - (c . Ω/(Ω . Ω)) Ω]/Norm[c];\nchk1 = Table[With[{d2 = dim[Λ]^2, v1 = 1/3, v2 = -2/5},\n    {Λ, relErr[tMN[Λ, Zn, 3, v1], qdet[Λ][v1] IdentityMatrix[d2]], relErr[tMN[Λ, Zn, 1, v1] . tMN[Λ, Zn, 2, v2], tMN[Λ, Zn, 2, v2] . tMN[Λ, Zn, 1, v1]],\n     Max[Table[eigRes[Ω2N[Λ] . tMN[Λ, Gpn, a, v1], Ω2N[Λ]], {a, 3}]]}], {Λ, {{2, 1, 0}, {4, 2, 0}}}];\nchecks[\"qdet: t3 = χ3 ν1(v)ν2(v-h)ν3(v-2h) (max rel. err, machine)\"] = Max[chk1[[All, 2]]];\nchecks[\"[t1, t2] = 0 (max rel. err, machine)\"] = Max[chk1[[All, 3]]];\nchecks[\"Ωzw⊗Ωzw left eigenvector of t_a(G') (max rel. resid, machine)\"] = Max[chk1[[All, 4]]];\nGrid[Prepend[chk1, {\"Λ\", \"qdet rel. err\", \"[t1,t2] rel. err\", \"Ω eigencovector of t_a(G') resid\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
