      {
       "data": "Out[358]= \\begin{array}{|c|c|c|c|}\\hline\\Lambda  & \\text{qdet rel. err} & \\text{[t1,t2] rel. err} & \\text{$\\Omega$ eigencovector of t\\_a(G') resid}\\\\\\hline\\left\\{2,1,0\\right\\} & 9.098695122460241\\times 10^{-15} & 1.8581303921426077\\times 10^{-16} & 7.529876283061674\\times 10^{-14}\\\\\\hline\\left\\{4,2,0\\right\\} & 2.5501557242786257\\times 10^{-15} & 1.468478436563959\\times 10^{-16} & 3.8347149305497055\\times 10^{-14}\\\\\\hline\\end{array}",
