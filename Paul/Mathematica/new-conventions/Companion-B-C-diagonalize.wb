   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* matching auxiliary-space factors *)\nPpa = MatrixExp[(-(1/z[1]))*ee[2, 1]] . MatrixExp[(1/(z[1]*z[2]))*ee[3, 1]] . MatrixExp[(-((z[1] + z[2])/(z[1]*z[2])))*ee[3, 2]];\nPma = MatrixExp[(-r[1])*ee[2, 3]] . MatrixExp[(-r[2])*ee[1, 3]] . MatrixExp[(-r[3])*ee[1, 2]];\nPda = MatrixExp[(-Log[s[1]])*ee[1, 1]] . MatrixExp[(-Log[s[2]])*ee[2, 2]] . MatrixExp[(-Log[s[3]])*ee[3, 3]];\nrsSol = {s[1] -> z[1]^2/((z[1] - z[2])*(z[1] - z[3])), s[2] -> -(z[2]/(z[1]*(z[2] - z[3]))), s[3] -> 1/(z[1]*z[2]), r[1] -> -(z[3]/z[2]), r[2] -> -(z[3]/z[1]), r[3] -> (z[2]^2*(-z[1] + z[3]))/(z[1]^2*(z[2] - z[3]))};\nPaux = Simplify[Pma . Pda . Ppa /. rsSol];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Paux diagonalizes the companion twist; expect {0} *)\nUnion[Flatten[Simplify[Simplify[Paux . G . Inverse[Paux]] - DiagonalMatrix[{z[1], z[2], z[3]}]]]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"758596\" data-output-id=\"4\" data-out-n=\"74\" data-sub-idx=\"1\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"24\" data-sub-start=\"1\" data-sub-end=\"1\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[74]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"XGxlZnRcezBccmlnaHRcfQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[74]= \\left\\{0\\right\\}",
       "mime": "text/plain"
      }
     ],
     "id": "9fb37584-13e9-4522-9e86-897be7219992"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Pphys = Simplify[Pmp . Pdp . Ppp /. rsSol];\nPphysInv = Simplify[Inverse[Ppp] . Inverse[Pdp] . Inverse[Pmp] /. rsSol];\n(* the physical rotation maps t_{1,0} to the diagonal-twist transfer matrix; expect {0} *)\nUnion[Flatten[Simplify[Pphys . t[{1, 0}][u] . PphysInv - Sum[ℒ[1][i, i][u - θ[1]]*z[i], {i, 3}]]]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"758596\" data-output-id=\"5\" data-out-n=\"77\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"25\" data-sub-start=\"3\" data-sub-end=\"3\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[77]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"XGxlZnRcezBccmlnaHRcfQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
