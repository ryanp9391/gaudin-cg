      {
       "data": "Out[763]= \\begin{array}{|c|c|c|c|}\\hline\\text{weight $\\mu$} & \\text{(1,2;3) resid | C | C/(1/z2-1/z1)} & \\text{(2,3;1)} & \\text{(3,1;2)}\\\\\\hline0,2,1 & 0\\text{ | }0.0285714\\text{ | }1.\\, & 0\\text{ | }1.23810\\text{ | }1.\\, & 0\\text{ | }-1.26667\\text{ | }1.\\,\\\\\\hline1,1,1 & 0\\text{ | }0.0285714\\text{ | }1.\\, & 0\\text{ | }1.23810\\text{ | }1.\\, & 0\\text{ | }-1.26667\\text{ | }1.\\,\\\\\\hline2,0,1 & 0\\text{ | }0.0285714\\text{ | }1.\\, & 0\\text{ | }1.23810\\text{ | }1.\\, & 0\\text{ | }-1.26667\\text{ | }1.\\,\\\\\\hline0,1,2 & 0\\text{ | }0.0285714\\text{ | }1.\\, & 0\\text{ | }1.23810\\text{ | }1.\\, & 0\\text{ | }-1.26667\\text{ | }1.\\,\\\\\\hline1,0,2 & 0\\text{ | }0.0285714\\text{ | }1.\\, & 0\\text{ | }1.23810\\text{ | }1.\\, & 0\\text{ | }-1.26667\\text{ | }1.\\,\\\\\\hline1,1,1 & 0\\text{ | }0.0285714\\text{ | }1.\\, & 0\\text{ | }1.23810\\text{ | }1.\\, & 0\\text{ | }-1.26667\\text{ | }1.\\,\\\\\\hline2,1,0 & 0\\text{ | }0.0285714\\text{ | }1.\\, & 0\\text{ | }1.23810\\text{ | }1.\\, & 0\\text{ | }-1.26667\\text{ | }1.\\,\\\\\\hline1,2,0 & 0\\text{ | }0.0285714\\text{ | }1.\\, & 0\\text{ | }1.23810\\text{ | }1.\\, & 0\\text{ | }-1.26667\\text{ | }1.\\,\\\\\\hline\\end{array}",
       "mime": "text/plain"
