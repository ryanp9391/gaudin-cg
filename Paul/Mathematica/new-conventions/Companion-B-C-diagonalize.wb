       "data": "Out[754]= \\text{\"{{{0, 2, 1}, {{1.$\\grave{ }$8., {-15.6578947368421052632$\\grave{ }$8.016217551821327 - 14.4873380573837534645$\\grave{ }$7.982472777070183*I, -15.6578947368421052632$\\grave{ }$8.016217551821327 + 14.4873380573837534645$\\grave{ }$7.982472777070183*I}}, {0, {}}, {1.$\\grave{ }$8., {-0.6538461538461538461$\\grave{ }$8.}}}}, {{1, 1, 1}, {{1.$\\grave{ }$8., {-30.1605960942228593978$\\grave{ }$8.}}, {1.$\\grave{ }$8., {27.8298841802058266476$\\grave{ }$8.}}, {1.$\\grave{ }$8., {-0.6692880859829672498$\\grave{ }$8.}}}}, {{2, 0, 1}, {{0, {}}, {1.$\\grave{ }$8., {13.3269230769230769231$\\grave{ }$7.981109035387833 - 14.4876886114305738114$\\grave{ }$8.017378247385606*I, 13.3269230769230769231$\\grave{ }$7.981109035387833 + 14.4876886114305738114$\\grave{ }$8.017378247385606*I}}, {1.$\\grave{ }$8., {-0.6842105263157894737$\\grave{ }$8.}}}}, {{0, 1, 2}, {{1.$\\grave{ }$8., {-15.2837480028204354984$\\grave{ }$8., -2.3478309445479855542$\\grave{ }$8.}}, {1.$\\grave{ }$8., {-2.3461538461538461539$\\grave{ }$8.}}, {0, {}}}}, {{1, 0, 2}, {{1.$\\grave{ }$8., {-2.3157894736842105263$\\grave{ }$8.}}, {1.$\\grave{ }$8., {-2.3169771203607867712$\\grave{ }$8., 13.6246694280530944635$\\grave{ }$8.}}, {0, {}}}}, {{1, 1, 1},… [latex truncated: 1693 chars total]",
