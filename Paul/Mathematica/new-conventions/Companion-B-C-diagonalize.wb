     ],
     "id": "7f955187-3d20-414c-8429-7b0bce73c029"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* twist G(w) written in the frame where G(z) is diagonal *)\nGPzw = Simplify[Paux . (G /. z -> w) . Inverse[Paux]];\nClearAll[tGPzw];\ntGPzw[u_] = Sum[ℒ[1][i, k][u - θ[1]]*GPzw[[k, i]], {i, 3}, {k, 3}];\nΩzw = {{1, 0, 0, 0, 0, 0, 0, 0}} . MatrixExp[r1*Ee[1][1, 2]] . MatrixExp[r2*Ee[1][1, 3]] . MatrixExp[r3*Ee[1][2, 3]] /. {r1 -> (w[1] - z[1])/(w[1] - z[2]), r2 -> ((w[1] - z[1])*(-w[2] + z[1])*(z[2] - z[3]))/((z[1] - z[2])*(w[1] - z[3])*(w[2] - z[3])), r3 -> ((w[1] - z[2])*(-w[2] + z[2])*(z[1] - z[3]))/((z[1] - z[2])*(w[1] - z[3])*(-w[2] + z[3]))};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Ωzw is the twist-w vacuum in the z-diagonal frame, eigenvalue τvac(w); expect {0} *)\nUnion[Flatten[Simplify[Ωzw . tGPzw[u] - Ωzw*(τvac[u] /. z -> w)]]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"758596\" data-output-id=\"7\" data-out-n=\"83\" data-sub-idx=\"1\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"28\" data-sub-start=\"1\" data-sub-end=\"1\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[83]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"XGxlZnRcezBccmlnaHRcfQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
