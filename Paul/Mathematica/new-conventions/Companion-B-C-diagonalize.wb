"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-13.3em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-14.5em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-15.7em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-16.9em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-18.1em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-19.3em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-20.5em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-21.7em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-22.9em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-24.1em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-25.3em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-26.5em;\"><span class=\"pstrut\" style=\"height:14.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:11.75em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[773]= \\begin{array}{|c|c|c|c|c|}\\hline\\lambda  & \\text{max remainder} & \\text{state spread of P} & \\text{roots of P in x-$\\theta$} & \\text{P - content product}\\\\\\hline\\left\\{1,0,0\\right\\} & 0 & 0 & \\left\\{0\\right\\} & 0\\\\\\hline\\left\\{1,1,0\\right\\} & 0 & 0 & \\left\\{0,1.\\,\\right\\} & 0\\\\\\hline\\left\\{1,1,1\\right\\} & 0 & 0 & \\left\\{0,1.\\,,2.\\,\\right\\} & 0\\\\\\hline\\left\\{2,0,0\\right\\} & 0 & 0 & \\left\\{-1.\\,,0\\right\\} & 0\\\\\\hline\\left\\{2,1,0\\right\\} & 0 & 0 & \\left\\{-1.\\,,0,1.\\,\\right\\} & 0\\\\\\hline\\left\\{2,1,1\\right\\} & 0 & 0 & \\left\\{-1.\\,,0,1.\\,,2.\\,\\right\\} & 0\\\\\\hline\\left\\{2,2,0\\right\\} & 0 & 0 & \\left\\{-1.\\,,0,0,1.\\,\\right\\} & 0\\\\\\hline\\left\\{2,2,1\\right\\} & 0 & 0 & \\left\\{-1.\\,,0,0,1.\\,,2.\\,\\right\\} & 0\\\\\\hline\\left\\{2,2,2\\right\\} & 0 & 0 & \\left\\{-1.\\,,0,0,1.\\,,1.\\,,2.\\,\\right\\} & 0\\\\\\hline\\left\\{3,0,0\\right\\} & 0 & 0 & \\left\\{-2.\\,,-1.\\,,0\\right\\} & 0\\\\\\hline\\left\\{3,1,0\\right\\} & 0 & 0 & \\left\\{-2.\\,,-1.\\,,0,1.\\,\\right\\} & 0\\\\\\hline\\left\\{3,1,1\\right\\} & 0 & 0 & \\left\\{-2.\\,,-1.\\,,0,1.\\,,2.\\,\\right\\} & 0\\\\\\hline\\left\\{3,2,0\\right\\} & 0 & 0 & \\left\\{-2.\\,,-1.\\,,0,0,1.\\,\\right\\} & 0\\\\\\hline\\left\\{3,2,1\\right\\} & 0 & 0 & \\left\\{-2.\\,,-1.\\,,0,0,1.\\,,2.\\,\\right\\} & 0\\\\\\hline\\left\\{3,2,2\\righ… [latex truncated: 1645 chars total]",
