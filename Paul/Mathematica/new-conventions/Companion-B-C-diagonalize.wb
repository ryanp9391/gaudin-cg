      {
       "data": "Out[825]= \\text{\"{\\\"direct parallel pairs:\\\", {{-2, -1}}, \\\"direct dependent triples:\\\", {{-6, -2, -1}, {-5, -2, -1}, {-4, -2, -1}, {-3, -2, -1}, {-2, -1, 0}, {-2, -1, 1}, {-2, -1, 2}, {-2, -1, 3}, {-2, -1, 4}, {-2, 0, 1}, {-1, 0, 1}}, \\\"N'_mu spreads (perm -> rows x k):\\\", {{{1, 2, 3}, {{\\\"singular\\\", \\\"singular\\\", \\\"singular\\\"}, {\\\"singular\\\", \\\"singular\\\", \\\"singular\\\"}, {\\\"singular\\\", \\\"singular\\\", \\\"singular\\\"}}}, {{2, 3, 1}, {{0$\\grave{ }$$\\grave{ }$51.129303095260376, 0$\\grave{ }$$\\grave{ }$51.129307924829554, 0$\\grave{ }$$\\grave{ }$51.12929938179346}, {0$\\grave{ }$$\\grave{ }$54.708610183667346, 0$\\grave{ }$$\\grave{ }$54.730135591773454, 0$\\grave{ }$$\\grave{ }$54.811598277254255}, {0$\\grave{ }$$\\grave{ }$54.69977253285597, 0$\\grave{ }$$\\grave{ }$54.7208536396703, 0$\\grave{ }$$\\grave{ }$54.800425709665625}}}, {{1, 3, 2}, {{0.6175247790193740035$\\grave{ }$3., 0.7093824490825962865$\\grave{ }$3., 1.371928518242740134$\\grave{ }$3.}, {0.6175247790193740035$\\grave{ }$3., 0.7093824490825962865$\\grave{ }$3., 1.371928518242740134$\\grave{ }$3.}, {0.6175247790193740035$\\grave{ }$3., 0.7093824490825962865$\\grave{ }$3., 1.371928518242740134$\\grave{ }$3.}}}}}\"}",
       "mime": "text/plain"
