      {
       "data": "Out[1061]= \\begin{array}{|c|c|}\\hline\\text{states} & 64\\\\\\hline\\text{sector sizes} & \\begin{pmatrix}1 & 6\\\\2 & 6\\\\6 & 6\\\\10 & 1\\end{pmatrix}\\\\\\hline\\text{max residual} & 0\\\\\\hline\\text{min gap} & 0.0032182\\\\\\hline\\end{array}",
