      {
       "data": "Out[1137]= \\begin{array}{|c|c|}\\hline\\text{diagnostic} & \\text{max |ratio/ratio\\_1 - 1|}\\\\\\hline\\text{row choice \\{13,12,23,21,31,11\\} vs off-diagonal rows, mixed twist} & \\text{1.08}\\times 10^{\\text{5}}\\\\\\hline\\text{same, same twist A=B} & \\text{8.29}\\times 10^{\\text{2}}\\\\\\hline\\text{R\\_B spread in sector }\\left\\{4,1,1\\right\\}\\text{ (}2\\text{ states)} & \\text{8.67}\\times 10^{\\text{-1}}\\\\\\hline\\text{R\\_B spread in sector }\\left\\{3,3,0\\right\\}\\text{ (}2\\text{ states)} & \\text{9.83}\\times 10^{\\text{-1}}\\\\\\hline\\text{R\\_B spread in sector }\\left\\{3,2,1\\right\\}\\text{ (}6\\text{ states)} & \\text{2.52}\\times 10^{\\text{1}}\\\\\\hline\\text{R\\_B spread in sector }\\left\\{3,1,2\\right\\}\\text{ (}6\\text{ states)} & \\text{5.82}\\\\\\hline\\text{R\\_B spread in sector }\\left\\{2,3,1\\right\\}\\text{ (}6\\text{ states)} & \\text{2.14}\\times 10^{\\text{2}}\\\\\\hline\\text{R\\_B spread in sector }\\left\\{2,2,2\\right\\}\\text{ (}10\\text{ states)} & \\text{1.35}\\times 10^{\\text{2}}\\\\\\hline\\text{R\\_B spread in sector }\\left\\{3,0,3\\right\\}\\text{ (}2\\text{ states)} & \\text{6.56}\\times 10^{\\text{-1}}\\\\\\hline\\text{R\\_B spread in sector }\\left\\{2,1,3\\right\\}\\text{ (}6\\text{ states)} & \\text{3.67}\\times 10^{\\text{1}}\\\\\\hline\\text{R\\_B spread i… [latex truncated: 1753 chars total]",
