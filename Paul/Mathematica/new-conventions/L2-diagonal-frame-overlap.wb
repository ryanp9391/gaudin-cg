       "data": "Out[1112]= \\begin{array}{|c|c|}\\hline\\text{check} & \\text{value}\\\\\\hline\\text{orthogonality: max $\\sigma$min/$\\sigma$max over A$\\not=$B} & \\text{3.45}\\times 10^{\\text{-65}}\\\\\\hline\\text{orthogonality: min $\\sigma$min/$\\sigma$max over A=B (not a zero test)} & \\text{1.63}\\times 10^{\\text{-10}}\\\\\\hline\\text{det N off-diagonal/diagonal (same twist)} & \\text{7.39}\\times 10^{\\text{-51}}\\\\\\hline\\text{time (s)} & 3.203999\\\\\\hline\\end{array}",
