      {
       "data": "Out[1173]= \\begin{array}{|c|c|}\\hline\\text{<x0|y0> per site} & \\left\\{\\frac{9}{16},\\frac{9}{16}\\right\\}\\\\\\hline\\text{\\# monomials, all same coefficient} & \\left\\{16,\\mathrm{True}\\right\\}\\\\\\hline\\text{c0 (L=2)} & -\\frac{148361297185718750000000000}{1526352895767005026479}\\\\\\hline\\text{c0 $\\times$ h\\^{}12} & -\\frac{144884079282928466796875}{6105411583068020105916}\\\\\\hline\\text{$\\Omega$$\\cdot$y0} & 137.2383205\\\\\\hline\\text{R (fitted)} & 0.000913651481083\\\\\\hline\\text{R / Rpred} & 1.\\,\\\\\\hline\\end{array}",
