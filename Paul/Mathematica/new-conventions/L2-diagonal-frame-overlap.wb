  {
   "kind": 2,
   "value": "(* c0 symbolically in h, θ1, θ2: same per-ladder det, residue weights of ρ with symbolic poles *)\nthS = {ϑ1, ϑ2};\nxPs[{s_, n_}] := thS[[s]] - n ħ;\nwgtS[p_] := 1/Product[xPs[p] - xPs[q], {q, DeleteCases[poles, p]}];\nrowSs[{i_, j_}, α_] := Sum[wgtS[p] With[{x = xPs[p], n = p[[2]]}, {-Us[j, α, -n] Ds[i, α, -n], -x Us[j, α, -n] Ds[i, α, -n], Us[j, α, -n] Ds[i, α, -n + 1], x Us[j, α, -n] Ds[i, α, -n + 1], Us[j, α, -n - 1] Ds[i, α, -n], x Us[j, α, -n - 1] Ds[i, α, -n]}], {p, Select[poles, #[[1]] == α &]}];\ndetSymS = Expand[Det[Flatten[Table[rowSs[ij, α], {α, nL}, {ij, prsL1}], 1]] /. (v : (Us | Ds)[__] /; ! MemberQ[keepVars, v]) -> 0];\nc0S = Factor[Together[Coefficient[detSymS, monos[[1]]/(monos[[1]] /. (Us | Ds)[__] -> 1)]/(monos[[1]] /. (Us | Ds)[__] -> 1)]];\nchecks[\"c0 symbolic reproduces numeric c0\"] = (c0S /. {ϑ1 -> thN[[1]], ϑ2 -> thN[[2]], ħ -> hN}) === c02;\n(* closed form: (L=1 c0)^2 times the cross-site factors of the residue weights *)\nc0closed = -(1/(4 ħ^6))^2/((ϑ1 - ϑ2)^3 Product[((ϑ1 - ϑ2)^2 - k^2 ħ^2)^(6 - 2 k), {k, 1, 2}]);\nchecks[\"c0 = -(1/4h^6)^2 / [θ12^3 (θ12^2-h^2)^4 (θ12^2-4h^2)^2]\"] = Simplify[c0S - c0closed] === 0;\nchecks[\"R = Ω·y0/(c0 <x0|y0>^2 Φ_Q(y0)): max |R_B/Rpred - 1|\"] = Max[Abs[RBa/Rpred - 1]];\nGrid[{{\"c0(h, θ1, θ2)\", c0S}, {\"matches numeric\", checks[\"c0 symbolic reproduces numeric c0\"]}, {\"closed form\", checks[\"c0 = -(1/4h^6)^2 / [θ12^3 (θ12^2-h^2)^4 (θ12^2-4h^2)^2]\"]}, {\"max |R_B/Rpred - 1| (all 64)\", ScientificForm[N[Max[Abs[RBa/Rpred - 1]], 3], 3]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
