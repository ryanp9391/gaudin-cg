       "data": "Out[1251]= \\begin{array}{|c|c|}\\hline\\text{orthogonality A$\\not=$B} & \\text{9.50}\\times 10^{\\text{-74}}\\\\\\hline\\text{A=B (not zero)} & \\text{3.54}\\times 10^{\\text{-7}}\\\\\\hline\\text{c0} & \\frac{\\left(\\varepsilon \\left(1\\right)-\\varepsilon \\left(2\\right)\\right)^3}{16\\,ħ^{12}\\,\\left(\\vartheta1-\\vartheta2\\right)^3\\,\\left(ħ+\\vartheta1-\\vartheta2\\right)^4\\,\\left(2\\,ħ+\\vartheta1-\\vartheta2\\right)^2\\,\\left(ħ-\\vartheta1+\\vartheta2\\right)^4\\,\\left(2\\,ħ-\\vartheta1+\\vartheta2\\right)^2}\\\\\\hline\\text{c0 same on 16 monomials} & \\mathrm{True}\\\\\\hline\\text{c0 = ($\\varepsilon$2-$\\varepsilon$1)\\^{}3 c0(per-ladder)} & \\mathrm{True}\\\\\\hline\\text{full formula, all 64} & \\text{0.}\\times 10^{\\text{-50}}\\\\\\hline\\end{array}",
