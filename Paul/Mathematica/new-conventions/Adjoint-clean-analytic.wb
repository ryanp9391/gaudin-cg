       "data": "Out[860]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\mu  & \\lambda  & \\text{signal S: orders $\\varepsilon$\\^{}0, $\\varepsilon$\\^{}1, $\\varepsilon$\\^{}2 (zero?)} & \\text{top-killed covector at $\\varepsilon$\\^{}0 vanishes?} & \\text{K at $\\varepsilon$\\^{}2 is zero?} & \\text{h eigenvector \\& $\\psi$1 equation residuals zero?}\\\\\\hline\\left\\{2,2,2\\right\\} & \\text{11} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\} & \\mathrm{True} & \\mathrm{False} & \\mathrm{True}\\\\\\hline\\left\\{2,2,2\\right\\} & \\text{21} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{False}\\right\\} & \\mathrm{True} & \\mathrm{False} & \\mathrm{True}\\\\\\hline\\left\\{3,3,0\\right\\} & \\text{11} & \\left\\{\\mathrm{True},\\mathrm{False},\\mathrm{False}\\right\\} & \\mathrm{True} & \\mathrm{False} & \\mathrm{True}\\\\\\hline\\left\\{3,3,0\\right\\} & \\text{21} & \\left\\{\\mathrm{True},\\mathrm{False},\\mathrm{False}\\right\\} & \\mathrm{True} & \\mathrm{False} & \\mathrm{True}\\\\\\hline\\left\\{4,1,1\\right\\} & \\text{11} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\left\\{4,1,1\\right\\} & \\text{21} & \\left\\{\\mathrm{True},\\mathrm{False},\\mathrm{False}\\right\\} & \\mathrm{True} & \\mathrm{False} & \\mathrm{True}\\\\… [latex truncated: 1263 chars total]",
