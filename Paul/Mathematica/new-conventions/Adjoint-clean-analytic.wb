       "data": "Out[839]= \\begin{array}{|c|c|}\\hline\\text{dims} & \\left\\{8,64\\right\\}\\\\\\hline\\text{build time (s)} & 0.041622\\\\\\hline\\text{T21 entries are polynomials in} & \\left\\{\\mathrm{tt},\\mathrm{zz}\\left(1\\right),\\mathrm{zz}\\left(2\\right),\\mathrm{zz}\\left(3\\right)\\right\\}\\\\\\hline\\end{array}",
