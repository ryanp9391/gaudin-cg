span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.4033em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span><span style=\"top:-3.5667em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-2.3667em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-1.1616em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">3</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">1</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">(</span><span class=\"mord\">2</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">tt</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">3</span><span class=\"mclose delimcenter\" style=\"top:0em;\">)</span></span></span></span><span style=\"top:0.0435em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">−</span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">3</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">1</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.4035em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:7.3071em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.4035em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.9035em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7051em;\"><span class=\"pstrut\" style=\"height:5.9035em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9102em;\"><span class=\"pstrut\" style=\"height:5.9035em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1102em;\"><span class=\"pstrut\" style=\"height:5.9035em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3102em;\"><span class=\"pstrut\" style=\"height:5.9035em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5587em;\"><span class=\"pstrut\" style=\"height:5.9035em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.8071em;\"><span class=\"pstrut\" style=\"height:5.9035em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.4035em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[866]= \\begin{array}{|c|c|}\\hline\\text{$\\beta$(t), directions A} & \\frac{2\\,\\mathrm{tt}-3}{\\mathrm{tt}-1}\\\\\\hline\\text{$\\beta$(t), directions B} & \\frac{2\\,\\mathrm{tt}-3}{\\mathrm{tt}-1}\\\\\\hline\\text{A = B ?} & \\mathrm{True}\\\\\\hline\\text{= (2t-3)/(t-1) (fitted earlier, h=1)?} & \\mathrm{True}\\\\\\hline\\text{K21/S21 (singlet, plain top-killed T21)} & \\frac{1}{3}\\,\\left(2\\,\\mathrm{tt}-3\\right)\\\\\\hline\\text{K11/S21} & -\\frac{1}{3}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "56cdf602-2e4f-4d3a-9fec-dadf73da1ac6"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "**Result (exact, independent of $\\varphi,\\omega$).** With $h=1$, the singlet's contamination ratios at $\\varepsilon^2$, in raw eigenvalues, are $K_{(1,1)}/S_{(2,1)}=-\\tfrac13$ and $K_{(2,1)}/S_{(2,1)}=\\tfrac{2t-3}{3}$. So:\n- **$f$-normalized:** $\\beta=\\frac{2t-3}{t-1}$, i.e. $\\beta=h\\frac{2\\theta_{12}-3h}{\\theta_{12}-h}$ with $h$ restored. This matches the earlier fit.\n- **Raw:** the clean combination is $T_{(2,1)}+h(2\\theta_{12}-3h)\\,T_{(1,1)}$ at $\\theta_1-2h$, top-killed.\n- **Every other HW state** ($[4,1,1]$, $[3,3,0]$, octets) has signal at $O(\\varepsilon)$ and contamination at $O(\\varepsilon^2)$, so this one combination is clean for all of them.\n\n## 2. In terms of Q's\nPrediction for the adjoint at $\\theta_1-2h$ ($\\Lambda_1=2$, $\\Lambda_2=1$, $G=\\prod_s(u-\\theta_s+h)$), from the general formula:\n- $T_{(1,1)}/f_{(1,1)}=3h^2\\chi_3\\,r$;\n- $T_{(2,1)}/f_{(2,1)}=-3h^3\\chi_3\\,\\rho\\,r$;\n- $r=Q_c(\\theta_1-h)/Q_c(\\theta_1-2h)$ (direct, any $c$), $\\rho=Q^j(\\theta_1)/Q^j(\\theta_1-h)$ (dual, any $j$).\n\nFor the top state ($q_1=1$, $q^3=1$) this gives $r=1/z_1$ and $\\rho=z_3$, i.e. $3h^2z_2z_3$ and $-3h^3z_2z_3^2$, which is the $[4,2,0]$ row of the Section 10d table of `L2-diagonal-frame-overlap.md`. The cell checks the prediction numerically at $t=62/35$ ($h=1$), finite twist $z=(3/2,5/4,2/3)$, for every state of three weight sectors, all $c$ and $j$.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "pr = 60; tt0 = 62/35; zN = {3/2, 5/4, 2/3}; th0 = {tt0, 0};\nnuN[n_][x_] := Product[x - th0[[s]] + Λ[[n]], {s, 2}];\nsubs0 = Join[{tt -> tt0}, Thread[Array[zz, 3] -> zN]];\n(* numeric matrices, substituted once and cached *)\ntN[a_, x_] := tN[a, x] = N[Normal[tS[a, x]] /. subs0, pr];\nopsN = Association[Table[λ -> N[Normal[ops[λ]] /. subs0, pr], {λ, {\"11\", \"21\"}}]];\nmixN = tN[1, 3/7] + N[Pi, pr] tN[2, 1/5];\nxs = Range[0, 4]/3;\n(* eigenvalue polynomial of t_a by interpolation through 2a+1 points *)\nevPoly[a_, Ψ_, k_] := InterpolatingPolynomial[Table[{x, (tN[a, x] . Ψ)[[k]]/Ψ[[k]]}, {x, Take[xs, 2 a + 1]}], X];\nqSolve[op_, d_] := Module[{c, q, cl, sol}, q[x_] := x^d + Sum[c[i] x^i, {i, 0, d - 1}]; cl = CoefficientList[Expand[op[q]], X];\n   sol = If[d == 0, {}, LeastSquares[Table[Coefficient[e, c[i]], {e, cl}, {i, 0, d - 1}], -(cl /. c[_] -> 0)]];\n   {Function[x, Evaluate[x^d + Sum[If[d == 0, 0, sol[[i + 1]]] x^i, {i, 0, d - 1}]]], Max[Abs[cl /. Thread[Table[c[i], {i, 0, d - 1}] -> sol]]]/Max[Abs[cl /. c[_] -> 0]]}];\nt3N[x_] := (Times @@ zN) nuN[1][x] nuN[2][x - 1] nuN[3][x - 2];\ncheckState[Ψ_, μ_] := Module[{k = Ordering[Abs[Ψ], -1][[1]], t1, t2, up, lo, Qd, Qu, χ3 = Times @@ zN, X11, X21, th = tt0},\n   t1 = Expand[evPoly[1, Ψ, k]]; t2 = Expand[evPoly[2, Ψ, k]];\n   up = Table[With[{zj = zN[[j]]}, qSolve[Function[q, nuN[3][X] nuN[3][X - 1] nuN[3][X - 2] zj q[X + 1] - t1 nuN[3][X - 1] nuN[3][X - 2] q[X] + t2 nuN[3][X - 2] q[X - 1]/zj - t3N[X] q[X - 2]/zj^2], μ[[j]]]], {j, 3}];\n   lo = Table[With[{zi = zN[[i]]}, qSolve[Function[q, nuN[1][X] nuN[1][X + 1] nuN[1][X + 2] zi q[X - 1] - t1 nuN[1][X + 1] nuN[1][X + 2] q[X] + (t2 /. X -> X + 1) nuN[1][X + 2] q[X + 1]/zi - t3N[X + 2] q[X + 2]/zi^2], 4 - μ[[i]]]], {i, 3}];\n   Qd[j_][u_] := zN[[j]]^u up[[j, 1]][u]; Qu[c_][u_] := zN[[c]]^(-u) lo[[c, 1]][u];\n   X11 = (opsN[\"11\"] . Ψ)[[k]]/Ψ[[k]]/((tt0 - 1) (tt0 - 3)); X21 = (opsN[\"21\"] . Ψ)[[k]]/Ψ[[k]]/((tt0 - 1)^2 (tt0 - 3));\n   {Max[up[[All, 2]], lo[[All, 2]]],\n    Max[Table[Abs[3 χ3 Qu[c][th - 1]/Qu[c][th - 2] - X11]/Abs[X11], {c, 3}]],\n    Max[Table[Abs[-3 χ3 Qd[j][th]/Qd[j][th - 1] Qu[c][th - 1]/Qu[c][th - 2] - X21]/Abs[X21], {c, 3}, {j, 3}]]}];\ntestSecs = {{2, 2, 2}, {3, 2, 1}, {3, 3, 0}};\n{tQ, qTab} = AbsoluteTiming[Flatten[Table[With[{sec = secOf[μ]}, With[{es = Eigenvectors[mixN[[sec, sec]]]}, Table[Prepend[checkState[Normal[SparseArray[Thread[sec -> e], {d2}]], μ], μ], {e, es}]]], {μ, testSecs}], 1]];\nGrid[Join[{{\"μ\", \"Baxter residuals (max)\", \"X11 = 3h²χ₃ r (max rel., all c)\", \"X21 = -3h³χ₃ ρ r (max rel., all c, j)\"}},\n   Table[{μ, Sequence @@ (N[Max[#], 3] & /@ Transpose[Select[qTab, #[[1]] === μ &][[All, 2 ;;]]])}, {μ, testSecs}], {{\"time (s)\", tQ, \"\", \"\"}}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<details class=\"vscode-wolfram-message-output\" style=\"color:#f44;border-left:3px solid #f44;background:rgba(255,68,68,0.08);padding:2px 6px;margin:1px 0;border-radius:0 3px 3px 0;font-family:monospace;font-size:0.85em\"><summary style=\"cursor:pointer\">4 warnings</summary><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression -------- encountered.                                       -54                                  0. 10</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0. 10    ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression -------- encountered.                                       -54                                  0. 10</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0. 10    ComplexInfinity encountered.</div></details>",
       "mime": "x-application/wolfram-language-html"
      },
