      {
       "data": "Out[266]= \\begin{aligned}\n  &\\left\\{\\text{M}\\to \\left\\{1,1,3,3\\right\\},\\text{\\#eqs/\\#unk/\\#sol}\\to \\left\\{68,26,1\\right\\} \\right. \\\\\n  &\\left. ,\\text{free}\\to \\left\\{\\mathrm{pcn}\\left(3,1,2\\right),\\mathrm{pcn}\\left(3,2,1\\right),\\mathrm{pcn}\\left(4,1,2\\right) \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{pcn}\\left(4,2,1\\right),\\mathrm{tcn}\\left(1,2\\right),\\mathrm{tcn}\\left(5,2\\right)\\right\\},\\text{tc\\^{}(1)} \\right. \\\\\n  &\\left. \\to \\left\\{-\\frac{3424\\,\\mathrm{i}}{6615},\\frac{3296824\\,\\mathrm{i}}{46305},-\\frac{429304\\,\\mathrm{i}}{19845},\\frac{516032\\,\\mathrm{i}}{138915},\\frac{106088\\,\\mathrm{i}}{6615}\\right\\} \\right. \\\\\n  &\\left. ,\\text{satisfies Section 8 order-1 relations?}\\to \\left\\{0,0,0\\right\\}\\right\\}\n\\end{aligned}",
