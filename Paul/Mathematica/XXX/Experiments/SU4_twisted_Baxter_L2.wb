      {
       "data": "Out[14]= \\begin{aligned}\n  &\\left\\{h^2\\,P\\,S+h\\,\\theta1\\,P-h\\,P\\,u+h\\,\\theta2\\,S-h\\,S\\,u+\\theta1\\,\\theta2 \\right. \\\\\n  &\\left. +u^2-\\theta1\\,u-\\theta2\\,u,\\theta1\\,\\theta2+u^2-\\theta1\\,u-\\theta2\\,u,0,0\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
