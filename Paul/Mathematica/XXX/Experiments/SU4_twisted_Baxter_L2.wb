      {
       "data": "Out[254]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{k} & \\text{M\\_k} & \\text{\\#conditions} & \\text{solvable?} & \\text{still free}\\\\\\hline1 & 0 & 6 & \\mathrm{True} & \\left\\{\\mathrm{tcn}\\left(1,1\\right),\\mathrm{tcn}\\left(1,2\\right),\\mathrm{tcn}\\left(1,3\\right),\\mathrm{tcn}\\left(2,1\\right),\\mathrm{tcn}\\left(2,2\\right),\\mathrm{tcn}\\left(2,3\\right)\\right\\}\\\\\\hline2 & 0 & 6 & \\mathrm{True} & \\left\\{\\mathrm{tcn}\\left(1,1\\right),\\mathrm{tcn}\\left(1,2\\right),\\mathrm{tcn}\\left(1,3\\right),\\mathrm{tcn}\\left(2,1\\right),\\mathrm{tcn}\\left(2,2\\right),\\mathrm{tcn}\\left(2,3\\right)\\right\\}\\\\\\hline3 & 2 & 1 & \\mathrm{True} & \\left\\{\\mathrm{qq}\\left(1,1\\right),\\mathrm{qq}\\left(2,1\\right),\\mathrm{qq}\\left(3,1\\right),\\mathrm{tcn}\\left(1,1\\right),\\mathrm{tcn}\\left(1,2\\right),\\mathrm{tcn}\\left(1,3\\right),\\mathrm{tcn}\\left(2,1\\right),\\mathrm{tcn}\\left(2,2\\right),\\mathrm{tcn}\\left(2,3\\right),\\mathrm{tcn}\\left(3,3\\right)\\right\\}\\\\\\hline4 & 2 & 1 & \\mathrm{True} & \\left\\{\\mathrm{qq}\\left(1,1\\right),\\mathrm{qq}\\left(2,1\\right),\\mathrm{qq}\\left(3,1\\right),\\mathrm{tcn}\\left(1,1\\right),\\mathrm{tcn}\\left(1,2\\right),\\mathrm{tcn}\\left(1,3\\right),\\mathrm{tcn}\\left(2,1\\right),\\mathrm{tcn}\\left(2,2\\right),\\mathrm{tcn}\\left(2,3\\right)… [latex truncated: 1256 chars total]",
       "mime": "text/plain"
      }
