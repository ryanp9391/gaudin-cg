       "data": "Out[102]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{(S,P)} & \\text{weight} & \\text{M} & \\text{pred deg q\\textasciitilde{}123} & \\text{remainder mod A} & \\text{deg quotient} & \\text{lead coeff}\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,3,0,0\\right\\} & \\left\\{0,0,3,3\\right\\} & 0 & 0 & 0 & 1\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,0,3,0\\right\\} & \\left\\{0,3,0,3\\right\\} & 0 & 0 & 0 & 1\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,0,0,3\\right\\} & \\left\\{0,3,3,0\\right\\} & 3 & 0 & 3 & 1\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{0,3,3,0\\right\\} & \\left\\{3,0,0,3\\right\\} & 0 & 0 & 0 & 1\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{0,3,0,3\\right\\} & \\left\\{3,0,3,0\\right\\} & 3 & 0 & 3 & 1\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{0,0,3,3\\right\\} & \\left\\{3,3,0,0\\right\\} & 3 & 0 & 3 & 1\\\\\\hline\\left\\{3,1\\right\\} & \\left\\{4,4,0,0\\right\\} & \\left\\{0,0,4,4\\right\\} & 0 & 0 & 0 & 1\\\\\\hline\\left\\{3,1\\right\\} & \\left\\{4,0,4,0\\right\\} & \\left\\{0,4,0,4\\right\\} & 0 & 0 & 0 & 1\\\\\\hline\\left\\{3,1\\right\\} & \\left\\{4,0,0,4\\right\\} & \\left\\{0,4,4,0\\right\\} & 4 & 0 & 4 & 1\\\\\\hline\\left\\{3,1\\right\\} & \\left\\{0,4,4,0\\right\\} & \\left\\{4,0,0,4\\right\\} & 0 & 0 & 0 & 1\\\\\\hline\\left\\{3,1\\right\\} & \\left\\{0,4,0,4\\right\\} & \\left\\{4,0,4,0\\right\\} & 4 & 0 & 4 & 1\\\\\\hli… [latex truncated: 1305 chars total]",
