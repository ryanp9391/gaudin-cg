      {
       "data": "Out[194]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{M}\\to \\left\\{1,1,3,3\\right\\},\\text{Mh}\\to \\left\\{1,2,5,6\\right\\},\\text{q0}\\to \\left\\{1,-\\frac{63}{34}\\right\\} \\\\\n  &,\\text{tc0}\\to \\left\\{-\\frac{16}{7},\\frac{10952}{147},-\\frac{346}{21},\\frac{1712}{441},\\frac{244}{21}\\right\\} \\\\\n  &,\\text{order0 residual}\\to \\left\\{0\\right\\},\\text{\\#eqs}\\to 34 \\\\\n  &,\\text{\\#unknowns}\\to 19,\\text{\\#solutions}\\to 1,\\text{lead0}\\to \\\\\n  &\\left\\{\\mathrm{pv}\\left(\\mathrm{tc}\\left(1\\right),0\\right)\\to -\\frac{16}{7},\\mathrm{pv}\\left(\\mathrm{tc}\\left(2\\right),0\\right)\\to \\frac{10952}{147},\\mathrm{pv}\\left(\\mathrm{tc}\\left(3\\right),0\\right)\\to -\\frac{346}{21},\\mathrm{pv}\\left(\\mathrm{tc}\\left(4\\right),0\\right)\\to \\frac{1712}{441},\\mathrm{pv}\\left(\\mathrm{tc}\\left(5\\right),0\\right)\\to \\frac{244}{21},\\mathrm{pv}\\left(\\mathrm{qc}\\left(1,1\\right),0\\right)\\to -\\frac{63}{34},\\mathrm{pv}\\left(\\mathrm{qc}\\left(2,1\\right),0\\right)\\to -\\frac{63}{34},\\mathrm{pv}\\left(\\mathrm{qc}\\left(2,2\\right),0\\right)\\to 0,\\mathrm{pv}\\left(\\mathrm{qc}\\left(3,1\\right),0\\right)\\to -\\frac{63}{34},\\mathrm{pv}\\left(\\mathrm{qc}\\left(3,2\\right),0\\right)\\to 0,\\mathrm{pv}\\left(\\mathrm{qc}\\left(3,3\\right),0\\right)\\to 0,\\mathrm{pv}\\left(\\mathrm{qc}\\lef… [latex truncated: 2247 chars total]",
       "mime": "text/plain"
