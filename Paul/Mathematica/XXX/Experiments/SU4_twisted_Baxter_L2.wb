      {
       "data": "Out[167]= \\begin{aligned}\n  &\\left\\{\\text{degU == Mhat} \\right. \\\\\n  &\\left. \\to \\begin{pmatrix}\\left\\{\\mathrm{True}\\right\\} & \\left\\{\\mathrm{True}\\right\\}\\\\\\left\\{\\mathrm{True}\\right\\} & \\left\\{\\mathrm{True}\\right\\}\\\\\\left\\{\\mathrm{True}\\right\\} & \\left\\{\\mathrm{True}\\right\\}\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\text{tau degrees}\\to \\left\\{2,4,6,8\\right\\} \\right. \\\\\n  &\\left. ,\\text{tau2 carries Cas4}\\to \\mathrm{True}\\right\\}\n\\end{aligned}",
