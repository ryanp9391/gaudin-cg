     "id": "a2db0905-7fee-4a11-b103-d773bf9b7c1f"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Solve the order-2 system for the order-2 unknowns together with the order-1 leftovers f1,\n   then validate against the EXACT pseudovacuum tau, expanded to second order in eps. *)\nsol2vac = Solve[Thread[ord2vac[\"e2\"] == 0], Join[ord2vac[\"u2\"], ord2vac[\"f1\"]]];\n\ntcExactSeries = Module[{x, eqs, tcEps},\n   eqs = Flatten[Table[CoefficientList[Expand[τ[a][1, 1, {2, 2, 0, 0}][x] - τvac[1, 1][a][x]], x], {a, 3}]];\n   tcEps = (tcvars /. First@Solve[Thread[eqs == 0], tcvars]) /. th /. zser[2];\n   Table[Coefficient[Normal[Series[tcEps[[i]], {eps, 0, 2}]], eps, n], {n, 0, 2}, {i, 5}]];\n\n{\"#order-2 solutions\" -> Length[sol2vac],\n \"exact tc^(1)\" -> tcExactSeries[[2]],\n \"tc^(1) from each branch\" -> Table[Table[pv[tc[i], 1], {i, 5}] /. Join[First[ord2vac[\"sub01\"]] & @@ {}, {}] /. s /. ord2vac[\"sub01\"], {s, sol2vac}]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<details class=\"vscode-wolfram-message-output\" style=\"color:#f44;border-left:3px solid #f44;background:rgba(255,68,68,0.08);padding:2px 6px;margin:1px 0;border-radius:0 3px 3px 0;font-family:monospace;font-size:0.85em\"><summary style=\"cursor:pointer\">2 warnings</summary><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Solve::svars: Equations may not give solutions for all &quot;solve&quot; variables.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Solve::svars: Equations may not give solutions for all &quot;solve&quot; variables.</div></details>",
       "mime": "x-application/wolfram-language-html"
      },
