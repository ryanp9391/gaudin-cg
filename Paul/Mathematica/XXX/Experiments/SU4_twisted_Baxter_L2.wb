       "data": "Out[231]= \\begin{array}{|c|c|c|c|}\\hline\\text{k} & \\text{degree of limit} & \\text{Mhat\\_k} & \\text{limit}\\\\\\hline1 & 0 & 0 & 1\\\\\\hline2 & 1 & 1 & -\\frac{2\\,\\mathrm{i}\\,\\mathrm{uu}}{3}\\\\\\hline3 & 1 & 4 & -\\frac{32\\,\\mathrm{uu}}{64715}\\\\\\hline4 & 1 & 5 & -\\frac{5409216\\,\\mathrm{i}\\,\\mathrm{uu}}{3948574478135}\\\\\\hline\\end{array}",
