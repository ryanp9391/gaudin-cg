      {
       "data": "Out[245]= \\begin{array}{|c|c|c|c|}\\hline\\text{n} & \\text{Q\\^{}(n) from solver} & \\text{exact} & \\text{difference}\\\\\\hline1 & \\mathrm{uu}\\,\\mathrm{qq}\\left(1,1\\right) & \\mathrm{i}\\,\\mathrm{uu} & \\mathrm{uu}\\,\\left(\\mathrm{qq}\\left(1,1\\right)-\\mathrm{i}\\right)\\\\\\hline2 & \\mathrm{uu}\\,\\left(\\mathrm{qq}\\left(2,1\\right)+\\mathrm{uu}\\,\\left(\\mathrm{qq}\\left(1,1\\right)\\,\\left(\\frac{1}{6}\\,\\mathrm{tcn}\\left(1,1\\right)+\\frac{2152\\,\\mathrm{i}}{6615}\\right)+\\frac{1}{6}\\,\\mathrm{tcn}\\left(1,2\\right)+\\frac{5}{252}\\,\\mathrm{tcn}\\left(2,2\\right)+\\frac{1}{24}\\,\\mathrm{tcn}\\left(3,2\\right)-\\frac{3628867}{102102525}\\right)\\right) & -\\frac{\\mathrm{uu}^2}{2} & \\frac{1}{2}\\,\\mathrm{uu}\\,\\left(2\\,\\mathrm{qq}\\left(2,1\\right)+\\mathrm{uu}\\,\\left(\\mathrm{qq}\\left(1,1\\right)\\,\\left(\\frac{1}{3}\\,\\mathrm{tcn}\\left(1,1\\right)+\\frac{4304\\,\\mathrm{i}}{6615}\\right)+\\frac{1}{3}\\,\\mathrm{tcn}\\left(1,2\\right)+\\frac{5}{126}\\,\\mathrm{tcn}\\left(2,2\\right)+\\frac{1}{12}\\,\\mathrm{tcn}\\left(3,2\\right)+\\frac{94844791}{102102525}\\right)\\right)\\\\\\hline3 & \\mathrm{uu}\\,\\left(\\mathrm{uu}^2\\,\\left(\\mathrm{qq}\\left(1,1\\right)^2\\,\\left(\\frac{1}{12}\\,\\mathrm{tcn}\\left(2,1\\right)-\\frac{37420\\,\\mathrm{i}}{9261}\\right)+\\mathrm{qq}\\left(1,1\\right)… [latex truncated: 7088 chars total]",
