      {
       "data": "Out[96]= \\begin{aligned}\n  &\\left\\{\\text{\\#untwisted solutions}\\to 1 \\right. \\\\\n  &\\left. ,\\text{tc0}\\to \\left\\{-\\frac{16}{7},\\frac{10952}{147},-\\frac{346}{21},\\frac{1712}{441},\\frac{244}{21}\\right\\} \\right. \\\\\n  &\\left. ,\\text{untwisted degrees}\\to \\left\\{1,2,5,6\\right\\}\\right\\}\n\\end{aligned}",
