     "id": "6648b0e0-c473-4e1a-b39e-d4fe5fb4ed33"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Are the four order-0 branches genuinely different states, or the same tau with different\n   Q-normalisations? Compare tc, and compare against the exactly-known untwisted pseudovacuum. *)\ntcExact0 = Module[{x},\n   tcvars /. First@Solve[Thread[Flatten[Table[\n      CoefficientList[Expand[((τ[a][1, 1, {2, 2, 0, 0}][x] - τvac[1, 1][a][x]) /. th) /. Table[z[j] -> 1, {j, 4}]], x],\n      {a, 3}]] == 0], tcvars]];\nGrid[Prepend[\n  Table[Prepend[Table[pv[tc[i], 0], {i, 5}] /. sol0[[s]], \"branch \" <> ToString[s]], {s, Length[sol0]}],\n  {\"\", \"tc1\", \"tc2\", \"tc3\", \"tc4\", \"tc5\"}] ~Join~ {Prepend[tcExact0, \"tau_vac (exact, z->1)\"]},\n Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
