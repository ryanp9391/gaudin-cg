       "data": "Out[90]= \\begin{array}{|c|c|c|c|}\\hline\\text{I} & \\text{object} & \\text{degree} & \\text{eps orders of coefficients}\\\\\\hline\\left\\{1\\right\\} & \\text{q\\_1} & 0 & \\left\\{0\\right\\}\\\\\\hline\\left\\{2\\right\\} & \\text{q\\_2} & 1 & \\left\\{-1,0\\right\\}\\\\\\hline\\left\\{3\\right\\} & \\text{q\\_3} & 1 & \\left\\{-1,0\\right\\}\\\\\\hline\\left\\{4\\right\\} & \\text{q\\_4} & 2 & \\left\\{-2,-1,0\\right\\}\\\\\\hline\\left\\{1,2\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 1 & \\left\\{0,0\\right\\}\\\\\\hline\\left\\{1,3\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 1 & \\left\\{0,0\\right\\}\\\\\\hline\\left\\{2,3\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 2 & \\left\\{-1,-1,0\\right\\}\\\\\\hline\\left\\{1,2,3\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 2 & \\left\\{0,0,0\\right\\}\\\\\\hline\\left\\{1,2,4\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 3 & \\left\\{-1,-1,-1,0\\right\\}\\\\\\hline\\left\\{2,3,4\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 4 & \\left\\{-2,-2,-2,-1,0\\right\\}\\\\\\hline\\left\\{1,2,3,4\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 4 & \\left\\{0,0,0,0,0\\right\\}\\\\\\hline\\end{array}",
