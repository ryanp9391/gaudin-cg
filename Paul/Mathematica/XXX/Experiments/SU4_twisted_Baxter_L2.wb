       "data": "Out[66]//TableForm= \\begin{pmatrix}\\left\\{P+S,P+S,0,0\\right\\} & \\left\\{1,2,3,4\\right\\}\\\\\\left\\{P+S,0,P+S,0\\right\\} & \\left\\{1,3,2,4\\right\\}\\\\\\left\\{P+S,0,0,P+S\\right\\} & \\left\\{1,4,2,3\\right\\}\\\\\\left\\{0,P+S,P+S,0\\right\\} & \\left\\{2,3,1,4\\right\\}\\\\\\left\\{0,P+S,0,P+S\\right\\} & \\left\\{2,4,1,3\\right\\}\\\\\\left\\{0,0,P+S,P+S\\right\\} & \\left\\{3,4,1,2\\right\\}\\end{pmatrix}",
