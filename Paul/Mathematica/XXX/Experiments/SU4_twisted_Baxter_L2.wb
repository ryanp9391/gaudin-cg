n></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6.0481em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.7741em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.2741em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7215em;\"><span class=\"pstrut\" style=\"height:5.2741em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9266em;\"><span class=\"pstrut\" style=\"height:5.2741em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1481em;\"><span class=\"pstrut\" style=\"height:5.2741em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3481em;\"><span class=\"pstrut\" style=\"height:5.2741em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5481em;\"><span class=\"pstrut\" style=\"height:5.2741em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.7741em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
