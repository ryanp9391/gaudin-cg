   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Every z[j] is a root of the twist characteristic polynomial. This identity is what makes the\n   leading coefficient of every branch's Baxter residual vanish automatically — checked below. *)\nClearAll[charPoly];\ncharPoly[x_] := x^4 - χ[1] x^3 + χ[2] x^2 - χ[3] x + χ[4];\n\nSimplify[Table[charPoly[z[k]], {k, 4}]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"961315\" data-output-id=\"1\" data-out-n=\"9\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"3\" data-sub-start=\"5\" data-sub-end=\"5\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[9]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"XGxlZnRcezAsMCwwLDBccmlnaHRcfQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[9]= \\left\\{0,0,0,0\\right\\}",
