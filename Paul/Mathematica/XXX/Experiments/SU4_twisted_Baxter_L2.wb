      {
       "data": "Out[171]= \\begin{aligned}\n  &\\left\\{\\text{tc0U[\\{2,1,1,0\\},1,1]} \\right. \\\\\n  &\\left. \\to \\left\\{\\frac{8}{7},\\frac{6626}{147},-\\frac{3016}{147},-\\frac{640}{441},\\frac{232}{21}\\right\\},\\text{tau4 agrees} \\right. \\\\\n  &\\left. \\to \\mathrm{True},\\text{pseudovacuum: tc0U - tcExact0} \\right. \\\\\n  &\\left. \\to \\left\\{0,0,0,0,0\\right\\} \\right. \\\\\n  &\\left. ,\\text{pseudovacuum: tc0U - order-0 solve} \\right. \\\\\n  &\\left. \\to \\left\\{0,0,0,0,0\\right\\}\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
     ],
     "id": "8b9dca8f-4199-4b7b-8e37-97ad97ef78b2"
