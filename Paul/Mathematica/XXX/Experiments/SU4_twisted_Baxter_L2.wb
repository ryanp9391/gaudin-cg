      {
       "data": "Out[92]= \\begin{array}{|c|c|c|c|}\\hline\\text{I} & \\text{object} & \\text{degree} & \\text{eps orders of coefficients}\\\\\\hline\\left\\{1\\right\\} & \\text{q\\_1} & 1 & \\left\\{0,0\\right\\}\\\\\\hline\\left\\{2\\right\\} & \\text{q\\_2} & 1 & \\left\\{0,0\\right\\}\\\\\\hline\\left\\{3\\right\\} & \\text{q\\_3} & 1 & \\left\\{0,0\\right\\}\\\\\\hline\\left\\{4\\right\\} & \\text{q\\_4} & 1 & \\left\\{0,0\\right\\}\\\\\\hline\\left\\{1,2\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 2 & \\left\\{0,0,0\\right\\}\\\\\\hline\\left\\{2,3\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 2 & \\left\\{0,0,0\\right\\}\\\\\\hline\\left\\{3,4\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 2 & \\left\\{0,0,0\\right\\}\\\\\\hline\\left\\{1,2,3\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 3 & \\left\\{0,0,0,0\\right\\}\\\\\\hline\\left\\{2,3,4\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 3 & \\left\\{0,0,0,0\\right\\}\\\\\\hline\\left\\{1,2,3,4\\right\\} & \\text{q\\_I = W\\_I/V\\_I} & 4 & \\left\\{0,0,0,0,0\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
