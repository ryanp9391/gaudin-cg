      },
      {
       "data": "Out[270]= \\begin{array}{|c|c|}\\hline\\text{order n} & \\text{tc\\^{}(n) from joint solver  -  exact}\\\\\\hline1 & \\left\\{0,0,0,0,0\\right\\}\\\\\\hline2 & \\left\\{0,0,0,0,0\\right\\}\\\\\\hline3 & \\left\\{0,0,0,0,0\\right\\}\\\\\\hline4 & \\left\\{0,0,0,0,0\\right\\}\\\\\\hline5 & \\left\\{0,0,0,0,0\\right\\}\\\\\\hline6 & \\left\\{\\mathrm{tcn}\\left(1,6\\right)+\\frac{21470991078373}{10131123043125000},\\mathrm{tcn}\\left(1,6\\right)+\\mathrm{tcn}\\left(5,6\\right)+\\frac{179163412754933}{1013112304312500},-\\frac{94}{21}\\,\\mathrm{tcn}\\left(1,6\\right)-\\frac{10}{21}\\,\\mathrm{tcn}\\left(5,6\\right)-\\frac{2464988065759579}{26594197988203125},5\\,\\mathrm{tcn}\\left(1,6\\right)+\\frac{1}{21}\\,\\mathrm{tcn}\\left(5,6\\right)+\\frac{2012308599850061}{106376791952812500},\\mathrm{tcn}\\left(5,6\\right)+\\frac{1770163136470957}{10131123043125000}\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
