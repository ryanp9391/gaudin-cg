      {
       "data": "Out[219]= \\begin{aligned}\n  &\\left\\{\\text{Z[j] coefficient == z\\_j\\^{}-3 BaxRes\\_j ?} \\right. \\\\\n  &\\left. \\to \\left\\{0,0,0,0\\right\\} \\right. \\\\\n  &\\left. ,\\text{any cross terms p\\_i in the Z[j] equation?} \\right. \\\\\n  &\\left. \\to \\left\\{\\{\\},\\{\\},\\{\\},\\{\\}\\right\\}\\right\\}\n\\end{aligned}",
