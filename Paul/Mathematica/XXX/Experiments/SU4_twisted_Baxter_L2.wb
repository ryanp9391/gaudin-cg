      {
       "data": "Out[59]= \\begin{aligned}\n  &\\left\\{\\text{\\#solutions}\\to 4 \\right. \\\\\n  &\\left. ,\\text{\\#free parameters left}\\to 6,\\text{free} \\right. \\\\\n  &\\left. \\to \\left\\{\\mathrm{pv}\\left(\\mathrm{qc}\\left(2,1\\right),0\\right),\\mathrm{pv}\\left(\\mathrm{qc}\\left(3,1\\right),0\\right),\\mathrm{pv}\\left(\\mathrm{qc}\\left(3,4\\right),0\\right) \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{pv}\\left(\\mathrm{qc}\\left(4,1\\right),0\\right),\\mathrm{pv}\\left(\\mathrm{qc}\\left(4,4\\right),0\\right),\\mathrm{pv}\\left(\\mathrm{qc}\\left(4,5\\right),0\\right)\\right\\} \\right. \\\\\n  &\\left. ,\\text{tc at order 0}\\to \\left\\{\\frac{22}{7},\\frac{7214}{147},-\\frac{4472}{147},\\frac{3812}{441},\\frac{274}{21}\\right\\}\\right\\}\n\\end{aligned}",
