      {
       "data": "Out[109]= \\begin{array}{|c|c|}\\hline\\text{M} & \\left\\{0,1,1,2\\right\\}\\\\\\hline\\text{kernel degrees predicted (Mhat\\_1, Mhat\\_2)} & \\left\\{0,2\\right\\}\\\\\\hline\\text{coefficient degrees (= M\\_1+M\\_2)} & \\left\\{1,1,1\\right\\}\\\\\\hline\\text{O\\_3[q\\_1] (must vanish)} & 0\\\\\\hline\\text{d -> deg O\\_3} & \\left\\{0\\to -\\infty ,1\\to 0,2\\to 0,3\\to 2,4\\to 3,5\\to 4\\right\\}\\\\\\hline\\text{generic rule M\\_1+M\\_2+d-2} & \\left\\{0\\to -1,1\\to 0,2\\to 1,3\\to 2,4\\to 3,5\\to 4\\right\\}\\\\\\hline\\text{=> extra drops exactly at d = 0, 2 = Mhat\\_1, Mhat\\_2} & \\text{kernel confirmed}\\\\\\hline\\text{count at d = M\\_3+2 (outside kernel)} & \\left\\{3,\\text{deg}\\to 2,\\text{= M\\_1+M\\_2+M\\_3}\\to 2\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "dae074ab-1411-4bb7-ba04-90ad66cf856d"
