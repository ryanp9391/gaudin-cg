      {
       "data": "Out[27]= \\begin{aligned}\n  &-h\\,m1\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z\\left(3\\right)-h\\,m1\\,z\\left(1\\right)\\,z\\left(4\\right)\\,z\\left(3\\right) \\\\\n  &-h\\,m1\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z\\left(4\\right)-h\\,m2\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z\\left(3\\right) \\\\\n  &-h\\,m2\\,z\\left(2\\right)\\,z\\left(4\\right)\\,z\\left(3\\right)-h\\,m2\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z\\left(4\\right) \\\\\n  &-h\\,m3\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z\\left(3\\right)-h\\,m3\\,z\\left(1\\right)\\,z\\left(4\\right)\\,z\\left(3\\right) \\\\\n  &-h\\,m3\\,z\\left(2\\right)\\,z\\left(4\\right)\\,z\\left(3\\right)-h\\,m4\\,z\\left(1\\right)\\,z\\left(4\\right)\\,z\\left(3\\right) \\\\\n  &-h\\,m4\\,z\\left(2\\right)\\,z\\left(4\\right)\\,z\\left(3\\right)-h\\,m4\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z\\left(4\\right) \\\\\n  &+h\\,P\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z\\left(3\\right)+h\\,P\\,z\\left(1\\right)\\,z\\left(4\\right)\\,z\\left(3\\right) \\\\\n  &+h\\,P\\,z\\left(2\\right)\\,z\\left(4\\right)\\,z\\left(3\\right)+h\\,P\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z\\left(4\\right) \\\\\n  &+h\\,S\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z\\left(3\\right)+h\\,S\\,z\\left(1\\right)\\,z\\left(4\\right)\\,z\\left(3\\right) \\\\\n  &+h\\,S\\,z\\left(2\\right)\\,z\\left(4\\right)\\,z\\left(3\\right)+h\\,S\\,z\\left(1\\right)\\,z\\left(2\\right)\\,z… [latex truncated: 1966 chars total]",
