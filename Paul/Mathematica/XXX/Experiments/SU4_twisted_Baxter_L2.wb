      {
       "data": "Out[203]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{f1}\\to \\left\\{\\mathrm{pv}\\left(\\mathrm{qc}\\left(2,1\\right),1\\right),\\mathrm{pv}\\left(\\mathrm{qc}\\left(3,1\\right),1\\right),\\mathrm{pv}\\left(\\mathrm{qc}\\left(3,2\\right),1\\right),\\mathrm{pv}\\left(\\mathrm{qc}\\left(4,1\\right),1\\right),\\mathrm{pv}\\left(\\mathrm{qc}\\left(4,3\\right),1\\right),\\mathrm{pv}\\left(\\mathrm{qc}\\left(4,4\\right),1\\right),\\mathrm{pv}\\left(\\mathrm{tc}\\left(1\\right),1\\right),\\mathrm{pv}\\left(\\mathrm{tc}\\left(2\\right),1\\right)\\right\\} \\\\\n  &,\\text{\\#e2}\\to 35,\\text{order1 residual}\\to \\left\\{0\\right\\} \\\\\n  &,\\text{degree in f1}\\to 2,\\text{degree in u2}\\to 1\\rvert\\!\\rangle\n\\end{aligned}",
       "mime": "text/plain"
      }
     ],
