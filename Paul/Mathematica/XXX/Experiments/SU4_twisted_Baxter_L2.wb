   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* TwistedSolve[S,P,μ,sub] : solve the twisted TQ equation for the five transfer-matrix\n   coefficients tc[1..5] and the four monic Q-polynomials q_1..q_4.\n     sub  = substitution list for the parameters (θ1,θ2,h,z[j]); {} keeps everything symbolic.\n   Returns a list of associations, one per solution (= per state of weight μ):\n     \"tc\" -> {tc1..tc5}, \"q\" -> {ascending coeff lists of q_1..q_4}, \"M\" -> {M_1..M_4}. *)\nClearAll[TwistedSolve];\nTwistedSolve::negdeg = \"μ=`1` gives a negative degree M=`2` at (S,P)=(`3`,`4`).\";\nTwistedSolve::nosol = \"No solution for μ=`1` at (S,P)=(`2`,`3`).\";\nTwistedSolve[S_, P_, μ_List, sub_: {}] := Module[{Ms, x, eqs = {}, unk, sols, R},\n   Ms = Mdeg[S, P, μ];\n   If[! VectorQ[Ms, IntegerQ] || Min[Ms] < 0, Message[TwistedSolve::negdeg, μ, Ms, S, P]; Return[$Failed]];\n   Do[R = Expand[(BaxRes[S, P, μ][k][qmonic[k, Ms[[k]]]][x]) /. sub];\n      eqs = Join[eqs, DeleteCases[CoefficientList[R, x], 0]], {k, 4}];\n   unk = Join[tcvars, Flatten[Table[qc[k, j], {k, 4}, {j, 0, Ms[[k]] - 1}]]];\n   sols = Solve[Thread[eqs == 0], unk];\n   If[sols === {}, Message[TwistedSolve::nosol, μ, S, P]; Return[{}]];\n   Table[<|\"M\" -> Ms, \"tc\" -> (tcvars /. s),\n           \"q\" -> Table[PadRight[CoefficientList[qmonic[k, Ms[[k]]][x] /. s, x], Ms[[k]] + 1], {k, 4}]|>,\n         {s, sols}]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Polynomial from an ascending coefficient list. The x-substitution avoids 0^0 if ever called\n   at a numeric 0. *)\nClearAll[qpoly];\nqpoly[clist_List, uu_] := Module[{x}, (clist . x^Range[0, Length[clist] - 1]) /. x -> uu];\n\n(* Residual check: substitute a returned solution back into the Baxter residual for all four\n   branches and count coefficients that are not exactly 0. 0 = pass.\n   NB on rigour: for the vacuum states of Section 5 the solution is RATIONAL, so Expand[Together]\n   collapses the residual to a literal 0 and this is an exact statement. In higher weight sectors\n   the Q-coefficients are algebraic (Root objects); there Simplify may leave a nonzero-looking\n   but actually-zero radical, and RootReduce, while exact, is far too slow to sweep with. *)\nClearAll[verifyTwisted];\nverifyTwisted[S_, P_, μ_, rec_, sub_: {}] := Module[{x, res},\n   Total@Table[\n     res = Expand[Together[\n        (BaxRes[S, P, μ][k][Function[y, qpoly[rec[\"q\"][[k]], y]]][x] /. Thread[tcvars -> rec[\"tc\"]]) /. sub]];\n     Count[CoefficientList[res, x], c_ /; Simplify[c] =!= 0], {k, 4}]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Test parameters: exact rationals, four distinct twists. *)\nnum = {θ1 -> 1/3, θ2 -> 1/7, h -> 1, z[1] -> 2, z[2] -> 3, z[3] -> 5, z[4] -> 7};\n\n(* Pseudovacuum cross-check: the solver must reproduce the exactly-known τvac coefficients. *)\nModule[{SS = 1, PP = 1, μtop = {2, 2, 0, 0}, recs, x, tcExact},\n  recs = TwistedSolve[SS, PP, μtop, num];\n  tcExact = tcvars /. First@Solve[\n     Thread[Flatten[CoefficientList[Table[Expand[(τ[a][SS, PP, μtop][x] - τvac[SS, PP][a][x]) /. num], {a, 3}], x]] == 0], tcvars];\n  {\"#solutions\" -> Length[recs],\n   \"tc from solver\" -> recs[[1]][\"tc\"],\n   \"tc from τvac\" -> tcExact,\n   \"difference\" -> Simplify[recs[[1]][\"tc\"] - tcExact],\n   \"residual\" -> verifyTwisted[SS, PP, μtop, recs[[1]], num]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
