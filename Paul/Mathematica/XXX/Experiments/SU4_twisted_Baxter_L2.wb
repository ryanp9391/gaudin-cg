      {
       "data": "Out[258]= \\begin{aligned}\n  &\\langle\\!\\lvert \\text{M}\\to \\left\\{0,0,2,2\\right\\},\\text{q0}\\to \\left\\{1\\right\\},\\text{\\#eqs}\\to 60,\\text{\\#unk}\\to 18,\\text{\\#sol}\\to 1 \\\\\n  &,\\text{free}\\to \\\\\n  &\\left\\{\\mathrm{pcn}\\left(3,1,1\\right),\\mathrm{pcn}\\left(3,1,2\\right),\\mathrm{pcn}\\left(4,1,1\\right) \\right. \\\\\n  &\\left. ,\\mathrm{pcn}\\left(4,1,2\\right),\\mathrm{tcn}\\left(1,2\\right),\\mathrm{tcn}\\left(5,2\\right)\\right\\}\\rvert\\!\\rangle\n\\end{aligned}",
