      {
       "data": "Out[51]= \\begin{aligned}\n  &\\left\\{\\left\\{z\\left(1\\right)\\to 1+\\mathrm{i}\\,\\mathrm{eps},z\\left(2\\right)\\to 1+\\frac{\\mathrm{i}\\,\\mathrm{eps}}{3},z\\left(3\\right) \\right. \\right. \\\\\n  &\\left. \\left. \\to 1+\\frac{\\mathrm{i}\\,\\mathrm{eps}}{5},z\\left(4\\right)\\to 1+\\frac{\\mathrm{i}\\,\\mathrm{eps}}{7}\\right\\},x^4\\,\\mathrm{qc}\\left(3,4\\right) \\right. \\\\\n  &\\left. +x^3\\,\\mathrm{qc}\\left(3,3\\right)+x^2\\,\\mathrm{qc}\\left(3,2\\right)+x\\,\\mathrm{qc}\\left(3,1\\right)+1\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
