       "data": "Out[61]= \\begin{array}{|c|c|c|c|c|c|}\\hline & \\text{tc1} & \\text{tc2} & \\text{tc3} & \\text{tc4} & \\text{tc5}\\\\\\hline\\text{branch 1} & \\frac{22}{7} & \\frac{7214}{147} & -\\frac{4472}{147} & \\frac{3812}{441} & \\frac{274}{21}\\\\\\hline\\text{branch 2} & \\frac{8}{7} & \\frac{6626}{147} & -\\frac{3016}{147} & -\\frac{640}{441} & \\frac{232}{21}\\\\\\hline\\text{branch 3} & \\frac{1}{21}\\,\\left(21\\,\\mathrm{pv}\\left(\\mathrm{tc}\\left(5\\right),0\\right)-208\\right) & \\frac{2}{49}\\,\\left(49\\,\\mathrm{pv}\\left(\\mathrm{tc}\\left(5\\right),0\\right)+563\\right) & -\\frac{104}{441}\\,\\left(21\\,\\mathrm{pv}\\left(\\mathrm{tc}\\left(5\\right),0\\right)-145\\right) & \\frac{2}{441}\\,\\left(1113\\,\\mathrm{pv}\\left(\\mathrm{tc}\\left(5\\right),0\\right)-12616\\right) & \\mathrm{pv}\\left(\\mathrm{tc}\\left(5\\right),0\\right)\\\\\\hline\\text{branch 4} & \\frac{-441\\,\\mathrm{pv}\\left(\\mathrm{tc}\\left(3\\right),0\\right)-210\\,\\mathrm{pv}\\left(\\mathrm{tc}\\left(5\\right),0\\right)-4472}{1974} & \\frac{-3087\\,\\mathrm{pv}\\left(\\mathrm{tc}\\left(3\\right),0\\right)+12348\\,\\mathrm{pv}\\left(\\mathrm{tc}\\left(5\\right),0\\right)+423092}{13818} & \\mathrm{pv}\\left(\\mathrm{tc}\\left(3\\right),0\\right) & \\frac{-46305\\,\\mathrm{pv}\\left(\\mathrm{tc}\\left(3\\right),0\\right)-20076\\,\\math… [latex truncated: 1461 chars total]",
