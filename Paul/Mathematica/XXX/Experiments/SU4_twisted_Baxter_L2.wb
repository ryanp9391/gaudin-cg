      {
       "data": "Solve::svars: Equations may not give solutions for all \"solve\" variables.",
       "mime": "text/plain"
      },
      {
       "data": "{\n\t\"name\": \"WolframKernelMessage\",\n\t\"message\": \"Solve::svars: Equations may not give solutions for all \\\"solve\\\" variables.\",\n\t\"stack\": \"\"\n}",
       "mime": "application/vnd.code.notebook.error"
      }
     ],
     "id": "5b92a4a2-a6b7-4487-a50f-4a472bc3e15d"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Residual validation. Rebuild the four Q-polynomials from the solution and substitute back\n   into each branch's Baxter equation; report, per branch, the eps-orders at which the residual\n   vanishes identically in u.\n   NB: test the coefficient against 0 directly -- CoefficientList[0, x] returns {}, not {0}, so\n   a Union[...] === {0} test silently rejects exactly the orders that DID vanish. *)\nClearAll[residualOrders];\nresidualOrders[st_, SS_, PP_, μ_, N_, x_] := Module[{Mk, q0, pcser, tcser, pfun, R},\n   Mk = Mdeg[SS, PP, μ]; q0 = st[\"q0\"];\n   pcser[k_, j_] := (If[j <= Length[q0] - 1, q0[[j + 1]], 0] + Sum[eps^n pcn[k, j, n], {n, N}]) /. First[st[\"sol\"]];\n   tcser = Table[tc[i] -> (((tc0U[μ, SS, PP][[i]] /. th) + Sum[eps^n tcn[i, n], {n, N}]) /. First[st[\"sol\"]]), {i, 5}];\n   pfun[k_] := Function[y, Evaluate[1 + Sum[pcser[k, j] y^j, {j, Mk[[k]]}]]];\n   Table[R = Expand[((BaxRes[SS, PP, μ][k][pfun[k]][x] /. th) /. zser[N]) /. tcser];\n     Select[Range[0, N], Simplify[Coefficient[R, eps, #]] === 0 &], {k, 4}]];\n\nresX = residualOrders[jointX, 2, 2, {4, 3, 1, 0}, 6, uu];\ntauOrd = Max[Select[Range[6], FreeQ[Table[tcn[i, #], {i, 5}] /. First[jointX[\"sol\"]], tcn[_, _]] &]];\n{\"free parameters\" -> jointX[\"free\"],\n \"eps-orders where each branch residual vanishes\" -> resX,\n \"tau fully determined through order\" -> tauOrd}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"961315\" data-output-id=\"47\" data-out-n=\"281\" data-sub-idx=\"5\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"75\" data-sub-start=\"16\" data-sub-end=\"18\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[281]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"26\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:12.6em;vertical-align:-6.05em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.55em;\"><span style=\"top:-10.36em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"mord\"></span></span><span style=\"top:-8.86em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"mord\"></span></span><span style=\"top:-7.36em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"mord\"></span></span><span style=\"top:-5.86em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"mord\"></span></span><span style=\"top:-2.55em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"mord\"></span></span><span style=\"top:0.74em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.05em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.55em;\"><span style=\"top