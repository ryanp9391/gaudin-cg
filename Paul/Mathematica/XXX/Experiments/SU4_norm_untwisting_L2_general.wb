      {
       "data": "Out[48]= \\begin{aligned}\n  &\\left\\{-0.000140434837967195+0.\\times 10^{-19}\\,\\mathrm{i} \\right. \\\\\n  &\\left. ,-0.0274316528219221+0.\\times 10^{-17}\\,\\mathrm{i}\\right\\}\n\\end{aligned}",
