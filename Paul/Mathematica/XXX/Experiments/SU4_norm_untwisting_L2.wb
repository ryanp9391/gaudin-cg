ttp://www.w3.org/2000/svg\" width=\"0.8889em\" height=\"18.316em\" style=\"width:0.8889em\" viewBox=\"0 0 888.89 18316\" preserveAspectRatio=\"xMinYMin\"><path d=\"M384 0 H504 V18316 H384z M384 0 H504 V18316 H384z\"/></svg></span></span><span style=\"top:-20.316em;\"><span class=\"pstrut\" style=\"height:20.316em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎬</span></span></span><span style=\"top:-21.458em;\"><span class=\"pstrut\" style=\"height:20.316em;\"></span><span style=\"height:18.316em;width:0.8889em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.8889em\" height=\"18.316em\" style=\"width:0.8889em\" viewBox=\"0 0 888.89 18316\" preserveAspectRatio=\"xMinYMin\"><path d=\"M384 0 H504 V18316 H384z M384 0 H504 V18316 H384z\"/></svg></span></span><span style=\"top:-39.766em;\"><span class=\"pstrut\" style=\"height:20.316em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎫</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:19.85em;\"><span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:20.8822em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
