      {
       "data": "Out[43]= \\left\\{\\left\\{8,8\\right\\},-\\frac{\\mathrm{i}-\\mathrm{i}\\,\\mathrm{e}^{-\\mathrm{i}\\,\\left(ph1-ph2\\right)}}{1+\\mathrm{e}^{\\mathrm{i}\\,ph2}},\\frac{\\mathrm{i}\\,\\left(\\mathrm{e}^{\\mathrm{i}\\,ph1}-\\mathrm{e}^{\\mathrm{i}\\,ph2}\\right)}{1+\\mathrm{e}^{\\mathrm{i}\\,ph2}}\\right\\}",
