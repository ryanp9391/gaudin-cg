      {
       "data": "Out[26]= \\begin{aligned}\n  &\\left\\{2,\\left\\{0,1,1,2\\right\\} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}1 & u-\\frac{\\mathrm{i}\\,\\left(\\mathrm{zz}\\left(1\\right)-\\mathrm{zz}\\left(2\\right)^2\\right)}{\\left(\\mathrm{zz}\\left(1\\right)-\\mathrm{zz}\\left(2\\right)\\right)\\,\\left(\\mathrm{zz}\\left(2\\right)-1\\right)} & u+\\frac{\\mathrm{i}\\,\\left(\\mathrm{zz}\\left(1\\right)\\,\\mathrm{zz}\\left(2\\right)^2-1\\right)}{\\left(\\mathrm{zz}\\left(2\\right)-1\\right)\\,\\left(\\mathrm{zz}\\left(1\\right)\\,\\mathrm{zz}\\left(2\\right)-1\\right)} & -\\frac{\\textcolor{gray}{\\left[\\textcolor{black}{\\begin{gathered}\n  -u^2\\,{\\left(\\mathrm{zz}\\left(1\\right)^2-1\\right)}^2\\,\\left(\\mathrm{zz}\\left(2\\right)\\,\\mathrm{zz}\\left(1\\right)^2 \\right. \\\\\n  \\left. -\\left(\\mathrm{zz}\\left(2\\right)^2+1\\right)\\,\\mathrm{zz}\\left(1\\right)+\\mathrm{zz}\\left(2\\right)\\right) \\\\\n  -\\mathrm{i}\\,u\\,\\left(\\mathrm{zz}\\left(1\\right)^2-1\\right)\\,\\left(2\\,\\mathrm{zz}\\left(2\\right)\\,\\mathrm{zz}\\left(1\\right)^4 \\right. \\\\\n  \\left. -\\left(\\mathrm{zz}\\left(2\\right)^2+1\\right)\\,\\mathrm{zz}\\left(1\\right)^3 \\right. \\\\\n  \\left. -\\left(\\mathrm{zz}\\left(2\\right)^2+1\\right)\\,\\mathrm{zz}\\left(1\\right)+2\\,\\mathrm{zz}\\left(2\\right)\\right) \\\\\n  +\\mathrm{zz}\\left(2\\right)\\,\\mathrm{zz}\\left(1… [latex truncated: 3687 chars total]",
