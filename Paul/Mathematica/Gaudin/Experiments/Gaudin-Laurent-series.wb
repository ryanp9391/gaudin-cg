  {
   "kind": 1,
   "value": "## E1/E2 (copied from W4): exact HW kets of V(x)V, untwisted Laurent data `lauData`, universal copies `branchData`",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* helper: write long results to a scratch file (the tool channel truncates long messages) *)\nscr = \"C:/Users/pryan/AppData/Local/Temp/claude/c--Users-pryan-git-projects-gaudin-cg/a13cc9a6-6bae-4dcb-abfb-547940cad2b5/scratchpad/\";\ndump[x_] := Export[scr <> \"dump.txt\", StringRiffle[If[ListQ[x], ToString[#, InputForm, PageWidth -> Infinity] & /@ x, {ToString[x, InputForm, PageWidth -> Infinity]}], \"\\n\"], \"Text\"];\nrefDir = \"C:/Users/pryan/git-projects/gaudin-cg/Paul/Mathematica/Gaudin/ref/\";\n(* HW vectors = common null space of the total simple raising operators E12, E23 on each total-weight sector, RowReduce canonical basis (first nonzero component positive), scaled to primitive integers; G2 = G(x)G invariant inner product *)\nck = <||>;\nsecOf[Lam_, mu_] := secOf[Lam, mu] = Flatten[Position[build[Lam][\"wtB\"], mu]];\nraiseM[Lam_] := raiseM[Lam] = With[{R = build[Lam]}, Join[R[\"E1\"][[1, 2]] + R[\"E2\"][[1, 2]], R[\"E1\"][[2, 3]] + R[\"E2\"][[2, 3]]]];\nprim[v_] := With[{w = LCM @@ Denominator[v] v}, w/GCD @@ w];\nhwK[Lam_, mu_] := hwK[Lam, mu] = With[{sec = secOf[Lam, mu]}, With[{ns = NullSpace[Normal[raiseM[Lam][[All, sec]]]]}, If[ns === {}, {}, prim /@ RowReduce[ns]]]];\nembed[Lam_, mu_, v_] := Normal[SparseArray[Thread[secOf[Lam, mu] -> v], build[Lam][\"d2\"]]];\nhwSecsOf[Lam_] := hwSecsOf[Lam] = Select[Reverse[Sort[Union[build[Lam][\"wtB\"]]]], Length[hwK[Lam, #]] > 0 &];\ngNorm2[Lam_, v_] := Total[build[Lam][\"gd2\"] v^2];\ngGram[Lam_, mu_] := With[{H = embed[Lam, mu, #] & /@ hwK[Lam, mu], g = build[Lam][\"gd2\"]}, Table[Total[g a b], {a, H}, {b, H}]];\nweylDim[mu_] := (mu[[1]] - mu[[2]] + 1) (mu[[2]] - mu[[3]] + 1) (mu[[1]] - mu[[3]] + 2)/2;\ncgSlice[Lam_, vfull_] := With[{d1 = build[Lam][\"d1\"]}, Table[vfull[[(nu - 1) d1 + 1]], {nu, d1}]];\nDo[Module[{R = build[Lam], secs, mults},\n  secs = hwSecsOf[Lam]; mults = Length[hwK[Lam, #]] & /@ secs;\n  ck[{Lam, \"HW kets annihilated by E12tot, E23tot\"}] = And @@ Flatten[Table[Normal[raiseM[Lam] . embed[Lam, mu, v]] === ConstantArray[0, 2 R[\"d2\"]], {mu, secs}, {v, hwK[Lam, mu]}]];\n  ck[{Lam, \"Sum mult*dim(mu) = d^2\"}] = Total[mults weylDim /@ secs] == R[\"d2\"];\n  ck[{Lam, \"sectors, mults\"}] = {secs, mults}], {Lam, repList}];\n(* E2: untwisted (g = 0) Laurent data applied to the exact HW kets: exact Laurent fit from rational u samples, verified at spare samples *)\nuSam = {7/13, -2/9, 5/11, 1/3, -4/5, 6/7, 7/3, 9/5, -3/2};\nbas2[ths_, u_] := {1, 1/(u - ths[[1]]), 1/(u - ths[[1]])^2, 1/(u - ths[[2]]), 1/(u - ths[[2]])^2};\nbas3[ths_, u_] := {1, 1/(u - ths[[1]]), 1/(u - ths[[1]])^2, 1/(u - ths[[1]])^3, 1/(u - ths[[2]]), 1/(u - ths[[2]])^2, 1/(u - ths[[2]])^3};\nlApply[R_, sym_, g_, ths_, u_, X_] := Module[{i = sym[[1]], j = sym[[2]], a, b},\n  a = R[\"E1\"][[i, j]] . X; b = R[\"E2\"][[i, j]] . X;\n  Switch[Head[sym], l, g[[i, j]] X + a/(u - ths[[1]]) + b/(u - ths[[2]]), lp, -a/(u - ths[[1]])^2 - b/(u - ths[[2]])^2, lpp, 2 a/(u - ths[[1]])^3 + 2 b/(u - ths[[2]])^3]];\nskApply[R_, 2, g_, ths_, u_, X_] := Total[Table[t[[1]] Fold[lApply[R, #2, g, ths, u, #1] &, X, Reverse[t[[2]]]], {t, Ssym2}]];\nskApply[R_, 3, g_, ths_, u_, X_] := Total[Table[t[[1]] Fold[lApply[R, #2, g, ths, u, #1] &, X, Reverse[t[[2]]]], {t, Ssym3}]];\nfitL[R_, kk_, bas_, g_, ths_, X_] := Module[{nb = Length[bas[ths, uSym]], pts, Ainv, vals, cs, resid},\n  pts = Take[uSam, nb]; Ainv = Inverse[Table[bas[ths, p], {p, pts}]];\n  vals = Table[skApply[R, kk, g, ths, p, X], {p, pts}];\n  cs = Table[Sum[Ainv[[j, k]] vals[[k]], {k, nb}], {j, nb}];\n  resid = Table[Total[Table[bas[ths, p][[j]] cs[[j]], {j, nb}]] - skApply[R, kk, g, ths, p, X], {p, Drop[uSam, nb]}];\n  {cs, resid}];\nlaurentX[R_, g_, ths_, X_] := Module[{f2 = fitL[R, 2, bas2, g, ths, X], f3 = fitL[R, 3, bas3, g, ths, X]},\n  <|\"S2inf\" -> f2[[1, 1]], \"H\" -> {f2[[1, 2]], f2[[1, 4]]}, \"c2\" -> {f2[[1, 3]], f2[[1, 5]]}, \"S3inf\" -> f3[[1, 1]], \"b\" -> {f3[[1, 2]], f3[[1, 5]]}, \"a\" -> {f3[[1, 3]], f3[[1, 6]]}, \"tri\" -> {f3[[1, 4]], f3[[1, 7]]},\n   \"resid\" -> Join[f2[[2]], f3[[2]]]|>];\nhwBlock[Lam_, mu_] := Transpose[embed[Lam, mu, #] & /@ hwK[Lam, mu]];\ntoHW[Lam_, mu_, X_] := Module[{sec = secOf[Lam, mu], Hs = Transpose[hwK[Lam, mu]], Xs, M},\n  Xs = X[[sec]]; M = LinearSolve[Hs, Xs];\n  {M, Hs . M === Xs && Union[Flatten[Delete[X, List /@ sec]]] === {0}}];\ncasX[R_, 2, X_] := Total[Table[(R[\"E1\"][[i, k]] + R[\"E2\"][[i, k]]) . ((R[\"E1\"][[k, i]] + R[\"E2\"][[k, i]]) . X), {i, 3}, {k, 3}], 2];\ncasX[R_, 3, X_] := Total[Table[(R[\"E1\"][[i, j]] + R[\"E2\"][[i, j]]) . ((R[\"E1\"][[j, k]] + R[\"E2\"][[j, k]]) . ((R[\"E1\"][[k, i]] + R[\"E2\"][[k, i]]) . X)), {i, 3}, {j, 3}, {k, 3}], 3];\ncas1[R_, 2] := With[{E = R[\"Ee\"], e = UnitVector[R[\"d1\"], 1]}, Total[Table[E[[i, k]] . (E[[k, i]] . e), {i, 3}, {k, 3}], 2][[1]]];\ncas1[R_, 3] := With[{E = R[\"Ee\"], e = UnitVector[R[\"d1\"], 1]}, Total[Table[E[[i, j]] . (E[[j, k]] . (E[[k, i]] . e)), {i, 3}, {j, 3}, {k, 3}], 3][[1]]];\nthPts = {{2/7, -3/5}, {1, 0}, {3/7, -1/4}};\nlauData = <||>;\nDo[Module[{R = build[Lam], c1, okInv = True, okScal = True, okFit = True, okTri = True, okC2 = True, okEta = True, okCas = True, okS2inf = True, lamT = Total[Lam]},\n  c1 = {cas1[R, 2], cas1[R, 3]};\n  Do[Module[{Hb = hwBlock[Lam, mu], m = Length[hwK[Lam, mu]], per = {}, cs2, cs3, cas},\n    cs2 = toHW[Lam, mu, casX[R, 2, Hb]]; cs3 = toHW[Lam, mu, casX[R, 3, Hb]];\n    okCas = okCas && cs2[[2]] && cs3[[2]] && cs2[[1]] === cs2[[1, 1, 1]] IdentityMatrix[m] && cs3[[1]] === cs3[[1, 1, 1]] IdentityMatrix[m];\n    cas = {cs2[[1, 1, 1]], cs3[[1, 1, 1]]};\n    Do[Module[{ths = thPts[[ip]], LD, th12, conv},\n      th12 = ths[[1]] - ths[[2]];\n      LD = laurentX[R, ConstantArray[0, {3, 3}], ths, Hb];\n      okFit = okFit && (Union[Flatten[LD[\"resid\"]]] === {0});\n      conv = Association[Table[key -> If[ListQ[LD[key]] && Length[LD[key]] == 2, toHW[Lam, mu, #] & /@ LD[key], toHW[Lam, mu, LD[key]]], {key, {\"S2inf\", \"H\", \"c2\", \"S3inf\", \"b\", \"a\", \"tri\"}}]];\n      okInv = okInv && And @@ Flatten[{conv[\"S2inf\"][[2]], conv[\"S3inf\"][[2]], conv[#][[All, 2]] & /@ {\"H\", \"c2\", \"b\", \"a\", \"tri\"}}];\n      okS2inf = okS2inf && conv[\"S2inf\"][[1]] === ConstantArray[0, {m, m}] && conv[\"S3inf\"][[1]] === ConstantArray[0, {m, m}];\n      okTri = okTri && (And @@ (#[[1]] === ConstantArray[0, {m, m}] & /@ conv[\"tri\"]));\n      okC2 = okC2 && (And @@ (#[[1]] === Lam[[2]] (Lam[[1]] + 1) IdentityMatrix[m] & /@ conv[\"c2\"]));\n      AppendTo[per, <|\"th\" -> ths, \"eta\" -> (conv[\"H\"][[All, 1]] th12), \"A\" -> (conv[\"a\"][[All, 1]] th12), \"B\" -> (conv[\"b\"][[All, 1]] th12^2)|>]], {ip, 3}];\n    okScal = okScal && (per[[1, \"eta\"]] === per[[2, \"eta\"]] === per[[3, \"eta\"]]) && (per[[1, \"A\"]] === per[[2, \"A\"]] === per[[3, \"A\"]]) && (per[[1, \"B\"]] === per[[2, \"B\"]] === per[[3, \"B\"]]);\n    okEta = okEta && (per[[1, \"eta\"]][[1]] === (lamT^2 - (cas[[1]] - 2 c1[[1]])/2) IdentityMatrix[m]) && (per[[1, \"eta\"]][[2]] === -per[[1, \"eta\"]][[1]]);\n    lauData[{Lam, mu}] = <|\"mult\" -> m, \"cas2\" -> cas[[1]], \"cas3\" -> cas[[2]], \"eta\" -> per[[1, \"eta\"]], \"A\" -> per[[1, \"A\"]], \"B\" -> per[[1, \"B\"]]|>], {mu, hwSecsOf[Lam]}];\n  ck[{Lam, \"(i) fits exact (ii) HW space invariant (iii) S2inf=S3inf=0 (iv) no triple pole (v) c2 scalar = lam2(lam1+1) (vi) Casimirs scalar\"}] = {okFit, okInv, okS2inf, okTri, okC2, okCas};\n  ck[{Lam, \"theta12 scaling of eta, A, B at 3 theta points\"}] = okScal;\n  ck[{Lam, \"H1 = (|Lam|^2 - (cas2(mu) - 2 cas2(Lam))/2)/theta12, H2 = -H1\"}] = okEta], {Lam, repList}];\n(* universal copies in multiplicity-2 sectors: eigenvectors of A1 = theta12 a_1 on the HW space, in Q(Sqrt[D0]); copy 1 = smaller alpha_1 *)\nsqfreeSplit[x_] := Module[{n = Numerator[x] Denominator[x], f, sq, kk}, f = FactorInteger[n]; sq = Times @@ (#[[1]]^Mod[#[[2]], 2] & /@ f); kk = Sqrt[n/sq]; {sq, kk/Denominator[x]}];\nqval[x0_, x1_, lam_] := {x0 + x1 lam[[1]], x1 lam[[2]]};\nbranchData[Lam_, mu_] := branchData[Lam, mu] = Module[{R = build[Lam], ld = lauData[{Lam, mu}], m, kets},\n  m = ld[\"mult\"]; kets = embed[Lam, mu, #] & /@ hwK[Lam, mu];\n  If[m == 1,\n   {<|\"copy\" -> 1, \"D0\" -> 0, \"vA\" -> kets[[1]], \"vB\" -> ConstantArray[0, R[\"d2\"]], \"gn\" -> {gNorm2[Lam, kets[[1]]], 0},\n     \"eta\" -> {{ld[\"eta\"][[1, 1, 1]], 0}, {ld[\"eta\"][[2, 1, 1]], 0}}, \"alpha\" -> {{ld[\"A\"][[1, 1, 1]], 0}, {ld[\"A\"][[2, 1, 1]], 0}}, \"beta\" -> {{ld[\"B\"][[1, 1, 1]], 0}, {ld[\"B\"][[2, 1, 1]], 0}}|>},\n   Module[{A1 = ld[\"A\"][[1]], trA, detA, disc, f, D0, lams},\n    trA = Tr[A1]; detA = Det[A1]; disc = trA^2 - 4 detA; {D0, f} = sqfreeSplit[disc];\n    lams = {{trA/2, -f/2}, {trA/2, f/2}};\n    Table[Module[{lam = lams[[ic]], cA, cB, vA, vB, num, sgn, x1, ev, c2n},\n      cA = {A1[[1, 2]], lam[[1]] - A1[[1, 1]]}; cB = {0, lam[[2]]};\n      c2n = LCM @@ Denominator[Join[cA, cB]]; cA = c2n cA; cB = c2n cB;\n      vA = cA . kets; vB = cB . kets;\n      num = N[vA + Sqrt[D0] vB, 30]; sgn = Sign[First[Select[num, Abs[#] > 10^-20 &]]];\n      vA = sgn vA; vB = sgn vB;\n      x1[X_] := X[[1, 2]]/A1[[1, 2]];\n      ev[X_] := qval[X[[1, 1]] - x1[X] A1[[1, 1]], x1[X], lam];\n      <|\"copy\" -> ic, \"D0\" -> D0, \"vA\" -> vA, \"vB\" -> vB, \"gn\" -> {Total[R[\"gd2\"] (vA^2 + D0 vB^2)], Total[R[\"gd2\"] 2 vA vB]},\n        \"eta\" -> {{ld[\"eta\"][[1, 1, 1]], 0}, {ld[\"eta\"][[2, 1, 1]], 0}}, \"alpha\" -> {ev[ld[\"A\"][[1]]], ev[ld[\"A\"][[2]]]}, \"beta\" -> {ev[ld[\"B\"][[1]]], ev[ld[\"B\"][[2]]]},\n        \"lam\" -> lam|>], {ic, 2}]]]];\nGrid[List @@@ Normal[ck] /. {a_, b_} :> {a, b}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"953927\" data-output-id=\"1\" data-out-n=\"57\" data-sub-idx=\"39\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"5\" data-sub-start=\"93\" data-sub-end=\"93\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[57]=</span></div><div class=\"wl-output-content\"><pre class=\"vscode-wolfram-text-output\">No output at Out[57]</pre></div></div>",
       "mime": "x-application/wolfram-language-html"
