  {
   "kind": 1,
   "value": "## B3: exact eps-series of every HW-limit branch of [2,1,0] (calibration), [3,1,0], [3,2,0]; rule checks",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* runBranchT: W4's runBranch generalised (any rep, any theta). zeta = eps*phi. Returns the Laurent-data series of H1,H2,a1,a2,b1,b2 (lists over orders 0..nMax, entries in Q or Q(sq), sq^2 = D0), the series state psi_n, G-norm series, eigen-equation flags. *)\nrunBranchT[Lam_, mu_, ic_, phi_, nMax_, thArg_] := Block[{thN = thArg, th12 = thArg[[1]] - thArg[[2]]}, Module[{ops = opPolyOfT[Lam, mu, thArg], sec = secOf[Lam, mu], bd = branchData[Lam, mu][[ic]], R = build[Lam], psi0, lam0, Aks, rs, ser = <||>, flags = {}, gsec, gnorm},\n  dD = bd[\"D0\"];\n  psi0 = bd[\"vA\"][[sec]] + If[dD === 0, 0, sq] bd[\"vB\"][[sec]];\n  lam0 = (bd[\"eta\"][[1, 1]] + rhoI (bd[\"alpha\"][[1, 1]] + sq bd[\"alpha\"][[1, 2]]))/th12;\n  Aks = trimOps[opSeries[ops, \"H1\", phi, 3] + rhoI opSeries[ops, \"a1\", phi, 3]];\n  rs = rsSolve[Aks, psi0, lam0, nMax];\n  Do[With[{r = laurSeries[trimOps[opSeries[ops, nm, phi, 3]], rs[\"psi\"], nMax]}, ser[nm] = r[[1]]; AppendTo[flags, r[[2]]]], {nm, opNames}];\n  gsec = R[\"gd2\"][[sec]];\n  gnorm = Table[rd[Sum[rs[\"psi\"][[k + 1]] . (gsec rs[\"psi\"][[nn - k + 1]]), {k, 0, nn}]], {nn, 0, nMax}];\n  <|\"series\" -> ser, \"psi\" -> rs[\"psi\"], \"lam\" -> rs[\"lam\"], \"gnorm\" -> gnorm, \"eigOK\" -> And @@ flags, \"ev0\" -> (Max[Abs[Flatten[rs[\"ev0\"] /. sq -> 1]]] === 0 || Union[Flatten[rs[\"ev0\"]]] === {0}), \"D0\" -> dD, \"th12\" -> th12, \"sec\" -> sec|>]];\n(* series algebra helpers: a series is the list of coefficients of eps^0..eps^nMax *)\nsPad[l_, n_] := PadRight[l, n + 1, 0];\n(* no-log type relation of site s (the constant relation for the adjoint, [3,1,0]; P4/W3's quadratic D2 relation for [3,2,0]): returns the residual series list *)\nrelRes[Lam_, mu_, phi_, r_, s_, nMax_] := Module[{H = r[\"series\"][\"H\" <> ToString[s]], a = r[\"series\"][\"a\" <> ToString[s]], b = r[\"series\"][\"b\" <> ToString[s]], th = (-1)^(s + 1) r[\"th12\"], sp = Total[phi], e2 = phi[[1]] phi[[2]] + phi[[1]] phi[[3]] + phi[[2]] phi[[3]], wv = phi . mu, c2 = Lam[[2]] (Lam[[1]] + 1), bet, gam, del, Wser, cv},\n  If[Lam =!= {3, 2, 0},\n   cv = serConv[a, H - a, nMax]; Table[rd[b[[n + 1]] - cv[[n + 1]]/c2], {n, 0, nMax}],\n   Wser = sPad[{0, wv}, nMax]; bet = sPad[{78/th, 15 sp}, nMax]; gam = sPad[{-45/(2 th), -9/2 sp}, nMax]; del = sPad[{-504/th^2, -210 sp/th, -18 sp^2 - 3 e2}, nMax];\n   cv = 3 serConv[H, H, nMax] - 7/4 serConv[H, a, nMax] + 1/4 serConv[a, a, nMax] - 3/th Wser - serConv[bet, H, nMax] - serConv[gam, a, nMax] - del;\n   Table[rd[b[[n + 1]] - cv[[n + 1]]], {n, 0, nMax}]]];\nbranchesOf[Lam_] := Flatten[Table[Table[{mu, ic}, {ic, lauData[{Lam, mu}][\"mult\"]}], {mu, hwSecsOf[Lam]}], 1];\nnMaxN = 10;\nresN = <||>; tN = <||>; ckB = <||>;\nDo[Do[Module[{mu = b[[1]], ic = b[[2]], phi = pp[[2]], r, rr, ser, bd, th1 = thN, t12 = th12, okOrd0, okH, okRel, bsum, okScal, rscal, sc, th2 = {1, 0}},\n  tN[{Lam, b, pp[[1]]}] = First@AbsoluteTiming[r = runBranchT[Lam, mu, ic, phi, nMaxN, thN]]; resN[{Lam, b, pp[[1]]}] = r;\n  dD = r[\"D0\"]; ser = r[\"series\"]; bd = branchData[Lam, mu][[ic]];\n  okOrd0 = rd[ser[\"H1\"][[1]] - (bd[\"eta\"][[1, 1]])/th12] === 0 && rd[ser[\"a1\"][[1]] - (bd[\"alpha\"][[1, 1]] + sq bd[\"alpha\"][[1, 2]])/th12] === 0 && rd[ser[\"b1\"][[1]] - (bd[\"beta\"][[1, 1]] + sq bd[\"beta\"][[1, 2]])/th12^2] === 0;\n  okH = Union[rd /@ Table[ser[\"H1\"][[n + 1]] + ser[\"H2\"][[n + 1]] - If[n == 1, Total[phi] Total[mu] - phi . mu, 0], {n, 0, nMaxN}]] === {0};\n  bsum = Table[rd[ser[\"b1\"][[n + 1]] + ser[\"b2\"][[n + 1]]], {n, 0, nMaxN}];\n  okRel = Table[Union[relRes[Lam, mu, phi, r, s, nMaxN]] === {0}, {s, 2}];\n  ckB[{Lam, b, pp[[1]]}] = <|\"eig\" -> {r[\"ev0\"], r[\"eigOK\"]}, \"ord0\" -> okOrd0, \"HsumRule\" -> okH, \"rel\" -> okRel, \"bsum\" -> (bsum /. sq -> Sqrt[dD]), \"bsumRule\" -> (bsum === sPad[{0, 0, phi[[1]] phi[[2]] mu[[3]] + phi[[1]] phi[[3]] mu[[2]] + phi[[2]] phi[[3]] mu[[1]]}, nMaxN])|>], {b, branchesOf[Lam]}, {pp, {{\"A\", phiA}, {\"B\", phiB}}}], {Lam, repList}];\ndump[Join[{N[Values[tN], 3]}, Table[{k[[1]], k[[2]], k[[3]], v[\"eig\"], v[\"ord0\"], v[\"HsumRule\"], v[\"rel\"], v[\"bsumRule\"]}, {k, Keys[ckB]}, {v, {ckB[k]}}]]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"953927\" data-output-id=\"4\" data-out-n=\"101\" data-sub-idx=\"10\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"11\" data-sub-start=\"31\" data-sub-end=\"31\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[101]=</span></div><div class=\"wl-output-content\"><pre class=\"vscode-wolfram-text-output\">No output at Out[101]</pre></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[101]= No output at Out[101]",
       "mime": "text/plain"
      }
     ],
     "id": "228662bc-fee8-4add-92ec-38f37e5aedf1"
    }
   ],
   "metadata": {}
