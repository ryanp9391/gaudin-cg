  {
   "kind": 1,
   "value": "## B3b: x(zeta) covectors, k_B and the leading coefficient X_B of <x(zeta)(x)x(zeta)|Psi_B>, the k_B rule",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "checks = Join[checks, ck]; ck = <||>;\n(* x(zeta) = e1^T P_phys^(G-1) as in W4 E5A: a row vector, polynomial and homogeneous of degree lam2 in zeta; x0^G = x(zeta) (x) x(zeta) *)\nexpE[R_, c_, i_, j_] := Module[{E = Normal[R[\"Ee\"][[i, j]]], nl = R[\"nilp\"]}, IdentityMatrix[R[\"d1\"]] + Sum[c^k MatrixPower[E, k]/k!, {k, 1, nl}]];\nxOfSym[Lam_] := Module[{R = build[Lam], z = {z1, z2, z3}, sv, rv, v, dinv},\n  sv = {z1^2/((z1 - z2) (z1 - z3)), -(z2/(z1 (z2 - z3))), 1/(z1 z2)};\n  rv = {-(z3/z2), -(z3/z1), (z2^2 (z3 - z1))/(z1^2 (z2 - z3))};\n  v = UnitVector[R[\"d1\"], 1] . expE[R, -((z1 + z2)/(z1 z2)), 2, 3];\n  v = v . expE[R, 1/(z1 z2), 1, 3]; v = v . expE[R, -1/z1, 1, 2];\n  dinv = DiagonalMatrix[Table[Product[sv[[k]]^(-J0[k][p]), {k, 3}], {p, ps[{Lam}]}]];\n  v = v . dinv; v = v . expE[R, -rv[[3]], 2, 1]; v = v . expE[R, -rv[[2]], 3, 1]; v = v . expE[R, -rv[[1]], 3, 2];\n  Factor /@ Together /@ v];\nxTab = <||>;\nDo[Module[{xs = xOfSym[Lam], degs},\n  xTab[Lam] = xs;\n  degs = Table[If[xi === 0, {}, Union[{Exponent[xi /. {z1 -> t z1, z2 -> t z2, z3 -> t z3}, t]}]], {xi, xs}];\n  ck[{Lam, \"x(zeta): all components polynomial, homogeneous of degree\"}] = {And @@ (PolynomialQ[#, {z1, z2, z3}] & /@ xs), Union[Flatten[degs]]}], {Lam, repList}];\nxvP[Lam_] := xTab[Lam] /. {z1 -> p1, z2 -> p2, z3 -> p3};\nxxOf[Lam_, phi_] := Flatten[KroneckerProduct[#, #]] &[xTab[Lam] /. Thread[{z1, z2, z3} -> phi]];\nkBrule[Lam_, mu_] := 2 (Lam[[1]] - Lam[[3]]) - (mu[[1]] - mu[[3]]);\nfirstNZ[l_] := Catch[Do[If[l[[i]] =!= 0, Throw[i - 1]], {i, Length[l]}]; None];\nkBres = <||>;\nDo[Module[{b = k[[2]], Lam = k[[1]], pp = k[[3]], r, ph, xx, ov, kB, gn0, sec},\n  r = resN[k]; dD = r[\"D0\"]; ph = If[pp == \"A\", phiA, phiB]; sec = r[\"sec\"];\n  xx = xxOf[Lam, ph]; ov = Table[rd[xx[[sec]] . r[\"psi\"][[n + 1]]], {n, 0, nMaxN}];\n  kB = firstNZ[ov]; gn0 = r[\"gnorm\"][[1]];\n  kBres[k] = <|\"kB\" -> kB, \"lead\" -> pairOf[ov[[kB + 1]]], \"gn0\" -> pairOf[gn0], \"ov\" -> ov, \"D0\" -> dD|>], {k, Keys[ckB]}];\nck[\"k_B at both phi points agree; k_B == 2(l1-l3)-(mu1-mu3) for every branch (rule 'height of 2Lambda - mu')\"] = Table[And @@ Table[kBres[{Lam, b, \"A\"}][\"kB\"] == kBres[{Lam, b, \"B\"}][\"kB\"] == kBrule[Lam, b[[1]]], {b, branchesOf[Lam]}], {Lam, repList}];\nck[\"k_B table (rep -> k_B per branch in order)\"] = Table[Lam -> Table[kBres[{Lam, b, \"A\"}][\"kB\"], {b, branchesOf[Lam]}], {Lam, repList}];\ndump[List @@@ Normal[ck]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"953927\" data-output-id=\"9\" data-out-n=\"163\" data-sub-idx=\"14\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"17\" data-sub-start=\"28\" data-sub-end=\"28\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[163]=</span></div><div class=\"wl-output-content\"><pre class=\"vscode-wolfram-text-output\">No output at Out[163]</pre></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[163]= No output at Out[163]",
       "mime": "text/plain"
      }
     ],
     "id": "69e43f4d-5608-4057-abd8-0865e7a2d517"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## B3b (cont.): symbolic leading coefficient X_B, E5_KB / XVEC / PSI records appended to the data files",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "checks = Join[checks, ck]; ck = <||>;\nleadS = <||>; tL = <||>;\nDo[Module[{Lam = Lam0, b = bb, kB, r, xs, sec},\n  kB = kBres[{Lam, b, \"A\"}][\"kB\"]; sec = secOf[Lam, b[[1]]];\n  tL[{Lam, b}] = First@AbsoluteTiming[r = If[kB <= nSym, resS[{Lam, b}], runBranchT[Lam, b[[1]], b[[2]], pphi, kB, thN]]];\n  dD = r[\"D0\"]; xs = Flatten[KroneckerProduct[xvP[Lam], xvP[Lam]]];\n  leadS[{Lam, b}] = <|\"kB\" -> kB, \"D0\" -> dD, \"lead\" -> cleanSym[rd[xs[[sec]] . r[\"psi\"][[kB + 1]]], dD], \"gn0\" -> rd[r[\"gnorm\"][[1]]], \"lowerZero\" -> (Union[Table[rd[xs[[sec]] . r[\"psi\"][[n + 1]]], {n, 0, kB - 1}]] === {0} || kB == 0)|>;\n  (* check: the symbolic lead reproduces the numeric exact lead at phiA and phiB *)\n  ck[{Lam, b, \"symbolic X_B at phiA, phiB == numeric lead, lower orders zero\"}] = And @@ Flatten[{leadS[{Lam, b}][\"lowerZero\"], Table[rd[(leadS[{Lam, b}][\"lead\"] /. If[dD === 0, {}, {Sqrt[dD] -> sq}]) /. Thread[pphi -> ph[[2]]]] === rd[kBres[{Lam, b, ph[[1]]}][\"lead\"] . {1, sq}], {ph, {{\"A\", phiA}, {\"B\", phiB}}}] /. {True -> True}}]], {Lam0, repList}, {bb, branchesOf[Lam0]}];\ndump[Join[{N[Values[tL], 3]}, List @@@ Normal[ck] /. {a_, b_} :> {ToString[a], b}]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"953927\" data-output-id=\"10\" data-out-n=\"167\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"19\" data-sub-start=\"9\" data-sub-end=\"9\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[167]=</span></div><div class=\"wl-output-content\"><pre class=\"vscode-wolfram-text-output\">No output at Out[167]</pre></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[167]= No output at Out[167]",
       "mime": "text/plain"
      }
     ],
     "id": "18ea3288-fe74-466d-95ff-a27036cfe60b"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "checks = Join[checks, ck]; ck = <||>;\nappendRecords[Lam_] := Module[{fn = refDir <> \"laurent-series-\" <> StringJoin[ToString /@ Lam] <> \".txt\", lines, add, nPsi = 4},\n  lines = Import[fn, \"Text\"]; lines = StringSplit[lines, \"\\n\"];\n  lines = Select[lines, ! StringStartsQ[#, \"E5_KB\"] && ! StringStartsQ[#, \"XVEC\"] && ! StringStartsQ[#, \"PSI\"] && ! StringStartsQ[#, \"GNORM\"] && ! StringStartsQ[#, \"# E5_KB\"] && ! StringStartsQ[#, \"# XVEC\"] && ! StringStartsQ[#, \"# PSI\"] && ! StringStartsQ[#, \"# GNORM\"] &];\n  add[tag_, args__] := AppendTo[lines, StringRiffle[Prepend[fmt /@ {args}, tag], \"\\t\"]];\n  AppendTo[lines, \"# E5_KB mu copy D0 kB lead gnorm0numeric_phiA gnorm0numeric_phiB : <x0^G|Psi_B> = eps^(2*lam2 + kB) lead / Sqrt[gnorm0] + ..., x0^G = x(zeta)(x)x(zeta) (XVEC, homogeneous degree lam2 in zeta); lead = <x(phi)(x)x(phi)|Psi_kB> as an InputForm STRING in symbolic phi = (p1,p2,p3) (Sqrt[D0] only for mult-2 copies), gnorm0 = {p,q} = exact G-norm^2 of Psi_0 (the primitive-integer HW vector of untwisted-exact-*.txt, pair p + q Sqrt[D0]; the series state is normalised by ell.Psi_n = 0, n>=1). kB = 2(l1-l3) - (mu1-mu3) on every branch.\"];\n  AppendTo[lines, \"# E5_KBNUM mu copy D0 phi kB {p,q} : the exact numeric lead at phiA or phiB (pair p + q Sqrt[D0]).\"];\n  AppendTo[lines, \"# XVEC {x_nu(z1,z2,z3)} : the one-site covector x(zeta), nu = GT index in the notebook order, as InputForm strings (polynomial, homogeneous of degree lam2).\"];\n  AppendTo[lines, \"# PSI mu copy D0 phi nPsi secIdx {Psi_0,...,Psi_nPsi} : the series state Psi(eps) = Sum eps^n Psi_n on the weight-mu sector of V(x)V; secIdx = product-basis indices ((i-1)*DIM+j) of the sector, each Psi_n a list of pairs {p,q} (same order as secIdx); Psi_0 = the HW ket of the BRANCH in the sector coordinates, normalisation ell.Psi_n = 0 (n >= 1) with ell the left null vector of H1(0)+a1(0)/7 - lam0. GNORM mu copy D0 phi {pairs} : G-norm^2 series of Psi(eps), orders 0..nPsi.\"];\n  add[\"XVEC\", ToString[InputForm[#]] & /@ xTab[Lam]];\n  Do[Module[{mu = b[[1]], ic = b[[2]], ls = leadS[{Lam, b}]},\n    add[\"E5_KB\", mu, ic, ls[\"D0\"], ls[\"kB\"], ToString[InputForm[ls[\"lead\"]]], pairOf[ls[\"gn0\"]]];\n    Do[Module[{k = {Lam, b, pp[[1]]}, r},\n      r = resN[k]; dD = r[\"D0\"];\n      add[\"E5_KBNUM\", mu, ic, dD, pp[[2]], kBres[k][\"kB\"], kBres[k][\"lead\"]];\n      add[\"PSI\", mu, ic, dD, pp[[2]], nPsi, r[\"sec\"], Table[pairOf /@ r[\"psi\"][[n + 1]], {n, 0, nPsi}]];\n      add[\"GNORM\", mu, ic, dD, pp[[2]], serPairs[r[\"gnorm\"][[1 ;; nPsi + 1]]]]], {pp, {{\"A\", phiA}, {\"B\", phiB}}}]], {b, branchesOf[Lam]}];\n  Export[fn, StringRiffle[lines, \"\\n\"] <> \"\\n\", \"Text\"]; Length[lines]];\ndump[Table[Lam -> appendRecords[Lam], {Lam, repList}]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"953927\" data-output-id=\"11\" data-out-n=\"170\" data-sub-idx=\"2\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"20\" data-sub-start=\"18\" data-sub-end=\"18\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[170]=</span></div><div class=\"wl-output-content\"><pre class=\"vscode-wolfram-text-output\">No output at Out[170]</pre></div></div>",
       "mime": "x-application/wolfram-language-html"
