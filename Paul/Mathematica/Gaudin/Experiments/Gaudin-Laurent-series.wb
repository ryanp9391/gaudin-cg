       "data": "Out[229]= No output at Out[229]",
       "mime": "text/plain"
      }
     ],
     "id": "d0c18704-73cd-4e3d-9b6b-7c5d57b71fe8"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Final checks: chi_B = det(lambda - H1(eps)) on the weight space whenever d = dim; duality of H2, a2; summary table",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "checks = Join[checks, ck]; ck = <||>;\nck[\"chi_B == full char poly det(lambda - H1(eps)) of the weight-mu space (checked at eps = 1/3, 2/7, 5/3, 7/9) for every branch with d = dim; d < dim only for the adjoint singlet\"] = Table[Module[{Lam = kk[[1]], mu = kk[[2, 1]], ph, n, ops, d, ok},\n   ph = If[kk[[3]] == \"A\", phiA, phiB]; ops = opPolyOf[Lam, mu]; n = Length[secOf[Lam, mu]]; d = cycRes[kk][\"d\"]; dD = cycRes[kk][\"D0\"];\n   ok = If[d == n, And @@ Table[Expand[Det[lam IdentityMatrix[n] - opMatE[ops, \"H1\", ph, e]] - (chiExpr[cycRes[kk]] /. eps -> e)] === 0, {e, {1/3, 2/7, 5/3, 7/9}}], \"d<n\"];\n   {kk, n, d, ok}], {kk, Keys[cycRes]}];\nck[\"summary d_B per rep: {mu, copy, d_B, weight-space dim, branch factor degree}\"] = Table[Lam -> Table[{b, cycRes[{Lam, b, \"A\"}][\"d\"], Length[secOf[Lam, b[[1]]]], cycRes[{Lam, b, \"A\"}][\"branchFactorDeg\"], cycRes[{Lam, b, \"A\"}][\"dAlg\"] == cycRes[{Lam, b, \"A\"}][\"d\"], cycRes[{Lam, b, \"A\"}][\"annihilated\"]}, {b, branchesOf[Lam]}], {Lam, repList}];\ndump[List @@@ Normal[ck]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
