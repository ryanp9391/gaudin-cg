  {
   "kind": 2,
   "value": "ClearAll[QHBase,T,U];\nQHBase[T_][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QHBase[T][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]=Table[Hodge[{QBase[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]]},rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,z,T],{U,1,Length[QBase[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]]}];\n\n\n\n(*Q†[T][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAllh†[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,1,1];*)\n\n(*With Hodge*)\n(*Table[Hodge[{QBase[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]],QBase[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][[U]]},rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,z,T],{U,1,Length[QBase[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]]}];*)",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[QVac2,QHVac2,QvQv2,QvQv2ωϕ];\n(*QvQv*)\n(*VACUUM STATES*)\nQVac2[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4]={QBase[1][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QBase[2][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QBase[3][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QBase[4][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]]};\nQHVac2[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QHVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4]={QHBase[1][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QHBase[2][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QHBase[3][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QHBase[4][rep1,rep2,rep1+rep2,ϕ1,ϕ2,ϕ3,ϕ4][[1]]};\n\nQvQv2[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QvQv2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4]=OrthogRen[QHVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],QVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],QHVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],QVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],rep1,rep2];\n\nQvQv2ωϕ[rep1_,rep2_,ω1_,ω2_,ω3_,ω4_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QvQv2ωϕ[rep1,rep2,ω1,ω2,ω3,ω4,ϕ1,ϕ2,ϕ3,ϕ4]=OrthogRen[QHVac2[rep1,rep2,ω1,ω2,ω3,ω4],QVac2[rep1,rep2,ω1,ω2,ω3,ω4],QHVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],QVac2[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4],rep1,rep2];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Matteo one-site implementation\n\nOne-site polynomial and adjoint-Hamiltonian symbols are renamed where Matteo reused two-site names. This removes order-dependent destruction of the two-site solver.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[h1];\nh1[rep1_][1,1]:=h1[rep1][1,1]=rep1[[1]]+rep1[[2]]+rep1[[3]]+rep1[[4]];\nh1[rep1_][2,1]:=h1[rep1][2,1]=rep1〚3〛 (-1+rep1〚4〛)+rep1〚2〛 (-2+rep1〚3〛+rep1〚4〛)+rep1〚1〛 (-3+rep1〚2〛+rep1〚3〛+rep1〚4〛);\nh1[rep1_][3,1]:=h1[rep1][3,1]=rep1〚2〛 (-1+rep1〚3〛) (-2+rep1〚4〛)+rep1〚1〛 ((-2+rep1〚3〛) (-3+rep1〚4〛)+rep1〚2〛 (-4+rep1〚3〛+rep1〚4〛));\nh1[rep1_][4,1]:=h1[rep1][4,1]=rep1〚1〛 (-1+rep1〚2〛) (-2+rep1〚3〛) (-3+rep1〚4〛);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*H1*)\nh1[ϕ1_,ϕ2_,ϕ3_,ϕ4_][1,3]:=h1[ϕ1,ϕ2,ϕ3,ϕ4][1,3]=ϕ1+ϕ2+ϕ3+ϕ4;\n\n(*H2*)\nh1[ϕ1_,ϕ2_,ϕ3_,ϕ4_][2,5]:=h1[ϕ1,ϕ2,ϕ3,ϕ4][2,5]=ϕ1 ϕ2+ϕ1 ϕ3+ϕ2 ϕ3+ϕ1 ϕ4+ϕ2 ϕ4+ϕ3 ϕ4;\n\n(*H3*)\nh1[ϕ1_,ϕ2_,ϕ3_,ϕ4_][3,7]:=h1[ϕ1,ϕ2,ϕ3,ϕ4][3,7]=ϕ1 ϕ2 ϕ3+ϕ1 ϕ2 ϕ4+ϕ1 ϕ3 ϕ4+ϕ2 ϕ3 ϕ4;\n\n(*H4*)\nh1[ϕ1_,ϕ2_,ϕ3_,ϕ4_][4,9]:=h1[ϕ1,ϕ2,ϕ3,ϕ4][4,9]=ϕ1*ϕ2*ϕ3*ϕ4;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*H2*)\nh1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][2,3]:=h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][2,3]=(ϕ2+ϕ3+ϕ4) (weight1[[1]])+(ϕ1+ϕ3+ϕ4) (weight1[[2]])+(ϕ1+ϕ2+ϕ4) (weight1[[3]])+(ϕ1+ϕ2+ϕ3) (weight1[[4]]);\n\n(*H3*)\nh1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][3,5]:=h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][3,5]=ϕ3 ϕ4 (weight1[[1]]+weight1[[2]])+ϕ2 ϕ4 (weight1[[1]]+weight1[[3]])+ϕ1 ϕ4 (weight1[[2]]+weight1[[3]])+ϕ2 ϕ3 (weight1[[1]]+weight1[[4]])+ϕ1 ϕ3 (weight1[[2]]+weight1[[4]])+ϕ1 ϕ2 (weight1[[3]]+weight1[[4]]);\n\n(*H4*)\nh1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][4,7]:=h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][4,7]=ϕ2 ϕ3 ϕ4 (weight1[[1]])+ϕ1 ϕ3 ϕ4 (weight1[[2]])+ϕ1 ϕ2 ϕ4 (weight1[[3]])+ϕ1 ϕ2 ϕ3 (weight1[[4]]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ϵ11,ϵ12,ϵ13];\nϵ11[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h1[rep1][1,1])/(z-w1)+h1[ϕ1,ϕ2,ϕ3,ϕ4][1,3];\nϵ12[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h1[rep1][2,1])/((z-w1)^2)+(h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][2,3])/((z-w1))+h1[ϕ1,ϕ2,ϕ3,ϕ4][2,5];\nϵ13[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ13[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h1[rep1][3,1])/((z-w1)^3)+(h1[3,3])/((z-w1)^2)+(h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][3,5])/(z-w1)+h1[ϕ1,ϕ2,ϕ3,ϕ4][3,7];\nϵ14[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ14[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h1[rep1][4,1])/((z-w1)^4)+(h1[4,3])/((z-w1)^3)+(h1[4,5])/((z-w1)^2)+(h1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][4,7])/(z-w1)+h1[ϕ1,ϕ2,ϕ3,ϕ4][4,9];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[F1];\nF1[rep1_,C1_][z_]:=F1[rep1,C1][z]=(1)/((z-w1)^(rep1[[C1]]-C1+1));",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ϵ11S,ϵ12S,ϵ13S];\nϵ11S[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_][z_]:=ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]=ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]+(4 D[F1[rep1,C1][z],z])/(F1[rep1,C1][z]);\nϵ12S[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_][z_]:=ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]=ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]+(3 ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z] D[F1[rep1,C1][z],z])/(F1[rep1,C1][z])+(6 D[F1[rep1,C1][z],{z,2}])/(F1[rep1,C1][z]);\nϵ13S[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_][z_]:=ϵ13S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]=ϵ13[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]+2*ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]*(D[F1[rep1,C1][z],z])/(F1[rep1,C1][z])+3*(ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z] D[F1[rep1,C1][z],{z,2}])/(F1[rep1,C1][z])+4*(D[F1[rep1,C1][z],{z,3}])/(F1[rep1,C1][z]);\nϵ14S[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_][z_]:=ϵ14S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]=ϵ14[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]+ϵ13[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]*(D[F1[rep1,C1][z],z])/(F1[rep1,C1][z])+(ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z] D[F1[rep1,C1][z],{z,2}])/(F1[rep1,C1][z])+ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]*(D[F1[rep1,C1][z],{z,3}])/(F1[rep1,C1][z])+(D[F1[rep1,C1][z],{z,4}])/(F1[rep1,C1][z]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[BaxOp1];\nBaxOp1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=D[#,{z,4}]+ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]*D[#,{z,3}]+ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]*D[#,{z,2}]+ϵ13S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]*D[#,z]+ϵ14S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][z]*#&;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[QPoly1Site,Q1,c11,c12,c13,c14];\nQPoly1Site[c_,M_,r_][z_]:=QPoly1Site[c,M,r][z]=Exp[r z]*(z^M+Sum[c[k]*z^k,{k,0,M-1}]);\nQ1[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly1Site[c11,rep1〚1〛-weight1〚1〛,-ϕ1][z];\nQ1[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly1Site[c12,rep1〚1〛-weight1〚2〛,-ϕ2][z];\nQ1[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly1Site[c13,rep1〚1〛-weight1〚3〛,-ϕ3][z];\nQ1[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly1Site[c14,rep1〚1〛-weight1〚4〛,-ϕ4][z];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Bax1];\nBax1[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=Bax1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1]=((BaxOp1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][Q1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ1 z])//Simplify;\nBax1[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=Bax1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1]=((BaxOp1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][Q1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ2 z])//Simplify;\nBax1[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=Bax1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1]=((BaxOp1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][Q1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ3 z])//Simplify;\nBax1[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_]:=Bax1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1]=((BaxOp1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,C1][Q1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ4 z])//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Vars11,Vars12,Vars13,Vars14];\nVars11[rep1_,weight1_]:=Vars11[rep1,weight1]=Table[c11[n],{n,0,rep1〚1〛-weight1〚1〛-1}];\nVars12[rep1_,weight1_]:=Vars12[rep1,weight1]=Table[c12[n],{n,0,rep1〚1〛-weight1〚2〛-1}];\nVars13[rep1_,weight1_]:=Vars13[rep1,weight1]=Table[c13[n],{n,0,rep1〚1〛-weight1〚3〛-1}];\nVars14[rep1_,weight1_]:=Vars14[rep1,weight1]=Table[c14[n],{n,0,rep1〚1〛-weight1〚4〛-1}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[SolveBaxAll1];\nSolveBaxAll1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,c1_]:=SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]=Solve[CoefficientList[Bax1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]//Together//Numerator,z]==0&&\nCoefficientList[Bax1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]//Together//Numerator,z]==0&&CoefficientList[Bax1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]//Together//Numerator,z]==0&&CoefficientList[Bax1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,c1]//Together//Numerator,z]==0,Join[Vars11[rep1,weight1],Vars12[rep1,weight1],Vars13[rep1,weight1],Vars14[rep1,weight1],{h1[3,3],h1[4,3],h1[4,5]}]]//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[HSpectrum1];\nHSpectrum1[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ11[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ12[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ13[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ14[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[HSpectrum1S];\nHSpectrum1S[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1S[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1S[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1S[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1S[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1S[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ13S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];\n\nHSpectrum1S[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum1S[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ14S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]/.SolveBaxAll1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[μ1,μ2];\nμ1[rep1_][z_]:=μ1[rep1][z]=z^(-rep1[[1]]+rep1[[4]]);\nμ2[rep2_][z_]:=μ2[rep2][z]=(-1+z)^(-rep2[[1]]+rep2[[4]]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[MeanValue1,MeanValue2];\nMeanValue1[f_,τ_,rep1_]:=MeanValue1[f,τ,rep1]=\n2 π I Residue[(f*μ1[rep1][z]),{z,τ}];\nMeanValue2[f_,τ_,rep2_]:=MeanValue2[f,τ,rep2]=\n2 π I Residue[(f*μ2[rep2][z]),{z,τ}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ϵ11S†,ϵ12S†,ϵ13S†];\nϵ11S†[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ11S†[rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=-ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]+4*(D[μ1[rep1][z],z])/(μ1[rep1][z]);\nϵ12S†[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ12S†[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]-3*D[ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],z]-3*ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]*(D[μ1[rep1][z],z])/(μ1[rep1][z])+6*(D[μ1[rep1][z],{z,2}])/(μ1[rep1][z]);\nϵ13S†[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ13S†[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=-ϵ13S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]+2*D[ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],z]-3*D[ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],{z,2}]+(D[μ1[rep1][z],z])/(μ1[rep1][z])*(2*ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]-6*D[ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],z])-3*(D[μ1[rep1][z],{z,2}])/(μ1[rep1][z])*ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]+4*(D[μ1[rep1][z],{z,3}])/(μ1[rep1][z]);\nϵ14S†[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ14S†[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ14S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]-D[ϵ13S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],z]+D[ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],{z,2}]-D[ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],{z,3}]+(D[μ1[rep1][z],z])/(μ1[rep1][z])*(-ϵ13S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]+2*D[ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],z]-3*D[ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],{z,2}])+(D[μ1[rep1][z],{z,2}])/(μ1[rep1][z])*(ϵ12S[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]-3D[ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z],z])-ϵ11S[rep1,ϕ1,ϕ2,ϕ3,ϕ4,1][z]*(D[μ1[rep1][z],{z,3}])/(μ1[rep1][z])+(D[μ1[rep1][z],{z,4}])/(μ1[rep1][z]);",
   "languageId": "wolfram",
