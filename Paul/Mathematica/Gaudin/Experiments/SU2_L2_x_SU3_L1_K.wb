  {
   "kind": 2,
   "value": "ClearAll[SolveBaxAll];\nSolveBaxAll[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,c1_,c2_]:=SolveBaxAll[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,c1,c2]=Solve[CoefficientList[Bax[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,c1,c2]//Together//Numerator,z]==0&&\nCoefficientList[Bax[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,c1,c2]//Together//Numerator,z]==0&&\nCoefficientList[Bax[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,c1,c2]//Together//Numerator,z]==0&&CoefficientList[Bax[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,c1,c2]//Together//Numerator,z]==0,Join[Vars1[rep1,rep2,repAll],Vars2[rep1,rep2,repAll],Vars3[rep1,rep2,repAll],Vars4[rep1,rep2,repAll],{h[2,4],h[3,3],h[3,4],h[3,6],h[4,3],h[4,4],h[4,5],h[4,6],h[4,8]}]]//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[HSpectrum];\nHSpectrum[1][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ1[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,1,1];\n\nHSpectrum[2][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ2[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,1,1];\n\nHSpectrum[3][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ3[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,1,1];\n\nHSpectrum[4][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=HSpectrum[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=ϵ4[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]/.SolveBaxAll[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,1,1];",
