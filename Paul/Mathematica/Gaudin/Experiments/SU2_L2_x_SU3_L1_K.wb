  {
   "kind": 2,
   "value": "ClearAll[rep1T,rep2T,repAllT,MaxM,Weight,MaxW,ϕ1T,ϕ2T,ϕ3T,ϕ4T];\nrep1T={1,1,0,0}; rep2T={1,1,0,0};\nrepAllT=FindWeight2[rep1T,rep2T];\nMaxM=Length[repAllT]; Weight=FindGoodWeight[rep1T]; MaxW=Length[Weight];\n{ϕ1T,ϕ2T,ϕ3T,ϕ4T}={1,1/2,1/3,1/5};\n<|\"OutputWeights\"->repAllT,\"OneSiteWeights\"->Weight|>",
   "languageId": "wolfram",
   "outputs": [
    {
