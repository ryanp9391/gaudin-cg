  {
   "kind": 2,
   "value": "ClearAll[w1, w2];\nw1 = 0;\nw2 = 1;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[FUNDAMENTAL, ANTIFUNDAMENTAL, ADJOINT];\n(*Rep of gl(4)*)\nFUNDAMENTAL={1,0,0,0};\nANTIFUNDAMENTAL={1,1,1,0};\nADJOINT={2,1,1,0};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Ng=4;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ps[rep_]:=ps[rep]=Block[{res=(Prepend[rep,#]&/@(Tuples[Table[Range[rep[[1,i+1]],rep[[1,i]]],{i,1,Length[rep[[1]]]-1}]]))},If[Length[res[[1,1]]]==1,Reverse@Sort@res,Reverse@Sort@Flatten[ps/@res,1]]];\ndim[rep_]:=dim[rep]=Length[ps[{rep}]];\nJ0[k_][pat_]:=J0[k][pat]=Sum[pat[[k,i]],{i,1,k}]-Sum[pat[[k-1,i]],{i,1,k-1}];\nJp[k_][pat_]:=Jp[k][pat]=-Sum[Product[pat[[k,i]]-i-pat[[k+1,j]]+j,{j,Range[k+1]}]/Product[pat[[k,i]]-i-pat[[k,j]]+j,{j,Complement[Range[k],{i}]}] v[ReplacePart[pat,{k,i}->pat[[k,i]]+1]],{i,1,k}];\nJm[k_][pat_]:=Jm[k][pat]=Sum[Product[pat[[k,i]]-i-pat[[k-1,j]]+j,{j,Range[k-1]}]/Product[pat[[k,i]]-i-pat[[k,j]]+j,{j,Complement[Range[k],{i}]}] v[ReplacePart[pat,{k,i}->pat[[k,i]]-1]],{i,1,k}];\nJJ[k_,l_,rep_]:=JJ[k,l,rep]=Which[k==l,DiagonalMatrix[J0[k]/@ps[{rep}]],l==k+1,Transpose[Table[Coefficient[Jp[k][ps[{rep}][[i]]],v[#]]&/@ps[{rep}],{i,1,Length[ps[{rep}]]}]],l==k-1,Transpose[Table[Coefficient[Jm[l][ps[{rep}][[i]]],v[#]]&/@ps[{rep}],{i,1,Length[ps[{rep}]]}]],l>k+1,JJ[k,k+1,rep].JJ[k+1,l,rep]-JJ[k+1,l,rep].JJ[k,k+1,rep],l<k-1,JJ[k,k-1,rep].JJ[k-1,l,rep]-JJ[k-1,l,rep].JJ[k,k-1,rep]];\nCC[k_,set_,rep_]:=CC[k,set,rep]=Sum[Dot[Sequence@@Table[JJ[j[i+1],j[i],rep],{i,1,k}]]/.j[k+1]->j[1],Evaluate[Sequence@@Array[{j[#],set}&,k]]];\nCCDiag[k_,set_,rep_]:=CCDiag[k,set,rep]=Diagonal[Inverse[Transpose[Eigenvectors[CC[Length[set],set,rep]]]].CC[k,set,rep].Transpose[Eigenvectors[CC[Length[set],set,rep]]]]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[JJH,PM,SolvePH,PH,PElement];\nPM[rep_]:=PM[rep]=DiagonalMatrix[Table[PElement[i],{i,1,dim[rep]}]];\nSolvePH[rep_]:=SolvePH[rep]=FullSimplify[(Solve[(DeleteDuplicates[Table[PM[rep].JJ[k,l,rep].Inverse[PM[rep]]-Inverse[PM[rep]].ConjugateTranspose[JJ[l,k,rep]].PM[rep],{k,1,Ng},{l,1,Ng}]//Flatten])==0,Table[PElement[i],{i,1,dim[rep]}]])];(*If PM is real*)\nPH[rep_,Optional[M_,1]]:=PH[rep,Optional[M,1]]=(PM[rep]/.SolvePH[rep])[[M]]//Simplify;\n(*If PM is complex*)(*Solve[(DeleteDuplicates[Table[PM[rep].JJ[k,l,rep].Inverse[PM[rep]]-ConjugateTranspose[PM[rep].JJ[l,k,rep].Inverse[PM[rep]]],{k,1,3},{l,1,3}]//Flatten])==0,Table[PElement[i],{i,1,dim[rep]}]];*)\nJJH[k_,l_,rep_,Optional[M_,1]]:=JJH[k,l,rep,Optional[M,1]]=(PH[rep,M].JJ[k,l,rep].Inverse[PH[rep,M]])//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[e,EM,Id];\ne[a_,b_,rep1_]:=e[a,b,rep1]=SparseArray[{a,b}->1,{dim[rep1],dim[rep1]}];\nEM[a_,b_,rep1_]:=EM[a,b,rep1]=JJ[a,b,rep1];(*Non Hermitian generators*)\n(*JJH[a,b,rep1];*)\nId[rep1_]:=Id[rep1]=SparseArray[{a_,a_}->1,{dim[rep1],dim[rep1]}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[EMAll];\nEMAll[a_,b_,rep1_,rep2_]:=EMAll[a,b,rep1,rep2]=KroneckerProduct[EM[a,b,rep1],Id[rep2]]+KroneckerProduct[Id[rep1],EM[a,b,rep2]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[FindWeight,FindGoodWeight];\nFindWeight[rep_]:=Table[{EM[1,1,rep][[n,n]],EM[2,2,rep][[n,n]],EM[3,3,rep][[n,n]],EM[4,4,rep][[n,n]]},{n,1,dim[rep]}];\nFindGoodWeight[rep_]:=Pick[FindWeight[rep],Lookup[Counts[FindWeight[rep]],FindWeight[rep]],1]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[FindWeight2All,FindWeight2,FindGoodWeight2];\nFindWeight2All[rep1_,rep2_]:=FindWeight2All[rep1,rep2]=Flatten[Table[{EM[1,1,rep1][[n,n]]+EM[1,1,rep2][[m,m]],\nEM[2,2,rep1][[n,n]]+EM[2,2,rep2][[m,m]],\nEM[3,3,rep1][[n,n]]+EM[3,3,rep2][[m,m]],EM[4,4,rep1][[n,n]]+EM[4,4,rep2][[m,m]]},{n,1,dim[rep1]},{m,1,dim[rep2]}],1];\nFindWeight2[rep1_,rep2_]:=FindWeight2[rep1,rep2]=DeleteDuplicates[FindWeight2All[rep1,rep2]];\nFindGoodWeight2[rep1_,rep2_]:=FindGoodWeight2[rep1,rep2]=Pick[FindWeight2All[rep1,rep2],Lookup[Counts[FindWeight2All[rep1,rep2]],FindWeight2All[rep1,rep2]],1]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[WeightDynkin,λ1,λ2,λ3];\nWeightDynkin[Δ_,l_]:=Solve[λ1-λ2==(Δ)&&λ2-λ3==l&&λ1+λ2+λ3==0,{λ1,λ2,λ3}]\n(*Fundamental*)\nWeightDynkin[1,0]\n(*AntiFundamental*)\nWeightDynkin[0,1]\n(*Adjoint*)\nWeightDynkin[1,1]",
   "languageId": "wolfram",
   "outputs": [
