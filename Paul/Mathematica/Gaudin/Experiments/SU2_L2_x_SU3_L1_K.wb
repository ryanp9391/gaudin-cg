  {
   "kind": 2,
   "value": "ClearAll[K22B];\nK22B[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,αϕ13_,αϕ14_,αϕ23_,k1_,k2_,k3_,k4_]:=K22B[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,αϕ13,αϕ14,αϕ23,k1,k2,k3,k4]=KroneckerProduct[UPL1[rep1].MatrixExp[(αϕ13 (k3-ϕ3) (-k4+ϕ2+ϕ3))/((k3-ϕ1) (-k4+ϕ1+ϕ2))(EM[1,3,rep1])].MatrixExp[(αϕ14 (k3-ϕ4) (-k4+ϕ2+ϕ4))/((k3-ϕ1) (-k4+ϕ1+ϕ2))(EM[1,4,rep1])].MatrixExp[(αϕ23 (k3-ϕ3) (-k4+ϕ1+ϕ3))/((k3-ϕ2) (-k4+ϕ1+ϕ2))(EM[2,3,rep1])].MatrixExp[-(αϕ14 αϕ23 (ϕ2-ϕ3) (k3-ϕ4) (-ϕ1+ϕ4) (-k4+ϕ1+ϕ4))/(αϕ13 (k3-ϕ2) (-k4+ϕ1+ϕ2) (ϕ1-ϕ3) (ϕ2-ϕ4))(EM[2,4,rep1])],UPL1[rep2].MatrixExp[(αϕ13*(k3-ϕ3))/((k3-ϕ1))(EM[1,3,rep2])].MatrixExp[(αϕ14*(k3-ϕ4))/((k3-ϕ1))(EM[1,4,rep2])].MatrixExp[αϕ23*((k3-ϕ3))/((k3-ϕ2))(EM[2,3,rep2])].MatrixExp[αr[24][ϕ1,ϕ2,ϕ3,ϕ4,αϕ13,αϕ14,αϕ23]*((k3-ϕ4))/((k3-ϕ2))(EM[2,4,rep2])]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[K22C];\nK22C[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,αϕ13_,αϕ14_,αϕ23_,k1_,k2_,k3_,k4_]:=KroneckerProduct[\n UPL1[rep1].\n  MatrixExp[αϕ13 ((k4-ϕ2-ϕ3) (k3-ϕ3))/((k4-ϕ1-ϕ2) (k3-ϕ1)) EM[1,3,rep1]].\n  MatrixExp[αϕ14 ((k3-ϕ4) (k4-ϕ2-ϕ4))/((k3-ϕ1) (k4-ϕ1-ϕ2)) EM[1,4,rep1]].\n  MatrixExp[αϕ23 ((k3-ϕ3) (k4-ϕ3-ϕ1))/((k3-ϕ2) (k4-ϕ1-ϕ2)) EM[2,3,rep1]].\n  MatrixExp[αr[24][ϕ1,ϕ2,ϕ3,ϕ4,αϕ13,αϕ14,αϕ23] ((k4-ϕ1-ϕ4) (k3-ϕ4))/((k4-ϕ1-ϕ2) (k3-ϕ2)) EM[2,4,rep1]],\n UPL1[rep2].\n  MatrixExp[αϕ13 (k4-ϕ2-ϕ3)/(k4-ϕ1-ϕ2) EM[1,3,rep2]].\n  MatrixExp[αϕ14 (k4-ϕ2-ϕ4)/(k4-ϕ1-ϕ2) EM[1,4,rep2]].\n  MatrixExp[αϕ23 (k4-ϕ3-ϕ1)/(k4-ϕ1-ϕ2) EM[2,3,rep2]].\n  MatrixExp[αr[24][ϕ1,ϕ2,ϕ3,ϕ4,αϕ13,αϕ14,αϕ23] (k4-ϕ1-ϕ4)/(k4-ϕ1-ϕ2) EM[2,4,rep2]]\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[OrthogRen22B];\nOrthogRen22B[QHL_,QL_,QHR_,QR_,rep1_,rep2_]:=OrthogRen22B[QHL,QL,QHR,QR,rep1,rep2]=\n2 π I Residue[(QHL[[4]]*Wronskian[{QR[[1]],QR[[2]]},z]*((1)/((z-w1)^((rep1[[1]]-rep1[[4]])+1 ) ))),{z,0}]/((Limit[QHL[[4]],z->w1])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z],z->w1]))*(1/((Limit[QHL[[3]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[D[QHL[[3]],z],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z],z->0,Direction->\"\\<FromAbove\\>\"])*\n(Limit[QHL[[3]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[D[QHL[[3]],z],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z],z->1,Direction->\"\\<FromAbove\\>\"])))*\nDet[{{2 π I Residue[(QHL[[3]] D[QR[[1]],z])/(z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,0}],\n2 π I Residue[(QHL[[3]] QR[[1]])/(z^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,0}],\n2 π I Residue[(QHL[[3]] D[QR[[1]],z])/(-1+z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,0}],\n2 π I Residue[(QHL[[3]] QR[[1]])/((-1+z)^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,0}]},\n\n{2 π I Residue[(QHL[[3]] D[QR[[2]],z])/(z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,0}],\n2 π I Residue[(QHL[[3]] QR[[2]])/(z^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,0}],\n2 π I Residue[(QHL[[3]] D[QR[[2]],z])/(-1+z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,0}],\n2 π I Residue[(QHL[[3]] QR[[2]])/((-1+z)^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,0}]},\n\n\n{2 π I Residue[(QHL[[3]] D[QR[[1]],z])/(z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,1}],\n2 π I Residue[(QHL[[3]] QR[[1]])/(z^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,1}],\n2 π I Residue[(QHL[[3]] D[QR[[1]],z])/(-1+z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,1}],\n2 π I Residue[(QHL[[3]] QR[[1]])/((-1+z)^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,1}]},\n\n{2 π I Residue[(QHL[[3]] D[QR[[2]],z])/(z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,1}],\n2 π I Residue[(QHL[[3]] QR[[2]])/(z^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,1}],\n2 π I Residue[(QHL[[3]] D[QR[[2]],z])/(-1+z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,1}],\n2 π I Residue[(QHL[[3]] QR[[2]])/((-1+z)^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]) (z-w2)^(rep2[[1]]-rep2[[3]]))),{z,1}]}}];",
   "languageId": "wolfram",
   "outputs": [],
