  {
   "kind": 2,
   "value": "ClearAll[h];\nh[rep1_,rep2_][1,1]:=h[rep1,rep2][1,1]=rep1[[1]]+rep1[[2]]+rep1[[3]]+rep1[[4]];\nh[rep1_,rep2_][2,1]:=h[rep1,rep2][2,1]=rep1〚3〛 (-1+rep1〚4〛)+rep1〚2〛 (-2+rep1〚3〛+rep1〚4〛)+rep1〚1〛 (-3+rep1〚2〛+rep1〚3〛+rep1〚4〛);\nh[rep1_,rep2_][3,1]:=h[rep1,rep2][3,1]=rep1〚2〛 (-1+rep1〚3〛) (-2+rep1〚4〛)+rep1〚1〛 ((-2+rep1〚3〛) (-3+rep1〚4〛)+rep1〚2〛 (-4+rep1〚3〛+rep1〚4〛));\nh[rep1_,rep2_][4,1]:=h[rep1,rep2][4,1]=rep1〚1〛 (-1+rep1〚2〛) (-2+rep1〚3〛) (-3+rep1〚4〛);\n\nh[rep1_,rep2_][1,2]:=h[rep1,rep2][1,2]=rep2[[1]]+rep2[[2]]+rep2[[3]]+rep2[[4]];\nh[rep1_,rep2_][2,2]:=h[rep1,rep2][2,2]=rep2〚3〛 (-1+rep2〚4〛)+rep2〚2〛 (-2+rep2〚3〛+rep2〚4〛)+rep2〚1〛 (-3+rep2〚2〛+rep2〚3〛+rep2〚4〛);\nh[rep1_,rep2_][3,2]:=h[rep1,rep2][3,2]=rep2〚2〛 (-1+rep2〚3〛) (-2+rep2〚4〛)+rep2〚1〛 ((-2+rep2〚3〛) (-3+rep2〚4〛)+rep2〚2〛 (-4+rep2〚3〛+rep2〚4〛));\nh[rep1_,rep2_][4,2]:=h[rep1,rep2][4,2]=rep2〚1〛 (-1+rep2〚2〛) (-2+rep2〚3〛) (-3+rep2〚4〛);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*H1*)\nh[ϕ1_,ϕ2_,ϕ3_,ϕ4_][1,3]:=h[ϕ1,ϕ2,ϕ3,ϕ4][1,3]=ϕ1+ϕ2+ϕ3+ϕ4;\n\n(*H2*)\nh[ϕ1_,ϕ2_,ϕ3_,ϕ4_][2,5]:=h[ϕ1,ϕ2,ϕ3,ϕ4][2,5]=ϕ1 ϕ2+ϕ1 ϕ3+ϕ2 ϕ3+ϕ1 ϕ4+ϕ2 ϕ4+ϕ3 ϕ4;\n\n(*H3*)\nh[ϕ1_,ϕ2_,ϕ3_,ϕ4_][3,7]:=h[ϕ1,ϕ2,ϕ3,ϕ4][3,7]=ϕ1 ϕ2 ϕ3+ϕ1 ϕ2 ϕ4+ϕ1 ϕ3 ϕ4+ϕ2 ϕ3 ϕ4;\n\n(*H4*)\nh[ϕ1_,ϕ2_,ϕ3_,ϕ4_][4,9]:=h[ϕ1,ϕ2,ϕ3,ϕ4][4,9]=ϕ1*ϕ2*ϕ3*ϕ4;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*H2*)\nh[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][2,3]:=h[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][2,3]=-h[2,4]+(ϕ2+ϕ3+ϕ4) (repAll[[1]])+(ϕ1+ϕ3+ϕ4) (repAll[[2]])+(ϕ1+ϕ2+ϕ4) (repAll[[3]])+(ϕ1+ϕ2+ϕ3) (repAll[[4]]);\n\n(*H3*)\nh[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][3,5]:=h[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][3,5]=-h[3,6]+ϕ3 ϕ4 (repAll[[1]]+repAll[[2]])+ϕ2 ϕ4 (repAll[[1]]+repAll[[3]])+ϕ1 ϕ4 (repAll[[2]]+repAll[[3]])+ϕ2 ϕ3 (repAll[[1]]+repAll[[4]])+ϕ1 ϕ3 (repAll[[2]]+repAll[[4]])+ϕ1 ϕ2 (repAll[[3]]+repAll[[4]]);\n\n(*H4*)\nh[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][4,7]:=h[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][4,7]=-h[4,8]+ϕ2 ϕ3 ϕ4 (repAll[[1]])+ϕ1 ϕ3 ϕ4 (repAll[[2]])+ϕ1 ϕ2 ϕ4 (repAll[[3]])+ϕ1 ϕ2 ϕ3 (repAll[[4]]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ϵ1,ϵ2,ϵ3];\nϵ1[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ1[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h[rep1,rep2][1,1])/(z-w1)+(h[rep1,rep2][1,2])/(z-w2)+h[ϕ1,ϕ2,ϕ3,ϕ4][1,3];\nϵ2[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ2[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h[rep1,rep2][2,1])/((z-w1)^2)+(h[rep1,rep2][2,2])/((z-w2)^2)+(h[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][2,3])/((z-w1))+(h[2,4])/((z-w2))+h[ϕ1,ϕ2,ϕ3,ϕ4][2,5];\nϵ3[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ3[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h[rep1,rep2][3,1])/((z-w1)^3)+(h[rep1,rep2][3,2])/((z-w2)^3)+(h[3,3])/((z-w1)^2)+(h[3,4])/((z-w2)^2)+(h[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][3,5])/(z-w1)+(h[3,6])/(z-w2)+h[ϕ1,ϕ2,ϕ3,ϕ4][3,7];\nϵ4[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=ϵ4[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=(h[rep1,rep2][4,1])/((z-w1)^4)+(h[rep1,rep2][4,2])/((z-w2)^4)+(h[4,3])/((z-w1)^3)+(h[4,4])/((z-w2)^3)+(h[4,5])/((z-w1)^2)+(h[4,6])/((z-w2)^2)+(h[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][4,7])/(z-w1)+(h[4,8])/(z-w2)+h[ϕ1,ϕ2,ϕ3,ϕ4][4,9];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[F];\nF[rep1_,rep2_,C1_,\nC2_][z_]:=F[rep1,rep2,C1,C2][z]=Cases[{{C1,C2}},{a_,b_}:>(1)/((z-w1)^(rep1[[a]]-a+1)*(z-w2)^(rep2[[b]]-b+1))][[1]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ϵ1S,ϵ2S,ϵ3S];\nϵ1S[rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_,C2_][z_]:=ϵ1S[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][z]=ϵ1[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]+(4 D[F[rep1,rep2,C1,C2][z],z])/(F[rep1,rep2,C1,C2][z]);\nϵ2S[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_,C2_][z_]:=ϵ2S[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][z]=ϵ2[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]+(3 ϵ1[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z] D[F[rep1,rep2,C1,C2][z],z])/(F[rep1,rep2,C1,C2][z])+(6 D[F[rep1,rep2,C1,C2][z],{z,2}])/(F[rep1,rep2,C1,C2][z]);\nϵ3S[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_,C2_][z_]:=ϵ3S[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][z]=ϵ3[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]+2*ϵ2[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]*(D[F[rep1,rep2,C1,C2][z],z])/(F[rep1,rep2,C1,C2][z])+3*(ϵ1[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z] D[F[rep1,rep2,C1,C2][z],{z,2}])/(F[rep1,rep2,C1,C2][z])+4*(D[F[rep1,rep2,C1,C2][z],{z,3}])/(F[rep1,rep2,C1,C2][z]);\nϵ4S[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_,C2_][z_]:=ϵ4S[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][z]=ϵ4[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]+ϵ3[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]*(D[F[rep1,rep2,C1,C2][z],z])/(F[rep1,rep2,C1,C2][z])+(ϵ2[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z] D[F[rep1,rep2,C1,C2][z],{z,2}])/(F[rep1,rep2,C1,C2][z])+ϵ1[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]*(D[F[rep1,rep2,C1,C2][z],{z,3}])/(F[rep1,rep2,C1,C2][z])+(D[F[rep1,rep2,C1,C2][z],{z,4}])/(F[rep1,rep2,C1,C2][z]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[BaxOp];\nBaxOp[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_,C2_]:=D[#,{z,4}]+ϵ1S[rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][z]*D[#,{z,3}]+ϵ2S[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][z]*D[#,{z,2}]+ϵ3S[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][z]*D[#,z]+ϵ4S[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][z]*#&;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
