  {
   "kind": 2,
   "value": "ClearAll[SolveBaxh1†,SolveBaxAllh1†];\nSolveBaxh1†[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h33_,h43_,h45_]:=SolveBaxh1†[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h33,h43,h45]=Solve[CoefficientList[Bax1†[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]/.{h1[3,3]->h33,\nh1[4,3]->h43,h1[4,5]->h45}//Together//Numerator,z]==0,Vars11†[rep1,weight1]]//Simplify//Flatten;\n\nSolveBaxh1†[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h33_,h43_,h45_]:=SolveBaxh1†[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h33,h43,h45]=Solve[CoefficientList[Bax1†[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]/.{h1[3,3]->h33,\nh1[4,3]->h43,h1[4,5]->h45}//Together//Numerator,z]==0,Vars12†[rep1,weight1]]//Simplify//Flatten;\n\nSolveBaxh1†[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h33_,h43_,h45_]:=SolveBaxh1†[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h33,h43,h45]=Solve[CoefficientList[Bax1†[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]/.{h1[3,3]->h33,\nh1[4,3]->h43,h1[4,5]->h45}//Together//Numerator,z]==0,Vars13†[rep1,weight1]]//Simplify//Flatten;\n\nSolveBaxh1†[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h33_,h43_,h45_]:=SolveBaxh1†[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h33,h43,h45]=Solve[CoefficientList[Bax1†[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]/.{h1[3,3]->h33,\nh1[4,3]->h43,h1[4,5]->h45}//Together//Numerator,z]==0,Vars14†[rep1,weight1]]//Simplify//Flatten;\n\nSolveBaxAllh1†[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h33_,h43_,h45_]:=SolveBaxAllh1†[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h33,h43,h45]=Join[SolveBaxh1†[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h33,h43,h45],SolveBaxh1†[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h33,h43,h45],SolveBaxh1†[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h33,h43,h45],SolveBaxh1†[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,h33,h43,h45]]//Simplify;",
   "languageId": "wolfram",
