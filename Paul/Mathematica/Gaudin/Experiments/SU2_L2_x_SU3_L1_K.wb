05/3146, -525/81796, -1/7, -5/104, -25/572, 3/98, 3/77, 15/2002, -1/11, -35/1144, -175/6292, 3/154, 3/121, 15/3146, -2/143, -35/7436, -175/40898, 3/1001, 6/1573, 15/20449}}, \"SymbolicAgreement\" -> (-2*(-4 + kPhysical4))/((-2 + kPhysical3)*(-3 + kPhysical4)*untwistedPivotLeading[\"Coefficient\"]) == {{1, (5*(-4 + kPhysical4))/(13*(-3 + kPhysical4)), (70*(-6 + kPhysical4))/(143*(-3 + kPhysical4)), (-2*(-5 + kPhysical4))/(7*(-3 + kPhysical4)), (-6*(-7 + kPhysical4))/(11*(-3 + kPhysical4)), (-20*(-8 + kPhysical4))/(143*(-3 + kPhysical4)), (5*(-3 + kPhysical3)*(-4 + kPhysical4))/(13*(-2 + kPhysical3)*(-3 + kPhysical4)), (25*(-3 + kPhysical3)*(-4 + kPhysical4)^2)/(169*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (350*(-3 + kPhysical3)*(-6 + kPhysical4)*(-4 + kPhysical4))/(1859*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (-10*(-3 + kPhysical3)*(-5 + kPhysical4)*(-4 + kPhysical4))/(91*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (-30*(-3 + kPhysical3)*(-7 + kPhysical4)*(-4 + kPhysical4))/(143*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (-100*(-3 + kPhysical3)*(-8 + kPhysical4)*(-4 + kPhysical4))/(1859*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (70*(-5 + kPhysical3)*(-6 + kPhysical4))/(143*(-2 + kPhysical3)*(-3 + kPhysical4)), (350*(-5 + kPhysical3)*(-6 + kPhysical4)*(-4 + kPhysical4))/(1859*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (4900*(-5 + kPhysical3)*(-6 + kPhysical4)^2)/(20449*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (-20*(-5 + kPhysical3)*(-6 + kPhysical4)*(-5 + kPhysical4))/(143*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (-420*(-5 + kPhysical3)*(-7 + kPhysical4)*(-6 + kPhysical4))/(1573*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (-1400*(-5 + kPhysical3)*(-8 + kPhysical4)*(-6 + kPhysical4))/(20449*(-2 + kPhysical3)*(-3 + kPhysical4)^2), (-2*(-3 + kPhysical3)*(-5 + kPhysical4))/(7*(-1 + kPhysical3)*(-3 + kPhysical4)), (-10*(-3 + kPhysical3)*(-5 + kPhysical4)*(-4 + kPhysical4))/(91*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (-20*(-3 + kPhysical3)*(-6 + kPhysical4)*(-5 + kPhysical4))/(143*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (4*(-3 + kPhysical3)*(-5 + kPhysical4)^2)/(49*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (12*(-3 + kPhysical3)*(-7 + kPhysical4)*(-5 + kPhysical4))/(77*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (40*(-3 + kPhysical3)*(-8 + kPhysical4)*(-5 + kPhysical4))/(1001*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (-6*(-5 + kPhysical3)*(-7 + kPhysical4))/(11*(-1 + kPhysical3)*(-3 + kPhysical4)), (-30*(-5 + kPhysical3)*(-7 + kPhysical4)*(-4 + kPhysical4))/(143*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (-420*(-5 + kPhysical3)*(-7 + kPhysical4)*(-6 + kPhysical4))/(1573*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (12*(-5 + kPhysical3)*(-7 + kPhysical4)*(-5 + kPhysical4))/(77*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (36*(-5 + kPhysical3)*(-7 + kPhysical4)^2)/(121*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (120*(-5 + kPhysical3)*(-8 + kPhysical4)*(-7 + kPhysical4))/(1573*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (-20*(-5 + kPhysical3)*(-3 + kPhysical3)*(-8 + kPhysical4))/(143*(-2 + kPhysical3)*(-1 + kPhysical3)*(-3 + kPhysical4)), (-100*(-5 + kPhysical3)*(-3 + kPhysical3)*(-8 + kPhysical4)*(-4 + kPhysical4))/(1859*(-2 + kPhysical3)*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (-1400*(-5 + kPhysical3)*(-3 + kPhysical3)*(-8 + kPhysical4)*(-6 + kPhysical4))/(20449*(-2 + kPhysical3)*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (40*(-5 + kPhysical3)*(-3 + kPhysical3)*(-8 + kPhysical4)*(-5 + kPhysical4))/(1001*(-2 + kPhysical3)*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (120*(-5 + kPhysical3)*(-3 + kPhysical3)*(-8 + kPhysical4)*(-7 + kPhysical4))/(1573*(-2 + kPhysical3)*(-1 + kPhysical3)*(-3 + kPhysical4)^2), (400*(-5 + kPhysical3)*(-3 + kPhysical3)*(-8 + kPhysical4)^2)/(20449*(-2 + kPhysical3)*(-1 + kPhysical3)*(-3 + kPhysical4)^2)}}|>",
