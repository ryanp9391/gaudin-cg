  {
   "kind": 2,
   "value": "ClearAll[αr,α12,α13,α14,α23,α24,α34,ϕ1,ϕ2,ϕ3,ϕ4];\nαr[12][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=(α13 (-ϕ1+ϕ3))/(α23 (ϕ2-ϕ3));\nαr[24][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=(α14 α23 (ϕ2-ϕ3) (ϕ1-ϕ4))/(α13 (ϕ1-ϕ3) (ϕ2-ϕ4));\nαr[34][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=(α14 (ϕ1-ϕ4))/(α13 (ϕ1-ϕ3));",
