   "value": "ClearAll[QPoly†,Q†,c1†,c2†,c3†,c4†];\nQPoly†[c_,M_,r_][z_]:=QPoly†[c,M,r][z]=Exp[r z]*(z^M+Sum[c[k]*z^k,{k,0,M-1}]);\nQ†[1][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q†[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly†[c1†,-rep1〚4〛-rep2〚4〛+repAll〚1〛,ϕ1][z];\nQ†[2][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q†[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly†[c2†,-rep1〚4〛-rep2〚4〛+repAll〚2〛,ϕ2][z];\nQ†[3][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q†[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly†[c3†,-rep1〚4〛-rep2〚4〛+repAll〚3〛,ϕ3][z];\nQ†[4][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q†[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly†[c4†,-rep1〚4〛-rep2〚4〛+repAll〚4〛,ϕ4][z];",
