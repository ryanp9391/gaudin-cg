   "value": "ClearAll[LIndex1];\nLIndex1[a_,b_,rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=LIndex1[a,b,rep1,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(z-w1)*EM[a,b,rep1]+KroneckerDelta[a,1]*KroneckerDelta[b,1]*ϕ1*Id[rep1]+KroneckerDelta[a,2]*KroneckerDelta[b,2]*ϕ2*Id[rep1]+KroneckerDelta[a,3]*KroneckerDelta[b,3]*ϕ3*Id[rep1]+KroneckerDelta[a,4]*KroneckerDelta[b,4]*ϕ4*Id[rep1];",
