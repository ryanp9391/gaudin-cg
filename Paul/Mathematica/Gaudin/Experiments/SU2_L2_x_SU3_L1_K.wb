  {
   "kind": 2,
   "value": "ClearAll[βrT,α12,α13,α14,α23,α24,α34,ϕ1,ϕ2,ϕ3,ϕ4];\nβrT[12][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[12][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=(α23 (ϕ1-ϕ4))/(α13 (ϕ2-ϕ4));\nβrT[13][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[13][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=((ϕ2-ϕ3) (ϕ1-ϕ4))/(α13 (ϕ1-ϕ2) (ϕ3-ϕ4));\nβrT[14][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[14][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=-((ϕ1-ϕ3) (ϕ2-ϕ4))/(α14 (ϕ1-ϕ2) (ϕ3-ϕ4));\nβrT[23][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[23][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=-((ϕ1-ϕ3) (ϕ2-ϕ4))/(α23 (ϕ1-ϕ2) (ϕ3-ϕ4));\nβrT[24][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[24][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=(α13 (ϕ1-ϕ3) (ϕ2-ϕ4))/(α14 α23 (ϕ1-ϕ2) (ϕ3-ϕ4));\nβrT[34][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α12_,α13_,α14_,α23_,α24_,α34_]:=βrT[34][ϕ1,ϕ2,ϕ3,ϕ4,α12,α13,α14,α23,α24,α34]=(α13 (ϕ2-ϕ4))/(α14 (-ϕ2+ϕ3));",
   "languageId": "wolfram",
