   "value": "ClearAll[Hodge1];\nHodge1[Qfour_,rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,z_,i_]:=\n(Exp[z*(ϕ1+ϕ2+ϕ3+ϕ4)]*Signature[Join[Complement[SetN,{i}],{i}]]*Wronskian[{Qfour[[Complement[SetN,{i}]]][[1]],Qfour[[Complement[SetN,{i}]]][[2]],Qfour[[Complement[SetN,{i}]]][[3]]},z]*(((z)^(-(2*rep1[[1]]-rep1[[2]]-rep1[[3]]))))/((({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[1]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[2]]]]))*({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[1]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[3]]]])*({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[2]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[3]]]])))//Simplify;\n(*The Q argument should be Q1[z], not Q1!*)\n\n(**(((z)^(-2(rep1[[1]]-rep1[[2]]))*(z-1)^(-2(rep2[[1]]-rep2[[2]]))))*)\n(**)",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Normalisation1];\nNormalisation1[QHL_,QL_,QHR_,QR_,rep1_]:=Normalisation1[QHL,QL,QHR,QR,rep1]=(Limit[QHL[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QHL[[1]],QHL[[2]]},z]*(1)/(z^(rep1[[3]]-rep1[[4]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QL[[4]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QR[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z]*(1)/(z^(rep1[[1]]-rep1[[2]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QHR[[4]],z->0,Direction->\"\\<FromAbove\\>\"]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[RawOrthog1];\nRawOrthog1[QH_,Q_,rep1_,w_,α_,i_,j_]:=RawOrthog1[QH,Q,rep1,w,α,i,j]={MeanValue1[QH[[i]]*D[Q[[j]],{z,2}]*(1)/(z-w),α,rep1],MeanValue1[QH[[i]]*D[Q[[j]],{z,1}]*(1)/((z-w)^2),α,rep1],MeanValue1[QH[[i]]*D[Q[[j]],{z,1}]*(1)/(z-w),α,rep1],MeanValue1[QH[[i]]*Q[[j]]*(1)/((z-w)^3),α,rep1],MeanValue1[QH[[i]]*Q[[j]]*(1)/((z-w)^2),α,rep1],MeanValue1[QH[[i]]*Q[[j]]*(1)/(z-w),α,rep1]};\nClearAll[OrthogRen1];\nOrthogRen1[QHL_,QL_,QHR_,QR_,rep1_]:=OrthogRen1[QHL,QL,QHR,QR,rep1]=(1/Normalisation1[QHL,QL,QHR,QR,rep1])*Det[{RawOrthog1[QHL,QR,rep1,0,0,1,1],RawOrthog1[QHL,QR,rep1,0,0,1,2],RawOrthog1[QHL,QR,rep1,0,0,2,1],RawOrthog1[QHL,QR,rep1,0,0,2,2],RawOrthog1[QHL,QR,rep1,0,0,1,3],RawOrthog1[QHL,QR,rep1,0,0,3,1]}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
