  {
   "kind": 2,
   "value": "ClearAll[LIndex];\nLIndex[a_,b_,rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z_]:=LIndex[a,b,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4][z]=(1)/(z-w1)*KroneckerProduct[EM[a,b,rep1],Id[rep2]]+(1)/(z-w2)*KroneckerProduct[Id[rep1],EM[a,b,rep2]]+KroneckerDelta[a,1]*KroneckerDelta[b,1]*ϕ1*KroneckerProduct[Id[rep1],Id[rep2]]+KroneckerDelta[a,2]*KroneckerDelta[b,2]*ϕ2*KroneckerProduct[Id[rep1],Id[rep2]]+KroneckerDelta[a,3]*KroneckerDelta[b,3]*ϕ3*KroneckerProduct[Id[rep1],Id[rep2]]+KroneckerDelta[a,4]*KroneckerDelta[b,4]*ϕ4*KroneckerProduct[Id[rep1],Id[rep2]];",
