  {
   "kind": 2,
   "value": "ClearAll[OrthogRen22C];\nOrthogRen22C[QHL_,QL_,QHR_,QR_,rep1_,rep2_]:=OrthogRen22C[QHL,QL,QHR,QR,rep1,rep2]=(2 π I Residue[(QHL[[4]]*Wronskian[{QR[[1]],QR[[2]]},z]*((1)/((z-w1)^((rep1[[1]]-rep1[[4]]) +1) (z-w2)^((rep2[[1]]-rep2[[4]]) +1)))),{z,w1}]*2 π I Residue[(QHL[[4]]*Wronskian[{QR[[1]],QR[[2]]},z]*z*((1)/((z-w1)^((rep1[[1]]-rep1[[4]]) +1) (z-w2)^((rep2[[1]]-rep2[[4]]) +1)))),{z,w2}]-2 π I Residue[(QHL[[4]]*Wronskian[{QR[[1]],QR[[2]]},z]*((1)/((z-w1)^((rep1[[1]]-rep1[[4]]) +1) (z-w2)^((rep2[[1]]-rep2[[4]]) +1)))),{z,w2}]*2 π I Residue[(QHL[[4]]*Wronskian[{QR[[1]],QR[[2]]},z]*z*((1)/((z-w1)^((rep1[[1]]-rep1[[4]]) +1) (z-w2)^((rep2[[1]]-rep2[[4]]) +1)))),{z,w1}])/((Limit[QHL[[4]],z->w1])*(Limit[QHL[[4]],z->w2])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z],z->w1])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z],z->w2]))*\nDet[{{2 π I Residue[QHL[[3]]*D[QR[[1]],z]*(1)/(z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]))),{z,0}],2 π I Residue[QHL[[3]]*QR[[1]]*(1)/(z^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]))),{z,0}]},\n\n{2 π I Residue[QHL[[3]]*D[QR[[2]],z]*(1)/(z)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]))),{z,0}],2 π I Residue[QHL[[3]]*QR[[2]]*(1)/(z^2)*((1)/((z-w1)^(rep1[[1]]-rep1[[3]]))),{z,0}]}}]/((Limit[QHL[[3]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[D[QHL[[3]],z],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z],z->0,Direction->\"\\<FromAbove\\>\"]));",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Q2Base,QH2Base,Q1Base,QH1Base];\nClearAll[rep1T,rep2T,repAllT,Weight,QTϕ,QHTϕ,QT1ϕ,QHT1ϕ,M,W,MaxM,MaxW,KT,T,REigϕ,LEigϕ];\nClearAll[ϕ1T,ϕ1,ϕ2T,ϕ2,ϕ3T,ϕ3,ϕ4T,ϕ4,k1,k2,k3,k4];\n\n(*Create Q base*)\nQ2Base[rep1T_,rep2T_,repAllT_,Weight_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_][M_]:=Q2Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][M]=Table[{QBase[1][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],QBase[2][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],\nQBase[3][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],QBase[4][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]]},{T,1,Length[QBase[1][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T]]}];\n\nQH2Base[rep1T_,rep2T_,repAllT_,Weight_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_][M_]:=QH2Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][M]=Table[{QHBase[1][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],QHBase[2][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],\nQHBase[3][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],QHBase[4][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]]},{T,1,Length[QHBase[1][rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T]]}];\n\nQ1Base[rep1T_,rep2T_,repAllT_,Weight_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_][W_]:=Q1Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][W]=Table[{QBase1[1][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],QBase1[2][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],\nQBase1[3][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],QBase1[4][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]]},{T,1,Length[QBase1[1][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T]]}];\n\nQH1Base[rep1T_,rep2T_,repAllT_,Weight_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_][W_]:=QH1Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][W]=Table[{QHBase1[1][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],QHBase1[2][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],\nQHBase1[3][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]],QHBase1[4][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T][[T]]},{T,1,Length[QHBase1[1][rep1T,Weight[[W]],ϕ1T,ϕ2T,ϕ3T,ϕ4T]]}];\n\n(*Create Ψ base*)\nRBase[rep1T_,rep2T_,repAllT_,Weight_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_,αϕ13_,αϕ14_,αϕ23_][M_]:=RBase[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23][M]=ReEigenR[rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23]//Simplify;\n\nLBase[rep1T_,rep2T_,repAllT_,Weight_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_,αϕ13_,αϕ14_,αϕ23_][M_]:=LBase[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23][M]=ReEigenL[rep1T,rep2T,repAllT[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23]//Simplify;\n\n(*Create Ψ base*)\nRBase1P[rep1T_,rep2T_,repAllT_,Weight_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_,αϕ13_,αϕ14_,αϕ23_][M_]:=RBase1P[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23][M]=ReEigenR1[rep1T,Weight[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23]//Simplify;\n\nLBase1P[rep1T_,rep2T_,repAllT_,Weight_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_,αϕ13_,αϕ14_,αϕ23_][M_]:=LBase1P[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23][M]=ReEigenL1[rep1T,Weight[[M]],ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23]//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[TESTK22B,TESTK22C];\n(*SU(2) 1-site · SU(3) 2-sites*)\nTESTK22B[rep1T_,rep2T_,repAllT_,Weight_,MaxM_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_,αϕ13_,αϕ14_,αϕ23_,k1_,k2_,k3_,k4_][L_]:=TESTK22B[rep1T,rep2T,repAllT,Weight,MaxM,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23,k1,k2,k3,k4][L]=\nTable[\n((K22B[rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23,k1,k2,k3,k4].RBase[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23][L][[U]]//Flatten)[[1]])-μR*((OrthogRen22B[QHVac1[rep1T,k1,k2,k3,k4],QVac1[rep1T,k1,k2,k3,k4],QH2Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][L][[U]],Q2Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][L][[U]],rep1T,rep2T])/(OrthogRen22B[QHVac1[rep1T,k1,k2,k3,k4],QVac1[rep1T,k1,k2,k3,k4],QHVac2[rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T],QVac2[rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T],rep1T,rep2T])),{U,1,Dimensions[RBase[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23][L]][[1]]}];\n\n(*SU(2) 2-site · SU(3) 1-sites*)\nTESTK22C[rep1T_,rep2T_,repAllT_,Weight_,MaxM_,ϕ1T_,ϕ2T_,ϕ3T_,ϕ4T_,αϕ13_,αϕ14_,αϕ23_,k1_,k2_,k3_,k4_][L_]:=TESTK22C[rep1T,rep2T,repAllT,Weight,MaxM,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23,k1,k2,k3,k4][L]=\nTable[\n((K22C[rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23,k1,k2,k3,k4].RBase[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23][L][[U]]//Flatten)[[1]])-μR*((OrthogRen22C[QHVac1[rep1T,k1,k2,k3,k4],QVac1[rep1T,k1,k2,k3,k4],QH2Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][L][[U]],Q2Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][L][[U]],rep1T,rep2T])/(OrthogRen22C[QHVac1[rep1T,k1,k2,k3,k4],QVac1[rep1T,k1,k2,k3,k4],QHVac2[rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T],QVac2[rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T],rep1T,rep2T])),{U,1,Dimensions[RBase[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T,αϕ13,αϕ14,αϕ23][L]][[1]]}];",
   "languageId": "wolfram",
   "outputs": [],
