   "kind": 2,
   "value": "ClearAll[vecT,M,Mult,SolCartNorm,vecT2,SolF,vecT3,ExpectedRes];\nvecT=VecR[rep1T,rep2T];\nM=3;\nMult=1;\nPrint[\"\\<Rep\\>\"];\nrepAllT[[M]]\nPrint[\"\\<Imposing Cartan eigenvalues\\>\"];\nVacL[rep1T,rep2T,α12,α13,α14,α23,α24,α34];\nSolCartNorm=Solve[EMAll[1,1,rep1T,rep2T].vecT==repAllT[[M]][[1]]*vecT&&EMAll[2,2,rep1T,rep2T].vecT==repAllT[[M]][[2]]*vecT&&EMAll[3,3,rep1T,rep2T].vecT==repAllT[[M]][[3]]*vecT&&EMAll[4,4,rep1T,rep2T].vecT==repAllT[[M]][[4]]*vecT&&(((VacL[rep1T,rep2T,αr[12][ϕ1T,ϕ2T,ϕ3T,ϕ4T,α13,α14,α23],α13,α14,α23,αr[24][ϕ1T,ϕ2T,ϕ3T,ϕ4T,α13,α14,α23],αr[34][ϕ1T,ϕ2T,ϕ3T,ϕ4T,α13,α14,α23]].vecT)//Flatten)[[1]])==1,Flatten[vecT]];\nPrint[\"\\<Substituting solution\\>\"];\nvecT2=vecT/.SolCartNorm[[1]];\n\nClearAll[k1,k2,k3,k4];\nPrint[\"\\<Solution from expansion\\>\"];\nSolF=Solve[(CoefficientList[((((K22B[rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T,α13,α14,α23,k1,k2,k3,k4].vecT2)//Flatten)[[1]])//Simplify)-((OrthogRen22B[QHVac1[rep1T,k1,k2,k3,k4],QVac1[rep1T,k1,k2,k3,k4],QH2Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][M][[Mult]],Q2Base[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T][M][[Mult]],rep1T,rep2T])/(OrthogRen22B[QHVac1[rep1T,k1,k2,k3,k4],QVac1[rep1T,k1,k2,k3,k4],QHVac2[rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T],QVac2[rep1T,rep2T,ϕ1T,ϕ2T,ϕ3T,ϕ4T],rep1T,rep2T]))//Together//Numerator,{k2,k3,k4}]//Flatten)==0,Flatten[vecT]];\nvecT3=vecT2/.SolF[[1]]//Simplify;\nExpectedRes=RBase[rep1T,rep2T,repAllT,Weight,ϕ1T,ϕ2T,ϕ3T,ϕ4T,α13,α14,α23][M][[Mult]];\nvecT3==ExpectedRes//FullSimplify",
