   "value": "ClearAll[ReEigenR1,ReEigenL1];\nReEigenR1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=ReEigenR1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=ReNormR1[rep1,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],#]&/@EigenR1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4];\nReEigenL1[rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=ReEigenL1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=ReNormL1[rep1,βr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[13][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[14][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[23][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],βr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],#]&/@EigenL1[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4];",
