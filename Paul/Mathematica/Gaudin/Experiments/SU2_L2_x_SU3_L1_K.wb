  {
   "kind": 2,
   "value": "ClearAll[QPoly1Site†,Q1†,c11†,c12†,c13†,c14†];\nQPoly1Site†[c_,M_,r_][z_]:=QPoly1Site†[c,M,r][z]=Exp[r z]*(z^M+Sum[c[k]*z^k,{k,0,M-1}]);\nQ1†[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1†[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly1Site†[c11†,-rep1〚4〛+weight1〚1〛,ϕ1][z];\nQ1†[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1†[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly1Site†[c12†,-rep1〚4〛+weight1〚2〛,ϕ2][z];\nQ1†[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1†[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly1Site†[c13†,-rep1〚4〛+weight1〚3〛,ϕ3][z];\nQ1†[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q1†[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly1Site†[c14†,-rep1〚4〛+weight1〚4〛,ϕ4][z];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Bax1†];\nBax1†[1][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=Bax1†[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]=((BaxOp1†[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][Q1†[1][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[-ϕ1 z])//Simplify;\nBax1†[2][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=Bax1†[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]=((BaxOp1†[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][Q1†[2][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[-ϕ2 z])//Simplify;\nBax1†[3][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=Bax1†[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]=((BaxOp1†[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][Q1†[3][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[-ϕ3 z])//Simplify;\nBax1†[4][rep1_,weight1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=Bax1†[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4]=((BaxOp1†[rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][Q1†[4][rep1,weight1,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[-ϕ4 z])//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
