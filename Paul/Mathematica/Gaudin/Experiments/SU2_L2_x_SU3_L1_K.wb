   "value": "ClearAll[SolveBaxh†,SolveBaxAllh†];\nSolveBaxh†[1][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h24_,h33_,h34_,h36_,h43_,h44_,h45_,h46_,h48_]:=SolveBaxh†[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,h24,h33,h34,h36,h43,h44,h45,h46,h48]=Solve[CoefficientList[Bax†[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]/.{h[2,4]->h24,h[3,3]->h33,h[3,4]->h34,h[3,6]->h36,\nh[4,3]->h43,h[4,4]->h44,h[4,5]->h45,h[4,6]->h46,h[4,8]->h48}//Together//Numerator,z]==0,Vars1†[rep1,rep2,repAll]]//Simplify//Flatten;\n\nSolveBaxh†[2][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h24_,h33_,h34_,h36_,h43_,h44_,h45_,h46_,h48_]:=SolveBaxh†[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,h24,h33,h34,h36,h43,h44,h45,h46,h48]=Solve[CoefficientList[Bax†[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]/.{h[2,4]->h24,h[3,3]->h33,h[3,4]->h34,h[3,6]->h36,\nh[4,3]->h43,h[4,4]->h44,h[4,5]->h45,h[4,6]->h46,h[4,8]->h48}//Together//Numerator,z]==0,Vars2†[rep1,rep2,repAll]]//Simplify//Flatten;\n\nSolveBaxh†[3][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h24_,h33_,h34_,h36_,h43_,h44_,h45_,h46_,h48_]:=SolveBaxh†[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,h24,h33,h34,h36,h43,h44,h45,h46,h48]=Solve[CoefficientList[Bax†[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]/.{h[2,4]->h24,h[3,3]->h33,h[3,4]->h34,h[3,6]->h36,\nh[4,3]->h43,h[4,4]->h44,h[4,5]->h45,h[4,6]->h46,h[4,8]->h48}//Together//Numerator,z]==0,Vars3†[rep1,rep2,repAll]]//Simplify//Flatten;\n\nSolveBaxh†[4][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h24_,h33_,h34_,h36_,h43_,h44_,h45_,h46_,h48_]:=SolveBaxh†[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,h24,h33,h34,h36,h43,h44,h45,h46,h48]=Solve[CoefficientList[Bax†[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4]/.{h[2,4]->h24,h[3,3]->h33,h[3,4]->h34,h[3,6]->h36,\nh[4,3]->h43,h[4,4]->h44,h[4,5]->h45,h[4,6]->h46,h[4,8]->h48}//Together//Numerator,z]==0,Vars4†[rep1,rep2,repAll]]//Simplify//Flatten;\n\nSolveBaxAllh†[rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,h24_,h33_,h34_,h36_,h43_,h44_,h45_,h46_,h48_]:=SolveBaxAllh†[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,h24,h33,h34,h36,h43,h44,h45,h46,h48]=Join[SolveBaxh†[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,h24,h33,h34,h36,h43,h44,h45,h46,h48],SolveBaxh†[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,h24,h33,h34,h36,h43,h44,h45,h46,h48],SolveBaxh†[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,h24,h33,h34,h36,h43,h44,h45,h46,h48],SolveBaxh†[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,h24,h33,h34,h36,h43,h44,h45,h46,h48]]//Simplify;",
