   "value": "ClearAll[Hodge];\nHodge[Qfour_,rep1_,rep2_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,z_,i_]:=Hodge[Qfour,rep1,rep2,ϕ1,ϕ2,ϕ3,ϕ4,z,i]=\n(Exp[z*(ϕ1+ϕ2+ϕ3+ϕ4)]*Signature[Join[Complement[SetN,{i}],{i}]]*Wronskian[{Qfour[[Complement[SetN,{i}]]][[1]],Qfour[[Complement[SetN,{i}]]][[2]],Qfour[[Complement[SetN,{i}]]][[3]]},z]*(((z)^(-(2*rep1[[1]]-rep1[[2]]-rep1[[3]]))*(z-1)^(-(2*rep2[[1]]-rep2[[2]]-rep2[[3]]))))/((({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[1]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[2]]]]))*({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[1]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[3]]]])*({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[2]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[3]]]])))//Simplify;\n(*The Q argument should be Q1[z], not Q1!*)\n\n(**(((z)^(-2(rep1[[1]]-rep1[[2]]))*(z-1)^(-2(rep2[[1]]-rep2[[2]]))))*)\n(*/({ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[1]]]]-{ϕ1,ϕ2,ϕ3,ϕ4}[[Complement[SetN,{i}][[2]]]])*)",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Normalisation];\nNormalisation[QHL_,QL_,QHR_,QR_,rep1_,rep2_]:=Normalisation[QHL,QL,QHR,QR,rep1,rep2]=(Limit[QHL[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QHL[[1]],QHL[[2]]},z]*(1)/(z^(rep1[[3]]-rep1[[4]])*(z-1)^(rep2[[3]]-rep2[[4]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QL[[4]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QR[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z]*(1)/(z^(rep1[[1]]-rep1[[2]])*(z-1)^(rep2[[1]]-rep2[[2]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QHR[[4]],z->0,Direction->\"\\<FromAbove\\>\"])*\n(Limit[QHL[[1]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QHL[[1]],QHL[[2]]},z]*(1)/(z^(rep1[[3]]-rep1[[4]])*(z-1)^(rep2[[3]]-rep2[[4]])),z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[QL[[4]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[QR[[1]],z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z]*(1)/(z^(rep1[[1]]-rep1[[2]])*(z-1)^(rep2[[1]]-rep2[[2]])),z->1,Direction->\"\\<FromAbove\\>\"])*(Limit[QHR[[4]],z->1,Direction->\"\\<FromAbove\\>\"]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[OrthogRen,RawOrthogT,RawOrthog12];\nRawOrthogT[QH_,Q_,rep1_,rep2_,w_,α_,i_,j_]:=RawOrthogT[QH,Q,rep1,rep2,w,α,i,j]={MeanValue[QH[[i]]*D[Q[[j]],{z,2}]*(1)/(z-w),α,rep1,rep2],MeanValue[QH[[i]]*D[Q[[j]],{z,1}]*(1)/((z-w)^2),α,rep1,rep2],MeanValue[QH[[i]]*D[Q[[j]],{z,1}]*(1)/(z-w),α,rep1,rep2],MeanValue[QH[[i]]*Q[[j]]*(1)/((z-w)^3),α,rep1,rep2],MeanValue[QH[[i]]*Q[[j]]*(1)/((z-w)^2),α,rep1,rep2],MeanValue[QH[[i]]*Q[[j]]*(1)/(z-w),α,rep1,rep2]};\n\nRawOrthog12[QH_,Q_,rep1_,rep2_,α_,i_,j_]:=RawOrthog12[QH,Q,rep1,rep2,α,i,j]=Join[RawOrthogT[QH,Q,rep1,rep2,0,α,i,j],RawOrthogT[QH,Q,rep1,rep2,1,α,i,j]];\n\nOrthogRen[QHL_,QL_,QHR_,QR_,rep1_,rep2_]:=OrthogRen[QHL,QL,QHR,QR,rep1,rep2]=(1/Normalisation[QHL,QL,QHR,QR,rep1,rep2])*Det[{RawOrthog12[QHL,QR,rep1,rep2,0,1,1],RawOrthog12[QHL,QR,rep1,rep2,0,1,2],RawOrthog12[QHL,QR,rep1,rep2,0,2,1],RawOrthog12[QHL,QR,rep1,rep2,0,2,2],RawOrthog12[QHL,QR,rep1,rep2,0,1,3],RawOrthog12[QHL,QR,rep1,rep2,0,3,1],RawOrthog12[QHL,QR,rep1,rep2,1,1,1],RawOrthog12[QHL,QR,rep1,rep2,1,1,2],RawOrthog12[QHL,QR,rep1,rep2,1,2,1],RawOrthog12[QHL,QR,rep1,rep2,1,2,2],RawOrthog12[QHL,QR,rep1,rep2,1,1,3],RawOrthog12[QHL,QR,rep1,rep2,1,3,1]}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Normalisation1];\nNormalisation1[QHL_,QL_,QHR_,QR_,rep1_]:=Normalisation1[QHL,QL,QHR,QR,rep1]=(Limit[QHL[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QHL[[1]],QHL[[2]]},z]*(1)/(z^(rep1[[3]]-rep1[[4]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QL[[4]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QR[[1]],z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[Wronskian[{QR[[1]],QR[[2]]},z]*(1)/(z^(rep1[[1]]-rep1[[2]])),z->0,Direction->\"\\<FromAbove\\>\"])*(Limit[QHR[[4]],z->0,Direction->\"\\<FromAbove\\>\"]);",
