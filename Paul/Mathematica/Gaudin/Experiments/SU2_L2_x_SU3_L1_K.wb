   "value": "ClearAll[matteoGenericExpected,matteoGenericSolution,matteoGenericResiduals];\nmatteoGenericExpected={{c2[0]->6,c2[1]->-4,c3[0]->35/8,c3[1]->-7/2,c4[0]->35/9,c4[1]->-10/3,h[2,4]->71/105,h[3,3]->-142/105,h[3,4]->-142/105,h[3,6]->1/7,h[4,3]->142/105,h[4,4]->142/105,h[4,5]->-1/7,h[4,6]->-1/7,h[4,8]->1/105}};\nmatteoGenericSolution=SolveBaxAll[FUNDAMENTAL,FUNDAMENTAL,{2,0,0,0},1,1/3,1/5,1/7,1,1];\nmatteoGenericResiduals=Table[Factor[Bax[k][FUNDAMENTAL,FUNDAMENTAL,{2,0,0,0},1,1/3,1/5,1/7,1,1]/.First[matteoGenericSolution]],{k,4}];\n<|\"SavedSolutionReproduced\"->(matteoGenericSolution===matteoGenericExpected),\"AllBaxterResidualsZero\"->AllTrue[matteoGenericResiduals,PossibleZeroQ],\"TwoSiteSolverSurvivesOneSiteLoad\"->(Length[matteoGenericSolution]===1)|>",
