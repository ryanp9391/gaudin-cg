   "kind": 2,
   "value": "ClearAll[UntwistedSU2IntegralMatrix,UntwistedSU2Norm,UntwistedSU3IntegralMatrix,UntwistedSU3Norm,UntwistedIntegralPieces];\nUntwistedSU2IntegralMatrix[qhl_,qr_,rep1_,rep2_]:=Module[{zz=Global`z,wr},\n wr=Wronskian[{qr[[1]],qr[[2]]},zz];\n Table[2 Pi I Residue[qhl[[4]] wr zz^(column-1)/(zz^(rep1[[1]]-rep1[[4]]+1) (zz-1)^(rep2[[1]]-rep2[[4]]+1)),{zz,{0,1}[[row]]}],{row,1,2},{column,1,2}]];\nUntwistedSU2Norm[qhl_,qr_]:=Module[{zz=Global`z,wr=Wronskian[{qr[[1]],qr[[2]]},Global`z]},Product[(qhl[[4]]/.zz->site) (wr/.zz->site),{site,{0,1}}]];\nUntwistedSU3IntegralMatrix[qhl_,qr_,rep1_]:=Module[{zz=Global`z,power=rep1[[1]]-rep1[[3]]},\n Table[{2 Pi I Residue[qhl[[3]] D[qr[[row]],zz]/zz^(power+1),{zz,0}],2 Pi I Residue[qhl[[3]] qr[[row]]/zz^(power+2),{zz,0}]},{row,1,2}]];\nUntwistedSU3Norm[qhl_,qr_]:=Module[{zz=Global`z,wr=Wronskian[{qr[[1]],qr[[2]]},Global`z]},(qhl[[3]]/.zz->0) (D[qhl[[3]],zz]/.zz->0) (wr/.zz->0)];\nUntwistedIntegralPieces[qhl_,qr_]:=Module[{matrix2=UntwistedSU2IntegralMatrix[qhl,qr,ConcreteRep,ConcreteRep],matrix3=UntwistedSU3IntegralMatrix[qhl,qr,ConcreteRep]},\n <|\"SU2Matrix\"->matrix2,\"SU2Det\"->Det[matrix2],\"SU2Norm\"->UntwistedSU2Norm[qhl,qr],\"SU3Matrix\"->matrix3,\"SU3Det\"->Det[matrix3],\"SU3Norm\"->UntwistedSU3Norm[qhl,qr]|>];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[LeadingTaylorDatum,UntwistedLeadingPieces,UntwistedScalarLeading];\nLeadingTaylorDatum[expression_,delta_,maxOrder_:8]:=FirstCase[Table[{order,FullSimplify[Coefficient[Expand[expression],delta,order]]},{order,0,maxOrder}],{order_,coefficientValue_}/;!PossibleZeroQ[coefficientValue]];\nUntwistedLeadingPieces[pieces_,delta_]:=AssociationMap[LeadingTaylorDatum[pieces[#],delta]&,{\"SU2Det\",\"SU2Norm\",\"SU3Det\",\"SU3Norm\"}];\nUntwistedScalarLeading[data_]:=Module[{d2=data[\"SU2Det\"],n2=data[\"SU2Norm\"],d3=data[\"SU3Det\"],n3=data[\"SU3Norm\"]},\n <|\"Order\"->d2[[1]]-n2[[1]]+d3[[1]]-n3[[1]],\"Coefficient\"->FullSimplify[d2[[2]] d3[[2]]/(n2[[2]] n3[[2]])]|>];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[untwistedStatePieces,untwistedVacuumPieces,untwistedStateLeading,untwistedVacuumLeading,untwistedStateScalar,untwistedVacuumScalar,ConcreteProjectivePivot,untwistedPivotLeading,UntwistedQIntegralOverlap,UntwistedKVectorOverlap];\nuntwistedStatePieces=UntwistedIntegralPieces[ConcreteDualQJet[delta],ConcreteStateQJet[delta]];\nuntwistedVacuumPieces=UntwistedIntegralPieces[ConcreteDualQJet[delta],ConcreteVacuumQJet[delta]];\nuntwistedStateLeading=UntwistedLeadingPieces[untwistedStatePieces,delta];\nuntwistedVacuumLeading=UntwistedLeadingPieces[untwistedVacuumPieces,delta];\nuntwistedStateScalar=UntwistedScalarLeading[untwistedStateLeading];\nuntwistedVacuumScalar=UntwistedScalarLeading[untwistedVacuumLeading];\nConcreteProjectivePivot[delta_]:=-26/(5 (-2+delta+Sqrt[4+delta^2]));\nuntwistedPivotLeading=<|\"Order\"->-1,\"Coefficient\"->Limit[delta ConcreteProjectivePivot[delta],delta->0]|>;\nUntwistedQIntegralOverlap=FullSimplify[(untwistedStateScalar[\"Coefficient\"]/untwistedVacuumScalar[\"Coefficient\"])/untwistedPivotLeading[\"Coefficient\"]];\nUntwistedKVectorOverlap=FullSimplify[First[ConcreteK2Paul[1].concretePaulLimit]];\n<|\"StateLeadingPieces\"->untwistedStateLeading,\"VacuumLeadingPieces\"->untwistedVacuumLeading,\"StateScalarLeading\"->untwistedStateScalar,\"VacuumScalarLeading\"->untwistedVacuumScalar,\"PivotLeading\"->untwistedPivotLeading,\"NetOrder\"->untwistedStateScalar[\"Order\"]-untwistedVacuumScalar[\"Order\"]-untwistedPivotLeading[\"Order\"],\"QIntegralOverlap\"->UntwistedQIntegralOverlap,\"KVectorOverlap\"->UntwistedKVectorOverlap,\"DirectUntwistedAgreement\"->TrueQ[UntwistedQIntegralOverlap==UntwistedKVectorOverlap]|>",
   "languageId": "wolfram",
