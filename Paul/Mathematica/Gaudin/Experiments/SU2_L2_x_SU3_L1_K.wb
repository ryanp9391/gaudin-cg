  {
   "kind": 2,
   "value": "ClearAll[QPoly,Q,c1,c2,c3,c4];\nQPoly[c_,M_,r_][z_]:=QPoly[c,M,r][z]=Exp[r z]*(z^M+Sum[c[k]*z^k,{k,0,M-1}]);\nQ[1][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly[c1,rep1〚1〛+rep2〚1〛-repAll〚1〛,-ϕ1][z];\nQ[2][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly[c2,rep1〚1〛+rep2〚1〛-repAll〚2〛,-ϕ2][z];\nQ[3][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly[c3,rep1〚1〛+rep2〚1〛-repAll〚3〛,-ϕ3][z];\nQ[4][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_][z]:=Q[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]=QPoly[c4,rep1〚1〛+rep2〚1〛-repAll〚4〛,-ϕ4][z];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Bax];\nBax[1][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_,C2_]:=Bax[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2]=((BaxOp[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][Q[1][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ1 z])//Simplify;\nBax[2][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_,C2_]:=Bax[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2]=((BaxOp[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][Q[2][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ2 z])//Simplify;\nBax[3][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_,C2_]:=Bax[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2]=((BaxOp[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][Q[3][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ3 z])//Simplify;\nBax[4][rep1_,rep2_,repAll_,ϕ1_,ϕ2_,ϕ3_,ϕ4_,C1_,C2_]:=Bax[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2]=((BaxOp[rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4,C1,C2][Q[4][rep1,rep2,repAll,ϕ1,ϕ2,ϕ3,ϕ4][z]])*Exp[ϕ4 z])//Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Vars1,Vars2,Vars3,Vars4];\nVars1[rep1_,rep2_,repAll_]:=Vars1[rep1,rep2,repAll]=Table[c1[n],{n,0,rep1〚1〛+rep2〚1〛-repAll〚1〛-1}];\nVars2[rep1_,rep2_,repAll_]:=Vars2[rep1,rep2,repAll]=Table[c2[n],{n,0,rep1〚1〛+rep2〚1〛-repAll〚2〛-1}];\nVars3[rep1_,rep2_,repAll_]:=Vars3[rep1,rep2,repAll]=Table[c3[n],{n,0,rep1〚1〛+rep2〚1〛-repAll〚3〛-1}];\nVars4[rep1_,rep2_,repAll_]:=Vars4[rep1,rep2,repAll]=Table[c4[n],{n,0,rep1〚1〛+rep2〚1〛-repAll〚4〛-1}];",
   "languageId": "wolfram",
