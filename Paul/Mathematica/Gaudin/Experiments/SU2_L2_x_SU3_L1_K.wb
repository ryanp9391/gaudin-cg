  {
   "kind": 2,
   "value": "ClearAll[QVac1,QHVac1,QvQv1,QvQv1ωϕ];\n(*QvQv*)\n(*VACUUM STATES*)\nQVac1[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QVac1[rep1,ϕ1,ϕ2,ϕ3,ϕ4]={QBase1[1][rep1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QBase1[2][rep1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QBase1[3][rep1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QBase1[4][rep1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][[1]]};\nQHVac1[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QHVac1[rep1,ϕ1,ϕ2,ϕ3,ϕ4]={QHBase1[1][rep1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QHBase1[2][rep1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QHBase1[3][rep1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][[1]],QHBase1[4][rep1,rep1,ϕ1,ϕ2,ϕ3,ϕ4][[1]]};\n\nQvQv1[rep1_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QvQv1[rep1,ϕ1,ϕ2,ϕ3,ϕ4]=OrthogRen1[QHVac1[rep1,ϕ1,ϕ2,ϕ3,ϕ4],QVac1[rep1,ϕ1,ϕ2,ϕ3,ϕ4],QHVac1[rep1,ϕ1,ϕ2,ϕ3,ϕ4],QVac1[rep1,ϕ1,ϕ2,ϕ3,ϕ4],rep1];\n\nQvQv1ωϕ[rep1_,ω1_,ω2_,ω3_,ω4_,ϕ1_,ϕ2_,ϕ3_,ϕ4_]:=QvQv1ωϕ[rep1,ω1,ω2,ω3,ω4,ϕ1,ϕ2,ϕ3,ϕ4]=OrthogRen1[QHVac1[rep1,ω1,ω2,ω3,ω4],QVac1[rep1,ω1,ω2,ω3,ω4],QHVac1[rep1,ϕ1,ϕ2,ϕ3,ϕ4],QVac1[rep1,ϕ1,ϕ2,ϕ3,ϕ4],rep1];",
