  {
   "kind": 2,
   "value": "ClearAll[βr,α12,α13,α14,α23,α24,α34,ϕ1,ϕ2,ϕ3,ϕ4];\nβr[12][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[12][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[13][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[13][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[13][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[14][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[14][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[14][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[23][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[23][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[23][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[24][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[24][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];\nβr[34][ϕ1_,ϕ2_,ϕ3_,ϕ4_,α13_,α14_,α23_]:=βr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]=βrT[34][ϕ1,ϕ2,ϕ3,ϕ4,αr[12][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],α13,α14,α23,αr[24][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23],αr[34][ϕ1,ϕ2,ϕ3,ϕ4,α13,α14,α23]];",
