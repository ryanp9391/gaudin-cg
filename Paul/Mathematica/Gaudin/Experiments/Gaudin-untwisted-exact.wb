2; sectors\"}` | `{1, 3}` |  |  |  |  |  |\n| `{{2, 2, 0}, \"time\"}` | `2 ms` |  |  |  |  |  |\n| `{{3, 1, 0}, \"HW kets annihilated by E12tot, E23tot (all sectors)\"}` | `True` |  |  |  |  |  |\n| `{{3, 1, 0}, \"dimension count: Sum mult*dim(mu) = d^2\"}` | `{225, 225}` |  |  |  |  |  |\n| `{{3, 1, 0}, \"all sectors have mult <= 2; sectors\"}` | `{2, 8}` |  |  |  |  |  |\n| `{{3, 1, 0}, \"time\"}` | `48 ms` |  |  |  |  |  |\n| `{{3, 2, 0}, \"HW kets annihilated by E12tot, E23tot (all sectors)\"}` | `True` |  |  |  |  |  |\n| `{{3, 2, 0}, \"dimension count: Sum mult*dim(mu) = d^2\"}` | `{225, 225}` |  |  |  |  |  |\n| `{{3, 2, 0}, \"all sectors have mult <= 2; sectors\"}` | `{2, 8}` |  |  |  |  |  |\n| `{{3, 2, 0}, \"time\"}` | `39 ms` |  |  |  |  |  |\n| `{{4, 1, 0}, \"HW kets annihilated by E12tot, E23tot (all sectors)\"}` | `True` |  |  |  |  |  |\n| `{{4, 1, 0}, \"dimension count: Sum mult*dim(mu) = d^2\"}` | `{576, 576}` |  |  |  |  |  |\n| `{{4, 1, 0}, \"all sectors have mult <= 2; sectors\"}` | `{2, 11}` |  |  |  |  |  |\n| `{{4, 1, 0}, \"time\"}` | `346 ms` |  |  |  |  |  |",
