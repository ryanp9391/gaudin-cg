  {
   "kind": 1,
   "value": "## E2. Untwisted Laurent data H_s, a_s, b_s on every HW sector, Casimirs, theta-scaling",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* E2. Untwisted (zeta = 0, g = 0) Laurent data of S2, S3 on every HW sector, applied directly to the exact HW kets (matrix-vector products only; no 576x576 operator is ever formed). S2 = Sum_s [H_s/(u-th_s) + c2/(u-th_s)^2], S3 = Sum_s [b_s/(u-th_s) + a_s/(u-th_s)^2] are fitted exactly from 9 rational u samples and verified at the spare samples. The HW space is invariant: A.H = H.M exactly; M (m x m, m = multiplicity) is read off with LinearSolve (consistency = invariance). Scaling in theta12 is checked at three theta points. *)\nck = <||>;\nuSam = {7/13, -2/9, 5/11, 1/3, -4/5, 6/7, 7/3, 9/5, -3/2};\nbas2[ths_, u_] := {1, 1/(u - ths[[1]]), 1/(u - ths[[1]])^2, 1/(u - ths[[2]]), 1/(u - ths[[2]])^2};\nbas3[ths_, u_] := {1, 1/(u - ths[[1]]), 1/(u - ths[[1]])^2, 1/(u - ths[[1]])^3, 1/(u - ths[[2]]), 1/(u - ths[[2]])^2, 1/(u - ths[[2]])^3};\n(* apply one symbol (l, lp, lpp with indices) of the Lax matrix to a block of column vectors X *)\nlApply[R_, sym_, g_, ths_, u_, X_] := Module[{i = sym[[1]], j = sym[[2]], a, b},\n  a = R[\"E1\"][[i, j]] . X; b = R[\"E2\"][[i, j]] . X;\n  Switch[Head[sym], l, g[[i, j]] X + a/(u - ths[[1]]) + b/(u - ths[[2]]), lp, -a/(u - ths[[1]])^2 - b/(u - ths[[2]])^2, lpp, 2 a/(u - ths[[1]])^3 + 2 b/(u - ths[[2]])^3]];\nskApply[R_, 2, g_, ths_, u_, X_] := Total[Table[t[[1]] Fold[lApply[R, #2, g, ths, u, #1] &, X, Reverse[t[[2]]]], {t, Ssym2}]];\nskApply[R_, 3, g_, ths_, u_, X_] := Total[Table[t[[1]] Fold[lApply[R, #2, g, ths, u, #1] &, X, Reverse[t[[2]]]], {t, Ssym3}]];\n(* exact Laurent fit of the block-valued functions *)\nfitL[R_, kk_, bas_, g_, ths_, X_] := Module[{nb = Length[bas[ths, uSym]], pts, Ainv, vals, cs, resid},\n  pts = Take[uSam, nb]; Ainv = Inverse[Table[bas[ths, p], {p, pts}]];\n  vals = Table[skApply[R, kk, g, ths, p, X], {p, pts}];\n  cs = Table[Sum[Ainv[[j, k]] vals[[k]], {k, nb}], {j, nb}];\n  resid = Table[Total[Table[bas[ths, p][[j]] cs[[j]], {j, nb}]] - skApply[R, kk, g, ths, p, X], {p, Drop[uSam, nb]}];\n  {cs, resid}];\nlaurentX[R_, g_, ths_, X_] := Module[{f2 = fitL[R, 2, bas2, g, ths, X], f3 = fitL[R, 3, bas3, g, ths, X]},\n  <|\"S2inf\" -> f2[[1, 1]], \"H\" -> {f2[[1, 2]], f2[[1, 4]]}, \"c2\" -> {f2[[1, 3]], f2[[1, 5]]}, \"S3inf\" -> f3[[1, 1]], \"b\" -> {f3[[1, 2]], f3[[1, 5]]}, \"a\" -> {f3[[1, 3]], f3[[1, 6]]}, \"tri\" -> {f3[[1, 4]], f3[[1, 7]]},\n   \"resid\" -> Join[f2[[2]], f3[[2]]]|>];\n(* sector data *)\nhwBlock[Lam_, mu_] := Transpose[embed[Lam, mu, #] & /@ hwK[Lam, mu]];\n(* coordinates of a block of vectors in the HW basis: X = Hblock.M, solved on the weight sector, consistency and zero off-sector checked *)\ntoHW[Lam_, mu_, X_] := Module[{sec = secOf[Lam, mu], Hs = Transpose[hwK[Lam, mu]], Xs, M},\n  Xs = X[[sec]]; M = LinearSolve[Hs, Xs];\n  {M, Hs . M === Xs && Union[Flatten[Delete[X, List /@ sec]]] === {0}}];\ncasX[R_, 2, X_] := Total[Table[(R[\"E1\"][[i, k]] + R[\"E2\"][[i, k]]) . ((R[\"E1\"][[k, i]] + R[\"E2\"][[k, i]]) . X), {i, 3}, {k, 3}], 2];\ncasX[R_, 3, X_] := Total[Table[(R[\"E1\"][[i, j]] + R[\"E2\"][[i, j]]) . ((R[\"E1\"][[j, k]] + R[\"E2\"][[j, k]]) . ((R[\"E1\"][[k, i]] + R[\"E2\"][[k, i]]) . X)), {i, 3}, {j, 3}, {k, 3}], 3];\ncas1[R_, 2] := With[{E = R[\"Ee\"], e = UnitVector[R[\"d1\"], 1]}, Total[Table[E[[i, k]] . (E[[k, i]] . e), {i, 3}, {k, 3}], 2][[1]]];\ncas1[R_, 3] := With[{E = R[\"Ee\"], e = UnitVector[R[\"d1\"], 1]}, Total[Table[E[[i, j]] . (E[[j, k]] . (E[[k, i]] . e)), {i, 3}, {j, 3}, {k, 3}], 3][[1]]];\nthPts = {{2/7, -3/5}, {1, 0}, {3/7, -1/4}};\nlauData = <||>;\ntab = {};\nDo[Module[{R = build[Lam], t0 = AbsoluteTime[], c1, c2l, lamT = Total[Lam], okInv = True, okScal = True, okFit = True, okTri = True, okC2 = True, okEta = True, okCas = True, okS2inf = True},\n  c1 = {cas1[R, 2], cas1[R, 3]};\n  ck[{Lam, \"one-site Casimirs cas2(Lam), cas3(Lam); c2 = lam2(lam1+1)\"}] = {c1, Lam[[2]] (Lam[[1]] + 1)};\n  Do[Module[{Hb = hwBlock[Lam, mu], m = Length[hwK[Lam, mu]], dat, per = {}, cs2, cs3, cas},\n    cs2 = toHW[Lam, mu, casX[R, 2, Hb]]; cs3 = toHW[Lam, mu, casX[R, 3, Hb]];\n    okCas = okCas && cs2[[2]] && cs3[[2]] && cs2[[1]] === cs2[[1, 1, 1]] IdentityMatrix[m] && cs3[[1]] === cs3[[1, 1, 1]] IdentityMatrix[m];\n    cas = {cs2[[1, 1, 1]], cs3[[1, 1, 1]]};\n    Do[Module[{ths = thPts[[ip]], LD, th12, conv},\n      th12 = ths[[1]] - ths[[2]];\n      LD = laurentX[R, ConstantArray[0, {3, 3}], ths, Hb];\n      okFit = okFit && (Union[Flatten[LD[\"resid\"]]] === {0});\n      conv = Association[Table[key -> If[ListQ[LD[key]] && Length[LD[key]] == 2, toHW[Lam, mu, #] & /@ LD[key], toHW[Lam, mu, LD[key]]], {key, {\"S2inf\", \"H\", \"c2\", \"S3inf\", \"b\", \"a\", \"tri\"}}]];\n      okInv = okInv && And @@ Flatten[{conv[\"S2inf\"][[2]], conv[\"S3inf\"][[2]], conv[#][[All, 2]] & /@ {\"H\", \"c2\", \"b\", \"a\", \"tri\"}}];\n      okS2inf = okS2inf && conv[\"S2inf\"][[1]] === ConstantArray[0, {m, m}] && conv[\"S3inf\"][[1]] === ConstantArray[0, {m, m}];\n      okTri = okTri && (And @@ (#[[1]] === ConstantArray[0, {m, m}] & /@ conv[\"tri\"]));\n      okC2 = okC2 && (And @@ (#[[1]] === Lam[[2]] (Lam[[1]] + 1) IdentityMatrix[m] & /@ conv[\"c2\"]));\n      AppendTo[per, <|\"th\" -> ths, \"eta\" -> (conv[\"H\"][[All, 1]] th12), \"A\" -> (conv[\"a\"][[All, 1]] th12), \"B\" -> (conv[\"b\"][[All, 1]] th12^2)|>]], {ip, 3}];\n    okScal = okScal && (per[[1, \"eta\"]] === per[[2, \"eta\"]] === per[[3, \"eta\"]]) && (per[[1, \"A\"]] === per[[2, \"A\"]] === per[[3, \"A\"]]) && (per[[1, \"B\"]] === per[[2, \"B\"]] === per[[3, \"B\"]]);\n    okEta = okEta && (per[[1, \"eta\"]][[1]] === (lamT^2 - (cas[[1]] - 2 c1[[1]])/2) IdentityMatrix[m]) && (per[[1, \"eta\"]][[2]] === -per[[1, \"eta\"]][[1]]);\n    lauData[{Lam, mu}] = <|\"mult\" -> m, \"cas2\" -> cas[[1]], \"cas3\" -> cas[[2]], \"eta\" -> per[[1, \"eta\"]], \"A\" -> per[[1, \"A\"]], \"B\" -> per[[1, \"B\"]]|>;\n    AppendTo[tab, {ToString[Lam, InputForm], ToString[mu, InputForm], m, cas[[1]], cas[[2]], ToString[If[m == 1, per[[1, \"eta\"]][[All, 1, 1]], per[[1, \"eta\"]][[1, 1, 1]]], InputForm], ToString[If[m == 1, per[[1, \"A\"]][[All, 1, 1]], per[[1, \"A\"]]], InputForm], ToString[If[m == 1, per[[1, \"B\"]][[All, 1, 1]], per[[1, \"B\"]]], InputForm]}]], {mu, hwSecsOf[Lam]}];\n  ck[{Lam, \"(i) fits exact at spare samples (ii) HW space invariant (iii) S2inf = S3inf = 0 at zeta = 0 (iv) no triple pole (v) c2 = lam2(lam1+1) scalar (vi) Casimirs scalar on HW space\"}] = {okFit, okInv, okS2inf, okTri, okC2, okCas};\n  ck[{Lam, \"theta12 scaling: eta, A, B (theta12-scaled) identical at 3 theta points\"}] = okScal;\n  ck[{Lam, \"H1 = (|Lam|^2 - (cas2(mu) - 2 cas2(Lam))/2)/theta12, H2 = -H1\"}] = okEta;\n  ck[{Lam, \"time\"}] = ToString[Round[1000 (AbsoluteTime[] - t0)]] <> \" ms\"], {Lam, repList}];\nchecks = Join[checks, ck];\nGrid[Join[{{\"Lam\", \"mu\", \"mult\", \"cas2(mu)\", \"cas3(mu)\", \"eta_s = theta12 H_s (mult 1: s=1,2; mult 2: eta_1 scalar)\", \"A_s = theta12 a_s\", \"B_s = theta12^2 b_s\"}}, tab, List @@@ Normal[ck] /. {a_, b_} :> {a, b}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
