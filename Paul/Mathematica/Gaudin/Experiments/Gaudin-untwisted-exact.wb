`phi' a1 orders 0..5` | `{210/31, 267/176, 49197/2168320, 0, -25010229693/329112813568000, 0}` |\n| `{{3, 3, 0}, 1}` | `phi' H1 orders 0..5` | `{210/31, 1647/880, 29791/448000, 0, -27512614111/14049280000000, 0}` |\n| `{{3, 3, 0}, 1}` | `phi' a1 orders 0..5` | `{0, 21/11, 0, 0, 0, 0}` |\n| `{{3, 2, 1}, 1}` | `phi' H1 orders 0..5` | `{315/31, (3447/55 - 1017/(110*Sqrt[5]))/36, 3081679/84700000, 117606219/(20380937500*Sqrt[5]), -35052849883217/1076113500000000000, -25068181719055654111/(248582218500000000000000*Sqrt[5])}` |\n| `{{3, 2, 1}, 1}` | `phi' a1 orders 0..5` | `{(9450/31 - (1890*Sqrt[5])/31)/36, (53973/1100 + 7209/(220*Sqrt[5]))/36, (59244813/42350000 - 59032773/(21175000*Sqrt[5]))/36, (-1420487983899/16304750000000 + 31672116177/(163047500000*Sqrt[5]))/36, (-28953925361951/1255465750000000000 + 999773582048037/(251093150000000000*Sqrt[5]))/36, (773904908209354615117/483354313750000000000000 - 942599116058851694393/(290012588250000000000000*Sqrt[5]))/36}` |\n| `{{3, 2, 1}, 2}` | `phi' H1 orders 0..5` | `{315/31, (3447/55 + 1017/(110*Sqrt[5]))/36, 3081679/84700000, -117606219/(20380937500*Sqrt[5]), -35052849883217/1076113500000000000, 25068181719055654111/(248582218500000000000000*Sqrt[5])}` |\n| `{{3, 2, 1}, 2}` | `phi' a1 orders 0..5` | `{(9450/31 + (1890*Sqrt[5])/31)/36, (53973/1100 - 7209/(220*Sqrt[5]))/36, (59244813/42350000 + 59032773/(21175000*Sqrt[5]))/36, (-1420487983899/16304750000000 - 31672116177/(163047500000*Sqrt[5]))/36, (-28953925361951/1255465750000000000 - 999773582048037/(251093150000000000*Sqrt[5]))/36, (773904908209354615117/483354313750000000000000 + 942599116058851694393/(290012588250000000000000*Sqrt[5]))/36}` |\n| `{{2, 2, 2}, 1}` | `phi' H1 orders 0..5` | `{420/31, 269/220, 747193/5808000, 0, -17307218756719/9445201920000000, 0}` |\n| `{{2, 2, 2}, 1}` | `phi' a1 orders 0..5` | `{420/31, 269/440, 747193/3872000, -49419262591/3756614400000, -17307218756719/6296801280000000, 1144697539267868953/1666133618688000000000}` |",
