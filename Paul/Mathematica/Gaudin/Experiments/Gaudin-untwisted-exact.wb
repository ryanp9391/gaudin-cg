ent <x(phi)(x)x(phi)\\|Psi_kB> (unnormalised) and Psi_0 G-norm^2 (divide by its Sqrt)` | `(-5766*(3 + Sqrt[5])*p2^3*p3)/6125 + (5766*(3 + Sqrt[5])*p2^2*p3^2)/6125 + p1^3*((5766*(3 + Sqrt[5])*p2)/6125 - (5766*(3 + Sqrt[5])*p3)/6125) + p1^2*((-11532*(3 + Sqrt[5])*p2^2)/6125 + (5766*(3 + Sqrt[5])*p2*p3)/6125 + (5766*(3 + Sqrt[5])*p3^2)/6125) + p1*((5766*(3 + Sqrt[5])*p2^3)/6125 + (5766*(3 + Sqrt[5])*p2^2*p3)/6125 - (11532*(3 + Sqrt[5])*p2*p3^2)/6125)` | `7560 + 3240*Sqrt[5]` |\n| `{{3, 2, 1}, 2}` | `slices s_n[nu] = Psi_n(nu,1), n = 0,1,2, nu = 1..8 (unnormalised, intermediate normalisation)` | `{{0, 0, 0, 21 + 9*Sqrt[5], -3*(1 + Sqrt[5]), 0, 0, 0}, {0, 0, 0, (31*(105 + 41*Sqrt[5])*p1)/875 - (62*(30 + 11*Sqrt[5])*p2)/875 - (31*(45 + 19*Sqrt[5])*p3)/875, (-31*(25 + 13*Sqrt[5])*p1)/875 + (62*(25 + 8*Sqrt[5])*p2)/875 - (31*(25 + 3*Sqrt[5])*p3)/875, 0, 0, 0}, {0, 0, 0, (961*(157 + 75*Sqrt[5])*p1^2)/459375 - (961*(77 + 15*Sqrt[5])*p2^2)/459375 + (1922*(151 + 60*Sqrt[5])*p2*p3)/459375 - (1922*(34 + 15*Sqrt[5])*p3^2)/459375 + p1*((-1922*(74 + 45*Sqrt[5])*p2)/459375 - (1922*(83 + 30*Sqrt[5])*p3)/459375), (-961*(61 + 23*Sqrt[5])*p1^2)/459375 - (961*(79 + 37*Sqrt[5])*p2^2)/459375 + (1922*(2 + 11*Sqrt[5])*p2*p3)/459375 - (1922*(-7 + 4*Sqrt[5])*p3^2)/459375 + p1*((1922*(77 + 26*Sqrt[5])*p2)/459375 - (1922*(16 + 3*Sqrt[5])*p3)/459375), 0, 0, 0}}` |  |\n| `{{3, 2, 1}, 2}` | `chat <phi_u (x) e1\\|Psi_0> (unnormalised Psi_0) as a polynomial in (w1, w1')` | `-12*o2^3*(p1 - p2)^2*(p1 - p3)*(p2 - p3)*p3 - 6*o2^2*(p1 - p2)^2*((5 + 3*Sqrt[5])*p2 - 2*p3)*(p1 - p3)*(p2 - p3)*p3 + 6*(5 + 3*Sqrt[5])*o2*(p1 - p2)^2*p2*(p1 - p3)*(p2 - p3)*p3^2 + o1^3*(6*(7 + 3*Sqrt[5])*o2*(p1 - p2)^2*(p1 - p3)*(p2 - p3) - 6*(7 + 3*Sqrt[5])*(p1 - p2)^2*(p1 - p3)*(p2 - p3)*p3) + o1*(12*o2^3*(p1 - p2)^2*(p1 - p3)*(p2 - p3) - 18*(3 + Sqrt[5])*o2*(p1 - p2)^2*(p1 - p3)*(p2 - p3)*p3^2 - 6*(5 + 3*Sqrt[5])*(p1 - p2)^2*p2*(p1 - p3)*(p2 - p3)*p3^2 + 6*o2^2*(p1 - p2)^2*(p1 - p3)*(p2 - p3)*((5 + 3*Sqrt[5])*p2 + (7 + 3*Sqrt[5