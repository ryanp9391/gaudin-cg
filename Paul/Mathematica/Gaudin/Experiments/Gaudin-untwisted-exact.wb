 |  |  |  |\n| `{{{3, 2, 1}, 1}, \"symbolic series == numeric series at phiA (all six, orders 0..3) and psi_0..psi_3\"}` | `True` |  |  |  |\n| `{{{3, 2, 1}, 1}, \"symbolic series == fresh numeric run at phiB\"}` | `True` |  |  |  |\n| `{{{3, 2, 1}, 2}, \"symbolic series == numeric series at phiA (all six, orders 0..3) and psi_0..psi_3\"}` | `True` |  |  |  |\n| `{{{3, 2, 1}, 2}, \"symbolic series == fresh numeric run at phiB\"}` | `True` |  |  |  |\n| `{{{2, 2, 2}, 1}, \"symbolic series == numeric series at phiA (all six, orders 0..3) and psi_0..psi_3\"}` | `True` |  |  |  |\n| `{{{2, 2, 2}, 1}, \"symbolic series == fresh numeric run at phiB\"}` | `True` |  |  |  |",
