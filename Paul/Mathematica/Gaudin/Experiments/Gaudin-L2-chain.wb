213` | `{5, 1, 2}` | `6` | `362.48718288731943282937789672` | `-189.16624151577697608420811621` |\n| `214` | `{5, 2, 1}` | `1` | `359.14053929222675453954153786` | `60.84921487133546156343559029` |\n| `215` | `{5, 2, 1}` | `2` | `310.47695697244034955136070143` | `16.93883821662160114622477804` |\n| `216` | `{5, 2, 1}` | `3` | `310.60016974778638326696726967` | `13.69181525427237009710629914` |\n| `217` | `{5, 2, 1}` | `4` | `337.94429187271211936712890901` | `-3.07495645728474932376800107` |\n| `218` | `{5, 2, 1}` | `5` | `324.61797164647023816616594971` | `-28.18928277104298304147757448` |\n| `219` | `{5, 2, 1}` | `6` | `357.87747787577156251624303972` | `-180.10275758086753089134808154` |\n| `220` | `{5, 3, 0}` | `1` | `308.41164548585682492823503051` | `11.86671542856221653750137036` |\n| `221` | `{5, 3, 0}` | `2` | `335.67554587216786642978966085` | `-2.05162027285287397694773714` |\n| `222` | `{6, 0, 2}` | `1` | `312.08641975308641975308641975` | `19.54660805038927335640138408` |\n| `223` | `{6, 1, 1}` | `1` | `309.53776747627994777469437522` | `16.39390472929103632753019699` |\n| `224` | `{6, 1, 1}` | `2` | `323.59572017804103987962661243` | `-28.96142946436889099881047381` |\n| `225` | `{6, 2, 0}` | `1` | `307.43595679012345679012345679` | `11.79955125432525951557093426` |",
