4*^-200` | `4.000000145559486*^-200` | `4.000000291118714*^-200` | `4.0000005822369243*^-200` | `-` |\n| `{6, 1, 1}` | `1` | `2.3181033067840057883955815578235'3.*^-7` | `1.34340073523074463778281'3.*^-14` | `1.6391465677179357335804947119787'3.*^-7` | `3.278293135436'3.*^-7` | `6.556586270868'3.*^-7` | `0.9999999999996002632'4.` |\n| `{5, 3, 0}` | `1` | `1.9385308354978003024366866764934'3.*^-7` | `2.34868862510987756888131'3.*^-15` | `4.846327088744503601720043415255'3.*^-8` | `9.692654177488819391970523052292'3.*^-8` | `1.9385308354976136292184536138081'3.*^-7` | `0.9999999999999301134'4.` |\n| `{5, 2, 1}` | `1` | `2.2470793873526427283061508115679'3.*^-7` | `3.17107938618375857276991'3.*^-15` | `4.39355813132844397666403125613'3.*^-8` | `8.787115986819561140854530893653'3.*^-8` | `1.7574230870289166806460853349142'3.*^-7` | `0.9999999320682736761'4.` |\n| `{5, 2, 1}` | `2` | `2.2470795603359090118010532996819'3.*^-7` | `3.17107948330432262233271'3.*^-15` | `4.393558407165608732704771393303'3.*^-8` | `8.787117090168220164942074681714'3.*^-8` | `1.7574235283683802901604360331265'3.*^-7` | `1.0000000679315826271'4.` |\n| `{4, 4, 0}` | `1` | `4.476845198828'3.*^-7` | `2.505267866783605385323305'3.*^-14` | `1.1192112997069868274988805753962'3.*^-7` | `2.2384225994135764324161775518465'3.*^-7` | `4.476845198824'3.*^-7` | `0.9999999999993599611'4.` |\n| `{4, 3, 1}` | `1` | `3.490834840462'3.*^-7` | `8.79458396430835501292849'3.*^-15` | `5.008997121003034914389003564731'3.*^-8` | `1.0017993515098932777270903845921'3.*^-7` | `2.0035984122567982792772728757024'3.*^-7` | `0.9999998429766880208'4.` |\n| `{4, 3, 1}` | `2` | `3.490835491185'3.*^-7` | `8.79458618335247395140339'3.*^-15` | `5.008997847909838326431756668047'3.*^-8` | `1.0017996422726146425018569227185'3.*^-7` | `2.0035995753076837376989837770086'3.*^-7` | `1.0000001570230147732'4.` |\n| `{4, 2, 2}` | `1` | `3.945927427929'3.*^-7` | `7.20562524516927703674122'3.*^-15` | `2.208686004151058574418577495639'3.*^-8` | `4.417372008302009034614727821934'3.*^-8` | `8.834744016603153155450038425395'3.*^-8` | `0.9999999999999117259'4.` |\n| `{3, 3, 2}` | `1` | `6.63757106514'3.*^-7` | `3.188257805229940686914877'3.*^-14` | `3.4126142438172144028947147112'3.*^-8` | `6.825228487633041860646085140528'3.*^-8` | `1.3650456975254988160145437728117'3.*^-7` | `0.9999999999992670799'4.` |\n| `multiplicity-2 sectors (untwisted HW space, exact 2x2):` |  |  |  |  |  |  |  |\n| `mu` | `{5, 2, 1}` |  |  |  |  |  |  |\n| `S2(u0) on HW space` | `{{46697/162, 0}, {0, 46697/162}}` |  |  |  |  |  |  |\n| `S3(u1)` | `{{-40645395/295936, -11864475/36992}, {-2372895/147968, 4669245/73984}}` |  |  |  |  |  |  |\n| `S3c[1,2] (g=0)` | `{{665/93, -1400/93}, {-70/93, 1540/93}}` |  |  |  |  |  |  |\n| `eigenvalues of S2(u0)+Pi S3(u1); of S3c[1,2]` | `{{558.83031062700747119776254126625771990071'20., -215.53608623247527119948322775068706134044'20.}, {17.63940769046106360343123151319736805933'20., 6.07026972889377510624618784164134161815'20.}}` |  |  |  |  |  |  |\n| `S2(u0), S3(u1) commute on HW space` | `True` |  |  |  |  |  |  |\n| `mu` | `{4, 3, 1}` |  |  |  |  |  |  |\n| `S2(u0) on HW space` | `{{100009/324, 0}, {0, 100009/324}}` |  |  |  |  |  |  |\n| `S3(u1)` | `{{-3750705/18496, -2372895/73984}, {-2372895/36992, 4363065/36992}}` |  |  |  |  |  |  |\n| `S3c[1,2] (g=0)` | `{{560/93, -140/93}, {-280/93, 1960/93}}` |  |  |  |  |  |  |\n| `eigenvalues of S2(u0)+Pi S3(u1); of S3c[1,2]` | `{{698.97302656610089547269074946147025938667'20., -348.16146147323164397553908251598562667582'20.}, {21.37055203418202648689814476809103649587'20., 5.72622215936636060987604878029606027833'20.}}` |  |  |  |  |  |  |\n| `S2(u0), S3(u1) commute on HW space` | `True` |  |  |  |  |  |  |\n| `mu` | `{5, 2, 1}` |  |  |  |  |  |  |\n| `untwisted copies c=1,2 as coefficients on the exact HW kets hwKets[mu] (G-norm 1)` | `{{0.03278144919688059001239360515410436328'15., 0.00235241822437136148700639499850424473'15.}, {-0.01793360242396812419658507843856250097'15., 0.01249542854854110432880213171703761758'15.}}` |  |  |  |  |  |  |\n| `eigenvalues, eigenvectors (HW-ket coefficients) of the 2x2 matrix of S3c[1,2] at g = 0` | `{{17.63940769046106360343123151319736805933'15., 6.07026972889377510624618784164134161815'15.}, {{-0.01793360242396812419658507843856250097'15., 0.01249542854854110432880213171703761758'15.}, {0.03278144919688059001239360515410436328'15., 0.00235241822437136148700639499850424473'15.}}}` |  |  |  |  |  |  |\n| `\\|\\|eigvec_k - copy_c\\|\\| (k, c = 1,2; up to sign)` | `{{0.656872500171442313'3., 2.7638147204313317*^-200}, {2.284844153713267*^-200, 0.656872500171442313'3.}}` |  |  |  |  |  |  |\n| `mu` | `{4, 3, 1}` |  |  |  |  |  |  |\n| `untwisted copies c=1,2 as coefficients on the exact HW kets hwKets[mu] (G-norm 1)` | `{{-0.01264838336837443191447891824771237207'15., -0.00248101104102891394881994128235303364'15.}, {0.00338912410911517265521965898845311281'15., -0.0345560259960081230882170957546840034'15.}}` |  |  |  |  |  |  |\n| `eigenvalues, eigenvectors (HW-ket coefficients) of the 2x2 matrix of S3c[1,2] at g = 0` | `{{21.37055203418202648689814476809103649587'15., 5.72622215936636060987604878029606027833'15.}, {{-0.00338912410911517265521965898845311281'15., 0.0345560259960081230882170957546840034'15.}, {0.01264838336837443191447891824771237207'15., 0.00248101104102891394881994128235303364'15.}}}` |  |  |  |  |  |  |\n| `\\|\\|eigvec_k - copy_c\\|\\| (k, c = 1,2; up to sign)` | `{{0.5314201797141386382'3., 1.6952989189153127*^-200}, {1.6019559178017604*^-200, 0.5314201797141386382'3.}}` |  |  |  |  |  |  |",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Task 3. The localising scan: machinery (no printed output)",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Task 3 machinery. For a point (zeta, omega, thetas): the operator spaces D1 (independent subset of {id, W, H1, S3c12, S3c11, S3c22, S3c21}) and D2 = D1 + quadratic monomials (greedy independent subset, H1-products placed right after D1), the covectors Phi_X = reshape(<Om (x) Om|X, d1 x d1) (row = site 1, column = site 2), and the localisation systems: site 1 localises iff Phi_X.k = 0 for all k in NullSpace[{Om1}] (then <Om(x)Om|X = v (x) Om1 with v = Phi_X.e1), site 2 iff k.Phi_X = 0 (then = Om1 (x) u with u = e1.Phi_X). Everything exact. *)\nck = <||>;\nvecOf[a_] := Flatten[Normal[a]];\ngreedyIndep[ops_, names_] := Module[{keep = {}, mat = {}, rk = 0},\n  Do[With[{v = vecOf[ops[[i]]]}, If[MatrixRank[Append[mat, v]] > rk, AppendTo[mat, v]; AppendTo[keep, i]; rk++]], {i, Length[ops]}];\n  {ops[[keep]], names[[keep]]}];\nscanBuild[zz_, ww_, ths_] := Module[{g = DiagonalMatrix[zz], L, Wo, ops1, nm1, d1o, d1n, hprod, hn, prods, pn, d2o, d2n, nD1, nH, Om1, Om2v, K, Phis},\n  L = laurent[g, ths]; Wo = SparseArray[Sum[zz[[k]] (E1[k, k] + E2[k, k]), {k, 3}]];\n  ops1 = {id2, Wo, L[\"Hres\"][[1]], L[\"S3c\"][{1, 2}], L[\"S3c\"][{1, 1}], L[\"S3c\"][{2, 2}], L[\"S3c\"][{2, 1}]};\n  nm1 = {\"id\", \"W\", \"H1\", \"S3c[1,2]\", \"S3c[1,1]\", \"S3c[2,2]\", \"S3c[2,1]\"};\n  {d1o, d1n} = greedyIndep[ops1, nm1]; nD1 = Length[d1o];\n  hprod = Table[d1o[[3]] . d1o[[j]], {j, nD1}]; hn = Table[\"H1.\" <> d1n[[j]], {j, nD1}];\n  prods = Flatten[Table[d1o[[i]] . d1o[[j]], {i, nD1}, {j, i, nD1}], 1]; pn = Flatten[Table[d1n[[i]] <> \".\" <> d1n[[j]], {i, nD1}, {j, i, nD1}], 1];\n  {d2o, d2n} = greedyIndep[Join[d1o, hprod, prods], Join[d1n, hn, pn]];\n  nH = Length[Select[d2n[[nD1 + 1 ;;]], StringStartsQ[#, \"H1.\"] &]];\n  Om1 = ΩD[zz, ww[[1 ;; 2]]]; Om2v = kron[Om1, Om1];\n  K = NullSpace[{Om1}];\n  Phis = Table[Partition[Om2v . op, d1], {op, d2o}];\n  <|\"zz\" -> zz, \"ww\" -> ww, \"ths\" -> ths, \"D1\" -> d1o, \"D1n\" -> d1n, \"D2\" -> d2o, \"D2n\" -> d2n, \"nD1\" -> nD1, \"nH\" -> nH, \"Om1\" -> Om1, \"K\" -> K, \"Phis\" -> Phis, \"rkCubic\" -> Missing[]|>];\n(* the localisation matrix: rows indexed by (i, m), columns by operators; site 1: (Phi_a.k_m)_i; site 2: (k_m.Phi_a)_j *)\nlocMat[sc_, site_] := If[site == 1, Table[Flatten[Table[(sc[\"Phis\"][[a]] . k), {k, sc[\"K\"]}]], {a, Length[sc[\"Phis\"]]}], Table[Flatten[Table[(k . sc[\"Phis\"][[a]]), {k, sc[\"K\"]}]], {a, Length[sc[\"Phis\"]]}]] // Transpose;\n(* covector v(c) for the coefficient vector c: site 1: Phi.e1 (first column), site 2: e1.Phi (first row); Om1[[1]] = 1 *)\nvMap[sc_, site_] := If[site == 1, Table[sc[\"Phis\"][[a, All, 1]], {a, Length[sc[\"Phis\"]]}], Table[sc[\"Phis\"][[a, 1, All]], {a, Length[sc[\"Phis\"]]}]];\nlocSpace[sc_, site_, cols_] := Module[{M = locMat[sc, site][[All, cols]], ns, V = vMap[sc, site][[cols]], vs},\n  ns = NullSpace[M]; vs = If[ns === {}, {}, ns . V]; {ns, vs, If[vs === {}, 0, MatrixRank[vs]]}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Task 3. Which T's localise",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* Task 3 results. (a) ranks of D1, D2 and the cubic span (exact) and the localising spaces L1, L2 for the column sets {D1}, {D1 + H1.D1}, {D2}, {cubic span} at P and P'; (b) the localising X (coefficient vectors, row-reduced), the covectors v and their weights; (c) identification of L1, L2 inside Om1.span{id, C_zeta, one-site S2/S3 Laurent coefficients at theta_s, Sum (g - g')_ij E_ji}; (d) the spectator factors f(X) = <Om(x)Om|X|e1(x)e1> for the localising Laurent coefficients as functions of theta12 (rational fit, exact, two more thetas as checks). *)\nck = <||>;\nLm1[g_, th_, u_] := Association[Flatten[Table[{l[i, j] -> g[[i, j]] id1 + Ee[i, j]/(u - th), lp[i, j] -> -Ee[i, j]/(u - th)^2, lpp[i, j] -> 2 Ee[i, j]/(u - th)^3}, {i, 3}, {j, 3}], 1]];\nSk1[k_][g_, th_, u_] := Module[{M = Lm1[g, th, u]}, Total[Table[t[[1]] If[t[[2]] === {}, id1, Dot @@ Map[M[#] &, t[[2]]]], {t, Ssym[k]}]]];\nbas1[n_][th_, u_] := Table[1/(u - th)^j, {j, 0, n}];\nfit1[kk_, n_, g_, th_] := Module[{pts = Take[uSam, n + 1], Ainv, cs, resid}, Ainv = Inverse[Table[bas1[n][th, p], {p, pts}]]; cs = Table[Total[Table[Ainv[[j, k]] Sk1[kk][g, th, pts[[k]]], {k, n + 1}]], {j, n + 1}]; resid = Table[Total[Table[bas1[n][th, p][[j]] cs[[j]], {j, n + 1}]] - Sk1[kk][g, th, p], {p, Drop[uSam, n + 1]}]; {cs, resid}];\noneSiteOps[zz_, ww_, th_] := Module[{g = DiagonalMatrix[zz], f2, f3, gp = gpVar[1][zz, ww]}, f2 = fit1[2, 2, g, th]; f3 = fit1[3, 3, g, th];\n  <|\"names\" -> {\"id\", \"C_zeta\", \"S2res\", \"S3c[2]\", \"S3c[1]\", \"(g-g').E\"}, \"ops\" -> {id1, SparseArray[Sum[zz[[k]] Ee[k, k], {k, 3}]], f2[[1, 2]], f3[[1, 3]], f3[[1, 2]], SparseArray[Sum[(g - gp)[[i, j]] Ee[j, i], {i, 3}, {j, 3}]]}, \"resid\" -> Join[f2[[2]], f3[[2]]]|>];\n(* weights of the one-site space covered by a set of covectors *)\nwtRank[vs_] := Table[{u12wts[[m]], u12dims[[m]], MatrixRank[vs[[All, u12idx[[m]]]]]}, {m, Length[u12wts]}];\nscanReport[zz_, ww_, ths_] := Module[{sc = scanBuild[zz, ww, ths], nD1, nH, nAll, cols, rows, Om1, os1, os2, ident, cubicOps, sc3, cubicRk, deg2Rk, res},\n  nD1 = sc[\"nD1\"]; nH = sc[\"nH\"]; nAll = Length[sc[\"D2\"]]; Om1 = sc[\"Om1\"];\n  cols = {Range[nD1], Range[nD1 + nH], Range[nAll]};\n  rows = Table[Table[With[{r = locSpace[sc, site, c]}, {Length[c], r[[3]], Length[r[[1]]]}], {c, cols}], {site, 2}];\n  (* cubic span: all triple products of D1 (exact), greedy independent subset; the localisation test on this larger space *)\n  cubicOps = Flatten[Table[sc[\"D1\"][[i]] . sc[\"D1\"][[j]] . sc[\"D1\"][[k]], {i, nD1}, {j, i, nD1}, {k, j, nD1}], 2];\n  {cubicOps, cubicRk} = {#[[1]], Length[#[[1]]]} &[greedyIndep[Join[sc[\"D2\"], cubicOps], ConstantArray[\"\", Length[sc[\"D2\"]] + Length[cubicOps]]]];\n  sc3 = Join[sc, <|\"Phis\" -> Table[Partition[kron[Om1, Om1] . op, d1], {op, cubicOps}]|>];\n  res = <|\"sc\" -> sc, \"rows\" -> rows, \"cubicRk\" -> cubicRk, \"l1cubic\" -> locSpace[sc3, 1, Range[cubicRk]][[3]], \"l2cubic\" -> locSpace[sc3, 2, Range[cubicRk]][[3]]|>;\n  res];\n{tScan, scanP} = AbsoluteTiming[scanReport[zP, wP, thN]];\nscanPq = scanReport[zQ, wQ, thN];\nck[\"P: rank D1, rank D2, rank of span of cubic monomials (of 64)\"] = {scanP[\"sc\"][\"nD1\"], Length[scanP[\"sc\"][\"D2\"]], scanP[\"cubicRk\"]};\nck[\"P': rank D1, rank D2, rank cubic\"] = {scanPq[\"sc\"][\"nD1\"], Length[scanPq[\"sc\"][\"D2\"]], scanPq[\"cubicRk\"]};\nck[\"P: {#columns, ell, dim null} for site 1 over column sets D1 | D1+H1.D1 | D2 ; site 2 ; cubic: (ell1, ell2)\"] = {scanP[\"rows\"][[1]], scanP[\"rows\"][[2]], {scanP[\"l1cubic\"], scanP[\"l2cubic\"]}};\nck[\"P': same\"] = {scanPq[\"rows\"][[1]], scanPq[\"rows\"][[2]], {scanPq[\"l1cubic\"], scanPq[\"l2cubic\"]}};\n(* the localising X: row-reduced coefficient vectors over D1 (names), their covectors, weights *)\nlocD1[sc_, site_] := Module[{r = locSpace[sc, site, Range[sc[\"nD1\"]]]}, <|\"coef\" -> RowReduce[r[[1]]], \"v\" -> RowReduce[r[[2]]], \"rank\" -> r[[3]]|>];\nL1P = locD1[scanP[\"sc\"], 1]; L2P = locD1[scanP[\"sc\"], 2]; L1Q = locD1[scanPq[\"sc\"], 1]; L2Q = locD1[scanPq[\"sc\"], 2];\nck[\"P: localising X over D1, site 1 (rows = coefficient vectors on {id, W, H1, S3c12, S3c11, S3c22, S3c21})\"] = L1P[\"coef\"];\nck[\"P: localising X over D1, site 2\"] = L2P[\"coef\"];\nck[\"P': site 1 / site 2 coefficient vectors\"] = {L1Q[\"coef\"], L2Q[\"coef\"]};\nck[\"P: weights covered by L1 and L2: {weight, dim, rank of L projected}\"] = {wtRank[L1P[\"v\"]], wtRank[L2P[\"v\"]]};\n(* identification inside Om1 . span of one-site operators: for each localising X (coefficient vector over D1) the covector v(X) = Phi_X e1 (site 1) / e1 Phi_X (site 2) is solved EXACTLY as Om1 . (a id + b C_zeta + c S3c1[2]) with the one-site Laurent coefficient S3c1[2] at theta_s (basis of 3 independent covectors); the rank of Om1 . {all six one-site operators} shows what else is available *)\nidentX[zz_, ww_, sc_, L_, site_] := Module[{os = oneSiteOps[zz, ww, sc[\"ths\"][[site]]], Om1 = sc[\"Om1\"], O2, basis3, basis6, rows, sols},\n  O2 = kron[Om1, Om1]; basis3 = Table[Om1 . os[\"ops\"][[k]], {k, {1, 2, 4}}]; basis6 = Table[Om1 . op, {op, os[\"ops\"]}];\n  rows = L[\"coef\"];\n  sols = Table[With[{X = Sum[c[[a]] sc[\"D1\"][[a]], {a, sc[\"nD1\"]}], X0 = 0}, With[{Phi = Partition[O2 . X, d1]}, With[{v = If[site == 1, Phi[[All, 1]], Phi[[1, All]]]}, {MatrixRank[Join[basis3, {v}]] == 3, Quiet[Check[LinearSolve[Transpose[basis3], v], \"none\"]]}]]], {c, rows}];\n  {MatrixRank[basis3], MatrixRank[basis6], rows, sols}];\nidX1P = identX[zP, wP, scanP[\"sc\"], L1P, 1]; idX2P = identX[zP, wP, scanP[\"sc\"], L2P, 2]; idX1Q = identX[zQ, wQ, scanPq[\"sc\"], L1Q, 1]; idX2Q = identX[zQ, wQ, scanPq[\"sc\"], L2Q, 2];\nck[\"P: Om1.{id, C_zeta, S3c1[2]} rank; Om1.{all 6 one-site ops} rank; site 1: for X = id, H1, S3c12: {v in span?, (a, b, c) with v = Om1.(a id + b C_zeta + c S3c1[2])}\"] = {idX1P[[1]], idX1P[[2]], idX1P[[4]]};\nck[\"P: site 2: X = id, W+H1, S3c22 -> (a, b, c) w.r.t. {id, C_zeta, S3c1[2] at theta_2}\"] = idX2P[[4]];\nck[\"P': site 1 / site 2 (a, b, c)\"] = {idX1Q[[4]], idX2Q[[4]]};\nck[\"one-site Laurent fit residual (max abs, exact zero expected), sites 1, 2\"] = {Max[Max[Abs[Normal[#]]] & /@ oneSiteOps[zP, wP, thN[[1]]][\"resid\"]], Max[Max[Abs[Normal[#]]] & /@ oneSiteOps[zP, wP, thN[[2]]][\"resid\"]]};\n(* quadratic extras: the full localising space over D2 and over D1 + ONE extra column c: which single product c completes it, and the localising X in terms of D1 names + c. Then: is the full L (D2 columns) inside Om1.span{one-site ops and their pair products}? *)\nextraRep[sc_, site_] := Module[{nD1 = sc[\"nD1\"], n = Length[sc[\"D2\"]], full, ext, good},\n  full = locSpace[sc, site, Range[n]][[3]];\n  ext = Table[{sc[\"D2n\"][[c]], locSpace[sc, site, Append[Range[nD1], c]][[3]]}, {c, nD1 + 1, n}];\n  good = Select[ext, #[[2]] == full &];\n  {full, Length[ext], Length[good], If[good === {}, {}, With[{c = Position[sc[\"D2n\"], good[[1, 1]]][[1, 1]]}, {good[[1, 1]], RowReduce[locSpace[sc, site, Append[Range[nD1], c]][[1]]], sc[\"D2n\"][[Append[Range[nD1], c]]]}]], good[[All, 1]]}];\nexP1 = extraRep[scanP[\"sc\"], 1]; exP2 = extraRep[scanP[\"sc\"], 2];\nck[\"P: full localising dim over D2 and over D1+{one product}: {ell(D2), # products tried, # single products completing L, first completing product with its localising X (row-reduced over D1 names + product), all completing products}: site 1\"] = exP1;\nck[\"P: same, site 2\"] = exP2;\nos1Prod[zz_, ww_, sc_, site_] := Module[{os = oneSiteOps[zz, ww, sc[\"ths\"][[site]]], base, prods, Om1 = sc[\"Om1\"], Lfull = locSpace[sc, site, Range[Length[sc[\"D2\"]]]][[2]]},\n  base = os[\"ops\"][[{1, 2, 4, 5, 6}]]; prods = Flatten[Table[base[[i]] . base[[j]], {i, 5}, {j, i, 5}], 1];\n  {MatrixRank[Table[Om1 . op, {op, base}]], MatrixRank[Table[Om1 . op, {op, Join[base, prods]}]], MatrixRank[Lfull], MatrixRank[Join[Table[Om1 . op, {op, base}], Lfull]], MatrixRank[Join[Table[Om1 . op, {op, Join[base, prods]}], Lfull]]}];\nck[\"P: Om1.{id, C_zeta, S3c1[2], S3c1[1], (g-g').E} rank; with pair products rank; ell (full D2); rank with L added (base); rank with L added (base + products): L inside base? inside base+products?, site 1 / site 2\"] = {os1Prod[zP, wP, scanP[\"sc\"], 1], os1Prod[zP, wP, scanP[\"sc\"], 2]};\n(* (d) spectator factors *)\nspect[zz_, ww_, ths_] := Module[{sc = scanBuild[zz, ww, ths], L = laurent[DiagonalMatrix[zz], ths], Om1, O2, Xs, out},\n  Om1 = sc[\"Om1\"]; O2 = kron[Om1, Om1];\n  Xs = <|\"H1\" -> {1, L[\"Hres\"][[1]]}, \"S3c12\" -> {1, L[\"S3c\"][{1, 2}]}, \"H2\" -> {2, L[\"Hres\"][[2]]}, \"S3c22\" -> {2, L[\"S3c\"][{2, 2}]}|>;\n  Association[KeyValueMap[Function[{nm, p}, With[{Phi = Partition[O2 . p[[2]], d1]}, nm -> If[p[[1]] == 1, {Phi[[1, 1]], Phi === Outer[Times, Phi[[All, 1]], Om1]}, {Phi[[1, 1]], Phi === Outer[Times, Om1, Phi[[1, All]]]}]]], Xs]]];\nth1v = thN[[1]]; th2s = {-3/5, 1/4, -1, 4/3, 5/7, 2, -4/3, 7/5, 3};\nspData = Table[<|\"th12\" -> th1v - t2, \"f\" -> spect[zP, wP, {th1v, t2}]|>, {t2, th2s}];\nck[\"spectator factors: localisation exact for all theta (all True)\"] = And @@ Flatten[Table[Values[d[\"f\"]][[All, 2]], {d, spData}]];\nfitF[sd_, nm_] := Module[{pts = Take[sd, 6], cof},\n  cof = LinearSolve[Table[d[\"th12\"]^j, {d, pts}, {j, -2, 3}], Table[d[\"f\"][nm][[1]], {d, pts}]];\n  {Total[cof Table[thx^j, {j, -2, 3}]], Table[Total[cof Table[d[\"th12\"]^j, {j, -2, 3}]] - d[\"f\"][nm][[1]], {d, Drop[sd, 6]}]}];\nspDataQ = Table[<|\"th12\" -> th1v - t2, \"f\" -> spect[zQ, wQ, {th1v, t2}]|>, {t2, th2s}];\nck[\"spectator factors at P': localisation exact for all theta\"] = And @@ Flatten[Table[Values[d[\"f\"]][[All, 2]], {d, spDataQ}]];\nfits = Table[nm -> fitF[spData, nm], {nm, {\"H1\", \"S3c12\", \"H2\", \"S3c22\"}}];\nfitsQ = Table[nm -> fitF[spDataQ, nm], {nm, {\"H1\", \"S3c12\", \"H2\", \"S3c22\"}}];\nck[\"spectator f(X) = <Om(x)Om|X|e1(x)e1> at P as a Laurent polynomial in thx = th12 (fit on 6 points, residuals at the other 3)\"] = Table[nm[[1]] -> {Factor[nm[[2, 1]]], nm[[2, 2]]}, {nm, fits}];\nck[\"spectator f(X) at P' (same fit)\"] = Table[nm[[1]] -> {Factor[nm[[2, 1]]], nm[[2, 2]]}, {nm, fitsQ}];\nchecks = Join[checks, ck];\nGrid[Join[{{\"time (s)\", tScan}}, List @@@ Normal[ck]], Frame -> All, Alignment -> Left]",
