387373987791843837090667711644`10., -0.0701153288981854321931040754802621531`10.} | {0.22491771387373987779802820185050602322`10., -0.07011532889818543148516179201931069833`10.} | 3.15e-18 | 1.84e-21 |\n| {5, 3, 2} | 1 | 2 | 2.53e-6, 1.01e-5 | 4.14e-6, 8.29e-6, 1.66e-5 | 4.00 | {-0.00744303312308674184645982384705910092`10., -0.07589030021024659148687350948627423242`10.} | {-0.0074430331230867415332368240946140482`10., -0.07589030021024659163253910239200541561`10.} | 4.13e-18 | 1.56e-20 |\n| {5, 3, 2} | 2 | 2 | 2.31e-6, 9.25e-6 | 3.86e-6, 7.72e-6, 1.54e-5 | 4.00 | {-0.10366807798802436926465128726405201019`10., 0.02033474465469103593131795393071867686`10.} | {-0.10366807798802436944785563712302044746`10., 0.02033474465469103570358924730684820019`10.} | 2.2e-18 | 1.54e-20 |\n| {4, 4, 2} | 1 | 2 | 4.12e-7, 1.65e-6 | 3.89e-7, 7.77e-7, 1.55e-6 | 4.00 | {0, -0.07453559924999298988030578895770920785`10.} | {2.4675057810258568278`10.*^-19, -0.07453559924999299071244005337393882537`10.} | 1.12e-17 | 3.23e-27 |\n| {4, 3, 3} | 1 | 1 | 7.81e-6, 3.12e-5 | 9.88e-6, 1.98e-5, 3.95e-5 | 4.00 | {-0.02282177322938192139404040761670008891`10.} | {-0.02282177322938192138485922596911045904`10.} | 4.02e-19 | 4.81e-25 |\n| phi_u(main, all 24 points) = coverG[{a', g', c'}] with the closed forms of 4(b) (exact) | True |  |  |  |  |  |  |  |  |\n| control omega' fixed: eps -> 0 limit of phi_u finite (no poles at ep = 0) and per-weight ranks over 6 directions {weight, dim, rank} | {True, {{{0, 2, 3}, 1, 1}, {{0, 3, 2}, 1, 1}, {{1, 1, 3}, 1, 1}, {{1, 2, 2}, 2, 2}, {{1, 3, 1}, 1, 1}, {{2, 0, 3}, 1, 1}, {{2, 1, 2}, 2, 2}, {{2, 2, 1}, 2, 2}, {{2, 3, 0}, 1, 1}, {{3, 0, 2}, 1, 1}, {{3, 1, 1}, 1, 1}, {{3, 2, 0}, 1, 1}}} |  |  |  |  |  |  |  |  |\n| u = e1 E13 and u' = e1 E23 E12 are supported on the weight Lambda+(-1,0,1) slice: supports vs idxOf[{1,1,1}] | {{5, 7}, {5}, {5, 7}} |  |  |  |  |  |  |  |  |\n| mixing R_c = (u.C_c)/(u'.C_c): {mu, copy} | exact copy | overlap Richardson | chain Richardson | rel dev overlap | rel dev chain |  |  |  |  |\n| {{5, 4, 1}, 1} | 4.31173769149 | 4.31173769149 | 4.31173769149 | 7.25e-19 | 1.18e-20 |  |  |  |  |\n| {{5, 4, 1}, 2} | -0.811737691490 | -0.811737691490 | -0.811737691490 | 5.11e-20 | -2.23e-21 |  |  |  |  |\n| time (s) main CG | 0.1375519 |  |  |  |  |  |  |  |  |",
