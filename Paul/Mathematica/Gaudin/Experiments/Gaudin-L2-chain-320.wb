  {
   "kind": 2,
   "value": "(* Task B1/B2 (generalised from the [3,1,0] cell: no representation guard). Generators: D1 = {id, W, H1, S3c[1,2], S3c[1,1], S3c[2,2], S3c[2,1]} (7, independent) and the 21 quadratic monomials Q_ij = a_i a_j (i <= j) of the six non-identity elements a = {W, H1, S3c12, S3c11, S3c22, S3c21} (all commute): 28 generators spanning D2 (rank 26 expected). The operator X = Sum c_g g localises at site 1 iff Phi_X . k = 0 for all k in K = NullSpace[{Omega1}], Phi_X = reshape(<Omega (x) Omega|X, 15 x 15) (rows = site 1); at site 2 iff k . Phi_X = 0. <Omega (x) Omega|g is computed by pushing the covector through the factors (no 225 x 225 products). Operators are compared through an exact sketch (action on three random integer vectors) that is faithful on the 28-dim generator space (rank checked). L := {X in D2 : localises}; dim L (as an operator space), dim L cap D1, quotient, and l = dim of the image covector space. *)\nck = <||>;\n(* two generator bases (same span D1, D2): basis 1 = site-1 variables {W, H1, S3c12, S3c11, S3c22, S3c21}; basis 2 = site-2 variables {W, H2t = H1 + W (= -H2 + const), S3c22, S3c21, S3c12, S3c11} *)\nbBaseNames = <|1 -> {\"W\", \"H1\", \"S3c12\", \"S3c11\", \"S3c22\", \"S3c21\"}, 2 -> {\"W\", \"H2t\", \"S3c22\", \"S3c21\", \"S3c12\", \"S3c11\"}|>;\nbNames[b_] := Join[{\"id\"}, bBaseNames[b], Flatten[Table[bBaseNames[b][[i]] <> \".\" <> bBaseNames[b][[j]], {i, 6}, {j, i, 6}]]];\nbPairs = Flatten[Table[{i, j}, {i, 6}, {j, i, 6}], 1];\nSeedRandom[20261016];\nbW = Table[RandomInteger[{-9, 9}, d2], {3}];\nbSetup[zz_, ww_, ths_, basis_] := bSetup[zz, ww, ths, basis] = Module[{L = laurent[DiagonalMatrix[zz], ths], Wo, a, Om1, O2, K, actRow, actCol, rows, Phis, Sk},\n  Wo = SparseArray[Sum[zz[[k]] (E1[k, k] + E2[k, k]), {k, 3}]];\n  a = If[basis == 1, {Wo, L[\"Hres\"][[1]], L[\"S3c\"][{1, 2}], L[\"S3c\"][{1, 1}], L[\"S3c\"][{2, 2}], L[\"S3c\"][{2, 1}]}, {Wo, L[\"Hres\"][[1]] + Wo, L[\"S3c\"][{2, 2}], L[\"S3c\"][{2, 1}], L[\"S3c\"][{1, 2}], L[\"S3c\"][{1, 1}]}];\n  Om1 = ΩD[zz, ww[[1 ;; 2]]]; O2 = kron[Om1, Om1]; K = NullSpace[{Om1}];\n  actRow[r_, g_] := If[g == 1, r, If[g <= 7, r . a[[g - 1]], (r . a[[bPairs[[g - 7, 1]]]]) . a[[bPairs[[g - 7, 2]]]]]];\n  actCol[w_, g_] := If[g == 1, w, If[g <= 7, a[[g - 1]] . w, a[[bPairs[[g - 7, 1]]]] . (a[[bPairs[[g - 7, 2]]]] . w)]];\n  Phis = Table[Partition[actRow[O2, g], d1], {g, 28}];\n  Sk = Table[Flatten[Table[actCol[w, g], {w, bW}]], {g, 28}];\n  <|\"zz\" -> zz, \"ww\" -> ww, \"ths\" -> ths, \"basis\" -> basis, \"names\" -> bNames[basis], \"a\" -> a, \"Om1\" -> Om1, \"K\" -> K, \"Phis\" -> Phis, \"Sk\" -> Sk, \"actRow\" -> actRow, \"actCol\" -> actCol|>];\nbLocCols[sc_, site_] := Table[Flatten[If[site == 1, sc[\"Phis\"][[g]] . Transpose[sc[\"K\"]], sc[\"K\"] . sc[\"Phis\"][[g]]]], {g, 28}];\nbVec[sc_, site_] := If[site == 1, Table[sc[\"Phis\"][[g, All, 1]], {g, 28}], Table[sc[\"Phis\"][[g, 1, All]], {g, 28}]];\nbAnalyse[sc_, site_] := Module[{A = Transpose[bLocCols[sc, site]], ns, nsD1, rkSk, dimL, dimLD1, vs, ell, vsD1, ell3},\n  rkSk = MatrixRank[sc[\"Sk\"]]; ns = NullSpace[A]; nsD1 = NullSpace[A[[All, 1 ;; 7]]];\n  dimL = MatrixRank[ns . sc[\"Sk\"]]; dimLD1 = Length[nsD1];\n  vs = If[ns === {}, {}, ns . bVec[sc, site]]; ell = If[vs === {}, 0, MatrixRank[vs]];\n  <|\"rkSk\" -> rkSk, \"rkD1\" -> MatrixRank[sc[\"Sk\"][[1 ;; 7]]], \"nullGen\" -> Length[ns], \"dimL\" -> dimL, \"dimLD1\" -> dimLD1, \"quot\" -> dimL - dimLD1, \"ell\" -> ell, \"ns\" -> ns, \"nsD1\" -> nsD1|>];\n{tB1, bP} = AbsoluteTiming[bSetup[zP, wP, thN, 1]];\nbQ = bSetup[zQ, wQ, thN, 1]; bP2 = bSetup[zP, wP, thN, 2]; bQ2 = bSetup[zQ, wQ, thN, 2];\nbAnP = {bAnalyse[bP, 1], bAnalyse[bP2, 2]}; bAnQ = {bAnalyse[bQ, 1], bAnalyse[bQ2, 2]};\nck[\"rank of the 28 generators (sketch) = rank D2, rank of D1 (P, P')\"] = {bAnP[[1]][\"rkSk\"], bAnP[[1]][\"rkD1\"], bAnQ[[1]][\"rkSk\"], bAnQ[[1]][\"rkD1\"]};\nck[\"site 1, P: {dim L (operators), dim L cap D1, quotient, l = dim of the covector space v(L)}\"] = Table[bAnP[[1]][k], {k, {\"dimL\", \"dimLD1\", \"quot\", \"ell\"}}];\nck[\"site 1, P': same\"] = Table[bAnQ[[1]][k], {k, {\"dimL\", \"dimLD1\", \"quot\", \"ell\"}}];\nck[\"site 2, P: same\"] = Table[bAnP[[2]][k], {k, {\"dimL\", \"dimLD1\", \"quot\", \"ell\"}}];\nck[\"site 2, P': same\"] = Table[bAnQ[[2]][k], {k, {\"dimL\", \"dimLD1\", \"quot\", \"ell\"}}];\n(* which D1 elements localise on their own, and the coefficient vectors of L cap D1 (row-reduced, on {id, W, H1, S3c12, S3c11, S3c22, S3c21}) *)\nck[\"site 1, P: L cap D1 coefficient vectors (RowReduce) on the basis-1 D1 = {id, W, H1, S3c12, S3c11, S3c22, S3c21}\"] = RowReduce[bAnP[[1]][\"nsD1\"]];\nck[\"site 2, P: L cap D1 coefficient vectors (RowReduce) on the basis-2 D1 = {id, W, H2t, S3c22, S3c21, S3c12, S3c11}\"] = RowReduce[bAnP[[2]][\"nsD1\"]];\n(* B2: supports of size 1, 2, 3 among the 21 quadratic monomials, with free D1 coefficients *)\nbSupportScan[sc_, site_, maxs_] := Module[{A = Transpose[bLocCols[sc, site]], Sk = sc[\"Sk\"], sk1 = sc[\"Sk\"][[1 ;; 7]], rk1, res = {}},\n  rk1 = MatrixRank[sc[\"Sk\"][[1 ;; 7]]];\n  Do[Do[Module[{cols = Join[Range[7], 7 + S], ns, outside, reach},\n    ns = NullSpace[A[[All, cols]]];\n    If[ns =!= {},\n     reach = And @@ Table[AnyTrue[ns, #[[7 + m]] =!= 0 &], {m, Length[S]}];\n     outside = AnyTrue[ns, MatrixRank[Append[sk1, #[[1 ;; 7]] . sk1 + #[[8 ;;]] . Sk[[7 + S]]]] > rk1 &];\n     If[reach && outside, AppendTo[res, <|\"S\" -> S, \"ns\" -> ns|>]]]], {S, Subsets[Range[21], {sz}]}], {sz, maxs}];\n  res];\nminimalSupports[res_] := Select[res, Function[r, ! AnyTrue[res, #[\"S\"] =!= r[\"S\"] && SubsetQ[r[\"S\"], #[\"S\"]] &]]];\n(* explicit X for a support: reduced row echelon with the quadratic columns first, so that the D1 coefficients on the pivot columns of L cap D1 vanish *)\nbExplicit[r_, nm_] := Module[{S = r[\"S\"], ns = r[\"ns\"], M, rr, rows},\n  M = ns[[All, Join[7 + Range[Length[S]], Range[7]]]]; rr = RowReduce[M];\n  rows = Select[rr, ! (# [[1 ;; Length[S]]] === ConstantArray[0, Length[S]]) &];\n  Table[StringRiffle[Join[Table[If[row[[k]] === 0, Nothing, ToString[row[[k]], InputForm] <> \"*\" <> nm[[7 + S[[k]]]]], {k, Length[S]}], Table[If[row[[Length[S] + j]] === 0, Nothing, ToString[row[[Length[S] + j]], InputForm] <> \"*\" <> nm[[j]]], {j, 7}]], \" + \"], {row, rows}]];\nbScans = <||>;\nbPts = <|{\"P\", 1} -> bP, {\"P\", 2} -> bP2, {\"P'\", 1} -> bQ, {\"P'\", 2} -> bQ2|>;\n{tScans, dummy} = AbsoluteTiming[Do[bScans[k] = bSupportScan[bPts[k], k[[2]], 3], {k, Keys[bPts]}]];\nck[\"B2 time of the four scans (supports of size <= 3 among the 21 quadratics, 1561 systems each, free D1 coefficients), s\"] = tScans;\nDo[ck[\"B2 \" <> k[[1]] <> \", site \" <> ToString[k[[2]]] <> \" (basis \" <> ToString[k[[2]]] <> \"): # supports found by size {1,2,3}; minimal supports\"] = {Table[Count[Length[#[\"S\"]] & /@ bScans[k], sz], {sz, 3}], bNames[k[[2]]][[7 + #[\"S\"]]] & /@ minimalSupports[bScans[k]]}, {k, Keys[bScans]}];\nDo[ck[\"B2 \" <> k[[1]] <> \", site \" <> ToString[k[[2]]] <> \": explicit X for each minimal support (q-part first, D1 part reduced modulo L cap D1)\"] = Table[{bNames[k[[2]]][[7 + r[\"S\"]]], bExplicit[r, bNames[k[[2]]]]}, {r, minimalSupports[bScans[k]]}], {k, Keys[bScans]}];\nbNat1 = {\"H1.H1\", \"H1.S3c12\", \"S3c12.S3c12\", \"H1.S3c11\", \"S3c12.S3c11\", \"S3c11.S3c11\", \"W.H1\", \"W.S3c12\"};\nbNat2 = {\"H2t.H2t\", \"H2t.S3c22\", \"S3c22.S3c22\", \"H2t.S3c21\", \"S3c22.S3c21\", \"S3c21.S3c21\", \"W.H2t\", \"W.S3c22\"};\nck[\"B2 natural candidates, site 1 (P): {name, single-monomial support works, appears in a support found}\"] = Table[With[{pos = Position[bNames[1], nm][[1, 1]] - 7}, {nm, MemberQ[bScans[{\"P\", 1}][[All, \"S\"]], {pos}], AnyTrue[bScans[{\"P\", 1}][[All, \"S\"]], MemberQ[#, pos] &]}], {nm, bNat1}];\nck[\"B2 natural candidates, site 2 (P, basis 2): same\"] = Table[With[{pos = Position[bNames[2], nm][[1, 1]] - 7}, {nm, MemberQ[bScans[{\"P\", 2}][[All, \"S\"]], {pos}], AnyTrue[bScans[{\"P\", 2}][[All, \"S\"]], MemberQ[#, pos] &]}], {nm, bNat2}];\nck[\"B1 note: the individual D1 elements S3c11, S3c22, S3c21, W do not localise on their own at site 1 (L cap D1 has dim 3: id, H1, S3c12; site 2: id, W + H1, S3c22)\"] = True;\nchecks = Join[checks, ck];\nGrid[Join[{{\"check\", \"result\"}}, List @@@ Normal[ck]], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
