  {
   "kind": 2,
   "value": "(* A3 (duality with [3,1,0]). Rep-generic analysis of V (x) V at g = 0 for lam = [3,1,0] and [3,2,0] (independent of the global switch, own operators): the HW sectors with multiplicities, the matrix of theta12 S3c[1,2] on the exact HW space of every sector (theta = (2/7, -3/5), theta12 = 31/35; S3c[1,2] = double-pole Laurent coefficient of S3 at theta1, fitted exactly from 7 rational u), its eigenvalues, and for each multiplicity-2 sector the basis-independent mixing diagnostic of each copy (= eigenvector): the ratio of the two slice components in the G-orthonormal basis, r = v[ix1] sqrt(g[ix1]) / (v[ix2] sqrt(g[ix2])) (v = the full HW state, ix = GT indices of the slice weight nu = mu - lam, second site = e1). The dual image of a [3,1,0]^2 sector mu is mu* = (6 - mu3, 6 - mu2, 6 - mu1) in [3,2,0]^2. *)\nck = <||>;\nrepAnalysis[lam_] := Module[{d = dim[lam], idr, Er, E1r, E2r, wt1, wtB, secsAll, raise, hwK, gdiagR, gv, gsol, th12v = thN[[1]] - thN[[2]], pts = Take[uSamAlt, 7], Ainv, S3at, cs, A, out = <||>, idd},\n  idr = IdentityMatrix[d, SparseArray]; idd = IdentityMatrix[d^2, SparseArray];\n  Er = Table[SparseArray[JJ[i, j, lam]], {i, 3}, {j, 3}];\n  E1r = Table[KroneckerProduct[Er[[i, j]], idr], {i, 3}, {j, 3}]; E2r = Table[KroneckerProduct[idr, Er[[i, j]]], {i, 3}, {j, 3}];\n  wt1 = Table[Table[J0[k][p], {k, 3}], {p, ps[{lam}]}]; wtB = Flatten[Table[wt1[[i]] + wt1[[j]], {i, d}, {j, d}], 1];\n  raise = Join[E1r[[1, 2]] + E2r[[1, 2]], E1r[[1, 3]] + E2r[[1, 3]], E1r[[2, 3]] + E2r[[2, 3]]];\n  gv = Array[gg, d]; gsol = Solve[Flatten[Append[Table[Transpose[Normal[Er[[i, j]]]] . DiagonalMatrix[gv] - DiagonalMatrix[gv] . Normal[Er[[j, i]]], {i, 3}, {j, i + 1, 3}], {gv[[1]] - 1}]] == 0, gv]; gdiagR = gv /. First[gsol];\n  S3at[u_] := Module[{M = Association[Flatten[Table[{l[i, j] -> E1r[[i, j]]/(u - thN[[1]]) + E2r[[i, j]]/(u - thN[[2]]), lp[i, j] -> -E1r[[i, j]]/(u - thN[[1]])^2 - E2r[[i, j]]/(u - thN[[2]])^2, lpp[i, j] -> 2 E1r[[i, j]]/(u - thN[[1]])^3 + 2 E2r[[i, j]]/(u - thN[[2]])^3}, {i, 3}, {j, 3}], 1]]},\n     Total[Table[t[[1]] If[t[[2]] === {}, idd, Dot @@ Map[M[#] &, t[[2]]]], {t, Ssym[3]}]]];\n  Ainv = Inverse[Table[bas3[thN, p], {p, pts}]];\n  cs = Table[Total[Table[Ainv[[j, k]] S3at[pts[[k]]], {k, 7}]], {j, 7}];\n  A = cs[[3]];\n  secsAll = Reverse[Sort[Union[wtB]]];\n  Do[Module[{sec = Flatten[Position[wtB, mu]], ker, m, Hs, AH, Msec, es},\n    ker = NullSpace[Normal[raise[[All, sec]]]]; m = Length[ker];\n    If[m > 0,\n     Hs = Transpose[ker]; AH = Normal[A[[sec, sec]]] . Hs; Msec = th12v LeastSquares[Hs, AH];\n     es = Eigensystem[N[Msec, 40]];\n     out[mu] = <|\"m\" -> m, \"M\" -> Msec, \"ev\" -> es[[1]], \"ker\" -> ker, \"sec\" -> sec, \"es\" -> es|>]], {mu, secsAll}];\n  <|\"lam\" -> lam, \"d\" -> d, \"out\" -> out, \"wt1\" -> wt1, \"g\" -> gdiagR|>];\nrA = <|{3, 1, 0} -> repAnalysis[{3, 1, 0}], {3, 2, 0} -> repAnalysis[{3, 2, 0}]|>;\nsliceRatios[ra_, mu_] := Module[{o = ra[\"out\"][mu], lam = ra[\"lam\"], d = ra[\"d\"], nu, ix, ph},\n  nu = mu - lam; ix = Flatten[Position[ra[\"wt1\"], nu]];\n  If[o[\"m\"] != 2 || Length[ix] != 2, {},\n   Table[Module[{c = o[\"es\"][[2, k]], v, sl},\n      v = c . o[\"ker\"]; v = Normal[SparseArray[Thread[o[\"sec\"] -> v], d^2]]; sl = v[[(ix - 1) d + 1]];\n      {N[o[\"ev\"][[k]], 12], N[(sl[[1]] Sqrt[ra[\"g\"][[ix[[1]]]]])/(sl[[2]] Sqrt[ra[\"g\"][[ix[[2]]]]]), 12]}], {k, 2}]]];\ndualOf[mu_] := {6 - mu[[3]], 6 - mu[[2]], 6 - mu[[1]]};\nr310 = rA[{3, 1, 0}]; r320 = rA[{3, 2, 0}];\nck[\"# HW sectors found: [3,2,0] (all sectors with a kernel; = HW sectors of the global-switch run?), [3,1,0]\"] = {Length[Keys[r320[\"out\"]]], Length[Keys[r310[\"out\"]]], Sort[Keys[r320[\"out\"]]] === Sort[hwSecs]};\nck[\"dual map mu -> (6-mu3, 6-mu2, 6-mu1): [3,1,0] HW sectors map exactly onto the [3,2,0] HW sectors, multiplicities preserved\"] = {Sort[dualOf /@ Keys[r310[\"out\"]]] === Sort[Keys[r320[\"out\"]]], And @@ Table[r310[\"out\"][mu][\"m\"] == r320[\"out\"][dualOf[mu]][\"m\"], {mu, Keys[r310[\"out\"]]}]};\nck[\"consistency with the global-switch data: theta12 M (5,4,1), (5,3,2) of [3,2,0] equal 31/35 * the earlier S3c[1,2] matrices (HW basis may differ): eigenvalues equal?\"] = Table[Sort[N[Eigenvalues[r320[\"out\"][mu][\"M\"]], 20]] == Sort[N[Eigenvalues[(31/35) hwMat[S3c12g0, mu]], 20]], {mu, multSecs}];\nrows = Table[Module[{ms = dualOf[mu], o1 = r310[\"out\"][mu], o2 = r320[\"out\"][dualOf[mu]], sr1 = sliceRatios[r310, mu], sr2 = sliceRatios[r320, dualOf[mu]]},\n   {ToString[mu], ToString[ms], o1[\"m\"], ToString[N[o1[\"ev\"], 10], InputForm], ToString[N[o2[\"ev\"], 10], InputForm], ToString[N[Sort[Re[o2[\"ev\"]]] - Sort[Re[o1[\"ev\"]]], 10], InputForm], ToString[Quiet[Factor[CharacteristicPolynomial[o1[\"M\"], xx]]], InputForm], ToString[Quiet[Factor[CharacteristicPolynomial[o2[\"M\"], xx]]], InputForm], ToString[sr1, InputForm], ToString[sr2, InputForm]}], {mu, SortBy[Keys[r310[\"out\"]], # &]}];\nchecks = Join[checks, ck];\nGrid[Join[{{\"[3,1,0] sector mu\", \"dual image mu* in [3,2,0]\", \"mult\", \"eigenvalues of theta12 S3c12|HW, [3,1,0]\", \"same, [3,2,0] at mu*\", \"difference (sorted) [3,2,0] - [3,1,0]\", \"char. poly [3,1,0]\", \"char. poly [3,2,0]\", \"[3,1,0]: (eigenvalue, G-orthonormal slice ratio) per copy\", \"[3,2,0]: same\"}}, rows, List @@@ Normal[ck] /. {a_, b_} :> {a, b, \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
