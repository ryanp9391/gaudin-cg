19391970523052292`3.*^-8 | 1.9385308354976136292184536138081`3.*^-7 | 0.9999999999999301134`4. |\n| {5, 2, 1} | 1 | 2.2470793873526427283061508115679`3.*^-7 | 3.17107938618375857276991`3.*^-15 | 4.39355813132844397666403125613`3.*^-8 | 8.787115986819561140854530893653`3.*^-8 | 1.7574230870289166806460853349142`3.*^-7 | 0.9999999320682736761`4. |\n| {5, 2, 1} | 2 | 2.2470795603359090118010532996819`3.*^-7 | 3.17107948330432262233271`3.*^-15 | 4.393558407165608732704771393303`3.*^-8 | 8.787117090168220164942074681714`3.*^-8 | 1.7574235283683802901604360331265`3.*^-7 | 1.0000000679315826271`4. |\n| {4, 4, 0} | 1 | 4.476845198828`3.*^-7 | 2.505267866783605385323305`3.*^-14 | 1.1192112997069868274988805753962`3.*^-7 | 2.2384225994135764324161775518465`3.*^-7 | 4.476845198824`3.*^-7 | 0.9999999999993599611`4. |\n| {4, 3, 1} | 1 | 3.490834840462`3.*^-7 | 8.79458396430835501292849`3.*^-15 | 5.008997121003034914389003564731`3.*^-8 | 1.0017993515098932777270903845921`3.*^-7 | 2.0035984122567982792772728757024`3.*^-7 | 0.9999998429766880208`4. |\n| {4, 3, 1} | 2 | 3.490835491185`3.*^-7 | 8.79458618335247395140339`3.*^-15 | 5.008997847909838326431756668047`3.*^-8 | 1.0017996422726146425018569227185`3.*^-7 | 2.0035995753076837376989837770086`3.*^-7 | 1.0000001570230147732`4. |\n| {4, 2, 2} | 1 | 3.945927427929`3.*^-7 | 7.20562524516927703674122`3.*^-15 | 2.208686004151058574418577495639`3.*^-8 | 4.417372008302009034614727821934`3.*^-8 | 8.834744016603153155450038425395`3.*^-8 | 0.9999999999999117259`4. |\n| {3, 3, 2} | 1 | 6.63757106514`3.*^-7 | 3.188257805229940686914877`3.*^-14 | 3.4126142438172144028947147112`3.*^-8 | 6.825228487633041860646085140528`3.*^-8 | 1.3650456975254988160145437728117`3.*^-7 | 0.9999999999992670799`4. |\n| multiplicity-2 sectors (untwisted HW space, exact 2x2): |  |  |  |  |  |  |  |\n| mu | {5, 2, 1} |  |  |  |  |  |  |\n| S2(u0) on HW space | {{46697/162, 0}, {0, 46697/162}} |  |  |  |  |  |  |\n| S3(u1) | {{-40645395/295936, -11864475/36992}, {-237