  {
   "kind": 2,
   "value": "If[Λ === {3, 1, 0},\n(* Task B3. (a) The 2 linear relations among the 28 generators (D2 has rank 26): quadratic identities of the Gaudin algebra. (b) Closed form of the extra localiser, verified exactly at P, P' and 9 values of theta2: site 1: X4 = H1^2 - (1/2) H1 S3c12 - (2/theta12) W - S3c11 (mod id, H1, S3c12); site 2 (mirror): X4' = H2t^2 + (1/2) H2t S3c22 + (2/theta12) W - S3c21 (mod id, H2t, S3c22), H2t = H1 + W = -H2 + const. (c) The fourth covector v4: the G-orthogonal (dual metric G^-1) representative of v(X4) modulo L1_3 = span{Omega1, v(H1), v(S3c12)}; X4 normalised by its H1^2 coefficient 1 and D1 part fixed by the orthogonality; its spectator f4 = v4[[1]] as a Laurent polynomial in theta12 (fit on 6 values, 3 checks). (d) Minimal decomposition of v4 over Omega1 . span{one-site operators and pair products}: candidates beyond L1_3 are S3^{1-site}[-1] and the six pair products of {C_zeta, S3[-2], S3[-1]} (S2^{1-site} residue = -C_zeta + const is dependent); all supports of size <= 3 tested exactly. (e) per-weight ranks of the 3-dim L1_3 and the 4-dim L1 (= L1_3 + v4). *)\nck = <||>;\n{relG, relS} = {NullSpace[Transpose[bP[\"Sk\"]]], bNames[1]};\nbRel = Table[StringRiffle[Table[If[r[[k]] === 0, Nothing, ToString[r[[k]], InputForm] <> \"*\" <> relS[[k]]], {k, 28}], \" + \"], {r, RowReduce[relG]}];\nck[\"(a) the two linear relations among the 28 generators of D2 at P (zero operators; RowReduce)\"] = bRel;\nbRelQ = RowReduce[NullSpace[Transpose[bQ[\"Sk\"]]]];\nck[\"(a) same relations at P' (RowReduce): site-1 relation unchanged, site-2 relation zeta-dependent\"] = Table[StringRiffle[Table[If[r[[k]] === 0, Nothing, ToString[r[[k]], InputForm] <> \"*\" <> relS[[k]]], {k, 28}], \" + \"], {r, bRelQ}];\nck[\"(a) the two relations as exact 225 x 225 operator identities: S3c11 = (1/4) S3c12 (H1 - S3c12) and S3c21 = (1/4) S3c22 (H2 - S3c22), H2 = -H1 - W + 2|Lambda| Sum zeta: {site 1, site 2} at P, P', and theta2 = -3/5, 1/4, 4/3, -1 (P)\"] = Table[Module[{sc = bAt[p[[1]], p[[2]], p[[3]], 1], a, H2}, a = sc[\"a\"]; H2 = -a[[2]] - a[[1]] + 2 Total[Λ] Total[p[[1]]] id2; {zeroQ[a[[4]] - (1/4) a[[3]] . (a[[2]] - a[[3]])], zeroQ[a[[6]] - (1/4) a[[5]] . (H2 - a[[5]])]}], {p, {{zP, wP, -3/5}, {zQ, wQ, -3/5}, {zP, wP, 1/4}, {zP, wP, 4/3}, {zP, wP, -1}}}];\nipos1[nm_] := Position[bNames[1], nm][[1, 1]]; ipos2[nm_] := Position[bNames[2], nm][[1, 1]];\nunitG[k_] := UnitVector[28, k];\nxA[th12_] := Module[{c = ConstantArray[0, 28]}, c[[ipos1[\"H1.H1\"]]] = 1; c[[ipos1[\"H1.S3c12\"]]] = -1/2; c[[ipos1[\"W\"]]] = -2/th12; c[[ipos1[\"S3c11\"]]] = -1; c];\nxB[th12_] := Module[{c = ConstantArray[0, 28]}, c[[ipos2[\"H2t.H2t\"]]] = 1; c[[ipos2[\"H2t.S3c22\"]]] = 1/2; c[[ipos2[\"W\"]]] = 2/th12; c[[ipos2[\"S3c21\"]]] = -1; c];\nth2s = {-3/5, 1/4, -1, 4/3, 5/7, 2, -4/3, 7/5, 3};\nbAt[zz_, ww_, th2_, basis_] := bSetup[zz, ww, {thN[[1]], th2}, basis];\nclosedFormTest = Join[Table[{\"P\", th2, zeroQ[xA[thN[[1]] - th2] . bLocCols[bAt[zP, wP, th2, 1], 1]], zeroQ[xB[thN[[1]] - th2] . bLocCols[bAt[zP, wP, th2, 2], 2]]}, {th2, th2s}], Table[{\"P'\", th2, zeroQ[xA[thN[[1]] - th2] . bLocCols[bAt[zQ, wQ, th2, 1], 1]], zeroQ[xB[thN[[1]] - th2] . bLocCols[bAt[zQ, wQ, th2, 2], 2]]}, {th2, {-3/5, 4/3}}]];\nck[\"(b) X4 (site 1) and X4' (site 2) closed forms localise exactly: all True over 9 theta2 at P and 2 at P'\"] = And @@ Flatten[closedFormTest[[All, 3 ;; 4]]];\n(* the operators are NOT in D1: sketch rank *)\nck[\"(b) X4 is not in D1 (sketch rank of D1 + X4 = 8) at P\"] = MatrixRank[Append[bP[\"Sk\"][[1 ;; 7]], xA[thN[[1]] - thN[[2]]] . bP[\"Sk\"]]];\n(* (c) v4 *)\ngInvD = Inverse[Normal[gMet]];\nv4Site[sc_, site_, c_, l3idx_] := Module[{vv = bVec[sc, site], L3, vA, gram, co, v4, c4},\n  L3 = vv[[l3idx]]; vA = c . vv; gram = L3 . gInvD . Transpose[L3]; co = LinearSolve[gram, L3 . gInvD . vA];\n  v4 = vA - co . L3; c4 = c - co . unitG /@ l3idx;\n  <|\"v4\" -> v4, \"c4\" -> c4, \"co\" -> co, \"L3\" -> L3, \"gram\" -> gram|>];\nv4P1 = v4Site[bP, 1, xA[thN[[1]] - thN[[2]]], {1, 3, 4}];\nv4P2 = v4Site[bP2, 2, xB[thN[[1]] - thN[[2]]], {1, 3, 4}];\nck[\"(c) L1_3 rank (site 1: id, H1, S3c12; site 2: id, H2t, S3c22) and rank of L1_3 + v4 at P\"] = {MatrixRank[v4P1[\"L3\"]], MatrixRank[Append[v4P1[\"L3\"], v4P1[\"v4\"]]], MatrixRank[v4P2[\"L3\"]], MatrixRank[Append[v4P2[\"L3\"], v4P2[\"v4\"]]]};\nck[\"(c) G-orthogonality of v4 to L1_3 (dual metric G^-1), site 1 and 2\"] = {zeroQ[v4P1[\"L3\"] . gInvD . v4P1[\"v4\"]], zeroQ[v4P2[\"L3\"] . gInvD . v4P2[\"v4\"]]};\nck[\"(c) the L1_3-corrections: X4_canon = X4 - co.(id, H1, S3c12): co (site 1), co (site 2) at P\"] = {v4P1[\"co\"], v4P2[\"co\"]};\nck[\"(c) v4 (site 1) at P, normalised by its first component\"] = With[{v = v4P1[\"v4\"]}, If[v[[1]] === 0, v, v/v[[1]]]];\n(* spectator f4(theta12) *)\nf4Data = Table[Module[{s1 = bAt[zP, wP, th2, 1], s2 = bAt[zP, wP, th2, 2], th12v = thN[[1]] - th2},\n   <|\"th12\" -> th12v, \"f1\" -> v4Site[s1, 1, xA[th12v], {1, 3, 4}][\"v4\"][[1]], \"f2\" -> v4Site[s2, 2, xB[th12v], {1, 3, 4}][\"v4\"][[1]], \"v1\" -> v4Site[s1, 1, xA[th12v], {1, 3, 4}][\"v4\"], \"v2\" -> v4Site[s2, 2, xB[th12v], {1, 3, 4}][\"v4\"]|>], {th2, th2s}];\nfitL[key_, js_] := Module[{pts = Take[f4Data, Length[js]], cof, rest = Drop[f4Data, Length[js]]}, cof = LinearSolve[Table[d[\"th12\"]^j, {d, pts}, {j, js}], Table[d[key], {d, pts}]];\n  {Total[cof Table[thv^j, {j, js}]], Table[Total[cof Table[d[\"th12\"]^j, {j, js}]] - d[key], {d, rest}]}];\nfitA1 = fitL[\"f1\", Range[-2, 3]]; fitA2 = fitL[\"f2\", Range[-2, 3]];\nck[\"(c) spectator f4 (site 1) = v4[[1]] as a Laurent polynomial in theta12 (fit on 6 values, residuals on 3)\"] = {Factor[fitA1[[1]]], fitA1[[2]]};\nck[\"(c) spectator f4' (site 2) same\"] = {Factor[fitA2[[1]]], fitA2[[2]]};\nck[\"(c) the whole covector v4 (site 1, site 2) is independent of theta12: equal at all 9 theta2?\"] = {Length[Union[f4Data[[All, \"v1\"]]]] === 1, Length[Union[f4Data[[All, \"v2\"]]]] === 1};\n(* (d) decomposition over one-site operators *)\ndecomp[vv_, os_, om1_] := Module[{ops = os[\"ops\"], Cz, S3m2, S3m1, cand, candN, base, baseN, rowsBase, rowsC, found = {}},\n  Cz = ops[[2]]; S3m2 = ops[[4]]; S3m1 = ops[[5]];\n  base = {om1, om1 . Cz, om1 . S3m2}; baseN = {\"id\", \"Cz\", \"S3[-2]\"};\n  cand = {om1 . S3m1, (om1 . Cz) . Cz, (om1 . Cz) . S3m2, (om1 . Cz) . S3m1, (om1 . S3m2) . S3m2, (om1 . S3m2) . S3m1, (om1 . S3m1) . S3m1};\n  candN = {\"S3[-1]\", \"Cz^2\", \"Cz.S3[-2]\", \"Cz.S3[-1]\", \"S3[-2]^2\", \"S3[-2].S3[-1]\", \"S3[-1]^2\"};\n  Do[found = Select[Subsets[Range[7], {sz}], MatrixRank[Join[base, cand[[#]]]] === MatrixRank[Append[Join[base, cand[[#]]], vv]] &]; If[found =!= {}, Break[]], {sz, 0, 3}];\n  <|\"minSize\" -> If[found === {}, \"none <= 3\", Length[found[[1]]]], \"minimal\" -> (candN[[#]] & /@ found), \"sol\" -> If[found === {}, {}, With[{T = found[[1]]}, {Join[baseN, candN[[T]]], LinearSolve[Transpose[Join[base, cand[[T]]]], vv]}]], \"rkAll\" -> MatrixRank[Join[base, cand]], \"rkBase\" -> MatrixRank[base]|>];\nos1 = oneSiteOps[zP, wP, thN[[1]]]; os2 = oneSiteOps[zP, wP, thN[[2]]];\ndec1 = decomp[v4P1[\"v4\"], os1, bP[\"Om1\"]]; dec2 = decomp[v4P2[\"v4\"], os2, bP[\"Om1\"]];\nck[\"(d) rank of Omega1.{id, Cz, S3[-2]} and of all 10 candidate covectors (site 1)\"] = {dec1[\"rkBase\"], dec1[\"rkAll\"]};\nck[\"(d) site 1: minimal number of extra terms beyond {id, Cz, S3[-2]}, all minimal sets, explicit decomposition v4 = Omega1.(sum coef * op)\"] = {dec1[\"minSize\"], dec1[\"minimal\"], dec1[\"sol\"]};\nck[\"(d) site 2 (operators at theta2): same\"] = {dec2[\"minSize\"], dec2[\"minimal\"], dec2[\"sol\"]};\n(* the cyclic filtration: dim of Omega1 . (polynomials of degree <= d in {Cz, S3[-2], S3[-1]}) *)\ncycDims[os_, om1_] := Module[{ops = {os[\"ops\"][[2]], os[\"ops\"][[4]], os[\"ops\"][[5]]}, cur = {om1}, dims = {1}, all = {om1}},\n  Do[cur = Flatten[Table[c . o, {c, cur}, {o, ops}], 1]; all = Join[all, cur]; AppendTo[dims, MatrixRank[all]], {4}]; dims];\nck[\"(d) cyclic filtration: dim of Omega1.(polynomials of degree <= 0..4 in {Cz, S3[-2], S3[-1]}), site 1, site 2 (full V has dim 15)\"] = {cycDims[os1, bP[\"Om1\"]], cycDims[os2, bP[\"Om1\"]]};\nck[\"(d) is v4 in Omega1.(polynomials of degree <= 2) (site 1, site 2)?\"] = {MatrixRank[Append[Module[{ops = {os1[\"ops\"][[2]], os1[\"ops\"][[4]], os1[\"ops\"][[5]]}, om1 = bP[\"Om1\"]}, Join[{om1}, Table[om1 . o, {o, ops}], Flatten[Table[(om1 . o) . p, {o, ops}, {p, ops}], 1]]], v4P1[\"v4\"]]] == MatrixRank[Module[{ops = {os1[\"ops\"][[2]], os1[\"ops\"][[4]], os1[\"ops\"][[5]]}, om1 = bP[\"Om1\"]}, Join[{om1}, Table[om1 . o, {o, ops}], Flatten[Table[(om1 . o) . p, {o, ops}, {p, ops}], 1]]]], MatrixRank[Append[Module[{ops = {os2[\"ops\"][[2]], os2[\"ops\"][[4]], os2[\"ops\"][[5]]}, om1 = bP[\"Om1\"]}, Join[{om1}, Table[om1 . o, {o, ops}], Flatten[Table[(om1 . o) . p, {o, ops}, {p, ops}], 1]]], v4P2[\"v4\"]]] == MatrixRank[Module[{ops = {os2[\"ops\"][[2]], os2[\"ops\"][[4]], os2[\"ops\"][[5]]}, om1 = bP[\"Om1\"]}, Join[{om1}, Table[om1 . o, {o, ops}], Flatten[Table[(om1 . o) . p, {o, ops}, {p, ops}], 1]]]]};\n(* (e) weights *)\nwtT = Table[{u12wts[[m]], u12dims[[m]], MatrixRank[v4P1[\"L3\"][[All, u12idx[[m]]]]], MatrixRank[Append[v4P1[\"L3\"], v4P1[\"v4\"]][[All, u12idx[[m]]]]], MatrixRank[v4P2[\"L3\"][[All, u12idx[[m]]]]], MatrixRank[Append[v4P2[\"L3\"], v4P2[\"v4\"]][[All, u12idx[[m]]]]]}, {m, Length[u12wts]}];\nck[\"(e) per weight {weight, dim, rank 3-dim L1 (site 1), rank 4-dim L1 (site 1), rank 3-dim L2 (site 2), rank 4-dim L2}\"] = wtT;\nck[\"(e) weights where the 3-dim L1 falls short (rank < dim), site 1 and site 2; 4-dim L1 reaches all weights with full rank?\"] = {Select[wtT, #[[3]] < #[[2]] &][[All, 1]], Select[wtT, #[[5]] < #[[2]] &][[All, 1]], And @@ (#[[4]] == #[[2]] && #[[6]] == #[[2]] & /@ wtT)};\nchecks = Join[checks, ck];\nGrid[Join[{{\"check\", \"result\"}}, List @@@ Normal[ck]], Frame -> All, Alignment -> Left]\n, Grid[{{\"Task B is [3,1,0]-only: skipped for this Λ. See the [3,1,0] run block below.\"}}, Frame -> All]]\n",
