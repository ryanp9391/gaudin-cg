  {
   "kind": 2,
   "value": "ck = <||>;\nzs = {z[1], z[2], z[3]};\nrsSol = {s[1] -> z[1]^2/((z[1] - z[2]) (z[1] - z[3])), s[2] -> -(z[2]/(z[1] (z[2] - z[3]))), s[3] -> 1/(z[1] z[2]), r[1] -> -(z[3]/z[2]), r[2] -> -(z[3]/z[1]), r[3] -> (z[2]^2 (-z[1] + z[3]))/(z[1]^2 (z[2] - z[3]))};\nexpN[a_] := With[{A = Normal[a]}, IdentityMatrix[Length[A]] + Sum[MatrixPower[A, k]/k!, {k, 1, nilp}]];\nck[\"expN = MatrixExp on root generators (exact, 3 test values)\"] = And @@ Flatten[Table[If[i == j, True, expN[c Ee[i, j]] === MatrixExp[c Normal[Ee[i, j]]]], {i, 3}, {j, 3}, {c, {3/7, -5/2, 2}}]];\nx0Of[zz_] := Module[{rs, ppinv, pminv, dinv, x},\n  rs = rsSol /. Thread[zs -> zz];\n  ppinv = expN[-((zz[[1]] + zz[[2]])/(zz[[1]] zz[[2]])) Ee[2, 3]] . expN[(1/(zz[[1]] zz[[2]])) Ee[1, 3]] . expN[-(1/zz[[1]]) Ee[1, 2]];\n  pminv = expN[-(r[3] /. rs) Ee[2, 1]] . expN[-(r[2] /. rs) Ee[3, 1]] . expN[-(r[1] /. rs) Ee[3, 2]];\n  dinv = DiagonalMatrix[Table[Product[(s[k] /. rs)^(-J0[k][p]), {k, 3}], {p, ps[{Λ}]}]];\n  x = e1 . ppinv . dinv . pminv; Flatten[KroneckerProduct[x, x]]];\nx0Control[zz_] := Module[{rs = rsSol /. Thread[zs -> zz], Ppp, Pmp, Pdp, x},\n  Ppp = MatrixExp[(1/zz[[1]]) Normal[Ee[1, 2]]] . MatrixExp[-(1/(zz[[1]] zz[[2]])) Normal[Ee[1, 3]]] . MatrixExp[((zz[[1]] + zz[[2]])/(zz[[1]] zz[[2]])) Normal[Ee[2, 3]]];\n  Pmp = MatrixExp[(r[1] /. rs) Normal[Ee[3, 2]]] . MatrixExp[(r[2] /. rs) Normal[Ee[3, 1]]] . MatrixExp[(r[3] /. rs) Normal[Ee[2, 1]]];\n  Pdp = DiagonalMatrix[Table[Product[(s[k] /. rs)^J0[k][p], {k, 3}], {p, ps[{Λ}]}]];\n  x = First[{e1} . Inverse[Pmp . Pdp . Ppp]]; Flatten[KroneckerProduct[x, x]]];\nck[\"x0Of (factorized inverse) = x0 from Inverse[Pph1] (exact, z = (3/2,5/4,2/3))\"] = x0Of[{3/2, 5/4, 2/3}] === x0Control[{3/2, 5/4, 2/3}];\nρdiag[d_] := DiagonalMatrix[Table[Product[d[[k]]^J0[k][p], {k, 3}], {p, ps[{Λ}]}]];\n(* row vector times rho(exp(c E_ij)) *)\nApow[i_, j_][k_] := Apow[i, j][k] = If[k == 0, IdentityMatrix[d1], MatrixPower[Normal[Ee[i, j]], k]];\nrowExp[vv_, c_, {i_, j_}] := vv + Sum[c^k/k! (vv . Apow[i, j][k]), {k, 1, nilp}];\n(* e1 rho(exp(p1 E12) exp(p2 E13) exp(p3 E23)) for Gauss parameters (p1, p2, p3) *)\ncoverG[{p1_, p2_, p3_}] := rowExp[rowExp[rowExp[e1, p1, {1, 2}], p2, {1, 3}], p3, {2, 3}];\n(* a 3x3 upper unipotent n = [[1,a,b],[0,1,c],[0,0,1]] = exp(a e12) exp((b-ac) e13) exp(c e23): Gauss parameters (a, b - a c, c) *)\ngaussOfN[n_] := {n[[1, 2]], n[[1, 3]] - n[[1, 2]] n[[2, 3]], n[[2, 3]]};\ncoverU[n_] := coverG[gaussOfN[n]];\nrhoU[n_] := With[{g = gaussOfN[n]}, expN[g[[1]] Ee[1, 2]] . expN[g[[2]] Ee[1, 3]] . expN[g[[3]] Ee[2, 3]]];\nnInv3[n_] := {{1, -n[[1, 2]], n[[1, 2]] n[[2, 3]] - n[[1, 3]]}, {0, 1, -n[[2, 3]]}, {0, 0, 1}};\n(* Gauss parameters of the one-site vacuum n(z,w) (depends on w1, w2 only); w2 = Infinity is the limit *)\nrGauss[zz_, w1_, w2_] := If[w2 === Infinity,\n  {(w1 - zz[[1]])/(w1 - zz[[2]]), -((w1 - zz[[1]]) (zz[[2]] - zz[[3]]))/((zz[[1]] - zz[[2]]) (w1 - zz[[3]])), ((w1 - zz[[2]]) (zz[[1]] - zz[[3]]))/((zz[[1]] - zz[[2]]) (w1 - zz[[3]]))},\n  {(w1 - zz[[1]])/(w1 - zz[[2]]), ((w1 - zz[[1]]) (zz[[1]] - w2) (zz[[2]] - zz[[3]]))/((zz[[1]] - zz[[2]]) (w1 - zz[[3]]) (w2 - zz[[3]])), ((w1 - zz[[2]]) (zz[[2]] - w2) (zz[[1]] - zz[[3]]))/((zz[[1]] - zz[[2]]) (w1 - zz[[3]]) (zz[[3]] - w2))}];\nnMat3[zz_, w1_, w2_] := With[{r = rGauss[zz, w1, w2]}, {{1, r[[1]], r[[2]] + r[[1]] r[[3]]}, {0, 1, r[[3]]}, {0, 0, 1}}];\nnOf[zz_, w_] := nMat3[zz, w[[1]], w[[2]]];\n(* the undone unipotent of the pair (w, w'): <e1 rho(n(w)) (x) e1 rho(n(w'))|h> = <e1 rho(n(w) n(w')^-1) (x) e1|h> for every HW ket h *)\nnPrime[zz_, w_, wp_] := nOf[zz, w] . nInv3[nOf[zz, wp]];\nΩD[zz_, w_] := coverU[nOf[zz, w]];\nphiUof[zz_, w_, wp_] := coverU[nPrime[zz, w, wp]];\n(* the 3x3 matrices of the defining rep: check the Gauss parameters give the 3x3 unipotent matrix, and that rhoU is multiplicative (exact, 3 random points) *)\ne3[i_, j_] := Table[KroneckerDelta[i, a] KroneckerDelta[j, b], {a, 3}, {b, 3}];\nn3exp[{p1_, p2_, p3_}] := MatrixExp[p1 e3[1, 2]] . MatrixExp[p2 e3[1, 3]] . MatrixExp[p3 e3[2, 3]];\nck[\"nMat3 = exp(r1 e12) exp(r2 e13) exp(r3 e23) (3x3, exact)\"] = nMat3[{3/2, 5/4, 2/3}, 5/2, 7/3] === n3exp[rGauss[{3/2, 5/4, 2/3}, 5/2, 7/3]];\nck[\"OmegaD = e1 expN(r1 E12) expN(r2 E13) expN(r3 E23) (full matrices, exact, 2 points)\"] = Table[With[{r = rGauss[{3/2, 5/4, 2/3}, w[[1]], w[[2]]]}, ΩD[{3/2, 5/4, 2/3}, w] === e1 . expN[r[[1]] Ee[1, 2]] . expN[r[[2]] Ee[1, 3]] . expN[r[[3]] Ee[2, 3]]], {w, {{5/2, 7/3}, {-3/2, 4/5}}}];\nck[\"rho multiplicative: e1 rho(n n'^-1) = (e1 rho(n)) rho(n'^-1) (exact)\"] = Module[{zz = {3/2, 5/4, 2/3}, n1 = nOf[{3/2, 5/4, 2/3}, {5/2, 7/3}], n2 = nOf[{3/2, 5/4, 2/3}, {7/4, -2/5}]}, phiUof[zz, {5/2, 7/3}, {7/4, -2/5}] === ΩD[zz, {5/2, 7/3}] . rhoU[nInv3[n2]]];\nsVec[zv_] := {zv[[1]]^2/((zv[[1]] - zv[[2]]) (zv[[1]] - zv[[3]])), -(zv[[2]]/(zv[[1]] (zv[[2]] - zv[[3]]))), 1/(zv[[1]] zv[[2]])};\nrVec[zv_] := {-(zv[[3]]/zv[[2]]), -(zv[[3]]/zv[[1]]), (zv[[2]]^2 (zv[[3]] - zv[[1]]))/(zv[[1]]^2 (zv[[2]] - zv[[3]]))};\nPphys[zv_] := expN[rVec[zv][[1]] Ee[3, 2]] . expN[rVec[zv][[2]] Ee[3, 1]] . expN[rVec[zv][[3]] Ee[2, 1]] . ρdiag[sVec[zv]] . expN[(1/zv[[1]]) Ee[1, 2]] . expN[-(1/(zv[[1]] zv[[2]])) Ee[1, 3]] . expN[((zv[[1]] + zv[[2]])/(zv[[1]] zv[[2]])) Ee[2, 3]];\n(* the regime: zeta = eps phi, omega = eps omega-hat, omega' = eps omega-hat' (Gaudin: the vacua do not depend on eps at all); the Stage D grid of 24 direction pairs, eps in {1,2,4} 10^-6 *)\nregG[eps_, ph_, om_, omp_] := <|\"eps\" -> eps, \"z\" -> eps ph, \"w\" -> eps om, \"wp\" -> eps omp|>;\nphiP = {1/3, -2/7, 5/11}; phiC = {-2/5, 3/8, 7/11};\nomGrid = Flatten[Table[{{o1, o2}, {p1, p2}}, {o1, {3/4, -5/3}}, {o2, {-1/5, 9/7, 5/3}}, {p1, {-12/5, 7/2}}, {p2, {1/8, -3/4}}], 3];\nepsL = {10^-6, 2 10^-6, 4 10^-6};\nck[\"grid: 24 points, all directions distinct from phi_k and from each other\"] = {Length[omGrid], And @@ (Length[Union[Join[phiP, #[[1]], #[[2]]]]] == 7 & /@ omGrid)};\nchecks = Join[checks, ck];\nGrid[Join[{{\"check\", \"result\"}}, List @@@ Normal[ck]], Frame -> All, Alignment -> Left]",
