      {
       "data": "Out[91]//TableForm= \\begin{pmatrix}\\left\\{3,0,1,2\\right\\} & 1 & \\mathrm{True}\\\\\\left\\{3,0,2,1\\right\\} & 1 & \\mathrm{True}\\\\\\left\\{2,1,1,2\\right\\} & 1 & \\mathrm{True}\\\\\\left\\{2,1,2,1\\right\\} & 2 & \\mathrm{True}\\\\\\left\\{1,2,1,2\\right\\} & 1 & \\mathrm{True}\\\\\\left\\{2,1,3,0\\right\\} & 1 & \\mathrm{True}\\\\\\left\\{1,2,2,1\\right\\} & 1 & \\mathrm{True}\\\\\\left\\{1,2,3,0\\right\\} & 1 & \\mathrm{True}\\end{pmatrix}",
