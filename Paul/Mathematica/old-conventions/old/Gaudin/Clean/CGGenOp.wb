      {
       "data": "Out[102]= \\frac{a\\left(1,4\\right)^8\\,a\\left(2,3\\right)^8\\,\\mathrm{bra}\\left(0,8,8,0\\right)}{1625702400}+\\frac{a\\left(1,3\\right)\\,a\\left(1,4\\right)^7\\,a\\left(2,4\\right)\\,a\\left(2,3\\right)^7\\,\\mathrm{bra}\\left(1,7,7,1\\right)}{25401600}+\\frac{a\\left(1,3\\right)^2\\,a\\left(1,4\\right)^6\\,a\\left(2,4\\right)^2\\,a\\left(2,3\\right)^6\\,\\mathrm{bra}\\left(2,6,6,2\\right)}{2073600}+\\frac{a\\left(1,3\\right)^3\\,a\\left(1,4\\right)^5\\,a\\left(2,4\\right)^3\\,a\\left(2,3\\right)^5\\,\\mathrm{bra}\\left(3,5,5,3\\right)}{518400}+\\frac{a\\left(1,3\\right)^4\\,a\\left(1,4\\right)^4\\,a\\left(2,4\\right)^4\\,a\\left(2,3\\right)^4\\,\\mathrm{bra}\\left(4,4,4,4\\right)}{331776}+\\frac{a\\left(1,3\\right)^5\\,a\\left(1,4\\right)^3\\,a\\left(2,4\\right)^5\\,a\\left(2,3\\right)^3\\,\\mathrm{bra}\\left(5,3,3,5\\right)}{518400}+\\frac{a\\left(1,3\\right)^6\\,a\\left(1,4\\right)^2\\,a\\left(2,4\\right)^6\\,a\\left(2,3\\right)^2\\,\\mathrm{bra}\\left(6,2,2,6\\right)}{2073600}+\\frac{a\\left(1,3\\right)^7\\,a\\left(1,4\\right)\\,a\\left(2,4\\right)^7\\,a\\left(2,3\\right)\\,\\mathrm{bra}\\left(7,1,1,7\\right)}{25401600}+\\frac{a\\left(1,3\\right)^8\\,a\\left(2,4\\right)^8\\,\\mathrm{bra}\\left(8,0,0,8\\right)}{1625702400}",
