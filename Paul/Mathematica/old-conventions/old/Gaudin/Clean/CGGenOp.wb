  {
   "kind": 2,
   "value": "(* (g) Graded Levi decomposition: degree-k dimensions vs the D^j Sym^a (x) Sym^a prediction. *)\ngradedDims[S_] := Module[{rep = rect[S], prev = {ConstantArray[0, dim[rect[S]]]}, res = {}, cur, r0, r1},\n   Do[cur = Join[prev, braVec[rep, #] & /@ nList[k]]; r0 = MatrixRank[prev]; r1 = MatrixRank[cur];\n      AppendTo[res, r1 - r0]; prev = cur, {k, 0, 2 S + 2}]; res];\npredDims[S_] := Table[Total[Table[If[0 <= k - 2 j <= S && j <= S - (k - 2 j), (k - 2 j + 1)^2, 0], {j, 0, Floor[k/2]}]], {k, 0, 2 S + 2}];\nTableForm[Table[{S, gradedDims[S], gradedDims[S] === predDims[S], Total[gradedDims[S]], dim[rect[S]]}, {S, 1, 3}],\n  TableHeadings -> {None, {\"S\", \"graded dims\", \"matches prediction\", \"total\", \"dim\"}}]",
   "languageId": "wolfram",
   "outputs": [
    {
