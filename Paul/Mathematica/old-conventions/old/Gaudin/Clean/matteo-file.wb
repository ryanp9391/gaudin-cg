      {
       "data": "Out[75]= \\left\\{\\frac{6}{z}+\\frac{10}{z-1}+\\frac{176}{105},-\\frac{6}{z^2}-\\frac{818}{35\\,z}+\\frac{862}{21\\,\\left(z-1\\right)}+\\frac{86}{105},-\\frac{12}{z^3}+\\frac{372}{7\\,z^2}-\\frac{482}{35\\,z}+\\frac{138}{7\\,\\left(z-1\\right)}-\\frac{1388}{21\\,\\left(z-1\\right)^2}-\\frac{60}{\\left(z-1\\right)^3}+\\frac{16}{105},\\frac{36}{z^4}-\\frac{2084}{35\\,z^3}+\\frac{102}{7\\,z^2}-\\frac{62}{35\\,z}+\\frac{50}{21\\,\\left(z-1\\right)}-\\frac{124}{7\\,\\left(z-1\\right)^2}+\\frac{1052}{21\\,\\left(z-1\\right)^3}+\\frac{120}{\\left(z-1\\right)^4}+\\frac{1}{105}\\right\\}",
