      {
       "data": "Out[125]= \\begin{pmatrix}8 & 8 & 0 & 0\\\\8 & 0 & 8 & 0\\\\8 & 0 & 0 & 8\\\\0 & 8 & 8 & 0\\\\0 & 8 & 0 & 8\\\\0 & 0 & 8 & 8\\end{pmatrix}",
       "mime": "text/plain"
