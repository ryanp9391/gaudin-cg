  {
   "kind": 1,
   "value": "# Build Hamiltonians",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[LL];\nLL[rep1_,rep2_][i_,j_][z_] := ϕ[j] KroneckerDelta[i,j] SparseArray[IdentityMatrix[dim[rep1] dim[rep2]]] + KroneckerProduct[EM[i,j,rep1],Id[rep2]]/(z)+KroneckerProduct[Id[rep1],EM[i,j,rep2]]/(z - 1);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "M[{i_, j_}][f_] := D[f, z] KroneckerDelta[i, j] + L[i, j][z] . f;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[detOp];\ndetOp =\n  (1/4! Sum[\n       Signature[iperm] Signature[jperm]\n        M[{iperm[[1]], jperm[[1]]}][M[{iperm[[2]], jperm[[2]]}][\n          M[{iperm[[3]], jperm[[3]]}][M[{iperm[[4]], jperm[[4]]}][f[z]]]]],\n       {iperm, Permutations[Range[4]]}, {jperm, Permutations[Range[4]]}] // ExpandAll) //.\n    Dot[a___, b_ + c_, d___] :> Dot[a, b, d] + Dot[a, c, d] //.\n    Dot[a___, b_, d___] :> b Dot[a, d] /; FreeQ[b, f | L] //.\n    Dot[a___, b_*c_, d___] :> b Dot[a, c, d] /; FreeQ[b, L] //.\n    Dot[a___, last_] :> Dot[a] last /; FreeQ[last, L];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[applyLL];\napplyLL[rep1_, rep2_][expr_] := expr /. {\n    Derivative[n_][L[a_, b_]][zz_] :> D[LL[rep1, rep2][a, b][zz], {zz, n}],\n    L[a_, b_][zz_] :> LL[rep1, rep2][a, b][zz]};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[Hop];\nHop[1][rep1_, rep2_][z_] := applyLL[rep1, rep2][Coefficient[detOp, f'''[z]]] // ExpandAll;\nHop[2][rep1_, rep2_][z_] := applyLL[rep1, rep2][Coefficient[detOp, f''[z]]]  // ExpandAll;\nHop[3][rep1_, rep2_][z_] := applyLL[rep1, rep2][Coefficient[detOp, f'[z]]]   // ExpandAll;\nHop[4][rep1_, rep2_][z_] := applyLL[rep1, rep2][Coefficient[detOp, f[z]]]    // ExpandAll;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
