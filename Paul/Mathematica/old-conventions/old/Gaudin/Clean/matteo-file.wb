      {
       "data": "Out[101]= \\left\\{\\frac{2}{z}+\\frac{2}{z-1}+\\frac{176}{105},-\\frac{4}{z^2}+\\frac{2}{105\\,z}+\\frac{422}{105\\,\\left(z-1\\right)}-\\frac{4}{\\left(z-1\\right)^2}+\\frac{86}{105},\\frac{4}{z^3}+\\frac{68}{105\\,z^2}-\\frac{6}{35\\,z}+\\frac{6}{5\\,\\left(z-1\\right)}-\\frac{772}{105\\,\\left(z-1\\right)^2}+\\frac{4}{\\left(z-1\\right)^3}+\\frac{16}{105},-\\frac{4}{3\\,z^3}+\\frac{8}{35\\,z^2}-\\frac{2}{105\\,z}+\\frac{2}{21\\,\\left(z-1\\right)}-\\frac{8}{7\\,\\left(z-1\\right)^2}+\\frac{20}{3\\,\\left(z-1\\right)^3}+\\frac{1}{105}\\right\\}",
       "mime": "text/plain"
      }
     ],
     "id": "30da6048-a30b-427e-a163-cfa36660510e"
