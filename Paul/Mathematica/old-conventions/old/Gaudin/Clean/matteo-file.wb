   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Analytic form of Hamiltonians",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*Hamiltonians*)\nClearAll[H,h,expandH];\nexpandH={H[a_/;a>=1][z_]:>h[a,0,0]+Sum[h[a,i,0]/z^i,{i,1,a}]+Sum[h[a,0,i]/(z-1)^i,{i,1,a}]};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*characters in twist parameters entering asymptotics of Hamiltonians*)\nχ[a_]:=SymmetricPolynomial[a,ϕ[#]&/@Range[4]]\nh[a_,0,0]:=χ[a];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*h[a,a,0] and h[a,0,a] are central and are determined by the weights on each site*)\n(*apply central h's*)\nClearAll[applycentralH];\napplycentralH=Table[{h[a, a, 0] -> Sum[Product[e1[subset[[m]]] - (m - 1), {m, 1, a}], {subset, Subsets[Range[4], {a}]}],\n               h[a, 0, a] -> Sum[Product[e2[subset[[m]]] - (m - 1), {m, 1, a}], {subset, Subsets[Range[4], {a}]}]},{a,1,4}]//Flatten;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*relation between highest hamiltonians and global Cartan generators*)\nClearAll[applyleadingH];\napplyleadingH=Table[(h[a,0,1]->-h[a,1,0]+Total[\n  (Times @@ ϕ /@ #) * Total[et /@ Complement[Range[4], #]] & /@ Subsets[Range[4], {a-1}]]),{a,2,4}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*replacement rule for applying concrete representations*)\nClearAll[applyrep];\napplyrep[rep1_List, rep2_List, repall_List] := Join[\n  Thread[e1 /@ Range[4] -> rep1],\n  Thread[e2 /@ Range[4] -> rep2],\n  Thread[et /@ Range[4] -> repall]\n]",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*examples*)\nH[1][z]/.expandH/.applycentralH/.applyrep[fund,antifund,adj]\nH[2][z]/.expandH/.applyleadingH/.applycentralH/.applyrep[fund,antifund,adj]",
   "languageId": "wolfram",
   "outputs": [
    {
