  {
   "kind": 2,
   "value": "(* ---- 4a. ORTHOGONALITY. det = 0 for distinct states, nonzero for the norms.\n       Exact test (Simplify on algebraic numbers) -- N[] cannot certify a vanishing determinant.\n       The same-weight rows are the sharp test: those states differ only in their\n       integrals of motion. ---- *)\nClearAll[orthTest];\northTest[SS_, PP_, muA_, kA_, muB_, kB_, sub_] := Module[{rA, rB},\n  rA = TwistedSolve[SS, PP, muA, sub][[kA]]; rB = TwistedSolve[SS, PP, muB, sub][[kB]];\n  {{SS, PP}, muA, kA, muB, kB, If[muA === muB && kA === kB, \"norm\", \"cross\"],\n   Simplify[Det[spMatFSoV[SS, PP, rA, rB, sub]]] === 0}];\n\nGrid[Join[{{\"(S,P)\", \"mu_A\", \"#A\", \"mu_B\", \"#B\", \"kind\", \"det == 0\"}},\n  {orthTest[1, 1, {2, 2, 0, 0}, 1, {2, 1, 1, 0}, 1, numU],\n   orthTest[1, 1, {2, 1, 1, 0}, 1, {2, 2, 0, 0}, 1, numU],\n   orthTest[1, 1, {2, 1, 1, 0}, 1, {2, 1, 1, 0}, 2, numU],\n   orthTest[1, 1, {2, 1, 1, 0}, 2, {2, 1, 1, 0}, 1, numU],\n   orthTest[1, 1, {2, 2, 0, 0}, 1, {2, 2, 0, 0}, 1, numU],\n   orthTest[1, 1, {2, 1, 1, 0}, 1, {2, 1, 1, 0}, 1, numU],\n   orthTest[2, 2, {4, 4, 0, 0}, 1, {4, 3, 1, 0}, 1, numU],\n   orthTest[2, 2, {4, 3, 1, 0}, 1, {4, 4, 0, 0}, 1, numU],\n   orthTest[2, 2, {4, 3, 1, 0}, 1, {4, 3, 1, 0}, 2, numU],\n   orthTest[2, 2, {4, 3, 1, 0}, 2, {4, 3, 1, 0}, 1, numU],\n   orthTest[2, 2, {4, 4, 0, 0}, 1, {4, 4, 0, 0}, 1, numU],\n   orthTest[2, 2, {4, 3, 1, 0}, 1, {4, 3, 1, 0}, 1, numU],\n   orthTest[2, 2, {4, 3, 1, 0}, 2, {4, 3, 1, 0}, 2, numU]}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"961317\" data-output-id=\"96\" data-out-n=\"54\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"8\" data-sub-start=\"10\" data-sub-end=\"23\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[54]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"28\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:16.84em;vertical-align:-8.15em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.69em;\"><span style=\"top:-10.65em;\"><span class=\"pstrut\" style=\"height:10.65em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:16.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-8.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.65em;\"><span style=\"top:-10.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">(S,P)</span></span></span></span><span style=\"top:-9.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-8.41em;\"><span c