   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 2. Baxter equation and the exact twisted solver -------------------------------------- *)\nClearAll[Mdeg, qc, qmonic, BaxRes, qpoly, TwistedSolve];\nMdeg[S_, P_, μ_List] := (S + P) - μ;\nqmonic[k_, M_][x_] := x^M + Sum[qc[k, j] x^j, {j, 0, M - 1}];\nqpoly[clist_List, uu_] := Module[{x}, (clist . x^Range[0, Length[clist] - 1]) /. x -> uu];\n\n(* branch-k Baxter residual, Q_k = z_k^(u/h) q_k with the exponential stripped *)\nBaxRes[S_, P_, μ_][k_][qf_][x_] :=\n   z[k]^4 Product[ν1[S, P][x - m h], {m, 0, 3}] qf[x + h]\n - z[k]^3 τ[1][S, P, μ][x] Product[ν1[S, P][x - m h], {m, 1, 3}] qf[x]\n + z[k]^2 τ[2][S, P, μ][x] Product[ν1[S, P][x - m h], {m, 2, 3}] qf[x - h]\n - z[k]   τ[3][S, P, μ][x] ν1[S, P][x - 3 h] qf[x - 2 h]\n + τ[4][S, P, μ][x] qf[x - 3 h];\n\nTwistedSolve::negdeg = \"μ=`1` gives a negative degree M=`2` at (S,P)=(`3`,`4`).\";\nTwistedSolve::nosol = \"No solution for μ=`1` at (S,P)=(`2`,`3`).\";\nTwistedSolve[S_, P_, μ_List, sub_: {}] := Module[{Ms, x, eqs = {}, unk, sols, R},\n   Ms = Mdeg[S, P, μ];\n   If[! VectorQ[Ms, IntegerQ] || Min[Ms] < 0, Message[TwistedSolve::negdeg, μ, Ms, S, P]; Return[$Failed]];\n   Do[R = Expand[(BaxRes[S, P, μ][k][qmonic[k, Ms[[k]]]][x]) /. sub];\n      eqs = Join[eqs, DeleteCases[CoefficientList[R, x], 0]], {k, 4}];\n   unk = Join[tcvars, Flatten[Table[qc[k, j], {k, 4}, {j, 0, Ms[[k]] - 1}]]];\n   sols = Solve[Thread[eqs == 0], unk];\n   If[sols === {}, Message[TwistedSolve::nosol, μ, S, P]; Return[{}]];\n   Table[<|\"M\" -> Ms, \"tc\" -> (tcvars /. s),\n           \"q\" -> Table[PadRight[CoefficientList[qmonic[k, Ms[[k]]][x] /. s, x], Ms[[k]] + 1], {k, 4}]|>,\n         {s, sols}]];\n\n(* test parameters: exact rationals, UNIMODULAR twist, all z distinct *)\nnumU = {θ1 -> 1/3, θ2 -> 1/7, h -> 1, z[1] -> 2, z[2] -> 3, z[3] -> 1/2, z[4] -> 1/3};\n{\"2. solver loaded; unimodular?\", Simplify[Product[z[j], {j, 4}] /. numU] === 1}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"961317\" data-output-id=\"92\" data-out-n=\"25\" data-sub-idx=\"12\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"2\" data-sub-start=\"30\" data-sub-end=\"30\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[25]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"28\" data-latex-b64=\"XGxlZnRce1x0ZXh0ezIuIHNvbHZlciBsb2FkZWQ7IHVuaW1vZHVsYXI/fSxcbWF0aHJte1RydWV9XHJpZ2h0XH0=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord text\"><span class=\"mord\">2. solver loaded; unimodular?</span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[25]= \\left\\{\\text{2. solver loaded; unimodular?},\\mathrm{True}\\right\\}",
       "mime": "text/plain"
      }
     ],
     "id": "62bbdc2a-08c3-4114-8f9c-fc19d9b7e6a0"
    }
