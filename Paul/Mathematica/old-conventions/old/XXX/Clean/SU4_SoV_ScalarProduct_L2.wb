  {
   "kind": 2,
   "value": "(* ---- 3a. CHECK: O annihilates q_i^[2] and O-dagger annihilates q^j, all four branches. ------ *)\nClearAll[relCheck];\nrelCheck[SS_, PP_, mu_, sub_] := Module[{r, x, pt = 17/13}, r = First[TwistedSolve[SS, PP, mu, sub]];\n  Table[{{SS, PP}, mu, k,\n     Chop[N[Simplify[(OpO[SS, PP, mu, r][Function[y, qhat[r, sub][k][y + h]]][x] /. sub) /. x -> pt], 30]],\n     Chop[N[Simplify[(OpOd[SS, PP, mu, r][qdualhat[SS, PP, r, sub][k]][x] /. sub) /. x -> pt], 30]],\n     Exponent[Simplify[qDual[SS, PP, r, sub][k][x]], x], mu[[k]]}, {k, 4}]];\n\nGrid[Join[{{\"(S,P)\", \"mu\", \"k\", \"O q_k^[2]\", \"Odag q^k\", \"deg q^k\", \"mu_k\"}},\n  Join @@ {relCheck[1, 1, {2, 1, 1, 0}, numU], relCheck[2, 2, {4, 3, 1, 0}, numU]}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
