  {
   "kind": 2,
   "value": "(* ---- 6. The boxed zero-twist formula: physical limit vs B_A/B_vac, with the site-ladder measure and c = cHX. ---- *)\nClearAll[vandX, hwRecX, gX, epsLimX, phiSetX, lhsX, untwNX, bracketX, BX, EformulaX, relTabX];\n\nvandX[z_, lam_] := Product[(z[[i]] - z[[j]])^(lam[[i]] - lam[[j]]), {i, 3}, {j, i + 1, 3}];\nhwRecX[eps_, phi_, m_] := SelectFirst[twX[eps, phi][\"recs\"], #[\"hwLimit\"] && #[\"mult\"] == m &];\n\n(* V_vac(z)/V_A(z) <L_A|R_A>/(<L_A|0><0|R_A>), with <L_A|R_A> = 1; analytic in eps since both sides scale as eps^(2k). *)\ngX[eps_, phi_, m_] := With[{s = hwRecX[eps, phi, m], z = twX[eps, phi][\"z\"]},\n   vandX[z, untwX[[1, \"mu\"]]]/vandX[z, untwX[[m, \"mu\"]]]/(s[\"braR\"] s[\"Lket\"])];\nepsLimX = {10^-6, 10^-7, 10^-8};\nphiSetX = {{1, 1/3, -4/3}, {2, -1/2, -3/2}};\n(* Quadratic extrapolation to eps = 0, normalized by the vacuum; the 2-point value gives the error bar. *)\nlhsX[phi_] := lhsX[phi] = Table[With[{pts = Table[{e, gX[e, phi, m]/gX[e, phi, 1]}, {e, epsLimX}]},\n     {InterpolatingPolynomial[pts, 0], InterpolatingPolynomial[pts[[2 ;;]], 0]}], {m, 7}];\n\n(* Untwisted side: numeric q's first (radicals in the doublet), contour bracket over the site-ladder poles. *)\nuntwNX = Table[Join[s, <|\"q\" -> N[s[\"q\"], 250], \"qd\" -> N[s[\"qd\"], 250]|>], {s, untwX}];\nbracketX[f_] := Sum[weightsX[[r]] Exp[2 Pi I SetPrecision[polesX[[r]], 250]] f[polesX[[r]]], {r, Length[polesX]}];\nEformulaX[lam_] := -(lam[[1]] - lam[[2]] + 1) (lam[[2]] - lam[[3]] + 1)/\n   ((lam[[1]] - lam[[3]] + 1)! (lam[[1]] - lam[[2]])! (lam[[2]] - lam[[3]])!);\n(* Returns {det calN/(c^ref Psi^ref), E_lambda}. *)\nBX[m_, c_] := Module[{s = untwNX[[m]], q, qd, Nm, psi, cref},\n   q = Function[{i, x}, qpolyX[s[\"q\"][[i]], x]];\n   qd = Function[{j, x}, qpolyX[s[\"qd\"][[j]], x]];\n   Nm = Table[{\n      bracketX[Function[x, qd[ij[[2]], x + 1] q[ij[[1]], x] - qd[ij[[2]], x] q[ij[[1]], x]]],\n      bracketX[Function[x, x qd[ij[[2]], x] q[ij[[1]], x - 1] - (x - c) qd[ij[[2]], x + 1] q[ij[[1]], x]]],\n      bracketX[Function[x, qd[ij[[2]], x] q[ij[[1]], x - 1] - qd[ij[[2]], x + 1] q[ij[[1]], x]]]}, {ij, tripleX}];\n   psi = Product[psiRefLocX[Function[i, Function[x, q[i, x]]], th, 1, 2], {th, thetaX}];\n   cref = Product[cRefLocX[Function[j, Function[x, qd[j, x]]], th, 3, 2], {th, thetaX}];\n   {Det[Nm]/(cref psi), EformulaX[s[\"mu\"]]}];\n\nScan[lhsX, phiSetX];\n\nrelTabX = Table[Module[{b = BX[m, cHX], b1 = BX[1, cHX], rhs, lhs = lhsX[phiSetX[[1]]][[m, 1]], reqE},\n    rhs = (b[[2]] b[[1]])/(b1[[2]] b1[[1]]);\n    (* E_A/E_vac the physical limit requires, given det calN/(c Psi) *)\n    reqE = lhs b1[[1]]/b[[1]];\n    {nameX[[m]], Row[untwX[[m, \"mu\"]], \",\"],\n     N[Re[lhs], 15],\n     N[Max[Abs[lhsX[phiSetX[[2]]][[m, 1]]/lhs - 1], Abs[lhsX[phiSetX[[1]]][[m, 2]]/lhs - 1]], 3],\n     N[Re[rhs], 15], N[Abs[rhs/lhs - 1], 3],\n     b[[2]]/b1[[2]], N[Re[reqE], 15],\n     N[Abs[With[{bb = BX[m, cHX - 1], bb1 = BX[1, cHX - 1]}, (bb[[2]] bb[[1]])/(bb1[[2]] bb1[[1]])]/lhs - 1], 3],\n     N[Abs[With[{bb = BX[m, cHX + 1], bb1 = BX[1, cHX + 1]}, (bb[[2]] bb[[1]])/(bb1[[2]] bb1[[1]])]/lhs - 1], 3]}], {m, 7}];\n\nGrid[Prepend[relTabX, {\"multiplet\", \"hw weight\", \"physical limit (phi 1)\", \"rel. spread (2nd phi, extrapolation)\",\n    \"B_A/B_vac, c = cHX\", \"|rhs/lhs - 1|\", \"E_A/E_vac formula\", \"E_A/E_vac required\",\n    \"|rhs/lhs - 1|, c = cHX - 1\", \"|rhs/lhs - 1|, c = cHX + 1\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
