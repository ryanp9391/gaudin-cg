   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 4. Twisted FSoV identity for mixed sites: which measure? Test at eps = 1e-3. ---- *)\nClearAll[qRX, qLX, polesX, weightsX, poleSetsX, setMeasureX, rowX, tripleX, detNX, psiRefX, cRefX, sampleX, orthoX, matchX, measTabX];\n\nqRX[s_, z_, i_, x_] := z[[i]]^x qpolyX[s[\"q\"][[i]], x];\nqLX[s_, z_, j_, x_] := z[[j]]^(-x) qpolyX[s[\"qd\"][[j]], x];\n\n(* Candidates (offsets n in theta_s + n, per site):\n   \"nu\"         = poles of 1/(nu1 nu2 nu3): site 1 {0,1,3}, site 2 {0,1,2};\n   \"siteLadder\" = Gamma_h[nu1]/Gamma_h[nu3^[2]]: site s gets lambda3^(s)..lambda1^(s), i.e. {0,1,2,3} and {0,1,2};\n   \"fullLadder\" = both sites {0,1,2,3}. *)\npoleSetsX = <|\"nu\" -> {Union[rep1X], Union[rep2X]},\n   \"siteLadder\" -> {Range[rep1X[[3]], rep1X[[1]]], Range[rep2X[[3]], rep2X[[1]]]},\n   \"fullLadder\" -> {Range[0, 3], Range[0, 3]}|>;\nsetMeasureX[type_] := (polesX = Flatten@Table[thetaX[[s]] + poleSetsX[type][[s]], {s, 2}];\n   weightsX = Table[1/Times @@ (polesX[[r]] - Delete[polesX, r]), {r, Length[polesX]}]);\n\n(* Row (alpha,i,j); columns u^beta x (-Q^j Q_i, Q^j Q_i^[-2], Q^j[2] Q_i), beta = 0,1. *)\nrowX[A_, B_, z_, {alpha_, {i_, j_}}] := Sum[\n   With[{x = polesX[[r]]},\n    weightsX[[r]] Exp[2 Pi I (alpha - 1) SetPrecision[x, precX]] *\n     Flatten@Table[x^beta {-qLX[A, z, j, x] qRX[B, z, i, x], qLX[A, z, j, x] qRX[B, z, i, x - 1],\n        qLX[A, z, j, x + 1] qRX[B, z, i, x]}, {beta, 0, 1}]], {r, Length[polesX]}];\ntripleX = {{1, 3}, {1, 2}, {2, 3}};\ndetNX[A_, B_, z_] := Det[rowX[A, B, z, #] & /@ Flatten[Table[{alpha, ij}, {alpha, 2}, {ij, tripleX}], 1]];\npsiRefX[B_, z_] := Product[psiRefLocX[Function[i, Function[x, qRX[B, z, i, x]]], th, 1, 2], {th, thetaX}];\ncRefX[A_, z_] := Product[cRefLocX[Function[j, Function[x, qLX[A, z, j, x]]], th, 3, 2], {th, thetaX}];\n\n(* Orthogonality in the largest weight sector. *)\nsampleX = With[{recs = twX[1/1000][\"recs\"]},\n   With[{w = First@MaximalBy[Union[recs[[All, \"mu\"]]], Count[recs[[All, \"mu\"]], #] &]}, Select[recs, #[\"mu\"] == w &]]];\northoX[type_] := (setMeasureX[type];\n   With[{z = twX[1/1000][\"z\"], S = sampleX},\n    With[{dm = Table[detNX[S[[a]], S[[b]], z], {a, Length[S]}, {b, Length[S]}]},\n     N[Max[Abs[dm - DiagonalMatrix[Diagonal[dm]]]]/Min[Abs[Diagonal[dm]]], 3]]]);\n(* det N/(c^ref Psi^ref) x <L|0><0|R> must be the same for all 120 states (= 1/C_vac). *)\nmatchX[type_] := (setMeasureX[type];\n   With[{z = twX[1/1000][\"z\"], recs = twX[1/1000][\"recs\"]},\n    With[{ratio = Table[detNX[s, s, z]/(cRefX[s, z] psiRefX[s, z]) (s[\"braR\"] s[\"Lket\"]), {s, recs}]},\n     N[Max[Abs[ratio/ratio[[1]] - 1]], 3]]]);\n\nmeasTabX = Table[{type, Row[poleSetsX[type][[1]], \",\"], Row[poleSetsX[type][[2]], \",\"], orthoX[type], matchX[type]},\n   {type, Keys[poleSetsX]}];\nsetMeasureX[\"siteLadder\"];\n\nGrid[Prepend[measTabX, {\"measure\", \"site-1 offsets\", \"site-2 offsets\",\n    Row[{\"max|cross det|/min|diag det| (weight \", Row[sampleX[[1, \"mu\"]], \",\"], \", \", Length[sampleX], \" states)\"}],\n    \"120 states: rel. spread of 1/C_vac\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
