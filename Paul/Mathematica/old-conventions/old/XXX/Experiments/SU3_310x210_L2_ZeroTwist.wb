       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"55\" data-out-n=\"572\" data-sub-idx=\"18\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"6\" data-sub-start=\"46\" data-sub-end=\"48\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[572]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.6451em;vertical-align:-4.5526em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.0926em;\"><span style=\"top:-7.0526em;\"><span class=\"pstrut\" style=\"height:7.0526em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:9.6051em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.5526em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.0526em;\"><span style=\"top:-7.2126em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">multiplet</span></span></span></span><span style=\"top:-6.0126em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">42</span></span></span></span><span style=\"top:-4.8126em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">24</span></span></span></span><span style=\"top:-3.6074em;\"><span class=\"pstrut\" style=\"height:3em;\