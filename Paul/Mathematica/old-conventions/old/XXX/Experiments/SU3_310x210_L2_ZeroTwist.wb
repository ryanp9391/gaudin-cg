  {
   "kind": 2,
   "value": "(* ---- 2. Untwisted highest-weight states: (T1,T2) and staggered Q-functions (exact). ---- *)\nClearAll[showX, degTotX, BaxDirX, BaxDualX, polyKernelX, qpolyX, wtX, hwBasisX, hwMusX, hwRecsX, untwX, nameX, psiRefLocX, cRefLocX];\n\n(* Wolfbook replies truncate at the first brace; read results through this. *)\nshowX[e_] := StringReplace[ToString[e, InputForm], {\"{\" -> \"(\", \"}\" -> \")\"}];\n\n(* Twisted degrees: deg q_i = degTotX - mu_i, deg q^j = mu_j, with degTotX = lambda1 summed over sites. *)\ndegTotX = rep1X[[1]] + rep2X[[1]];\n\n(* Reduced Baxter operators (direct gauge nu1, dual gauge nu3); z = 1 is untwisted. *)\nBaxDirX[T1_, T2_, z_][q_][x_] := (z nuX[1][x] nuX[1][x - 1] nuX[1][x - 2] q[x + 1] - (T1 /. u -> x) nuX[1][x - 1] nuX[1][x - 2] q[x]\n    + (T2 /. u -> x) nuX[1][x - 2] q[x - 1]/z - qdetX[x] q[x - 2]/z^2);\nBaxDualX[T1_, T2_, y_][g_][x_] := (nuX[3][x + 1] nuX[3][x + 2] nuX[3][x + 3] g[x] - y (T1 /. u -> x + 1) nuX[3][x + 2] nuX[3][x + 3] g[x + 1]\n    + y^2 (T2 /. u -> x + 2) nuX[3][x + 3] g[x + 2] - y^3 qdetX[x + 3] g[x + 3]);\nqpolyX[cl_List, y_] := Fold[#1 y + #2 &, 0, Reverse[cl]];\n\npolyKernelX[op_] := Module[{c, x, pf, eqs, ns, rr},\n   pf = Function[y, Evaluate[Sum[c[m] y^m, {m, 0, 14}]]];\n   eqs = CoefficientList[Expand[op[pf][x]], x];\n   ns = NullSpace[Table[D[e, c[m]], {e, eqs}, {m, 0, 14}]];\n   rr = DeleteCases[RowReduce[Reverse /@ ns], {0 ..}];\n   SortBy[Table[RootReduce /@ (Reverse[r] /. {a___, 0 ..} :> {a}), {r, rr}], Length]];\n\nwtX = Transpose[Table[Diagonal[Normal@EtotX[i, i]], {i, 3}]];\nhwBasisX[w_] := Module[{idx = Flatten@Position[wtX, w]},\n   Transpose@Table[ReplacePart[ConstantArray[0, dcX], Thread[idx -> nv]],\n     {nv, NullSpace[Normal[Join[EtotX[1, 2], EtotX[2, 3]]][[All, idx]]]}]];\n(* hw weights found from the kernel of E12, E23; ordered by height below the vacuum (vacuum first). *)\nhwMusX = SortBy[Select[Union[wtX], #[[1]] >= #[[2]] >= #[[3]] &&\n      Length[NullSpace[Normal[Join[EtotX[1, 2], EtotX[2, 3]]][[All, Flatten@Position[wtX, #]]]]] > 0 &], -(2 #[[1]] + #[[2]]) &];\n\nhwRecsX[w_] := Module[{Bt = hwBasisX[w], r, Rk, evs, ev, p},\n   r = First@Select[Subsets[Range[dcX], {Length[Bt[[1]]]}], Det[Bt[[#]]] =!= 0 &, 1];\n   Rk[a_, k_] := Inverse[Bt[[r]]].(Normal[TcoX[a, k, {1, 1, 1}]].Bt)[[r]];\n   evs = Eigenvectors[Rk[2, 0]];\n   Table[ev = evs[[c]]; p = First@Flatten@Position[Unitize[ev], 1];\n    <|\"mu\" -> w, \"vec\" -> Bt.ev,\n     \"T1\" -> Sum[RootReduce[(Rk[1, k].ev)[[p]]/ev[[p]]] u^k, {k, 0, 2}],\n     \"T2\" -> Sum[RootReduce[(Rk[2, k].ev)[[p]]/ev[[p]]] u^k, {k, 0, 4}]|>, {c, Length[evs]}]];\n\n(* Records: q = q_1,q_2,q_3; qd = q^1,q^2,q^3. The doublet (4,2,1) is ordered by N[[u^0]T2]. *)\nuntwX = Module[{recs = Flatten[hwRecsX /@ hwMusX, 1]},\n   recs = SortBy[recs, {First@Flatten@Position[hwMusX, #[\"mu\"]] &, N[Coefficient[#[\"T2\"], u, 0], 30] &}];\n   Table[Append[s, <|\"q\" -> polyKernelX[BaxDirX[s[\"T1\"], s[\"T2\"], 1]],\n      \"qd\" -> Reverse[polyKernelX[BaxDualX[s[\"T1\"], s[\"T2\"], 1]]]|>], {s, recs}]];\n(* 15 x 8 = 42 + 24 + 15' + 15 + 15 + 6b + 3; index 1 = vacuum (5,2,0). *)\nnameX = {\"42\", \"24\", \"15'\", \"15_1\", \"15_2\", \"6b\", \"3\"};\n\npsiRefLocX[Qd_, th_, a_, b_] := Qd[a][th + 1] (Qd[a][th] Qd[b][th - 1] - Qd[b][th] Qd[a][th - 1]);\ncRefLocX[Qu_, th_, c_, d_] := (Qu[c][th + 1] (Qu[c][th] Qu[d][th + 1] - Qu[d][th] Qu[c][th + 1])\n    - Qu[c][th] (Qu[c][th] Qu[d][th + 2] - Qu[d][th] Qu[c][th + 2]))/4;\n\nGrid[Prepend[Table[With[{s = untwX[[m]]}, {nameX[[m]], Row[s[\"mu\"], \",\"], Row[Length /@ s[\"q\"] - 1, \",\"],\n     Row[Length /@ s[\"qd\"] - 1, \",\"], Row[(degTotX - s[\"mu\"]) + {0, 1, 2}, \",\"], Row[s[\"mu\"] + {2, 1, 0}, \",\"],\n     And @@ Flatten[{\n        RootReduce[Expand[BaxDirX[s[\"T1\"], s[\"T2\"], 1][Function[y, Evaluate@qpolyX[#, y]]][u]]] === 0 & /@ s[\"q\"],\n        RootReduce[Expand[BaxDualX[s[\"T1\"], s[\"T2\"], 1][Function[y, Evaluate@qpolyX[#, y]]][u]]] === 0 & /@ s[\"qd\"]}]}],\n    {m, Length[untwX]}],\n   {\"multiplet\", \"hw weight\", \"deg q_i\", \"deg q^j\", \"predicted (5-l_i)+(i-1)\", \"predicted l_j+3-j\", \"Baxter exact\"}],\n  Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
