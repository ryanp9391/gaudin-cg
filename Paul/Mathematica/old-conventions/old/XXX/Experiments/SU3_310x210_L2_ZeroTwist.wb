       "data": "Out[577]= \\begin{array}{|c|c|c|}\\hline\\text{multiplet} & \\text{|-det calN''/det calN - 1|} & \\text{same with c+1 in calN'' (contrast)}\\\\\\hline\\text{42} & 0.\\times 10^{-246} & 0.167\\\\\\hline\\text{24} & 0.\\times 10^{-247} & 0.133\\\\\\hline\\text{15'} & 0.\\times 10^{-247} & 0.15\\\\\\hline\\text{15\\_1} & 0.\\times 10^{-246} & 0.0353\\\\\\hline\\text{15\\_2} & 0.\\times 10^{-247} & 0.246\\\\\\hline\\text{6b} & 0.\\times 10^{-246} & 0.0148\\\\\\hline\\text{3} & 0.\\times 10^{-246} & 0.454\\\\\\hline\\end{array}",
