pan></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:1.19em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:9.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.1em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[512]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{multiplet} & \\text{hw weight} & \\text{deg q\\_i} & \\text{deg q\\^{}j} & \\text{predicted (5-l\\_i)+(i-1)} & \\text{predicted l\\_j+3-j} & \\text{Baxter exact}\\\\\\hline\\text{42} & 5,2,0 & 0,4,7 & 7,3,0 & 0,4,7 & 7,3,0 & \\mathrm{True}\\\\\\hline\\text{24} & 4,3,0 & 1,3,7 & 6,4,0 & 1,3,7 & 6,4,0 & \\mathrm{True}\\\\\\hline\\text{15'} & 5,1,1 & 0,5,6 & 7,2,1 & 0,5,6 & 7,2,1 & \\mathrm{True}\\\\\\hline\\text{15\\_1} & 4,2,1 & 1,4,6 & 6,3,1 & 1,4,6 & 6,3,1 & \\mathrm{True}\\\\\\hline\\text{15\\_2} & 4,2,1 & 1,4,6 & 6,3,1 & 1,4,6 & 6,3,1 & \\mathrm{True}\\\\\\hline\\text{6b} & 3,3,1 & 2,3,6 & 5,4,1 & 2,3,6 & 5,4,1 & \\mathrm{True}\\\\\\hline\\text{3} & 3,2,2 & 2,4,5 & 5,3,2 & 2,4,5 & 5,3,2 & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "0644b89f-5ac2-4cc3-a383-5332b7d70895"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 3. Twisted chain at z_j = Exp[eps phi_j]: all 120 states, Q-functions, physical references. ---- *)\nClearAll[precX, phiX, rhoX, zOfX, solveMonicX, nilExpX, refBraX, refKetX, twX, multipletOfX, sectorsX];\n\nprecX = 200;\nphiX = {1, 1/3, -4/3};\nrhoX[a_, k_] := Prime[7 a + k + 1]/(11 + 2 a + k);\nzOfX[eps_, phi_] := N[Exp[eps phi], precX];\nsectorsX = Union[wtX];\n\nsolveMonicX[op_, degree_] := Module[{c, x, q, eqs, aa, bb, sol, res, scale},\n  q = Function[y, Evaluate[y^degree + Sum[c[m] y^m, {m, 0, degree - 1}]]];\n  eqs = CoefficientList[Expand[op[q][x]], x];\n  aa = Table[Coefficient[e, c[m]], {e, eqs}, {m, 0, degree - 1}];\n  bb = eqs /. c[_] -> 0;\n  sol = If[degree == 0, {}, LeastSquares[aa, -bb]];\n  res = If[degree == 0, bb, aa.sol + bb];\n  scale = Max[Join[{1}, Abs@Flatten[{aa, bb}]]];\n  {Append[sol, 1], Max[Abs[res]]/scale}];\n\nnilExpX[mat_, c_] := Module[{acc = IdentityMatrix[Length[mat]], term = IdentityMatrix[Length[mat]]},\n   Do[term = c term.mat/k; acc += term, {k, 1, 8}]; acc];\n(* One-site branch-I reference covector/vector (a13 = 3/5, a23 = 4/7), for any site rep via its generators EE. *)\nrefBraX[EE_, z_] := With[{a12 = -z[[2]] (z[[1]] - z[[3]])/(z[[1]] (z[[2]] - z[[3]])) (3/5)/(4/7), n = Length[EE[1, 1]]},\n   UnitVector[n, 1].nilExpX[Normal@EE[1, 2], a12].nilExpX[Normal@EE[1, 3], 3/5].nilExpX[Normal@EE[2, 3], 4/7]];\nrefKetX[EE_, z_] := With[{a12 = -z[[2]] (z[[1]] - z[[3]])/(z[[1]] (z[[2]] - z[[3]])) (3/5)/(4/7), a13 = 3/5, a23 = 4/7, n = Length[EE[1, 1]]},\n   nilExpX[Normal@EE[2, 1], -z[[1]] (z[[1]] - z[[3]])/(a12 z[[2]] (z[[2]] - z[[3]]))].\n    nilExpX[Normal@EE[3, 1], -z[[1]]^2/(a13 z[[3]]^2)].\n    nilExpX[Normal@EE[3, 2], -z[[2]]^2 (z[[1]] - z[[3]])/(a23 (z[[1]] - z[[2]]) z[[3]]^2)].UnitVector[n, 1]];\n\nmultipletOfX[t1_, t2_] := First@Ordering[Table[\n     Total[Abs[CoefficientList[t1 - N[s[\"T1\"], 50], u]]] + Total[Abs[CoefficientList[t2 - N[s[\"T2\"], 50], u]]],\n     {s, untwX}], 1];\n\ntwX[eps_] := twX[eps, phiX];\ntwX[eps_, phi_List] := twX[eps, phi] = Module[{z = zOfX[eps, phi], recs, bra, ket, tco},\n   Do[tco[a, k] = Normal[TcoX[a, k, z]], {a, 2}, {k, 0, 2 a}];\n   bra = Flatten[KroneckerProduct[refBraX[EE1X, z], refBraX[EE2X, z]]];\n   ket = Flatten[KroneckerProduct[refKetX[EE1X, z], refKetX[EE2X, z]]];\n   recs = Flatten[Table[\n      Module[{idx = Flatten@Position[wtX, wt], K, vals, vecs, Linv},\n       K = Sum[rhoX[a, k] tco[a, k][[idx, idx]], {a, 2}, {k, 0, 2 a}];\n       {vals, vecs} = Eigensystem[K];\n       vecs = Table[vv/vv[[First@Ordering[-Abs[vv], 1]]], {vv, vecs}];\n       Linv = Inverse[Transpose[vecs]];\n       Table[Module[{vv = vecs[[r]], p, t1, t2, full, left, m, qs, qds},\n         p = First@Ordering[-Abs[vv], 1];\n         t1 = Expand@Sum[(tco[1, k][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 2}];\n         t2 = Expand@Sum[(tco[2, k][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 4}];\n         full = ReplacePart[ConstantArray[SetPrecision[0, precX], dcX], Thread[idx -> vv]];\n         left = ReplacePart[ConstantArray[SetPrecision[0, precX], dcX], Thread[idx -> Linv[[r]]]];\n         m = multipletOfX[t1, t2];\n         qs = Table[solveMonicX[BaxDirX[t1, t2, z[[i]]], degTotX - wt[[i]]], {i, 3}];\n         qds = Table[solveMonicX[BaxDualX[t1, t2, 1/z[[j]]], wt[[j]]], {j, 3}];\n         <|\"mu\" -> wt, \"vec\" -> full, \"left\" -> left, \"T1\" -> t1, \"T2\" -> t2,\n          \"mult\" -> m, \"hwLimit\" -> (untwX[[m, \"mu\"]] == wt),\n          \"eigRes\" -> Max[Flatten@Table[Abs[tco[a, k][[idx, idx]].vv - Coefficient[{t1, t2}[[a]], u, k] vv],\n              {a, 2}, {k, 0, 2 a}]],\n          \"q\" -> qs[[All, 1]], \"qd\" -> qds[[All, 1]], \"bRes\" -> Max[Join[qs[[All, 2]], qds[[All, 2]]]],\n          \"braR\" -> bra.full, \"Lket\" -> left.ket|>],\n        {r, Length[vecs]}]],\n      {wt, sectorsX}], 1];\n   <|\"eps\" -> eps, \"phi\" -> phi, \"z\" -> z, \"recs\" -> recs, \"bra\" -> bra, \"ket\" -> ket|>];\n\nWith[{t = AbsoluteTiming[twX[1/1000]]},\n Grid[{\n   {\"eps, phi\", Row[{1/1000, \"  \", Row[phiX, \",\"]}]},\n   {\"build time (s)\", Round[t[[1]], 0.1]},\n   {\"number of states\", Length[t[[2]][\"recs\"]]},\n   {\"max eigen residual\", N[Max[t[[2]][\"recs\"][[All, \"eigRes\"]]], 3]},\n   {\"max Baxter residual (deg 5-mu_i, mu_j)\", N[Max[t[[2]][\"recs\"][[All, \"bRes\"]]], 3]},\n   {\"states per multiplet (expected 42,24,15,15,15,6,3)\", Row[Table[Count[t[[2]][\"recs\"][[All, \"mult\"]], m], {m, 7}], \",\"]},\n   {\"hw-limit states per multiplet\", Row[Table[Count[t[[2]][\"recs\"], _?(#[\"hwLimit\"] && #[\"mult\"] == m &)], {m, 7}], \",\"]}\n   }, Frame -> All, Alignment -> Left]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"51\" data-out-n=\"526\" data-sub-idx=\"15\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"3\" data-sub-start=\"63\" data-sub-end=\"72\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[526]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:8.4451em;vertical-align:-3.9526em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4926em;\"><span style=\"top:-6.4526em;\"><span class=\"pstrut\" style=\"height:6.4526em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:8.4051em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.9526em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4526em;\"><span style=\"top:-6.6074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">eps, phi</span></span></span></span><span style=\"top:-5.4074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">build time (s)</span></span></span></span><span style=\"top:-4.2074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">number of states</span></span></span></span><span style=\"top:-3.0074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max eigen residual</span></span></span></span><span style=\"top:-1.8074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max Baxter residual (deg 5-mu_i, mu_j)</span></span></span></span><span style=\"top:-0.6074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">states per multiplet (expected 42,24,15,15,15,6,3)</span></span></span></span><span style=\"top:0.5926em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">hw-limit states per multiplet</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.9526em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:8.4051em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.9526em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4526em;\"><span style=\"top:-6.6074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">1000</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=