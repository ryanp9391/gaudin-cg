-r\"><span class=\"vlist\" style=\"height:2.15em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:4.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.65em;\"><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">120 states: rel. spread of 1/C_vac</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2.19</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">5.67</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">160</span></span></span></span></span></span></span></span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">507</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.15em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:4.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.15em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.15em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[542]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{measure} & \\text{site-1 offsets} & \\text{site-2 offsets} & \\text{max|cross det|/min|diag det| (weight }2,2,3\\text{, }12\\text{ states)} & \\text{120 states: rel. spread of 1/C\\_vac}\\\\\\hline\\text{nu} & 0,1,3 & 0,1,2 & 5.86\\times 10^{34} & 2.19\\\\\\hline\\text{siteLadder} & 0,1,2,3 & 0,1,2 & 2.11\\times 10^{-131} & 5.67\\times 10^{-160}\\\\\\hline\\text{fullLadder} & 0,1,2,3 & 0,1,2,3 & 4.37\\times 10^{-135} & 507\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "c706ee91-f17e-44a6-aaaa-d40c82350226"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 5. The constant c: twisted w-identity, then the zero-twist relation b1 + b2 - dc1 = kappa a1 gives c = kappa - 1. ---- *)\nClearAll[splitT2X, wVecX, wCheckX, zeroTwistX, kappaSetX, cHX];\n\n(* Delta T2 = prod_s(u-th_s-lambda1^(s)-1)(a1 u + b1) + prod_s(u-th_s-lambda3^(s))(a2 u + b2), per-site weights. *)\nsplitT2X[A_, B_] := Module[{a1, b1, a2, b2, x, dT2},\n   dT2 = Expand[B[\"T2\"] - A[\"T2\"]] /. u -> x;\n   {a1, b1, a2, b2} /. First@Solve[Thread[CoefficientList[dT2 - ((x - thetaX[[1]] - rep1X[[1]] - 1) (x - thetaX[[2]] - rep2X[[1]] - 1) (a1 x + b1)\n          + (x - thetaX[[1]] - rep1X[[3]]) (x - thetaX[[2]] - rep2X[[3]]) (a2 x + b2)), x] == 0], {a1, b1, a2, b2}]];\n(* w in the c-basis: c1 dc1, c2 b1, c3 (a2+b2), c4 ds1, c5 a1, c6 a2. *)\nwVecX[A_, B_] := With[{sp = splitT2X[A, B], dT1 = Expand[B[\"T1\"] - A[\"T1\"]]},\n   {Coefficient[dT1, u, 0], sp[[2]], sp[[3]] + sp[[4]], Coefficient[dT1, u, 1], sp[[1]], sp[[3]]}];\n\n(* Twisted cross pairs in the largest sector (first 5 states), all 18 rows. *)\nwCheckX = Module[{z = twX[1/1000][\"z\"], S = sampleX[[1 ;; 5]], vals},\n   vals = Flatten@Table[If[a == b, Nothing, With[{w = wVecX[S[[a]], S[[b]]]},\n        Table[With[{rw = rowX[S[[a]], S[[b]], z, {al, {i, j}}]}, With[{den = Total[Abs[rw] Abs[w]]},\n           If[den < 10^-150, Nothing, Abs[rw.w]/den]]], {al, 2}, {i, 3}, {j, 3}]]], {a, 5}, {b, 5}];\n   {Length[vals], Max[vals]}];\n\n(* Zero twist, all 42 untwisted pairs A != B: {ds1, ds2, a1 + a2} and {a1, b1 + b2 - dc1}. *)\nzeroTwistX = Flatten[Table[If[a == b, Nothing,\n     With[{A = untwX[[a]], B = untwX[[b]]}, With[{sp = splitT2X[A, B], dT1 = Expand[B[\"T1\"] - A[\"T1\"]], dT2 = Expand[B[\"T2\"] - A[\"T2\"]]},\n       {RootReduce /@ {Coefficient[dT1, u, 1], Coefficient[dT2, u, 3], sp[[1]] + sp[[3]]},\n        RootReduce /@ {sp[[1]], sp[[2]] + sp[[4]] - Coefficient[dT1, u, 0]}}]]], {a, 7}, {b, 7}], 1];\n(* kappa from pairs with a1 != 0; pairs with a1 = 0 must have b1 + b2 - dc1 = 0 too. *)\nkappaSetX = Union[RootReduce[#[[2]]/#[[1]]] & /@ Select[zeroTwistX[[All, 2]], #[[1]] =!= 0 &]];\ncHX = If[Length[kappaSetX] == 1, kappaSetX[[1]] - 1, $Failed];\n\nGrid[{{\"twisted w-identity: # nonvanishing cross rows\", wCheckX[[1]]},\n   {\"max |row.w|/sum|row_c w_c|\", N[wCheckX[[2]], 3]},\n   {\"zero twist, 42 pairs: ds1 = ds2 = a1+a2 = 0\", Union[Flatten[zeroTwistX[[All, 1]]]] === {0}},\n   {\"pairs with a1 != 0 / with a1 = 0\", Row[{Count[zeroTwistX[[All, 2, 1]], Except[0]], \" / \", Count[zeroTwistX[[All, 2, 1]], 0]}]},\n   {\"a1 = 0 pairs: b1+b2-dc1 = 0\", Union[Select[zeroTwistX[[All, 2]], #[[1]] === 0 &][[All, 2]]] === {0}},\n   {\"kappa = (b1+b2-dc1)/a1 (a1 != 0 pairs)\", Row[kappaSetX, \",\"]},\n   {\"c = kappa - 1\", cHX},\n   {\"number of measure poles - 1\", Length[polesX] - 1}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
