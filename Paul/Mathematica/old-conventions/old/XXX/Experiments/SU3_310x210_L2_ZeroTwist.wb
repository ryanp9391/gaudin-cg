      {
       "data": "Out[526]= \\begin{array}{|c|c|}\\hline\\text{eps, phi} & \\frac{1}{1000}\\text{  }1,\\frac{1}{3},-\\frac{4}{3}\\\\\\hline\\text{build time (s)} & 0.9\\\\\\hline\\text{number of states} & 120\\\\\\hline\\text{max eigen residual} & 0.\\times 10^{-192}\\\\\\hline\\text{max Baxter residual (deg 5-mu\\_i, mu\\_j)} & 3.3\\times 10^{-178}\\\\\\hline\\text{states per multiplet (expected 42,24,15,15,15,6,3)} & 42,24,15,15,15,6,3\\\\\\hline\\text{hw-limit states per multiplet} & 1,1,1,1,1,1,1\\\\\\hline\\end{array}",
