  {
   "kind": 2,
   "value": "(* the same 4-dim oscillator algebra *)\nbasW = {yOf[UnitVector[8, 8]], yOf[UnitVector[8, 7]], yOf[UnitVector[8, 5]], yOf[UnitVector[8, 3]]};\ncomms = Flatten[Table[basW[[p]] . basW[[q]] - basW[[q]] . basW[[p]], {p, 4}, {q, 4}], 1];\nbr[A_, B_] := A . B - B . A;\nhgr = 2 el[3, 3] - el[1, 1] - el[2, 2];\nGrid[{\n  {\"slot 8\", MatrixForm[basW[[1]]], \"E13/3  =  a\"},\n  {\"slot 7\", MatrixForm[basW[[2]]], \"E12/2  =  c\"},\n  {\"slot 5\", MatrixForm[basW[[3]]], \"H/6    =  N\"},\n  {\"slot 3\", MatrixForm[basW[[4]]], \"E32    =  a+\"},\n  {\"dim span\", MatrixRank[Flatten /@ basW], \"\"},\n  {\"dim span + all 16 commutators\", MatrixRank[Flatten /@ Join[basW, comms]], \"CLOSED\"},\n  {\"[a, a+] == c\", br[el[1, 3], el[3, 2]] === el[1, 2], \"Heisenberg\"},\n  {\"[H, a], [H, a+], [H, c]\",\n   {br[hgr, el[1, 3]] === -3 el[1, 3], br[hgr, el[3, 2]] === 3 el[3, 2], br[hgr, el[1, 2]] === 0 el[1, 2]},\n   \"grading -3, +3, 0\"}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
