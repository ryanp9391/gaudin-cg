   "metadata": {}
  },
  {
   "kind": 2,
   "value": "Λ[1] = {2, 1, 0};\nΛ[2] = {1, 0, 0};\nν[n_][u_] := (u - θ[1] - h Λ[1][[n]]) (u - θ[2] - h Λ[2][[n]]);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[ℒ, T, TG];\nEe[α_][i_, j_] := Ee[α][i, j] = JJ[i, j, Λ[α]];\nℒ[α_][i_, j_][u_] := ℒ[α][i, j][u] = u IdentityMatrix[dim[Λ[α]]] KroneckerDelta[i, j] - h Ee[α][j, i];\nG = {{z[1] + z[2] + z[3], -z[1] z[2] - z[1] z[3] - z[2] z[3], z[1] z[2] z[3]}, {1, 0, 0}, {0, 1, 0}};\nT[{i_, j_}][u_] := T[i, j][u] = Sum[KroneckerProduct[ℒ[1][i, k][u - θ[1]], ℒ[2][k, j][u - θ[2]]], {k, 3}];\nTG[{i_, j_}][u_] := TG[i, j][u] = 1/ν[1][u] Sum[KroneckerProduct[ℒ[1][i, k][u - θ[1]], ℒ[2][k, l][u - θ[2]] G[[l, j]]], {l, 3}, {k, 3}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "EE[i_, j_] := KroneckerProduct[Ee[1][i, j], IdentityMatrix[dim[Λ[2]]]] + KroneckerProduct[IdentityMatrix[dim[Λ[1]]], Ee[2][i, j]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* transfer matrices *)\nClearAll[QM, tG, QMG];\nQM[Ii_, Jj_][u_] := QM[Ii, Jj][u] = Sum[Signature[Permutations[Ii][[σ]]] (Dot @@ (T[#][u + h - h Position[Transpose[{Permutations[Ii][[σ]], Jj}], #] // Flatten // Last] & /@ Transpose[{Permutations[Ii][[σ]], Jj}])), {σ, 1, Length[Permutations[Ii]]}];\nQMG[Ii_, Jj_][u_] := QMG[Ii, Jj][u] = Sum[Signature[Permutations[Ii][[σ]]] (Dot @@ (TG[#][u + h - h Position[Transpose[{Permutations[Ii][[σ]], Jj}], #] // Flatten // Last] & /@ Transpose[{Permutations[Ii][[σ]], Jj}])), {σ, 1, Length[Permutations[Ii]]}];\ntG[a_][u_] := tG[a][u] = Sum[QMG[Ii, Ii][u], {Ii, Subsets[Range[3], {a}]}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[t];\nt[{0, 0}][u_] := t[{0, 0}][u] = Simplify[IdentityMatrix[8 3]];\nt[{1, 0}][u_] := t[{1, 0}][u] = Simplify[tG[1][u]];\nt[{1, 1}][u_] := t[{1, 1}][u] = Simplify[tG[2][u]];\nt[{2, 0}][u_] := t[{2, 0}][u] = Simplify[tG[1][u] . tG[1][u + h] - tG[2][u + h]];\nt[{2, 1}][u_] := t[{2, 1}][u] = Simplify[tG[2][u] . tG[1][u + h] - tG[3][u + h]];\nt[{2, 2}][u_] := t[{2, 2}][u] = Simplify[tG[2][u] . tG[2][u + h] - tG[3][u + h] . tG[1][u]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "vac = {Table[KroneckerDelta[8 3, ii], {ii, dim[Λ[1]] dim[Λ[2]]}]};\nvec[v_] = {Table[v[i], {i, 3 8}]};\nvaceigen = Sum[z[k] ν[k][u], {k, 3}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ΩL[z_] := vec[v] /. {v[1] -> 1/(6 z[2]^2 z[3]^4), v[2] -> -((z[2] + z[3])/(6 z[2]^2 z[3]^4)), v[3] -> 1/(3 z[2] z[3]^3), v[4] -> -(1/(6 z[2]^2 z[3]^3)), v[5] -> (z[2] + z[3])/(6 z[2]^2 z[3]^3), v[6] -> -(1/(3 z[2] z[3]^2)), v[7] -> -((z[2] + z[3])/(6 z[2]^2 z[3]^4)), v[8] -> (z[2] + z[3])^2/(6 z[2]^2 z[3]^4), v[9] -> -((z[2] + z[3])/(3 z[2] z[3]^3)), v[10] -> (z[2] + 2 z[3])/(6 z[2]^2 z[3]^3), v[11] -> -((z[2]^2 + 3 z[2] z[3] + 2 z[3]^2)/(6 z[2]^2 z[3]^3)), v[12] -> (z[2] + 2 z[3])/(3 z[2] z[3]^2), v[13] -> 1/(2 z[2] z[3]^3), v[14] -> -((z[2] + z[3])/(2 z[2] z[3]^3)), v[15] -> 1/z[3]^2, v[16] -> -(1/(2 z[2] z[3]^2)), v[17] -> (z[2] + z[3])/(2 z[2] z[3]^2), v[18] -> -(1/z[3]), v[19] -> -((z[2] + z[3])/(3 z[2]^2 z[3]^2)), v[20] -> (z[2] + z[3])^2/(3 z[2]^2 z[3]^2), v[21] -> -((2 (z[2] + z[3]))/(3 z[2] z[3])), v[22] -> 1/(2 z[2] z[3]), v[23] -> -((z[2] + z[3])/(2 z[2] z[3])), v[24] -> 1};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* check: ΩL is the left vacuum eigenvector *)\nSimplify[Expand[ΩL[z] . t[{1, 0}][u] ν[1][u] - ΩL[z] vaceigen]]",
   "languageId": "wolfram",
   "outputs": [
