      {
       "data": "Out[143]= \\begin{array}{|c|c|}\\hline\\text{Y(aa,bb,cc)} & \\begin{pmatrix}-\\frac{\\mathrm{bb}}{6} & \\frac{\\mathrm{aa}}{2} & \\frac{1}{3}\\\\0 & -\\frac{\\mathrm{bb}}{6} & 0\\\\0 & \\mathrm{cc} & \\frac{\\mathrm{bb}}{3}\\end{pmatrix}\\\\\\hline\\text{Det Y} & \\frac{\\mathrm{bb}^3}{108}\\\\\\hline\\text{char poly} & \\frac{1}{108}\\,\\left(\\mathrm{bb}-3\\,\\mathrm{tt}\\right)\\,\\left(\\mathrm{bb}+6\\,\\mathrm{tt}\\right)^2\\\\\\hline\\end{array}",
