      {
       "data": "{\n\t\"name\": \"WolframKernelMessage\",\n\t\"message\": \"ClearAll::wrsym: Symbol ClearGlobals is Protected.\\nClearAll::wrsym: Symbol VsCodeCleanupImgDir is Protected.\\nClearAll::wrsym: Symbol VsCodeDynExportValue is Protected.\\nGeneral::stop: Further output of ClearAll::wrsym will be suppressed during this calculation.\",\n\t\"stack\": \"\"\n}",
