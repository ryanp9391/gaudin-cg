  {
   "kind": 2,
   "value": "B[u_] = Simplify[T[{1, 1}][u] . QM[{1, 2}, {1, 2}][u + h] + T[{2, 1}][u] . QM[{1, 2}, {1, 3}][u + h]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "gtpats[1] = {{{1}, {0, 0}}, {{1}, {1, 0}}, {{1}, {1, 1}}, {{2}, {0, 0}}, {{2}, {1, 0}}, {{2}, {1, 1}}, {{2}, {2, 0}}, {{2}, {2, 1}}};\ngtpats[2] = {{{0}, {0}}, {{1}, {0}}, {{1}, {1}}};\nb[{{a_}, {bb_, c_}}, {{r_}, {s_}}][u_] = (u - θ[1] - h a) (u - θ[1] - h bb) (u - θ[1] - h c + h) (u - θ[2] - h r) (u - θ[2] - h s) (u - θ[2] + h);\nbeigenvalues = Sort[Flatten[Table[b[gt1, gt2][u], {gt1, gtpats[1]}, {gt2, gtpats[2]}]]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[xst];\nxst[μ1_, μ2_] := xst[μ1, μ2] = nm[μ1, μ2] (vec[v] /. Last[Quiet[Solve[Union[Flatten[CoefficientList[vec[v] . B[u] - b[μ1, μ2][u] vec[v], u]]] == 0, Flatten[vec[v]]]]] /. v[a_] :> 1);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[site1pats];\nsite1pats[2] = {{0, 0}, {1, 0}, {2, 0}, {1, 1}, {2, 1}};\nsite1pats[1] = {{0, 0}, {1, 0}, {1, 1}};\nsite2pats = {{{0}, {0}}, {{1}, {0}}, {{1}, {1}}};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "nm[{{1}, {0, 0}}, {{0}, {0}}] = 1;\nnm[{{2}, {0, 0}}, {{0}, {0}}] = 2/3;\nnmssolns = {nm[{{1}, {0, 0}}, {{1}, {0}}] -> (2 h)/(6 h + 3 θ[1] - 3 θ[2]), nm[{{1}, {0, 0}}, {{1}, {1}}] -> (h (h + θ[1] - θ[2]))/(2 (2 h + θ[1] - θ[2])^2), nm[{{1}, {1, 0}}, {{0}, {0}}] -> h/(4 (h - θ[1] + θ[2])), nm[{{1}, {1, 0}}, {{1}, {0}}] -> (h + θ[1] - θ[2])/(8 h + 4 θ[1] - 4 θ[2]), nm[{{1}, {1, 0}}, {{1}, {1}}] -> (h + θ[1] - θ[2])^2/(4 (2 h + θ[1] - θ[2])^2), nm[{{1}, {1, 1}}, {{0}, {0}}] -> (-θ[1] + θ[2])/(3 (h - θ[1] + θ[2])), nm[{{1}, {1, 1}}, {{1}, {0}}] -> (h (-θ[1] + θ[2]))/(6 (2 h + θ[1] - θ[2]) (h - θ[1] + θ[2])), nm[{{1}, {1, 1}}, {{1}, {1}}] -> -((h (θ[1] - θ[2]) (h + θ[1] - θ[2]))/(6 (2 h + θ[1] - θ[2])^2 (h - θ[1] + θ[2]))), nm[{{2}, {0, 0}}, {{1}, {0}}] -> 1/3, nm[{{2}, {0, 0}}, {{1}, {1}}] -> h/(6 h + 3 θ[1] - 3 θ[2]), nm[{{2}, {1, 0}}, {{0}, {0}}] -> h/(3 (h - θ[1] + θ[2])), nm[{{2}, {1, 0}}, {{1}, {0}}] -> -(h/(6 (h - θ[1] + θ[2]))), nm[{{2}, {1, 0}}, {{1}, {1}}] -> h/(12 h + 6 θ[1] - 6 θ[2]), nm[{{2}, {1, 1}}, {{0}, {0}}] -> (-θ[1] + θ[2])/(6 (h - θ[1] + θ[2])), nm[{{2}, {1, 1}}, {{1}, {0}}] -> (-θ[1] + θ[2])/(12 (h - θ[1] + θ[2])), nm[{{2}, {1, 1}}, {{1}, {1}}] -> (h (-θ[1] + θ[2]))/(12 (2 h + θ[1] - θ[2]) (h - θ[1] + θ[2])), nm[{{2}, {2, 0}}, {{0}, {0}}] -> h/(3 (h - θ[1] + θ[2])), nm[{{2}, {2, 0}}, {{1}, {0}}] -> -(h/(3 (h - θ[1] + θ[2]))), nm[{{2}, {2, 0}}, {{1}, {1}}] -> 1/6, nm[{{2}, {2, 1}}, {{0}, {0}}] -> h/(12 (h - θ[1] + θ[2])), nm[{{2}, {2, 1}}, {{1}, {0}}] -> (θ[1] - θ[2])/(12 (-h + θ[1] - θ[2])), nm[{{2}, {2, 1}}, {{1}, {1}}] -> (θ[1] - θ[2])/(12 (-h + θ[1] - θ[2]))};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[xx];\nxx[μ1_, μ2_] := (xst[μ1, μ2] //. nmssolns);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* THE LOCALIZATION: a combination of the 8 site-2-minimal SoV covectors that factorizes\n   as <rr| (x) (0,0,1), i.e. localizes onto site 1. *)\nlocComb = Sum[c[μ1, {{0}, {0}}] xx[μ1, {{0}, {0}}], {μ1, gtpats[1]}];\nlocEq = locComb - KroneckerProduct[{Table[rr[i], {i, 8}]}, {{0, 0, 1}}];\nlocSol = Solve[locEq == 0];\nrrVec = First[{Table[rr[i], {i, 8}]} /. Last[locSol]]",
   "languageId": "wolfram",
   "outputs": [
