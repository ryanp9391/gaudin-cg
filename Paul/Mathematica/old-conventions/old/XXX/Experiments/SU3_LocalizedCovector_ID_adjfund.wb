     "id": "d1d7d9a9-1149-408e-a6b6-fd054f8b1649"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* same dictionary as in the adj (x) adj notebook: site-1 rep is adjoint (x) det *)\nwts = Transpose[Table[Diagonal[Ee[1][i, i]], {i, 3}]];\nClearAll[el, cvar, mm0, vars, eqsInt, amat, ns, mAd];\nel[p_, q_] := el[p, q] = Normal @ SparseArray[{{p, q} -> 1}, {3, 3}];\nmm0 = Table[cvar[k, p, q], {k, 8}, {p, 3}, {q, 3}];\nvars = Flatten[mm0];\neqsInt = Flatten[Table[\n    el[i, j] . mm0[[k]] - mm0[[k]] . el[i, j] + KroneckerDelta[i, j] mm0[[k]]\n     - Sum[Ee[1][i, j][[l, k]] mm0[[l]], {l, 8}],\n    {i, 3}, {j, 3}, {k, 8}]];\namat = Normal[Last[CoefficientArrays[eqsInt, vars]]];\nns = NullSpace[amat];\nmAd = mm0 /. Thread[vars -> First[ns]];\nmAd = mAd/mAd[[1, 1, 3]];\nkForm = Table[Tr[mAd[[k]] . mAd[[l]]], {k, 8}, {l, 8}];\nyOf[w_] := Simplify[Sum[LinearSolve[Transpose[kForm], w][[l]] mAd[[l]], {l, 8}]];\nyMat = yOf[{0, 0, cc, 0, bb, 0, aa, 1}];\nGrid[{{\"Y(aa,bb,cc)\", MatrixForm[yMat]},\n      {\"Det Y\", Factor[Det[yMat]]},\n      {\"char poly\", Factor[CharacteristicPolynomial[yMat, tt]]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
