       "data": "Out[28]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{mu} & \\text{Mhat} & \\text{\\#sol} & \\text{tc at eps=0} & \\text{P\\_1..P\\_4 (ascending coeffs)} & \\text{residual == 0}\\\\\\hline\\left\\{2,2,0,0\\right\\} & \\left\\{0,1,4,5\\right\\} & 1 & \\left\\{\\frac{22}{7},\\frac{7214}{147},-\\frac{4472}{147},\\frac{3812}{441},\\frac{274}{21}\\right\\} & \\begin{matrix}\\left\\{1\\right\\}\\\\\\left\\{0,1\\right\\}\\\\\\left\\{0,0,-\\frac{5}{7},-\\frac{20}{21},1\\right\\}\\\\\\left\\{0,0,\\frac{100}{441},-\\frac{2995}{1323},0,1\\right\\}\\end{matrix} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\left\\{2,1,1,0\\right\\} & \\left\\{0,2,3,5\\right\\} & 1 & \\left\\{\\frac{8}{7},\\frac{6626}{147},-\\frac{3016}{147},-\\frac{640}{441},\\frac{232}{21}\\right\\} & \\begin{matrix}\\left\\{1\\right\\}\\\\\\left\\{0,-\\frac{10}{21},1\\right\\}\\\\\\left\\{0,-\\frac{8}{7},0,1\\right\\}\\\\\\left\\{0,-\\frac{176}{441},0,0,-\\frac{25}{21},1\\right\\}\\end{matrix} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\left\\{1,1,1,1\\right\\} & \\left\\{1,2,3,4\\right\\} & 1 & \\left\\{-\\frac{20}{7},\\frac{5450}{147},-\\frac{104}{147},\\frac{1040}{441},\\frac{148}{21}\\right\\} & \\begin{matrix}\\left\\{-\\frac{5}{21},1\\right\\}\\\\\\left\\{-\\frac{512}{1323},0,1\\right\\}\\\\… [latex truncated: 1383 chars total]",
