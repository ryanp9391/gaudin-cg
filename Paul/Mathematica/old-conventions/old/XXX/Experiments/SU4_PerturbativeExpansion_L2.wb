      {
       "data": "Out[57]= \\begin{matrix}\\text{direct branches Q\\_1, Q\\_2 : M = }\\left\\{0,0,2,2\\right\\}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{order n} & \\text{\\#eqs} & \\text{\\#unk} & \\text{status} & \\text{\\#free at this order}\\\\\\hline0 & 0 & 0 & \\text{ok} & 0\\\\\\hline1 & 14 & 5 & \\text{ok} & 2\\\\\\hline2 & 14 & 7 & \\text{ok} & 2\\\\\\hline3 & 14 & 7 & \\text{ok} & 2\\\\\\hline4 & 14 & 7 & \\text{ok} & 2\\\\\\hline5 & 14 & 7 & \\text{ok} & 2\\\\\\hline6 & 14 & 7 & \\text{ok} & 2\\\\\\hline7 & 14 & 7 & \\text{ok} & 2\\\\\\hline8 & 14 & 7 & \\text{ok} & 2\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{order m} & \\text{\\#tc fixed (of 5)} & \\text{remaining free}\\\\\\hline1 & 5 & \\{\\}\\\\\\hline2 & 5 & \\{\\}\\\\\\hline3 & 5 & \\{\\}\\\\\\hline4 & 5 & \\{\\}\\\\\\hline5 & 5 & \\{\\}\\\\\\hline6 & 5 & \\{\\}\\\\\\hline7 & 5 & \\{\\}\\\\\\hline8 & 0 & \\left\\{\\mathrm{tcn}\\left(1,8\\right),\\mathrm{tcn}\\left(2,8\\right)\\right\\}\\\\\\hline\\end{array}\\\\\\text{matches exact tau, orders 1-7: }\\mathrm{True}\\\\\\text{dual branches Q\\^{}4, Q\\^{}3 : deg q\\^{}j = mu\\_j = }\\left\\{0,0\\right\\}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{order n} & \\text{\\#eqs} & \\text{\\#unk} & \\text{status} & \\text{\\#free at this order}\\\\\\hline0 & 0 & 0 & \\text{ok} & 0\\\\\\hline1 & 14 & 5 & \\text{ok} & 2\\\\\\hline2 &… [latex truncated: 1853 chars total]",
