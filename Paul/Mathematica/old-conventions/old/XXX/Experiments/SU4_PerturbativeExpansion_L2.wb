      {
       "data": "Out[39]= \\begin{matrix}\\text{mu = \\{2,2,0,0\\}, M = }\\left\\{0,0,2,2\\right\\}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{order n} & \\text{\\#eqs} & \\text{\\#unk} & \\text{status} & \\text{\\#free}\\\\\\hline0 & 0 & 0 & \\text{ok} & 0\\\\\\hline1 & 14 & 5 & \\text{ok} & 2\\\\\\hline2 & 14 & 7 & \\text{ok} & 2\\\\\\hline3 & 14 & 7 & \\text{ok} & 2\\\\\\hline4 & 14 & 7 & \\text{ok} & 2\\\\\\hline5 & 14 & 7 & \\text{ok} & 2\\\\\\hline6 & 14 & 7 & \\text{ok} & 2\\\\\\hline7 & 14 & 7 & \\text{ok} & 2\\\\\\hline8 & 14 & 7 & \\text{ok} & 2\\\\\\hline\\end{array}\\end{matrix}",
