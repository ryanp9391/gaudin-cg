  {
   "kind": 2,
   "value": "(* Bax[n][f] : Baxter operator applied to f, to order n in the twist; an expression in the global u holding f[u+h], f[u], f[u-h], f[u-2h], f[u-3h]. *)\nClearAll[SetState, Bax, tcSer, zSub, SS, PP, MU, TC0, u];\nSetState[S_, P_, μ_] := (SS = S; PP = P; MU = μ; TC0 = UntwSolve[S, P, μ][\"tc0\"]; {\"state\" -> {S, P, μ}, \"tc0\" -> TC0});\nzSub[n_] := Table[z[j] -> Normal[Series[Exp[I eps psi[[j]]], {eps, 0, n}]], {j, 4}];\ntcSer[n_] := Table[tc[i] -> TC0[[i]] + Sum[eps^m tcn[i, m], {m, n}], {i, 5}];\nBax[n_][f_] := Normal[Series[Expand[(((Product[ν1[SS, PP][u - m h], {m, 0, 3}] f[u + h] - τ[1][SS, PP, MU][u] Product[ν1[SS, PP][u - m h], {m, 1, 3}] f[u] + τ[2][SS, PP, MU][u] Product[ν1[SS, PP][u - m h], {m, 2, 3}] f[u - h] - τ[3][SS, PP, MU][u] ν1[SS, PP][u - 3 h] f[u - 2 h] + τ[4][SS, PP, MU][u] f[u - 3 h]) /. prm) /. zSub[n + 4]) /. tcSer[n]], {eps, 0, n}]];\nSetState[1, 1, {2, 2, 0, 0}];\n{\"shifts in Bax[0][f]\" -> Union[Cases[Bax[0][f], f[a_] :> a, Infinity]], \"Bax[0] kills every untwisted P_k\" -> Table[Simplify[Bax[0][Function[y, qpoly[UntwSolve[1, 1, {2, 2, 0, 0}][\"P\"][[k]], y]]]] === 0, {k, 4}]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"251778\" data-output-id=\"33\" data-out-n=\"35\" data-sub-idx=\"7\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"4\" data-sub-start=\"7\" data-sub-end=\"7\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[35]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"29\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:3.01em;vertical-align:-1.255em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.755em;\"><span style=\"top:-3.765em;\"><span class=\"pstrut\" style=\"height:2.85em;\"></span><span class=\"mord\"></span></span><span style=\"top:-2.255em;\"><span class=\"pstrut\" style=\"height:2.85em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.255em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.755em;\"><span style=\"top:-3.915em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord text\"><span class=\"mord\">shifts in Bax[0][f]</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-righ