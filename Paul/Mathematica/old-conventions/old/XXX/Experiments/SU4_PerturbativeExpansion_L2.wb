  {
   "kind": 2,
   "value": "(* A state where the branch polynomials are not trivial: mu = {2,1,1,0} gives M = {0,1,1,2}, so q_2 is monic of degree 1 with coefficients diverging as 1/eps, and on the dual side deg q^3 = mu_3 = 1. Direct and dual reports come out identical. *)\nSetState[1, 1, {2, 1, 1, 0}];\nrv2 = pushQ12[1, 1, {2, 1, 1, 0}, 6];\nrd2 = pushQ34[1, 1, {2, 1, 1, 0}, 6];\nColumn[{Row[{\"M = \", rv2[\"M\"], \"   dual degs (j=4,3) = \", rd2[\"deg\"]}], Grid[Prepend[rv2[\"report\"], {\"direct: order n\", \"#eqs\", \"#unk\", \"status\", \"#free\"}], Frame -> All], Grid[Prepend[rd2[\"report\"], {\"dual: order n\", \"#eqs\", \"#unk\", \"status\", \"#free\"}], Frame -> All], Row[{\"direct #tc fixed per order: \", Table[Count[Table[tcn[i, m] /. rv2[\"sol\"], {i, 5}], _?(FreeQ[#, _tcn] &)], {m, 6}]}], Row[{\"dual   #tc fixed per order: \", Table[Count[Table[tcn[i, m] /. rd2[\"sol\"], {i, 5}], _?(FreeQ[#, _tcn] &)], {m, 6}]}]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
