       "data": "Out[232]= \\begin{array}{|c|c|}\\hline\\text{ground site-2 pattern (m12; m11, m22)} & \\left\\{2,0,0\\right\\}\\\\\\hline\\text{root n-triple} & \\left\\{2,0,-1\\right\\}\\\\\\hline\\text{distinct? (method valid without extra projection)} & \\mathrm{True}\\\\\\hline\\text{dim W1 (site-1-only excitations)} & 15\\\\\\hline\\text{annihilated by B at all ground points} & \\mathrm{True}\\\\\\hline\\text{contains <0|} & \\mathrm{True}\\\\\\hline\\end{array}",
