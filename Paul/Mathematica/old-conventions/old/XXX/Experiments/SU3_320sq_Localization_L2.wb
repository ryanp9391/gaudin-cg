      {
       "data": "Out[238]= \\begin{array}{|c|c|}\\hline\\text{restriction exact} & \\mathrm{True}\\\\\\hline\\text{restricted B(u) commute} & \\mathrm{True}\\\\\\hline\\text{distinct eigenvalues, single B(7/3)} & 13\\\\\\hline\\text{distinct eigenvalues, generic combination} & 15\\\\\\hline\\text{15 independent covectors} & \\mathrm{True}\\\\\\hline\\text{each a left eigenvector of B(u) at 3 FRESH u} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
