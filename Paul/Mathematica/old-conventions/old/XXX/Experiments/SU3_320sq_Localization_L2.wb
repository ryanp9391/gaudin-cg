  {
   "kind": 2,
   "value": "(* verdict *)\nlocLabels = Select[summary, #[[5]] &][[All, 1 ;; 3]];\nlocSlots = Sort[Flatten[Position[Table[{m12[k], m11[k], m22[k]}, {k, d1}], #, 1, 1] & /@ locLabels]];\nGrid[{\n  {\"# localizing\", Count[locQ, True]},\n  {\"predicted (l1-l2+1)(l2-l3+1)\", (Λ[1][[1]] - Λ[1][[2]] + 1) (Λ[1][[2]] - Λ[1][[3]] + 1)},\n  {\"localizing labels (m12; m11, m22)\", locLabels},\n  {\"rule m11 == m22 holds exactly\", And @@ Table[locQ[[i]] == (labels[[i]][[1, 1]] == labels[[i]][[2, 2]]), {i, Length[W1]}]},\n  {\"site-1 slots\", locSlots},\n  {\"predicted slots from the rule\", Select[Range[d1], m11[#] == m22[#] &]}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
