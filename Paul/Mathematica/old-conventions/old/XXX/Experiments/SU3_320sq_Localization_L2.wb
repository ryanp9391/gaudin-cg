      {
       "data": "Out[249]= \\begin{array}{|c|c|}\\hline\\text{\\# localizing} & 6\\\\\\hline\\text{predicted (l1-l2+1)(l2-l3+1)} & 6\\\\\\hline\\text{localizing labels (m12; m11, m22)} & \\begin{pmatrix}2 & 0 & 0\\\\2 & 1 & 1\\\\2 & 2 & 2\\\\3 & 0 & 0\\\\3 & 1 & 1\\\\3 & 2 & 2\\end{pmatrix}\\\\\\hline\\text{rule m11 == m22 holds exactly} & \\mathrm{True}\\\\\\hline\\text{site-1 slots} & \\left\\{4,7,10,12,14,15\\right\\}\\\\\\hline\\text{predicted slots from the rule} & \\left\\{4,7,10,12,14,15\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "243f331b-bd07-4e16-89b0-593b73fa2e13"
