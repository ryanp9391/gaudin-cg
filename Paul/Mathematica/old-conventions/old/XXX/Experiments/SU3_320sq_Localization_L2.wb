  {
   "kind": 2,
   "value": "(* ground site-2 label = the minimal GT pattern; its root n-triple must have 3 distinct entries *)\ngndPat = Last[ps[{Λ[2]}]];\nnTrip = {gndPat[[2, 1]], gndPat[[1, 1]], gndPat[[2, 2]] - 1};\ngndPts = θ[2] + h # & /@ Union[nTrip];\nMstack = Join @@ Table[Transpose[Normal[Bop[uu]]], {uu, gndPts}];\nW1 = NullSpace[Mstack];\nGrid[{\n  {\"ground site-2 pattern (m12; m11, m22)\", {gndPat[[2, 1]], gndPat[[1, 1]], gndPat[[2, 2]]}},\n  {\"root n-triple\", nTrip},\n  {\"distinct? (method valid without extra projection)\", Length[Union[nTrip]] == 3},\n  {\"dim W1 (site-1-only excitations)\", Length[W1]},\n  {\"annihilated by B at all ground points\", Max[Table[Max[Abs[Flatten[W1 . Normal[Bop[uu]]]]], {uu, gndPts}]] == 0},\n  {\"contains <0|\", MatrixRank[Join[W1, {vacRef}]] == Length[W1]}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
