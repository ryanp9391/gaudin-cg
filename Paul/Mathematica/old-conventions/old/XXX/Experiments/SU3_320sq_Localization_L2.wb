       "data": "Out[226]= \\begin{array}{|c|c|}\\hline\\text{dim, chain dim} & \\left\\{15,225\\right\\}\\\\\\hline\\text{gl(3) relations site 1} & \\mathrm{True}\\\\\\hline\\text{<0| = e\\_dtot is a left eigenvector of B} & \\mathrm{True}\\\\\\hline\\text{nullity of B($\\theta$2+hn) vs prediction} & \\begin{array}{|c|c|c|}\\hline\\text{n} & \\text{measured} & \\text{predicted}\\\\\\hline-2 & 0 & 0\\\\\\hline-1 & 105 & 105\\\\\\hline0 & 105 & 105\\\\\\hline1 & 105 & 105\\\\\\hline2 & 135 & 135\\\\\\hline3 & 135 & 135\\\\\\hline4 & 0 & 0\\\\\\hline\\end{array}\\\\\\hline\\end{array}",
