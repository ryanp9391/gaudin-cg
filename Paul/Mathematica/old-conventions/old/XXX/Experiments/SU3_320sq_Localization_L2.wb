  },
  {
   "kind": 2,
   "value": "Λ[1] = {3, 2, 0};\nΛ[2] = {3, 2, 0};\nh = 1; θ[1] = 0; θ[2] = 1/2;\nd1 = dim[Λ[1]]; d2 = dim[Λ[2]]; dtot = d1 d2;\npats = ps[{Λ[1]}];\nm11[k_] := pats[[k, 1, 1]]; m12[k_] := pats[[k, 2, 1]]; m22[k_] := pats[[k, 2, 2]];\nEe[α_][i_, j_] := Ee[α][i, j] = JJ[i, j, Λ[α]];\nℒ[α_][i_, j_][u_] := u IdentityMatrix[dim[Λ[α]]] KroneckerDelta[i, j] - h Ee[α][j, i];\nT[{i_, j_}][u_] := T[i, j][u] = SparseArray @ Sum[KroneckerProduct[ℒ[1][i, k][u - θ[1]], ℒ[2][k, j][u - θ[2]]], {k, 3}];\nglOK = And @@ Flatten @ Table[\n    Ee[1][i, j] . Ee[1][k, l] - Ee[1][k, l] . Ee[1][i, j] - KroneckerDelta[j, k] Ee[1][i, l] + KroneckerDelta[i, l] Ee[1][k, j] == 0 IdentityMatrix[d1],\n    {i, 3}, {j, 3}, {k, 3}, {l, 3}];\nwts = Transpose[Table[Diagonal[Ee[1][i, i]], {i, 3}]];\nGrid[Prepend[Table[{k, m12[k], m11[k], m22[k], wts[[k]]}, {k, d1}],\n  {\"slot\", \"m12\", \"m11\", \"m22\", \"weight\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"927746\" data-output-id=\"24\" data-out-n=\"220\" data-sub-idx=\"11\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"2\" data-sub-start=\"13\" data-sub-end=\"14\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[220]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"23\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:19.24em;vertical-align:-9.35em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.89em;\"><span style=\"top:-11.85em;\"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:19.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-9.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.85em;\"><span style=\"top:-12.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">slot</span></span></span></span><span style=\"top:-10.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:-9.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span></span></span><span style=\"top:-8.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">3</span></span></span><span style=\"top:-