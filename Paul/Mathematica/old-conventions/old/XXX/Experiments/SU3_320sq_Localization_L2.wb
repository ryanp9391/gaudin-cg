       "data": "Out[220]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{slot} & \\text{m12} & \\text{m11} & \\text{m22} & \\text{weight}\\\\\\hline1 & 3 & 3 & 2 & \\left\\{3,2,0\\right\\}\\\\\\hline2 & 3 & 3 & 1 & \\left\\{3,1,1\\right\\}\\\\\\hline3 & 3 & 3 & 0 & \\left\\{3,0,2\\right\\}\\\\\\hline4 & 3 & 2 & 2 & \\left\\{2,3,0\\right\\}\\\\\\hline5 & 3 & 2 & 1 & \\left\\{2,2,1\\right\\}\\\\\\hline6 & 3 & 2 & 0 & \\left\\{2,1,2\\right\\}\\\\\\hline7 & 2 & 2 & 2 & \\left\\{2,2,1\\right\\}\\\\\\hline8 & 2 & 2 & 1 & \\left\\{2,1,2\\right\\}\\\\\\hline9 & 2 & 2 & 0 & \\left\\{2,0,3\\right\\}\\\\\\hline10 & 3 & 1 & 1 & \\left\\{1,3,1\\right\\}\\\\\\hline11 & 3 & 1 & 0 & \\left\\{1,2,2\\right\\}\\\\\\hline12 & 2 & 1 & 1 & \\left\\{1,2,2\\right\\}\\\\\\hline13 & 2 & 1 & 0 & \\left\\{1,1,3\\right\\}\\\\\\hline14 & 3 & 0 & 0 & \\left\\{0,3,2\\right\\}\\\\\\hline15 & 2 & 0 & 0 & \\left\\{0,2,3\\right\\}\\\\\\hline\\end{array}",
