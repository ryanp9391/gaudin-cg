  {
   "kind": 2,
   "value": "QM[Ii_, Jj_][u_] := QM[Ii, Jj][u] = SparseArray @ Sum[\n    Signature[Permutations[Ii][[σ]]] (Dot @@ (T[#][u + h - h Position[Transpose[{Permutations[Ii][[σ]], Jj}], #] // Flatten // Last] & /@ Transpose[{Permutations[Ii][[σ]], Jj}])),\n    {σ, 1, Length[Permutations[Ii]]}];\nBop[u_] := Bop[u] = SparseArray[T[{1, 1}][u] . QM[{1, 2}, {1, 2}][u + h] + T[{2, 1}][u] . QM[{1, 2}, {1, 3}][u + h]];\nvacRef = UnitVector[dtot, dtot];\nlns[u_] := lns[u] = NullSpace[Transpose[Normal[Bop[u]]]];\npredCount[n_] := d1 Count[ps[{Λ[2]}], p_ /; MemberQ[{p[[2, 1]], p[[1, 1]], p[[2, 2]] - 1}, n]];\nGrid[{{\"dim, chain dim\", {d1, dtot}}, {\"gl(3) relations site 1\", glOK},\n      {\"<0| = e_dtot is a left eigenvector of B\", MatrixRank[{vacRef, vacRef . Normal[Bop[7/3]]}] == 1},\n      {\"nullity of B(θ2+hn) vs prediction\",\n       Grid[Prepend[Table[{n, Length[lns[θ[2] + h n]], predCount[n]}, {n, -2, 4}], {\"n\", \"measured\", \"predicted\"}], Frame -> All]}},\n  Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
