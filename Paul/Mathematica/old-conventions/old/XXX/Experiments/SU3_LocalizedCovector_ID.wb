  {
   "kind": 2,
   "value": "(* --- 4. push the localized covector through the trace form:  Tr[Y M_k] = w_k --- *)\nkForm = Table[Tr[mAd[[k]] . mAd[[l]]], {k, 8}, {l, 8}];\nyOf[w_] := Simplify[Sum[LinearSolve[Transpose[kForm], w][[l]] mAd[[l]], {l, 8}]];\nwcov = {0, 0, cc, 0, bb, 0, aa, 1};\nyMat = yOf[wcov];\ny8 = yOf[UnitVector[8, 8]];\nGrid[{\n  {\"Y(aa,bb,cc)\", MatrixForm[yMat]},\n  {\"check Tr[Y M_k]\", Table[Tr[yMat . mAd[[k]]], {k, 8}]},\n  {\"Y_8  (the reference <e8|)\", MatrixForm[y8]},\n  {\"rank Y_8 , Y_8^2\", {MatrixRank[y8], MatrixForm[y8 . y8]}}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
