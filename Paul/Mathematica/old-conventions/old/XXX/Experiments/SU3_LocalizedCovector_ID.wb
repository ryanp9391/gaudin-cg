     "items": [
      {
       "data": "<span style=\"display:none\"></span>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "SetDelayed::write: Tag In in In[35] is Protected.\nSet::write: Tag Out in Out[36] is Protected.",
       "mime": "text/plain"
      },
      {
       "data": "{\n\t\"name\": \"WolframKernelMessage\",\n\t\"message\": \"SetDelayed::write: Tag In in In[35] is Protected.\\nSet::write: Tag Out in Out[36] is Protected.\",\n\t\"stack\": \"\"\n}",
       "mime": "application/vnd.code.notebook.error"
