       "data": "Out[44]= \\begin{array}{|c|c|c|}\\hline\\text{slot} & \\text{gl(3) weight} & \\text{sl(3) weight}\\\\\\hline1 & \\left\\{2,1,0\\right\\} & \\left\\{1,0,-1\\right\\}\\\\\\hline2 & \\left\\{2,0,1\\right\\} & \\left\\{1,-1,0\\right\\}\\\\\\hline3 & \\left\\{1,2,0\\right\\} & \\left\\{0,1,-1\\right\\}\\\\\\hline4 & \\left\\{1,1,1\\right\\} & \\left\\{0,0,0\\right\\}\\\\\\hline5 & \\left\\{1,1,1\\right\\} & \\left\\{0,0,0\\right\\}\\\\\\hline6 & \\left\\{1,0,2\\right\\} & \\left\\{0,-1,1\\right\\}\\\\\\hline7 & \\left\\{0,2,1\\right\\} & \\left\\{-1,1,0\\right\\}\\\\\\hline8 & \\left\\{0,1,2\\right\\} & \\left\\{-1,0,1\\right\\}\\\\\\hline\\end{array}",
