     "id": "72b446eb-d3dd-417f-a55f-c94a7406453c"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "vec[v_] := {Table[v[i], {i, 8^2}]};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "B[u_] = T[{1, 1}][u].QM[{1, 2}, {1, 2}][u + h] + T[{2, 1}][u].QM[{1, 2}, {1, 3}][u + h] // Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "gtpats[1] = {{{1}, {0, 0}}, {{1}, {1, 0}}, {{1}, {1, 1}}, {{2}, {0, 0}}, {{2}, {1, 0}}, {{2}, {1, 1}}, {{2}, {2, 0}}, {{2}, {2, 1}}};\ngtpats[2] = gtpats[1];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "b[{{a_}, {bb_, c_}}, {{r_}, {s_, p_}}][u_] =\n    (u - θ[1] - h a) (u - θ[1] - h bb) (u - θ[1] - h c + h) (u - θ[2] - h r) (u - θ[2] - h s) (u - θ[2] - h p + h);",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "beigenvalues = Table[b[gt1, gt2][u], {gt1, gtpats[1]}, {gt2, gtpats[2]}] // Flatten // Sort;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[xst]\nxst[μ1_, μ2_] :=\n    xst[μ1, μ2] =\n    vec[v]\n    /. ((Solve[(CoefficientList[vec[v].B[u] - b[μ1, μ2][u] vec[v], u] // Flatten // Union) == 0, vec[v] // Flatten] // Quiet // Last)) /. v[a_] ⧴ 1",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(*the following combination of SoV basis states is localizes to the \\\nfirst site of the chain*)\nxst[{{1}, {0, 0}}, {{1}, {0, 0}}]\n+ aa xst[{{2}, {0, 0}}, {{1}, {0, 0}}]\n+ bb xst[{{1}, {1, 1}}, {{1}, {0, 0}}]\n+ cc xst[{{2}, {1, 1}}, {{1}, {0, 0}}]\n- KroneckerProduct[{Table[w[i], {i, 8}]}, {{0, 0, 0, 0, 0, 0, 0, 1}}];\nSolve[% == 0] // Last;\n{Table[w[i], {i, 8}]} /. %",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"927746\" data-output-id=\"2\" data-out-n=\"42\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"13\" data-sub-start=\"8\" data-sub-end=\"8\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[42]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-latex-b64=\"XGJlZ2lue3BtYXRyaXh9MCAmIDAgJiBcbWF0aHJte2NjfSAmIDAgJiBcbWF0aHJte2JifSAmIDAgJiBcbWF0aHJte2FhfSAmIDFcZW5ke3BtYXRyaXh9\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.2em;vertical-align:-0.35em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">(</span></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">cc</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">bb</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">aa</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">)</span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[42]= \\begin{pmatrix}0 & 0 & \\mathrm{cc} & 0 & \\mathrm{bb} & 0 & \\mathrm{aa} & 1\\end{pmatrix}",
       "mime": "text/plain"
      }
     ],
     "id": "ebc4acab-b9be-4d67-8e19-6897e7e05da8"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## Identifying the localized site-1 covector\n\n`aa`, `bb`, `cc` are free, so the object is really the **4-dimensional space** of site-1 covectors\n`span{ e*_3, e*_5, e*_7, e*_8 }`.\n\nStrategy: the site-1 rep is `adjoint (x) det`, so `V ~ traceless 3x3 matrices`. Build the explicit\nintertwiner `v_k -> M_k`, push the covector through the trace form, and read off which matrix\n`Y(aa,bb,cc)` it is. Then \"is it `<e8| g`?\" becomes a question about adjoint orbits.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* --- 1. index <-> weight dictionary for the site-1 adjoint GT basis --- *)\nwts = Transpose[Table[Diagonal[Ee[1][i, i]], {i, 3}]];\nGrid[Prepend[Table[{k, wts[[k]], wts[[k]] - {1, 1, 1}}, {k, 8}],\n  {\"slot\", \"gl(3) weight\", \"sl(3) weight\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
