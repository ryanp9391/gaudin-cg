;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.9411em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.4411em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7401em;\"><span class=\"pstrut\" style=\"height:5.4411em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9501em;\"><span class=\"pstrut\" style=\"height:5.4411em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1902em;\"><span class=\"pstrut\" style=\"height:5.4411em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.5042em;\"><span class=\"pstrut\" style=\"height:5.4411em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.8821em;\"><span class=\"pstrut\" style=\"height:5.4411em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.9411em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
