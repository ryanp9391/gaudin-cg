\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:11.391em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-5.4455em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9051em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1051em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3051em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5051em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.883em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-11.2609em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.691em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-13.891em;\"><span class=\"pstrut\" style=\"height:7.9455em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5