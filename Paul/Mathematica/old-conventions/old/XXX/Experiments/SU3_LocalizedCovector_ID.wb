      {
       "data": "Out[58]= \\begin{array}{|c|c|c|}\\hline\\text{slot} & \\text{weight} & \\text{M\\_k}\\\\\\hline1 & \\left\\{2,1,0\\right\\} & \\begin{pmatrix}0 & 0 & 1\\\\0 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix}\\\\\\hline2 & \\left\\{2,0,1\\right\\} & \\begin{pmatrix}0 & -1 & 0\\\\0 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix}\\\\\\hline3 & \\left\\{1,2,0\\right\\} & \\begin{pmatrix}0 & 0 & 0\\\\0 & 0 & 1\\\\0 & 0 & 0\\end{pmatrix}\\\\\\hline4 & \\left\\{1,1,1\\right\\} & \\begin{pmatrix}1 & 0 & 0\\\\0 & -1 & 0\\\\0 & 0 & 0\\end{pmatrix}\\\\\\hline5 & \\left\\{1,1,1\\right\\} & \\begin{pmatrix}-1 & 0 & 0\\\\0 & -1 & 0\\\\0 & 0 & 2\\end{pmatrix}\\\\\\hline6 & \\left\\{1,0,2\\right\\} & \\begin{pmatrix}0 & 0 & 0\\\\0 & 0 & 0\\\\0 & -3 & 0\\end{pmatrix}\\\\\\hline7 & \\left\\{0,2,1\\right\\} & \\begin{pmatrix}0 & 0 & 0\\\\2 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix}\\\\\\hline8 & \\left\\{0,1,2\\right\\} & \\begin{pmatrix}0 & 0 & 0\\\\0 & 0 & 0\\\\3 & 0 & 0\\end{pmatrix}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "0f55ca5d-9722-4f9a-887f-5df21815a0b0"
    }
