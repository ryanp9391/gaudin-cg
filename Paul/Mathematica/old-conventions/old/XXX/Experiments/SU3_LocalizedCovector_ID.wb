      {
       "data": "Out[65]= \\begin{array}{|c|c|}\\hline\\text{Det Y} & \\frac{\\mathrm{bb}^3}{108}\\\\\\hline\\text{char poly} & \\frac{1}{108}\\,\\left(\\mathrm{bb}-3\\,t\\right)\\,\\left(\\mathrm{bb}+6\\,t\\right)^2\\\\\\hline\\text{eigenvalues} & \\left\\{\\frac{\\mathrm{bb}}{3},-\\frac{\\mathrm{bb}}{6},-\\frac{\\mathrm{bb}}{6}\\right\\}\\\\\\hline\\text{2x2 minors of Y + (bb/6) 1} & \\left\\{0,0,0,0,0,\\frac{1}{12}\\,\\left(3\\,\\mathrm{aa}\\,\\mathrm{bb}-4\\,\\mathrm{cc}\\right),0,0,0\\right\\}\\\\\\hline\\text{=> Y semisimple iff} & \\mathrm{cc}⩵\\frac{3\\,\\mathrm{aa}\\,\\mathrm{bb}}{4}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "39787ed6-b6a4-4eb0-8e88-99c821467bc0"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* --- 6. WHAT IT IS: the four localized directions span a 4-dim LIE SUBALGEBRA of gl(3) --- *)\nbasW = {yOf[UnitVector[8, 8]], yOf[UnitVector[8, 7]], yOf[UnitVector[8, 5]], yOf[UnitVector[8, 3]]};\ncomms = Flatten[Table[basW[[p]] . basW[[q]] - basW[[q]] . basW[[p]], {p, 4}, {q, 4}], 1];\nbr[A_, B_] := A . B - B . A;\nhgr = 2 el[3, 3] - el[1, 1] - el[2, 2];   (* H = diag(-1,-1,2) *)\nGrid[{\n  {\"slot 8  (coeff 1 )\", MatrixForm[basW[[1]]], \"E13/3  =  a   annihilation\"},\n  {\"slot 7  (coeff aa)\", MatrixForm[basW[[2]]], \"E12/2  =  c   centre\"},\n  {\"slot 5  (coeff bb)\", MatrixForm[basW[[3]]], \"H/6    =  N   grading\"},\n  {\"slot 3  (coeff cc)\", MatrixForm[basW[[4]]], \"E32    =  a+  creation\"},\n  {\"dim span\", MatrixRank[Flatten /@ basW], \"\"},\n  {\"dim span + all 16 commutators\", MatrixRank[Flatten /@ Join[basW, comms]], \"CLOSED -> Lie subalgebra\"},\n  {\"[a, a+] == c\", br[el[1, 3], el[3, 2]] === el[1, 2], \"Heisenberg\"},\n  {\"[c, a] == 0 , [c, a+] == 0\", {br[el[1, 2], el[1, 3]] === 0 el[1, 1], br[el[1, 2], el[3, 2]] === 0 el[1, 1]}, \"c central\"},\n  {\"[H, a] , [H, a+] , [H, c]\",\n   {br[hgr, el[1, 3]] === -3 el[1, 3], br[hgr, el[3, 2]] === 3 el[3, 2], br[hgr, el[1, 2]] === 0 el[1, 2]},\n   \"grading -3, +3, 0\"}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
