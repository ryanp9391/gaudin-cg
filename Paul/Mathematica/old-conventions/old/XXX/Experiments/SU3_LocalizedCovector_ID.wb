       "data": "Out[70]= \\begin{array}{|c|c|c|}\\hline\\text{slot 8  (coeff 1 )} & \\begin{pmatrix}0 & 0 & \\frac{1}{3}\\\\0 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix} & \\text{E13/3  =  a   annihilation}\\\\\\hline\\text{slot 7  (coeff aa)} & \\begin{pmatrix}0 & \\frac{1}{2} & 0\\\\0 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix} & \\text{E12/2  =  c   centre}\\\\\\hline\\text{slot 5  (coeff bb)} & \\begin{pmatrix}-\\frac{1}{6} & 0 & 0\\\\0 & -\\frac{1}{6} & 0\\\\0 & 0 & \\frac{1}{3}\\end{pmatrix} & \\text{H/6    =  N   grading}\\\\\\hline\\text{slot 3  (coeff cc)} & \\begin{pmatrix}0 & 0 & 0\\\\0 & 0 & 0\\\\0 & 1 & 0\\end{pmatrix} & \\text{E32    =  a+  creation}\\\\\\hline\\text{dim span} & 4 & \\\\\\hline\\text{dim span + all 16 commutators} & 4 & \\text{CLOSED -> Lie subalgebra}\\\\\\hline\\text{[a, a+] == c} & \\mathrm{True} & \\text{Heisenberg}\\\\\\hline\\text{[c, a] == 0 , [c, a+] == 0} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\} & \\text{c central}\\\\\\hline\\text{[H, a] , [H, a+] , [H, c]} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\} & \\text{grading -3, +3, 0}\\\\\\hline\\end{array}",
