      },
      {
       "data": "Out[48]= \\begin{array}{|c|c|c|c|}\\hline\\text{slot} & \\text{weight} & \\text{<e8|exp(n)} & \\text{target}\\\\\\hline1 & \\left\\{2,1,0\\right\\} & \\frac{x^2\\,z^2}{12}-\\frac{y^2}{3} & 0\\\\\\hline2 & \\left\\{2,0,1\\right\\} & \\frac{x^2\\,z}{6}+\\frac{x\\,y}{3} & 0\\\\\\hline3 & \\left\\{1,2,0\\right\\} & \\frac{x\\,z^2}{6}-\\frac{y\\,z}{3} & \\mathrm{cc}\\\\\\hline4 & \\left\\{1,1,1\\right\\} & \\frac{x\\,z}{2}+\\frac{y}{3} & 0\\\\\\hline5 & \\left\\{1,1,1\\right\\} & \\frac{x\\,z}{2}-y & \\mathrm{bb}\\\\\\hline6 & \\left\\{1,0,2\\right\\} & x & 0\\\\\\hline7 & \\left\\{0,2,1\\right\\} & \\frac{2\\,z}{3} & \\mathrm{aa}\\\\\\hline8 & \\left\\{0,1,2\\right\\} & 1 & 1\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "dcd96307-1ea0-4d11-af28-b2512c775a40"
