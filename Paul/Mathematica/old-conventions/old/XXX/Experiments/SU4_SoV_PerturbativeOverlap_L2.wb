  {
   "kind": 2,
   "value": "ClearAll[univHahnFour,univProductCandidate,univInterpData,univPairPolynomial];\nunivHahnFour[ss_,pp_,mm_,kk_] := Module[{r=mm+kk+1,a,b,c,d,hh=h/.prm,base,xx},base[n_] := Expand[hh^n (univHahnSeed[n]/.{exS->ss+1,exP->pp+1,exT->((θ1-θ2)/h/.prm),x->((x-(θ2/.prm))/hh+1)})];a=base[mm];b=Expand[base[r]-Coefficient[base[r],x,mm]a];c=Expand[a/.x->x-hh];d=Expand[(b/.x->x-hh)-Coefficient[b/.x->x-hh,x,mm]c];{a,b,c,d}];\nunivProductCandidate[ss_,pp_,mm_,kk_] := With[{ll=ss+pp,jj=mm+kk},univVacScalar[ss,pp] univExpectedFactors[ss,pp,mm,kk] mm! kk! Pochhammer[kk+2,mm]^3/(Pochhammer[ll-2 mm-2 kk+2,kk]^5 Pochhammer[ll-2 mm-kk+3,mm]^3 Pochhammer[ll-2 mm+4,mm])];\nunivHahnFourChecks=Table[Module[{qs=univHahnFour@@cc,mu0={cc[[1]]+cc[[2]]-cc[[3]],cc[[1]]+cc[[2]]-cc[[3]]-cc[[4]],cc[[3]]+cc[[4]],cc[[3]]},orig},orig=Join[qpoly[#,x]&/@Take[UntwSolve[cc[[1]],cc[[2]],mu0][\"P\"],2],qpoly[#,x]&/@Take[UntwSolveD[cc[[1]],cc[[2]],mu0][\"Pd\"],2]];Expand[qs-orig]],{cc,{{3,2,0,2},{3,2,1,1},{3,2,2,0},{4,3,1,2},{4,3,2,1},{4,3,3,0}}}];\nGrid[{{\"explicit Hahn formulas for all four allowed Q-functions\",univHahnFourChecks},{\"all-label norm product candidate\",\"m! k! (k+2)_m^3 / [(L-2m-2k+2)_k^5 (L-2m-k+3)_m^3 (L-2m+4)_m] times the written spin and separation products\"}},Frame->All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
