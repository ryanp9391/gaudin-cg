  {
   "kind": 2,
   "value": "ClearAll[d2FirstEq, d2FirstSol, d2FirstQ, d2ps];\nd2FirstQ = Table[x + (d2a /. First[d2UntwSol]) - If[kk > 2, h, 0] + eps d2q[kk, 1], {kk, 4}];\nd2FirstEq = Join[Table[CoefficientList[Cancel[BaxRes[exS, exP, d2mu][kk][Function[y, Evaluate[d2FirstQ[[kk]] /. x -> y]]][x]/(ν1[exS, exP][x - 2 h] ν1[exS, exP][x - 3 h])], x], {kk, 2}], Table[CoefficientList[d2DualRes[exS, exP, d2mu][{4, 3}[[kk - 2]]][Function[y, Evaluate[d2FirstQ[[kk]] /. x -> y]]][x], x], {kk, 3, 4}]];\nd2FirstEq = Factor /@ Coefficient[Expand[Flatten[d2FirstEq] /. Table[tc[k] -> (tc[k] /. First[d2UntwSol]) + eps d2t[k, 1], {k, 5}] /. Table[z[k] -> 1 + eps d2ps[k], {k, 4}]], eps, 1];\nd2FirstSol = TimeConstrained[Quiet[Solve[Thread[d2FirstEq == 0], Join[Table[d2q[k, 1], {k, 4}], Table[d2t[k, 1], {k, 5}]]], Solve::svars], 40, $Aborted];\nIf[ListQ[d2FirstSol], Factor[Table[d2q[k, 1], {k, 4}] /. First[d2FirstSol]], d2FirstSol]",
   "languageId": "wolfram",
   "outputs": [
