  {
   "kind": 2,
   "value": "univProductNewCases={{5,4,0,4},{5,4,1,3},{5,4,2,2},{5,4,3,1}};\nunivProductNewChecks=Table[Module[{rr=univNestedNorm@@Append[Append[cc,10],{3,1,-1,-3}]},Join[cc,{If[KeyExistsQ[rr,\"coefficient\"],Factor[rr[\"coefficient\"]-univProductCandidate@@cc],rr[\"failure\"]]}]],{cc,univProductNewCases}];\nGrid[Prepend[univProductNewChecks,{\"S\",\"P\",\"m\",\"k\",\"independent nested-jet residual\"}],Frame->All]",
