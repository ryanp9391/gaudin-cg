  {
   "kind": 2,
   "value": "ClearAll[univExpectedFactors];\nunivExpectedFactors[ss_,pp_,mm_,kk_] := With[{jj=mm+kk,tt=(θ1-θ2)/h/.prm},Factor[(FactorialPower[ss,jj]FactorialPower[pp,jj])^3 FactorialPower[ss+1,mm]FactorialPower[pp+1,mm] Product[((ss-r+tt)(pp-r-tt))^3,{r,0,jj-1}] Product[(ss+1-r+tt)(pp+1-r-tt),{r,0,mm-1}]]];\nunivMixedRay=univNestedNorm[3,2,1,1,8,{4,1,-2,-3}];\nunivMixedCases={{3,2,1,1},{4,2,1,1},{4,3,1,1},{4,3,1,2},{4,3,2,1}};\nunivMixedData=Table[Module[{rr=univNestedNorm@@Append[Append[cc,8],{3,1,-1,-3}]},If[KeyExistsQ[rr,\"coefficient\"],Join[cc,{Factor[rr[\"coefficient\"]/univVacScalar@@Take[cc,2]/univExpectedFactors@@cc]}],Join[cc,{rr[\"failure\"]}]]],{cc,univMixedCases}];\nGrid[{{\"second-ray and deeper-jet residual\",Factor[univMixedRay[\"coefficient\"]-univM1K1Norm32[\"coefficient\"]]},{\"S,P,m,k; residual prefactor after the proposed products\",Grid[univMixedData,Frame->All]}},Frame->All]",
   "languageId": "wolfram",
