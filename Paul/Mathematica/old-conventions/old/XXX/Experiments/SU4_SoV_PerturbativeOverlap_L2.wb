  {
   "kind": 2,
   "value": "univQuarticAll6=univQuarticScan[univHahnTables,univHahnTargets,Range[Length[univQuarticIndices]]];\nunivQuarticSmallScans=Table[With[{sc=univQuarticScan[Take[univHahnTables,n],Take[univHahnTargets,n],Range[Length[univQuarticIndices]]]}, {n-1,sc[\"rank\"],sc[\"augmented rank\"]}],{n,2,5}];\nGrid[{{\"all beta distributions: rank\",univQuarticAll6[\"rank\"]},{\"all beta distributions: augmented rank\",univQuarticAll6[\"augmented rank\"]},{\"maximum k, rank, augmented rank\",Grid[univQuarticSmallScans,Frame->All]}},Frame->All]",
   "languageId": "wolfram",
   "outputs": [
    {
