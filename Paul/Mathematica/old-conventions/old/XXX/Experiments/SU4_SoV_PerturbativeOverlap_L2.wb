  {
   "kind": 2,
   "value": "ClearAll[univMod,univQuarticScan];\nunivMod[v_,prime_] := Mod[Numerator[v] PowerMod[Denominator[v],-1,prime],prime];\nunivQuarticScan[tabs_List,targets_List,ids_List,prime_:1000003] := Module[{maxdeg=Max[Exponent[Flatten[tabs],exT]]4,rows,yy,vec,tm,rr,rank,aug}, rows=Flatten[Table[vec=univMod[#,prime]&/@(Flatten[tabs[[j]]]/.exT->tt);Mod[(Times@@vec[[#]]&)/@univQuarticIndices[[ids]],prime],{j,Length[tabs]},{tt,0,maxdeg}],1];yy=Flatten[Table[univMod[targets[[j]]/.exT->tt,prime],{j,Length[tabs]},{tt,0,maxdeg}]];rank=MatrixRank[rows,Modulus->prime];aug=MatrixRank[MapThread[Append,{rows,yy}],Modulus->prime];<|\"rank\"->rank,\"augmented rank\"->aug,\"rows\"->rows,\"target\"->yy,\"samples per state\"->maxdeg+1|>];\nunivHahnTargets=Table[univSl2Pref[12,kk] univHahnMoment[(univHahnSeed[kk]/.{exS->6,exP->6})^2,6,6]^3,{kk,0,4}];\nunivQuarticScan6=univQuarticScan[univHahnTables,univHahnTargets,univQuarticBeta2];\nGrid[{{\"candidate coefficients\",Length[univQuarticBeta2]},{\"constraint rows\",Length[univQuarticScan6[\"rows\"]]},{\"rank modulo 1000003\",univQuarticScan6[\"rank\"]},{\"augmented rank\",univQuarticScan6[\"augmented rank\"]},{\"evidence caveat\",\"k>=2 target uses the cubic-pairing conjecture; verify independently before excluding an ansatz\"}},Frame->All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
