      {
       "data": "Out[57]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{Claim} & \\text{Status} & \\text{Evidence} & \\text{Exact residual} & \\text{Next test}\\\\\\hline\\text{Balanced d=2 product} & \\text{proved} & \\text{symbolic S,P,t determinant} & 0 & \\text{none for this family}\\\\\\hline\\text{Balanced d=4 product} & \\text{proved} & \\text{symbolic S,P,t determinant} & 0 & \\text{none for this family}\\\\\\hline\\text{Balanced all d=2m determinant} & \\text{derived} & \\text{analytic row confluence; d=4 independent twist jets} & 0 & \\text{extend to unbalanced degrees}\\\\\\hline\\text{Balanced all-m product} & \\text{independently validated; all-m proof open} & \\text{d=6 second inhomogeneity; d=8} & \\left\\{0,0\\right\\} & \\text{prove general factorisation}\\\\\\hline\\text{Unbalanced d>=2} & \\text{open} & \\text{not covered by the equal-degree proof} & \\text{not evaluated} & \\text{mu=\\{L,L-2,2,0\\} and \\{L-1,L-2,2,1\\}}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "9cbeb489-bfd7-485f-9e5f-9395a44174b1"
    }
