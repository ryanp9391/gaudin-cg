      {
       "data": "Out[81]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{truncation Ntr} & \\text{det A|A (norm)} & \\text{det V|V (norm)} & \\text{det A|V (cross)} & \\text{det V|A (cross)}\\\\\\hline5 & 14.\\, & 16.\\, & 17.\\, & 17.04\\\\\\hline6 & 14.\\, & 16.\\, & 18.\\, & 18.\\,\\\\\\hline7 & 14.\\, & 16.\\, & 19.\\, & 19.\\,\\\\\\hline8 & 14.\\, & 16.\\, & 20.\\, & 20.\\,\\\\\\hline10 & 14.\\, & 16.\\, & 22.\\, & 22.\\,\\\\\\hline\\end{array}",
