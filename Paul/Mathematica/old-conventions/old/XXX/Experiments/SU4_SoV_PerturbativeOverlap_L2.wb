  {
   "kind": 2,
   "value": "ClearAll[balancedFastJet, bjc, bjt];\nbalancedFastJet[S_, P_, mm_, nn_, ps_List] := Module[{mu = {S + P - mm, S + P - mm, mm, mm}, p0, pd0, tc0, qq, ts, eq, acc = {}, report = {}, eqn, unk, ss}, p0 = UntwSolve[S, P, mu][\"P\"][[1]]; pd0 = UntwSolveD[S, P, mu][\"Pd\"][[1]]; tc0 = UntwSolve[S, P, mu][\"tc0\"]; qq[kk_][y_] := qpoly[If[kk <= 2, p0, pd0], y] + Sum[eps^jj Sum[bjc[kk, ii, jj] y^ii, {ii, 0, mm - 1}], {jj, nn}]; ts = Table[tc[kk] -> tc0[[kk]] + Sum[eps^jj bjt[kk, jj], {jj, nn}], {kk, 5}]; eq = Join[Table[CoefficientList[Cancel[BaxRes[S, P, mu][kk][qq[kk]][x]/(ν1[S, P][x - 2 h] ν1[S, P][x - 3 h])], x], {kk, 2}], Table[CoefficientList[d2DualRes[S, P, mu][{4, 3}[[kk - 2]]][qq[kk]][x], x], {kk, 3, 4}]]; eq = Expand[Flatten[eq] /. prm /. ts /. Table[z[j] -> 1 + eps ps[[j]], {j, 4}]]; Do[eqn = DeleteCases[Expand[Coefficient[eq, eps, jj] /. acc], 0]; unk = DeleteDuplicates[Cases[Variables[eqn], _bjc | _bjt]]; ss = Quiet[Solve[Thread[eqn == 0], unk], Solve::svars]; If[ss === {}, Return[<|\"failed order\" -> jj, \"report\" -> report|>]]; acc = Join[acc /. First[ss], First[ss]]; AppendTo[report, {jj, Length[eqn], Length[unk], Length[First[ss]]}], {jj, 0, nn}]; <|\"q\" -> Table[qq[kk][x] /. acc, {kk, 4}], \"sol\" -> acc, \"report\" -> report|>];\nbj32 = TimeConstrained[balancedFastJet[3, 2, 2, 4, {3, 1, -1, -3}], 40, $Aborted];\nbj32det = If[AssociationQ[bj32], jetDet[jetSPMat[3, 2, {3, 1, -1, -3}, bj32[\"q\"]], 14], $Aborted];\n{If[AssociationQ[bj32], bj32[\"report\"], bj32], If[bj32det === $Aborted, $Aborted, Factor[Coefficient[Normal[bj32det], eps, 12]/cand[{3, 1, -1, -3}, {3, 3, 2, 2}] - Det[balancedQMat[3, 2, 2]]]]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"251778\" data-output-id=\"86\" data-out-n=\"296\" data-sub-idx=\"4\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"60\" data-sub-start=\"4\" data-sub-end=\"4\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[296]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"29\" data-line-broken=\"1\" data-latex-b64=\"XGJlZ2lue2FsaWduZWR9CiAgJiBcXAogICZcbGVmdFx7XGJlZ2lue3BtYXRyaXh9MCAmIDAgJiAwICYgMFxcMSAmIDIwICYgMTMgJiAxMlxcMiAmIDIwICYgMTQgJiAxM1xcMyAmIDIwICYgMTQgJiAxM1xcNCAmIDIwICYgMTQgJiAxM1xlbmR7cG1hdHJpeH0gXHJpZ2h0LiBcXAogICZcbGVmdC4gLDBccmlnaHRcfQpcZW5ke2FsaWduZWR9\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.3001em;vertical-align:-4.4em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.9em;\"><span style=\"top:-9.3101em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"mord\"></span></span><span style=\"top:-5.4em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"mord\"></span></span><span style=\"top:-1.51em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.9em;\"><span style=\"top:-9.3101em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"mord\"><span class=\"