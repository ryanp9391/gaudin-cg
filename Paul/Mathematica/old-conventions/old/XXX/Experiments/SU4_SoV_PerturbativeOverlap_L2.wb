      {
       "data": "Out[93]= \\begin{array}{|c|c|c|c|}\\hline\\text{state} & \\text{full rank} & \\text{total-functional rank} & \\text{nonzero counts by (i,a)}\\\\\\hline\\left\\{1,1,\\left\\{2,2,0,0\\right\\}\\right\\} & 5 & 5 & \\begin{pmatrix}0 & 0 & 8 & 8\\\\0 & 4 & 8 & 8\\\\8 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\end{pmatrix}\\\\\\hline\\left\\{1,1,\\left\\{2,1,1,0\\right\\}\\right\\} & 6 & 6 & \\begin{pmatrix}0 & 4 & 8 & 8\\\\4 & 6 & 8 & 8\\\\8 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\end{pmatrix}\\\\\\hline\\left\\{1,1,\\left\\{1,1,1,1\\right\\}\\right\\} & 8 & 8 & \\begin{pmatrix}4 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\end{pmatrix}\\\\\\hline\\left\\{2,1,\\left\\{3,3,0,0\\right\\}\\right\\} & 4 & 4 & \\begin{pmatrix}0 & 0 & 8 & 8\\\\0 & 0 & 8 & 8\\\\8 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\end{pmatrix}\\\\\\hline\\left\\{2,1,\\left\\{3,2,1,0\\right\\}\\right\\} & 5 & 5 & \\begin{pmatrix}0 & 0 & 8 & 8\\\\0 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\end{pmatrix}\\\\\\hline\\left\\{2,1,\\left\\{2,2,1,1\\right\\}\\right\\} & 6 & 6 & \\begin{pmatrix}0 & 4 & 8 & 8\\\\4 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\\\8 & 8 & 8 & 8\\end{pmatrix}\\\\\\hline\\end{array}",
