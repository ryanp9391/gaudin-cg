  {
   "kind": 2,
   "value": "ClearAll[univColumnBasis,univFullDegreeScan];\nunivColumnBasis[mat_,prime_] := Module[{red=RowReduce[mat,Modulus->prime],piv},piv=(First[FirstPosition[#,Except[0],Missing[\"zero\"],{1},Heads->False]]&)/@Select[red,!AllTrue[#,PossibleZeroQ]&];<|\"matrix\"->mat[[All,piv]],\"pivots\"->piv|>];\nunivFullDegreeScan[tabs_List,targets_List,prime_:1000003] := Module[{md=4 Max[Exponent[Flatten[tabs],exT]],vals,yy,base,cur,products,bb,record={},rnk,arnk},vals=Flatten[Table[univMod[#,prime]&/@(Flatten[tabs[[j]]]/.exT->tt),{j,Length[tabs]},{tt,0,md}],1];yy=Flatten[Table[univMod[targets[[j]]/.exT->tt,prime],{j,Length[tabs]},{tt,0,md}]];base=univColumnBasis[vals,prime][\"matrix\"];cur=base;AppendTo[record,{1,Dimensions[cur][[2]],MatrixRank[MapThread[Append,{cur,yy}],Modulus->prime]}];Do[products=Transpose[Flatten[Table[Mod[cur[[All,i]]base[[All,j]],prime],{i,Dimensions[cur][[2]]},{j,Dimensions[base][[2]]}],1]];bb=univColumnBasis[products,prime];cur=bb[\"matrix\"];AppendTo[record,{deg,Dimensions[cur][[2]],MatrixRank[MapThread[Append,{cur,yy}],Modulus->prime]}],{deg,2,4}];<|\"record\"->record,\"basis\"->cur,\"target\"->yy|>];\nunivFullQuartic6=univFullDegreeScan[univHahnTables,univHahnTargets];\nGrid[Prepend[univFullQuartic6[\"record\"],{\"polynomial degree\",\"rank of every monomial\",\"augmented rank\"}],Frame->All]",
   "languageId": "wolfram",
   "outputs": [
