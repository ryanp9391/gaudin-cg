  {
   "kind": 2,
   "value": "ClearAll[balUntwSeed, buc];\nbalUntwSeed[mm_] := Module[{mu = {exS + exP - mm, exS + exP - mm, mm, mm}, pf, eq, unk, ss}, pf[1][y_] := y^mm + Sum[buc[1, jj] y^jj, {jj, 0, mm - 1}]; pf[2][y_] := y^(mm + 1) + Sum[buc[2, jj] y^jj, {jj, 0, mm - 1}]; eq = Flatten[Table[CoefficientList[Cancel[BaxRes[exS, exP, mu][kk][pf[kk]][x]/(ν1[exS, exP][x - 2 h] ν1[exS, exP][x - 3 h])] /. z1sub /. {h -> 1, θ1 -> exT, θ2 -> 0}, x], {kk, 2}]]; unk = Join[tcvars, Flatten[Table[buc[kk, jj], {kk, 2}, {jj, 0, mm - 1}]]]; ss = Solve[Thread[eq == 0], unk]; <|\"solutions\" -> ss, \"P\" -> Factor[Table[pf[kk][x], {kk, 2}] /. First[ss]]|>];\nbalSeed2 = TimeConstrained[balUntwSeed[2], 40, $Aborted];\nGrid[{{\"Number of exact d=4 untwisted solutions\", If[AssociationQ[balSeed2], Length[balSeed2[\"solutions\"]], balSeed2]}}, Frame -> All]",
   "languageId": "wolfram",
