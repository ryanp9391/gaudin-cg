  {
   "kind": 2,
   "value": "ClearAll[exRoot, exRootEq, exRed, exTc, exDualRes, exDualEq, exDualSol];\nexRootEq = Expand[z[2] (exRoot - θ1 - exS h) (exRoot - θ2 - exP h) - z[3] (exRoot - θ1) (exRoot - θ2)];\nexRed[e_] := Factor[PolynomialRemainder[Numerator[Together[e]], exRootEq, exRoot]/Denominator[Together[e]]];\nexTc = Factor /@ (Join[exGeneralSol[[1]] /. exGeneralSol[[2, 2]], exGeneralSol[[2, 2]]] /. Power[aa_, 1/2] :> ((exS + exP) h + θ1 + θ2) z[2] - (θ1 + θ2) z[3] - 2 (z[2] - z[3]) exRoot);\nexTc = (#1[[1]] -> exRed[#1[[2]]]) & /@ exTc;\nexDualRes[j_, qf_] := Cancel[(z[j]^4 Product[ν[exS, exP][4][x + m h], {m, 1, 4}] qf[x] - z[j]^3 τ[1][exS, exP, {exS + exP, exS + exP - 1, 1, 0}][x + h] Product[ν[exS, exP][4][x + m h], {m, 2, 4}] qf[x + h] + z[j]^2 τ[2][exS, exP, {exS + exP, exS + exP - 1, 1, 0}][x + 2 h] Product[ν[exS, exP][4][x + m h], {m, 3, 4}] qf[x + 2 h] - z[j] τ[3][exS, exP, {exS + exP, exS + exP - 1, 1, 0}][x + 3 h] ν[exS, exP][4][x + 4 h] qf[x + 3 h] + τ[4][exS, exP, {exS + exP, exS + exP - 1, 1, 0}][x + 4 h] qf[x + 4 h])/(ν[exS, exP][4][x + 3 h] ν[exS, exP][4][x + 4 h])];\nexDualEq = DeleteCases[exRed /@ CoefficientList[exDualRes[3, Function[y, y + exCg]] /. exTc, x], 0];\nexDualSol = Solve[Thread[exDualEq == 0], exCg];\n{exBg /. exTc, exDualSol, exRed /@ CoefficientList[exDualRes[4, Function[y, 1]] /. exTc, x]}",
   "languageId": "wolfram",
