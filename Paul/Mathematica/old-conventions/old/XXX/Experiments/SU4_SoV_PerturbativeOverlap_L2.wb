  {
   "kind": 2,
   "value": "(* Q-functions straight from the perturbative solvers: Q_i = Exp[phi_i u] q_i from pushQ12 (i=1,2) and Q^j = Exp[-phi_j u] q^j from pushQ34 (a=1,2 <-> j=4,3). Any coefficient still undetermined at the top order is set to zero. *)\nClearAll[dirQ, dulQ, zero, pairF, spMat];\nzero[r_] := Thread[DeleteDuplicates[Cases[r[\"sol\"], (_qd | _qe | _tcn), Infinity]] -> 0];\ndirQ[r_, S_, P_, μ_, N_, Ntr_][i_] := Function[y, Evaluate[trunc[Ntr][((Exp[I eps psi[[i]] y] (y^(Mdeg[S, P, μ][[i]]) + Sum[y^j Sum[eps^n qd[i, n, j], {n, -(Mdeg[S, P, μ][[i]] - Mdeg[S, P, μ][[1]]), N}], {j, 0, Mdeg[S, P, μ][[i]] - 1}])) /. r[\"sol\"]) /. zero[r]]]];\ndulQ[r_, μ_, N_, Ntr_][a_] := Function[y, Evaluate[trunc[Ntr][((Exp[-I eps psi[[{4, 3}[[a]]]] y] (y^(μ[[{4, 3}[[a]]]]) + Sum[y^j Sum[eps^n qe[a, n, j], {n, -(μ[[{4, 3}[[a]]]] - μ[[4]]), N}], {j, 0, μ[[{4, 3}[[a]]]] - 1}])) /. r[\"sol\"]) /. zero[r]]]];\npairF[qa_, qb_, r_, y_] := Switch[r, 1, qa[y] qb[y], 21, qa[y] qb[y - (h /. prm)], 22, qa[y + (h /. prm)] qb[y], 3, qa[y + (h /. prm)] qb[y - (h /. prm)]];\nspMat[S_, P_, dualA_, dirB_, Ntr_] := Module[{rows = Flatten[Table[{al, i, a}, {al, 2}, {i, 2}, {a, 2}], 2], cols = Flatten[Table[{r, be}, {r, {1, 21, 22, 3}}, {be, {0, 1}}], 1]}, Outer[resSum[S, P, #1[[1]], trunc[Ntr][u^#2[[2]] pairF[dualA[#1[[3]]], dirB[#1[[2]]], #2[[1]], u]]] &, rows, cols, 1]];\n\"scalar product loaded\"",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"51807\" data-output-id=\"6\" data-out-n=\"53\" data-sub-idx=\"7\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"12\" data-sub-start=\"7\" data-sub-end=\"7\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[53]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"7\" data-latex-b64=\"XHRleHR7c2NhbGFyIHByb2R1Y3QgbG9hZGVkfQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord text\"><span class=\"mord\">scalar product loaded</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
