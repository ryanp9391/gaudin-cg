      {
       "data": "Out[170]= \\begin{aligned}\n  &\\left\\{-\\frac{\\textcolor{gray}{\\left[\\textcolor{black}{\\begin{gathered}\n  \\mathrm{exRoot}\\,z\\left(1\\right) \\\\\n  -\\mathrm{exRoot}\\,z\\left(2\\right)-h\\,z\\left(1\\right)\n\\end{gathered}}\\right]}}{z\\left(1\\right)-z\\left(2\\right)} \\right. \\\\\n  &\\left. ,\\frac{\\textcolor{gray}{\\left[\\textcolor{black}{\\begin{gathered}\n  -\\mathrm{exRoot}\\,z\\left(3\\right) \\\\\n  +\\mathrm{exRoot}\\,z\\left(4\\right)+h\\,z\\left(4\\right)\n\\end{gathered}}\\right]}}{z\\left(3\\right)-z\\left(4\\right)} \\right. \\\\\n  &\\left. ,\\left\\{0\\right\\},\\left\\{0\\right\\} \\right. \\\\\n  &\\left. ,\\frac{\\textcolor{gray}{\\left[\\textcolor{black}{\\begin{gathered}\n  \\mathrm{exP}\\,\\mathrm{exS}\\,h+\\mathrm{exP}\\,\\theta1 \\\\\n  +\\mathrm{exS}\\,\\theta2\n\\end{gathered}}\\right]}}{\\mathrm{exP}+\\mathrm{exS}}\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
