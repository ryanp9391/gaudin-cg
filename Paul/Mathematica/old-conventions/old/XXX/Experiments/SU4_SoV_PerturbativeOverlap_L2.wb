  {
   "kind": 2,
   "value": "ClearAll[d2DualRes, d2FastJet, d2q, d2t];\nd2DualRes[S_, P_, mu_][j_][qf_][x_] := Cancel[(z[j]^4 Product[ν[S, P][4][x + m h], {m, 1, 4}] qf[x] - z[j]^3 τ[1][S, P, mu][x + h] Product[ν[S, P][4][x + m h], {m, 2, 4}] qf[x + h] + z[j]^2 τ[2][S, P, mu][x + 2 h] Product[ν[S, P][4][x + m h], {m, 3, 4}] qf[x + 2 h] - z[j] τ[3][S, P, mu][x + 3 h] ν[S, P][4][x + 4 h] qf[x + 3 h] + τ[4][S, P, mu][x + 4 h] qf[x + 4 h])/(ν[S, P][4][x + 3 h] ν[S, P][4][x + 4 h])];\nd2FastJet[S_, P_, nn_, ps_List] := Module[{mu = {S + P - 1, S + P - 1, 1, 1}, u0, v0, tc0, qq, ts, eq, acc = {}, report = {}, eqn, unk, ss}, u0 = UntwSolve[S, P, mu][\"P\"][[1, 1]]; v0 = UntwSolveD[S, P, mu][\"Pd\"][[1, 1]]; tc0 = UntwSolve[S, P, mu][\"tc0\"]; qq[kk_][y_] := y + If[kk <= 2, u0, v0] + Sum[eps^mm d2q[kk, mm], {mm, nn}]; ts = Table[tc[kk] -> tc0[[kk]] + Sum[eps^mm d2t[kk, mm], {mm, nn}], {kk, 5}]; eq = Join[Table[CoefficientList[Cancel[BaxRes[S, P, mu][kk][qq[kk]][x]/(ν1[S, P][x - 2 h] ν1[S, P][x - 3 h])], x], {kk, 2}], Table[CoefficientList[d2DualRes[S, P, mu][{4, 3}[[kk - 2]]][qq[kk]][x], x], {kk, 3, 4}]]; eq = Expand[Flatten[eq] /. prm /. ts /. Table[z[j] -> 1 + eps ps[[j]], {j, 4}]]; Do[eqn = DeleteCases[Expand[Coefficient[eq, eps, mm] /. acc], 0]; unk = DeleteDuplicates[Cases[Variables[eqn], _d2q | _d2t]]; ss = Quiet[Solve[Thread[eqn == 0], unk], Solve::svars]; If[ss === {}, Return[<|\"failed order\" -> mm, \"report\" -> report|>]]; acc = Join[acc /. First[ss], First[ss]]; AppendTo[report, {mm, Length[eqn], Length[unk], Length[First[ss]]}], {mm, 0, nn}]; <|\"q\" -> Table[qq[kk][x] /. acc, {kk, 4}], \"tc\" -> (tcvars /. ts /. acc), \"sol\" -> acc, \"report\" -> report|>];\nd2J11 = TimeConstrained[d2FastJet[1, 1, 8, {3, 1, -1, -3}], 40, $Aborted];\nIf[AssociationQ[d2J11], d2J11[\"report\"], d2J11]",
