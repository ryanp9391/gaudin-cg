  {
   "kind": 2,
   "value": "ClearAll[univInterpData,univPairPolynomial,univPairCoordinates,univExactBench,univValidatePolynomial];\nunivInterpData[ss_,pp_] := Module[{poles=Table[(θ2+j h)/.prm,{j,0,pp}],wx,h0,hh=h/.prm,q},wx=wE1[ss,pp,#]&/@poles;h0=Total[wx];Table[q=univHahnFour[ss,pp,mm,kk];{Factor[Total[MapThread[#1(q[[1]]/.x->#2)(q[[3]]/.x->#2+hh)&,{wx,poles}]]/h0],Factor[Total[MapThread[#1(q[[2]]/.x->#2)(q[[4]]/.x->#2+hh)&,{wx,poles}]]/h0],Factor[univProductCandidate[ss,pp,mm,kk]/univVacScalar[ss,pp]]},{mm,0,Min[ss,pp]},{kk,0,Min[ss,pp]-mm}]];\nunivPairPolynomial[data_List,xx_,yy_] := Module[{av=data[[All,1,1]],mx=Length[data]-1},Total[Table[Product[If[r==mm,1,(xx-av[[r+1]])/(av[[mm+1]]-av[[r+1]])],{r,0,mx}] Total[Table[data[[mm+1,kk+1,3]]Product[If[s==kk,1,(yy-data[[mm+1,s+1,2]])/(data[[mm+1,kk+1,2]]-data[[mm+1,s+1,2]])],{s,0,mx-mm}],{kk,0,mx-mm}]],{mm,0,mx}]]];\nunivPairCoordinates[ss_,pp_,mm_,kk_] := Module[{mu0={ss+pp-mm,ss+pp-mm-kk,mm+kk,mm},ps,pd,poles,wx,hh=h/.prm},ps=qpoly[#,x]&/@Take[UntwSolve[ss,pp,mu0][\"P\"],2];pd=qpoly[#,x]&/@Take[UntwSolveD[ss,pp,mu0][\"Pd\"],2];poles=Table[(θ2+j h)/.prm,{j,0,pp}];wx=wE1[ss,pp,#]&/@poles;Table[Factor[Total[MapThread[#1(ps[[j]]/.x->#2)(pd[[j]]/.x->#2+hh)&,{wx,poles}]]/Total[wx]],{j,2}]];\nunivExactBench[ss_,pp_,mm_,kk_] := If[kk==0,Det[balancedQMat[ss,pp,mm]],If[mm==0,univSl2Norm[ss,pp,kk,2 kk+4,{3,1,-1,-3}][\"coefficient\"],univNestedNorm[ss,pp,mm,kk,mm+3 kk+6,{3,1,-1,-3}][\"coefficient\"]]];\nunivValidatePolynomial[ss_,pp_] := Module[{dat=univInterpData[ss,pp],poly,coord,bench},poly=univPairPolynomial[dat,univX,univY];Flatten[Table[coord=univPairCoordinates[ss,pp,mm,kk];bench=univExactBench[ss,pp,mm,kk];{mm,kk,Factor[(poly/.Thread[{univX,univY}->coord])-bench/univVacScalar[ss,pp]]},{mm,0,Min[ss,pp]},{kk,0,Min[ss,pp]-mm}],1]];\nunivPolyData32=univInterpData[3,2];univPoly32=univPairPolynomial[univPolyData32,univX,univY];\nunivPolyCheck32=univValidatePolynomial[3,2];\nunivPolyData43=univInterpData[4,3];univPoly43=univPairPolynomial[univPolyData43,univX,univY];\nunivPolyCheck43=univValidatePolynomial[4,3];\nGrid[{{\"all 6 irreps at (3,2): m,k,residual\",Grid[univPolyCheck32,Frame->All]},{\"all 10 irreps at (4,3): m,k,residual\",Grid[univPolyCheck43,Frame->All]},{\"maximum total polynomial degrees\",{Max[Total/@(First/@CoefficientRules[univPoly32,{univX,univY}])],Max[Total/@(First/@CoefficientRules[univPoly43,{univX,univY}])]}},{\"general status\",\"Polynomial construction exact; all-spin norm coefficients remain a conjecture\"}},Frame->All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
