   "kind": 2,
   "value": "ClearAll[d2DualRes];\nd2DualRes[S_, P_, mu_][j_][qf_][x_] := Cancel[(z[j]^4 Product[ν[S, P][4][x + m h], {m, 1, 4}] qf[x] - z[j]^3 τ[1][S, P, mu][x + h] Product[ν[S, P][4][x + m h], {m, 2, 4}] qf[x + h] + z[j]^2 τ[2][S, P, mu][x + 2 h] Product[ν[S, P][4][x + m h], {m, 3, 4}] qf[x + 2 h] - z[j] τ[3][S, P, mu][x + 3 h] ν[S, P][4][x + 4 h] qf[x + 3 h] + τ[4][S, P, mu][x + 4 h] qf[x + 4 h])/(ν[S, P][4][x + 3 h] ν[S, P][4][x + 4 h])];\n\nClearAll[univLaurentJet, ulq, ult];\nunivLaurentJet[ss_,pp_,mm_,gap_,nn_,ray_List] := Module[{mu0={ss+pp-mm,ss+pp-mm-gap,mm+gap,mm}, deg={mm,mm+gap,mm,mm+gap}, lo={0,-gap,0,-gap}, seed, t0, qq, tr, eq, acc={}, report={}, en, vars, so, failure=None, r}, seed=Join[ConstantArray[UntwSolve[ss,pp,mu0][\"P\"][[1]],2],ConstantArray[UntwSolveD[ss,pp,mu0][\"Pd\"][[1]],2]];t0=UntwSolve[ss,pp,mu0][\"tc0\"]; If[gap>0,acc=Flatten[Table[ulq[j,c,-gap]->gap! (h/.prm)^gap/(ray[[If[j==2,1,3]]]-ray[[If[j==2,2,4]]])^gap Coefficient[qpoly[seed[[j]],x],x,c],{j,{2,4}},{c,0,deg[[j]]-1}]]];\nqq[j_][y_] := If[OddQ[j],qpoly[seed[[j]],y]+Sum[eps^r Sum[ulq[j,c,r] y^c,{c,0,deg[[j]]-1}],{r,1,nn}],y^deg[[j]]+Sum[eps^r Sum[ulq[j,c,r] y^c,{c,0,deg[[j]]-1}],{r,lo[[j]],nn}]];\ntr=Table[tc[j]->t0[[j]]+Sum[eps^r ult[j,r],{r,nn}],{j,5}];\neq=Join[Table[CoefficientList[Cancel[BaxRes[ss,pp,mu0][j][qq[j]][x]/(ν1[ss,pp][x-2 h] ν1[ss,pp][x-3 h])],x],{j,2}],Table[CoefficientList[d2DualRes[ss,pp,mu0][{4,3}[[j-2]]][qq[j]][x],x],{j,3,4}]];\neq=Expand[eps^gap Flatten[eq]/.prm/.tr/.Table[z[j]->1+eps ray[[j]],{j,4}]];\nDo[en=DeleteCases[Expand[Coefficient[eq,eps,r+gap]/.acc],0];vars=DeleteDuplicates[Cases[Variables[en],_ulq|_ult]];so=Quiet[Solve[Thread[en==0],vars],Solve::svars];If[so==={},failure=r;Break[]];acc=Join[acc/.First[so],First[so]];AppendTo[report,{r,Length[en],Length[vars],Length[First[so]]}],{r,-gap,nn}];\n<|\"failure\"->failure,\"mu\"->mu0,\"q\"->Table[qq[j][x]/.acc,{j,4}],\"tc\"->(tcvars/.tr/.acc),\"rules\"->acc,\"report\"->report|>];\nunivK2Jet=TimeConstrained[univLaurentJet[2,2,0,2,8,{3,1,-1,-3}],45,$Aborted];\nGrid[{{\"unbalanced d=2 Laurent jet\",If[AssociationQ[univK2Jet],univK2Jet[\"report\"],univK2Jet]},{\"failure\",If[AssociationQ[univK2Jet],Lookup[univK2Jet,\"failure\",None],\"not completed\"]}},Frame->All]",
   "languageId": "wolfram",
