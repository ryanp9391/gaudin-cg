   "kind": 2,
   "value": "balSeed1 = balUntwSeed[1];\nbalNorm1Closed = Factor[Det[balNormalizedMat[1, balSeed1[\"P\"]]]];\nbalD2FormulaResidual = Factor[balNorm1Closed - 8 (exS exP)^3 (exS + 1) (exP + 1) ((exS + exT) (exP - exT))^3 (exS + 1 + exT) (exP + 1 - exT)/((exS + exP + 1)^3 (exS + exP + 2))];\nbalD4PrefactorResidual = Factor[balQPref2 - 432 (exS + exP - 1)^3 (exS + exP)^4 (exS + exP + 1)];\nGrid[{{\"Claim\", \"Status\", \"Evidence\", \"Exact residual\", \"Next test\"}, {\"Balanced d=2 product\", \"proved\", \"symbolic S,P,t determinant\", balD2FormulaResidual, \"none for this family\"}, {\"Balanced d=4 product\", \"proved\", \"symbolic S,P,t determinant\", balD4PrefactorResidual, \"none for this family\"}, {\"Balanced all d=2m determinant\", \"derived\", \"analytic row confluence; d=4 independent twist jets\", balEqualCheck, \"extend to unbalanced degrees\"}, {\"Balanced all-m product\", \"independently validated; all-m proof open\", \"d=6 second inhomogeneity; d=8\", {balSecondThetaResidual, balD8Residual}, \"prove general factorisation\"}, {\"Unbalanced d>=2\", \"open\", \"not covered by the equal-degree proof\", \"not evaluated\", \"mu={L,L-2,2,0} and {L-1,L-2,2,1}\"}}, Frame -> All, Alignment -> Left]",
