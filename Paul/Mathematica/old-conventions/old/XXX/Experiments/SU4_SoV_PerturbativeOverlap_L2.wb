   "kind": 2,
   "value": "ClearAll[balSecondThetaCheck];\nbalSecondThetaCheck[S_, P_, mm_] := Module[{du = Select[DownValues[UntwSolve], ! FreeQ[#[[1]], Pattern] &], dd = Select[DownValues[UntwSolveD], ! FreeQ[#[[1]], Pattern] &], dt = Select[DownValues[τ3quad], ! FreeQ[#[[1]], Pattern] &]}, Block[{prm = {θ1 -> 1/3, θ2 -> 1/5, h -> 1}, UntwSolve, UntwSolveD, τ3quad}, DownValues[UntwSolve] = du; DownValues[UntwSolveD] = dd; DownValues[τ3quad] = dt; Factor[Det[balancedQMat[S, P, mm]]/balVacK[S, P] - balQCandidate[S, P, mm]]]];\nbalSecondThetaResidual = TimeConstrained[balSecondThetaCheck[4, 3, 3], 30, $Aborted];\nbalD8Residual = TimeConstrained[Factor[Det[balancedQMat[4, 4, 4]]/balVacK[4, 4] - balQCandidate[4, 4, 4]], 30, $Aborted];\nGrid[{{\"d=6, (4,3), theta2=1/5: exact residual\", balSecondThetaResidual}, {\"d=8, (4,4): exact residual\", balD8Residual}, {\"Parameter state restored\", prm === {θ1 -> 1/3, θ2 -> 1/7, h -> 1}}}, Frame -> All, Alignment -> Left]",
