  {
   "kind": 2,
   "value": "ClearAll[univSl2Jet, usq, ust, univLiftQ];\nunivSl2Jet[ss_,pp_,kk_,nn_,ray_List] := Module[{mu0={ss+pp,ss+pp-kk,kk,0}, v, q0, qa, aa, dd, tt0, tc0, tpol, eq, acc={}, rep={}, en, va, so, rr, failure=None, hh=h/.prm}, v=qpoly[UntwSolve[ss,pp,mu0][\"P\"][[2]],x];q0=Expand[(v-(v/.x->x-hh))/((kk+1) hh)];aa=((x-θ1-ss h)(x-θ2-pp h))/.prm;dd=((x-θ1)(x-θ2))/.prm;tt0=Cancel[(aa (q0/.x->x+hh)+dd (q0/.x->x-hh))/q0];If[!PolynomialQ[tt0,x],Return[<|\"failure\"->\"seed TQ equation\"|>]];tc0=Coefficient[tt0,x,0];qa=q0+Sum[eps^rr Sum[usq[c,rr] x^c,{c,0,kk-1}],{rr,nn}];tpol=(2+eps(ray[[2]]+ray[[3]]))x^2+(-((1+eps ray[[2]])(θ1+θ2+(ss+pp)h)+(1+eps ray[[3]])(θ1+θ2))+kk h eps(ray[[2]]-ray[[3]]))x+tc0+Sum[eps^rr ust[rr],{rr,nn}];eq=Expand[((tpol qa-(1+eps ray[[2]])aa(qa/.x->x+hh)-(1+eps ray[[3]])dd(qa/.x->x-hh))/.prm)];Do[en=DeleteCases[Expand[CoefficientList[Coefficient[eq,eps,rr]/.acc,x]],0];va=DeleteDuplicates[Cases[Variables[en],_usq|_ust]];so=Solve[Thread[en==0],va];If[Length[so]!=1,failure=rr;Break[]];acc=Join[acc/.First[so],First[so]];AppendTo[rep,{rr,Length[en],Length[va],Length[First[so]]}],{rr,nn}];<|\"failure\"->failure,\"Q\"->(qa/.acc),\"T\"->(tpol/.prm/.acc),\"report\"->rep|>];\nunivLiftQ[poly_,zz_List] := Module[{hh=h/.prm, back,forward},back=NestList[Expand[(#/.x->x-hh)-#]&,poly,Exponent[poly,x]];forward=NestList[Expand[(#/.x->x+hh)-#]&,poly,Exponent[poly,x]];{1,Together[Sum[(-zz[[1]]/(zz[[1]]-zz[[2]]))^j back[[j+1]],{j,0,Length[back]-1}]],1,Together[Sum[(zz[[4]]/(zz[[3]]-zz[[4]]))^j forward[[j+1]],{j,0,Length[forward]-1}]]}];\nunivSl2K2=univSl2Jet[2,2,2,8,{3,1,-1,-3}];\nunivLiftK2=univLiftQ[univSl2K2[\"Q\"],1+eps{3,1,-1,-3}];\nGrid[{{\"unbalanced d=2 reduced TQ jet\",univSl2K2[\"report\"]},{\"failure\",univSl2K2[\"failure\"]},{\"leading Laurent coefficients\",Table[SeriesCoefficient[univLiftK2[[j]],{eps,0,-2}],{j,{2,4}}]}},Frame->All]",
   "languageId": "wolfram",
