   "value": "ClearAll[d2L, d2s1, d2s2, d2Mom, d2mom, d2v, d2w, d2UU, d2Confluent];\nd2L = exS + exP;\nd2s1 = (exS + 1) exT + exS (exS + 1)/2 + exP (exP + 1)/2;\nd2s2 = (d2s1^2 + (exS + 1) exT^2 + exT exS (exS + 1) + exS (exS + 1) (2 exS + 1)/6 + exP (exP + 1) (2 exP + 1)/6)/2;\nd2Mom[mm_] := Sum[StirlingS2[mm, kk] Pochhammer[-exP, kk] Pochhammer[-exS - exT, kk]/((-1)^kk Pochhammer[-d2L, kk]), {kk, 0, mm}];\nd2mom[pol_] := Total[MapIndexed[#1 d2Mom[First[#2] - 1] &, CoefficientList[Expand[pol], d2UU]]];\nd2Confluent = Module[{aa = d2a /. First[d2UntwSol] /. {h -> 1, θ1 -> exT, θ2 -> 0}, bb = d2BD /. {h -> 1, θ1 -> exT, θ2 -> 0}, cc = d2CD /. {h -> 1, θ1 -> exT, θ2 -> 0}, cols = Tuples[{{0, 1}, {0, 1}, {0, 1}}], top, low}, top = Transpose[Table[With[{sg = col[[1]], tt = col[[2]], be = col[[3]]}, Module[{xv = d2v - d2w, av = aa - col[[2]] + bb d2v, cv = aa + col[[1]] - 1 + cc d2w, ff}, ff = If[be == 0, xv d2L + xv^2 (d2s1 + av + cv), d2L (d2L - 1) + xv d2L (d2s1 + av + cv) + xv^2 (d2s2 + (av + cv) d2s1 + av cv)]; ff = Expand[(1 - tt d2v - sg d2w + (tt d2v + sg d2w)^2/2) ff]; {ff /. {d2v -> 0, d2w -> 0}, Coefficient[ff, d2w, 1] /. d2v -> 0, Coefficient[ff, d2v, 1] /. d2w -> 0, Coefficient[Coefficient[ff, d2v, 1], d2w, 1]}]], {col, cols}]]; low = Transpose[Table[With[{sg = col[[1]], tt = col[[2]], be = col[[3]]}, With[{qa = d2UU + aa - tt, qc = d2UU + aa + sg - 1}, d2mom /@ (d2UU^be {qa qc, qa ((-d2UU - sg) qc + cc), ((d2UU - tt) qa + bb) qc, ((d2UU - tt) qa + bb) ((-d2UU - sg) qc + cc)})]], {col, cols}]]; Map[Factor, Join[top, low], {2}]];\n{Dimensions[d2Confluent], Factor[Det[d2Confluent /. {exS -> 3, exP -> 2, exT -> 4/21}]]}",
   "languageId": "wolfram",
