   "kind": 2,
   "value": "balSeed2DualCheck = Table[Factor[d2DualRes[exS, exP, {exS + exP - 2, exS + exP - 2, 2, 2}][{4, 3}[[kk]]][Function[y, Evaluate[balSeed2[\"P\"][[kk]] /. x -> y - 1]]][x] /. z1sub /. {h -> 1, θ1 -> exT, θ2 -> 0} /. First[balSeed2[\"solutions\"]]], {kk, 2}];\nbalW2 = Factor[-(balSeed2[\"P\"][[1]] (balSeed2[\"P\"][[2]] /. x -> x - 1) - (balSeed2[\"P\"][[1]] /. x -> x - 1) balSeed2[\"P\"][[2]])];\nbalTop2 = Factor /@ {balSeed2[\"P\"][[1]] /. x -> exT + exS, balSeed2[\"P\"][[1]] /. x -> exP, balW2 /. x -> exT + exS, balW2 /. x -> exP};\n{balSeed2DualCheck, balTop2}",
