  {
   "kind": 2,
   "value": "ClearAll[balNormMom, balNormalizedMat, balNorm2];\nbalNormMom[kk_] := Sum[StirlingS2[kk, jj] Pochhammer[-exP, jj] Pochhammer[-exS - exT, jj]/((-1)^jj Pochhammer[-exS - exP, jj]), {jj, 0, kk}];\nbalNormalizedMat[mm_, seed_List] := Module[{ll = exS + exP, p1, p2, pd1, pd2, aa, ad, rd, rl, s1, s2, uu, v, w, cols = Tuples[{{0, 1}, {0, 1}, {0, 1}}], top, low, mom}, p1 = seed[[1]] /. x -> uu; p2 = seed[[2]] /. x -> uu; pd1 = p1 /. uu -> uu - 1; pd2 = (p2 /. uu -> uu - 1) + (mm + 1) pd1; aa = Coefficient[p1, uu, mm - 1]; ad = Coefficient[pd1, uu, mm - 1]; rd = Factor[p2 - (uu - aa) p1]; rl = Factor[-pd2 + (uu - ad) pd1]; s1 = (exS + 1) exT + exS (exS + 1)/2 + exP (exP + 1)/2; s2 = (s1^2 + (exS + 1) exT^2 + exT exS (exS + 1) + exS (exS + 1) (2 exS + 1)/6 + exP (exP + 1) (2 exP + 1)/6)/2; mom[pol_] := Total[MapIndexed[#1 balNormMom[First[#2] - 1] &, CoefficientList[Expand[pol], uu]]]; top = Transpose[Table[Module[{sg = col[[1]], tt = col[[2]], be = col[[3]], pol, ff}, pol = Expand[uu^be ((p1 + v rd) /. uu -> uu - tt) ((pd1 + w rl) /. uu -> uu + sg)]; ff = Sum[(v - w)^ell (-1)^(2 mm - ell) Pochhammer[-ll, 2 mm - ell] Sum[Coefficient[pol, uu, 2 mm + 1 - ell + jj] {1, s1, s2}[[jj + 1]], {jj, 0, 2}], {ell, 0, 2}]; ff = Expand[(1 - tt v - sg w + (tt v + sg w)^2/2) ff]; {ff /. {v -> 0, w -> 0}, Coefficient[ff, w, 1] /. v -> 0, Coefficient[ff, v, 1] /. w -> 0, Coefficient[Coefficient[ff, v, 1], w, 1]}], {col, cols}]]; low = Transpose[Table[Module[{sg = col[[1]], tt = col[[2]], be = col[[3]], qa, qc, ra, rc}, qa = p1 /. uu -> uu - tt; qc = pd1 /. uu -> uu + sg; ra = rd /. uu -> uu - tt; rc = rl /. uu -> uu + sg; mom /@ (uu^be {qa qc, qa ((-uu - sg) qc + rc), ((uu - tt) qa + ra) qc, ((uu - tt) qa + ra) ((-uu - sg) qc + rc)})], {col, cols}]]; Map[Factor, Join[top, low], {2}]];\nbalNorm2 = balNormalizedMat[2, balSeed2[\"P\"]];\nbalNorm2Closed = TimeConstrained[Factor[Det[balNorm2]], 45, $Aborted];\nGrid[{{\"d=4 symbolic ratio to vacuum\", balNorm2Closed}}, Frame -> All]",
   "languageId": "wolfram",
