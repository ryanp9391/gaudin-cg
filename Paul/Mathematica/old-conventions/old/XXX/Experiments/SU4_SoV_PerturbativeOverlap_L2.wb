      {
       "data": "Out[206]= \\begin{aligned}\n  &\\left\\{\\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\},\\mathrm{True} \\right. \\\\\n  &\\left. ,1355.94001494748764131246536677 \\right. \\\\\n  &\\left. -418.252103007227979590132389920\\,\\mathrm{i}\\right\\}\n\\end{aligned}",
