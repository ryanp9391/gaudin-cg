  {
   "kind": 2,
   "value": "ClearAll[d2DualRes];\nd2DualRes[S_, P_, mu_][j_][qf_][x_] := Cancel[(z[j]^4 Product[ν[S, P][4][x + m h], {m, 1, 4}] qf[x] - z[j]^3 τ[1][S, P, mu][x + h] Product[ν[S, P][4][x + m h], {m, 2, 4}] qf[x + h] + z[j]^2 τ[2][S, P, mu][x + 2 h] Product[ν[S, P][4][x + m h], {m, 3, 4}] qf[x + 2 h] - z[j] τ[3][S, P, mu][x + 3 h] ν[S, P][4][x + 4 h] qf[x + 3 h] + τ[4][S, P, mu][x + 4 h] qf[x + 4 h])/(ν[S, P][4][x + 3 h] ν[S, P][4][x + 4 h])];\n\nClearAll[univBaxJetCheck, ubt];\nunivBaxJetCheck[ss_,pp_,kk_,qp_List,nn_,ray_List] := Module[{mu0={ss+pp,ss+pp-kk,kk,0},tr,eq,eqs,so,t0},t0=UntwSolve[ss,pp,mu0][\"tc0\"];tr=Table[tc[j]->t0[[j]]+Sum[eps^r ubt[j,r],{r,nn+kk}],{j,5}];eq=Join[Table[Cancel[BaxRes[ss,pp,mu0][j][Function[y,Evaluate[qp[[j]]/.x->y]]][x]/(ν1[ss,pp][x-2 h]ν1[ss,pp][x-3 h])],{j,2}],Table[d2DualRes[ss,pp,mu0][{4,3}[[j-2]]][Function[y,Evaluate[qp[[j]]/.x->y]]][x],{j,3,4}]];eq=Expand[Normal[Series[(eps^kk eq/.prm/.tr/.Table[z[j]->1+eps ray[[j]],{j,4}]),{eps,0,nn+kk}]]];eqs=DeleteCases[Flatten[Table[CoefficientList[Coefficient[eq,eps,r],x],{r,0,nn+kk}]],0];so=Solve[Thread[eqs==0],DeleteDuplicates[Cases[Variables[eqs],_ubt]]];<|\"solutions\"->Length[so],\"residual\"->If[so==={},Missing[\"Inconsistent\"],Simplify[eqs/.First[so]]],\"rules\"->so|>];\nunivLiftCheck=univBaxJetCheck[2,2,2,univLiftK2,2,{3,1,-1,-3}];\nGrid[{{\"full four-branch Baxter solve\",univLiftCheck[\"solutions\"]},{\"all coefficients vanish\",If[univLiftCheck[\"solutions\"]>0,Union[Flatten[univLiftCheck[\"residual\"]]],univLiftCheck[\"residual\"]]}},Frame->All]",
   "languageId": "wolfram",
   "outputs": [
