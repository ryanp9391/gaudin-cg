      {
       "data": "Out[215]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{(S,P)} & \\text{mu} & \\text{d} & \\text{measured ratio (exact)} & \\text{closed form} & \\text{match} & \\text{Qbar12 top-of-ladder / product}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,2,0,0\\right\\} & 0 & 1 & 1 & \\mathrm{True} & \\left\\{1,1\\right\\}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,1,1,0\\right\\} & 1 & \\frac{76765625}{2744515872} & \\frac{76765625}{2744515872} & \\mathrm{True} & \\left\\{\\frac{1}{2},\\frac{1}{2}\\right\\}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{1,1,1,1\\right\\} & 2 & \\frac{1073490500000}{1021217202747} & \\frac{1073490500000}{1021217202747} & \\mathrm{True} & \\left\\{\\frac{1}{6},\\frac{1}{6}\\right\\}\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,3,0,0\\right\\} & 0 & 1 & 1 & \\mathrm{True} & \\left\\{1,1\\right\\}\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,2,1,0\\right\\} & 1 & \\frac{3825694144}{20841167403} & \\frac{3825694144}{20841167403} & \\mathrm{True} & \\left\\{\\frac{2}{3},\\frac{1}{3}\\right\\}\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{2,2,1,1\\right\\} & 2 & \\frac{2435054322656}{63038098935} & \\frac{2435054322656}{63038098935} & \\mathrm{True} & \\left\\{\\frac{3}{10},\\frac{1}{10}\\right\\}\\\\\\hline\\end{array}",
