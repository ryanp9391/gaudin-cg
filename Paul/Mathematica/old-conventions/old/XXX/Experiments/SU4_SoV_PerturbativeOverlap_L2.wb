  {
   "kind": 2,
   "value": "ClearAll[univNestedNorm,univFullBaxJetCheck];\nunivNestedNorm[ss_,pp_,mm_,kk_,nn_,ray_List] := Module[{jj=univNestedJet[ss,pp,mm,kk,nn,ray],qp,mat,dd,mu0={ss+pp-mm,ss+pp-mm-kk,mm+kk,mm},ord=4(ss+pp)-8 mm-2 kk+8},If[jj[\"failure\"]=!=None,Return[jj]];qp=univNestedLift[jj[\"Q\"],1+eps ray];qp=Normal[Series[#,{eps,0,nn-mm-kk}]]&/@qp;mat=jetSPMat[ss,pp,ray,qp];dd=jetDet[mat,ord+2];<|\"jet\"->jj,\"q\"->qp,\"series\"->dd,\"coefficient\"->Factor[Coefficient[Normal[dd],eps,ord]/univCand[ray,mu0]],\"lower\"->Table[Coefficient[Normal[dd],eps,r],{r,0,ord-1}]|>];\nunivFullBaxJetCheck[ss_,pp_,mu0_List,qp_List,nn_,ray_List] := Module[{tr,eq,eqs,so,t0,gap=mu0[[1]]-mu0[[2]]},t0=UntwSolve[ss,pp,mu0][\"tc0\"];tr=Table[tc[j]->t0[[j]]+Sum[eps^r ubt[j,r],{r,nn+gap}],{j,5}];eq=Join[Table[Cancel[BaxRes[ss,pp,mu0][j][Function[y,Evaluate[qp[[j]]/.x->y]]][x]/(ν1[ss,pp][x-2 h]ν1[ss,pp][x-3 h])],{j,2}],Table[d2DualRes[ss,pp,mu0][{4,3}[[j-2]]][Function[y,Evaluate[qp[[j]]/.x->y]]][x],{j,3,4}]];eq=Expand[Normal[Series[(eps^gap eq/.prm/.tr/.Table[z[j]->1+eps ray[[j]],{j,4}]),{eps,0,nn+gap}]]];eqs=DeleteCases[Flatten[Table[CoefficientList[Coefficient[eq,eps,r],x],{r,0,nn+gap}]],0];so=Quiet[Solve[Thread[eqs==0],DeleteDuplicates[Cases[Variables[eqs],_ubt]]],Solve::svars];<|\"solutions\"->Length[so],\"residual\"->If[so==={},Missing[\"Inconsistent\"],Union[Flatten[Simplify[eqs/.First[so]]]]]|>];\nunivM1K1Norm32=univNestedNorm[3,2,1,1,6,{3,1,-1,-3}];\nunivM1K1Bax32=univFullBaxJetCheck[3,2,{4,3,2,1},univM1K1Norm32[\"q\"],2,{3,1,-1,-3}];\nGrid[{{\"d=3 norm ratio\",Factor[univM1K1Norm32[\"coefficient\"]/univVacScalar[3,2]]},{\"lower coefficients\",Union[univM1K1Norm32[\"lower\"]]},{\"full Baxter solutions\",univM1K1Bax32[\"solutions\"]},{\"full Baxter residual\",univM1K1Bax32[\"residual\"]}},Frame->All]",
   "languageId": "wolfram",
   "outputs": [
    {
