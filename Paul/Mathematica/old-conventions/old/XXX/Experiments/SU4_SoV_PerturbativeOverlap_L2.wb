  {
   "kind": 2,
   "value": "ClearAll[balEndpoint, balQCandidate, balVacK];\nbalVacK[S_, P_] := With[{tt = (θ1 - θ2)/h /. prm}, 1/(S! P! Product[tt + kk, {kk, -P, S}])^4];\nbalEndpoint[S_, P_, mm_] := Module[{mu = {S + P - mm, S + P - mm, mm, mm}, pp, ww, tops = {θ1 + S h, θ2 + P h} /. prm}, pp = qpoly[#, x] & /@ Take[UntwSolve[S, P, mu][\"P\"], 2]; ww = Expand[-(pp[[1]] (pp[[2]] /. x -> x - 1) - (pp[[1]] /. x -> x - 1) pp[[2]])]; {Times @@ ((pp[[1]] /. x -> #) & /@ tops), Times @@ ((ww /. x -> #) & /@ tops)}];\nbalQCandidate[S_, P_, mm_] := With[{pq = balEndpoint[S, P, mm], nn = S + P - 2 mm}, mm! (mm + 1)!^3 Pochhammer[nn + 3, mm]^3 Pochhammer[nn + 4, mm] pq[[2]]^3/pq[[1]]^2];\nbalW2 = Factor[-(balSeed2[\"P\"][[1]] (balSeed2[\"P\"][[2]] /. x -> x - 1) - (balSeed2[\"P\"][[1]] /. x -> x - 1) balSeed2[\"P\"][[2]])];\nbalQPref2 = Factor[balNorm2Closed ((balSeed2[\"P\"][[1]] /. x -> exS + exT) (balSeed2[\"P\"][[1]] /. x -> exP))^2/((balW2 /. x -> exS + exT) (balW2 /. x -> exP))^3];\nbalHigherTests = Table[TimeConstrained[With[{S = sp[[1]], P = sp[[2]], mm = sp[[3]]}, {sp, Factor[Det[balancedQMat[S, P, mm]]/balVacK[S, P] - balQCandidate[S, P, mm]]}], 40, $Aborted], {sp, {{2, 2, 2}, {3, 2, 2}, {3, 3, 2}, {3, 3, 3}, {4, 3, 3}}}];\nGrid[Join[{{\"d=4 general Q-function prefactor\", balQPref2}, {\"S,P,m\", \"Exact candidate residual\"}}, balHigherTests], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
