  {
   "kind": 2,
   "value": "ClearAll[univSl2PairNorm];\nunivSl2PairNorm[ss_,pp_,kk_] := Module[{v,q0,hh=h/.prm,wx,poles,h0},v=qpoly[UntwSolve[ss,pp,{ss+pp,ss+pp-kk,kk,0}][\"P\"][[2]],u];q0=Expand[(v-(v/.u->u-hh))/((kk+1)hh)];poles=Table[(θ2+j h)/.prm,{j,0,pp}];wx=wE1[ss,pp,#]&/@poles;h0=Total[wx];Factor[Total[MapThread[#1(q0/.u->#2)^2&,{wx,poles}]]/h0]];\nunivK2RayCheck=univSl2Norm[2,2,2,6,{4,1,-2,-3}];\nunivSl2Cases={{1,1,1},{2,1,1},{2,2,2},{3,2,2},{3,3,3}};\nunivSl2Data=Table[With[{rr=univSl2Norm@@Append[Append[cc,8],{3,1,-1,-3}]},Join[cc,{Factor[rr[\"coefficient\"]/univVacScalar@@Take[cc,2]],Factor[(rr[\"coefficient\"]/univVacScalar@@Take[cc,2])/(univSl2PairNorm@@cc)^3]}]],{cc,univSl2Cases}];\nGrid[Join[{{\"second ray and order-6 jet residual\",Factor[univK2RayCheck[\"coefficient\"]-univK2Norm[\"coefficient\"]]}},{{\"S,P,k; norm/vac; ratio to cubic Q12 pairing\",Grid[univSl2Data,Frame->All]}}],Frame->All]",
   "languageId": "wolfram",
