  {
   "kind": 2,
   "value": "ClearAll[univHahnSeed, univHahnPrimitive, uhs, uhp, univHahnMoment, univHahnTensor];\nunivHahnSeed[kk_Integer?NonNegative] := univHahnSeed[kk] = Module[{qq=x^kk+Sum[uhs[j] x^j,{j,0,kk-1}],aa=(x-exT-exS)(x-exP),dd=(x-exT)x,tt,eq,so},tt=2 x^2-(2 exT+exS+exP)x+exP(exT+exS)+kk(kk-exS-exP-1);eq=CoefficientList[Expand[tt qq-aa(qq/.x->x+1)-dd(qq/.x->x-1)],x];so=Solve[Thread[eq==0],Table[uhs[j],{j,0,kk-1}]];Factor[qq/.First[so]]];\nunivHahnPrimitive[kk_Integer?NonNegative] := univHahnPrimitive[kk] = Module[{vv=x^(kk+1)+Sum[uhp[j]x^j,{j,1,kk}],eq,so},eq=CoefficientList[Expand[vv-(vv/.x->x-1)-(kk+1)univHahnSeed[kk]],x];so=Solve[Thread[eq==0],Table[uhp[j],{j,1,kk}]];Factor[vv/.First[so]]];\nunivHahnMoment[pol_,ss_Integer,pp_Integer] := Module[{co=CoefficientList[Expand[pol],x]},Factor[Sum[co[[j+1]] Sum[StirlingS2[j,r] FactorialPower[pp,r] FactorialPower[ss+exT,r]/FactorialPower[ss+pp,r],{r,0,Min[j,pp]}],{j,0,Length[co]-1}]]];\nunivHahnTensor[ss_Integer,pp_Integer,kk_Integer] := Module[{v=univHahnPrimitive[kk]/.{exS->ss,exP->pp},vd,ps,ds},vd=Expand[(v/.x->x-1)-(v/.x->-1)];ps={1,v};ds={1,vd};Table[univHahnMoment[x^col[[3]](ps[[i]]/.x->x-col[[2]])(ds[[a]]/.x->x+col[[1]]),ss,pp],{i,2},{a,2},{col,Tuples[{{0,1},{0,1},{0,1}}]}]];\nunivHahnChecks=Table[With[{vv=univHahnPrimitive[kk]/.{exS->3,exP->3,exT->((θ1-θ2)/h/.prm)},old=qpoly[UntwSolve[3,3,{6,6-kk,kk,0}][\"P\"][[2]],x]},Expand[(vv/.x->x-(θ2/.prm))-(vv/.x->-(θ2/.prm))-old]],{kk,0,3}];\nGrid[{{\"Hahn primitive versus original untwisted Baxter solutions\",univHahnChecks},{\"cubic pairing prefactor candidate\",\"L!^3 (L-2k+1)^2 / [k!^2 (L-2k)! (L-k+1)!^2]\"}},Frame->All]",
   "languageId": "wolfram",
   "outputs": [
