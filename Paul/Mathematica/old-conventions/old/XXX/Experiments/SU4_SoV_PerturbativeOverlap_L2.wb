      {
       "data": "Out[65]= \\begin{array}{|c|c|}\\hline\\text{unbalanced d=2 reduced TQ jet} & \\begin{pmatrix}1 & 3 & 3 & 3\\\\2 & 3 & 3 & 3\\\\3 & 3 & 3 & 3\\\\4 & 3 & 3 & 3\\\\5 & 3 & 3 & 3\\\\6 & 3 & 3 & 3\\\\7 & 3 & 3 & 3\\\\8 & 3 & 3 & 3\\end{pmatrix}\\\\\\hline\\text{failure} & \\mathrm{None}\\\\\\hline\\text{leading Laurent coefficients} & \\left\\{\\frac{1}{2},\\frac{1}{2}\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
