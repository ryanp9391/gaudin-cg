  {
   "kind": 2,
   "value": "ClearAll[univNestedSeed,univNestedShiftResidual];\nunivNestedSeed[ss_,pp_,mm_,kk_] := Module[{mu0={ss+pp-mm,ss+pp-mm-kk,mm+kk,mm},ps,pd,q12},ps=qpoly[#,x]&/@Take[UntwSolve[ss,pp,mu0][\"P\"],2];pd=qpoly[UntwSolveD[ss,pp,mu0][\"Pd\"][[1]],x];q12=Expand[(ps[[1]](ps[[2]]/.x->x-1)-(ps[[1]]/.x->x-1)ps[[2]])/(-(kk+1))];{ps[[1]],q12,pd}];\nunivNestedStates={{3,2,1,0},{3,2,1,1},{3,2,2,0},{4,3,2,1}};\nunivNestedSeeds=(univNestedSeed@@#&)/@univNestedStates;\nunivWingChecks=Table[With[{a=seed[[1]],b=seed[[2]],c=seed[[3]]},{PolynomialRemainder[Expand[(a/.x->x+1)b+(a/.x->x-1)(b/.x->x+1)],a,x],PolynomialRemainder[Expand[(c/.x->x+1)(b/.x->x-1)+(c/.x->x-1)b],c,x]}],{seed,univNestedSeeds}];\nunivNestedShiftResidual[seed_,st_,sh_] := With[{a=seed[[1]],b=seed[[2]],c=seed[[3]],aa=((x-θ1-st[[1]])(x-θ2-st[[2]]))/.prm,dd=((x-θ1)(x-θ2))/.prm},PolynomialRemainder[Expand[aa(b/.x->x+1)(a/.x->x+sh[[1]])(c/.x->x+sh[[2]])+dd(b/.x->x-1)(a/.x->x+sh[[3]])(c/.x->x+sh[[4]])],b,x]];\nunivMiddleShifts=Select[Tuples[{-1,0,1},4],Function[sh,And@@MapThread[univNestedShiftResidual[#1,#2,sh]===0&,{univNestedSeeds,univNestedStates}]]];\nGrid[{{\"wing QQ residuals\",univWingChecks},{\"middle shifts surviving all four states\",univMiddleShifts}},Frame->All]",
   "languageId": "wolfram",
   "outputs": [
