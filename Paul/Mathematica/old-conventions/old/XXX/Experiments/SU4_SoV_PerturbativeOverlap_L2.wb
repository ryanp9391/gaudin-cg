   "kind": 2,
   "value": "ClearAll[exVacSymbolic, exT];\nexVacSymbolic[S_, P_] := Block[{prm = {θ1 -> exT, θ2 -> 0, h -> 1}}, TimeConstrained[exVacLead[S, P, {3, 1, -1, -3}], 40, $Aborted]];\nexVs11 = exVacSymbolic[1, 1];\n{exVs11[\"order\"], Factor[exVs11[\"coefficient\"]], Factor[exVs11[\"coefficient\"] /. exT -> 4/21] == exV11[\"coefficient\"]}",
