  {
   "kind": 2,
   "value": "ClearAll[jetSPMat, jetDet];\njetSPMat[S_, P_, ps_List, qp_List] := Module[{rows, cols, zs = 1 + eps ps}, rows = Flatten[Table[{al, i, a}, {al, 2}, {i, 2}, {a, 2}], 2]; cols = Tuples[{{0, 1}, {0, 1}, {0, 1}}]; Outer[Function[{rr, cc}, With[{al = rr[[1]], i = rr[[2]], a = rr[[3]], j = {4, 3}[[rr[[3]]]], sg = cc[[1]], tt = cc[[2]], be = cc[[3]]}, Together[Sum[With[{p = ({θ1, θ2}[[al]] + nn h) /. prm}, wE1[S, P, p] If[be == 0, 1, p] (zs[[i]]/zs[[j]])^nn zs[[j]]^-sg zs[[i]]^-tt (qp[[i]] /. x -> p - tt (h /. prm)) (qp[[a + 2]] /. x -> p + sg (h /. prm))], {nn, 0, {S, P}[[al]]}]]]], rows, cols, 1]];\njetDet[mat_, nn_] := Module[{aa = Map[Series[#, {eps, 0, nn}] &, mat, {2}], prod = 1, piv, kk, mm, jj, v}, Do[piv = SelectFirst[Range[kk, Length[aa]], Normal[aa[[#, kk]]] =!= 0 &, Missing[\"no pivot\"]]; If[MissingQ[piv], Return[<|\"failure\" -> \"no pivot\", \"column\" -> kk|>]]; If[piv != kk, aa[[{kk, piv}]] = aa[[{piv, kk}]]; prod = -prod]; v = aa[[kk, kk]]; prod *= v; Do[aa[[mm, jj]] -= aa[[mm, kk]] aa[[kk, jj]]/v, {mm, kk + 1, Length[aa]}, {jj, kk + 1, Length[aa]}], {kk, Length[aa]}]; prod];\n\nClearAll[univCand,univSl2Norm,univVacScalar];\nunivCand[ps_,mm_] := (ps[[1]]-ps[[2]])^4(ps[[3]]-ps[[4]])^4 Product[(ps[[i]]-ps[[j]])^(mm[[i]]-mm[[j]]),{i,4},{j,i+1,4}];\nunivVacScalar[ss_,pp_] := 1/(ss! pp! Product[((θ1-θ2)/h/.prm)+k,{k,-pp,ss}])^4;\nunivSl2Norm[ss_,pp_,kk_,nn_,ray_List] := Module[{jj=univSl2Jet[ss,pp,kk,nn,ray],qp,mat,dd,mu0={ss+pp,ss+pp-kk,kk,0},ord=4(ss+pp)-2 kk+8},If[jj[\"failure\"]=!=None,Return[jj]];qp=univLiftQ[jj[\"Q\"],1+eps ray];mat=jetSPMat[ss,pp,ray,qp];dd=jetDet[mat,ord+2];<|\"jet\"->jj,\"series\"->dd,\"coefficient\"->Factor[Coefficient[Normal[dd],eps,ord]/univCand[ray,mu0]],\"lower\"->Table[Coefficient[Normal[dd],eps,k],{k,0,ord-1}]|>];\nunivK2Norm=TimeConstrained[univSl2Norm[2,2,2,8,{3,1,-1,-3}],50,$Aborted];\nGrid[{{\"unbalanced d=2 norm ratio\",If[AssociationQ[univK2Norm],Factor[univK2Norm[\"coefficient\"]/univVacScalar[2,2]],univK2Norm]},{\"lower determinant coefficients\",If[AssociationQ[univK2Norm],Union[univK2Norm[\"lower\"]],Missing[\"NotComputed\"]]}},Frame->All]",
   "languageId": "wolfram",
   "outputs": [
