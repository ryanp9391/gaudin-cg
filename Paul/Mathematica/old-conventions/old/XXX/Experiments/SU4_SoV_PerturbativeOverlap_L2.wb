  {
   "kind": 2,
   "value": "ClearAll[univNestedResidual,univNestedJet,unj,univNestedLift];\nunivNestedResidual[ss_,pp_,qs_List,zz_List] := Module[{a=qs[[1]],b=qs[[2]],c=qs[[3]],aa=((x-θ1-ss h)(x-θ2-pp h))/.prm,dd=((x-θ1)(x-θ2))/.prm,hh=h/.prm},Join[Take[PadRight[CoefficientList[PolynomialRemainder[Expand[zz[[1]](a/.x->x+hh)b+zz[[2]](a/.x->x-hh)(b/.x->x+hh)],a,x],x],Exponent[a,x]],Exponent[a,x]],Take[PadRight[CoefficientList[PolynomialRemainder[Expand[zz[[2]]aa(b/.x->x+hh)(a/.x->x-hh)c+zz[[3]]dd(b/.x->x-hh)a(c/.x->x+hh)],b,x],x],Exponent[b,x]],Exponent[b,x]],Take[PadRight[CoefficientList[PolynomialRemainder[Expand[zz[[3]](c/.x->x+hh)(b/.x->x-hh)+zz[[4]](c/.x->x-hh)b],c,x],x],Exponent[c,x]],Exponent[c,x]]]];\nunivNestedJet[ss_,pp_,mm_,kk_,nn_,ray_List] := Module[{seed=univNestedSeed[ss,pp,mm,kk],deg={mm,2 mm+kk,mm},vars,trial,jac,acc,eq,cor,rep={},rr,offset},vars=Table[unj[j],{j,4 mm+kk}];offset=Most[FoldList[Plus,0,deg]];trial=Table[seed[[j]]+Sum[vars[[offset[[j]]+c+1]]x^c,{c,0,deg[[j]]-1}],{j,3}];jac=Table[D[univNestedResidual[ss,pp,trial,{1,1,1,1}],va]/.Thread[vars->0],{va,vars}]//Transpose;If[MatrixRank[jac]<Length[vars],Return[<|\"failure\"->\"singular nested Jacobian\"|>]];acc=seed;Do[eq=Expand[Coefficient[univNestedResidual[ss,pp,acc,1+eps ray],eps,rr]];cor=LinearSolve[jac,-eq];acc=Table[Expand[acc[[j]]+eps^rr Sum[cor[[offset[[j]]+c+1]]x^c,{c,0,deg[[j]]-1}]],{j,3}];AppendTo[rep,{rr,Length[cor],Union[Expand[jac.cor+eq]]}],{rr,nn}];<|\"failure\"->None,\"Q\"->acc,\"report\"->rep|>];\nunivNestedLift[qs_List,zz_List] := Module[{a=qs[[1]],b=qs[[2]],c=qs[[3]],mm,dd,qr,ql,rr,res,hh=h/.prm},mm=Exponent[a,x];dd=Exponent[b,x]-mm;qr=x^dd;ql=x^dd;Do[res=Expand[zz[[1]]a(qr/.x->x-hh)-zz[[2]](a/.x->x-hh)qr-(zz[[1]]-zz[[2]])b];qr=Expand[qr-Cancel[Coefficient[res,x,mm+rr]/(zz[[1]]-zz[[2]])]x^rr];res=Expand[zz[[3]]ql(c/.x->x+hh)-zz[[4]](ql/.x->x+hh)c-(zz[[3]]-zz[[4]])b];ql=Expand[ql-Cancel[Coefficient[res,x,mm+rr]/(zz[[3]]-zz[[4]])]x^rr],{rr,dd-1,0,-1}];{a,qr,c,ql}];\nunivM1K1Jet=TimeConstrained[univNestedJet[2,2,1,1,4,{3,1,-1,-3}],45,$Aborted];\nGrid[{{\"both labels nonzero: nested jet\",If[AssociationQ[univM1K1Jet],Lookup[univM1K1Jet,\"report\",univM1K1Jet[\"failure\"]],univM1K1Jet]}},Frame->All]",
   "languageId": "wolfram",
