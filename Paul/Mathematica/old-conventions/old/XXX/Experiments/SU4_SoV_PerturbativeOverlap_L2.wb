  {
   "kind": 2,
   "value": "ClearAll[univTarget, univHMinor];\nunivTarget[ss_, pp_, mm_] := Which[mm[[1]] == mm[[2]], Det[balancedQMat[ss,pp,mm[[4]]]], mm == {ss+pp,ss+pp-1,1,0}, balVacK[ss,pp] (ss pp)^3/(ss+pp)^5 (((ss+(θ1-θ2)/h) (pp-(θ1-θ2)/h))^3 /. prm), True, Missing[\"NoIndependentTarget\"]];\nunivHMinor[ten_, be_] := Det[Flatten[ten[[2,1;;2,1;;2,If[be==0,{1,3,5,7},{2,4,6,8}]]],1]];\nunivMinorData = MapThread[Function[{state,ten},With[{target=univTarget@@state}, {state,Factor[univHMinor[ten,0]],If[univHMinor[ten,0]===0,Missing[\"ZeroMinor\"],Factor[target/univHMinor[ten,0]]],If[univHMinor[ten,0]===0,Missing[\"ZeroMinor\"],Factor[univHMinor[ten,1]/univHMinor[ten,0]]]}]],{univInitialStates,univInitialTensors}];\nGrid[Prepend[univMinorData,{\"state\",\"H shift minor beta=0\",\"N without phase / minor\",\"beta=1 minor / beta=0 minor\"}],Frame->All]",
   "languageId": "wolfram",
   "outputs": [
    {
