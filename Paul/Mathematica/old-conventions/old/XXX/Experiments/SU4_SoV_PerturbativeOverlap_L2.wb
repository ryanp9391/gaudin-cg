      {
       "data": "Out[46]= \\begin{aligned}\n  &\\left\\{\\text{E1 ladder at (1,1)} \\right. \\\\\n  &\\left. \\to \\left\\{\\frac{1}{3},\\frac{4}{3},\\frac{1}{7},\\frac{8}{7}\\right\\} \\right. \\\\\n  &\\left. ,\\text{functional kills u\\^{}2} \\right. \\\\\n  &\\left. \\to \\mathrm{True}\\right\\}\n\\end{aligned}",
