  {
   "kind": 2,
   "value": "ClearAll[exGeneralEq, exGeneralSol, exBg, exCg, exRg, exS, exP];\nexGeneralEq = Table[CoefficientList[Cancel[BaxRes[exS, exP, {exS + exP, exS + exP - 1, 1, 0}][kk][If[kk == 1, Function[y, 1], Function[y, y + exBg]]][x]/(ν1[exS, exP][x - 2 h] ν1[exS, exP][x - 3 h])], x], {kk, 2}];\nexGeneralSol = TimeConstrained[Module[{s1, eq2, s2}, s1 = First[Quiet[Solve[Thread[exGeneralEq[[1]] == 0], tcvars], Solve::svars]]; eq2 = DeleteCases[Factor /@ (exGeneralEq[[2]] /. s1), 0]; s2 = Solve[Thread[eq2 == 0], {tc[1], tc[2], exBg}]; {s1, s2}], 40, $Aborted];\n{Head[exGeneralSol], If[ListQ[exGeneralSol], Length[exGeneralSol[[2]]], 0]}",
   "languageId": "wolfram",
   "outputs": [
