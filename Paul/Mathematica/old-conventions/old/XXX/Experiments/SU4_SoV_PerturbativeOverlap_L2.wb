  {
   "kind": 2,
   "value": "univHahnTables10=Table[univHahnTensor[10,10,kk],{kk,0,8}];\nunivHahnTargets10=Table[univSl2Pref[20,kk] univHahnMoment[(univHahnSeed[kk]/.{exS->10,exP->10})^2,10,10]^3,{kk,0,8}];\nunivQuarticAll10=univQuarticScan[univHahnTables10,univHahnTargets10,Range[Length[univQuarticIndices]]];\nGrid[{{\"S=P=10, k=0,...,8\",Length[univHahnTables10]},{\"weighted quartic rank\",univQuarticAll10[\"rank\"]},{\"augmented rank\",univQuarticAll10[\"augmented rank\"]},{\"status\",\"Conditional on the cubic-pairing target; all total-functional entries vanish in these cases\"}},Frame->All]",
