  {
   "kind": 2,
   "value": "ClearAll[univQuarticIndices,univQuarticValues,univSl2Pref];\nunivQuarticIndices = Join[Flatten[Table[Prepend[tri,j],{j,1,8},{tri,Select[Tuples[Range[25,32],3],OrderedQ]}],1],Flatten[Table[Join[{j,k},pair],{j,9,16},{k,17,24},{pair,Select[Tuples[Range[25,32],2],OrderedQ]}],2]];\nunivQuarticValues[vec_] := (Times@@vec[[#]]&)/@univQuarticIndices;\nunivSl2Pref[ll_,kk_] := ll!^3(ll-2 kk+1)^2/(kk!^2(ll-2 kk)! (ll-kk+1)!^2);\nunivHahnTables=Table[univHahnTensor[6,6,kk],{kk,0,4}];\nunivQuarticBeta2=Select[Range[Length[univQuarticIndices]],Total[Mod[univQuarticIndices[[#]]+1,2]]==2&];\nGrid[{{\"quartic monomials with the required Q multiplicities\",Length[univQuarticIndices]},{\"total beta=2 subspace\",Length[univQuarticBeta2]},{\"states with zero total-functional block\",\"S=P=6; mu=(12,12-k,k,0), k=0,...,4\"},{\"maximum t degrees of pairing variables\",Table[Max[Exponent[Flatten[univHahnTables[[j]]],exT]],{j,5}]}},Frame->All]",
