  {
   "kind": 2,
   "value": "(* h-homogeneity of each allowed pairing and of the requested monic norm. *)\nClearAll[univScaleB, univScaleN];\nunivScaleB[ii_,aa_,be_] := mu[5-aa]-mu[ii]+ii+aa+be-3;\nunivScaleN = 4-mu[1]-3 mu[2]+3 mu[3]+mu[4];\nunivMinimalWeightCheck = Expand[univScaleB[1,1,0]+univScaleB[2,2,0]+2 univScaleB[2,2,1]-univScaleN];\nGrid[{{\"pairing h-weight\",univScaleB[ii,aa,be]},{\"norm h-weight\",univScaleN},{\"degree-four weight residual\",univMinimalWeightCheck},{\"required direct multiplicities at degree four\",{1,3,0,0}},{\"required dual multiplicities in ascending degree\",{1,3,0,0}}},Frame->All]",
