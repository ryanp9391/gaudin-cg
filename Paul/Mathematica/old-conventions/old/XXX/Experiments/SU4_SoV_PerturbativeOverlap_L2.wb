      {
       "data": "Out[35]= \\begin{aligned}\n  &\\left\\{\\text{shifts in Bax[0][f]} \\right. \\\\\n  &\\left. \\to \\left\\{u-3 \\right. \\right. \\\\\n  &\\left. \\left. ,u-2,u-1 \\right. \\right. \\\\\n  &\\left. \\left. ,u,u+1\\right\\} \\right. \\\\\n  &\\left. ,\\text{Bax[0] kills every untwisted P\\_k} \\right. \\\\\n  &\\left. \\to \\right. \\\\\n  &\\left. \\left\\{\\mathrm{True},\\mathrm{True} \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{True},\\mathrm{True}\\right\\}\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
     ],
