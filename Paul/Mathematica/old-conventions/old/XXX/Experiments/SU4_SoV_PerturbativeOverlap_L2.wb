      {
       "data": "Out[86]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{(S,P)} & \\text{mu} & \\text{M} & \\text{order of det} & \\text{Sum(mu\\_i-mu\\_j)} & \\text{difference}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,2,0,0\\right\\} & \\left\\{0,0,2,2\\right\\} & 16.\\, & 8 & 8.\\,\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,1,1,0\\right\\} & \\left\\{0,1,1,2\\right\\} & 14.\\, & 6 & 8.\\,\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{1,1,1,1\\right\\} & \\left\\{1,1,1,1\\right\\} & 8.\\, & 0 & 8.\\,\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,3,0,0\\right\\} & \\left\\{0,0,3,3\\right\\} & 20.\\, & 12 & 8.\\,\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,2,1,0\\right\\} & \\left\\{0,1,2,3\\right\\} & 18.\\, & 10 & 8.\\,\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{2,2,1,1\\right\\} & \\left\\{1,1,2,2\\right\\} & 12.\\, & 4 & 8.\\,\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{4,4,0,0\\right\\} & \\left\\{0,0,4,4\\right\\} & 24.\\, & 16 & 8.\\,\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{4,3,1,0\\right\\} & \\left\\{0,1,3,4\\right\\} & 22.\\, & 14 & 8.\\,\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{2,2,2,2\\right\\} & \\left\\{2,2,2,2\\right\\} & 8.\\, & 0 & 8.\\,\\\\\\hline\\end{array}",
