   "kind": 2,
   "value": "ClearAll[exVacFormula, exVacIdentityCheck];\nexVacFormula[S_, P_] := With[{tt = (θ1 - θ2)/h /. prm, hh = h /. prm}, (Exp[2 Pi I (θ2/h /. prm)] - Exp[2 Pi I (θ1/h /. prm)])^4 hh^(4 - 4 (S + P))/(S! P! Product[tt + kk, {kk, -P, S}])^4];\nexVacIdentityCheck[S_, P_, zs_List] := Module[{mat, p1 = (θ1 + S h) /. prm, p2 = (θ2 + P h) /. prm, kval}, mat = exVacMat[S, P, zs - 1] /. eps -> 1; kval = ((p2 - p1) wE1[S, P, p1] wE1[S, P, p2])^4; Factor[Det[mat] - kval cand[zs, {S + P, S + P, 0, 0}]/((zs[[1]] zs[[2]])^4 (zs[[3]] zs[[4]])^(2 (S + P) + 4))] == 0];\nexVacIdentityTests = {exVacIdentityCheck[1, 1, {2, 3, 5, 7}], exVacIdentityCheck[2, 2, {3/2, 5/4, 7/3, 4/3}], Block[{prm = {θ1 -> 1/3, θ2 -> 1/7, h -> 2/3}}, exVacIdentityCheck[2, 1, {2, 3, 5, 7}]]};\nexRayCheck = exD1Lead[2, 2, psiA][\"coefficient\"] == exD1Lead[2, 2, {3, 1, -1, -3}][\"coefficient\"];\n{exVacIdentityTests, exRayCheck, N[exVacFormula[1, 1], 30]}",
   "languageId": "wolfram",
   "outputs": [
