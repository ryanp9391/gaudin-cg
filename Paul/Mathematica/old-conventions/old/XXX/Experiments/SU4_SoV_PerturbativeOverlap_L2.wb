      {
       "data": "Out[39]= \\begin{array}{|c|c|}\\hline\\text{d=4 symbolic ratio to vacuum} & \\frac{432\\,\\left(\\mathrm{exP}-1\\right)^3\\,\\mathrm{exP}^4\\,\\left(\\mathrm{exP}+1\\right)\\,\\left(\\mathrm{exS}-1\\right)^3\\,\\mathrm{exS}^4\\,\\left(\\mathrm{exS}+1\\right)\\,\\left(\\mathrm{exP}-\\mathrm{exT}-1\\right)^3\\,\\left(\\mathrm{exP}-\\mathrm{exT}\\right)^4\\,\\left(\\mathrm{exP}-\\mathrm{exT}+1\\right)\\,\\left(\\mathrm{exS}+\\mathrm{exT}-1\\right)^3\\,\\left(\\mathrm{exS}+\\mathrm{exT}\\right)^4\\,\\left(\\mathrm{exS}+\\mathrm{exT}+1\\right)}{\\left(\\mathrm{exP}+\\mathrm{exS}-1\\right)^3\\,\\left(\\mathrm{exP}+\\mathrm{exS}\\right)^4\\,\\left(\\mathrm{exP}+\\mathrm{exS}+1\\right)}\\\\\\hline\\end{array}",
