   "kind": 2,
   "value": "exOnShellTable = Table[With[{S = sp[[1]], P = sp[[2]]}, Module[{aa = exD1OnShell[sp[[1]], sp[[2]], True], vv = 1/(S! P! Product[exT + kk, {kk, -P, S}])^4}, {sp, Factor[aa/vv], Factor[aa/vv - (S P)^3/(S + P)^5 ((S + exT) (P - exT))^3] == 0}]], {sp, {{1, 1}, {2, 1}, {2, 2}, {3, 1}, {3, 2}, {4, 1}}}];\nexOnShellTable",
