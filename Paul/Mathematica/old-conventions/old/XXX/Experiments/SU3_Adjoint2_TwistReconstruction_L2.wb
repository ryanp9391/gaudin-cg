      {
       "data": "Out[92]= \\begin{array}{|c|c|}\\hline\\text{[3,0,0]\\^{}2, dim} & 100\\\\\\hline\\text{dim W\\^{}perp with one companion insertion} & 37\\\\\\hline\\mathbf{\\text{(i) rank with k <= 1, 2, 3 insertions}} & \\mathbf{\\left\\{63,90,100\\right\\}}\\\\\\hline\\text{    rule predicts (lam\\_1 >= 6-k)} & \\left\\{63,90,100\\right\\}\\\\\\hline\\text{(ii) general non-companion twist reaches anything new} & \\mathrm{False}\\\\\\hline\\text{(iii) null-space dims of the 6 polarized vacua} & \\left\\{1,1,1,1,1,1\\right\\}\\\\\\hline\\text{(iii) other polarized vacua reach anything new} & \\mathrm{False}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
