      {
       "data": "Out[68]= \\begin{array}{|c|c|}\\hline\\text{reps} & \\begin{pmatrix}2 & 1 & 0\\\\2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{dim} & 64\\\\\\hline\\text{nTwists} & 14\\\\\\hline\\text{omegaDim} & \\left\\{1\\right\\}\\\\\\hline\\text{eigFreshU} & \\mathrm{True}\\\\\\hline\\text{perWrank} & \\left\\{9\\right\\}\\\\\\hline\\text{rankModP} & 63\\\\\\hline\\text{rankExact} & 63\\\\\\hline\\text{dimWperp} & 1\\\\\\hline\\text{nSinglets} & 1\\\\\\hline\\text{nullDim} & 1\\\\\\hline\\text{nullInsideSingletSpace} & \\mathrm{True}\\\\\\hline\\end{array}",
