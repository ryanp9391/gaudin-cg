  {
   "kind": 2,
   "value": "(* ---- 9b. Rep-generic operator span, vacuum eigenvalue and vacuum covector. ---- *)\nClearAll[opG, tauG, vacEG, omegaG, tagsG, uPQ];\n(* the u-points used by every rep-generic run below; 3 for tau_1 (degree 2), 5 for tau_2 (degree 4) *)\nuPQ = {{7/5, -3/2, 11/4}, {7/5, -3/2, 11/4, 2/9, -5/7}};\nopG[lA_, lB_, tA_, tB_][a_, m_][y_] := opG[lA, lB, tA, tB][a, m][y] = SparseArray @ Sum[\n   coeffKI[m, K, II] qmG[lA, lB, tA, tB][II, K][y], {II, subsetsA[a]}, {K, subsetsA[a]}];\ntauG[lA_, lB_, tA_, tB_][a_, ch_List][y_] := Sum[(Times @@ (ch^m)) opG[lA, lB, tA, tB][a, m][y], {m, monoms[a]}];\nvacEG[lA_, lB_, tA_, tB_][a_, w_List][y_] := Sum[(Times @@ w[[II]]) kapG[lA, lB, tA, tB][II][y], {II, subsetsA[a]}];\ntagsG[uP_List] := Prepend[Flatten[Table[{a, m, y}, {a, {1, 2}}, {m, monoms[a]}, {y, uP[[a]]}], 2], {0, {0, 0, 0}, 0}];\n(* <Om(w)| from ONE generic prime-weighted combination; dimension and eigenvector property are checked below *)\nomegaG[lA_, lB_, tA_, tB_, uP_List][w_List] := Module[{ch = chiOf[w], d = repDim[lA, lB], X},\n   X = Sum[Prime[10 + 7 a + 3 p] (Normal[tauG[lA, lB, tA, tB][a, ch][uP[[a]][[p]]]]\n        - vacEG[lA, lB, tA, tB][a, w][uP[[a]][[p]]] IdentityMatrix[d]),\n      {a, {1, 2}}, {p, Length[uP[[a]]]}];\n   NullSpace[Transpose[X]]];\n\n(* the generic path must be a genuine left eigenvector at a u-point outside its own construction *)\nModule[{lA = {2, 1, 0}, om, w = {2, 3, 1/6}},\n om = First @ omegaG[lA, lA, 1/3, -8/57, uPQ][w];\n Grid[{{\"tag count\", Length[tagsG[uPQ]]},\n       {\"generic-path <Om| is a left eigenvector at a fresh u\",\n        om.Normal[tauG[lA, lA, 1/3, -8/57][1, chiOf[w]][19/11]] === vacEG[lA, lA, 1/3, -8/57][1, w][19/11] om}},\n  Frame -> All, Alignment -> Left]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"773602\" data-output-id=\"41\" data-out-n=\"72\" data-sub-idx=\"11\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"20\" data-sub-start=\"17\" data-sub-end=\"22\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[72]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-latex-b64=\"XGJlZ2lue2FycmF5fXt8Y3xjfH1caGxpbmVcdGV4dHt0YWcgY291bnR9ICYgMzNcXFxobGluZVx0ZXh0e2dlbmVyaWMtcGF0aCA8T218IGlzIGEgbGVmdCBlaWdlbnZlY3RvciBhdCBhIGZyZXNoIHV9ICYgXG1hdGhybXtUcnVlfVxcXGhsaW5lXGVuZHthcnJheX0=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:2.44em;vertical-align:-0.95em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.49em;\"><span style=\"top:-3.45em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:2.4em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.95em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">tag count</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">generic-path &lt;Om| is a left eigenvector at a fresh u</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:2.4em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.95em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">33</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:2.4em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.95em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
