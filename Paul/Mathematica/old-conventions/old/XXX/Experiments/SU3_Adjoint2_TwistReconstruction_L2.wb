  {
   "kind": 2,
   "value": "(* ---- 9c. analyse[...]: dim W and its null space for an arbitrary pair of site reps. ---- *)\nClearAll[analyse];\nanalyse[lA_, lB_, tA_, tB_, uA_List, uB_List, nTw_Integer, seed_Integer] := Module[\n  {d = repDim[lA, lB], uP = {uA, uB}, tg, opOf, wS, oms, omDim, rowsW, kpts, satC,\n   allRows, pp = 2147483647, rkP, rkQ, ns, singNS, perW, eigOK, freshU = {101/37, -57/23, 13/29}},\n  tg = tagsG[uP];\n  opOf[t_] := If[t[[1]] === 0, IdentityMatrix[d, SparseArray], opG[lA, lB, tA, tB][t[[1]], t[[2]]][t[[3]]]];\n  SeedRandom[seed];\n  wS = DeleteDuplicates @ Select[\n     Table[RandomSample[Range[-11, 11] /. 0 -> 12, 3] + {RandomInteger[{1, 5}]/3, RandomInteger[{1, 5}]/4, RandomInteger[{1, 5}]/7}, {nTw}],\n     (Length[Union[#]] == 3 && FreeQ[#, 0]) &];\n  oms = Association @ Table[w -> omegaG[lA, lB, tA, tB, uP][w], {w, wS}];\n  omDim = Union[Length /@ Values[oms]];\n  eigOK = And @@ Flatten @ Table[\n     With[{om = First[oms[w]]}, om.Normal[tauG[lA, lB, tA, tB][a, chiOf[w]][y]] === vacEG[lA, lB, tA, tB][a, w][y] om],\n     {w, Take[wS, UpTo[5]]}, {a, {1, 2}}, {y, freshU}];\n  rowsW[w_] := rowsW[w] = With[{om = First[oms[w]]}, prim /@ Table[om.Normal[opOf[t]], {t, tg}]];\n  perW = Union @ Table[MatrixRank[rowsW[w]], {w, Take[wS, UpTo[8]]}];\n  kpts = DeleteDuplicates @ Select[Join[Range[1, 8], {10, 12, 15, 20, 25, 30, 40, Length[wS]}], # <= Length[wS] &];\n  satC = Table[{k, MatrixRank[Join @@ (rowsW /@ Take[wS, k]), Modulus -> pp]}, {k, kpts}];\n  allRows = Join @@ (rowsW /@ wS);\n  rkP = Last[satC][[2]];\n  rkQ = MatrixRank[allRows];\n  ns = If[rkQ < d, NullSpace[allRows], {}];\n  singNS = NullSpace[Join @@ Flatten[Table[\n     If[i === j, Normal[EtG[lA, lB][i, i] - (Total[lA] + Total[lB])/3 IdentityMatrix[d]], Normal[EtG[lA, lB][i, j]]],\n     {i, 3}, {j, 3}], 1]];\n  <|\"reps\" -> {lA, lB}, \"dim\" -> d, \"nTwists\" -> Length[wS], \"omegaDim\" -> omDim,\n    \"eigFreshU\" -> eigOK, \"perWrank\" -> perW, \"satCurveModP\" -> satC,\n    \"rankModP\" -> rkP, \"rankExact\" -> rkQ, \"dimWperp\" -> d - rkQ,\n    \"nSinglets\" -> Length[singNS], \"nullDim\" -> Length[ns],\n    \"nullInsideSingletSpace\" -> If[Length[ns] == 0, \"n/a (full rank)\",\n      Length[singNS] > 0 && MatrixRank[Join[ns, singNS]] == MatrixRank[singNS]]|>];\n\n(* regression: the generic driver must reproduce dim W = 63 for adj (x) adj *)\nresAdj = analyse[{2, 1, 0}, {2, 1, 0}, 1/3, -8/57, {7/5, -3/2, 11/4}, {7/5, -3/2, 11/4, 2/9, -5/7}, 14, 20260919];\nGrid[List @@@ Normal[KeyDrop[resAdj, \"satCurveModP\"]], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
