       "data": "Out[17]= \\begin{array}{|c|c|}\\hline\\text{dims (site1, site2, total)} & \\left\\{8,8,64\\right\\}\\\\\\hline\\text{gl(3) relations site 1} & \\mathrm{True}\\\\\\hline\\text{gl(3) relations site 2} & \\mathrm{True}\\\\\\hline\\text{gl(3) relations total} & \\mathrm{True}\\\\\\hline\\text{trace E\\_ii = |lam| per site} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\end{array}",
