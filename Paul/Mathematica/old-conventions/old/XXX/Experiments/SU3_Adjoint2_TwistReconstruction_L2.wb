       "data": "<details class=\"vscode-wolfram-message-output\" style=\"color:#f44;border-left:3px solid #f44;background:rgba(255,68,68,0.08);padding:2px 6px;margin:1px 0;border-radius:0 3px 3px 0;font-family:monospace;font-size:0.85em\"><summary style=\"cursor:pointer\">8 warnings</summary><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression - encountered.                                  0</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression - encountered.                                  0</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression - encountered.                                  0</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">General::stop: Further output of Power::infy will be suppressed during this calculation.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0 ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0 ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0 ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">General::stop: Further output of Infinity::indet will be suppressed during this calculation.</div></details>",
       "mime": "x-application/wolfram-language-html"
