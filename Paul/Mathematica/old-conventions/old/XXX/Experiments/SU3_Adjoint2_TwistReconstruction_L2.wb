  {
   "kind": 2,
   "value": "(* ---- 10b. Five rep pairs: measure dim W^perp and test the lambda_1 selection rule. ---- *)\nruleCases = {\n   {{2, 1, 0}, {1, 0, 0}, 14, 777},\n   {{2, 1, 0}, {2, 1, 0}, 16, 20260919},\n   {{3, 0, 0}, {3, 0, 0}, 20, 5150},\n   {{3, 1, 0}, {2, 1, 0}, 28, 31337},\n   {{3, 1, 0}, {3, 1, 0}, 40, 424242}};\nruleRes = Table[irrepSplit @@ c, {c, ruleCases}];\nruleChk = splitByRule /@ ruleRes;\nGrid[Prepend[\n  Table[{Row[{ruleRes[[k]][\"reps\"][[1]], \" (x) \", ruleRes[[k]][\"reps\"][[2]]}],\n         ruleRes[[k]][\"dim\"], ruleRes[[k]][\"rankW\"], ruleRes[[k]][\"dimWperp\"],\n         ruleChk[[k]][\"predictedDimWperp\"], ruleRes[[k]][\"glInvariant\"],\n         Row[Riffle[First /@ ruleChk[[k]][\"predictedInvisibleLams\"], \", \"]],\n         Style[ruleChk[[k]][\"RULE HOLDS\"], Bold]},\n   {k, Length[ruleRes]}],\n  {\"reps\", \"dim\", \"dim W\", \"dim W^perp\", \"predicted\", \"W^perp gl(3)-inv\", \"invisible lam\", \"rule holds\"}],\n Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
