      {
       "data": "Out[79]= \\begin{array}{|c|c|}\\hline\\text{dim W\\^{}perp} & 1\\\\\\hline\\text{weight of the null vector under Etot} & \\left\\{\\mathrm{List},\\left\\{2,2,2\\right\\}\\right\\}\\\\\\hline\\text{E\\_ij . nullVec = 0 for all i != j} & \\mathrm{True}\\\\\\hline\\text{quadratic Casimir eigenvalue} & 12\\\\\\hline\\mathbf{\\text{nullVec IS the gl(3) singlet of adj (x) adj}} & \\mathbf{True}\\\\\\hline\\text{VALIDATION: <Om(w)|tau\\_a(y,u)|s> = 0 at 8 fresh w x 5 fresh y x 5 fresh u (400)} & \\mathrm{True}\\\\\\hline\\mathbf{\\text{PRODUCTS tau\\_a(y,u) tau\\_b(y',u') do NOT annihilate |s>}} & \\mathbf{True}\\\\\\hline\\text{dim U0 = span\\{<Om(w)|\\} over all w} & 21\\\\\\hline\\text{dim span\\{ tau\\_a(y,u)|s> \\} (single insertions, incl |s>)} & 13\\\\\\hline\\text{the whole orbit of |s> is orthogonal to the whole U0} & \\mathrm{True}\\\\\\hline\\end{array}",
