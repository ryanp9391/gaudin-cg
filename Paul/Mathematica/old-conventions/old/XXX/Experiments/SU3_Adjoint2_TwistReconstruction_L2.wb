      {
       "data": "Out[124]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{reps} & \\text{dim} & \\text{dim W} & \\text{dim W\\^{}perp} & \\text{predicted} & \\text{W\\^{}perp gl(3)-inv} & \\text{invisible lam} & \\text{rule holds}\\\\\\hline\\left\\{2,1,0\\right\\}\\text{ (x) }\\left\\{1,0,0\\right\\} & 24 & 24 & 0 & 0 & \\mathrm{True} & \\square  & \\mathbf{True}\\\\\\hline\\left\\{2,1,0\\right\\}\\text{ (x) }\\left\\{2,1,0\\right\\} & 64 & 63 & 1 & 1 & \\mathrm{True} & \\left\\{2,2,2\\right\\} & \\mathbf{True}\\\\\\hline\\left\\{3,0,0\\right\\}\\text{ (x) }\\left\\{3,0,0\\right\\} & 100 & 63 & 37 & 37 & \\mathrm{True} & \\left\\{3,3,0\\right\\}\\text{, }\\left\\{4,2,0\\right\\} & \\mathbf{True}\\\\\\hline\\left\\{3,1,0\\right\\}\\text{ (x) }\\left\\{2,1,0\\right\\} & 120 & 111 & 9 & 9 & \\mathrm{True} & \\left\\{3,2,2\\right\\}\\text{, }\\left\\{3,3,1\\right\\} & \\mathbf{True}\\\\\\hline\\left\\{3,1,0\\right\\}\\text{ (x) }\\left\\{3,1,0\\right\\} & 225 & 171 & 54 & 54 & \\mathrm{True} & \\left\\{3,3,2\\right\\}\\text{, }\\left\\{4,2,2\\right\\}\\text{, }\\left\\{4,3,1\\right\\}\\text{, }\\left\\{4,4,0\\right\\} & \\mathbf{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "bbab2283-445d-4be3-b3d6-8eada24949e4"
