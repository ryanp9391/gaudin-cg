      {
       "data": "Out[28]= \\begin{array}{|c|c|}\\hline\\text{site dimension} & 8\\\\\\hline\\text{chain dimension} & 64\\\\\\hline\\text{parameters \\{theta1,theta2,h,z\\}} & \\left\\{\\left\\{\\frac{1}{3},-\\frac{8}{57}\\right\\},1,\\left\\{\\frac{5}{2},\\frac{7}{3},\\frac{6}{35}\\right\\}\\right\\}\\\\\\hline\\text{twist is unimodular} & \\mathrm{True}\\\\\\hline\\text{all coefficients of T1,T2 commute} & \\mathrm{True}\\\\\\hline\\text{T3 is the quantum determinant} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "5464cc58-59ef-4f19-aebf-a7357d08afb8"
