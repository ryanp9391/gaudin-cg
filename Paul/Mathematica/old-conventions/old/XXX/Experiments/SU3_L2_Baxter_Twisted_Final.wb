   "value": "(* ---- 3. Direct and dual Baxter polynomials for all 64 states. ---- *)\nClearAll[BaxterDirect2, BaxterDual2, solveMonic2, qpoly2, statesQ2, qRight2, qLeft2];\n\nBaxterDirect2[T1_, T2_, z_][q_][x_] :=\n    z nu1L2[x] nu1L2[x - 1] nu1L2[x - 2] q[x + 1]\n    - (T1 /. u → x) nu1L2[x - 1] nu1L2[x - 2] q[x] + (T2 /. u → x) nu1L2[x - 2] q[x - 1] / z - (Times @@ zTwist) qdetL2[x] q[x - 2] / z^2;\nBaxterDual2[T1_, T2_, y_][g_][x_] :=\n    nu3L2[x + 1] nu3L2[x + 2] nu3L2[x + 3] g[x]\n    - y (T1 /. u → x + 1) nu3L2[x + 2] nu3L2[x + 3] g[x + 1]\n    + y^2 (T2 /. u → x + 2) nu3L2[x + 3] g[x + 2]\n    - y^3 (Times @@ zTwist) qdetL2[x + 3] g[x + 3];\nqpoly2[cl_List, x_] := cl.x^Range[0, Length[cl] - 1];\n\nsolveMonic2[op_, degree_] :=\n    Module[\n        {c, x, q, eqs, aa, bb, sol, res, scale},\n        q = Function[y, Evaluate[y^degree + Sum[c[m] y^m, {m, 0, degree - 1}]]];\n        eqs = CoefficientList[Expand[op[q][x]], x];\n        aa = Table[Coefficient[e, c[m]], {e, eqs}, {m, 0, degree - 1}];\n        bb = eqs /. c[_] → 0;\n        sol = If[degree == 0, {}, LeastSquares[aa, -bb]];\n        res = If[degree == 0, bb, aa.sol + bb];\n        scale = Max[Join[{1}, Abs @ Flatten[{aa, bb}]]];\n        {Append[sol, 1], Max[Abs[res]] / scale}\n    ];\n\nstatesQ2 =\n    Table[\n        Module[\n            {s = stateRecords2〚n〛, mu, qr, ql},\n            mu = s[\"mu\"];\n            qr = Table[solveMonic2[BaxterDirect2[s[\"T1\"], s[\"T2\"], zTwist〚i〛], 4 - mu〚i〛], {i, 3}];\n            ql = Table[solveMonic2[BaxterDual2[s[\"T1\"], s[\"T2\"], 1 / zTwist〚j〛], mu〚j〛], {j, 3}];\n            Append[s, <|\"q\" → qr〚All, 1〛, \"qd\" → ql〚All, 1〛, \"baxterResidual\" → Max[Join[qr〚All, 2〛, ql〚All, 2〛]]|>]\n        ],\n        {n, dchain}\n    ];\n\nqRight2[S_Association, i_Integer, x_] := With[{zi = zTwist〚i〛, cl = S[\"q\"]〚i〛}, Exp[N[x, precisionL2] Log[N[zi, precisionL2]]] qpoly2[cl, x]];\nqLeft2[S_Association, j_Integer, x_] := With[{zj = zTwist〚j〛, cl = S[\"qd\"]〚j〛}, Exp[-N[x, precisionL2] Log[N[zj, precisionL2]]] qpoly2[cl, x]];\n\nGrid[\n    {\n        {\"direct degrees are 4-mu_i\", Union @ Table[(Length /@ s[\"q\"]) - 1 - (4 - s[\"mu\"]), {s, statesQ2}]},\n        {\"dual degrees are mu_j\", Union @ Table[(Length /@ s[\"qd\"]) - 1 - s[\"mu\"], {s, statesQ2}]},\n        {\"max relative Baxter residual\", N[Max[statesQ2〚All, \"baxterResidual\"〛], 6]}\n    },\n    Frame → All,\n    Alignment → Left\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
