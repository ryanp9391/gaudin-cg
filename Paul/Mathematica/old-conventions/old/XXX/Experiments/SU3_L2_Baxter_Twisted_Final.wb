     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752600\" data-output-id=\"8\" data-out-n=\"65\" data-sub-idx=\"6\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"4\" data-sub-start=\"11\" data-sub-end=\"19\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[65]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"26\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:13.2401em;vertical-align:-6.3501em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.89em;\"><span style=\"top:-8.85em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:13.2001em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-6.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.85em;\"><span style=\"top:-8.85em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">one-site labels</span></span></span></span><span style=\"top:-2.85em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">product reference configuration</span></span></span></span><span style=\"top:-1.06em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">all 64 right reference-point factors nonzero</span></span></span></span></span