  {
   "kind": 2,
   "value": "(* ---- 4. The product right reference-point wave function. ---- *)\nClearAll[gtPatterns2, referenceConfiguration2, psiRightLocal2, psiRightReference2];\n\ngtPatterns2 = {{1, 0, 0}, {1, 1, 0}, {1, 1, 1}, {2, 0, 0}, {2, 1, 0}, {2, 1, 1}, {2, 2, 0}, {2, 2, 1}};\nreferenceConfiguration2 = {{1, 0, 0}, {1, 0, 0}};\n\npsiRightLocal2[S_, th_, {aa_, bb_, cc_}] :=\n    qRight2[S, 1, th + aa] (qRight2[S, 1, th + bb] qRight2[S, 2, th + cc - 1] - qRight2[S, 2, th + bb] qRight2[S, 1, th + cc - 1]);\n\npsiRightReference2 = Table[Product[psiRightLocal2[statesQ2〚B〛, thetaValues〚site〛, referenceConfiguration2〚site〛], {site, 2}], {B, dchain}];\n\nGrid[\n    {\n        {\"one-site labels\", gtPatterns2},\n        {\"product reference configuration\", referenceConfiguration2},\n        {\"all 64 right reference-point factors nonzero\", Min[Abs[psiRightReference2]] > 10^ -60}\n    },\n    Frame → All,\n    Alignment → Left\n]",
   "languageId": "wolfram",
   "outputs": [
