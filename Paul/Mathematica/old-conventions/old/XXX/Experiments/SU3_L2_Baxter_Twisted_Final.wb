  {
   "kind": 2,
   "value": "(* ---- 2. Numerical simultaneous eigenstates and product reference vectors. ---- *)\nClearAll[\n    precisionL2,\n    weightList2,\n    sectors2,\n    rho2,\n    stateRecords2,\n    rightMatrix2,\n    leftMatrix2,\n    vacuumState2,\n    alphaConstraints2,\n    betaRules2,\n    alphaValues2,\n    betaValues2,\n    bra01,\n    ket01,\n    bra02,\n    ket02,\n    rightReferencePhysical2,\n    leftReferencePhysical2,\n    physicalScalar2\n];\n\nprecisionL2 = 90;\nweightList2 = Transpose[Table[Diagonal[Etot2[i, i]], {i, 3}]];\nsectors2 = Union[weightList2];\nrho2[a_, k_] := Prime[7 a + k + 1] / (11 + 2 a + k);\n\nstateRecords2 =\n    Flatten[\n        Table[\n            Module[\n                {idx, K, vals, vecs, ord},\n                idx = Flatten @ Position[weightList2, wt];\n                K = Sum[rho2[a, k] N[Tcoeff2[a, k]〚idx, idx〛, precisionL2], {a, 2}, {k, 0, 2 a}];\n                {vals, vecs} = Eigensystem[K];\n                ord = Ordering[({Re[#], Im[#]}&) /@ vals];\n                Table[\n                    Module[\n                        {vv = vecs〚ord〚r〛〛, p, t1, t2, full, eigResidual},\n                        p = First @ Ordering[-Abs[vv], 1];\n                        vv = vv / vv〚p〛;\n                        t1 = Sum[((N[Tcoeff2[1, k]〚idx, idx〛, precisionL2].vv)〚p〛 / vv〚p〛) u^k, {k, 0, 2}];\n                        t2 = Sum[((N[Tcoeff2[2, k]〚idx, idx〛, precisionL2].vv)〚p〛 / vv〚p〛) u^k, {k, 0, 4}];\n                        full = ReplacePart[ConstantArray[SetPrecision[0, precisionL2], dchain], Thread[idx → vv]];\n                        eigResidual =\n                            Max[Flatten @ Table[Abs[N[Tcoeff2[a, k], precisionL2].full - Coefficient[{t1, t2}〚a〛, u, k] full], {a, 2}, {k, 0, 2 a}]];\n                        <|\"mu\" → wt, \"vec\" → full, \"T1\" → Expand[t1], \"T2\" → Expand[t2], \"eigResidual\" → eigResidual|>\n                    ],\n                    {r, Length[ord]}\n                ]\n            ],\n            {wt, sectors2}\n        ],\n        1\n    ];\n\nstateRecords2 = SortBy[stateRecords2, {(-#[\"mu\"]〚1〛)&, (-#[\"mu\"]〚2〛)&, (-#[\"mu\"]〚3〛)&}];\nrightMatrix2 = Transpose[stateRecords2〚All, \"vec\"〛];\nleftMatrix2 = Inverse[rightMatrix2];\nvacuumState2 = First @ FirstPosition[stateRecords2〚All, \"mu\"〛, {4, 2, 0}];\n\nalphaConstraints2 = {-zTwist〚2〛 (zTwist〚1〛 - zTwist〚3〛) / (zTwist〚1〛 (zTwist〚2〛 - zTwist〚3〛)), -(zTwist〚1〛 - zTwist〚3〛) / (zTwist〚2〛 - zTwist〚3〛)};\nbetaRules2 =\n    Table[\n        {\n            b21 → -zTwist〚1〛 (zTwist〚1〛 - zTwist〚3〛) / (a12 zTwist〚2〛 (zTwist〚2〛 - zTwist〚3〛)),\n            b31 → {-zTwist〚1〛^2 / (a13 zTwist〚3〛^2), -zTwist〚1〛 / (a13 zTwist〚3〛)}〚q〛,\n            b32 → -zTwist〚2〛^2 (zTwist〚1〛 - zTwist〚3〛) / (a23 (zTwist〚1〛 - zTwist〚2〛) zTwist〚3〛^2)\n        },\n        {q, 2}\n    ];\nalphaValues2[q_] := {a13 → 3 / 5, a23 → 4 / 7, a12 → alphaConstraints2〚q〛 (3 / 5) / (4 / 7)};\nbetaValues2[q_] := betaRules2〚q〛 /. alphaValues2[q];\n\nbra01[q_] :=\n    N[\n        Dot[\n            UnitVector[dsite, 1],\n            MatrixExp[(a12 /. alphaValues2[q]) EElocal[1, 2]],\n            MatrixExp[(a13 /. alphaValues2[q]) EElocal[1, 3]],\n            MatrixExp[(a23 /. alphaValues2[q]) EElocal[2, 3]]\n        ],\n        precisionL2\n    ];\nket01[q_] :=\n    N[\n        Dot[\n            MatrixExp[(b21 /. betaValues2[q]) EElocal[2, 1]],\n            MatrixExp[(b31 /. betaValues2[q]) EElocal[3, 1]],\n            MatrixExp[(b32 /. betaValues2[q]) EElocal[3, 2]],\n            UnitVector[dsite, 1]\n        ],\n        precisionL2\n    ];\n(* KroneckerProduct of two vectors is their 8x8 outer product; flatten it\n   row-major to get the 64-vector in the Esite1 (x) Esite2 ordering. *)\nbra02[q_] := Flatten[KroneckerProduct[bra01[q], bra01[q]]];\nket02[q_] := Flatten[KroneckerProduct[ket01[q], ket01[q]]];\nrightReferencePhysical2[q_] := bra02[q].rightMatrix2;\nleftReferencePhysical2[q_] := leftMatrix2.ket02[q];\nphysicalScalar2[q_] := IdentityMatrix[dchain] / Outer[Times, leftReferencePhysical2[q], rightReferencePhysical2[q]];\n\nGrid[\n    {\n        {\"number of states\", Length[stateRecords2]},\n        {\"weight multiplicities\", Counts[stateRecords2〚All, \"mu\"〛]},\n        {\"max simultaneous-eigenvector residual\", N[Max[stateRecords2〚All, \"eigResidual\"〛], 6]},\n        {\"biorthogonal inverse residual\", N[Max[Abs[leftMatrix2.rightMatrix2 - IdentityMatrix[dchain]]], 6]},\n        {\"vacuum state index and weight\", {vacuumState2, stateRecords2〚vacuumState2, \"mu\"〛}},\n        {\"branch I: a12 a23/a13, beta rules\", {alphaConstraints2〚1〛, betaRules2〚1〛}},\n        {\"branch II: a12 a23/a13, beta rules\", {alphaConstraints2〚2〛, betaRules2〚2〛}}\n    },\n    Frame → All,\n    Alignment → Left\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
