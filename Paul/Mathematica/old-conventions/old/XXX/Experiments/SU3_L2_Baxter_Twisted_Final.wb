      {
       "data": "Out[65]= \\begin{array}{|c|c|}\\hline\\text{one-site labels} & \\begin{pmatrix}1 & 0 & 0\\\\1 & 1 & 0\\\\1 & 1 & 1\\\\2 & 0 & 0\\\\2 & 1 & 0\\\\2 & 1 & 1\\\\2 & 2 & 0\\\\2 & 2 & 1\\end{pmatrix}\\\\\\hline\\text{product reference configuration} & \\begin{pmatrix}1 & 0 & 0\\\\1 & 0 & 0\\end{pmatrix}\\\\\\hline\\text{all 64 right reference-point factors nonzero} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
