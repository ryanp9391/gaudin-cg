{
 "cells": [
  {
   "kind": 1,
   "value": "# gl(3), L = 1: final normalized scalar-product match\n\nOne adjoint site $\\lambda=(2,1,0)$, inhomogeneity $\\theta$, and diagonal twist\n$K=\\operatorname{diag}(z_1,z_2,z_3)$.\n\nThis notebook contains only the final construction:\n\n- all eight common transfer-matrix eigenstates;\n- their direct and dual Baxter Q-functions;\n- the exact coefficient of $\\Psi_B(\\{1\\},\\{0,0\\})$, without imposing an off-shell Q-relation;\n- the vacuum-normalized Q-function determinant;\n- the normalized vector overlap\n  $$\n  \\frac{\\langle L_A|R_B\\rangle}\n       {\\langle L_A|0\\rangle\\,\\langle0|R_B\\rangle};\n  $$\n- both allowed relations between $a_{ij}$ and $b_{ji}$;\n- exact equality of the complete $8\\times8$ scalar-product matrices.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 1. gl(3) representation and twisted fused transfer matrices. ---- *)\nps[rr_] := ps[rr] = Block[{res = Prepend[rr, #] & /@\n      Tuples[Table[Range[rr[[1, i + 1]], rr[[1, i]]],\n        {i, 1, Length[rr[[1]]] - 1}]]},\n   If[Length[res[[1, 1]]] == 1, Reverse@Sort@res,\n    Reverse@Sort@Flatten[ps /@ res, 1]]];\ndim[rr_] := dim[rr] = Length[ps[{rr}]];\nJ0[k_][pat_] := J0[k][pat] =\n  Sum[pat[[k, i]], {i, 1, k}] - Sum[pat[[k - 1, i]], {i, 1, k - 1}];\nJp[k_][pat_] := Jp[k][pat] = -Sum[\n   Product[pat[[k, i]] - i - pat[[k + 1, j]] + j, {j, Range[k + 1]}]/\n    Product[pat[[k, i]] - i - pat[[k, j]] + j,\n      {j, Complement[Range[k], {i}]}]\n    v[ReplacePart[pat, {k, i} -> pat[[k, i]] + 1]], {i, 1, k}];\nJm[k_][pat_] := Jm[k][pat] = Sum[\n   Product[pat[[k, i]] - i - pat[[k - 1, j]] + j, {j, Range[k - 1]}]/\n    Product[pat[[k, i]] - i - pat[[k, j]] + j,\n      {j, Complement[Range[k], {i}]}]\n    v[ReplacePart[pat, {k, i} -> pat[[k, i]] - 1]], {i, 1, k}];\nJJ[k_, l_, rr_] := JJ[k, l, rr] = Which[\n   k == l, DiagonalMatrix[J0[k] /@ ps[{rr}]],\n   l == k + 1, Transpose@Table[\n     Coefficient[Jp[k][ps[{rr}][[i]]], v[#]] & /@ ps[{rr}],\n     {i, Length[ps[{rr}]]}],\n   l == k - 1, Transpose@Table[\n     Coefficient[Jm[l][ps[{rr}][[i]]], v[#]] & /@ ps[{rr}],\n     {i, Length[ps[{rr}]]}],\n   l > k + 1, JJ[k, k + 1, rr] . JJ[k + 1, l, rr]\n     - JJ[k + 1, l, rr] . JJ[k, k + 1, rr],\n   l < k - 1, JJ[k, k - 1, rr] . JJ[k - 1, l, rr]\n     - JJ[k - 1, l, rr] . JJ[k, k - 1, rr]];\n\nrep = {2, 1, 0};\ndd = dim[rep];\nidd = IdentityMatrix[dd];\nzero8 = ConstantArray[0, {dd, dd}];\nEE[i_, j_] := EE[i, j] = JJ[i, j, rep];\ntwist = {z1, z2, z3};\nTm[i_, j_][x_] := (x - th) KroneckerDelta[i, j] idd - h EE[j, i];\nqmin[II_, KK_][x_] := Expand@Sum[\n   Signature[s] Dot @@ Table[\n     Tm[II[[s[[k]]]], KK[[k]]][x - (k - 1) h], {k, Length[KK]}],\n   {s, Permutations[Range[Length[KK]]]}];\nTT[a_][x_] := TT[a][x] = Expand@Sum[\n   (Times @@ twist[[II]]) qmin[II, II][x],\n   {II, Subsets[Range[3], {a}]}];\nnu[i_][x_] := x - th - h rep[[i]];\nnu1[x_] := nu[1][x];\nnu3[x_] := nu[3][x];\n\nGrid[{\n  {\"dimension\", dd},\n  {\"degrees of T_1,T_2,T_3\", Table[Exponent[TT[a][u][[1, 1]], u], {a, 3}]},\n  {\"all transfer-matrix coefficients commute\",\n   And @@ Flatten@Table[\n     Expand[Coefficient[TT[a][u], u, k] . Coefficient[TT[b][u], u, l]\n       - Coefficient[TT[b][u], u, l] . Coefficient[TT[a][u], u, k]] === zero8,\n     {a, 2}, {b, 2}, {k, 0, a}, {l, 0, b}]}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"639562\" data-output-id=\"88\" data-out-n=\"19\" data-sub-idx=\"19\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"1\" data-sub-start=\"50\" data-sub-end=\"58\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[19]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"11\" data-latex-b64=\"XGJlZ2lue2FycmF5fXt8Y3xjfH1caGxpbmVcdGV4dHtkaW1lbnNpb259ICYgOFxcXGhsaW5lXHRleHR7ZGVncmVlcyBvZiBUXF8xLFRcXzIsVFxfM30gJiBcbGVmdFx7MSwyLDNccmlnaHRcfVxcXGhsaW5lXHRleHR7YWxsIHRyYW5zZmVyLW1hdHJpeCBjb2VmZmljaWVudHMgY29tbXV0ZX0gJiBcbWF0aHJte1RydWV9XFxcaGxpbmVcZW5ke2FycmF5fQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:3.64em;vertical-align:-1.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.09em;\"><span style=\"top:-4.05em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">dimension</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">degrees of T_1,T_2,T_3</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">all transfer-matrix coefficients commute</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">8</span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">3</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[19]= \\begin{array}{|c|c|}\\hline\\text{dimension} & 8\\\\\\hline\\text{degrees of T\\_1,T\\_2,T\\_3} & \\left\\{1,2,3\\right\\}\\\\\\hline\\text{all transfer-matrix coefficients commute} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "9a6ec1b6-eb29-4840-bcbd-eb37a16d7d61"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 2. Eight eigenstates and the normalized vector scalar product. ---- *)\nClearAll[seedOp, seedValues, rightBasis, leftBasis, stateWeight, tEigen,\n  a12, a13, a23, b21, b31, b32, bra0, ket0, rightReferenceOverlap,\n  leftReferenceOverlap, physicalScalarProduct, simultaneousCheck];\n\nseedOp = Coefficient[TT[2][u], u, 0];\n{seedValues, rightBasis} = Eigensystem[seedOp];\nrightBasis = Transpose[rightBasis];\nleftBasis = Inverse[rightBasis];\n\nstateWeight = Table[\n   Table[FullSimplify[leftBasis[[s]] . EE[i, i] . rightBasis[[All, s]]],\n     {i, 3}], {s, dd}];\ntEigen[s_, a_] := Expand[leftBasis[[s]] . TT[a][u] . rightBasis[[All, s]]];\n\nsimultaneousCheck = And @@ Flatten@Table[\n    Module[{mm = Together[\n        leftBasis . Coefficient[TT[a][u], u, k] . rightBasis]},\n     Union[Flatten[\n       FullSimplify[mm - DiagonalMatrix[Diagonal[mm]]]]] === {0}],\n    {a, 3}, {k, 0, a}];\n\nvac = UnitVector[dd, 1];\nbra0 = Simplify[{vac} . MatrixExp[a12 EE[1, 2]] .\n    MatrixExp[a13 EE[1, 3]] . MatrixExp[a23 EE[2, 3]]];\nket0 = Simplify[MatrixExp[b21 EE[2, 1]] .\n    MatrixExp[b31 EE[3, 1]] . MatrixExp[b32 EE[3, 2]] . vac];\n\nrightReferenceOverlap =\n  Table[Factor[First[bra0] . rightBasis[[All, s]]], {s, dd}];\nleftReferenceOverlap =\n  Table[Factor[leftBasis[[s]] . ket0], {s, dd}];\n\nphysicalScalarProduct = Table[\n   Factor[(leftBasis[[A]] . rightBasis[[All, B]])/\n     (leftReferenceOverlap[[A]] rightReferenceOverlap[[B]])],\n   {A, dd}, {B, dd}];\n\nGrid[{\n  {\"all T_a coefficients simultaneously diagonal\", simultaneousCheck},\n  {\"state weights\", stateWeight},\n  {\"<0| components\", First[bra0]},\n  {\"|0> components\", ket0},\n  {\"normalized vector product\",\n   \"<Psi_A|Psi_B>/(<Psi_A|0><0|Psi_B>)\"}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"639562\" data-output-id=\"89\" data-out-n=\"34\" data-sub-idx=\"15\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"2\" data-sub-start=\"38\" data-sub-end=\"45\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[34]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"10\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:14.4802em;vertical-align:-6.9701em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:7.5101em;\"><span style=\"top:-9.4701em;\"><span class=\"pstrut\" style=\"height:9.4701em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:14.4402em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-6.9701em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:7.4701em;\"><span style=\"top:-13.6801em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">all T_a coefficients simultaneously diagonal</span></span></span></span><span style=\"top:-8.2701em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">state weights</span></span></span></span><span style=\"top:-2.88em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">&lt;0| components</span></span></span></span><span style=\"top:-1.6399em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">|0&gt; components</span></span></span></span><span style=\"top:-0.4399em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">normalized vector product</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.9701em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:14.4402em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-6.9701em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:7.4701em;\"><span style=\"top:-13.6801em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-8.2701em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen\"><span class=\"delimsizing mult\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.0499em;\"><span style=\"top:-7.0499em;\"><span class=\"pstrut\" style=\"height:11.6em;\"></span><span style=\"width:0.875em;height:9.600em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.875em\" height=\"9.600em\" viewBox=\"0 0 875 9600\"><path d=\"M863,9c0,-2,-2,-5,-6,-9c0,0,-17,0,-17,0c-12.7,0,-19.3,0.3,-20,1\nc-5.3,5.3,-10.3,11,-15,17c-242.7,294.7,-395.3,682,-458,1162c-21.3,163.3,-33.3,349,\n-36,557 l0,6084c0.2,6,0,26,0,60c2,159.3,10,310.7,24,454c53.3,528,210,\n949.7,470,1265c4.7,6,9.7,11.7,15,17c0.7,0.7,7,1,19,1c0,0,18,0,18,0c4,-4,6,-7,6,-9\nc0,-2.7,-3.3,-8.7,-10,-18c-135.3,-192.7,-235.5,-414.3,-300.5,-665c-65,-250.7,-102.5,\n-544.7,-112.5,-882c-2,-104,-3,-167,-3,-189\nl0,-6092c0,-162.7,5.7,-314,17,-454c20.7,-272,63.7,-513,129,-723c65.3,\n-210,155.3,-396.3,270,-559c6.7,-9.3,10,-15.3,10,-18z\"/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.5501em;\"><span></span></span></span></span></span></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span></span></span><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:1.19em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:1.19em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\">