  {
   "kind": 2,
   "value": "(* ---- 5. Impose b(a) and prove equality of the complete 8x8 matrices. ---- *)\nClearAll[x12, x23, z13Branches, alphaConstraints, betaRules,\n  alphaRules, branchResiduals, branchMatches];\n\nx12 = -z1 (z1 - z3)/(z2 (z2 - z3));\nx23 = -z2^2 (z1 - z3)/(z3^2 (z1 - z2));\nz13Branches = {-z1^2/z3^2, -z1/z3};\n\nalphaConstraints = {\n  -z2 (z1 - z3)/(z1 (z2 - z3)),\n  -(z1 - z3)/(z2 - z3)};\n\nbetaRules = Table[\n   {b21 -> Factor[x12/a12],\n    b31 -> Factor[z13Branches[[q]]/a13],\n    b32 -> Factor[x23/a23]}, {q, 2}];\n\n(* Used only to verify the constraint; the displayed solution keeps all b's in terms of a's. *)\nalphaRules = Table[\n   a12 -> Factor[alphaConstraints[[q]] a13/a23], {q, 2}];\n\nbranchResiduals = Table[\n   Table[Factor@Together[\n      ((physicalScalarProduct[[A, B]] /. betaRules[[q]])\n          /. alphaRules[[q]]) - qScalarProduct[[A, B]]],\n     {A, dd}, {B, dd}], {q, 2}];\nbranchMatches = Table[\n   branchResiduals[[q]] === ConstantArray[0, {dd, dd}],\n   {q, 2}];\n\nGrid[{\n  {\"branch\", \"constraint among a's\", \"all b's in terms of a's\",\n   \"full 8x8 equality\"},\n  {\"I\", a12 a23/a13 == alphaConstraints[[1]],\n   Column[betaRules[[1]]], branchMatches[[1]]},\n  {\"II\", a12 a23/a13 == alphaConstraints[[2]],\n   Column[betaRules[[2]]], branchMatches[[2]]},\n  {\"physical matrix\", MatrixForm[\n    (physicalScalarProduct /. betaRules[[1]]) /. alphaRules[[1]]],\n   SpanFromLeft, SpanFromLeft},\n  {\"Q-determinant matrix\", MatrixForm[qScalarProduct],\n   SpanFromLeft, SpanFromLeft}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
