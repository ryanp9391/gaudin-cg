      {
       "data": "Out[61]= \\begin{array}{|c|c|}\\hline\\text{exact coefficient c\\_A\\^{}ref} & \\frac{\\mathrm{Qup}\\left(1,1\\right)\\,\\left(\\mathrm{Qup}\\left(1,0\\right)\\,\\mathrm{Qup}\\left(2,1\\right)-\\mathrm{Qup}\\left(1,1\\right)\\,\\mathrm{Qup}\\left(2,0\\right)\\right)-\\mathrm{Qup}\\left(1,0\\right)\\,\\left(\\mathrm{Qup}\\left(1,0\\right)\\,\\mathrm{Qup}\\left(2,2\\right)-\\mathrm{Qup}\\left(1,2\\right)\\,\\mathrm{Qup}\\left(2,0\\right)\\right)}{4\\,h^6}\\\\\\hline\\text{vacuum calibration C\\_vac} & \\frac{z2\\,z3^3}{\\left(z1-z2\\right)\\,\\left(z1-z3\\right)^2\\,\\left(z2-z3\\right)}\\\\\\hline\\text{vacuum entry} & 1\\\\\\hline\\text{all 56 cross-state determinants vanish} & \\mathrm{True}\\\\\\hline\\text{Q-determinant scalar-product matrix is diagonal} & \\mathrm{True}\\\\\\hline\\text{diagonal entries} & \\left\\{1,-\\frac{\\left(z1-z2\\right)\\,z3^2}{z2^2\\,\\left(z1-z3\\right)},-\\frac{z2\\,\\left(z2-z3\\right)}{z1\\,\\left(z1-z3\\right)},-\\frac{\\left(z2-z3\\right)\\,z3^3}{z1\\,z2^2\\,\\left(z1-z3\\right)},-\\frac{\\left(z1-z2\\right)\\,z2\\,z3^2}{z1^3\\,\\left(z1-z3\\right)},\\frac{z3^3}{z1^3},-\\frac{2\\,h^6\\,\\left(z1-z2\\right)^3\\,z3^3\\,\\left(z1\\,z3\\,h^2-z2\\,z3\\,h^2+\\sqrt{h^4\\,\\left(z2^2\\,z1^2+z3^2\\,z1^2-z2\\,z3\\,z1^2-z2\\,z3^2\\,z1-z2^2\\,z3\\,z1+z2^2\\,z3^2\\right)}\\right)\\,\\left(h^2\\,z2^2\\,z1^2+… [latex truncated: 5212 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "04c5588b-fb15-4345-8d8a-d1f3ed9f8c02"
