       "data": "Out[71]= \\begin{array}{|c|c|c|c|}\\hline\\text{branch} & \\text{constraint among a's} & \\text{all b's in terms of a's} & \\text{full 8x8 equality}\\\\\\hline\\text{I} & \\frac{a12\\,a23}{a13}⩵-\\frac{z2\\,\\left(z1-z3\\right)}{z1\\,\\left(z2-z3\\right)} & \\begin{matrix}b21\\to -\\frac{z1\\,\\left(z1-z3\\right)}{a12\\,z2\\,\\left(z2-z3\\right)}\\\\b31\\to -\\frac{z1^2}{a13\\,z3^2}\\\\b32\\to -\\frac{z2^2\\,\\left(z1-z3\\right)}{a23\\,\\left(z1-z2\\right)\\,z3^2}\\end{matrix} & \\mathrm{True}\\\\\\hline\\text{II} & \\frac{a12\\,a23}{a13}⩵\\frac{z3-z1}{z2-z3} & \\begin{matrix}b21\\to -\\frac{z1\\,\\left(z1-z3\\right)}{a12\\,z2\\,\\left(z2-z3\\right)}\\\\b31\\to -\\frac{z1}{a13\\,z3}\\\\b32\\to -\\frac{z2^2\\,\\left(z1-z3\\right)}{a23\\,\\left(z1-z2\\right)\\,z3^2}\\end{matrix} & \\mathrm{True}\\\\\\hline\\text{physical matrix} & \\begin{pmatrix}1 & 0 & 0 & 0 & 0 & 0 & 0 & 0\\\\0 & -\\frac{\\left(z1-z2\\right)\\,z3^2}{z2^2\\,\\left(z1-z3\\right)} & 0 & 0 & 0 & 0 & 0 & 0\\\\0 & 0 & -\\frac{z2\\,\\left(z2-z3\\right)}{z1\\,\\left(z1-z3\\right)} & 0 & 0 & 0 & 0 & 0\\\\0 & 0 & 0 & \\frac{a13\\,\\left(z1-z2\\right)\\,z3^4}{z1^2\\,z2^2\\,\\left(a13-\\frac{a13\\,z2\\,\\left(z1-z3\\right)}{z1\\,\\left(z2-z3\\right)}\\right)\\,\\left(z1-z3\\right)} & 0 & 0 & 0 & 0\\\\0 & 0 & 0 & 0 & \\frac{z2\\,\\left(z2-z3\\right)}{a13\\,z1\\,\\left(… [latex truncated: 8363 chars total]",
