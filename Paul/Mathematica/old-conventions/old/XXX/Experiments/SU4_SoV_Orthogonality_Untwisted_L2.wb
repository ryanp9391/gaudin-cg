       "data": "Out[23]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{(S,P)} & \\text{mu} & \\text{tc} & \\text{deg q\\_1..q\\_4} & \\text{deg q\\^{}4..q\\^{}1} & \\text{O q\\_k\\^{}[2] = 0} & \\text{O$\\dag$ q\\^{}j = 0}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,2,0,0\\right\\} & \\left\\{\\frac{22}{7},\\frac{7214}{147},-\\frac{4472}{147},\\frac{3812}{441},\\frac{274}{21}\\right\\} & \\left\\{0,1,4,5\\right\\} & \\left\\{0,1,4,5\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,1,1,0\\right\\} & \\left\\{\\frac{8}{7},\\frac{6626}{147},-\\frac{3016}{147},-\\frac{640}{441},\\frac{232}{21}\\right\\} & \\left\\{0,2,3,5\\right\\} & \\left\\{0,2,3,5\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{1,1,1,1\\right\\} & \\left\\{-\\frac{20}{7},\\frac{5450}{147},-\\frac{104}{147},\\frac{1040}{441},\\frac{148}{21}\\right\\} & \\left\\{1,2,3,4\\right\\} & \\left\\{1,2,3,4\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,3,0,0\\right\\} & \\left\\{\\frac{38}{7},\\frac{10406}{147},-\\frac{8074}{147},\\frac{9032}{441},\\frac{52}{3}\\right\\} & \\left\\{0,1,5,6\\right\\} & \\left\\{0,1,5,6\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,2,1,0\\right\\} & \\left\\{\\frac{17}{7},\\frac{9524}{147},-\\frac{5449}… [latex truncated: 2883 chars total]",
