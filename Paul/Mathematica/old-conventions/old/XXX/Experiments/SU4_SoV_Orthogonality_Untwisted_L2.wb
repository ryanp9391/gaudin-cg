  {
   "kind": 2,
   "value": "(* ---- 6. ORTHOGONALITY and NORMS at (i,j) = (2,1), every ordered pair of irreps.\n   cross: det N = 0 and N.(Δtc1, Δc) = 0 ; rank 0 marks pairs where N vanishes identically (no test). ---- *)\northTab = Flatten[Table[With[{st = states @@ sp}, Table[With[{N = N2[sp[[1]], sp[[2]], A, B, 2, 1], d = invs[sp[[1]], sp[[2]], A, B]},\n       {sp, A[\"mu\"], B[\"mu\"], If[A === B, \"norm\", \"cross\"], Together[Det[N]], d, Together[N . d] === {0, 0}, MatrixRank[N]}], {A, st}, {B, st}]], {sp, {{1, 1}, {2, 1}, {2, 2}}}], 2];\northSummary = {{\"norms with det N != 0\", Row[{Count[orthTab, {_, _, _, \"norm\", x_, __} /; x =!= 0], \" / \", Count[orthTab, {_, _, _, \"norm\", __}]}]},\n   {\"cross pairs with det N = 0\", Row[{Count[orthTab, {_, _, _, \"cross\", 0, __}], \" / \", Count[orthTab, {_, _, _, \"cross\", __}]}]},\n   {\"cross pairs with N.(Δtc1, Δc) = 0\", Row[{Count[orthTab, {_, _, _, \"cross\", _, _, True, _}], \" / \", Count[orthTab, {_, _, _, \"cross\", __}]}]},\n   {\"cross pairs with N = 0 identically\", Cases[orthTab, {sp_, a_, b_, \"cross\", _, _, _, 0} :> {sp, a, b}]}};\nColumn[{Grid[orthSummary, Frame -> All, Alignment -> Left], Grid[Prepend[orthTab, {\"(S,P)\", \"mu_A\", \"mu_B\", \"kind\", \"det N\", \"(Δtc1, Δc)\", \"N.Δ = 0\", \"rank N\"}], Frame -> All]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
