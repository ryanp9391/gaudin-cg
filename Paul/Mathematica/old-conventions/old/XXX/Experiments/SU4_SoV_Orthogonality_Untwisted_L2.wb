  {
   "kind": 2,
   "value": "(* ---- 9. ORTHOGONALITY with full-contour rows, at the first universal pair of rows. ---- *)\npairSel = First[universalFull];\northFull = Flatten[Table[With[{st = states @@ sp}, Table[With[{N = {rowFull[sp[[1]], sp[[2]], A, B, Sequence @@ pairSel[[1]]], rowFull[sp[[1]], sp[[2]], A, B, Sequence @@ pairSel[[2]]]}, d = invs[sp[[1]], sp[[2]], A, B]},\n       {sp, A[\"mu\"], B[\"mu\"], If[A === B, \"norm\", \"cross\"], Together[Det[N]], Together[N . d] === {0, 0}, MatrixRank[N]}], {A, st}, {B, st}]], {sp, {{1, 1}, {2, 1}, {2, 2}}}], 2];\northFullSummary = {{\"rows used ((i1,j1), (i2,j2))\", pairSel},\n   {\"norms with det != 0\", Row[{Count[orthFull, {_, _, _, \"norm\", x_, __} /; x =!= 0], \" / \", Count[orthFull, {_, _, _, \"norm\", __}]}]},\n   {\"cross pairs with det = 0\", Row[{Count[orthFull, {_, _, _, \"cross\", 0, __}], \" / \", Count[orthFull, {_, _, _, \"cross\", __}]}]},\n   {\"cross pairs with N.(Δtc1, Δc) = 0\", Row[{Count[orthFull, {_, _, _, \"cross\", _, True, _}], \" / \", Count[orthFull, {_, _, _, \"cross\", __}]}]},\n   {\"cross pairs with N = 0 identically\", Cases[orthFull, {sp_, a_, b_, \"cross\", _, _, 0} :> {sp, a, b}]}};\nColumn[{Grid[orthFullSummary, Frame -> All, Alignment -> Left], Grid[Prepend[orthFull, {\"(S,P)\", \"mu_A\", \"mu_B\", \"kind\", \"det N\", \"N.Δ = 0\", \"rank N\"}], Frame -> All]}]",
   "languageId": "wolfram",
   "outputs": [
