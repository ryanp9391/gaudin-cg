      {
       "data": "Out[512]= \\begin{array}{c}\\begin{array}{|c|c|c|c|}\\hline\\text{(i,j)} & \\text{nonzero diagonal norms, of 12} & \\text{Nvac for (1,1), (2,1), (2,2)} & \\text{all three vacuum ratios = 1}\\\\\\hline\\left\\{2,1\\right\\} & 12 & \\left\\{-\\frac{145570417}{111435},-\\frac{5960610348}{497743},-\\frac{1183291756455123}{14683418500}\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{2,2\\right\\} & 12 & \\left\\{-\\frac{1577016}{37145},-\\frac{1970037993}{12443575},-\\frac{364231490427}{587336740}\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{3,1\\right\\} & 12 & \\left\\{\\frac{3604074308188}{2124704925},\\frac{79757432541700160}{871214007447},-\\frac{53067083118311710624}{237970492774875}\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{3,2\\right\\} & 12 & \\left\\{\\frac{100066016}{1605975},\\frac{1754505570577552}{1333490827725},-\\frac{1966600773027644}{1057646634555}\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{3,3\\right\\} & 12 & \\left\\{\\frac{34398}{10925},\\frac{99965292}{12443575},-\\frac{1442021049}{587336740}\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{4,1\\right\\} & 12 & \\left\\{-\\frac{19792950808985296}{3233689069275},\\frac{110687644969672577780}{128068459094709},\\frac{4155007047686321559954364}{291513853649221875}\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{4,2\\right\\} & 1… [latex truncated: 2792 chars total]",
       "mime": "text/plain"
      }
