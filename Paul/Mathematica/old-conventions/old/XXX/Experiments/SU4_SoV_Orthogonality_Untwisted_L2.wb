       "data": "Out[474]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{(i,j)} & \\text{irreps with zero full row (of 12)}\\\\\\hline\\left\\{1,1\\right\\} & 0\\\\\\hline\\left\\{1,2\\right\\} & 12\\\\\\hline\\left\\{1,3\\right\\} & 12\\\\\\hline\\left\\{1,4\\right\\} & 12\\\\\\hline\\left\\{2,1\\right\\} & 0\\\\\\hline\\left\\{2,2\\right\\} & 0\\\\\\hline\\left\\{2,3\\right\\} & 12\\\\\\hline\\left\\{2,4\\right\\} & 12\\\\\\hline\\left\\{3,1\\right\\} & 0\\\\\\hline\\left\\{3,2\\right\\} & 0\\\\\\hline\\left\\{3,3\\right\\} & 0\\\\\\hline\\left\\{3,4\\right\\} & 12\\\\\\hline\\left\\{4,1\\right\\} & 0\\\\\\hline\\left\\{4,2\\right\\} & 0\\\\\\hline\\left\\{4,3\\right\\} & 0\\\\\\hline\\left\\{4,4\\right\\} & 0\\\\\\hline\\end{array}\\\\\\text{pairs of rows with nonzero norm for all 12 irreps: }41\\text{ of }120\\\\\\text{they are: }\\begin{pmatrix}\\left\\{1,1\\right\\} & \\left\\{2,1\\right\\}\\\\\\left\\{1,1\\right\\} & \\left\\{2,2\\right\\}\\\\\\left\\{1,1\\right\\} & \\left\\{3,1\\right\\}\\\\\\left\\{1,1\\right\\} & \\left\\{3,2\\right\\}\\\\\\left\\{1,1\\right\\} & \\left\\{3,3\\right\\}\\\\\\left\\{1,1\\right\\} & \\left\\{4,1\\right\\}\\\\\\left\\{1,1\\right\\} & \\left\\{4,2\\right\\}\\\\\\left\\{1,1\\right\\} & \\left\\{4,3\\right\\}\\\\\\left\\{2,1\\right\\} & \\left\\{2,2\\right\\}\\\\\\left\\{2,1\\right\\} & \\left\\{3,1\\right\\}\\\\\\left\\{2,1\\right\\} & \\left\\{3,2\\right\\}\\\\\\left\\{2,1\\right\\} & \\left\\{3,3\\right\\}… [latex truncated: 2529 chars total]",
