       "data": "Out[548]= \\begin{array}{c}\\begin{array}{|c|c|c|c|c|}\\hline\\text{(i,j)} & \\text{vacuum = 1, of 3} & \\text{exact conversion identity, of 12} & \\text{conversion factor = 1, of 12} & \\text{distinct conversion factors}\\\\\\hline\\left\\{2,1\\right\\} & 3 & 12 & 3 & 10\\\\\\hline\\left\\{2,2\\right\\} & 3 & 12 & 3 & 10\\\\\\hline\\left\\{3,1\\right\\} & 3 & 12 & 3 & 10\\\\\\hline\\left\\{3,2\\right\\} & 3 & 12 & 3 & 10\\\\\\hline\\left\\{3,3\\right\\} & 3 & 12 & 3 & 10\\\\\\hline\\left\\{4,1\\right\\} & 3 & 12 & 3 & 10\\\\\\hline\\left\\{4,2\\right\\} & 3 & 12 & 3 & 10\\\\\\hline\\left\\{4,3\\right\\} & 3 & 12 & 3 & 10\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|}\\hline\\text{(S,P)} & \\text{mu} & \\text{distinct double ratios over 8 pairings} & \\text{distinct conversion factors over 8 pairings}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,2,0,0\\right\\} & 1 & 1\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,1,1,0\\right\\} & 8 & 8\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{1,1,1,1\\right\\} & 8 & 8\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,3,0,0\\right\\} & 1 & 1\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,2,1,0\\right\\} & 8 & 8\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{2,2,1,1\\right\\} & 8 & 8\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{4,4,0,0\\right\\} & 1 & 1\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{4,3,1,0\\right\\} & 8 … [latex truncated: 1703 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "f5793779-8306-4428-b8e8-f739709e2f81"
    }
