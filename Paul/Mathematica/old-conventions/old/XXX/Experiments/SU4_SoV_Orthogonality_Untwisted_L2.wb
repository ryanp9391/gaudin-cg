  {
   "kind": 2,
   "value": "(* ---- 11. Right/transpose-left highest-weight eigenvectors and comparison with det N^{AA}. ---- *)\nClearAll[hnPivotNormalize, hnZeroVectorQ, honestStateData, honestNormData];\nhnPivotNormalize[vec_] := Module[{pivot = First@FirstPosition[PossibleZeroQ /@ vec, False]},\n   Together[vec/vec[[pivot]]]];\nhnZeroVectorQ[vec_] := AllTrue[Flatten@Normal[vec], PossibleZeroQ];\n\nhonestStateData[S_, P_] := honestStateData[S, P] = Module[\n   {reps, sites0, dims, totalDim, localWeights1, localWeights2, totalWeights, id, t1, t2},\n   reps = {{S, S, 0, 0}, {P, P, 0, 0}};\n   sites0 = {{reps[[1]], 1/3}, {reps[[2]], 1/7}};\n   dims = hnDim /@ reps;\n   totalDim = Times @@ dims;\n   localWeights1 = (Table[hnJ0[k][#], {k, 4}] &) /@ hnPs[{reps[[1]]}];\n   localWeights2 = (Table[hnJ0[k][#], {k, 4}] &) /@ hnPs[{reps[[2]]}];\n   totalWeights = Flatten[\n     Table[localWeights1[[i]] + localWeights2[[j]], {i, dims[[1]]}, {j, dims[[2]]}], 1];\n   id = IdentityMatrix[totalDim, SparseArray];\n   t1 = hnTauV[sites0, ConstantArray[1, 4], 1, 0, id];\n   t2 = hnTauV[sites0, ConstantArray[1, 4], 2, 0, id];\n\n   Table[Module[\n     {mu = state[\"mu\"], lambda1 = state[\"tc\"][[1]], lambda2 = state[\"tc\"][[4]],\n      sector, block1, block2, nullR, nullL, rSector, lSector, psiR, psiL, honest, sov},\n     sector = Flatten@Position[totalWeights, mu];\n     block1 = t1[[sector, sector]];\n     block2 = t2[[sector, sector]];\n     nullR = NullSpace[block1 - lambda1 IdentityMatrix[Length[sector]]];\n     nullL = NullSpace[Transpose[block1] - lambda1 IdentityMatrix[Length[sector]]];\n     rSector = hnPivotNormalize@First[nullR];\n     lSector = hnPivotNormalize@First[nullL];\n     psiR = SparseArray[Thread[sector -> rSector], totalDim];\n     psiL = SparseArray[Thread[sector -> lSector], totalDim];\n     honest = Together[psiL . psiR];\n     sov = Together@Det@N2d[S, P, state, state, 2, 1];\n     <|\n      \"SP\" -> {S, P}, \"mu\" -> mu, \"sectorDimension\" -> Length[sector],\n      \"PsiR\" -> psiR, \"PsiL\" -> psiL, \"honestNorm\" -> honest,\n      \"SoVNorm\" -> sov, \"conversion\" -> Together[sov/honest],\n      \"oneDimensionalEigenlines\" -> ({Length[nullR], Length[nullL]} === {1, 1}),\n      \"tau1Right\" -> hnZeroVectorQ[t1 . psiR - lambda1 psiR],\n      \"tau1Left\" -> hnZeroVectorQ[Transpose[t1] . psiL - lambda1 psiL],\n      \"tau2Right\" -> hnZeroVectorQ[t2 . psiR - lambda2 psiR],\n      \"tau2Left\" -> hnZeroVectorQ[Transpose[t2] . psiL - lambda2 psiL]\n      |>\n     ], {state, states[S, P]}]\n   ];\n\nhonestNormData = Flatten[honestStateData @@@ {{1, 1}, {2, 1}, {2, 2}}, 1];\nGrid[\n Prepend[\n  (With[{checks = And[#[\"oneDimensionalEigenlines\"], #[\"tau1Right\"], #[\"tau1Left\"], #[\"tau2Right\"], #[\"tau2Left\"]]},\n      {#[\"SP\"], #[\"mu\"], #[\"sectorDimension\"], #[\"honestNorm\"], #[\"SoVNorm\"], #[\"conversion\"], checks}] &) /@ honestNormData,\n  {\"(S,P)\", \"mu\", \"weight-sector dim\", \"PsiL.PsiR\", \"det N\", \"C = det N/(PsiL.PsiR)\", \"all eigenvector checks\"}],\n Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"969947\" data-output-id=\"3\" data-out-n=\"43\" data-sub-idx=\"6\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"19\" data-sub-start=\"48\" data-sub-end=\"53\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[43]=</span></div><div class=\"wl-output-content\"><div data-wolfram-is-skeleton=\"1\" data-wolfram-atom-count=\"4664\"><div class=\"vscode-wolfram-wllatex-prerendered wl-lb-pending\" data-lb-id=\"lb-mty9qxsb-fiqubso\" data-page-width-em=\"10\" data-latex-b64=\"\" style=\"opacity:0.65;transition:opacity 0.35s\"><div class=\"wl-lb-content\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:15.76em;vertical-align:-7.61em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.15em;\"><span style=\"top:-10.11em;\"><span class=\"pstrut\" style=\"height:10.11em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:15.72em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-7.61em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.11em;\"><span style=\"top:-10.27em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">(S,P)</span></span></span></span><span style=\"top:-9.06em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"m