                                    7     21                     441     1323\\nDet::matsq: Argument {rowFull[1, 1, vacuumState[1, 1], vacuumState[1, 1], 3, 3], rowFull[1, 1, vacuumState[1, 1], vacuumState[1, 1], 4, 4]} at position 1 is not a non-empty square matrix.\\nDet::matsq: Argument {rowFull[1, 1, <|mu -> {2, 1, 1, 0}, tc -> {-, ----, -(----), -(---), ---}, q -> {{1}, {0, -(--), 1}, {0, -(-), 0, 1}, {0, -(---), 0, 0, -(--), 1}}, qd -> <|4 -> {1}, 3 -> {0, -(--), 1}, 2 -> {0, -(--), 0, 1}, 1 -> {0, ----, 0, 0, -(---), 1}|>|>, <|mu -> {2, 1, 1, 0}, tc -> {-, ----, -(----), -(---), ---}, q -> {{1}, {0, -(--), 1}, {0, -(-), 0, 1}, {0, -(---), 0, 0, -(--), 1}}, qd -> <|4 -> {1}, 3 -> {0, -(--), 1}, 2 -> {0, -(--), 0, 1}, 1 -> {0, ----, 0, 0, -(---), 1}|>|>, 3, 3], rowFull[1, 1, <|mu -> {2, 1, 1, 0}, tc -> {-, ----, -(----), -(---), ---}, q -> {{1}, {0, -(--), 1}, {0, -(-), 0, 1}, {0, -(---), 0, 0, -(--), 1}}, qd -> <|4 -> {1}, 3 -> {0, -(--), 1}, 2 -> {0, -(--), 0, 1}, 1 -> {0, ----, 0, 0, -(---), 1}|>|>, <|mu -> {2, 1, 1, 0}, tc -> {-, ----, -(----), -(---), ---}, q -> {{1}, {0, -(--), 1}, {0, -(-), 0, 1}, {0, -(---), 0, 0, -(--), 1}}, qd -> <|4 -> {1}, 3 -> {0, -(--), 1}, 2 -> {0, -(--), 0, 1}, 1 -> {0, ----, 0, 0, -(---), 1}|>|>, 4, 4]} at position 1 is not a non-empty square matrix.                                                                  7  147     147      441   21                     21             7                441           21                                     21                  7                     63           21                                         7  147     147      441   21                     21             7                441           21                                     21                  7                     63           21                                                              7  147     147      441   21                     21             7                441           21                                     21    