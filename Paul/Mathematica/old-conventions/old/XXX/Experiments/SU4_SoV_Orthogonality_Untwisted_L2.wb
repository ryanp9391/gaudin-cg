   "kind": 2,
   "value": "(* ---- 7. Worked example, (S,P) = (1,1), (i,j) = (2,1). ---- *)\nex = Association[#[\"mu\"] -> # & /@ states[1, 1]];\nexNorm = N2[1, 1, ex[{2, 1, 1, 0}], ex[{2, 1, 1, 0}], 2, 1];\nexCross = N2[1, 1, ex[{2, 2, 0, 0}], ex[{2, 1, 1, 0}], 2, 1];\nexD = invs[1, 1, ex[{2, 2, 0, 0}], ex[{2, 1, 1, 0}]];\nGrid[{{\"q_2 of {2,1,1,0}\", qpoly[ex[{2, 1, 1, 0}][\"q\"][[2]], u]}, {\"q^1 of {2,1,1,0}\", qpoly[ex[{2, 1, 1, 0}][\"qd\"][1], u]}, {\"q^1 of {2,2,0,0}\", qpoly[ex[{2, 2, 0, 0}][\"qd\"][1], u]},\n  {\"N, A = B = {2,1,1,0}\", MatrixForm[exNorm]}, {\"det\", Together[Det[exNorm]]},\n  {\"N, A = {2,2,0,0}, B = {2,1,1,0}\", MatrixForm[exCross]}, {\"det\", Together[Det[exCross]]}, {\"(Δtc1, Δc)\", exD}, {\"N.(Δtc1, Δc)\", Together[exCross . exD]}}, Frame -> All, Alignment -> Left]",
