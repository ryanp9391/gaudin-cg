rmal mtight\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord mtight\">1</span><span class=\"mspace mtight\" style=\"margin-right:0.1952em;\"></span><span class=\"mord mtight\"><span class=\"mord mathrm mtight\">sSpin</span></span><span class=\"mspace mtight\" style=\"margin-right:0.1952em;\"></span><span class=\"mord mtight\"><span class=\"mord mathrm mtight\">qDirectSymbolic</span></span><span class=\"minner mtight\"><span class=\"mopen mtight delimcenter\" style=\"top:0em;\"><span class=\"mtight\">(</span></span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord mtight\">1</span><span class=\"mbin mtight\">−</span><span class=\"mord mathnormal mtight\">h</span><span class=\"mclose mtight delimcenter\" style=\"top:0em;\"><span class=\"mtight\">)</span></span></span><span class=\"mspace mtight\" style=\"margin-right:0.1952em;\"></span><span class=\"mord mtight\"><span class=\"mord mathrm mtight\">qDirectSymbolic</span></span><span class=\"minner mtight\"><span class=\"mopen mtight delimcenter\" style=\"top:0em;\"><span class=\"mtight\">(</span></span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord mtight\">2</span><span class=\"mbin mtight\">−</span><span class=\"mord mathnormal mtight\">h</span><span class=\"mclose mtight delimcenter\" style=\"top:0em;\"><span class=\"mtight\">)</span></span></span><span class=\"mbin mtight\">+</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord mtight\">2</span><span class=\"mspace mtight\" style=\"margin-right:0.1952em;\"></span><span class=\"mord mtight\"><span class=\"mord mathrm mtight\">sSpin</span></span><span class=\"mspace mtight\" style=\"margin-right:0.1952em;\"></span><span class=\"mord mtight\"><span class=\"mord mathrm mtight\">qDirectSymbolic</span></span><span class=\"minner mtight\"><span class=\"mopen mtight delimcenter\" style=\"top:0em;\"><span class=\"mtight\">(</span></span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord mtight\">1</span><span class=\"mbin mtight\">−</span><span class=\"mord mathnormal mtight\">h</span><span class=\"mclose mtight delimcenter\" style=\"top:0em;\"><span class=\"mtight\">)</span></span></span><span class=\"mspace mtight\" style=\"margin-right:0.1952em;\"></span><span class=\"mord mtight\"><span class=\"mord mathrm mtight\">qDirectSymbolic</span></span><span class=\"minner mtight\"><span class=\"mopen mtight delimcenter\" style=\"top:0em;\"><span class=\"mtight\">(</span></span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord mtight\">2</span><span class=\"mbin mtight\">−</span><span class=\"mord mathnormal mtight\">h</span><span class=\"mclose mtight delimcenter\" style=\"top:0em;\"><span class=\"mtight\">)</span></span></span><span class=\"mclose mtight delimcenter\" style=\"top:0em;\"><span class=\"mtight\">)</span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.9572em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span><span style=\"top:5.3612em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.1712em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:18.8424em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-9.1712em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-5.7856em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.8712em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.9568em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.364em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-14.7712em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-16.8568em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-18.9424em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-20.1424em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-21.3424em;\"><span class=\"pstrut\" style=\"height:11.6712em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.1712em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[523]= \\begin{array}{|c|c|}\\hline\\text{first pole on ladder 1} & \\theta1\\\\\\hline\\text{first pole on ladder 2} & \\theta2\\\\\\hline\\text{measure residue at theta1} & \\frac{\\left(-1\\right)^{\\mathrm{sSpin}+1}\\,\\left(-h\\right)^{-\\mathrm{pSpin}-1}\\,h^{-\\mathrm{sSpin}-1}}{\\left(\\mathrm{sSpin}+1\\right)\\lnot \\,\\left(\\theta1-\\theta2\\right)\\,\\left(\\frac{h-\\theta1+\\theta2}{h}\\right)_{\\mathrm{pSpin}+1}}\\\\\\hline\\text{measure residue at theta2} & \\frac{\\left(-1\\right)^{\\mathrm{pSpin}+1}\\,h^{-\\mathrm{pSpin}-2}\\,\\left(-h\\right)^{-\\mathrm{sSpin}}}{\\left(\\mathrm{pSpin}+1\\right)\\lnot \\,\\left(\\theta1-\\theta2\\right)\\,\\left(\\frac{h+\\theta1-\\theta2}{h}\\right)_{\\mathrm{sSpin}+1}}\\\\\\hline\\text{r\\_(1,0)} & \\left\\{\\frac{\\left(-1\\right)^{\\mathrm{sSpin}+1}\\,\\left(\\mathrm{sSpin}+1\\right)\\,\\left(-h\\right)^{-\\mathrm{pSpin}-1}\\,h^{-\\mathrm{sSpin}}\\,\\mathrm{qDualSymbolic}\\left(\\theta1\\right)\\,\\left(\\mathrm{qDirectSymbolic}\\left(\\theta1\\right)-\\mathrm{qDirectSymbolic}\\left(\\theta1-h\\right)\\right)\\,\\left(-h\\,\\left(\\mathrm{pSpin}+1\\right)+\\theta1-\\theta2\\right)}{\\left(\\mathrm{sSpin}+1\\right)\\lnot \\,\\left(\\theta1-\\theta2\\right)\\,\\left(\\frac{h-\\theta1+\\theta2}{h}\\right)_{\\mathrm{pSpin}+1}},\\frac{\\left(-1\\right)^{\\mathrm{sSpin}+1}… [latex truncated: 6895 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "52a3f1a8-e010-4f50-bad0-1312e6d87e7c"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "Therefore the first residue does not contain only $Q(\\theta_s)$. For the difference-form matrix it contains\n$$\nq_A^{\\,j}(\\theta_s),\\qquad\nq_i^A(\\theta_s-h),\\qquad\nq_i^A(\\theta_s)-q_i^A(\\theta_s-h).\n$$\nThe dual function is unshifted because it multiplies the measure directly. The direct function is shifted in column two, while column one contains its backward finite difference. The formula is universal: for any allowed pairing, substitute $\\mathcal Q=q^j$, $Q=q_i$, followed by the desired $S,P$.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### 5.4 Normalization by the first residue-pair term\n\nWhenever $D_{00}\\neq0$, define\n$$\nN^{(00)}_{i,j;S,P}(A)=\\frac{\\det N^{AA}_{i,j;S,P}}{D_{00}^{A;i,j}}.\n$$\nThe residue-pair expansion gives the exact identity\n$$\nN^{(00)}_{i,j;S,P}(A)\n=1+\\sum_{(k,\\ell)\\neq(0,0)}\n  \\frac{D_{k\\ell}^{A;i,j}}{D_{00}^{A;i,j}}.\n$$\nThis normalization is state- and pairing-dependent. It is valid only away from zeros of $D_{00}$.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 15. Normalize every allowed norm by its own first residue-pair term D00. ---- *)\nClearAll[D00, ND00normalized, D00remainderRatio, d00NormData, d00Summary];\nD00[S_, P_, state_, i_, j_] := Module[\n   {hh = h /. prm, t1 = θ1 /. prm, t2 = θ2 /. prm, qa, qb, dq, rho1, rho2},\n   qa[x_] := qpoly[state[\"qd\"][j], x];\n   qb[x_] := qpoly[state[\"q\"][[i]], x];\n   dq[x_] := qb[x] - qb[x - hh];\n   rho1 = (-1)^(S + 1)/\n     (hh^(S + 1) Factorial[S + 1] Product[t1 - t2 - k hh, {k, 0, P + 1}]);\n   rho2 = (-1)^(P + 1)/\n     (hh^(P + 1) Factorial[P + 1] Product[t2 - t1 - k hh, {k, 0, S + 1}]);\n   Together[rho1 rho2 qa[t1] qa[t2] hh (\n      (S + 1) (t1 - t2 - (P + 1) hh) dq[t1] qb[t2 - hh]\n      + (P + 1) (t1 - t2 + (S + 1) hh) qb[t1 - hh] dq[t2])]\n   ];\n\nND00normalized[S_, P_, state_, i_, j_] :=\n   Together[NAA[S, P, state, i, j]/D00[S, P, state, i, j]];\n\nD00remainderRatio[S_, P_, state_, i_, j_] :=\n   Together[(NAA[S, P, state, i, j] - D00[S, P, state, i, j])/\n     D00[S, P, state, i, j]];\n\nd00NormData = Map[\n   Function[row, Module[\n     {sp = row[\"SP\"], pair = row[\"pairing\"], state, d00, raw},\n     state = First@Select[states @@ sp, #[\"mu\"] === row[\"mu\"] &];\n     raw = row[\"NAA\"];\n     d00 = D00[sp[[1]], sp[[2]], state, pair[[1]], pair[[2]]];\n     Join[row, <|\n       \"D00\" -> d00,\n       \"D00nonzero\" -> (d00 =!= 0),\n       \"normalizedByD00\" -> If[d00 === 0, Missing[\"ZeroD00\"], Together[raw/d00]],\n       \"remainderRatio\" -> If[d00 === 0, Missing[\"ZeroD00\"], Together[(raw - d00)/d00]]\n       |>]\n     ]],\n   pairingNormData];\n\nd00Summary = Table[\n   With[{rows = Select[d00NormData, #[\"pairing\"] === pair &]},\n    {pair,\n     Count[rows, row_ /; row[\"D00nonzero\"]],\n     Count[rows, row_ /; row[\"D00nonzero\"] &&\n       Together[row[\"normalizedByD00\"] - (1 + row[\"remainderRatio\"])] === 0]}\n    ], {pair, allowedPairings}];\n\nGrid[{\n  {Grid[\n    Prepend[d00Summary,\n     {\"(i,j)\", \"D00 nonzero, of 12\", \"normalized = 1 + remainder ratio, exact\"}],\n    Frame -> All, Alignment -> Left]},\n  {Grid[{\n     {\"D00 nonzero over all 96 records\",\n      Count[d00NormData, row_ /; row[\"D00nonzero\"]]},\n     {\"exact 1 + remainder identities\",\n      Count[d00NormData, row_ /; row[\"D00nonzero\"] &&\n        Together[row[\"normalizedByD00\"] - (1 + row[\"remainderRatio\"])] === 0]},\n     {\"records stored in d00NormData\", Length[d00NormData]}\n     }, Frame -> All, Alignment -> Left]}\n  }, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"331408\" data-output-id=\"70\" data-out-n=\"530\" data-sub-idx=\"7\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"31\" data-sub-start=\"46\" data-sub-end=\"59\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[530]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"10\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:14.48em;vertical-align:-6.99em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:7.49em;\"><span style=\"top:-9.49em;\"><span class=\"pstrut\" style=\"height:7.69em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.69em;\"><span style=\"top:-7.65em;\"><span class=\"pstrut\" style=\"height:7.65em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:10.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-5.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.65em;\"><span style=\"top:-7.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">(i,j)</span></span></span></span><span style=\"top:-6.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mi