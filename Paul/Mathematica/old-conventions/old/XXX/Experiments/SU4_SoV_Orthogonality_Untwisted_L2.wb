       "data": "Out[55]= \\begin{array}{c}\\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{(S,P)} & \\text{mu} & \\text{j} & \\text{k} & \\text{NAA/Nvac} & \\text{PsiL.PsiR} & \\text{(PsiL.PsiR)/(NAA/Nvac)}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,2,0,0\\right\\} & 0 & 0 & \\frac{\\left|\\left\\{\\mathrm{rowFull}\\left(1,1,\\langle\\!\\lvert \\text{mu}\\to \\left\\{2,2,0,0\\right\\},\\text{tc}\\to \\left\\{\\frac{22}{7},\\frac{7214}{147},-\\frac{4472}{147},\\frac{3812}{441},\\frac{274}{21}\\right\\},\\text{q}\\to \\left\\{\\left\\{1\\right\\},\\left\\{0,1\\right\\},\\left\\{0,0,-\\frac{5}{7},-\\frac{20}{21},1\\right\\},\\left\\{0,0,\\frac{100}{441},-\\frac{2995}{1323},0,1\\right\\}\\right\\},\\text{qd}\\to \\langle\\!\\lvert 4\\to \\left\\{1\\right\\},3\\to \\left\\{0,1\\right\\},2\\to \\left\\{0,0,\\frac{57}{7},-\\frac{104}{21},1\\right\\},1\\to \\left\\{0,0,\\frac{16640}{441},-\\frac{22525}{1323},0,1\\right\\}\\rvert\\!\\rangle \\rvert\\!\\rangle ,\\langle\\!\\lvert \\text{mu}\\to \\left\\{2,2,0,0\\right\\},\\text{tc}\\to \\left\\{\\frac{22}{7},\\frac{7214}{147},-\\frac{4472}{147},\\frac{3812}{441},\\frac{274}{21}\\right\\},\\text{q}\\to \\left\\{\\left\\{1\\right\\},\\left\\{0,1\\right\\},\\left\\{0,0,-\\frac{5}{7},-\\frac{20}{21},1\\right\\},\\left\\{0,0,\\frac{100}{441},-\\frac{2995}{1323},0,1\\right\\}\\right\\},\\text{qd}\\to \\langle\\!\\lvert 4\\to \\lef… [latex truncated: 370144 chars total]",
