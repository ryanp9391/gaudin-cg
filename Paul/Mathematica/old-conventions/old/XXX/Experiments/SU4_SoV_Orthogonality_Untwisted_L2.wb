      {
       "data": "Out[649]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{(S,P)} & \\text{mu} & \\text{j} & \\text{k} & \\text{Qhat12\\^{}(1)} & \\text{1/(PsiL.PsiR)} & \\text{exact match}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,2,0,0\\right\\} & 0 & 0 & 1 & 1 & \\mathrm{True}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{2,1,1,0\\right\\} & 0 & 1 & \\frac{1}{2} & \\frac{1}{2} & \\mathrm{True}\\\\\\hline\\left\\{1,1\\right\\} & \\left\\{1,1,1,1\\right\\} & 1 & 1 & \\frac{1}{6} & \\frac{1}{6} & \\mathrm{True}\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,3,0,0\\right\\} & 0 & 0 & 1 & 1 & \\mathrm{True}\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{3,2,1,0\\right\\} & 0 & 1 & \\frac{2}{3} & \\frac{2}{3} & \\mathrm{True}\\\\\\hline\\left\\{2,1\\right\\} & \\left\\{2,2,1,1\\right\\} & 1 & 1 & \\frac{3}{10} & \\frac{3}{10} & \\mathrm{True}\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{4,4,0,0\\right\\} & 0 & 0 & 1 & 1 & \\mathrm{True}\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{4,3,1,0\\right\\} & 0 & 1 & \\frac{1}{2} & \\frac{1}{2} & \\mathrm{True}\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{4,2,2,0\\right\\} & 0 & 2 & \\frac{1}{3} & \\frac{1}{3} & \\mathrm{True}\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{3,3,1,1\\right\\} & 1 & 1 & \\frac{1}{5} & \\frac{1}{5} & \\mathrm{True}\\\\\\hline\\left\\{2,2\\right\\} & \\left\\{3,2,2,1\\right\\} & 1 & 2 & \\frac{1}{8} & \\fr… [latex truncated: 2239 chars total]",
