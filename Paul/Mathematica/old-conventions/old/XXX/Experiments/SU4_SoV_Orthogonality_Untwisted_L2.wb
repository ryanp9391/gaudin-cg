      {
       "data": "Out[449]= \\begin{array}{|c|c|c|c|}\\hline\\text{(i,j)} & \\text{nonzero norms (1,1), of 3} & \\text{(2,1), of 3} & \\text{(2,2), of 6}\\\\\\hline\\left\\{1,1\\right\\} & 0 & 0 & 0\\\\\\hline\\left\\{1,2\\right\\} & 0 & 0 & 0\\\\\\hline\\left\\{1,3\\right\\} & 0 & 0 & 0\\\\\\hline\\left\\{1,4\\right\\} & 0 & 0 & 0\\\\\\hline\\left\\{2,1\\right\\} & 3 & 3 & 6\\\\\\hline\\left\\{2,2\\right\\} & 3 & 3 & 6\\\\\\hline\\left\\{2,3\\right\\} & 0 & 0 & 0\\\\\\hline\\left\\{2,4\\right\\} & 0 & 0 & 0\\\\\\hline\\left\\{3,1\\right\\} & 3 & 3 & 6\\\\\\hline\\left\\{3,2\\right\\} & 3 & 3 & 6\\\\\\hline\\left\\{3,3\\right\\} & 3 & 3 & 6\\\\\\hline\\left\\{3,4\\right\\} & 0 & 0 & 0\\\\\\hline\\left\\{4,1\\right\\} & 3 & 3 & 6\\\\\\hline\\left\\{4,2\\right\\} & 3 & 3 & 6\\\\\\hline\\left\\{4,3\\right\\} & 3 & 3 & 6\\\\\\hline\\left\\{4,4\\right\\} & 0 & 0 & 0\\\\\\hline\\end{array}",
