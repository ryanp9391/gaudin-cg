  {
   "kind": 2,
   "value": "(* ---- 8. The diagonal n1=n2=n3 part is exactly Psi^A Psi^B; what is left over. ---- *)\nClearAll[diagPart, remain, contentOK, forcedTriples, nMon];\nnMon[e_] := Length[CoefficientRules[Expand[e], Union@Cases[e, qu[_, _] | qd[_, _], Infinity]]];\ndiagPart = Expand[Sum[resw[[n + 1]]^3 PsiA[{n, n, n}] PsiB[{n, n, n}], {n, 0, 2}]];\nremain = Expand[detN[trGood] - diagPart];\n(* content argument: row (i,j) supplies one Q_i and one Q^j, so Psi^B forces i-multiset {1,1,2} and Psi^A forces j-multiset {1,1,2} *)\ncontentOK[tr_] := Sort[tr[[All, 1]]] === {1, 1, 2} && Sort[tr[[All, 2]]] === {1, 1, 2};\nforcedTriples = Select[Subsets[allRows, {3}], contentOK];\nGrid[{\n  {\"triples with correct Q-content (both multisets {1,1,2})\", forcedTriples},\n  {\"diagonal terms n1=n2=n3 equal m_n^3 Psi^A(n,n,n) Psi^B(n,n,n)\", And @@ Table[Expand[termOf[{n, n, n}] - PsiA[{n, n, n}] PsiB[{n, n, n}]] === 0, {n, 0, 2}]},\n  {\"# monomials in det N, in the diagonal part, in the remainder\", {nMon[detN[trGood]], nMon[diagPart], nMon[remain]}},\n  {\"remainder vanishes?\", remain === 0},\n  {\"det N = sum_x m(x) Psi^A(x) Psi^B(x) solvable for any weights?\", fitPsi[trGood]}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
