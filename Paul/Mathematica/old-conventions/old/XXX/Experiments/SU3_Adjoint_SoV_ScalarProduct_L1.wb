      {
       "data": "Out[47]= \\begin{array}{|c|c|}\\hline\\text{triple (i,j)} & \\text{status}\\\\\\hline\\begin{pmatrix}1 & 1\\\\2 & 1\\\\2 & 2\\end{pmatrix} & \\text{NO SOLUTION}\\\\\\hline\\begin{pmatrix}1 & 1\\\\1 & 2\\\\2 & 1\\end{pmatrix} & \\text{NO SOLUTION}\\\\\\hline\\begin{pmatrix}1 & 1\\\\1 & 2\\\\2 & 2\\end{pmatrix} & \\text{NO SOLUTION}\\\\\\hline\\begin{pmatrix}1 & 2\\\\2 & 1\\\\2 & 2\\end{pmatrix} & \\text{NO SOLUTION}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
