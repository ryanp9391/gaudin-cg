      {
       "data": "Out[73]= \\begin{array}{|c|c|c|}\\hline\\text{(n1,n2,n3)} & \\text{dual factor as Psi\\^{}A} & \\text{direct factor as Psi\\^{}B}\\\\\\hline\\left\\{0,0,0\\right\\} & \\left\\{\\left\\{0,1,-1\\right\\},-1\\right\\} & \\left\\{\\left\\{0,0,0\\right\\},1\\right\\}\\\\\\hline\\left\\{0,0,1\\right\\} & \\left\\{\\left\\{1,1,-1\\right\\},-1\\right\\} & \\text{not a Psi\\^{}B}\\\\\\hline\\left\\{0,0,2\\right\\} & \\left\\{\\left\\{2,1,-1\\right\\},-1\\right\\} & \\text{not a Psi\\^{}B}\\\\\\hline\\left\\{0,1,0\\right\\} & \\text{not a Psi\\^{}A} & \\left\\{\\left\\{1,0,0\\right\\},1\\right\\}\\\\\\hline\\left\\{0,1,1\\right\\} & \\text{not a Psi\\^{}A} & \\text{not a Psi\\^{}B}\\\\\\hline\\left\\{0,1,2\\right\\} & \\text{not a Psi\\^{}A} & \\text{not a Psi\\^{}B}\\\\\\hline\\left\\{0,2,0\\right\\} & \\text{not a Psi\\^{}A} & \\left\\{\\left\\{2,0,0\\right\\},1\\right\\}\\\\\\hline\\left\\{0,2,1\\right\\} & \\text{not a Psi\\^{}A} & \\text{not a Psi\\^{}B}\\\\\\hline\\left\\{0,2,2\\right\\} & \\text{not a Psi\\^{}A} & \\text{not a Psi\\^{}B}\\\\\\hline\\left\\{1,0,0\\right\\} & \\text{not a Psi\\^{}A} & \\text{not a Psi\\^{}B}\\\\\\hline\\left\\{1,0,1\\right\\} & \\text{not a Psi\\^{}A} & \\left\\{\\left\\{0,1,1\\right\\},-1\\right\\}\\\\\\hline\\left\\{1,0,2\\right\\} & \\text{not a Psi\\^{}A} & \\text{not a Psi\\^{}B}\\\\\\hline\\left\\{1,1,0\\right\\} & \\left\\{\\left\\{0,2,0\\right… [latex truncated: 2486 chars total]",
       "mime": "text/plain"
      }
