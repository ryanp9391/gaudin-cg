  {
   "kind": 2,
   "value": "(* ---- 5. Diagnostic: split det N into (dual monomial) x (direct polynomial) and test span membership. ---- *)\nClearAll[dualVars, dirVars, splitSides, inSpanQ, spanRep, diagTab];\ndualVars[e_] := Union@Cases[e, qd[_, _], Infinity];\ndirVars[e_] := Union@Cases[e, qu[_, _], Infinity];\n(* association: dual monomial -> cubic polynomial in the qu's *)\nsplitSides[e_] := Module[{dv = dualVars[e], uv = dirVars[e], cr},\n   cr = CoefficientRules[Expand[e], Join[dv, uv]];\n   Merge[Table[(Times @@ (dv^r[[1, 1 ;; Length[dv]]])) -> r[[2]] (Times @@ (uv^r[[1, Length[dv] + 1 ;;]])), {r, cr}], Total]];\n(* exact span membership of p in span[basis], both polynomials in the same variables *)\ninSpanQ[p_, basis_] := Module[{vs, mons, mat, vec, c},\n   vs = Union@Cases[Prepend[basis, p], qu[_, _] | qd[_, _], Infinity];\n   mons = Union@Flatten[First /@ CoefficientRules[#, vs] & /@ Prepend[basis, p], 1];\n   mat = Transpose@Table[Lookup[Association[CoefficientRules[b, vs]], Key /@ mons, 0], {b, basis}];\n   vec = Lookup[Association[CoefficientRules[p, vs]], Key /@ mons, 0];\n   c = Array[cc, Length[basis]];\n   If[Solve[Thread[mat . c == vec], c] === {}, False, True]];\ndiagTab = Table[Module[{ss = splitSides[detN[tr]], bB = PsiB /@ confs, bA = PsiA /@ confs, ssA},\n    ssA = splitSides[detN[tr] /. {qu[i_, n_] :> qd[i, n], qd[j_, n_] :> qu[j, n]}];\n    {tr, Length[ss], And @@ (inSpanQ[#, bB] & /@ Values[ss]), And @@ (inSpanQ[#, bA /. {qd -> qu}] & /@ Values[ssA] /. {} -> True)}],\n   {tr, cand}];\nGrid[Prepend[diagTab, {\"triple\", \"# dual monomials\", \"direct side in span Psi^B\", \"dual side in span Psi^A\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
