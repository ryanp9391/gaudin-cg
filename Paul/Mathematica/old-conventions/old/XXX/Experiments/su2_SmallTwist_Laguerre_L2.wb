      {
       "data": "Out[17]= \\begin{array}{|c|c|c|}\\hline\\text{state} & \\text{-2 phi u\\_inf} & \\text{Laguerre zeros}\\\\\\hline\\text{J=2 (m=2, Mhw=0)} & \\left\\{2.7639316524998208,7.236067607499328\\right\\} & \\left\\{2.76393202250021,7.23606797749979\\right\\}\\\\\\hline\\text{J=1 (m=1, Mhw=1)} & \\left\\{5.9999996299993335\\right\\} & \\left\\{6.\\,\\right\\}\\\\\\hline\\text{J=0 (m=0)} & \\left\\{-0.2698,0.6398\\right\\} & \\text{-}\\\\\\hline\\end{array}",
