       "data": "Out[14]= \\begin{array}{|c|c|c|c|}\\hline\\text{phi} & \\text{state 1} & \\text{state 2} & \\text{state 3}\\\\\\hline\\frac{1}{100} & \\left\\{-361.616,-138.010\\right\\} & \\left\\{-299.812,0.191895\\right\\} & \\left\\{-0.263718,0.645901\\right\\}\\\\\\hline\\frac{1}{1000} & \\left\\{-3617.85,-1381.78\\right\\} & \\left\\{-2999.81,0.185689\\right\\} & \\left\\{-0.269193,0.640411\\right\\}\\\\\\hline\\frac{1}{10000} & \\left\\{-36180.2,-13819.5\\right\\} & \\left\\{-29999.8,0.185069\\right\\} & \\left\\{-0.269741,0.639863\\right\\}\\\\\\hline\\end{array}",
