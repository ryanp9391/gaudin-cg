      {
       "data": "Out[21]= \\begin{matrix}\\left\\{1\\right\\}\\\\\\left\\{1\\right\\}\\\\\\left\\{1,\\frac{2144\\,\\mathrm{i}\\,\\mathrm{eps}^3}{69568625}-\\frac{32\\,\\mathrm{eps}^2}{64715}+\\frac{28\\,\\mathrm{i}\\,\\mathrm{eps}}{215},-\\frac{8\\,\\mathrm{eps}^2}{1075}-\\frac{32\\,\\mathrm{i}\\,\\mathrm{eps}^3}{138675}\\right\\}\\\\\\left\\{1,\\frac{67314994208\\,\\mathrm{i}\\,\\mathrm{eps}^3}{5644097890875}-\\frac{10754912\\,\\mathrm{eps}^2}{91439415}+\\frac{5852\\,\\mathrm{i}\\,\\mathrm{eps}}{4115},-\\frac{141512\\,\\mathrm{eps}^2}{185175}-\\frac{118304032\\,\\mathrm{i}\\,\\mathrm{eps}^3}{457197075}\\right\\}\\end{matrix}",
