       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[9]= \\begin{aligned}\n  &\\left\\{\\text{1. twist and transfer matrices loaded} \\right. \\\\\n  &\\left. ,\\left\\{\\text{2. solver loaded; unimodular?},\\mathrm{True}\\right\\} \\right. \\\\\n  &\\left. ,\\text{3. Q-functions and operators loaded} \\right. \\\\\n  &\\left. ,\\text{4. scalar product loaded}\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
