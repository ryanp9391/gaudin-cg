      {
       "data": "Out[79]= \\begin{array}{|c|c|c|c|}\\hline\\text{order N} & \\text{Mhat} & \\text{\\#determined} & \\text{still free (branch mixing)}\\\\\\hline1 & \\left\\{0,1,4,5\\right\\} & 21 & \\left\\{\\mathrm{pcn}\\left(1,1,1\\right),\\mathrm{pcn}\\left(3,2,1\\right)\\right\\}\\\\\\hline2 & \\left\\{0,1,4,5\\right\\} & 45 & \\left\\{\\mathrm{pcn}\\left(1,1,1\\right),\\mathrm{pcn}\\left(3,2,1\\right),\\mathrm{pcn}\\left(1,1,2\\right),\\mathrm{pcn}\\left(3,2,2\\right),\\mathrm{tcn}\\left(1,2\\right)\\right\\}\\\\\\hline3 & \\left\\{0,1,4,5\\right\\} & 45 & \\left\\{\\mathrm{pcn}\\left(1,1,1\\right),\\mathrm{pcn}\\left(3,2,1\\right),\\mathrm{pcn}\\left(1,1,2\\right),\\mathrm{pcn}\\left(3,2,2\\right),\\mathrm{tcn}\\left(1,2\\right)\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
