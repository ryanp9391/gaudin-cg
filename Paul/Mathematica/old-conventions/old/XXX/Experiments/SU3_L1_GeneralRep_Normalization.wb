  {
   "kind": 2,
   "value": "(* ---- 2. All eigenstates at finite twist: Q-functions and the physical normalized norm S = 1/(<L|0><0|R>). ---- *)\nClearAll[statesK, stateTabK];\n\n(* Vacuum (weight = lambda) first. Left eigenvectors = rows of the sector-block inverse, so <L_A|R_A> = 1. *)\nstatesK[r_] := statesK[r] = Module[{coef, bra, ket, recs},\n   setupRepK[r];\n   Do[coef[a, k] = N[Coefficient[TK[a], u, k], precK], {a, 2}, {k, 0, a}];\n   bra = N[refBraK[zK], precK]; ket = N[refKetK[zK], precK];\n   recs = Flatten[Table[Module[{idx = Flatten@Position[wtK, wt], K, vals, vecs, Linv},\n       K = Sum[rhoK[a, k] coef[a, k][[idx, idx]], {a, 2}, {k, 0, a}];\n       {vals, vecs} = Eigensystem[K];\n       vecs = Table[vv/vv[[First@Ordering[-Abs[vv], 1]]], {vv, vecs}];\n       Linv = Inverse[Transpose[vecs]];\n       Table[Module[{vv = vecs[[s]], p, t1, t2, qs, qds},\n         p = First@Ordering[-Abs[vv], 1];\n         t1 = Sum[(coef[1, k][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 1}];\n         t2 = Sum[(coef[2, k][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 2}];\n         qs = Table[solveMonicK[BaxDirK[t1, t2, zNK[[i]]], r[[1]] - wt[[i]]], {i, 3}];\n         qds = Table[solveMonicK[BaxDualK[t1, t2, 1/zNK[[j]]], wt[[j]]], {j, 3}];\n         <|\"mu\" -> wt, \"q\" -> qs[[All, 1]], \"qd\" -> qds[[All, 1]], \"bRes\" -> Max[Join[qs[[All, 2]], qds[[All, 2]]]],\n          \"eigRes\" -> Max[Flatten@Table[Abs[coef[a, k][[idx, idx]].vv - Coefficient[{t1, t2}[[a]], u, k] vv], {a, 2}, {k, 0, a}]],\n          \"S\" -> 1/((Linv[[s]].ket[[idx]]) (bra[[idx]].vv))|>], {s, Length[vecs]}]], {wt, Union[wtK]}], 1];\n   SortBy[recs, If[#[\"mu\"] == r, 0, 1] &]];\n\nstateTabK = Table[With[{st = statesK[r]}, {Row[r, \",\"], Length[st], N[Max[st[[All, \"eigRes\"]]], 3], N[Max[st[[All, \"bRes\"]]], 3],\n     st[[1, \"mu\"]] == r}], {r, repsK}];\nGrid[Prepend[stateTabK, {\"rep\", \"# states\", \"max eigen residual\", \"max Baxter residual (deg l1-mu_i, mu_j)\", \"vacuum first\"}],\n Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
