       "data": "Out[792]= \\begin{array}{|c|c|c|c|}\\hline\\text{rep} & \\text{dim} & \\text{T3 = nu1(u-2) nu2(u-1) nu3(u)} & \\text{T1, T2 coefficients commute}\\\\\\hline1,0,0 & 3 & \\mathrm{True} & \\mathrm{True}\\\\\\hline1,1,0 & 3 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2,0,0 & 6 & \\mathrm{True} & \\mathrm{True}\\\\\\hline3,0,0 & 10 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2,1,0 & 8 & \\mathrm{True} & \\mathrm{True}\\\\\\hline3,1,0 & 15 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2,2,0 & 6 & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
