><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.1em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[796]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{rep} & \\text{\\# states} & \\text{max eigen residual} & \\text{max Baxter residual (deg l1-mu\\_i, mu\\_j)} & \\text{vacuum first}\\\\\\hline1,0,0 & 3 & 0.\\times 10^{-146} & 0.\\times 10^{-144} & \\mathrm{True}\\\\\\hline1,1,0 & 3 & 0.\\times 10^{-146} & 0.\\times 10^{-144} & \\mathrm{True}\\\\\\hline2,0,0 & 6 & 0.\\times 10^{-147} & 0.\\times 10^{-144} & \\mathrm{True}\\\\\\hline3,0,0 & 10 & 0.\\times 10^{-147} & 0.\\times 10^{-143} & \\mathrm{True}\\\\\\hline2,1,0 & 8 & 0.\\times 10^{-146} & 0.\\times 10^{-143} & \\mathrm{True}\\\\\\hline3,1,0 & 15 & 0.\\times 10^{-145} & 0.\\times 10^{-143} & \\mathrm{True}\\\\\\hline2,2,0 & 6 & 0.\\times 10^{-146} & 0.\\times 10^{-144} & \\mathrm{True}\\\\\\hline\\end{array}",
