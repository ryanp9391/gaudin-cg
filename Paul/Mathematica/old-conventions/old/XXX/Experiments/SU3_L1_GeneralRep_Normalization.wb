  {
   "kind": 2,
   "value": "(* ---- 3. det N, its formal residue expansion, and which SoV label gives det N/(c[ns] Psi_B[ns]) proportional to S. ---- *)\nClearAll[polesK, wK, QDK, QUK, tripleK, rowK, detNK, orthoK, rowFK, detFK, labelsK, psiFK, cFK, numOfK, labelTestK, labelTabK, au, ad];\n\npolesK[r_] := Range[r[[3]], r[[1]]];\nwK[r_, n_] := 1/Times @@ (n - DeleteCases[polesK[r], n]);\n(* Full twisted Q's at theta + n (exponentials kept). *)\nQDK[s_, i_, n_] := zNK[[i]]^(thetaK + n) qpolyK[s[\"q\"][[i]], thetaK + n];\nQUK[s_, j_, n_] := zNK[[j]]^(-(thetaK + n)) qpolyK[s[\"qd\"][[j]], thetaK + n];\ntripleK = {{1, 3}, {1, 2}, {2, 3}};\nrowK[r_, A_, B_, {i_, j_}] := Sum[wK[r, n] {-QUK[A, j, n] QDK[B, i, n], QUK[A, j, n] QDK[B, i, n - 1], QUK[A, j, n + 1] QDK[B, i, n]},\n   {n, polesK[r]}];\ndetNK[r_, A_, B_] := Det[rowK[r, A, B, #] & /@ tripleK];\n\n(* Orthogonality over all pairs of states of the rep. *)\northoK[r_] := With[{st = statesK[r]}, With[{dm = Table[detNK[r, st[[a]], st[[b]]], {a, Length[st]}, {b, Length[st]}]},\n    N[Max[Abs[dm - DiagonalMatrix[Diagonal[dm]]]]/Min[Abs[Diagonal[dm]]], 3]]];\n\n(* Formal: au[i,n] = Q_i(theta+n), ad[j,n] = Q^j(theta+n). *)\nrowFK[r_, {i_, j_}] := Sum[wK[r, n] {-ad[j, n] au[i, n], ad[j, n] au[i, n - 1], ad[j, n + 1] au[i, n]}, {n, polesK[r]}];\ndetFK[r_] := detFK[r] = Expand[Det[rowFK[r, #] & /@ tripleK]];\n\n(* SoV labels (n21; n11, n12) = (m12; m11, m22) from the GT patterns {{m11},{m12,m22},lambda}. *)\nlabelsK[r_] := Union[Table[{p[[2, 1]], p[[1, 1]], p[[2, 2]]}, {p, ps[{r}]}]];\npsiFK[{a_, b_, c_}] := au[1, a] (au[1, b] au[2, c - 1] - au[2, b] au[1, c - 1]);\n(* c[ns] = coefficient of the first monomial of Psi_B[ns]; \"consistent\" if the second monomial carries -c[ns]. *)\ncFK[r_, {a_, b_, c_}] := Module[{c1 = Coefficient[detFK[r], au[1, a] au[1, b] au[2, c - 1]], c2 = Coefficient[detFK[r], au[1, a] au[2, b] au[1, c - 1]]},\n   <|\"c\" -> c1, \"consistent\" -> (Expand[c1 + c2] === 0), \"zero\" -> (c1 === 0)|>];\nnumOfK[expr_, A_, B_] := expr /. {ad[j_, n_] :> QUK[A, j, n], au[i_, n_] :> QDK[B, i, n]};\n\n(* For a label: spread over all states of det N_AA/(c[ns]_A Psi_B[ns]_A)/S_A, relative to the vacuum. *)\nlabelTestK[r_, lab_] := Module[{st = statesK[r], cc = cFK[r, lab], vals},\n   If[cc[\"zero\"], Return[{lab, cc[\"consistent\"], \"c = 0\", \"-\"}]];\n   vals = Table[Quiet@Check[detNK[r, s, s]/(numOfK[cc[\"c\"], s, s] numOfK[psiFK[lab], s, s])/s[\"S\"], Indeterminate], {s, st}];\n   {lab, cc[\"consistent\"], If[FreeQ[vals, Indeterminate | ComplexInfinity], N[Max[Abs[vals/vals[[1]] - 1]], 3], \"singular\"],\n    If[FreeQ[vals, Indeterminate | ComplexInfinity], N[vals[[1]], 6], \"-\"]}];\n\nlabelTabK = Table[r -> labelTestK[r, #] & /@ labelsK[r], {r, repsK}];\n\nColumn[Table[With[{r = repsK[[k]]},\n    Column[{Row[{\"rep \", Row[r, \",\"], \":  orthogonality (max cross/min diag) = \", orthoK[r],\n        \",  lowest-GT label (lambda2; lambda3, lambda3) = \", Row[{r[[2]], r[[3]], r[[3]]}, \",\"]}],\n      Grid[Prepend[labelTabK[[k]][[All, 2]] /. {lab_List, a_, b_, c_} :> {Row[lab, \",\"], a, b, c},\n        {\"label (n21;n11,n12)\", \"c[ns] consistent\", \"spread of det N/(c Psi)/S\", \"value (vacuum) = 1/C_vac\"}], Frame -> All, Alignment -> Left]}]],\n   {k, Length[repsK]}]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"70\" data-out-n=\"814\" data-sub-idx=\"24\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"3\" data-sub-start=\"38\" data-sub-end=\"43\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[814]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"9\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:78.28em;vertical-align:-38.89em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:39.39em;\"><span style=\"top:-48.59em;\"><span class=\"pstrut\" style=\"height:12.47em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.27em;\"><span style=\"top:-7.12em;\"><span class=\"pstrut\" style=\"height:4.69em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">rep </span></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mord text\"><span class=\"mord\">: orthogonality (max cross/min diag) = </span></span><span class=\"mord\">2.66</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</spa