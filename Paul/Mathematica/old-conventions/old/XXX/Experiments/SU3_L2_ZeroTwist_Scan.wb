><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-26.5em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-27.7em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-28.9em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-30.1em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-31.3em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-32.5em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-33.7em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-34.9em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-36.1em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-37.3em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-38.5em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-39.7em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-40.9em;\"><span class=\"pstrut\" style=\"height:21.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:18.95em;\"><span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:19.595em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[870]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{all hw states of all pairs: both factorizations hold exactly} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{site 1} & \\text{site 2} & \\text{mu} & \\text{W12 = K q\\^{}3(u) prod\\_s prod\\_\\{k=l2+1\\}\\^{}\\{l1\\}(u-th\\_s-k)} & \\text{W = K q\\_1(u) prod\\_s prod\\_\\{k=l3\\}\\^{}\\{l2-1\\}(u-th\\_s-k)}\\\\\\hline3,1,0 & 2,2,0 & 5,3,0 & \\mathrm{True} & \\mathrm{True}\\\\\\hline3,1,0 & 2,2,0 & 5,2,1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline3,1,0 & 2,2,0 & 4,3,1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline3,1,0 & 2,2,0 & 4,2,2 & \\mathrm{True} & \\mathrm{True}\\\\\\hline3,1,0 & 2,2,0 & 3,3,2 & \\mathrm{True} & \\mathrm{True}\\\\\\hline4,1,1 & 2,0,0 & 6,1,1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline4,1,1 & 2,0,0 & 5,2,1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline4,1,1 & 2,0,0 & 4,3,1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2,1,0 & 3,1,0 & 5,2,0 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2,1,0 & 3,1,0 & 4,3,0 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2,1,0 & 3,1,0 & 5,1,1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2,1,0 & 3,1,0 & 4,2,1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2,1,0 & 3,1,0 & 4,2,1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2,1,0 & 3,1,0 & 3,3,1 & \\mathrm{True} & … [latex truncated: 2281 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "76fe135e-debb-4fa9-acad-bb0c95d00688"
