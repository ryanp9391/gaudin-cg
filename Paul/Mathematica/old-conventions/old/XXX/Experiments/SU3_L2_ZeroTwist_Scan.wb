      {
       "data": "Out[880]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{site 1} & \\text{site 2} & \\text{\\# hw} & \\text{R/R\\_vac per hw state} & \\text{symmetric B\\_sym: max |rhs/lhs - 1|}\\\\\\hline2,1,0 & 2,1,0 & 6 & \\begin{matrix}1.\\,\\\\1.\\,\\\\1.\\,\\\\0.46022727\\\\-0.055555556\\\\0.088383838\\end{matrix} & 19.0\\\\\\hline3,1,0 & 2,2,0 & 5 & \\begin{matrix}1.\\,\\\\1.\\,\\\\-0.0058823529\\\\-0.11764706\\\\-0.032976827\\end{matrix} & 171\\\\\\hline2,1,1 & 4,3,1 & 3 & \\begin{matrix}1.\\,\\\\1.\\,\\\\-0.51595745\\end{matrix} & 2.94\\\\\\hline1,1,0 & 1,0,0 & 2 & \\begin{matrix}1.\\,\\\\-0.96551724\\end{matrix} & 2.04\\\\\\hline\\end{array}",
