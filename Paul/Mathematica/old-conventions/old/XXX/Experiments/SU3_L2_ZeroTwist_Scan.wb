       "data": "Out[838]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{all 49 pairs, both sites: W(theta\\_s + k) = 0 exactly for k < lambda2\\^{}(s), nonzero at k = lambda2\\^{}(s)} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{site 1} & \\text{site 2} & \\text{max over hw states of |W(theta\\_s + k)|/scale, k = 0..lambda2\\^{}(s)}\\\\\\hline1,0,0 & 1,0,0 & \\text{site }1\\text{: }\\text{6.0}\\times 10^{\\text{-1}}\\text{     }\\text{site }2\\text{: }\\text{1.0}\\\\\\hline1,0,0 & 1,1,0 & \\text{site }1\\text{: }\\text{1.0}\\text{     }\\text{site }2\\text{: }\\text{0}\\text{  }\\text{8.9}\\times 10^{\\text{-1}}\\\\\\hline1,0,0 & 2,0,0 & \\text{site }1\\text{: }\\text{6.0}\\times 10^{\\text{-1}}\\text{     }\\text{site }2\\text{: }\\text{1.0}\\\\\\hline1,0,0 & 3,0,0 & \\text{site }1\\text{: }\\text{6.0}\\times 10^{\\text{-1}}\\text{     }\\text{site }2\\text{: }\\text{1.0}\\\\\\hline1,0,0 & 2,1,0 & \\text{site }1\\text{: }\\text{1.0}\\text{     }\\text{site }2\\text{: }\\text{0}\\text{  }\\text{8.9}\\times 10^{\\text{-1}}\\\\\\hline1,0,0 & 3,1,0 & \\text{site }1\\text{: }\\text{1.0}\\text{     }\\text{site }2\\text{: }\\text{0}\\text{  }\\text{8.9}\\times 10^{\\text{-1}}\\\\\\hline1,0,0 & 2,2,0 & \\text{site }1\\text{: }\\text{1.0}\\text{     }\\text{site }2\\text{: }\\text{0… [latex truncated: 6951 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "2df99b89-4c4e-4d03-8f46-a0ab72c3f414"
