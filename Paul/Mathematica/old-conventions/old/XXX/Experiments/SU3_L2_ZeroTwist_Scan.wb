      {
       "data": "Out[875]= \\begin{array}{|c|c|c|c|}\\hline\\text{site 1} & \\text{site 2} & \\text{\\# hw} & \\text{max rel. spread of [E/(Psibar\\_0 Psi\\_0)] / simplified form}\\\\\\hline3,1,0 & 2,2,0 & 5 & 0.\\times 10^{-247}\\\\\\hline4,1,1 & 2,0,0 & 3 & 0.\\times 10^{-247}\\\\\\hline2,1,0 & 3,1,0 & 7 & 0.\\times 10^{-247}\\\\\\hline3,0,0 & 3,3,1 & 3 & 0.\\times 10^{-247}\\\\\\hline2,2,1 & 5,3,2 & 3 & 0.\\times 10^{-247}\\\\\\hline3,1,0 & 3,1,0 & 10 & 0.\\times 10^{-247}\\\\\\hline1,0,0 & 1,1,0 & 2 & 0.\\times 10^{-248}\\\\\\hline2,2,0 & 2,2,0 & 3 & 0.\\times 10^{-247}\\\\\\hline\\end{array}",
       "mime": "text/plain"
