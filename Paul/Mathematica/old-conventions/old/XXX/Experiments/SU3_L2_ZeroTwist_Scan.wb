       "data": "Out[853]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{site 1} & \\text{site 2} & \\text{\\# hw} & \\text{checks (qdet, degrees, twisted match)} & \\text{c (rule)} & \\text{c derived} & \\text{max |rhs/lhs - 1|, lambda3-shifted} & \\text{c+-1 contrast} & \\text{control: without lambda3 shifts} & \\\\\\hline2,1,1 & 2,1,0 & 3 & \\mathrm{True} & 4 & 4 & 2.45\\times 10^{-20} & 0.428 & 0.996 & \\text{PASS}\\\\\\hline3,2,1 & 3,1,0 & 7 & \\mathrm{True} & 6 & 6 & 1.28\\times 10^{-19} & 0.765 & 1.59 & \\text{PASS}\\\\\\hline2,1,0 & 3,3,1 & 4 & \\mathrm{True} & 5 & 5 & 9.61\\times 10^{-20} & 0.192 & 1.01 & \\text{PASS}\\\\\\hline4,1,1 & 1,1,0 & 2 & \\mathrm{True} & 5 & 5 & 6.07\\times 10^{-21} & 0.109 & 1.11 & \\text{PASS}\\\\\\hline3,2,1 & 3,2,1 & 6 & \\mathrm{True} & 5 & 5 & 8.26\\times 10^{-20} & 0.413 & 1.13 & \\text{PASS}\\\\\\hline2,2,2 & 2,1,0 & 1 & \\mathrm{True} & 3 & \\text{undet.} & -\\infty  & -\\infty  & \\text{singular} & \\textcolor{#ff0000}{\\text{FAIL}}\\\\\\hline2,1,1 & 4,3,1 & 3 & \\mathrm{True} & 5 & 5 & 1.06\\times 10^{-20} & 0.0686 & 1.16 & \\text{PASS}\\\\\\hline1,1,1 & 3,1,0 & 1 & \\mathrm{True} & 4 & \\text{undet.} & -\\infty  & -\\infty  & \\text{singular} & \\textcolor{#ff0000}{\\text{FAIL}}\\\\\\hline\\end{array}",
