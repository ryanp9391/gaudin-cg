       "data": "Out[857]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{site 1} & \\text{site 2} & \\text{\\# hw} & \\text{checks (qdet, degrees, twisted match)} & \\text{c (rule)} & \\text{c derived} & \\text{max |rhs/lhs - 1|, lambda3-shifted} & \\text{c+-1 contrast} & \\text{control: without lambda3 shifts} & \\\\\\hline3,2,1 & 4,4,1 & 4 & \\mathrm{True} & 6 & 6 & 1.06\\times 10^{-19} & 0.168 & 1.13 & \\text{PASS}\\\\\\hline2,2,1 & 5,3,2 & 3 & \\mathrm{True} & 5 & 5 & 1.49\\times 10^{-20} & 0.107 & 1.00 & \\text{PASS}\\\\\\hline\\end{array}",
