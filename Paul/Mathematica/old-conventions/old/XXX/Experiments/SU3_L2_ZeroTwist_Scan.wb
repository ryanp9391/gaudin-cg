      {
       "data": "Out[829]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{pairs} & 49\\\\\\hline\\text{pass} & 49\\\\\\hline\\text{worst residual} & 8.67\\times 10^{-17}\\\\\\hline\\text{weakest c+-1 contrast} & 0.0390\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{site 1} & \\text{site 2} & \\text{\\# hw} & \\text{hw order = section 3} & \\text{max |rhs/lhs - 1|} & \\text{c+-1 contrast} & \\text{min |c\\^{}ref Psi\\^{}ref|} & \\\\\\hline1,0,0 & 1,0,0 & 2 & \\mathrm{True} & 8.04\\times 10^{-23} & 0.25 & 0.117 & \\text{PASS}\\\\\\hline1,0,0 & 1,1,0 & 2 & \\mathrm{True} & 1.15\\times 10^{-20} & 0.286 & 0.00104 & \\text{PASS}\\\\\\hline1,0,0 & 2,0,0 & 2 & \\mathrm{True} & 7.52\\times 10^{-23} & 0.2 & 9.46 & \\text{PASS}\\\\\\hline1,0,0 & 3,0,0 & 2 & \\mathrm{True} & 1.12\\times 10^{-22} & 0.167 & 315 & \\text{PASS}\\\\\\hline1,0,0 & 2,1,0 & 3 & \\mathrm{True} & 5.34\\times 10^{-21} & 0.162 & 0.0591 & \\text{PASS}\\\\\\hline1,0,0 & 3,1,0 & 3 & \\mathrm{True} & 2.14\\times 10^{-18} & 0.109 & 0.403 & \\text{PASS}\\\\\\hline1,0,0 & 2,2,0 & 2 & \\mathrm{True} & 1.23\\times 10^{-20} & 0.0955 & 0.810 & \\text{PASS}\\\\\\hline1,1,0 & 1,0,0 & 2 & \\mathrm{True} & 9.98\\times 10^{-21} & 0.192 & 0.0150 & \\text{PASS}\\\\\\hline1,1,0 & 1,1,0 & 2 & \\mathrm{True} & 1.48\\times 10^{… [latex truncated: 4958 chars total]",
       "mime": "text/plain"
      }
