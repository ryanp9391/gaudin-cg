   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 10. Coverage of the 49-pair rescan (section 4): hw states per pair, non-vacuum states tested, and states whose\n   hw weight mu occurs more than once (multiplicity > 1 in the tensor product). ---- *)\nClearAll[multTabS, multTotS];\nmultTabS = Table[Module[{mus = r[\"states\"][[All, \"mu\"]], tally, rep},\n    tally = Tally[mus]; rep = Select[tally, #[[2]] > 1 &];\n    {Row[r[\"pair\"][[1]], \",\"], Row[r[\"pair\"][[2]], \",\"], Length[mus], Length[mus] - 1, Total[rep[[All, 2]]],\n     If[rep === {}, \"-\", Row[Row[{Row[#[[1]], \",\"], \" (x\", #[[2]], \")\"}] & /@ rep, \"  \"]], TrueQ[r[\"maxRes\"] < 10^-10]}], {r, rescanS}];\nmultTotS = {Total[multTabS[[All, 3]]], Total[multTabS[[All, 4]]], Total[multTabS[[All, 5]]], Count[multTabS[[All, 5]], _?Positive]};\nColumn[{\n  Grid[{{\"hw states in total (incl. 49 vacua)\", multTotS[[1]]}, {\"non-vacuum states tested\", multTotS[[2]]},\n    {\"states lying in a multiplicity > 1 weight\", multTotS[[3]]}, {\"pairs containing such states\", multTotS[[4]]}}, Frame -> All, Alignment -> Left],\n  Grid[Prepend[multTabS, {\"site 1\", \"site 2\", \"# hw states\", \"# tested (non-vac)\", \"# in repeated weights\", \"repeated weights\", \"pass\"}],\n   Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
