  {
   "kind": 2,
   "value": "(* ---- 2. Per-pair pipeline: untwisted hw states and Q's, twisted hw-sector eigenvectors, physical limit, formula. ---- *)\nClearAll[hwOpS, hwBasisS, hwMusS, hwRecsS, untwS, buildUntwS, twCacheS, twBuildS, twS, multipletOfS, hwRecS, vandS, gS,\n  epsLimS, phiSetS, lhsOfS, polesS, weightsS, setPolesS, bracketS, BS, EformulaS, splitT2S, kappaS, cRuleS, runPairS];\n\nhwBasisS[w_] := Module[{idx = Flatten@Position[wtS, w]},\n   Transpose@Table[ReplacePart[ConstantArray[0, dcS], Thread[idx -> nv]], {nv, NullSpace[hwOpS[[All, idx]]]}]];\n\n(* Joint (T1,T2) eigenvectors inside one hw space: split by a generic combination of all coefficients. *)\nhwRecsS[w_] := Module[{Bt = hwBasisS[w], n, rr, r, Rk, K, evs},\n   n = Length[Bt[[1]]];\n   rr = RowReduce[Transpose[Bt]];\n   r = Table[First@Flatten@Position[Unitize[rr[[k]]], 1, 1, 1], {k, n}];\n   Rk[a_, k_] := Rk[a, k] = Inverse[Bt[[r]]].(TcoS[a, k, {1, 1, 1}].Bt)[[r]];\n   K = Sum[rhoS[a, k] Rk[a, k], {a, 2}, {k, 0, 2 a}];\n   evs = If[n == 1, {{1}}, Eigenvectors[K]];\n   Table[With[{p = First@Flatten@Position[Unitize[ev], 1, 1, 1]},\n     <|\"mu\" -> w,\n      \"T1\" -> Sum[RootReduce[(Rk[1, k].ev)[[p]]/ev[[p]]] u^k, {k, 0, 2}],\n      \"T2\" -> Sum[RootReduce[(Rk[2, k].ev)[[p]]/ev[[p]]] u^k, {k, 0, 4}]|>], {ev, evs}]];\n\n(* Records sorted vacuum first (height below lambda_vac), multiplets by N[[u^0]T2]; q = q_1..q_3, qd = q^1..q^3. *)\nbuildUntwS[] := Module[{recs},\n   hwMusS = Select[Union[wtS], #[[1]] >= #[[2]] >= #[[3]] && Length[NullSpace[hwOpS[[All, Flatten@Position[wtS, #]]]]] > 0 &];\n   recs = SortBy[Flatten[hwRecsS /@ hwMusS, 1], {-(2 #[\"mu\"][[1]] + #[\"mu\"][[2]]) &, #[\"mu\"] &, N[Coefficient[#[\"T2\"], u, 0], 30] &}];\n   Table[Append[s, <|\"q\" -> polyKernelS[BaxDirS[s[\"T1\"], s[\"T2\"]]], \"qd\" -> Reverse[polyKernelS[BaxDualS[s[\"T1\"], s[\"T2\"]]]]|>], {s, recs}]];\n\nmultipletOfS[t1_, t2_] := First@Ordering[Table[\n     Total[Abs[CoefficientList[t1 - N[s[\"T1\"], 50], u]]] + Total[Abs[CoefficientList[t2 - N[s[\"T2\"], 50], u]]], {s, untwS}], 1];\n\n(* Twisted eigenvectors only in the hw-weight sectors; left eigenvectors = rows of the sector-block inverse. *)\ntwBuildS[eps_, phi_] := Module[{z = N[Exp[eps phi], precS], tco, bra, ket},\n   Do[tco[a, k] = TcoS[a, k, z], {a, 2}, {k, 0, 2 a}];\n   bra = Flatten[KroneckerProduct[refBraS[rep1S, z], refBraS[rep2S, z]]];\n   ket = Flatten[KroneckerProduct[refKetS[rep1S, z], refKetS[rep2S, z]]];\n   <|\"z\" -> z, \"recs\" -> Flatten[Table[\n       Module[{idx = Flatten@Position[wtS, wt], blk, K, vals, vecs, Linv},\n        Do[blk[a, k] = Normal[tco[a, k][[idx, idx]]], {a, 2}, {k, 0, 2 a}];\n        K = Sum[rhoS[a, k] blk[a, k], {a, 2}, {k, 0, 2 a}];\n        {vals, vecs} = Eigensystem[K];\n        vecs = Table[vv/vv[[First@Ordering[-Abs[vv], 1]]], {vv, vecs}];\n        Linv = Inverse[Transpose[vecs]];\n        Table[Module[{vv = vecs[[r]], p, t1, t2},\n          p = First@Ordering[-Abs[vv], 1];\n          t1 = Expand@Sum[(blk[1, k].vv)[[p]]/vv[[p]] u^k, {k, 0, 2}];\n          t2 = Expand@Sum[(blk[2, k].vv)[[p]]/vv[[p]] u^k, {k, 0, 4}];\n          <|\"mu\" -> wt, \"mult\" -> multipletOfS[t1, t2], \"braR\" -> bra[[idx]].vv, \"Lket\" -> Linv[[r]].ket[[idx]]|>],\n         {r, Length[vecs]}]],\n       {wt, Union[untwS[[All, \"mu\"]]]}], 1]|>];\ntwS[eps_, phi_] := If[KeyExistsQ[twCacheS, {eps, phi}], twCacheS[{eps, phi}], twCacheS[{eps, phi}] = twBuildS[eps, phi]];\nhwRecS[eps_, phi_, m_] := Select[twS[eps, phi][\"recs\"], #[\"mult\"] == m && #[\"mu\"] == untwS[[m, \"mu\"]] &];\n\nvandS[z_, lam_] := Product[(z[[i]] - z[[j]])^(lam[[i]] - lam[[j]]), {i, 3}, {j, i + 1, 3}];\ngS[eps_, phi_, m_] := With[{s = First@hwRecS[eps, phi, m], z = twS[eps, phi][\"z\"]},\n   vandS[z, untwS[[1, \"mu\"]]]/vandS[z, untwS[[m, \"mu\"]]]/(s[\"braR\"] s[\"Lket\"])];\nepsLimS = {10^-6, 10^-7, 10^-8};\nphiSetS = {{1, 1/3, -4/3}, {2, -1/2, -3/2}};\n(* {quadratic extrapolation, 2-point extrapolation} of the vacuum-normalized left side. *)\nlhsOfS[phi_, m_] := With[{pts = Table[{e, gS[e, phi, m]/gS[e, phi, 1]}, {e, epsLimS}]},\n   {InterpolatingPolynomial[pts, 0], InterpolatingPolynomial[pts[[2 ;;]], 0]}];\n\n(* Site-ladder measure; c from the general rule. *)\nsetPolesS[] := (polesS = Flatten@Table[thetaS[[s]] + Range[{rep1S, rep2S}[[s, 3]], {rep1S, rep2S}[[s, 1]]], {s, 2}];\n   weightsS = Table[1/Times @@ (polesS[[r]] - Delete[polesS, r]), {r, Length[polesS]}]);\ncRuleS[r1_, r2_] := (r1[[1]] - r1[[3]]) + (r2[[1]] - r2[[3]]) + 1;\nbracketS[f_] := Sum[weightsS[[r]] Exp[2 Pi I SetPrecision[polesS[[r]], 250]] f[polesS[[r]]], {r, Length[polesS]}];\nEformulaS[lam_] := -(lam[[1]] - lam[[2]] + 1) (lam[[2]] - lam[[3]] + 1)/\n   ((lam[[1]] - lam[[3]] + 1)! (lam[[1]] - lam[[2]])! (lam[[2]] - lam[[3]])!);\n(* {det calN/(c^ref Psi^ref), det calN, c^ref Psi^ref}, numeric q's. *)\nBS[m_, c_] := Module[{q, qd, Nm, psi, cref},\n   q = Function[{i, x}, qpolyS[N[untwS[[m, \"q\"]][[i]], 250], x]];\n   qd = Function[{j, x}, qpolyS[N[untwS[[m, \"qd\"]][[j]], 250], x]];\n   Nm = Table[{\n      bracketS[Function[x, qd[ij[[2]], x + 1] q[ij[[1]], x] - qd[ij[[2]], x] q[ij[[1]], x]]],\n      bracketS[Function[x, x qd[ij[[2]], x] q[ij[[1]], x - 1] - (x - c) qd[ij[[2]], x + 1] q[ij[[1]], x]]],\n      bracketS[Function[x, qd[ij[[2]], x] q[ij[[1]], x - 1] - qd[ij[[2]], x + 1] q[ij[[1]], x]]]}, {ij, {{1, 3}, {1, 2}, {2, 3}}}];\n   psi = Product[q[1, th + 1] (q[1, th] q[2, th - 1] - q[2, th] q[1, th - 1]), {th, thetaS}];\n   cref = Product[(qd[3, th + 1] (qd[3, th] qd[2, th + 1] - qd[2, th] qd[3, th + 1])\n       - qd[3, th] (qd[3, th] qd[2, th + 2] - qd[2, th] qd[3, th + 2]))/4, {th, thetaS}];\n   {Det[Nm]/(cref psi), Det[Nm], cref psi}];\n\n(* Zero-twist Delta T2 relation, per-site weights: kappa = (b1 + b2 - dc1)/a1 over pairs with a1 != 0. *)\nsplitT2S[A_, B_] := Module[{a1, b1, a2, b2, x, dT2},\n   dT2 = Expand[B[\"T2\"] - A[\"T2\"]] /. u -> x;\n   {a1, b1, a2, b2} /. First@Solve[Thread[CoefficientList[dT2 - ((x - thetaS[[1]] - rep1S[[1]] - 1) (x - thetaS[[2]] - rep2S[[1]] - 1) (a1 x + b1)\n          + (x - thetaS[[1]] - rep1S[[3]]) (x - thetaS[[2]] - rep2S[[3]]) (a2 x + b2)), x] == 0], {a1, b1, a2, b2}]];\nkappaS[] := Module[{pairs = Flatten[Table[If[a == b, Nothing,\n        With[{sp = splitT2S[untwS[[a]], untwS[[b]]], dT1 = Expand[untwS[[b, \"T1\"]] - untwS[[a, \"T1\"]]]},\n         RootReduce /@ {sp[[1]], sp[[2]] + sp[[4]] - Coefficient[dT1, u, 0]}]], {a, Length[untwS]}, {b, Length[untwS]}], 1]},\n   <|\"kappa\" -> Union[RootReduce[#[[2]]/#[[1]]] & /@ Select[pairs, #[[1]] =!= 0 &]],\n    \"a1zeroOK\" -> (Select[pairs, #[[1]] === 0 &] === {} || Union[Select[pairs, #[[1]] === 0 &][[All, 2]]] === {0})|>];\n\n(* Full test for one ordered pair of site reps. *)\nrunPairS[r1_, r2_] := runPairS[r1, r2] = Module[{time, res},\n   time = First@AbsoluteTiming[\n      setupChainS[r1, r2];\n      hwOpS = Normal[Join[EtotS[1, 2], EtotS[2, 3]]];\n      untwS = buildUntwS[];\n      twCacheS = <||>;\n      setPolesS[];\n      res = Module[{nhw = Length[untwS], dTot = r1[[1]] + r2[[1]], c = cRuleS[r1, r2], kap, b, bm, bp, lhs1, lhs2, states},\n        kap = kappaS[];\n        b = Table[BS[m, c], {m, nhw}]; bm = Table[BS[m, c - 1], {m, nhw}]; bp = Table[BS[m, c + 1], {m, nhw}];\n        lhs1 = Table[lhsOfS[phiSetS[[1]], m], {m, nhw}]; lhs2 = Table[lhsOfS[phiSetS[[2]], m], {m, nhw}];\n        states = Table[Module[{lhs = lhs1[[m, 1]], ratE = EformulaS[untwS[[m, \"mu\"]]]/EformulaS[untwS[[1, \"mu\"]]]},\n           <|\"mu\" -> untwS[[m, \"mu\"]], \"lhs\" -> lhs,\n            \"spread\" -> Max[Abs[lhs2[[m, 1]]/lhs - 1], Abs[lhs1[[m, 2]]/lhs - 1]],\n            \"res\" -> Abs[ratE b[[m, 1]]/b[[1, 1]]/lhs - 1],\n            \"resMinus\" -> Abs[ratE bm[[m, 1]]/bm[[1, 1]]/lhs - 1], \"resPlus\" -> Abs[ratE bp[[m, 1]]/bp[[1, 1]]/lhs - 1],\n            \"Eformula\" -> ratE, \"Erequired\" -> lhs b[[1, 1]]/b[[m, 1]],\n            \"cPsi\" -> Abs[b[[m, 3]]], \"nTw\" -> Length[hwRecS[epsLimS[[3]], phiSetS[[1]], m]]|>], {m, nhw}];\n        <|\"pair\" -> {r1, r2}, \"dims\" -> {ds1S, ds2S}, \"nhw\" -> nhw, \"c\" -> c, \"nPoles\" -> Length[polesS],\n         \"kappa\" -> kap[\"kappa\"], \"a1zeroOK\" -> kap[\"a1zeroOK\"],\n         \"qdetOK\" -> And @@ Table[Normal[TcoS[3, k, {1, 1, 1}]] === Coefficient[Expand[qdetS[u]], u, k] IdentityMatrix[dcS], {k, 0, 6}],\n         \"degOK\" -> And @@ Table[(Length /@ s[\"q\"] - 1) === (dTot - s[\"mu\"]) + {0, 1, 2} && (Length /@ s[\"qd\"] - 1) === s[\"mu\"] + {2, 1, 0}, {s, untwS}],\n         \"nTwOK\" -> Union[states[[All, \"nTw\"]]] === {1},\n         \"states\" -> states,\n         \"maxRes\" -> Max[states[[2 ;;, \"res\"]]],\n         \"contrast\" -> Min[Max[states[[2 ;;, \"resMinus\"]]], Max[states[[2 ;;, \"resPlus\"]]]],\n         \"maxSpread\" -> Max[states[[2 ;;, \"spread\"]]],\n         \"minCPsi\" -> Min[states[[All, \"cPsi\"]]]|>]];\n   twCacheS = <||>;\n   Append[res, \"time\" -> time]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 3. The scan: all 49 ordered pairs. A pair passes if every hw state matches to < 1e-10 and c +- 1 both fail (> 1e-3). ---- *)\nClearAll[repsS, scanS, scanProgressS, rowOfS, passS];\nrepsS = {{1, 0, 0}, {1, 1, 0}, {2, 0, 0}, {3, 0, 0}, {2, 1, 0}, {3, 1, 0}, {2, 2, 0}};\nscanS = Flatten[Table[scanProgressS = {r1, r2}; runPairS[r1, r2], {r1, repsS}, {r2, repsS}], 1];\n\npassS[r_] := r[\"qdetOK\"] && r[\"degOK\"] && r[\"nTwOK\"] && r[\"maxRes\"] < 10^-10 && r[\"contrast\"] > 10^-3;\nrowOfS[r_] := {Row[r[\"pair\"][[1]], \",\"], Row[r[\"pair\"][[2]], \",\"], Row[r[\"dims\"], \"x\"], r[\"nhw\"],\n   r[\"c\"], If[r[\"kappa\"] === {}, \"undet.\", Row[r[\"kappa\"] - 1, \",\"]],\n   r[\"qdetOK\"] && r[\"degOK\"] && r[\"nTwOK\"] && r[\"a1zeroOK\"],\n   N[r[\"maxRes\"], 3], N[r[\"contrast\"], 3], N[r[\"maxSpread\"], 3],\n   N[Max[Abs[r[\"states\"][[2 ;;, \"Erequired\"]]/r[\"states\"][[2 ;;, \"Eformula\"]] - 1]], 3],\n   Round[r[\"time\"], 0.1], If[passS[r], \"PASS\", Style[\"FAIL\", Red]]};\n\nColumn[{\n  Grid[{{\"pairs\", Length[scanS]}, {\"pass\", Count[scanS, _?passS]}, {\"fail\", Count[scanS, _?(! passS[#] &)]},\n    {\"worst residual over all pairs\", N[Max[scanS[[All, \"maxRes\"]]], 3]},\n    {\"weakest c+-1 contrast over all pairs\", N[Min[scanS[[All, \"contrast\"]]], 3]},\n    {\"pairs where c derived from Delta T2 differs from the rule\",\n     Count[scanS, _?(#[\"kappa\"] =!= {} && #[\"kappa\"] =!= {#[\"c\"] + 1} &)]}}, Frame -> All, Alignment -> Left],\n  Grid[Prepend[rowOfS /@ scanS, {\"site 1\", \"site 2\", \"dims\", \"# hw\", \"c (rule)\", \"c derived\", \"checks\",\n     \"max |rhs/lhs - 1|\", \"c+-1 contrast\", \"extrapolation spread\", \"max |E req/E formula - 1|\", \"time (s)\", \"\"}],\n   Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<details class=\"vscode-wolfram-message-output\" style=\"color:#f44;border-left:3px solid #f44;background:rgba(255,68,68,0.08);padding:2px 6px;margin:1px 0;border-radius:0 3px 3px 0;font-family:monospace;font-size:0.85em\"><summary style=\"cursor:pointer\">8 warnings</summary><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression --------- encountered.                                       -248                                  0. 10</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression --------- encountered.                                       -250                                  0. 10</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression --------- encountered.                                       -248                                  0. 10</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">General::stop: Further output of Power::infy will be suppressed during this calculation.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0 ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0 ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0 ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">General::stop: Further output of Infinity::indet will be suppressed during this calculation.</div></details>",
