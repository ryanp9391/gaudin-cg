   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 6. lambda3 != 0. A site in lambda' + (k,k,k) is the lambda' site at theta + k (E_ij -> E'_ij + k delta_ij), so the\n   reference points should move by lambda3 wherever theta appears without lambda2:\n   Psi_0    = prod_s q_1(th_s + l2) [q_1(th_s + l3) q_2(th_s + l3 - 1) - q_2(th_s + l3) q_1(th_s + l3 - 1)],\n   Psibar_0 = prod_s q^3(th_s + l3) [q^3(th_s + l3) q^2(th_s + l2 + 1) - q^2(th_s + l3) q^3(th_s + l2 + 1)].\n   Measure (poles th_s + l3..l1), c and E_mu are already written with lambda3 / differences. Full pipeline (twisted limit included);\n   control: the lambda3-free form of section 4. The degree check of runPairS assumed lambda3 = 0 for the duals; the correct\n   degrees are deg q_i = (D - mu_i) + (i-1), deg q^j = mu_j - L3 + (3-j), L3 = l3^(1) + l3^(2), checked here. ---- *)\nClearAll[BgenS, rescanWithS, lam3PairsS, lam3ResS, lam3ProgressS, lam3RowS, degGenOKS];\n\nBgenS[m_, c_] := Module[{q, qd, Nm, l2 = {rep1S[[2]], rep2S[[2]]}, l3 = {rep1S[[3]], rep2S[[3]]}, psi, cref},\n   q = Function[{i, x}, qpolyS[N[untwS[[m, \"q\"]][[i]], 250], x]];\n   qd = Function[{j, x}, qpolyS[N[untwS[[m, \"qd\"]][[j]], 250], x]];\n   Nm = Table[{\n      bracketS[Function[x, qd[ij[[2]], x + 1] q[ij[[1]], x] - qd[ij[[2]], x] q[ij[[1]], x]]],\n      bracketS[Function[x, x qd[ij[[2]], x] q[ij[[1]], x - 1] - (x - c) qd[ij[[2]], x + 1] q[ij[[1]], x]]],\n      bracketS[Function[x, qd[ij[[2]], x] q[ij[[1]], x - 1] - qd[ij[[2]], x + 1] q[ij[[1]], x]]]}, {ij, {{1, 3}, {1, 2}, {2, 3}}}];\n   psi = Product[With[{th = thetaS[[s]], a = l2[[s]], b = l3[[s]]},\n      q[1, th + a] (q[1, th + b] q[2, th + b - 1] - q[2, th + b] q[1, th + b - 1])], {s, 2}];\n   cref = Product[With[{th = thetaS[[s]], a = l2[[s]], b = l3[[s]]},\n      qd[3, th + b] (qd[3, th + b] qd[2, th + a + 1] - qd[2, th + b] qd[3, th + a + 1])], {s, 2}];\n   {Det[Nm]/(cref psi), Det[Nm], cref psi}];\n\n(* Same as rescanPairS, with the B-function as an argument; reuses the physical limits of runPairS. *)\nrescanWithS[old_, Bfun_] := Module[{r1 = old[\"pair\"][[1]], r2 = old[\"pair\"][[2]], c, nhw, b, bm, bp, states},\n   setupChainS[r1, r2];\n   hwOpS = Normal[Join[EtotS[1, 2], EtotS[2, 3]]];\n   untwS = buildUntwS[];\n   setPolesS[];\n   c = cRuleS[r1, r2]; nhw = Length[untwS];\n   b = Table[Bfun[m, c], {m, nhw}]; bm = Table[Bfun[m, c - 1], {m, nhw}]; bp = Table[Bfun[m, c + 1], {m, nhw}];\n   states = Table[Module[{lhs = old[\"states\"][[m, \"lhs\"]], ratE = EformulaS[untwS[[m, \"mu\"]]]/EformulaS[untwS[[1, \"mu\"]]]},\n      <|\"mu\" -> untwS[[m, \"mu\"]], \"res\" -> Abs[ratE b[[m, 1]]/b[[1, 1]]/lhs - 1],\n       \"resMinus\" -> Abs[ratE bm[[m, 1]]/bm[[1, 1]]/lhs - 1], \"resPlus\" -> Abs[ratE bp[[m, 1]]/bp[[1, 1]]/lhs - 1]|>], {m, nhw}];\n   <|\"nhw\" -> nhw, \"maxRes\" -> Max[states[[2 ;;, \"res\"]]],\n    \"contrast\" -> Min[Max[states[[2 ;;, \"resMinus\"]]], Max[states[[2 ;;, \"resPlus\"]]]]|>];\n\n(* Uses the untwS of the current pair. *)\ndegGenOKS[r1_, r2_] := With[{dTot = r1[[1]] + r2[[1]], L3 = r1[[3]] + r2[[3]]},\n   And @@ Table[(Length /@ s[\"q\"] - 1) === (dTot - s[\"mu\"]) + {0, 1, 2} && (Length /@ s[\"qd\"] - 1) === s[\"mu\"] - L3 + {2, 1, 0}, {s, untwS}]];\n\n(* Shifted versions of tested reps, plus [3,2,0]-type content via [4,3,1], and trivial [2,2,2], [1,1,1] sites. *)\nlam3PairsS = {{{2, 1, 1}, {2, 1, 0}}, {{3, 2, 1}, {3, 1, 0}}, {{2, 1, 0}, {3, 3, 1}}, {{4, 1, 1}, {1, 1, 0}},\n   {{3, 2, 1}, {3, 2, 1}}, {{2, 2, 2}, {2, 1, 0}}, {{2, 1, 1}, {4, 3, 1}}, {{1, 1, 1}, {3, 1, 0}}};\nlam3ResS = Table[lam3ProgressS = pr; With[{old = runPairS @@ pr},\n    Module[{gen = rescanWithS[old, BgenS], deg = degGenOKS @@ pr, ns = rescanWithS[old, BnewS]},\n     <|\"pair\" -> pr, \"checks\" -> (old[\"qdetOK\"] && old[\"nTwOK\"] && deg), \"kappa\" -> old[\"kappa\"], \"c\" -> old[\"c\"],\n      \"gen\" -> gen, \"noShift\" -> ns|>]], {pr, lam3PairsS}];\n\nlam3RowS[r_] := {Row[r[\"pair\"][[1]], \",\"], Row[r[\"pair\"][[2]], \",\"], r[\"gen\"][\"nhw\"], r[\"checks\"], r[\"c\"],\n   If[r[\"kappa\"] === {}, \"undet.\", Row[r[\"kappa\"] - 1, \",\"]],\n   N[r[\"gen\"][\"maxRes\"], 3], N[r[\"gen\"][\"contrast\"], 3], If[NumericQ[r[\"noShift\"][\"maxRes\"]], N[r[\"noShift\"][\"maxRes\"], 3], \"singular\"],\n   If[TrueQ[r[\"checks\"] && r[\"gen\"][\"maxRes\"] < 10^-10 && r[\"gen\"][\"contrast\"] > 10^-3], \"PASS\", Style[\"FAIL\", Red]]};\nGrid[Prepend[lam3RowS /@ lam3ResS, {\"site 1\", \"site 2\", \"# hw\", \"checks (qdet, degrees, twisted match)\", \"c (rule)\", \"c derived\",\n    \"max |rhs/lhs - 1|, lambda3-shifted\", \"c+-1 contrast\", \"control: without lambda3 shifts\", \"\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"76\" data-out-n=\"853\" data-sub-idx=\"11\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"8\" data-sub-start=\"52\" data-sub-end=\"53\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[853]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"9\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:10.84em;vertical-align:-5.15em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.69em;\"><span style=\"top:-7.65em;\"><span class=\"pstrut\" style=\"height:7.65em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:10.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-5.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.65em;\"><span style=\"top:-7.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">site 1</span></span></span></span><span style=\"top:-6.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span></span></span><span style=\"top:-5.41em;\"><span class=\"pstrut\" style=\"height