      {
       "data": "Out[716]= \\begin{array}{|c|c|c|}\\hline\\text{rep} & \\text{dim} & \\text{basis vector 1 is hw}\\\\\\hline1,0,0 & 3 & \\mathrm{True}\\\\\\hline1,1,0 & 3 & \\mathrm{True}\\\\\\hline2,0,0 & 6 & \\mathrm{True}\\\\\\hline3,0,0 & 10 & \\mathrm{True}\\\\\\hline2,1,0 & 8 & \\mathrm{True}\\\\\\hline3,1,0 & 15 & \\mathrm{True}\\\\\\hline2,2,0 & 6 & \\mathrm{True}\\\\\\hline\\end{array}",
