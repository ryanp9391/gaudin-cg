   "value": "(* ---- 19. Correct double reference division and vacuum calibration. ---- *)\nClearAll[qDAll, qAAll, rowStateAll, detStateAll, psiBAll, psiAAll,\n  rightRefLabel, couplingsToRightRef, vacStateAll, onShellZeroRightRef,\n  onShellSurvivingCouplings, leftRefLabel, coefficientOnShellCheck,\n  functionalRawAll, vacuumCalibration, functionalNormAll, functionalTable];\n\n(* Common exponential factors at theta cancel between direct and dual sectors. *)\nqDAll[s_, k_, n_] := {z1, z2, z3}[[k]]^n (qDirPoly[s, k] /. u -> th + n h);\nqAAll[s_, k_, n_] := {z1, z2, z3}[[k]]^(-n) (qDualPoly[s, k] /. u -> th + n h);\n\nrowStateAll[s_, {i_, j_}] := Sum[mW[[n + 1]] {\n     -qAAll[s, j, n] qDAll[s, i, n],\n      qAAll[s, j, n] qDAll[s, i, n - 1],\n      qAAll[s, j, n + 1] qDAll[s, i, n]}, {n, 0, 2}];\ndetStateAll[s_] := detStateAll[s] = Factor[Det[rowStateAll[s, #] & /@ trG[[1]]]];\n\npsiBAll[s_, {a_, b_, c_}] :=\n  qDAll[s, 1, a] (qDAll[s, 1, b] qDAll[s, 2, c - 1]\n    - qDAll[s, 2, b] qDAll[s, 1, c - 1]);\npsiAAll[s_, {a_, b_, c_}] :=\n  qAAll[s, 1, a] (qAAll[s, 1, b] qAAll[s, 2, c + 1]\n    - qAAll[s, 2, b] qAAll[s, 1, c + 1]);\n\nrightRefLabel = {1, 0, 0};\nvacStateAll = First@FirstPosition[stateMu, {2, 1, 0}];\ncouplingsToRightRef = Select[suppM, #[[1]] === rightRefLabel &];\n\n(* Off shell there are two formal terms.  On every Baxter solution the boundary\n   Wronskian Q^1_0 Q^2_1-Q^2_0 Q^1_1 vanishes, so only one term is physical. *)\nonShellZeroRightRef = Table[\n   Factor[psiAAll[s, rightRefLabel]] === 0, {s, dd}];\nonShellSurvivingCouplings = Select[couplingsToRightRef,\n   And @@ Table[Factor[psiAAll[s, #[[2]]]] =!= 0, {s, dd}] &];\nleftRefLabel = First[onShellSurvivingCouplings][[2]];\ncoefficientOnShellCheck = And @@ Table[\n   Factor[(cAssoc[rightRefLabel] /. ad[j_, n_] :> qAAll[s, j, n])\n      + psiAAll[s, leftRefLabel]/(4 h^6)] === 0, {s, dd}];\n\nfunctionalRawAll[s_] := Factor[\n  detStateAll[s]/(psiAAll[s, leftRefLabel] psiBAll[s, rightRefLabel])];\nvacuumCalibration = Factor[1/functionalRawAll[vacStateAll]];\nfunctionalNormAll[s_] := Factor[vacuumCalibration functionalRawAll[s]];\nfunctionalTable = Table[{s, stateMu[[s]], functionalNormAll[s]}, {s, dd}];\n\nGrid[Join[{\n   {\"right reference configuration\", rightRefLabel, SpanFromLeft},\n   {\"formal off-shell M-couplings\", couplingsToRightRef, SpanFromLeft},\n   {\"off-shell coefficient\",\n      (PsiAa[{1, 0, 0}] - PsiAa[{0, 0, 1}])/(4 h^6), SpanFromLeft},\n   {\"boundary Wronskian vanishes for all eight on-shell states\",\n      onShellZeroRightRef, SpanFromLeft},\n   {\"unique on-shell dual coupling\", onShellSurvivingCouplings, SpanFromLeft},\n   {\"exact on-shell coefficient\",\n      -PsiAa[{0, 0, 1}]/(4 h^6), SpanFromLeft},\n   {\"verified after all eight Baxter solutions\", coefficientOnShellCheck, SpanFromLeft},\n   {\"vacuum calibration\", vacuumCalibration, SpanFromLeft},\n   {\"state\", \"weight\", \"calibrated functional norm\"}},\n   functionalTable\n  ], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"639560\" data-output-id=\"86\" data-out-n=\"242\" data-sub-idx=\"21\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"27\" data-sub-start=\"44\" data-sub-end=\"58\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[242]=</span></div><div class=\"wl-output-content\"><div data-wolfram-is-skeleton=\"1\" data-wolfram-atom-count=\"1368\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"10\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:26.2916em;vertical-align:-12.8758em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:13.4158em;\"><span style=\"top:-15.3758em;\"><span class=\"pstrut\" style=\"height:15.3758em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:26.2516em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-12.8758em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:13.3758em;\"><span style=\"top:-15.9858em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">right reference configuration</span></span></span></span><span style=\"top:-14.1758em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">formal off-shell M-couplings</span></span></span></span><span style=\"top:-12.2158em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">off-shell coefficient</span></span></span></span><span style=\"top:-11.0158em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">boundary Wronskian vanishes for all eight on-shell states</span></span></span></span><span style=\"top:-9.8058em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">unique on-shell dual coupling</span></span></span></span><span style=\"top:-8.4358em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">exact on-shell coefficient</span></span></span></span><span style=\"top:-7.2358em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">verified after all eight Baxter solutions</span></span></span></span><span style=\"top:-5.8579em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">vacuum calibration</span></span></span></span><span style=\"top:-4.4327em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">state</span></span></span></span><span style=\"top:-3.2327em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:-1.7637em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">2</span></span></span><span style=\"top:-0.2337em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">3</span></span></span><span style=\"top:1.3952em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">4</span></span></span><span style=\"top:3.0241em;\"><span class=\"pstrut\