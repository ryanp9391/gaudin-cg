      {
       "data": "Out[89]= \\begin{array}{|c|c|}\\hline\\text{gtpats (8 SoV labels)} & \\begin{pmatrix}\\left\\{1\\right\\} & \\left\\{0,0\\right\\}\\\\\\left\\{1\\right\\} & \\left\\{1,0\\right\\}\\\\\\left\\{1\\right\\} & \\left\\{1,1\\right\\}\\\\\\left\\{2\\right\\} & \\left\\{0,0\\right\\}\\\\\\left\\{2\\right\\} & \\left\\{1,0\\right\\}\\\\\\left\\{2\\right\\} & \\left\\{1,1\\right\\}\\\\\\left\\{2\\right\\} & \\left\\{2,0\\right\\}\\\\\\left\\{2\\right\\} & \\left\\{2,1\\right\\}\\end{pmatrix}\\\\\\hline\\text{pseudovacuum (generic)} & \\begin{pmatrix}\\mathrm{xv}\\left(1\\right) & \\mathrm{xv}\\left(2\\right) & \\mathrm{xv}\\left(3\\right) & \\mathrm{xv}\\left(4\\right) & \\mathrm{xv}\\left(5\\right) & \\mathrm{xv}\\left(6\\right) & \\mathrm{xv}\\left(7\\right) & \\mathrm{xv}\\left(8\\right)\\end{pmatrix}\\\\\\hline\\text{covector matrix dimensions} & \\left\\{8,8\\right\\}\\\\\\hline\\text{rank of the SoV covector system (must be 8)} & 8\\\\\\hline\\text{normalised vacuum state Psi\\_vac} & \\left\\{\\frac{1}{\\mathrm{xv}\\left(1\\right)},0,0,0,0,0,0,0\\right\\}\\\\\\hline\\text{<x\\_vac | Psi\\_vac> = 1} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "56a4d2ba-2830-4a5a-9e18-c0d0970a4967"
