       "data": "Out[223]= \\begin{array}{|c|c|}\\hline\\text{invariant} & \\text{value fixed by matching}\\\\\\hline\\text{a12 b21} & -\\frac{z1\\,\\left(z1-z3\\right)}{z2\\,\\left(z2-z3\\right)}\\\\\\hline\\text{a23 b32} & -\\frac{z2^2\\,\\left(z1-z3\\right)}{z3^2\\,\\left(z1-z2\\right)}\\\\\\hline\\text{a13 b31 branches} & \\left\\{-\\frac{z1^2}{z3^2},-\\frac{z1}{z3}\\right\\}\\\\\\hline\\text{branch} & \\text{constraint on the a's / all b's in terms of the a's}\\\\\\hline\\text{I} & \\begin{matrix}\\frac{a12\\,a23}{a13}⩵-\\frac{z2\\,\\left(z1-z3\\right)}{z1\\,\\left(z2-z3\\right)}\\\\b21\\to -\\frac{z1\\,\\left(z1-z3\\right)}{a12\\,z2\\,\\left(z2-z3\\right)}\\\\b31\\to -\\frac{z1^2}{a13\\,z3^2}\\\\b32\\to -\\frac{z2^2\\,\\left(z1-z3\\right)}{a23\\,z3^2\\,\\left(z1-z2\\right)}\\end{matrix}\\\\\\hline\\text{II} & \\begin{matrix}\\frac{a12\\,a23}{a13}⩵-\\frac{z1-z3}{z2-z3}\\\\b21\\to -\\frac{z1\\,\\left(z1-z3\\right)}{a12\\,z2\\,\\left(z2-z3\\right)}\\\\b31\\to -\\frac{z1}{a13\\,z3}\\\\b32\\to -\\frac{z2^2\\,\\left(z1-z3\\right)}{a23\\,z3^2\\,\\left(z1-z2\\right)}\\end{matrix}\\\\\\hline\\text{all eight norms match on each branch} & \\begin{pmatrix}\\mathrm{True} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True}\\\\\\mathrm{True} & \\mathrm{True} & \\mathrm{True} & \\mathrm{… [latex truncated: 1344 chars total]",
