      {
       "data": "Out[24]= \\begin{array}{|c|c|}\\hline\\text{nu\\_1, nu\\_2, nu\\_3} & \\left\\{-2\\,h-\\mathrm{th}+u,-h-\\mathrm{th}+u,u-\\mathrm{th}\\right\\}\\\\\\hline\\text{degrees of T\\_1, T\\_2, T\\_3 in u (should be a L = 1, 2, 3)} & \\left\\{1,2,3\\right\\}\\\\\\hline\\text{T\\_3 = z1 z2 z3 nu\\_1\\^{}[-4] nu\\_2\\^{}[-2] nu\\_3} & \\mathrm{True}\\\\\\hline\\text{[T\\_a(u), T\\_b(v)] = 0} & \\mathrm{True}\\\\\\hline\\text{T\\_a commute with the Cartan generators} & \\mathrm{True}\\\\\\hline\\text{T\\_1 commutes with E\\_12? (must be False: the twist is on)} & \\mathrm{False}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "4047e546-ce5f-4e0f-abf3-16b9cd4df110"
    }
