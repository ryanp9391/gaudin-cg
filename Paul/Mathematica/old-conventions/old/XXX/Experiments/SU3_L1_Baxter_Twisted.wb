      {
       "data": "Out[121]= \\begin{array}{|c|c|c|c|}\\hline\\text{GT label \\{\\{n21\\},\\{n11,n12\\}\\}} & \\text{<x|Psi>} & \\text{Psi(n)/Psi(\\{1\\},\\{0,0\\})} & \\text{equal}\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{0,0\\right\\}\\right\\} & 1 & 1 & \\mathrm{True}\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{1,0\\right\\}\\right\\} & z1+\\frac{z2}{2} & z1+\\frac{z2}{2} & \\mathrm{True}\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\frac{z1\\,z2}{2} & \\frac{z1\\,z2}{2} & \\mathrm{True}\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{0,0\\right\\}\\right\\} & z1 & z1 & \\mathrm{True}\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{1,0\\right\\}\\right\\} & \\frac{1}{2}\\,z1\\,\\left(2\\,z1+z2\\right) & \\frac{1}{2}\\,z1\\,\\left(2\\,z1+z2\\right) & \\mathrm{True}\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\frac{z1^2\\,z2}{2} & \\frac{z1^2\\,z2}{2} & \\mathrm{True}\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{2,0\\right\\}\\right\\} & \\frac{1}{2}\\,z1^2\\,\\left(2\\,z1+z2\\right) & \\frac{1}{2}\\,z1^2\\,\\left(2\\,z1+z2\\right) & \\mathrm{True}\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{2,1\\right\\}\\right\\} & \\frac{z1^3\\,z2}{2} & \\frac{z1^3\\,z2}{2} & \\mathrm{True}\\\\\\hline\\text{ALL EIGHT MATCH} & \\mathrm{True} & {\\square} & {\\square}\\\\\\hline\\text{xv[i] surviving in <x|Psi> (must be none)} &… [latex truncated: 1248 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "9748e0b8-7e32-4751-8f79-3a00537cd1c9"
