ight:20.400em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.875em\" height=\"20.400em\" viewBox=\"0 0 875 20400\"><path d=\"M76,0c-16.7,0,-25,3,-25,9c0,2,2,6.3,6,13c21.3,28.7,42.3,60.3,\n63,95c96.7,156.7,172.8,332.5,228.5,527.5c55.7,195,92.8,416.5,111.5,664.5\nc11.3,139.3,17,290.7,17,454c0,28,1.7,43,3.3,45l0,16809\nc-3,4,-3.3,16.7,-3.3,38c0,162,-5.7,313.7,-17,455c-18.7,248,-55.8,469.3,-111.5,664\nc-55.7,194.7,-131.8,370.3,-228.5,527c-20.7,34.7,-41.7,66.3,-63,95c-2,3.3,-4,7,-6,11\nc0,7.3,5.7,11,17,11c0,0,11,0,11,0c9.3,0,14.3,-0.3,15,-1c5.3,-5.3,10.3,-11,15,-17\nc242.7,-294.7,395.3,-681.7,458,-1161c21.3,-164.7,33.3,-350.7,36,-558\nl0,-16944c-2,-159.3,-10,-310.7,-24,-454c-53.3,-528,-210,-949.7,\n-470,-1265c-4.7,-6,-9.7,-11.7,-15,-17c-0.7,-0.7,-6.7,-1,-18,-1z\"/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.9502em;\"><span></span></span></span></span></span></span></span></span></span><span style=\"top:-1.6599em;\"><span class=\"pstrut\" style=\"height:12.45em;\"></span><span class=\"mord\"><span class=\"mord\">17</span></span></span><span style=\"top:-0.4599em;\"><span class=\"pstrut\" style=\"height:12.45em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:0.7401em;\"><span class=\"pstrut\" style=\"height:12.45em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:13.5501em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:27.6002em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-13.5501em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:16.0501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:16.0501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:16.0501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:16.0501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-26.5002em;\"><span class=\"pstrut\" style=\"height:16.0501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-27.7002em;\"><span class=\"pstrut\" style=\"height:16.0501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-28.9002em;\"><span class=\"pstrut\" style=\"height:16.0501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-30.1002em;\"><span class=\"pstrut\" style=\"height:16.0501em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:13.5501em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[141]= \\begin{array}{|c|c|}\\hline\\text{number of ns labels} & 27\\\\\\hline\\text{dim span of Psi\\_B over all ns} & 17\\\\\\hline\\text{dim of det's direct side} & 17\\\\\\hline\\text{ns with c[ns] != 0} & \\begin{pmatrix}0 & 0 & 0\\\\0 & 0 & 2\\\\0 & 1 & 0\\\\0 & 2 & 0\\\\0 & 2 & 1\\\\0 & 2 & 2\\\\1 & 0 & 0\\\\1 & 0 & 2\\\\1 & 1 & 0\\\\1 & 2 & 0\\\\1 & 2 & 1\\\\1 & 2 & 2\\\\2 & 0 & 0\\\\2 & 1 & 0\\\\2 & 2 & 0\\\\2 & 2 & 1\\\\2 & 2 & 2\\end{pmatrix}\\\\\\hline\\text{how many} & 17\\\\\\hline\\text{EXPANSION EXACT: det - sum\\_ns c[ns] Psi\\_B[ns] = 0} & \\mathrm{True}\\\\\\hline\\text{c[ns] involve only dual Q's} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "ebe6629a-ac26-425f-9560-d52677a11ded"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 15. The coefficients c[ns] are themselves left wave functions: the non-diagonal measure. ---- *)\n(* c[ns] lies in span{Psi_A[ms]}, so  det = sum_{ns,ms} M[ns,ms] Psi_A[ms] Psi_B[ns].\n   Psi_A and Psi_B each span 17 of the 27 labels, so LinearSolve returns one representative;\n   cell 23 shows the grading forces every representative onto Total[ns] == Total[ms]. *)\nClearAll[A27, monsD, Adual, Mrow, Mtab, suppM, residM];\nA27 = PsiAa /@ cube;\nModule[{vs = Union@Cases[Join[A27, cSol], ad[_, _], Infinity], crA, crC},\n  crA = Association[CoefficientRules[Expand[#], vs]] & /@ A27;\n  crC = Association[CoefficientRules[Expand[#], vs]] & /@ cSol;\n  monsD = Union[Join @@ (Keys /@ crA), Join @@ (Keys /@ crC)];\n  Adual = Transpose[Table[Lookup[ca, Key /@ monsD, 0], {ca, crA}]];\n  Mrow = Table[If[cSol[[k]] === 0, ConstantArray[0, Length[cube]], LinearSolve[Adual, Lookup[crC[[k]], Key /@ monsD, 0]]], {k, Length[cube]}];\n];\nMtab = Association@Flatten@Table[If[Mrow[[p, q]] =!= 0, {cube[[p]], cube[[q]]} -> Mrow[[p, q]], Nothing], {p, Length[cube]}, {q, Length[cube]}];\nsuppM = Keys[Mtab];\n(* full verification of the double-sum form *)\nresidM = Expand[detA[trG[[1]]] - Sum[Mtab[k] PsiAa[k[[2]]] PsiBa[k[[1]]], {k, suppM}]];\nGrid[{\n  {\"det = sum_{ns,ms} M[ns,ms] Psi_A[ms] Psi_B[ns] EXACT\", residM === 0},\n  {\"nonzero M entries (of 27x27)\", Length[suppM]},\n  {\"distinct ns / ms appearing\", {Length[Union[First /@ suppM]], Length[Union[Last /@ suppM]]}},\n  {\"entries on ns == ms\", Count[suppM, k_ /; k[[1]] === k[[2]]]},\n  {\"M is NOT diagonal\", Count[suppM, k_ /; k[[1]] =!= k[[2]]] > 0},\n  {\"all entries are dyadic rationals over h^6\", Union[Together[h^6 Values[Mtab]]]},\n  {\"M table (ns <- ms, value x h^6)\", Column[Table[Row[{k[[1]], \" <- \", k[[2]], \"   \", Together[h^6 Mtab[k]]}], {k, SortBy[suppM, {Total@*First, First, Last}]}]]}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"639560\" data-output-id=\"79\" data-out-n=\"148\" data-sub-idx=\"9\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"20\" data-sub-start=\"17\" data-sub-end=\"25\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[148]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"10\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:42.1981em;vertical-align:-20.8291em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:21.3691em;\"><span style=\"top:-23.3291em;\"><span class=\"pstrut\" style=\"height:23.3291em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:42.1581em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-20.8291em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:21.3291em;\"><span style=\"top:-40.2131em;\"><span class=\"pstrut\" style=\"height:19.7241em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">det = sum_{ns,ms} M[ns,ms] Psi_A[ms] Psi_B[ns] EXACT</span></span></span></span><span style=\"top:-39.0131em;\"><span class=\"pstrut\" style=\"height:19.7241em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">nonzero M entries (of 27x27)</span></span></span></span><span style=\"top:-37.8131em;\"><span class=\"pstrut\" style=\"height:19.7241em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">distin