      {
       "data": "Out[54]= \\begin{array}{|c|c|c|}\\hline\\text{basis \\#} & \\text{GT pattern \\{\\{m11\\},\\{m12,m22\\}\\}} & \\text{SoV \\{\\{x21\\},\\{x11,x12\\}\\}}\\\\\\hline1 & \\left\\{\\left\\{2\\right\\},\\left\\{2,1\\right\\}\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{2,1\\right\\}\\right\\}\\\\\\hline2 & \\left\\{\\left\\{2\\right\\},\\left\\{2,0\\right\\}\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{2,0\\right\\}\\right\\}\\\\\\hline3 & \\left\\{\\left\\{1\\right\\},\\left\\{2,1\\right\\}\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{1,1\\right\\}\\right\\}\\\\\\hline4 & \\left\\{\\left\\{1\\right\\},\\left\\{2,0\\right\\}\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{1,0\\right\\}\\right\\}\\\\\\hline5 & \\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\}\\right\\}\\\\\\hline6 & \\left\\{\\left\\{1\\right\\},\\left\\{1,0\\right\\}\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{1,0\\right\\}\\right\\}\\\\\\hline7 & \\left\\{\\left\\{0\\right\\},\\left\\{2,0\\right\\}\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{0,0\\right\\}\\right\\}\\\\\\hline8 & \\left\\{\\left\\{0\\right\\},\\left\\{1,0\\right\\}\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{0,0\\right\\}\\right\\}\\\\\\hline\\text{as a set, equals the SoV list} & \\mathrm{True} & {\\square}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
