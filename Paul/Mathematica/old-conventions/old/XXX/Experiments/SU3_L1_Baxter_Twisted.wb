  {
   "kind": 2,
   "value": "(* ---- 11. Independent check: feed the full Q_k = z_k^{u/h} P_k back into the ORIGINAL Baxter\n     equation assembled from the transfer matrices, at random rational parameters and several u.\n     This does not reuse redBax, so it is not circular. ---- *)\nClearAll[num, nuN, baxDirect, indepChk];\nnum = {th -> 1/3, h -> 1, z1 -> 5/2, z2 -> 7/3, z3 -> 1/6};\nnuN[w_] := (w - th - 2 h) /. num;\nbaxDirect[zk_, Pk_, u0_] := Module[{T1n = T1v /. num, T2n = T2v /. num, T3n = T3v /. num},\n   Simplify[\n     zk^(u0 + 1) (Pk /. u -> u0 + 1) nuN[u0] nuN[u0 - 1] nuN[u0 - 2]\n     - (T1n /. u -> u0) nuN[u0 - 1] nuN[u0 - 2] zk^u0 (Pk /. u -> u0)\n     + (T2n /. u -> u0) nuN[u0 - 2] zk^(u0 - 1) (Pk /. u -> u0 - 1)\n     - (T3n /. u -> u0) zk^(u0 - 2) (Pk /. u -> u0 - 2)]];\nindepChk = Table[Table[baxDirect[{z1, z2, z3}[[k]] /. num, PP[k] /. num, u0], {u0, {2/7, -3/5, 11/4}}], {k, 3}];\nGrid[{\n  {\"parameters\", num},\n  {\"residuals, k = 1,2,3 at u = 2/7, -3/5, 11/4\", indepChk},\n  {\"all vanish\", Union[Flatten[indepChk]] === {0}}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"639560\" data-output-id=\"75\" data-out-n=\"114\" data-sub-idx=\"6\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"14\" data-sub-start=\"13\" data-sub-end=\"17\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[114]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"11\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:6.05em;vertical-align:-2.755em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.295em;\"><span style=\"top:-5.255em;\"><span class=\"pstrut\" style=\"height:5.255em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6.01em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.755em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.255em;\"><span style=\"top:-6.455em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">parameters</span></span></span></span><span style=\"top:-4.045em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">residuals, k = 1,2,3 at u = 2/7, -3/5, 11/4</span></span></span></span><span style=\"top:-1.655em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">all vanish</span></span></span></span></span><span class=\"vlist-s