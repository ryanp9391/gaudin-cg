lass=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord mathnormal\">h</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">th</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">h</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">th</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">3</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">h</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">th</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-0.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[31]= \\begin{array}{|c|c|}\\hline\\text{O acts as O qhat\\_i\\^{}\\{[2]\\}(u) = 0, i.e. on the function u -> qhat\\_i(u+h)} & \\text{(12.40)}\\\\\\hline\\text{nu\\_1\\^{}\\{[-2]\\}(u), nu\\_1\\^{}\\{[-4]\\}(u)} & \\left\\{-3\\,h-\\mathrm{th}+u,-4\\,h-\\mathrm{th}+u\\right\\}\\\\\\hline\\text{nu\\_3\\^{}\\{[2]\\}(u), nu\\_3\\^{}\\{[4]\\}(u), nu\\_3\\^{}\\{[6]\\}(u)} & \\left\\{h-\\mathrm{th}+u,2\\,h-\\mathrm{th}+u,3\\,h-\\mathrm{th}+u\\right\\}\\\\\\hline\\text{cleared form agrees with O times nu\\_1 nu\\_1\\^{}[-2] nu\\_1\\^{}[-4]} & \\mathrm{True}\\\\\\hline\\text{cleared form agrees with Odag times nu\\_3\\^{}[2] nu\\_3\\^{}[4] nu\\_3\\^{}[6]} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "1485130c-126f-428c-b839-b775e51fca81"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 3. The vacuum by DIRECT diagonalization: the weight-[2,1,0] eigenvector and its T_{a,1} eigenvalues. ---- *)\nClearAll[vac, wts, hwPos, eigQ, TvacDiag, TvacPred];\nwts = Transpose[Table[Diagonal[EE[i, i]], {i, 3}]];\nhwPos = First@Flatten@Position[wts, rep];\nvac = UnitVector[dd, hwPos];\n(* is it really a joint eigenvector of every coefficient of every T_a ? *)\neigQ[a_] := And @@ Table[With[{Mk = Coefficient[TT[a][u], u, k]}, Expand[Mk . vac - (Mk . vac)[[hwPos]] vac] === ConstantArray[0, dd]], {k, 0, 2 a}];\n(* eigenvalues read off component hwPos *)\nTvacDiag[a_] := Expand[(TT[a][u] . vac)[[hwPos]]];\n(* the standard vacuum formula: T_a = sum_{i1<...<ia} z_I nu_{i1}(u-(a-1)h) ... nu_{ia}(u) *)\nTvacPred[a_] := Expand[Sum[(Times @@ zz[[II]]) Product[nu[II[[k]]][u - (a - k) h], {k, a}], {II, Subsets[Range[3], {a}]}]];\nGrid[{\n  {\"weights of the 8 basis vectors\", wts},\n  {\"position of weight [2,1,0]\", hwPos},\n  {\"vacuum vector\", vac},\n  {\"is a joint eigenvector of all T_a coefficients\", Table[eigQ[a], {a, 3}]},\n  {\"T_1 eigenvalue\", TvacDiag[1]},\n  {\"T_2 eigenvalue\", TvacDiag[2]},\n  {\"T_3 eigenvalue\", TvacDiag[3]},\n  {\"matches sum_{|I|=a} z_I prod_k nu_{I_k}(u-(a-k)h)\", Table[Expand[TvacDiag[a] - TvacPred[a]] === 0, {a, 3}]}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"639560\" data-output-id=\"67\" data-out-n=\"39\" data-sub-idx=\"11\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"4\" data-sub-start=\"11\" data-sub-end=\"20\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[39]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"10\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:18.157em;vertical-align:-8.8085em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.3485em;\"><span style=\"top:-11.3085em;\"><span class=\"pstrut\" style=\"height:11.3085em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:18.117em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-8.8085em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.3085em;\"><span style=\"top:-11.3085em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">weights of the 8 basis vectors</span></span></span></span><span style=\"top:-5.9184em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">position of weight [2,1,0]</span></span></span></span><span style=\"top:-4.7184em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">vacuum vector</span></span></span></span><span st