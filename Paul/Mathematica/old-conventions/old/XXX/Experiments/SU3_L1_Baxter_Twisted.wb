      {
       "data": "{\n\t\"name\": \"WolframKernelMessage\",\n\t\"message\": \"Solve::svars: Equations may not give solutions for all \\\"solve\\\" variables.\\nSolve::svars: Equations may not give solutions for all \\\"solve\\\" variables.\\nSolve::svars: Equations may not give solutions for all \\\"solve\\\" variables.\",\n\t\"stack\": \"\"\n}",
