  {
   "kind": 2,
   "value": "(* ---- 7. Bridge between the two conventions, and the reason tG must NOT enter the Baxter equation. ---- *)\nClearAll[nuLadder, tGasT, baxWithTG];\n(* nu_1(u) nu_1^{[-2]}(u) ... nu_1^{[-2(a-1)]}(u) *)\nnuLadder[a_][w_] := Product[nu1[w - k h], {k, 0, a - 1}];\n(* companion quantum minors equal the ones of cell 3, and tG[a] = T_{a,1} / (nu_1 ladder) *)\ntGasT = Table[Expand[Together[(tG[a][u] /. bridge) nuLadder[a][u] - TT[a][u]]] === zmat, {a, 3}];\n(* what would go wrong: O already divides by the ladder, so substituting tG would divide twice *)\nbaxWithTG = Simplify[(OpO[(tG[1][u] /. bridge)[[1, 1]], (tG[2][u] /. bridge)[[1, 1]], (tG[3][u] /. bridge)[[1, 1]]][Q1sh][u]/Q1vac[u])];\nGrid[{\n  {\"QM_{I,I}(u) of the companion = qmin_{I,I}(u) of cell 3\", And @@ Table[Expand[(QM[Ii, Ii][u] /. bridge) - qmin[Ii, Ii][u]] === zmat, {Ii, Join @@ Table[Subsets[Range[3], {a}], {a, 3}]}]},\n  {\"tG[a](u) (nu_1 ladder) = T_{a,1}(u), a = 1,2,3\", tGasT},\n  {\"so tG[a] = T_{a,1}/(nu_1 nu_1^[-2] ... ) exactly the coefficients inside O\", And @@ tGasT},\n  {\"CORRECT Baxter input is the polynomial T (cell 6 residual)\", resO},\n  {\"WRONG: feeding tG into O gives a nonzero residual\", baxWithTG =!= 0},\n  {\"tG[a] are the vacuum eigenvalues over the ladder\", Table[Factor[(tG[a][u] /. bridge)[[1, 1]] - TvacDiag[a]/nuLadder[a][u]] === 0, {a, 3}]}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"639560\" data-output-id=\"71\" data-out-n=\"70\" data-sub-idx=\"8\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"10\" data-sub-start=\"8\" data-sub-end=\"15\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[70]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"10\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:7.24em;vertical-align:-3.35em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.89em;\"><span style=\"top:-5.85em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:7.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.85em;\"><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">QM_{I,I}(u) of the companion = qmin_{I,I}(u) of cell 3</span></span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">tG[a](u) (nu_1 ladder) = T_{a,1}(u), a = 1,2,3</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">so tG[a] = T_{a,1}/(nu_1 nu_1</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">[-2] ... ) exactly the coefficients inside O</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">CORRECT Baxter input is the polynomial T (cell 6 residual)</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">WRONG: feeding tG into O gives a nonzero residual</span></span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">tG[a] are the vacuum eigenvalues over the ladder</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:7.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.85em;\"><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:7.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.35em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.35em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[70]= \\begin{array}{|c|c|}\\hline\\text{QM\\_\\{I,I\\}(u) of the companion = qmin\\_\\{I,I\\}(u) of cell 3} & \\mathrm{True}\\\\\\hline\\text{tG[a](u) (nu\\_1 ladder) = T\\_\\{a,1\\}(u), a = 1,2,3} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\text{so tG[a] = T\\_\\{a,1\\}/(nu\\_1 nu\\_1\\^{}[-2] ... ) exactly the coefficients inside O} & \\mathrm{True}\\\\\\hline\\text{CORRECT Baxter input is the polynomial T (cell 6 residual)} & 0\\\\\\hline\\text{WRONG: feeding tG into O gives a nonzero residual} & \\mathrm{True}\\\\\\hline\\text{tG[a] are the vacuum eigenvalues over the ladder} & \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "f88baeb4-9c83-43ce-818a-f9d0575f37d6"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 8. Fused transfer matrices from the RESCALED tG, and the SoV covector basis. ---- *)\n(* The pseudovacuum is a GENERIC covector, not the last GT basis vector: the {0,...,0,1} of the\n   companion .nb came from an earlier notebook and is not the right object here. *)\nClearAll[t, gtpats, x, xmat, xv, xvac, normPsi, PsiVac];\nt[{1, 0, 0}][w_] = tG[1][w];\nt[{1, 1, 0}][w_] = tG[2][w];\nt[{2, 0, 0}][w_] = tG[1][w] . tG[1][w + h] - tG[2][w + h];\nt[{2, 1, 0}][w_] = tG[2][w] . tG[1][w + h] - tG[3][w + h];\ngtpats = {{{1}, {0, 0}}, {{1}, {1, 0}}, {{1}, {1, 1}}, {{2}, {0, 0}}, {{2}, {1, 0}}, {{2}, {1, 1}}, {{2}, {2, 0}}, {{2}, {2, 1}}};\n(* generic 8-component pseudovacuum covector *)\nx[{{1}, {0, 0}}] = {Array[xv, dd]};\nxvac = x[{{1}, {0, 0}}];\n(* act with the fused transfer matrices at u = theta[1]; everything is linear in the xv[i] *)\nx[{{1}, {1, 0}}] = Together[x[{{1}, {0, 0}}] . t[{1, 0, 0}][theta[1]]];\nx[{{1}, {1, 1}}] = Together[x[{{1}, {0, 0}}] . t[{1, 1, 0}][theta[1]]];\nx[{{2}, {0, 0}}] = Together[x[{{1}, {0, 0}}] . t[{2, 0, 0}][theta[1]] . Inverse[t[{1, 0, 0}][theta[1]]]];\nx[{{2}, {1, 0}}] = Together[x[{{2}, {0, 0}}] . t[{1, 0, 0}][theta[1]]];\nx[{{2}, {1, 1}}] = Together[x[{{2}, {0, 0}}] . t[{1, 1, 0}][theta[1]]];\nx[{{2}, {2, 0}}] = Together[x[{{2}, {0, 0}}] . t[{2, 0, 0}][theta[1]]];\nx[{{2}, {2, 1}}] = Together[x[{{2}, {0, 0}}] . t[{2, 1, 0}][theta[1]]];\nxmat = Flatten[x /@ gtpats, 1];\n(* normalisation convention: every state Psi is rescaled so that <x_vac|Psi> = 1 *)\nnormPsi[psi_] := psi/First[xvac . psi];\nPsiVac = normPsi[vac];\nGrid[{\n  {\"gtpats (8 SoV labels)\", gtpats},\n  {\"pseudovacuum (generic)\", xvac},\n  {\"covector matrix dimensions\", Dimensions[xmat]},\n  {\"rank of the SoV covector system (must be 8)\", MatrixRank[xmat]},\n  {\"normalised vacuum state Psi_vac\", PsiVac},\n  {\"<x_vac | Psi_vac> = 1\", Simplify[First[xvac . PsiVac]] === 1}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
