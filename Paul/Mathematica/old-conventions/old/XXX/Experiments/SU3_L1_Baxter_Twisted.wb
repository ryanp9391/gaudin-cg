      {
       "data": "Out[134]= \\begin{array}{|c|c|}\\hline\\text{poles of M} & \\left\\{\\mathrm{th},h+\\mathrm{th},2\\,h+\\mathrm{th}\\right\\}\\\\\\hline\\text{residue weights} & \\left\\{\\frac{1}{2\\,h^2},-\\frac{1}{h^2},\\frac{1}{2\\,h^2}\\right\\}\\\\\\hline\\text{direct sample points n, from the residues} & \\left\\{-1,0,1,2\\right\\}\\\\\\hline\\text{dual sample points n, from the residues} & \\left\\{0,1,2,3\\right\\}\\\\\\hline\\text{direct sample points n, from Psi\\_B over all ns} & \\left\\{-1,0,1,2\\right\\}\\\\\\hline\\text{dual sample points n, from Psi\\_A over all ms} & \\left\\{0,1,2,3\\right\\}\\\\\\hline\\text{row triples with the right Q-content (unique)} & \\begin{pmatrix}\\left\\{1,1\\right\\} & \\left\\{1,2\\right\\} & \\left\\{2,1\\right\\}\\end{pmatrix}\\\\\\hline\\text{row (1,1)} & \\left(\\begin{aligned}-\\frac{\\mathrm{ad}\\left(1,0\\right)\\,\\mathrm{au}\\left(1,0\\right)}{2\\,h^2}+\\frac{\\mathrm{ad}\\left(1,1\\right)\\,\\mathrm{au}\\left(1,1\\right)}{h^2}-\\frac{\\mathrm{ad}\\left(1,2\\right)\\,\\mathrm{au}\\left(1,2\\right)}{2\\,h^2}\\\\\\frac{\\mathrm{ad}\\left(1,0\\right)\\,\\mathrm{au}\\left(1,-1\\right)}{2\\,h^2}-\\frac{\\mathrm{ad}\\left(1,1\\right)\\,\\mathrm{au}\\left(1,0\\right)}{h^2}+\\frac{\\mathrm{ad}\\left(1,2\\right)\\,\\mathrm{au}\\left(1,1\\right)}{2\\,h^2}\\\\\\frac{\\mathrm{ad}\\left(1,1\\right)\\,\\ma… [latex truncated: 1413 chars total]",
