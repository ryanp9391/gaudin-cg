      {
       "data": "Out[108]= \\begin{array}{|c|c|}\\hline\\text{monic P\\_1(u)} & 1\\\\\\hline\\text{monic P\\_2(u)} & \\frac{-h\\,z1+2\\,h\\,z2-\\mathrm{th}\\,z1+\\mathrm{th}\\,z2}{z1-z2}+u\\\\\\hline\\text{monic P\\_3(u)} & \\frac{h^2\\,\\left(z1^2\\,z2-3\\,z1\\,z2\\,z3+2\\,z3^3\\right)}{\\left(z1-z3\\right)^2\\,\\left(z3-z2\\right)}+\\frac{h\\,z3\\,\\left(\\mathrm{th}-u\\right)\\,\\left(z1+2\\,z2-3\\,z3\\right)}{\\left(z1-z3\\right)\\,\\left(z3-z2\\right)}+\\left(\\mathrm{th}-u\\right)^2\\\\\\hline\\text{degrees (deg P\\_k = lambda\\_1 - mu\\_k with mu = (2,1,0))} & \\left\\{0,1,2\\right\\}\\\\\\hline\\text{Bethe roots} & \\left\\{\\{\\},\\left\\{\\frac{h\\,z1-2\\,h\\,z2+\\mathrm{th}\\,z1-\\mathrm{th}\\,z2}{z1-z2}\\right\\},\\left\\{-\\frac{1}{2}\\,\\sqrt{\\frac{h^2\\,\\left(z1^2\\,\\left(z3-2\\,z2\\right)^2-2\\,z1\\,z3\\,\\left(6\\,z2^2-8\\,z2\\,z3+3\\,z3^2\\right)+z3^2\\,\\left(z3-2\\,z2\\right)^2\\right)}{\\left(z1-z3\\right)^2\\,\\left(z2-z3\\right)^2}}+\\frac{h\\,z3\\,\\left(z1+2\\,z2-3\\,z3\\right)}{2\\,\\left(z1-z3\\right)\\,\\left(z3-z2\\right)}+\\mathrm{th},\\frac{1}{2}\\,\\sqrt{\\frac{h^2\\,\\left(z1^2\\,\\left(z3-2\\,z2\\right)^2-2\\,z1\\,z3\\,\\left(6\\,z2^2-8\\,z2\\,z3+3\\,z3^2\\right)+z3^2\\,\\left(z3-2\\,z2\\right)^2\\right)}{\\left(z1-z3\\right)^2\\,\\left(z2-z3\\right)^2}}+\\frac{h\\,z3\\,\\left(z1+2\\,z2-3\\,z3\\right)}{2\\,\\left(z1-z3\\right)\\,\\left(z3-z… [latex truncated: 1360 chars total]",
