      {
       "data": "Out[160]= \\begin{array}{|c|c|c|c|}\\hline\\text{mu} & \\text{untwisted N'} & \\text{2x2 good block (1e-3, 1e-4)} & \\text{det M'/(6x6 $\\times$ 2x2) (1e-3, 1e-4)}\\\\\\hline\\left\\{2,2,0,0\\right\\} & -1306.32581325 & \\left\\{-1292.262882,-1304.917861\\right\\} & \\left\\{87.52193661,87.41204554\\right\\}\\\\\\hline\\left\\{2,1,1,0\\right\\} & 6661.87874418 & \\left\\{6619.975988,6657.682252\\right\\} & \\left\\{0.005413221810,0.0005427536807\\right\\}\\\\\\hline\\left\\{1,1,1,1\\right\\} & -142.333333333 & \\left\\{-142.3330247,-142.3333302\\right\\} & \\left\\{-1.883912361,-1.888390263\\right\\}\\\\\\hline\\end{array}",
