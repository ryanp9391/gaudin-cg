       "data": "Out[141]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|c|}\\hline\\left\\{2,2,0,0\\right\\} & \\frac{1}{3} & \\frac{4}{3} & \\frac{7}{3} & \\frac{1}{7} & \\frac{8}{7} & \\frac{15}{7}\\\\\\hline\\text{q1} & 1 & 1 & 1 & 1 & 1 & 1\\\\\\hline\\text{q2} & \\frac{1}{3} & \\frac{4}{3} & \\frac{7}{3} & \\frac{1}{7} & \\frac{8}{7} & \\frac{15}{7}\\\\\\hline\\text{q3} & -\\frac{58}{567} & -\\frac{208}{567} & \\frac{1106}{81} & -\\frac{122}{7203} & -\\frac{4672}{7203} & \\frac{20250}{2401}\\\\\\hline\\text{q4} & -\\frac{1948}{35721} & -\\frac{26752}{35721} & \\frac{30356}{729} & -\\frac{124}{64827} & -\\frac{10496}{9261} & \\frac{57500}{2401}\\\\\\hline\\text{q\\^{}4} & 1 & 1 & 1 & 1 & 1 & 1\\\\\\hline\\text{q\\^{}3} & \\frac{1}{3} & \\frac{4}{3} & \\frac{7}{3} & \\frac{1}{7} & \\frac{8}{7} & \\frac{15}{7}\\\\\\hline\\text{q\\^{}2} & \\frac{416}{567} & \\frac{3344}{567} & \\frac{896}{81} & \\frac{1096}{7203} & \\frac{35648}{7203} & \\frac{23400}{2401}\\\\\\hline\\text{q\\^{}1} & \\frac{127382}{35721} & \\frac{1105088}{35721} & \\frac{42506}{729} & \\frac{46706}{64827} & \\frac{239104}{9261} & \\frac{122250}{2401}\\\\\\hline\\text{Q12} & 1 & 1 & 1 & 1 & 1 & 1\\\\\\hline\\text{Q123} & \\frac{17}{21} & 0 & \\frac{25}{21} & \\frac{25}{21} & 0 & \\frac{17}{21}\\\\\\hline\\text{Q\\^{}34} & 1 & 1 & 1 & 1 & 1 & … [latex truncated: 4522 chars total]",
