      {
       "data": "Out[124]= \\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{mu} & \\text{p per ray} & \\text{direct u\\^{}j per ray} & \\text{dual u\\^{}j per ray} & \\text{exponents (fit)} & \\text{exponents (rounded)} & \\text{max fit residual} & \\text{K = C6/prod a\\_ij\\^{}n per ray} & \\text{spread of K}\\\\\\hline\\left\\{2,1,1,0\\right\\} & \\left\\{20,20,20,20,20,20,20,20,20,20\\right\\} & \\begin{pmatrix}0 & 0 & 0 & 0\\end{pmatrix} & \\begin{pmatrix}0 & 0 & 0 & 0\\end{pmatrix} & \\left\\{3.52204,3.51290,2.54711,3.00993,4.57761,3.15615\\right\\} & \\left\\{4,4,3,3,5,3\\right\\} & 3.01 & \\left\\{-0.001621020359,0.1027476246,-0.009887191233,-0.0005399662882,0.0004821379540,-0.005450377644,-0.0002818731580,0.01769775782,-0.01777192519,0.07154457785\\right\\} & 7.68\\\\\\hline\\left\\{2,2,0,0\\right\\} & \\left\\{20,20,20,20,20,20,20,20,20,20\\right\\} & \\begin{pmatrix}0 & 0 & 0 & 0\\end{pmatrix} & \\begin{pmatrix}0 & 0 & 0 & 0\\end{pmatrix} & \\left\\{2.61361,0.972713,2.26507,7.05557,4.27784,2.06507\\right\\} & \\left\\{3,1,2,7,4,2\\right\\} & 1.49 & \\left\\{-7.518532430\\times 10^{-6},0.00002455047135,4.479803567\\times 10^{-6},-0.00001462447285,-1.782464738\\times 10^{-6},3.355900559\\times 10^{-6},-0.00001634308922,8.502533129\\times 10^{-6},-7.465528908\\times 10^{-6… [latex truncated: 1717 chars total]",
