  {
   "kind": 2,
   "value": "(* ---- 2. Untwisted solutions (as in SU4_SoV_Orthogonality_Untwisted_L2.wb): tc, q_1..q_4 (staggered degrees), q^1..q^4. ---- *)\nClearAll[UntwSolve0, cq, ce];\nUntwSolve0[S_, P_, μ_] := UntwSolve0[S, P, μ] = Module[{dh = Mdeg[S, P, μ] + Range[0, 3], dd = μ[[{4, 3, 2, 1}]] + Range[0, 3], js = {4, 3, 2, 1}, x, pf, G, eqs, sol, rec, qd = <||>},\n   pf[k_] := Function[y, Evaluate[y^dh[[k]] + Sum[cq[k, m] y^m, {m, 0, dh[[k]] - 1}]]];\n   eqs = Join[DeleteCases[Flatten[Table[CoefficientList[Expand[BaxRes[S, P, μ][1][pf[k]][x] /. sub0], x], {k, 4}]], 0], Flatten[Table[If[dh[[l]] < dh[[k]], cq[k, dh[[l]]], Nothing], {k, 4}, {l, k - 1}]]];\n   sol = Solve[(# == 0 &) /@ eqs, Join[tcvars, Flatten[Table[cq[k, m], {k, 4}, {m, 0, dh[[k]] - 1}]]]];\n   If[Length[sol] =!= 1, Return[$Failed]];\n   rec = <|\"mu\" -> μ, \"tc\" -> (tcvars /. First[sol]), \"q\" -> Table[CoefficientList[pf[k][x] /. First[sol], x], {k, 4}]|>;\n   Do[With[{j = js[[a]]}, G = Function[y, Evaluate[y^dd[[a]] + Sum[ce[j, m] y^m, {m, 0, dd[[a]] - 1}]]];\n     eqs = Join[DeleteCases[CoefficientList[Expand[BaxResD[S, P, μ][G][x] /. Thread[tcvars -> rec[\"tc\"]] /. sub0], x], 0], Table[If[dd[[b]] < dd[[a]], ce[j, dd[[b]]], Nothing], {b, a - 1}]];\n     sol = Solve[(# == 0 &) /@ eqs, Table[ce[j, m], {m, 0, dd[[a]] - 1}]];\n     qd[j] = If[Length[sol] === 1, CoefficientList[G[x] /. First[sol], x], $Failed]], {a, 4}];\n   Append[rec, \"qd\" -> qd]];\nGrid[Prepend[{#, UntwSolve0[1, 1, #][\"tc\"], Length /@ UntwSolve0[1, 1, #][\"q\"] - 1, Length /@ Values[UntwSolve0[1, 1, #][\"qd\"]] - 1} & /@ {{2, 2, 0, 0}, {2, 1, 1, 0}, {1, 1, 1, 1}}, {\"mu\", \"tc (z=1)\", \"deg q_k\", \"deg q^4..q^1\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"331408\" data-output-id=\"1\" data-out-n=\"33\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"2\" data-sub-start=\"13\" data-sub-end=\"13\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[33]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"12\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.87em;vertical-align:-2.165em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.705em;\"><span style=\"top:-4.665em;\"><span class=\"pstrut\" style=\"height:4.665em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:4.83em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.165em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.665em;\"><span style=\"top:-4.825em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">mu</span></span></span></span><span style=\"top:-3.615em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-2.405em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-1.195em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.165em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:4.83em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.165em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-al