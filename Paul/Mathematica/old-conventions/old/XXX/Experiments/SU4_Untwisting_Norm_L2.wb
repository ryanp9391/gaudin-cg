  {
   "kind": 2,
   "value": "(* ---- 20. Fit log|C6(mu)/C6(mu')| over the ten rays to a monomial in |a_i - a_j|; residual and constant. ---- *)\nClearAll[ratioFit];\nratioFit[s1_, s2_] := Module[{c1 = C6data[[s1, 2, All, 3]], c2 = C6data[[s2, 2, All, 3]], X = N[Table[Prepend[Log[Abs[aDiffs[r]]], 1], {r, raysG}], 30], y, sol, nR, K},\n   y = Log[Abs[c1/c2]]; sol = LeastSquares[X, y]; nR = Round[Rest[sol]];\n   K = Table[(c1[[r]]/c2[[r]])/Times @@ (aDiffs[raysG[[r]]]^nR), {r, 10}];\n   {C6data[[s1, 1]], C6data[[s2, 1]], N[Rest[sol], 5], N[Max[Abs[X . sol - y]], 3], nR, N[Mean[K], 10], N[(Max[K] - Min[K])/Abs[Mean[K]], 3]}];\nratioTab = {ratioFit[2, 1], ratioFit[3, 1], ratioFit[3, 2]};\nGrid[Prepend[ratioTab, {\"mu\", \"mu'\", \"fitted exponents\", \"max log residual\", \"rounded exponents\", \"constant K_mu/K_mu'\", \"spread\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
