  {
   "kind": 2,
   "value": "(* ---- 18d. Block dominance for the first common product row choice: full 8x8 = 2 good rows + these 6 full rows. ---- *)\ndomCommon = MemoryConstrained[TimeConstrained[Table[{mu, Table[blockTest[1, 1, mu, commonSets[[1]], e, 120], {e, {1/1000, 1/10000}}], N[Det[Mp[1, 1, untQ[1, 1, mu], untQ[1, 1, mu], rowsDef][[1 ;; 2, 1 ;; 2]]], 12]}, {mu, {{2, 2, 0, 0}, {2, 1, 1, 0}, {1, 1, 1, 1}}}], 1200, \"TIME LIMIT HIT\"], 3*10^9, \"MEMORY LIMIT HIT\"];\nIf[StringQ[domCommon], domCommon, Grid[Prepend[{#[[1]], #[[3]], N[#[[2, All, 3]], 10], N[#[[2, All, 4]], 10]} & /@ domCommon, {\"mu\", \"untwisted N'\", \"2x2 good block (1e-3, 1e-4)\", \"det M'/(6x6 × 2x2) (1e-3, 1e-4)\"}], Frame -> All]]",
   "languageId": "wolfram",
