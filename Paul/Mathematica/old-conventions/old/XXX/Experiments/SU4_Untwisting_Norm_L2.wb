       "data": "Out[54]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{mu} & \\text{rank M'(0)} & \\text{rank cols 1-2} & \\text{rank cols 3-8} & \\text{dim ker} & \\text{ker inside w3..w8} & \\text{kernel (w-coords)}\\\\\\hline\\left\\{2,2,0,0\\right\\} & 5 & 2 & 5 & 3 & \\mathrm{False} & \\begin{pmatrix}\\frac{13919}{27783} & -\\frac{54188}{27783} & 0 & 0 & -\\frac{52}{21} & -1 & 0 & 1\\\\-\\frac{288472}{361179} & \\frac{828082}{361179} & -\\frac{508}{273} & 0 & \\frac{31}{42} & 1 & 1 & 0\\\\\\frac{425}{6552} & -\\frac{1591}{3276} & -\\frac{21}{52} & 1 & 0 & 0 & 0 & 0\\end{pmatrix}\\\\\\hline\\left\\{2,1,1,0\\right\\} & 6 & 2 & 6 & 2 & \\mathrm{False} & \\begin{pmatrix}-\\frac{26}{21} & \\frac{52}{7} & -\\frac{104}{21} & -\\frac{20}{21} & 0 & 1 & 2 & 1\\\\-\\frac{1}{2} & \\frac{53}{21} & 1 & -\\frac{52}{21} & 1 & 0 & 0 & 0\\end{pmatrix}\\\\\\hline\\left\\{1,1,1,1\\right\\} & 6 & 2 & 6 & 2 & \\mathrm{False} & \\begin{pmatrix}\\frac{1224662275}{112587381} & -\\frac{217567991590}{5516781669} & -\\frac{1188333212}{87567963} & \\frac{51096881600}{1838927223} & -\\frac{785200244}{87567963} & -\\frac{32314271}{4169903} & 0 & 1\\\\-\\frac{6398442529}{1576223334} & \\frac{82203264359}{5516781669} & \\frac{106238597}{87567963} & -\\frac{12970779172}{1838927223} & \\frac{243098707}{875679… [latex truncated: 1270 chars total]",
