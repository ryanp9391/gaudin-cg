  {
   "kind": 2,
   "value": "(* ---- 3. Twisted state tending to the highest weight of irrep mu, and its regularised Q-functions.\n   twState: among the twisted solutions of weight mu, the one whose tc is closest to the untwisted tc of irrep mu.\n   regQ: R_k = Sum_l c_l Q_l, R^k = Sum_l d_l Q^l (Q_l = z_l^u q_l, Q^l the uncentred Hodge dual), fixed by matching\n   the untwisted q_k, q^k at u = 0,1,2,3. They are exact twisted solutions; numerics at precision prec. h = 1. ---- *)\nClearAll[twState, regQ, untQ];\ntwState[S_, P_, μ_, ε_] := Module[{sols = TwistedSolve[S, P, μ, zeps[ε]], t0 = UntwSolve0[S, P, μ][\"tc\"] /. prm}, First[SortBy[sols, Norm[N[#[\"tc\"] - t0, 30]] &]]];\nregQ[S_, P_, μ_, ε_, prec_] := Module[{rec = twState[S, P, μ, ε], u0 = UntwSolve0[S, P, μ], sub = zeps[ε], zN, qN, zeta, qdN, Qn, Qdn, A, B, cdir, cdual, xx},\n   zN = N[Table[z[l] /. sub, {l, 4}], prec]; qN = N[rec[\"q\"], prec];\n   zeta = Table[Times @@ Delete[zN, l], {l, 4}];\n   qdN = Table[N[CoefficientList[qDual[S, P, rec, sub][l][xx], xx], prec], {l, 4}];\n   Qn[l_, y_] := zN[[l]]^y qpoly[qN[[l]], y];\n   Qdn[l_, y_] := (-1)^l zeta[[l]]^(y - 1) qpoly[qdN[[l]], y - 1];\n   A = Table[Qn[l, m], {m, 0, 3}, {l, 4}]; B = Table[Qdn[l, m], {m, 0, 3}, {l, 4}];\n   cdir = Table[LinearSolve[A, Table[qpoly[u0[\"q\"][[k]], m], {m, 0, 3}]], {k, 4}];\n   cdual = Table[LinearSolve[B, Table[qpoly[u0[\"qd\"][k], m], {m, 0, 3}]], {k, 4}];\n   <|\"mu\" -> μ, \"eps\" -> ε, \"tc\" -> N[rec[\"tc\"], prec], \"sub\" -> sub, \"rec\" -> rec,\n     \"dir\" -> Function[{k, y}, cdir[[k]] . Table[Qn[l, y], {l, 4}]], \"dual\" -> Function[{k, y}, cdual[[k]] . Table[Qdn[l, y], {l, 4}]]|>];\n(* the untwisted Q-functions in the same format *)\nuntQ[S_, P_, μ_] := With[{u0 = UntwSolve0[S, P, μ]}, <|\"mu\" -> μ, \"tc\" -> u0[\"tc\"], \"sub\" -> sub0, \"dir\" -> Function[{k, y}, qpoly[u0[\"q\"][[k]], y]], \"dual\" -> Function[{k, y}, qpoly[u0[\"qd\"][k], y]]|>];\n(* distance of R from the untwisted q at off-grid points *)\nregErr[R_, U_] := Max[Abs[Flatten[Table[{R[\"dir\"][k, y] - U[\"dir\"][k, y], R[\"dual\"][k, y] - U[\"dual\"][k, y]}, {k, 4}, {y, {1/2, 5/2, -3/2, 7/3}}]]]];\n\"3. loaded\"",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"331408\" data-output-id=\"2\" data-out-n=\"39\" data-sub-idx=\"8\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"3\" data-sub-start=\"21\" data-sub-end=\"21\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[39]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"12\" data-latex-b64=\"XHRleHR7My4gbG9hZGVkfQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord text\"><span class=\"mord\">3. loaded</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[39]= \\text{3. loaded}",
       "mime": "text/plain"
      }
     ],
     "id": "d898354a-12df-4b1f-951d-f46fa1f0f540"
    }
   ],
   "metadata": {}
