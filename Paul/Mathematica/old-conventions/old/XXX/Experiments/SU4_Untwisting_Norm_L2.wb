       "data": "Out[79]= \\begin{array}{|c|c|c|c|}\\hline\\text{mu} & \\text{dim ker, 8 rows (cell 9)} & \\text{dim ker, all 32 rows = forced} & \\text{forced kernel (w-coords)}\\\\\\hline\\left\\{2,2,0,0\\right\\} & 3 & 3 & \\begin{pmatrix}\\frac{13919}{27783} & -\\frac{54188}{27783} & 0 & 0 & -\\frac{52}{21} & -1 & 0 & 1\\\\-\\frac{288472}{361179} & \\frac{828082}{361179} & -\\frac{508}{273} & 0 & \\frac{31}{42} & 1 & 1 & 0\\\\\\frac{425}{6552} & -\\frac{1591}{3276} & -\\frac{21}{52} & 1 & 0 & 0 & 0 & 0\\end{pmatrix}\\\\\\hline\\left\\{2,1,1,0\\right\\} & 2 & 2 & \\begin{pmatrix}-\\frac{26}{21} & \\frac{52}{7} & -\\frac{104}{21} & -\\frac{20}{21} & 0 & 1 & 2 & 1\\\\-\\frac{1}{2} & \\frac{53}{21} & 1 & -\\frac{52}{21} & 1 & 0 & 0 & 0\\end{pmatrix}\\\\\\hline\\left\\{1,1,1,1\\right\\} & 2 & 0 & \\{\\}\\\\\\hline\\end{array}",
