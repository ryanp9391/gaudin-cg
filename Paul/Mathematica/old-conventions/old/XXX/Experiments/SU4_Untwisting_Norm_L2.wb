      {
       "data": "Out[49]= \\begin{array}{|c|c|}\\hline\\text{|M'\\^{}\\{AB\\}.w| (cross)} & 0.\\times 10^{-69}\\\\\\hline\\text{|w|} & 2.812412283876425178647721085310200228629741584378747091054906689495265326976623\\\\\\hline\\text{|det M'\\^{}\\{AA\\}|} & 1.9711711921844952261951725733659552115364499275511880371946640674593225\\times 10^{-160}\\\\\\hline\\text{|det M'\\^{}\\{BB\\}|} & 1.5392747224873378332594867561371078259269704763791044658774139726102243\\times 10^{-157}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
