      {
       "data": "Out[101]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{mu} & \\text{ray a} & \\text{power p} & \\text{m6/eps\\^{}p at eps = 1e-3, 1e-4, 1e-5} & \\text{C6 (Richardson)}\\\\\\hline\\left\\{2,2,0,0\\right\\} & \\left\\{1,\\frac{1}{3},-\\frac{1}{2}\\right\\} & 0 & \\left\\{-0.22163096,-0.22260843,-0.22270635\\right\\} & -0.222717232847\\\\\\hline\\left\\{2,2,0,0\\right\\} & \\left\\{2,-1,\\frac{1}{2}\\right\\} & 0 & \\left\\{-3882.9675,-3785.9541,-3776.4138\\right\\} & -3775.35378849\\\\\\hline\\left\\{2,2,0,0\\right\\} & \\left\\{1,3,-2\\right\\} & 2 & \\left\\{-854.26537,-853.74375,-853.69435\\right\\} & -853.688857929\\\\\\hline\\left\\{2,2,0,0\\right\\} & \\left\\{-1,2,\\frac{1}{4}\\right\\} & 0 & \\left\\{1.6012629\\times 10^{8},1.4422846\\times 10^{8},1.4273678\\times 10^{8}\\right\\} & 1.42571041356\\times 10^{8}\\\\\\hline\\left\\{2,1,1,0\\right\\} & \\left\\{1,\\frac{1}{3},-\\frac{1}{2}\\right\\} & 2 & \\left\\{-0.074593326,-0.074951810,-0.074987743\\right\\} & -0.0749917351559\\\\\\hline\\left\\{2,1,1,0\\right\\} & \\left\\{2,-1,\\frac{1}{2}\\right\\} & 2 & \\left\\{-27.724713,-27.632638,-27.623520\\right\\} & -27.6225066374\\\\\\hline\\left\\{2,1,1,0\\right\\} & \\left\\{1,3,-2\\right\\} & 3 & \\left\\{-25.034382,-25.471896,-25.515937\\right\\} & -25.5208300692\\\\\\hline\\left\\{2,1,1,0\\right\\} & \\left\\{-1,2,\\frac… [latex truncated: 1897 chars total]",
       "mime": "text/plain"
