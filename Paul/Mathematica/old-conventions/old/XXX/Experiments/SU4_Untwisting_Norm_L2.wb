  {
   "kind": 2,
   "value": "(* ---- 15. C6 on ten generic rays (eps = 1e-4, 1e-5, first-order Richardson), then a log-linear fit in |a_i - a_j|. ---- *)\nClearAll[C6ray, fitC6, raysG, aFull, aDiffs];\nraysG = {{1, 1/3, -1/2}, {2, -1, 1/2}, {-1, 2, 1/4}, {3, 1, -1}, {1/2, -2, 3}, {-3, 1/2, 1}, {5, 2, -1}, {1, -1/3, 2}, {-2, -1/2, 4}, {3/2, 5/2, -3}};\naFull[r_] := Append[r, -Total[r]];\naDiffs[r_] := With[{a = aFull[r]}, Flatten[Table[a[[i]] - a[[j]], {i, 4}, {j, i + 1, 4}]]];\nC6ray[S_, P_, mu_, ray_, prec_] := Block[{zeps},\n   zeps[e_] := Join[prm, {z[1] -> 1 + e ray[[1]], z[2] -> 1 + e ray[[2]], z[3] -> 1 + e ray[[3]], z[4] -> 1/((1 + e ray[[1]]) (1 + e ray[[2]]) (1 + e ray[[3]]))}];\n   Module[{es = {1/10000, 1/100000}, m, p, c},\n    m = Table[m6Of[S, P, mu, blockSets[[1]], e, prec], {e, es}];\n    p = Round[Log10[Abs[m[[1]]/m[[2]]]]]; c = m/es^p;\n    {p, (10 c[[2]] - c[[1]])/9}]];\nfitC6[data_] := Module[{X = Table[Prepend[Log[Abs[aDiffs[d[[1]]]]], 1], {d, data}], y = Log[Abs[data[[All, 3]]]], sol, nRound, K},\n   sol = LeastSquares[N[X, 30], N[y, 30]]; nRound = Round[Rest[sol]];\n   K = Table[d[[3]]/Times @@ (aDiffs[d[[1]]]^nRound), {d, data}];\n   <|\"exponents (fit)\" -> N[Rest[sol], 6], \"exponents (rounded)\" -> nRound, \"max fit residual\" -> N[Max[Abs[X . sol - y]], 3],\n     \"K = C6/prod a_ij^n per ray\" -> N[K, 10], \"spread of K\" -> N[(Max[K] - Min[K])/Abs[Mean[K]], 3]|>];\nC6data = MemoryConstrained[TimeConstrained[Table[{mu, Table[Join[{r}, C6ray[1, 1, mu, r, 100]], {r, raysG}]}, {mu, {{2, 2, 0, 0}, {2, 1, 1, 0}, {1, 1, 1, 1}}}], 1700, \"TIME LIMIT HIT\"], 3*10^9, \"MEMORY LIMIT HIT\"];\nC6fits = If[StringQ[C6data], C6data, Table[Prepend[fitC6[{#[[1]], #[[2]], #[[3]]} & /@ d[[2]]], \"mu\" -> d[[1]]], {d, C6data}]];\nIf[StringQ[C6fits], C6fits, Grid[Prepend[Values /@ C6fits, Keys[First[C6fits]]], Frame -> All]]",
   "languageId": "wolfram",
   "outputs": [
