      {
       "data": "Out[127]= \\begin{array}{|c|c|}\\hline\\text{state} & \\left\\{2,1,1,0\\right\\}\\\\\\hline\\text{powers} & \\left\\{2\\right\\}\\\\\\hline\\text{coefficients of (a1\\^{}2, a2\\^{}2, a3\\^{}2, a1a2, a1a3, a2a3)} & \\left\\{-4.4104867\\times 10^{7},5.6975156\\times 10^{8},8.7482080\\times 10^{7},-1.9526536\\times 10^{6},1.9432755\\times 10^{7},5.3793490\\times 10^{8}\\right\\}\\\\\\hline\\text{max relative residual} & 2.05\\times 10^{10}\\\\\\hline\\end{array}",
