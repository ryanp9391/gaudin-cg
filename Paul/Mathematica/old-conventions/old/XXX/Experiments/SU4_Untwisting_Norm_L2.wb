      {
       "data": "Out[179]= \\begin{aligned}\n  &\\left\\{\\text{residuals == 0} \\right. \\\\\n  &\\left. \\to \\left\\{\\mathrm{True},\\mathrm{True} \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{True},\\mathrm{True}\\right\\} \\right. \\\\\n  &\\left. ,\\text{dual degrees (mu\\_j = 2,1,1,0)} \\right. \\\\\n  &\\left. \\to \\left\\{2,1,1,0\\right\\} \\right. \\\\\n  &\\left. ,\\text{q\\^{}3 matches TASK formula} \\right. \\\\\n  &\\left. \\to \\mathrm{False} \\right. \\\\\n  &\\left. ,\\text{q\\^{}4 == 1} \\right. \\\\\n  &\\left. \\to \\mathrm{True}\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
