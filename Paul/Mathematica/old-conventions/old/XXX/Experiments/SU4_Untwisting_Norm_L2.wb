      {
       "data": "Out[149]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{mu} & \\text{\\#subsets with consistent power} & \\text{\\#subsets giving a pure twist product} & \\text{their powers (tally)} & \\text{examples \\{rows, p, resid, exponents, K, spread\\}}\\\\\\hline\\left\\{2,2,0,0\\right\\} & 7827 & 321 & \\begin{pmatrix}15 & 32\\\\13 & 16\\\\17 & 12\\\\14 & 126\\\\16 & 16\\\\12 & 119\\end{pmatrix} & \\begin{pmatrix}\\begin{pmatrix}1 & 1\\\\1 & 3\\\\1 & 4\\\\2 & 3\\\\3 & 1\\\\3 & 3\\end{pmatrix} & 12 & 1.14\\times 10^{-6} & \\left\\{1,6,1,1,2,1\\right\\} & -0.002314814901 & 3.36\\times 10^{-6}\\\\\\begin{pmatrix}1 & 1\\\\1 & 3\\\\1 & 4\\\\2 & 3\\\\3 & 1\\\\3 & 4\\end{pmatrix} & 12 & 1.60\\times 10^{-6} & \\left\\{1,3,4,1,2,1\\right\\} & 0.002314812607 & 0.0000109\\\\\\begin{pmatrix}1 & 1\\\\1 & 3\\\\1 & 4\\\\2 & 3\\\\3 & 1\\\\4 & 3\\end{pmatrix} & 12 & 5.51\\times 10^{-7} & \\left\\{1,5,2,0,3,1\\right\\} & -0.002314814176 & 1.81\\times 10^{-6}\\\\\\begin{pmatrix}1 & 1\\\\1 & 3\\\\1 & 4\\\\2 & 3\\\\3 & 2\\\\3 & 3\\end{pmatrix} & 12 & 2.96\\times 10^{-6} & \\left\\{1,5,3,2,0,1\\right\\} & 0.002314815639 & 9.57\\times 10^{-6}\\end{pmatrix}\\\\\\hline\\left\\{2,1,1,0\\right\\} & 6156 & 282 & \\begin{pmatrix}14 & 20\\\\13 & 48\\\\15 & 2\\\\12 & 100\\\\11 & 83\\\\10 & 27\\\\8 & 2\\end{pmatrix} & \\begin{pmatrix}\\begin{pmatrix}1 & 2\\\\1 & 4\\\\… [latex truncated: 2607 chars total]",
