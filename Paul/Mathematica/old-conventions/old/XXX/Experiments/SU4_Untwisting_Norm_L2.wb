  {
   "kind": 2,
   "value": "(* ---- 13. Same block-dominance test for the other two (1,1) states, rows = set 1. Expect det M' ~ eps^(forced kernel dim):\n   {2,2,0,0} -> eps^3, {1,1,1,1} -> finite; and the 2x2 good block -> that state's N'. ---- *)\nClearAll[otherRes];\notherRes = MemoryConstrained[TimeConstrained[Table[\n     With[{rows = Table[blockTest[1, 1, mu, blockSets[[1]], e, 80], {e, {1/1000, 1/10000}}], Nu = N[Det[Mp[1, 1, untQ[1, 1, mu], untQ[1, 1, mu], rowsDef][[1 ;; 2, 1 ;; 2]]], 12]},\n      {mu, Nu, rows[[All, 3]], Round[Log10[Abs[rows[[1, 2]]/rows[[2, 2]]]], 0.01], rows[[All, 4]]}], {mu, {{2, 2, 0, 0}, {1, 1, 1, 1}}}], 800, \"TIME LIMIT HIT\"], 3*10^9, \"MEMORY LIMIT HIT\"];\nIf[StringQ[otherRes], otherRes, Grid[Prepend[otherRes, {\"mu\", \"untwisted N'\", \"2x2 good block (eps=1e-3, 1e-4)\", \"order of det M' in eps\", \"det M'/(6x6 × 2x2) (eps=1e-3, 1e-4)\"}], Frame -> All]]",
   "languageId": "wolfram",
   "outputs": [
