      {
       "data": "Out[92]= \\begin{matrix}\\text{untwisted N' for \\{2,1,1,0\\}: }6661.87874418\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{six full rows} & \\text{eps} & \\text{det M'} & \\text{2x2 good block} & \\text{det M' / (6x6 $\\times$ 2x2)}\\\\\\hline\\begin{pmatrix}2 & 1\\\\3 & 1\\\\4 & 1\\\\3 & 2\\\\4 & 2\\\\4 & 3\\end{pmatrix} & \\frac{1}{1000} & -0.00049522045 & 6619.97598763 & 1.002864318\\\\\\hline\\begin{pmatrix}2 & 1\\\\3 & 1\\\\4 & 1\\\\3 & 2\\\\4 & 2\\\\4 & 3\\end{pmatrix} & \\frac{1}{10000} & -4.9914786\\times 10^{-6} & 6657.68225152 & 1.000285619\\\\\\hline\\begin{pmatrix}1 & 1\\\\2 & 2\\\\3 & 3\\\\4 & 1\\\\3 & 1\\\\4 & 2\\end{pmatrix} & \\frac{1}{1000} & -2.2086822\\times 10^{-9} & 6619.97598763 & 1.002087019\\\\\\hline\\begin{pmatrix}1 & 1\\\\2 & 2\\\\3 & 3\\\\4 & 1\\\\3 & 1\\\\4 & 2\\end{pmatrix} & \\frac{1}{10000} & -2.2253808\\times 10^{-13} & 6657.68225152 & 1.000208144\\\\\\hline\\begin{pmatrix}1 & 1\\\\2 & 2\\\\4 & 4\\\\4 & 1\\\\3 & 2\\\\4 & 3\\end{pmatrix} & \\frac{1}{1000} & 1.5481868\\times 10^{-12} & 6619.97598763 & 1.001222758\\\\\\hline\\begin{pmatrix}1 & 1\\\\2 & 2\\\\4 & 4\\\\4 & 1\\\\3 & 2\\\\4 & 3\\end{pmatrix} & \\frac{1}{10000} & 1.5629826\\times 10^{-17} & 6657.68225152 & 1.000121813\\\\\\hline\\end{array}\\end{matrix}",
