  {
   "kind": 2,
   "value": "(* ---- 4. The transformed 8x8 matrix M'. Rows {s, {i, j}}: ladder s, dual R^j of state A against direct R_i of state B.\n   Columns: the eight coefficients of w = (Δtc1, Δc', Δtc2-2Δtc1, Δtc3-κ3 Δtc1, Δtc5-Δtc1, Δs1, Δs2, Δτ3q). h = 1. ---- *)\nClearAll[E2, ladder, fcol, Mp, wvec, rowsDef];\nE2[S_, P_][x_] := ((1/(Product[x - θ1 - k h, {k, 0, S - 1}] Product[x - θ2 - k h, {k, 0, P - 1}]))/(ν1[S, P][x] ν1[S, P][x - h])) /. prm;\nladder[S_, P_][s_] := ladder[S, P][s] = Module[{x}, Table[With[{u0 = ({θ1, θ2}[[s]] + k h) /. prm}, {u0, Residue[E2[S, P][x], {x, u0}]}], {k, 0, {S, P}[[s]] + 1}]];\nfcol[S_, P_][Rd_, Rr_, y_] := With[{n1 = ν1[S, P][y - 1] /. prm, n4 = ν[S, P][4][y] /. prm, a = Rd[y], r0 = Rr[y], r1 = Rr[y - 1], r2 = Rr[y - 2]},\n   a {-n1 r0 + (n1 + n4) r1 - n4 r2, r1, y^2 r1, y r1, -n4 r2, -y n1 r0, y^3 r1, -y n4 r2}];\nMp[S_, P_, RA_, RB_, rows_] := Table[Sum[p[[2]] fcol[S, P][Function[y, RA[\"dual\"][row[[2, 2]], y]], Function[y, RB[\"dir\"][row[[2, 1]], y]], p[[1]]], {p, ladder[S, P][row[[1]]]}], {row, rows}];\nwvec[S_, P_, A_, B_] := Module[{d = A[\"tc\"] - B[\"tc\"], k3 = -(2 (θ1 + θ2) + (S + P + 2) h) /. prm, k0 = (ν1[S, P][-h] + ν[S, P][4][0]) /. prm, sub = A[\"sub\"]},\n   {d[[1]], d[[4]] - k0 d[[1]], d[[2]] - 2 d[[1]], d[[3]] - k3 d[[1]], d[[5]] - d[[1]], (subl[1, A[\"mu\"]] - subl[1, B[\"mu\"]]) /. sub, (subl[2, A[\"mu\"]] - subl[2, B[\"mu\"]]) /. sub, (τ3quad[S, P, A[\"mu\"]] - τ3quad[S, P, B[\"mu\"]]) /. sub}];\nrowsDef = Flatten[Table[{s, p}, {p, {{2, 1}, {3, 1}, {4, 1}, {3, 2}}}, {s, 2}], 1];\n\"4. loaded; rows = \" <> ToString[rowsDef]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"331408\" data-output-id=\"3\" data-out-n=\"47\" data-sub-idx=\"8\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"4\" data-sub-start=\"11\" data-sub-end=\"11\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[47]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"12\" data-latex-b64=\"XHRleHR7NC4gbG9hZGVkOyByb3dzID0gXHtcezEsIFx7MiwgMVx9XH0sIFx7MiwgXHsyLCAxXH1cfSwgXHsxLCBcezMsIDFcfVx9LCBcezIsIFx7MywgMVx9XH0sIFx7MSwgXHs0LCAxXH1cfSwgXHsyLCBcezQsIDFcfVx9LCBcezEsIFx7MywgMlx9XH0sIFx7MiwgXHszLCAyXH1cfVx9fQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\"><span class=\"mord\">4. loaded; rows = {{1, {2, 1}}, {2, {2, 1}}, {1, {3, 1}}, {2, {3, 1}}, {1, {4, 1}}, {2, {4, 1}}, {1, {3, 2}}, {2, {3, 2}}}</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[47]= \\text{4. loaded; rows = \\{\\{1, \\{2, 1\\}\\}, \\{2, \\{2, 1\\}\\}, \\{1, \\{3, 1\\}\\}, \\{2, \\{3, 1\\}\\}, \\{1, \\{4, 1\\}\\}, \\{2, \\{4, 1\\}\\}, \\{1, \\{3, 2\\}\\}, \\{2, \\{3, 2\\}\\}\\}}",
       "mime": "text/plain"
