  {
   "kind": 2,
   "value": "(* ---- 18c. The constants K of the 82 common product row choices: recognise as rationals (tolerance 1e-7 relative, the Richardson accuracy). ---- *)\nClearAll[ratK, ratTab];\nratK[k_] := With[{r = Rationalize[k, 10^-7 Abs[k]]}, {r, N[Abs[(k - r)/k], 3]}];\nratTab = Table[{c[[1]], c[[2 ;; 4]], ratK /@ c[[8 ;; 10]]}, {c, commonTab}];\nColumn[{Row[{\"largest relative miss of the rational recognition over all 82 x 3 constants: \", N[Max[Flatten[ratTab[[All, 3, All, 2]]]], 3]}],\n  Grid[Prepend[Take[{#[[1]], #[[2]], #[[3, 1, 1]], #[[3, 2, 1]], #[[3, 3, 1]]} & /@ ratTab, UpTo[16]], {\"six rows (i,j)\", \"powers\", \"K {2,2,0,0}\", \"K {2,1,1,0}\", \"K {1,1,1,1}\"}], Frame -> All]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
