  {
   "kind": 2,
   "value": "(* ---- 4. Twisted FSoV identity: which measure? Test at eps = 1e-3. ---- *)\nClearAll[qRY, qLY, polesY, weightsY, poleSetsY, setMeasureY, rowY, tripleY, detNY, psiRefY, cRefY, sampleY, orthoY, matchY, measTabY];\n\nqRY[s_, z_, i_, x_] := z[[i]]^x qpolyY[s[\"q\"][[i]], x];\nqLY[s_, z_, j_, x_] := z[[j]]^(-x) qpolyY[s[\"qd\"][[j]], x];\n\n(* Candidates (offsets n in theta_s + n, per site):\n   \"nu\"         = poles of 1/(nu1 nu2 nu3): {0,1} per site (same as the site ladder for the fundamental);\n   \"siteLadder\" = Gamma_h[nu1]/Gamma_h[nu3^[2]]: lambda3^(s)..lambda1^(s) = {0,1} per site;\n   \"fullLadder\" = {0,1,2,3} at both sites (contrast). *)\npoleSetsY = <|\"nu\" -> {Union[rep1Y], Union[rep2Y]},\n   \"siteLadder\" -> {Range[rep1Y[[3]], rep1Y[[1]]], Range[rep2Y[[3]], rep2Y[[1]]]},\n   \"fullLadder\" -> {Range[0, 3], Range[0, 3]}|>;\nsetMeasureY[type_] := (polesY = Flatten@Table[thetaY[[s]] + poleSetsY[type][[s]], {s, 2}];\n   weightsY = Table[1/Times @@ (polesY[[r]] - Delete[polesY, r]), {r, Length[polesY]}]);\n\n(* Row (alpha,i,j); columns u^beta x (-Q^j Q_i, Q^j Q_i^[-2], Q^j[2] Q_i), beta = 0,1. *)\nrowY[A_, B_, z_, {alpha_, {i_, j_}}] := Sum[\n   With[{x = polesY[[r]]},\n    weightsY[[r]] Exp[2 Pi I (alpha - 1) SetPrecision[x, precY]] *\n     Flatten@Table[x^beta {-qLY[A, z, j, x] qRY[B, z, i, x], qLY[A, z, j, x] qRY[B, z, i, x - 1],\n        qLY[A, z, j, x + 1] qRY[B, z, i, x]}, {beta, 0, 1}]], {r, Length[polesY]}];\ntripleY = {{1, 3}, {1, 2}, {2, 3}};\ndetNY[A_, B_, z_] := Det[rowY[A, B, z, #] & /@ Flatten[Table[{alpha, ij}, {alpha, 2}, {ij, tripleY}], 1]];\npsiRefY[B_, z_] := Product[psiRefLocY[Function[i, Function[x, qRY[B, z, i, x]]], th, 1, 2], {th, thetaY}];\ncRefY[A_, z_] := Product[cRefLocY[Function[j, Function[x, qLY[A, z, j, x]]], th, 3, 2], {th, thetaY}];\n\n(* Orthogonality in the largest weight sector. *)\nsampleY = With[{recs = twY[1/1000][\"recs\"]},\n   With[{w = First@MaximalBy[Union[recs[[All, \"mu\"]]], Count[recs[[All, \"mu\"]], #] &]}, Select[recs, #[\"mu\"] == w &]]];\northoY[type_] := (setMeasureY[type];\n   With[{z = twY[1/1000][\"z\"], S = sampleY},\n    With[{dm = Table[detNY[S[[a]], S[[b]], z], {a, Length[S]}, {b, Length[S]}]},\n     N[Max[Abs[dm - DiagonalMatrix[Diagonal[dm]]]]/Min[Abs[Diagonal[dm]]], 3]]]);\n(* det N/(c^ref Psi^ref) x <L|0><0|R> must be the same for all 9 states (= 1/C_vac). *)\nmatchY[type_] := (setMeasureY[type];\n   With[{z = twY[1/1000][\"z\"], recs = twY[1/1000][\"recs\"]},\n    With[{ratio = Table[detNY[s, s, z]/(cRefY[s, z] psiRefY[s, z]) (s[\"braR\"] s[\"Lket\"]), {s, recs}]},\n     N[Max[Abs[ratio/ratio[[1]] - 1]], 3]]]);\n\nmeasTabY = Table[{type, Row[poleSetsY[type][[1]], \",\"], Row[poleSetsY[type][[2]], \",\"], orthoY[type], matchY[type]},\n   {type, Keys[poleSetsY]}];\nsetMeasureY[\"siteLadder\"];\n\nGrid[Prepend[measTabY, {\"measure\", \"site-1 offsets\", \"site-2 offsets\",\n    Row[{\"max|cross det|/min|diag det| (weight \", Row[sampleY[[1, \"mu\"]], \",\"], \", \", Length[sampleY], \" states)\"}],\n    \"9 states: rel. spread of 1/C_vac\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
