       "data": "Out[663]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{eps} & \\text{max |ratio/ratio\\_vac - 1|, triple (13),(12),(23)}\\\\\\hline\\frac{1}{100} & 0.0655\\\\\\hline\\frac{1}{1000} & 0.00674\\\\\\hline\\frac{1}{10000} & 0.000676\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{multiplet} & \\text{weight} & \\text{ratio/ratio\\_vac (eps = 1e-3)}\\\\\\hline\\text{6} & 0,0,2 & 1.\\,\\\\\\hline\\text{6} & 0,1,1 & 0.9980093163\\\\\\hline\\text{3b} & 0,1,1 & 0.9945706854\\\\\\hline\\text{6} & 0,2,0 & 0.9959093262\\\\\\hline\\text{6} & 1,0,1 & 0.9965358160\\\\\\hline\\text{3b} & 1,0,1 & 0.9945763805\\\\\\hline\\text{6} & 1,1,0 & 0.9945823319\\\\\\hline\\text{3b} & 1,1,0 & 0.9945823319\\\\\\hline\\text{6} & 2,0,0 & 0.9932571058\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{triple} & \\text{spread (eps = 1e-3)}\\\\\\hline\\left\\{1,1\\right\\}\\,\\left\\{1,2\\right\\}\\,\\left\\{2,1\\right\\} & 0.00805\\\\\\hline\\left\\{1,1\\right\\}\\,\\left\\{1,3\\right\\}\\,\\left\\{2,1\\right\\} & 0.00805\\\\\\hline\\left\\{1,2\\right\\}\\,\\left\\{1,1\\right\\}\\,\\left\\{2,2\\right\\} & 0.00992\\\\\\hline\\left\\{1,2\\right\\}\\,\\left\\{1,3\\right\\}\\,\\left\\{2,2\\right\\} & 0.00992\\\\\\hline\\left\\{1,3\\right\\}\\,\\left\\{1,1\\right\\}\\,\\left\\{2,3\\right\\} & 0.00674\\\\\\hline\\left\\{1,3\\right\\}\\,\\left\\{1,2\\right\\}\\,\\left\\{2,3\\r… [latex truncated: 3527 chars total]",
