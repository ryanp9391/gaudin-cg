      {
       "data": "Out[632]= \\begin{array}{|c|c|}\\hline\\text{eps, phi} & \\frac{1}{1000}\\text{  }1,\\frac{1}{3},-\\frac{4}{3}\\\\\\hline\\text{build time (s)} & 0.\\,\\\\\\hline\\text{number of states} & 9\\\\\\hline\\text{max eigen residual} & 0.\\times 10^{-197}\\\\\\hline\\text{max Baxter residual (deg 2-mu\\_i, mu\\_j)} & 0.\\times 10^{-187}\\\\\\hline\\text{states per multiplet (expected 6,3)} & 6,3\\\\\\hline\\text{hw-limit states per multiplet} & 1,1\\\\\\hline\\end{array}",
