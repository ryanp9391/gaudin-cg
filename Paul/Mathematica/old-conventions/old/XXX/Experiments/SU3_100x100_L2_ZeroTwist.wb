       "data": "Out[672]= \\begin{array}{|c|c|}\\hline\\text{twisted w-identity: \\# nonvanishing cross rows} & 30\\\\\\hline\\text{max |row.w|/sum|row\\_c w\\_c|} & 0.\\times 10^{-179}\\\\\\hline\\text{zero twist, all pairs: ds1 = ds2 = a1+a2 = 0} & \\mathrm{True}\\\\\\hline\\text{pairs with a1 != 0 / with a1 = 0} & 0\\text{ / }2\\\\\\hline\\text{a1 = 0 pairs: b1+b2-dc1 = 0} & \\mathrm{True}\\\\\\hline\\text{kappa = (b1+b2-dc1)/a1 (a1 != 0 pairs)} & \\text{undetermined (no pair with a1 != 0)}\\\\\\hline\\text{c used} & 3\\text{  (general rule, not derived here)}\\\\\\hline\\text{number of measure poles - 1} & 3\\\\\\hline\\end{array}",
