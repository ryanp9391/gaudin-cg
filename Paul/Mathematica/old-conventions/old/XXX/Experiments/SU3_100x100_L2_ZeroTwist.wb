  {
   "kind": 2,
   "value": "(* ---- 4b. Diagnostic: the twisted normalization is NOT state-independent for [1,0,0]^2 (spread ~7e-3 at eps = 1e-3).\n   (i) eps-scaling of the spread; (ii) dependence on the row triple {(a,c),(a,d),(b,c)} with Psi^ref(a,b), c^ref(c,d). ---- *)\nClearAll[ratioTabY, spreadY, detNTY, tripleSpreadY, allTriplesY];\n\ndetNTY[A_, B_, z_, tr_] := Det[rowY[A, B, z, #] & /@ Flatten[Table[{alpha, ij}, {alpha, 2}, {ij, tr}], 1]];\n(* Normalized ratio per state for a triple tr with direct content {a,a,b}, dual content {c,c,d}. *)\nratioTabY[eps_, tr_, {a_, b_, c_, d_}] := With[{z = twY[eps][\"z\"], recs = twY[eps][\"recs\"]},\n   With[{r = Table[detNTY[s, s, z, tr]/(Product[cRefLocY[Function[j, Function[x, qLY[s, z, j, x]]], th, c, d], {th, thetaY}]\n           Product[psiRefLocY[Function[i, Function[x, qRY[s, z, i, x]]], th, a, b], {th, thetaY}]) (s[\"braR\"] s[\"Lket\"]), {s, recs}]},\n    r/r[[1]]]];\nspreadY[eps_, tr_, abcd_] := N[Max[Abs[ratioTabY[eps, tr, abcd] - 1]], 3];\n\n(* All 36 triples {(a,c),(a,d),(b,c)}: a != b, c != d. *)\nallTriplesY = Flatten[Table[If[a != b && c != d, {{{a, c}, {a, d}, {b, c}}, {a, b, c, d}}, Nothing], {a, 3}, {b, 3}, {c, 3}, {d, 3}], 3];\ntripleSpreadY = Table[{Row[tr[[1]], \" \"], spreadY[1/1000, tr[[1]], tr[[2]]]}, {tr, allTriplesY}];\n\nColumn[{\n  Grid[Prepend[Table[{e, spreadY[e, tripleY, {1, 2, 3, 2}]}, {e, {1/100, 1/1000, 1/10000}}],\n    {\"eps\", \"max |ratio/ratio_vac - 1|, triple (13),(12),(23)\"}], Frame -> All, Alignment -> Left],\n  Grid[Prepend[Table[{nameY[[s[\"mult\"]]], Row[s[\"mu\"], \",\"], N[Re[r], 10]},\n     {s, twY[1/1000][\"recs\"]}, {r, {ratioTabY[1/1000, tripleY, {1, 2, 3, 2}][[Position[twY[1/1000][\"recs\"], s][[1, 1]]]]}}] // Flatten[#, 1] &,\n    {\"multiplet\", \"weight\", \"ratio/ratio_vac (eps = 1e-3)\"}], Frame -> All, Alignment -> Left],\n  Grid[Prepend[tripleSpreadY, {\"triple\", \"spread (eps = 1e-3)\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"62\" data-out-n=\"663\" data-sub-idx=\"9\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"6\" data-sub-start=\"16\" data-sub-end=\"22\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[663]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"36\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:61.3353em;vertical-align:-30.4177em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:30.9177em;\"><span style=\"top:-52.71em;\"><span class=\"pstrut\" style=\"height:24.49em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.6977em;\"><span style=\"top:-4.6577em;\"><span class=\"pstrut\" style=\"height:4.6577em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:4.8153em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.1577em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.6577em;\"><span style=\"top:-4.8177em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">eps</span></span></span></span><span style=\"top:-3.6126em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mopen nulldelimi