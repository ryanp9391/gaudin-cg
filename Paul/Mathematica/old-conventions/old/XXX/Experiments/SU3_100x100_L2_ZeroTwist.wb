  {
   "kind": 2,
   "value": "(* ---- 7. Column operations on calN (exact algebra): det calN = -det calN'' with, for G_ij = q^j(u) q_i(u-1),\n   calN'' = ( <D+ G>, <c q^j q_i - u D+ G>, <q^j D- q_i> ),  D+f = f(u+1) - f(u), D-f = f(u) - f(u-1).\n   Check against the original columns for all hw states, and at a wrong c for contrast. ---- *)\nClearAll[NmOldY, NmNewY, colTabY];\nNmOldY[m_, c_] := Module[{s = untwNY[[m]], q, qd},\n   q = Function[{i, x}, qpolyY[s[\"q\"][[i]], x]]; qd = Function[{j, x}, qpolyY[s[\"qd\"][[j]], x]];\n   Table[{\n     bracketY[Function[x, qd[ij[[2]], x + 1] q[ij[[1]], x] - qd[ij[[2]], x] q[ij[[1]], x]]],\n     bracketY[Function[x, x qd[ij[[2]], x] q[ij[[1]], x - 1] - (x - c) qd[ij[[2]], x + 1] q[ij[[1]], x]]],\n     bracketY[Function[x, qd[ij[[2]], x] q[ij[[1]], x - 1] - qd[ij[[2]], x + 1] q[ij[[1]], x]]]}, {ij, tripleY}]];\nNmNewY[m_, c_] := Module[{s = untwNY[[m]], q, qd, G},\n   q = Function[{i, x}, qpolyY[s[\"q\"][[i]], x]]; qd = Function[{j, x}, qpolyY[s[\"qd\"][[j]], x]];\n   G = Function[{i, j, x}, qd[j, x] q[i, x - 1]];\n   Table[With[{i = ij[[1]], j = ij[[2]]}, {\n      bracketY[Function[x, G[i, j, x + 1] - G[i, j, x]]],\n      bracketY[Function[x, c qd[j, x] q[i, x] - x (G[i, j, x + 1] - G[i, j, x])]],\n      bracketY[Function[x, qd[j, x] (q[i, x] - q[i, x - 1])]]}], {ij, tripleY}]];\ncolTabY = Table[{nameY[[m]], N[Abs[-Det[NmNewY[m, cHY]]/Det[NmOldY[m, cHY]] - 1], 3],\n    N[Abs[-Det[NmNewY[m, cHY + 1]]/Det[NmOldY[m, cHY]] - 1], 3]}, {m, Length[untwY]}];\nGrid[Prepend[colTabY, {\"multiplet\", \"|-det calN''/det calN - 1|\", \"same with c+1 in calN'' (contrast)\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
