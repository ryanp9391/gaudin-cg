      {
       "data": "Out[686]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{multiplet} & \\text{hw weight} & \\text{physical limit (phi 1)} & \\text{rel. spread (2nd phi, extrapolation)} & \\text{B\\_A/B\\_vac, c = cHY} & \\text{|rhs/lhs - 1|} & \\text{E\\_A/E\\_vac formula} & \\text{E\\_A/E\\_vac required} & \\text{|rhs/lhs - 1|, c = cHY - 1} & \\text{|rhs/lhs - 1|, c = cHY + 1}\\\\\\hline\\text{6} & 2,0,0 & 1.\\, & 0.\\times 10^{-190} & 1.\\, & 0.\\times 10^{-190} & 1 & 1.\\, & 0.\\times 10^{-190} & 0.\\times 10^{-190}\\\\\\hline\\text{3b} & 1,1,0 & 10.3142857142857 & 2.69\\times 10^{-16} & 10.3142857142857 & 8.04\\times 10^{-23} & 4 & 4.00000000000000 & 0.5 & 0.25\\\\\\hline\\end{array}",
