n><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">j</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">4</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">predicted (2-l_i)+(i-1)</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">4</span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">4</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">predicted l_j+3-j</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">4</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">Baxter exact</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[618]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{multiplet} & \\text{hw weight} & \\text{deg q\\_i} & \\text{deg q\\^{}j} & \\text{predicted (2-l\\_i)+(i-1)} & \\text{predicted l\\_j+3-j} & \\text{Baxter exact}\\\\\\hline\\text{6} & 2,0,0 & 0,3,4 & 4,1,0 & 0,3,4 & 4,1,0 & \\mathrm{True}\\\\\\hline\\text{3b} & 1,1,0 & 1,2,4 & 3,2,0 & 1,2,4 & 3,2,0 & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "f41f7f5c-226d-40cd-919f-17d11650fbe8"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 3. Twisted chain at z_j = Exp[eps phi_j]: all 9 states, Q-functions, physical references. ---- *)\nClearAll[precY, phiY, rhoY, zOfY, solveMonicY, nilExpY, refBraY, refKetY, twY, multipletOfY, sectorsY];\n\nprecY = 200;\nphiY = {1, 1/3, -4/3};\nrhoY[a_, k_] := Prime[7 a + k + 1]/(11 + 2 a + k);\nzOfY[eps_, phi_] := N[Exp[eps phi], precY];\nsectorsY = Union[wtY];\n\nsolveMonicY[op_, degree_] := Module[{c, x, q, eqs, aa, bb, sol, res, scale},\n  q = Function[y, Evaluate[y^degree + Sum[c[m] y^m, {m, 0, degree - 1}]]];\n  eqs = CoefficientList[Expand[op[q][x]], x];\n  aa = Table[Coefficient[e, c[m]], {e, eqs}, {m, 0, degree - 1}];\n  bb = eqs /. c[_] -> 0;\n  sol = If[degree == 0, {}, LeastSquares[aa, -bb]];\n  res = If[degree == 0, bb, aa.sol + bb];\n  scale = Max[Join[{1}, Abs@Flatten[{aa, bb}]]];\n  {Append[sol, 1], Max[Abs[res]]/scale}];\n\nnilExpY[mat_, c_] := Module[{acc = IdentityMatrix[Length[mat]], term = IdentityMatrix[Length[mat]]},\n   Do[term = c term.mat/k; acc += term, {k, 1, 8}]; acc];\n(* One-site branch-I reference covector/vector (a13 = 3/5, a23 = 4/7), for any site rep via its generators EE. *)\nrefBraY[EE_, z_] := With[{a12 = -z[[2]] (z[[1]] - z[[3]])/(z[[1]] (z[[2]] - z[[3]])) (3/5)/(4/7), n = Length[EE[1, 1]]},\n   UnitVector[n, 1].nilExpY[Normal@EE[1, 2], a12].nilExpY[Normal@EE[1, 3], 3/5].nilExpY[Normal@EE[2, 3], 4/7]];\nrefKetY[EE_, z_] := With[{a12 = -z[[2]] (z[[1]] - z[[3]])/(z[[1]] (z[[2]] - z[[3]])) (3/5)/(4/7), a13 = 3/5, a23 = 4/7, n = Length[EE[1, 1]]},\n   nilExpY[Normal@EE[2, 1], -z[[1]] (z[[1]] - z[[3]])/(a12 z[[2]] (z[[2]] - z[[3]]))].\n    nilExpY[Normal@EE[3, 1], -z[[1]]^2/(a13 z[[3]]^2)].\n    nilExpY[Normal@EE[3, 2], -z[[2]]^2 (z[[1]] - z[[3]])/(a23 (z[[1]] - z[[2]]) z[[3]]^2)].UnitVector[n, 1]];\n\nmultipletOfY[t1_, t2_] := First@Ordering[Table[\n     Total[Abs[CoefficientList[t1 - N[s[\"T1\"], 50], u]]] + Total[Abs[CoefficientList[t2 - N[s[\"T2\"], 50], u]]],\n     {s, untwY}], 1];\n\ntwY[eps_] := twY[eps, phiY];\ntwY[eps_, phi_List] := twY[eps, phi] = Module[{z = zOfY[eps, phi], recs, bra, ket, tco},\n   Do[tco[a, k] = Normal[TcoY[a, k, z]], {a, 2}, {k, 0, 2 a}];\n   bra = Flatten[KroneckerProduct[refBraY[EE1Y, z], refBraY[EE2Y, z]]];\n   ket = Flatten[KroneckerProduct[refKetY[EE1Y, z], refKetY[EE2Y, z]]];\n   recs = Flatten[Table[\n      Module[{idx = Flatten@Position[wtY, wt], K, vals, vecs, Linv},\n       K = Sum[rhoY[a, k] tco[a, k][[idx, idx]], {a, 2}, {k, 0, 2 a}];\n       {vals, vecs} = Eigensystem[K];\n       vecs = Table[vv/vv[[First@Ordering[-Abs[vv], 1]]], {vv, vecs}];\n       Linv = Inverse[Transpose[vecs]];\n       Table[Module[{vv = vecs[[r]], p, t1, t2, full, left, m, qs, qds},\n         p = First@Ordering[-Abs[vv], 1];\n         t1 = Expand@Sum[(tco[1, k][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 2}];\n         t2 = Expand@Sum[(tco[2, k][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 4}];\n         full = ReplacePart[ConstantArray[SetPrecision[0, precY], dcY], Thread[idx -> vv]];\n         left = ReplacePart[ConstantArray[SetPrecision[0, precY], dcY], Thread[idx -> Linv[[r]]]];\n         m = multipletOfY[t1, t2];\n         qs = Table[solveMonicY[BaxDirY[t1, t2, z[[i]]], degTotY - wt[[i]]], {i, 3}];\n         qds = Table[solveMonicY[BaxDualY[t1, t2, 1/z[[j]]], wt[[j]]], {j, 3}];\n         <|\"mu\" -> wt, \"vec\" -> full, \"left\" -> left, \"T1\" -> t1, \"T2\" -> t2,\n          \"mult\" -> m, \"hwLimit\" -> (untwY[[m, \"mu\"]] == wt),\n          \"eigRes\" -> Max[Flatten@Table[Abs[tco[a, k][[idx, idx]].vv - Coefficient[{t1, t2}[[a]], u, k] vv],\n              {a, 2}, {k, 0, 2 a}]],\n          \"q\" -> qs[[All, 1]], \"qd\" -> qds[[All, 1]], \"bRes\" -> Max[Join[qs[[All, 2]], qds[[All, 2]]]],\n          \"braR\" -> bra.full, \"Lket\" -> left.ket|>],\n        {r, Length[vecs]}]],\n      {wt, sectorsY}], 1];\n   <|\"eps\" -> eps, \"phi\" -> phi, \"z\" -> z, \"recs\" -> recs, \"bra\" -> bra, \"ket\" -> ket|>];\n\nWith[{t = AbsoluteTiming[twY[1/1000]]},\n Grid[{\n   {\"eps, phi\", Row[{1/1000, \"  \", Row[phiY, \",\"]}]},\n   {\"build time (s)\", Round[t[[1]], 0.1]},\n   {\"number of states\", Length[t[[2]][\"recs\"]]},\n   {\"max eigen residual\", N[Max[t[[2]][\"recs\"][[All, \"eigRes\"]]], 3]},\n   {\"max Baxter residual (deg 2-mu_i, mu_j)\", N[Max[t[[2]][\"recs\"][[All, \"bRes\"]]], 3]},\n   {\"states per multiplet (expected 6,3)\", Row[Table[Count[t[[2]][\"recs\"][[All, \"mult\"]], m], {m, Length[untwY]}], \",\"]},\n   {\"hw-limit states per multiplet\", Row[Table[Count[t[[2]][\"recs\"], _?(#[\"hwLimit\"] && #[\"mult\"] == m &)], {m, Length[untwY]}], \",\"]}\n   }, Frame -> All, Alignment -> Left]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
