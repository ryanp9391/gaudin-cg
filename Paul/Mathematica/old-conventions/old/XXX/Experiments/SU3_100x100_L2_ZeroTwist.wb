  {
   "kind": 2,
   "value": "(* ---- 2. Untwisted highest-weight states: (T1,T2) and staggered Q-functions (exact). ---- *)\nClearAll[showY, degTotY, BaxDirY, BaxDualY, polyKernelY, qpolyY, wtY, hwBasisY, hwMusY, hwRecsY, untwY, nameY, psiRefLocY, cRefLocY];\n\n(* Wolfbook replies truncate at the first brace; read results through this. *)\nshowY[e_] := StringReplace[ToString[e, InputForm], {\"{\" -> \"(\", \"}\" -> \")\"}];\n\n(* Twisted degrees: deg q_i = degTotY - mu_i, deg q^j = mu_j, with degTotY = lambda1 summed over sites. *)\ndegTotY = rep1Y[[1]] + rep2Y[[1]];\n\n(* Reduced Baxter operators (direct gauge nu1, dual gauge nu3); z = 1 is untwisted. *)\nBaxDirY[T1_, T2_, z_][q_][x_] := (z nuY[1][x] nuY[1][x - 1] nuY[1][x - 2] q[x + 1] - (T1 /. u -> x) nuY[1][x - 1] nuY[1][x - 2] q[x]\n    + (T2 /. u -> x) nuY[1][x - 2] q[x - 1]/z - qdetY[x] q[x - 2]/z^2);\nBaxDualY[T1_, T2_, y_][g_][x_] := (nuY[3][x + 1] nuY[3][x + 2] nuY[3][x + 3] g[x] - y (T1 /. u -> x + 1) nuY[3][x + 2] nuY[3][x + 3] g[x + 1]\n    + y^2 (T2 /. u -> x + 2) nuY[3][x + 3] g[x + 2] - y^3 qdetY[x + 3] g[x + 3]);\nqpolyY[cl_List, y_] := Fold[#1 y + #2 &, 0, Reverse[cl]];\n\npolyKernelY[op_] := Module[{c, x, pf, eqs, ns, rr},\n   pf = Function[y, Evaluate[Sum[c[m] y^m, {m, 0, 14}]]];\n   eqs = CoefficientList[Expand[op[pf][x]], x];\n   ns = NullSpace[Table[D[e, c[m]], {e, eqs}, {m, 0, 14}]];\n   rr = DeleteCases[RowReduce[Reverse /@ ns], {0 ..}];\n   SortBy[Table[RootReduce /@ (Reverse[r] /. {a___, 0 ..} :> {a}), {r, rr}], Length]];\n\nwtY = Transpose[Table[Diagonal[Normal@EtotY[i, i]], {i, 3}]];\nhwBasisY[w_] := Module[{idx = Flatten@Position[wtY, w]},\n   Transpose@Table[ReplacePart[ConstantArray[0, dcY], Thread[idx -> nv]],\n     {nv, NullSpace[Normal[Join[EtotY[1, 2], EtotY[2, 3]]][[All, idx]]]}]];\n(* hw weights found from the kernel of E12, E23; ordered by height below the vacuum (vacuum first). *)\nhwMusY = SortBy[Select[Union[wtY], #[[1]] >= #[[2]] >= #[[3]] &&\n      Length[NullSpace[Normal[Join[EtotY[1, 2], EtotY[2, 3]]][[All, Flatten@Position[wtY, #]]]]] > 0 &], -(2 #[[1]] + #[[2]]) &];\n\nhwRecsY[w_] := Module[{Bt = hwBasisY[w], r, Rk, evs, ev, p},\n   r = First@Select[Subsets[Range[dcY], {Length[Bt[[1]]]}], Det[Bt[[#]]] =!= 0 &, 1];\n   Rk[a_, k_] := Inverse[Bt[[r]]].(Normal[TcoY[a, k, {1, 1, 1}]].Bt)[[r]];\n   evs = Eigenvectors[Rk[2, 0]];\n   Table[ev = evs[[c]]; p = First@Flatten@Position[Unitize[ev], 1];\n    <|\"mu\" -> w, \"vec\" -> Bt.ev,\n     \"T1\" -> Sum[RootReduce[(Rk[1, k].ev)[[p]]/ev[[p]]] u^k, {k, 0, 2}],\n     \"T2\" -> Sum[RootReduce[(Rk[2, k].ev)[[p]]/ev[[p]]] u^k, {k, 0, 4}]|>, {c, Length[evs]}]];\n\n(* Records: q = q_1,q_2,q_3; qd = q^1,q^2,q^3. No multiplicities here. *)\nuntwY = Module[{recs = Flatten[hwRecsY /@ hwMusY, 1]},\n   recs = SortBy[recs, {First@Flatten@Position[hwMusY, #[\"mu\"]] &, N[Coefficient[#[\"T2\"], u, 0], 30] &}];\n   Table[Append[s, <|\"q\" -> polyKernelY[BaxDirY[s[\"T1\"], s[\"T2\"], 1]],\n      \"qd\" -> Reverse[polyKernelY[BaxDualY[s[\"T1\"], s[\"T2\"], 1]]]|>], {s, recs}]];\n(* 3 x 3 = 6 + 3b; index 1 = vacuum (2,0,0). *)\nnameY = {\"6\", \"3b\"};\n\npsiRefLocY[Qd_, th_, a_, b_] := Qd[a][th + 1] (Qd[a][th] Qd[b][th - 1] - Qd[b][th] Qd[a][th - 1]);\ncRefLocY[Qu_, th_, c_, d_] := (Qu[c][th + 1] (Qu[c][th] Qu[d][th + 1] - Qu[d][th] Qu[c][th + 1])\n    - Qu[c][th] (Qu[c][th] Qu[d][th + 2] - Qu[d][th] Qu[c][th + 2]))/4;\n\nGrid[Prepend[Table[With[{s = untwY[[m]]}, {nameY[[m]], Row[s[\"mu\"], \",\"], Row[Length /@ s[\"q\"] - 1, \",\"],\n     Row[Length /@ s[\"qd\"] - 1, \",\"], Row[(degTotY - s[\"mu\"]) + {0, 1, 2}, \",\"], Row[s[\"mu\"] + {2, 1, 0}, \",\"],\n     And @@ Flatten[{\n        RootReduce[Expand[BaxDirY[s[\"T1\"], s[\"T2\"], 1][Function[y, Evaluate@qpolyY[#, y]]][u]]] === 0 & /@ s[\"q\"],\n        RootReduce[Expand[BaxDualY[s[\"T1\"], s[\"T2\"], 1][Function[y, Evaluate@qpolyY[#, y]]][u]]] === 0 & /@ s[\"qd\"]}]}],\n    {m, Length[untwY]}],\n   {\"multiplet\", \"hw weight\", \"deg q_i\", \"deg q^j\", \"predicted (2-l_i)+(i-1)\", \"predicted l_j+3-j\", \"Baxter exact\"}],\n  Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"58\" data-out-n=\"618\" data-sub-idx=\"22\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"2\" data-sub-start=\"52\" data-sub-end=\"59\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[618]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"36\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:3.64em;vertical-align:-1.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.09em;\"><span style=\"top:-4.05em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">multiplet</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">6</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">3b</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">hw weight</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><spa