  {
   "kind": 2,
   "value": "(* ---- 6. The boxed zero-twist formula: physical limit vs B_A/B_vac, with the site-ladder measure and c = cHY. ---- *)\nClearAll[vandY, hwRecY, gY, epsLimY, phiSetY, lhsY, untwNY, bracketY, BY, EformulaY, relTabY];\n\nvandY[z_, lam_] := Product[(z[[i]] - z[[j]])^(lam[[i]] - lam[[j]]), {i, 3}, {j, i + 1, 3}];\nhwRecY[eps_, phi_, m_] := SelectFirst[twY[eps, phi][\"recs\"], #[\"hwLimit\"] && #[\"mult\"] == m &];\n\n(* V_vac(z)/V_A(z) <L_A|R_A>/(<L_A|0><0|R_A>), with <L_A|R_A> = 1; analytic in eps since both sides scale as eps^(2k). *)\ngY[eps_, phi_, m_] := With[{s = hwRecY[eps, phi, m], z = twY[eps, phi][\"z\"]},\n   vandY[z, untwY[[1, \"mu\"]]]/vandY[z, untwY[[m, \"mu\"]]]/(s[\"braR\"] s[\"Lket\"])];\nepsLimY = {10^-6, 10^-7, 10^-8};\nphiSetY = {{1, 1/3, -4/3}, {2, -1/2, -3/2}};\n(* Quadratic extrapolation to eps = 0, normalized by the vacuum; the 2-point value gives the error bar. *)\nlhsY[phi_] := lhsY[phi] = Table[With[{pts = Table[{e, gY[e, phi, m]/gY[e, phi, 1]}, {e, epsLimY}]},\n     {InterpolatingPolynomial[pts, 0], InterpolatingPolynomial[pts[[2 ;;]], 0]}], {m, Length[untwY]}];\n\n(* Untwisted side: numeric q's, contour bracket over the site-ladder poles. *)\nuntwNY = Table[Join[s, <|\"q\" -> N[s[\"q\"], 250], \"qd\" -> N[s[\"qd\"], 250]|>], {s, untwY}];\nbracketY[f_] := Sum[weightsY[[r]] Exp[2 Pi I SetPrecision[polesY[[r]], 250]] f[polesY[[r]]], {r, Length[polesY]}];\nEformulaY[lam_] := -(lam[[1]] - lam[[2]] + 1) (lam[[2]] - lam[[3]] + 1)/\n   ((lam[[1]] - lam[[3]] + 1)! (lam[[1]] - lam[[2]])! (lam[[2]] - lam[[3]])!);\n(* Returns {det calN/(c^ref Psi^ref), E_lambda}. *)\nBY[m_, c_] := Module[{s = untwNY[[m]], q, qd, Nm, psi, cref},\n   q = Function[{i, x}, qpolyY[s[\"q\"][[i]], x]];\n   qd = Function[{j, x}, qpolyY[s[\"qd\"][[j]], x]];\n   Nm = Table[{\n      bracketY[Function[x, qd[ij[[2]], x + 1] q[ij[[1]], x] - qd[ij[[2]], x] q[ij[[1]], x]]],\n      bracketY[Function[x, x qd[ij[[2]], x] q[ij[[1]], x - 1] - (x - c) qd[ij[[2]], x + 1] q[ij[[1]], x]]],\n      bracketY[Function[x, qd[ij[[2]], x] q[ij[[1]], x - 1] - qd[ij[[2]], x + 1] q[ij[[1]], x]]]}, {ij, tripleY}];\n   psi = Product[psiRefLocY[Function[i, Function[x, q[i, x]]], th, 1, 2], {th, thetaY}];\n   cref = Product[cRefLocY[Function[j, Function[x, qd[j, x]]], th, 3, 2], {th, thetaY}];\n   {Det[Nm]/(cref psi), EformulaY[s[\"mu\"]]}];\n\nScan[lhsY, phiSetY];\n\nrelTabY = Table[Module[{b = BY[m, cHY], b1 = BY[1, cHY], rhs, lhs = lhsY[phiSetY[[1]]][[m, 1]], reqE},\n    rhs = (b[[2]] b[[1]])/(b1[[2]] b1[[1]]);\n    (* E_A/E_vac the physical limit requires, given det calN/(c Psi) *)\n    reqE = lhs b1[[1]]/b[[1]];\n    {nameY[[m]], Row[untwY[[m, \"mu\"]], \",\"],\n     N[Re[lhs], 15],\n     N[Max[Abs[lhsY[phiSetY[[2]]][[m, 1]]/lhs - 1], Abs[lhsY[phiSetY[[1]]][[m, 2]]/lhs - 1]], 3],\n     N[Re[rhs], 15], N[Abs[rhs/lhs - 1], 3],\n     b[[2]]/b1[[2]], N[Re[reqE], 15],\n     N[Abs[With[{bb = BY[m, cHY - 1], bb1 = BY[1, cHY - 1]}, (bb[[2]] bb[[1]])/(bb1[[2]] bb1[[1]])]/lhs - 1], 3],\n     N[Abs[With[{bb = BY[m, cHY + 1], bb1 = BY[1, cHY + 1]}, (bb[[2]] bb[[1]])/(bb1[[2]] bb1[[1]])]/lhs - 1], 3]}], {m, Length[untwY]}];\n\nGrid[Prepend[relTabY, {\"multiplet\", \"hw weight\", \"physical limit (phi 1)\", \"rel. spread (2nd phi, extrapolation)\",\n    \"B_A/B_vac, c = cHY\", \"|rhs/lhs - 1|\", \"E_A/E_vac formula\", \"E_A/E_vac required\",\n    \"|rhs/lhs - 1|, c = cHY - 1\", \"|rhs/lhs - 1|, c = cHY + 1\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"64\" data-out-n=\"686\" data-sub-idx=\"18\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"7\" data-sub-start=\"46\" data-sub-end=\"48\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[686]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"36\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:3.64em;vertical-align:-1.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.09em;\"><span style=\"top:-4.05em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">multiplet</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">6</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">3b</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=