   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 5. The constant c: twisted w-identity, then the zero-twist relation b1 + b2 - dc1 = kappa a1 gives c = kappa - 1.\n   For [1,0,0]^2 the only hw pair (6, 3b) has a1 = 0, so kappa is not determined; c falls back to the general rule\n   c = (l1-l3)^(1) + (l1-l3)^(2) + 1 = 3, which section 6 tests against c = 2, 4. ---- *)\nClearAll[splitT2Y, wVecY, wCheckY, zeroTwistY, kappaSetY, cPredY, cHY];\n\n(* Delta T2 = prod_s(u-th_s-lambda1^(s)-1)(a1 u + b1) + prod_s(u-th_s-lambda3^(s))(a2 u + b2), per-site weights. *)\nsplitT2Y[A_, B_] := Module[{a1, b1, a2, b2, x, dT2},\n   dT2 = Expand[B[\"T2\"] - A[\"T2\"]] /. u -> x;\n   {a1, b1, a2, b2} /. First@Solve[Thread[CoefficientList[dT2 - ((x - thetaY[[1]] - rep1Y[[1]] - 1) (x - thetaY[[2]] - rep2Y[[1]] - 1) (a1 x + b1)\n          + (x - thetaY[[1]] - rep1Y[[3]]) (x - thetaY[[2]] - rep2Y[[3]]) (a2 x + b2)), x] == 0], {a1, b1, a2, b2}]];\n(* w in the c-basis: c1 dc1, c2 b1, c3 (a2+b2), c4 ds1, c5 a1, c6 a2. *)\nwVecY[A_, B_] := With[{sp = splitT2Y[A, B], dT1 = Expand[B[\"T1\"] - A[\"T1\"]]},\n   {Coefficient[dT1, u, 0], sp[[2]], sp[[3]] + sp[[4]], Coefficient[dT1, u, 1], sp[[1]], sp[[3]]}];\n\n(* Twisted cross pairs in the largest sector (all states), all 18 rows. *)\nwCheckY = Module[{z = twY[1/1000][\"z\"], S = sampleY, vals},\n   vals = Flatten@Table[If[a == b, Nothing, With[{w = wVecY[S[[a]], S[[b]]]},\n        Table[With[{rw = rowY[S[[a]], S[[b]], z, {al, {i, j}}]}, With[{den = Total[Abs[rw] Abs[w]]},\n           If[den < 10^-150, Nothing, Abs[rw.w]/den]]], {al, 2}, {i, 3}, {j, 3}]]], {a, Length[S]}, {b, Length[S]}];\n   {Length[vals], Max[vals]}];\n\n(* Zero twist, all untwisted pairs A != B: {ds1, ds2, a1 + a2} and {a1, b1 + b2 - dc1}. *)\nzeroTwistY = Flatten[Table[If[a == b, Nothing,\n     With[{A = untwY[[a]], B = untwY[[b]]}, With[{sp = splitT2Y[A, B], dT1 = Expand[B[\"T1\"] - A[\"T1\"]], dT2 = Expand[B[\"T2\"] - A[\"T2\"]]},\n       {RootReduce /@ {Coefficient[dT1, u, 1], Coefficient[dT2, u, 3], sp[[1]] + sp[[3]]},\n        RootReduce /@ {sp[[1]], sp[[2]] + sp[[4]] - Coefficient[dT1, u, 0]}}]]], {a, Length[untwY]}, {b, Length[untwY]}], 1];\n(* kappa from pairs with a1 != 0; pairs with a1 = 0 must have b1 + b2 - dc1 = 0 too. *)\nkappaSetY = Union[RootReduce[#[[2]]/#[[1]]] & /@ Select[zeroTwistY[[All, 2]], #[[1]] =!= 0 &]];\ncPredY = (rep1Y[[1]] - rep1Y[[3]]) + (rep2Y[[1]] - rep2Y[[3]]) + 1;\ncHY = If[Length[kappaSetY] == 1, kappaSetY[[1]] - 1, cPredY];\n\nGrid[{{\"twisted w-identity: # nonvanishing cross rows\", wCheckY[[1]]},\n   {\"max |row.w|/sum|row_c w_c|\", N[wCheckY[[2]], 3]},\n   {\"zero twist, all pairs: ds1 = ds2 = a1+a2 = 0\", Union[Flatten[zeroTwistY[[All, 1]]]] === {0}},\n   {\"pairs with a1 != 0 / with a1 = 0\", Row[{Count[zeroTwistY[[All, 2, 1]], Except[0]], \" / \", Count[zeroTwistY[[All, 2, 1]], 0]}]},\n   {\"a1 = 0 pairs: b1+b2-dc1 = 0\", Union[Select[zeroTwistY[[All, 2]], #[[1]] === 0 &][[All, 2]]] === {0}},\n   {\"kappa = (b1+b2-dc1)/a1 (a1 != 0 pairs)\", If[kappaSetY === {}, \"undetermined (no pair with a1 != 0)\", Row[kappaSetY, \",\"]]},\n   {\"c used\", Row[{cHY, If[kappaSetY === {}, \"  (general rule, not derived here)\", \"  (derived)\"]}]},\n   {\"number of measure poles - 1\", Length[polesY] - 1}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"63\" data-out-n=\"672\" data-sub-idx=\"14\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"5\" data-sub-start=\"31\" data-sub-end=\"38\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[672]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"36\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.64em;vertical-align:-4.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.09em;\"><span style=\"top:-7.05em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:9.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">twisted w-identity: # nonvanishing cross rows</span></span></span></span><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max |row.w|/sum|row_c w_c|</span></span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">zero twist, all pairs: ds1 = ds2 = a1+a2 = 0</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">pairs with a1 != 0 / with a1 = 0</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">a1 = 0 pairs: b1+b2-dc1 = 0</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">kappa = (b1+b2-dc1)/a1 (a1 != 0 pairs)</span></span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">c used</span></span></span></span><span style=\"top:1.19em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">number of measure poles - 1</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:9.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">30</span></span></span><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">179</span></span></span></span></span></span></span></span></span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"mord text\"><span class=\"mord\"> / </span></span><span class=\"mord\">2</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">undetermined (no pair with a1 != 0)</span></span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">3</span><span class=\"mord text\"><span class=\"mord\"> (general rule, not derived here)</span></span></span></span><span style=\"top:1.19em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">3</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:9.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.1em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
