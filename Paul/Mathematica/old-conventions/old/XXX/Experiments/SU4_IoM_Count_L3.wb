   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 6. L = 3 ---- *)\nres3 = With[{zt = {2, 3, 1/2, 1/5}, z1 = {1, 1, 1, 1}, s3 = Function[{a, b, c}, {{{a, a, 0, 0}, 1/3}, {{b, b, 0, 0}, 1/7}, {{c, c, 0, 0}, 2/5}}]},\n   {countRow[\"(1,1,1) twisted\", s3[1, 1, 1], zt], countRow[\"(2,1,1) twisted\", s3[2, 1, 1], zt],\n    countRow[\"(1,1,1) z=1\", s3[1, 1, 1], z1], countRow[\"(2,1,1) z=1\", s3[2, 1, 1], z1], countRow[\"(2,2,1) z=1\", s3[2, 2, 1], z1]}];\nGrid[Prepend[res3, countHeader], Frame -> All]",
   "languageId": "wolfram",
