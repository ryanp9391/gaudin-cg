      {
       "data": "Out[7]= \\begin{array}{|c|c|}\\hline\\text{Det C[z]} & \\mathrm{zz}\\left(1\\right)\\,\\mathrm{zz}\\left(2\\right)\\,\\mathrm{zz}\\left(3\\right)\\,\\mathrm{zz}\\left(4\\right)\\\\\\hline\\text{Det C[z] at z = Exp[h phi]} & \\mathrm{e}^{h\\,\\left(\\mathrm{ph}\\left(1\\right)+\\mathrm{ph}\\left(2\\right)+\\mathrm{ph}\\left(3\\right)+\\mathrm{ph}\\left(4\\right)\\right)}\\\\\\hline\\text{its h -> 0 limit} & 1\\\\\\hline\\text{Det C[phi] (what A C[z] B would have to reproduce)} & \\mathrm{ph}\\left(1\\right)\\,\\mathrm{ph}\\left(2\\right)\\,\\mathrm{ph}\\left(3\\right)\\,\\mathrm{ph}\\left(4\\right)\\\\\\hline\\end{array}",
