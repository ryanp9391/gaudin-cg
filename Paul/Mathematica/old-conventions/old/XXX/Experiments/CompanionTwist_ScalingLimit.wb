      {
       "data": "Out[4]= \\begin{array}{|c|c|}\\hline\\text{C[z]} & \\begin{pmatrix}\\mathrm{zz}\\left(1\\right)+\\mathrm{zz}\\left(2\\right) & -\\mathrm{zz}\\left(1\\right)\\,\\mathrm{zz}\\left(2\\right)\\\\1 & 0\\end{pmatrix}\\\\\\hline\\text{G} & \\begin{pmatrix}h & 1\\\\0 & 1\\end{pmatrix}\\\\\\hline\\text{G\\^{}-1 C[z] G} & \\begin{pmatrix}\\mathrm{zz}\\left(1\\right)+\\mathrm{zz}\\left(2\\right)-1 & -\\frac{\\left(\\mathrm{zz}\\left(1\\right)-1\\right)\\,\\left(\\mathrm{zz}\\left(2\\right)-1\\right)}{h}\\\\h & 1\\end{pmatrix}\\\\\\hline\\text{(G\\^{}-1 C[z] G - 1)/h} & \\begin{pmatrix}\\frac{\\mathrm{zz}\\left(1\\right)+\\mathrm{zz}\\left(2\\right)-2}{h} & -\\frac{\\left(\\mathrm{zz}\\left(1\\right)-1\\right)\\,\\left(\\mathrm{zz}\\left(2\\right)-1\\right)}{h^2}\\\\1 & 0\\end{pmatrix}\\\\\\hline\\text{companion of (z-1)/h} & \\begin{pmatrix}\\frac{\\mathrm{zz}\\left(1\\right)+\\mathrm{zz}\\left(2\\right)-2}{h} & -\\frac{\\left(\\mathrm{zz}\\left(1\\right)-1\\right)\\,\\left(\\mathrm{zz}\\left(2\\right)-1\\right)}{h^2}\\\\1 & 0\\end{pmatrix}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
