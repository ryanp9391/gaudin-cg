      {
       "data": "Out[201]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{m12} & \\text{m11} & \\text{m22} & \\text{m11==m22} & \\text{localizes alone}\\\\\\hline1 & 0 & 0 & \\mathrm{True} & \\mathrm{True}\\\\\\hline1 & 1 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline1 & 1 & 1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2 & 0 & 0 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2 & 1 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline2 & 1 & 1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline2 & 2 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline2 & 2 & 1 & \\mathrm{False} & \\mathrm{False}\\\\\\hline3 & 0 & 0 & \\mathrm{True} & \\mathrm{True}\\\\\\hline3 & 1 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline3 & 1 & 1 & \\mathrm{True} & \\mathrm{True}\\\\\\hline3 & 2 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline3 & 2 & 1 & \\mathrm{False} & \\mathrm{False}\\\\\\hline3 & 3 & 0 & \\mathrm{False} & \\mathrm{False}\\\\\\hline3 & 3 & 1 & \\mathrm{False} & \\mathrm{False}\\\\\\hline\\end{array}",
       "mime": "text/plain"
