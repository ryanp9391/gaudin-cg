      {
       "data": "Out[196]= \\begin{array}{|c|c|}\\hline\\text{15 independent covectors} & \\mathrm{True}\\\\\\hline\\text{each is a left eigenvector of B(u) at 3 FRESH u} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "4112a4c6-9b5a-4ba3-967c-6536530c8dfb"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* label each x by which B(θ1 + h n) annihilates it, then ask whether it localizes ON ITS OWN *)\nvanish[i_] := Select[Range[-1, 3], (xs[[i]] . Normal[Bop[θ[1] + h #]]) === ConstantArray[0, dtot] &];\nlab[trip_] := Union[{trip[[2, 1]], trip[[1, 1]], trip[[2, 2]] - 1}];\nlabels = Table[First[Select[pats, lab[#] === vanish[i] &]], {i, 15}];\nlocQ = Table[xs[[i, badCols]] === ConstantArray[0, Length[badCols]], {i, 15}];\nGrid[Prepend[\n  SortBy[Table[{labels[[i]][[2, 1]], labels[[i]][[1, 1]], labels[[i]][[2, 2]],\n     labels[[i]][[1, 1]] == labels[[i]][[2, 2]], locQ[[i]]}, {i, 15}], First],\n  {\"m12\", \"m11\", \"m22\", \"m11==m22\", \"localizes alone\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
