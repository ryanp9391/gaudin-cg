  {
   "kind": 2,
   "value": "(* THE RULE: the slots reached are exactly the GT patterns with  m11 == m22. *)\nm11[k_] := pats[[k, 1, 1]]; m12[k_] := pats[[k, 2, 1]]; m22[k_] := pats[[k, 2, 2]];\nGrid[Prepend[\n  Table[{k, m12[k], m11[k], m22[k], wts[[k]], m11[k] == m22[k], MemberQ[pivots, k]}, {k, d1}],\n  {\"slot\", \"m12\", \"m11\", \"m22\", \"weight\", \"m11==m22\", \"localizes\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
