     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"927746\" data-output-id=\"14\" data-out-n=\"164\" data-sub-idx=\"9\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"2\" data-sub-start=\"11\" data-sub-end=\"12\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[164]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:21.64em;vertical-align:-10.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:11.09em;\"><span style=\"top:-13.05em;\"><span class=\"pstrut\" style=\"height:13.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:21.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-10.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:11.05em;\"><span style=\"top:-21.46em;\"><span class=\"pstrut\" style=\"height:11.25em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">dim [3,1,0]</span></span></span></span><span style=\"top:-20.26em;\"><span class=\"pstrut\" style=\"height:11.25em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">chain dim</span></span></span></span><span style=\"top:-19.06em;\"><span class=\"pstrut\" style=\"height:11.25em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">gl(3) relations site 1</span></span></span></span><span style=\"top:-9.45em;\"><span class=\"pst