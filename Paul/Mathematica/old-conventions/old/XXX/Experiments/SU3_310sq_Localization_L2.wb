      {
       "data": "Out[189]= \\begin{array}{|c|c|c|c|}\\hline\\text{lambda} & \\text{dim} & \\text{slots with m11==m22} & \\text{(l1-l2+1)(l2-l3+1)}\\\\\\hline\\left\\{2,1,0\\right\\} & 8 & \\left\\{3,5,7,8\\right\\} & 4\\\\\\hline\\left\\{3,1,0\\right\\} & 15 & \\left\\{7,9,11,13,14,15\\right\\} & 6\\\\\\hline\\left\\{3,0,0\\right\\} & 10 & \\left\\{7,8,9,10\\right\\} & 4\\\\\\hline\\left\\{2,2,0\\right\\} & 6 & \\left\\{1,4,6\\right\\} & 3\\\\\\hline\\left\\{4,2,1\\right\\} & 15 & \\left\\{7,9,11,13,14,15\\right\\} & 6\\\\\\hline\\end{array}",
