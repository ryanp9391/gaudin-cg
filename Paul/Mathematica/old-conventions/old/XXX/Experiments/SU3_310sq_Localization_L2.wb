  {
   "kind": 2,
   "value": "(* the ground site-2 label is (m12,m11,m22) = (1,0,0), i.e. root n-triple (1,0,-1) -- three\n   DISTINCT values, so \"site-2 label = ground\" is exactly \"b vanishes at all three points\". *)\ngndPts = {θ[2] + h, θ[2], θ[2] - h};\nMstack = Join @@ Table[Transpose[Normal[Bop[uu]]], {uu, gndPts}];\nW1 = NullSpace[Mstack];\nvacRef = UnitVector[dtot, dtot];\nGrid[{\n  {\"dim W1 (excitations on the first GT pattern only)\", Length[W1]},\n  {\"annihilated by B at all three ground points\", Max[Table[Max[Abs[Flatten[W1 . Normal[Bop[uu]]]]], {uu, gndPts}]] == 0},\n  {\"contains the SoV reference <0| = e_225\", MatrixRank[Join[W1, {vacRef}]] == Length[W1]}\n  }, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"927746\" data-output-id=\"17\" data-out-n=\"176\" data-sub-idx=\"5\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"5\" data-sub-start=\"6\" data-sub-end=\"10\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[176]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:3.64em;vertical-align:-1.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.09em;\"><span style=\"top:-4.05em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">dim W1 (excitations on the first GT pattern only)</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">annihilated by B at all three ground points</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">contains the SoV reference &lt;0| = e_225</span>