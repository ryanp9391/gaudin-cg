"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-13.3em;\"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-14.5em;\"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-15.7em;\"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-16.9em;\"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-18.1em;\"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-19.3em;\"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-20.5em;\"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-21.7em;\"><span class=\"pstrut\" style=\"height:11.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:9.35em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
