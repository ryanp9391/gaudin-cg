      {
       "data": "Out[47]= \\begin{aligned}\n  &\\left\\{\\text{degrees m\\_k}\\to \\left\\{1,2,5,6\\right\\} \\right. \\\\\n  &\\left. ,\\text{eps\\^{}0 residual vanishes} \\right. \\\\\n  &\\left. \\to \\left\\{\\mathrm{True},\\mathrm{True},\\mathrm{True},\\mathrm{True}\\right\\} \\right. \\\\\n  &\\left. ,\\text{\\#eqs at eps\\^{}1}\\to 38 \\right. \\\\\n  &\\left. ,\\text{\\#unknowns}\\to 23 \\right. \\\\\n  &\\left. ,\\text{\\#solutions}\\to 1,\\text{tau at eps\\^{}1} \\right. \\\\\n  &\\left. \\to \\left\\{\\frac{124\\,\\mathrm{i}}{63},\\frac{416\\,\\mathrm{i}}{21},-\\frac{32384\\,\\mathrm{i}}{1323} \\right. \\right. \\\\\n  &\\left. \\left. ,\\frac{13312\\,\\mathrm{i}}{1323},\\frac{292\\,\\mathrm{i}}{63}\\right\\},\\text{left free} \\right. \\\\\n  &\\left. \\to \\left\\{\\mathrm{qc}\\left(1,1,0\\right),\\mathrm{qc}\\left(1,1,1\\right),\\mathrm{qc}\\left(2,1,0\\right) \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{qc}\\left(2,1,1\\right),\\mathrm{qc}\\left(3,1,0\\right),\\mathrm{qc}\\left(3,1,1\\right) \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{qc}\\left(3,1,2\\right),\\mathrm{qc}\\left(3,1,3\\right),\\mathrm{qc}\\left(4,1,0\\right) \\right. \\right. \\\\\n  &\\left. \\left. ,\\mathrm{qc}\\left(4,1,1\\right),\\mathrm{qc}\\left(4,1,2\\right),\\mathrm{qc}\\left(4,1,3\\right)\\right\\}\\right\\}\n\\end{aligned}",
