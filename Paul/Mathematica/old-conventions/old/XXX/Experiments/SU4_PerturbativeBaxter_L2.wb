       "data": "Out[101]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{variant} & \\text{order n} & \\text{\\#eqs} & \\text{\\#unk} & \\text{status} & \\text{\\#free} & \\text{tau at this order}\\\\\\hline\\text{zero leftovers} & 1 & 38 & 23 & \\text{ok} & 12 & \\left\\{\\frac{124\\,\\mathrm{i}}{63},\\frac{416\\,\\mathrm{i}}{21},-\\frac{32384\\,\\mathrm{i}}{1323},\\frac{13312\\,\\mathrm{i}}{1323},\\frac{292\\,\\mathrm{i}}{63}\\right\\}\\\\\\hline\\text{zero leftovers} & 2 & 38 & 27 & \\text{ok} & 13 & \\left\\{\\mathrm{tcn}\\left(1,2\\right),-\\frac{4\\,\\left(44552025\\,\\mathrm{tcn}\\left(1,2\\right)+361553251\\right)}{42170625},\\frac{208\\,\\left(2121525\\,\\mathrm{tcn}\\left(1,2\\right)+6436231\\right)}{42170625},-\\frac{4\\,\\left(25718175\\,\\mathrm{tcn}\\left(1,2\\right)+99644792\\right)}{42170625},\\mathrm{tcn}\\left(1,2\\right)-\\frac{27976}{4725}\\right\\}\\\\\\hline\\text{zero leftovers} & 3 & 42 & 31 & \\text{INCONSISTENT} & \\text{-} & \\text{-}\\\\\\hline\\text{carry leftovers} & 1 & 38 & 23 & \\text{ok} & 12 & \\left\\{\\frac{124\\,\\mathrm{i}}{63},\\frac{416\\,\\mathrm{i}}{21},-\\frac{32384\\,\\mathrm{i}}{1323},\\frac{13312\\,\\mathrm{i}}{1323},\\frac{292\\,\\mathrm{i}}{63}\\right\\}\\\\\\hline\\text{carry leftovers} & 2 & 38 & 27 & \\text{ok} & 13 & \\left\\{\\mathrm{tcn}\\left(1,2\\right),-\\frac{4\\,\\lef… [latex truncated: 1594 chars total]",
