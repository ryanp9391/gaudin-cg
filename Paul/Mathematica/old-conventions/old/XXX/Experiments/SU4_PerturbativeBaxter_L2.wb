  {
   "kind": 2,
   "value": "(* Same loop, one fix: coefficients still undetermined at lower orders are carried in pend and put back into the UNKNOWN list, not left as symbols. Solve[eqns, vars] treats any symbol outside vars as a parameter and returns {} when the system fails for GENERIC parameter values, even if particular values solve it -- that, not the ansatz, is what killed order 3. *)\nClearAll[runOrders2];\nrunOrders2[S_, P_, μ_, N_] := Module[{dh = UntwSolve[S, P, μ][\"Mhat\"], Pk = UntwSolve[S, P, μ][\"P\"], Qf, R, acc = {}, pend = {}, rep = {}, eqs, unk, sol, fr}, Qf[k_] := Function[y, Evaluate[qpoly[Pk[[k]], y] + Sum[eps^j Sum[qc[k, j, i] y^i, {i, 0, dh[[k]] + j}], {j, N}]]]; R = Table[Bax[N][Qf[k]], {k, 4}]; Do[eqs = DeleteCases[Expand[Flatten[Table[CoefficientList[Coefficient[R[[k]], eps, n], u], {k, 4}]] /. acc], 0]; unk = Select[Join[pend, Table[tcn[i, n], {i, 5}], Flatten[Table[qc[k, n, i], {k, 4}, {i, 0, dh[[k]] + n}]]], FreeQ[If[acc === {}, {}, acc[[All, 1]]], #] &]; sol = Quiet@Solve[(# == 0 &) /@ eqs, unk]; If[sol === {}, rep = Append[rep, {n, Length[eqs], Length[unk], \"INCONSISTENT\", \"-\", \"-\"}]; Break[]]; fr = Complement[unk, First[sol][[All, 1]]]; rep = Append[rep, {n, Length[eqs], Length[unk], \"ok\", Length[fr], Simplify[Table[tcn[i, n], {i, 5}] /. First[sol]]}]; acc = Join[acc, First[sol]]; pend = fr, {n, N}]; rep];\nSetState[1, 1, {2, 2, 0, 0}];\nGrid[Prepend[Most /@ runOrders2[1, 1, {2, 2, 0, 0}, 5], {\"order n\", \"#eqs\", \"#unk\", \"status\", \"#still free\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
