><span class=\"mord\">1</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">v</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">(</span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">)</span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">a</span><span class=\"mord\">2</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">v</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">(</span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">)</span></span><span class=\"mclose nulldelimiter\"></span></span></span></span><span style=\"top:1.4223em;\"><span class=\"pstrut\" style=\"height:3.3214em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen nulldelimiter\"></span><span class=\"mord\">+</span><span class=\"mord mathnormal\">a</span><span class=\"mord\">3</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">v</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">(</span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">)</span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">(</span><span class=\"mord mathnormal\">c</span><span class=\"mord\">01</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">(</span><span class=\"mord mathnormal\">c</span><span class=\"mord\">11</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mclose delimcenter\" style=\"top:0em;\">)</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">)</span></span><span class=\"mclose nulldelimiter\"></span></span></span></span><span style=\"top:2.9223em;\"><span class=\"pstrut\" style=\"height:3.3214em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen nulldelimiter\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord\">degree of limit</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\">2</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.9037em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[71]= \\begin{aligned}\n  &\\left\\{\\text{\\#conditions}\\to 12,\\text{solved} \\right. \\\\\n  &\\left. \\to \\left\\{a1v\\left(-3\\right)\\to 0,a2v\\left(-3\\right)\\to 0 \\right. \\right. \\\\\n  &\\left. \\left. ,a3v\\left(-3\\right)\\to 0,a1v\\left(-2\\right)\\to 0 \\right. \\right. \\\\\n  &\\left. \\left. ,a2v\\left(-2\\right)\\to 0,a3v\\left(-2\\right)\\to 0,a2v \\right. \\right. \\\\\n  &\\left. \\left. \\left(-1\\right)\\to -a1v\\left(-1\\right),a3v\\left(-1\\right)\\to 0\\right\\} \\right. \\\\\n  &\\left. ,\\text{eps\\^{}0 limit}\\to \\frac{2}{3}\\,\\mathrm{i}\\,a1v\\left(-1\\right)\\,u \\right. \\\\\n  &\\left. +a1v\\left(0\\right)+a2v\\left(0\\right) \\right. \\\\\n  &\\left. +a3v\\left(0\\right)\\,\\left(c01+u\\,\\left(c11+u\\right)\\right) \\right. \\\\\n  &\\left. ,\\text{degree of limit}\\to 2\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
