      {
       "data": "Out[91]= \\begin{matrix}\\text{mu = \\{2,1,1,0\\}, M = }\\left\\{0,1,1,2\\right\\}\\text{, so q\\_2 diverges as 1/eps}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{order n} & \\text{\\#eqs} & \\text{\\#unk} & \\text{status} & \\text{\\#free}\\\\\\hline-1 & 0 & 1 & \\text{ok} & 1\\\\\\hline0 & 7 & 7 & \\text{ok} & 4\\\\\\hline1 & 13 & 10 & \\text{ok} & 6\\\\\\hline2 & 14 & 12 & \\text{ok} & 7\\\\\\hline3 & 15 & 13 & \\text{ok} & 7\\\\\\hline4 & 15 & 13 & \\text{ok} & 7\\\\\\hline5 & 15 & 13 & \\text{ok} & 7\\\\\\hline6 & 15 & 8 & \\text{ok} & 2\\\\\\hline\\end{array}\\end{matrix}",
       "mime": "text/plain"
      }
     ],
