       "data": "Out[39]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{seed} & \\text{order n} & \\text{\\#eqs} & \\text{\\#unk} & \\text{status} & \\text{\\#free (set to 0)}\\\\\\hline\\text{seed P\\_}1\\text{ (deg }0\\text{)} & 1 & 7 & 7 & \\text{ok} & 4\\\\\\hline\\text{seed P\\_}1\\text{ (deg }0\\text{)} & 2 & 7 & 8 & \\text{ok} & 5\\\\\\hline\\text{seed P\\_}1\\text{ (deg }0\\text{)} & 3 & 8 & 9 & \\text{ok} & 5\\\\\\hline\\text{seed P\\_}1\\text{ (deg }0\\text{)} & 4 & 9 & 10 & \\text{INCONSISTENT} & \\text{-}\\\\\\hline\\text{seed P\\_}2\\text{ (deg }1\\text{)} & 1 & 8 & 8 & \\text{ok} & 4\\\\\\hline\\text{seed P\\_}2\\text{ (deg }1\\text{)} & 2 & 8 & 9 & \\text{ok} & 5\\\\\\hline\\text{seed P\\_}2\\text{ (deg }1\\text{)} & 3 & 9 & 10 & \\text{INCONSISTENT} & \\text{-}\\\\\\hline\\text{seed P\\_}3\\text{ (deg }4\\text{)} & 1 & 11 & 11 & \\text{ok} & 4\\\\\\hline\\text{seed P\\_}3\\text{ (deg }4\\text{)} & 2 & 11 & 12 & \\text{ok} & 5\\\\\\hline\\text{seed P\\_}3\\text{ (deg }4\\text{)} & 3 & 12 & 13 & \\text{ok} & 5\\\\\\hline\\text{seed P\\_}3\\text{ (deg }4\\text{)} & 4 & 13 & 14 & \\text{ok} & 5\\\\\\hline\\text{seed P\\_}4\\text{ (deg }5\\text{)} & 1 & 12 & 12 & \\text{ok} & 4\\\\\\hline\\text{seed P\\_}4\\text{ (deg }5\\text{)} & 2 & 12 & 13 & \\text{ok} & 5\\\\\\hline\\text{seed P\\_}4\\text{ (deg }5\\text{)} & 3 & 13… [latex truncated: 1316 chars total]",
