      {
       "data": "Out[105]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{order n} & \\text{\\#eqs} & \\text{\\#unk} & \\text{status} & \\text{\\#still free}\\\\\\hline1 & 38 & 23 & \\text{ok} & 12\\\\\\hline2 & 38 & 39 & \\text{ok} & 25\\\\\\hline3 & 42 & 56 & \\text{ok} & 38\\\\\\hline4 & 46 & 73 & \\text{INCONSISTENT} & \\text{-}\\\\\\hline\\end{array}",
