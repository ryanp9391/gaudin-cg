  {
   "kind": 2,
   "value": "(* ---- 12. t-dependence of B_A/B_vac and the normalization it demands of bare eigenvectors. ---- *)\nClearAll[tMoreU, dataMoreU, ratFitU, fitEvenU, octFitU, sqU, normTabU, octDataU, octFitResU];\n\n(* Rational points of t = (m-1)(m-5)/(m^2-5): there sqrt(4+5t^2) is rational, so the octets are rational. *)\ntMoreU = Union@Select[Table[(m - 1) (m - 5)/(m^2 - 5),\n     {m, {4, 6, 7, 8, 9, 10, 11, 12, 13, 1/2, 3/2, 5/2, 7/2, -1/2, -3/2, -5/2, 1/3, 2/3}}],\n    ! IntegerQ[#] &];\ndataMoreU = Table[(buildAtU[t];\n    With[{bs = BexplU /@ untwU},\n     {t, Table[Rationalize[Chop[bs[[m]]/bs[[1]], 10^-50], 10^-40], {m, 6}], untwU[[All, \"vec\"]]}]),\n   {t, tMoreU}];\n\n(* Rational function P(x)/Q(x) of degrees (dn,dd) through the points, from the null space. *)\nratFitU[pts_, dn_, dd_] := Module[{p, q, vars, ns},\n   vars = Join[Array[p, dn + 1, 0], Array[q, dd + 1, 0]];\n   ns = NullSpace[Table[Coefficient[Sum[p[k] pt[[1]]^k, {k, 0, dn}] -\n        pt[[2]] Sum[q[k] pt[[1]]^k, {k, 0, dd}], v], {pt, pts}, {v, vars}]];\n   If[Length[ns] == 1, (Sum[p[k] x^k, {k, 0, dn}]/Sum[q[k] x^k, {k, 0, dd}]) /.\n     Thread[vars -> First[ns]], $Failed]];\n(* Even in t (checked: every value at t and -t agrees); fit in x = t^2, verify on all points. *)\nfitEvenU[m_] := Module[{pts = Union[Table[{d[[1]]^2, d[[2, m]]}, {d, dataMoreU}]], res = $Failed},\n   Do[With[{f = ratFitU[pts[[1 ;; 2 dg + 3]], dg, dg]},\n     If[f =!= $Failed && AllTrue[pts, (f /. x -> #[[1]]) == #[[2]] &],\n      res = Factor[f /. x -> t^2]; Break[]]], {dg, 0, 5}]; res];\n\n(* Octets: B = (P + sigma Q s)/R, s = sqrt(4+5t^2) > 0, sigma = -1 for 8_1 (lower [u^0]T2), +1 for 8_2. *)\noctDataU = Flatten[Table[Table[{d[[1]], Sqrt[4 + 5 d[[1]]^2], {-1, 1}[[m - 3]], d[[2, m]]}, {m, {4, 5}}],\n    {d, dataMoreU}], 1];\noctFitU[dg_] := Module[{P, Q, R, vars, ns},\n   vars = Join[Array[P, dg + 1, 0], Array[Q, dg + 1, 0], Array[R, dg + 1, 0]];\n   ns = NullSpace[Table[Coefficient[Sum[P[k] y[[1]]^(2 k), {k, 0, dg}] +\n        y[[3]] y[[2]] Sum[Q[k] y[[1]]^(2 k), {k, 0, dg}] - y[[4]] Sum[R[k] y[[1]]^(2 k), {k, 0, dg}], v],\n      {y, octDataU}, {v, vars}]];\n   If[Length[ns] == 1, With[{sol = Thread[vars -> First[ns]]},\n     Factor /@ ({Sum[P[k] t^(2 k), {k, 0, dg}], Sum[Q[k] t^(2 k), {k, 0, dg}], Sum[R[k] t^(2 k), {k, 0, dg}]} /. sol)],\n    $Failed]];\noctFitResU = SelectFirst[Table[octFitU[dg], {dg, 0, 7}], # =!= $Failed &];\n\n(* Required N_R N_L = ||r_0||_S^2/(c^2 B/B_vac), with r_0 fixed by one component c. *)\nnormTabU = Table[With[{f = fitEvenU[m], r0 = dataMoreU[[1, 3, m]], comp = {{1, 1}, {1, 3}, {1, 2}, {}, {}, {1, 8}}[[m]]},\n    {untwU[[m, \"mu\"]], f, comp, r0.(S2U r0)/r0[[(comp[[1]] - 1) 8 + comp[[2]]]]^2,\n     Factor[(r0.(S2U r0)/r0[[(comp[[1]] - 1) 8 + comp[[2]]]]^2)/f]}], {m, {1, 2, 3, 6}}];\n\nColumn[{\n  Grid[Prepend[normTabU, {\"hw weight\", \"B_A/B_vac(t), t = theta1-theta2 (h=1)\",\n     \"component c = site1 hw (x) extremal site2\", \"||r_0||_S^2/c^2\",\n     \"required N_R N_L\"}], Frame -> All, Alignment -> Left],\n  Grid[{{\"octets: B/B_vac = (P + sigma Q s)/R, {P, Q, R}\", octFitResU},\n    {\"number of t points (both octets fitted on all of them)\", Length[tMoreU]}},\n   Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
