  {
   "kind": 2,
   "value": "(* ---- 9. The precise relation: det N_reg = V_lambda(z) E_lambda det(A2_H)_untw (1 + O(eps)). ---- *)\nClearAll[splitResU, untwHU, EformulaU, EnumU, relationTab];\n\n(* Laplace split: only the (alpha=1 rows x O columns) block times the\n   (alpha=2 rows x H columns) block survives at leading order. *)\nsplitResU[eps_, m_] := With[{mat = matRegU[eps, phiU, m]},\n   Abs[-Det[mat[[1 ;; 3, 4 ;; 6]]] Det[mat[[4 ;; 6, 1 ;; 3]]]/Det[mat] - 1]];\n\n(* The untwisted minor: periodic rows of the triple {(1,3),(1,2),(2,3)}, H columns. *)\nuntwHU[m_] := Det[(matUntwU[m].colChangeU)[[4 ;; 6, 1 ;; 3]]];\n\n(* alpha=1 block, from the residue at infinity: depends only on the total highest weight. *)\nEformulaU[lam_] := -(lam[[1]] - lam[[2]] + 1) (lam[[2]] - lam[[3]] + 1)/\n   ((lam[[1]] - lam[[3]] + 1)! (lam[[1]] - lam[[2]])! (lam[[2]] - lam[[3]])!);\n(* Numerical value from the eps -> 0 limits (det of colChangeU is -1). *)\nEnumU[m_] := -D0U[m] Det[colChangeU]/untwHU[m];\n\nrelationTab = Table[{untwU[[m, \"mu\"]],\n    Round[Log10[splitResU[10^-7, m]], 1/10], Round[Log10[splitResU[10^-8, m]], 1/10],\n    Round[Log10[Abs[Det[matRegU[10^-8, phiU, m][[4 ;; 6, 1 ;; 3]]]/untwHU[m] - 1]], 1/10],\n    EformulaU[lamU[[m]]], N[Abs[EnumU[m]/EformulaU[lamU[[m]]] - 1], 3],\n    Rationalize[Re[untwHU[m]/untwHU[1]], 10^-20],\n    N[Abs[(EformulaU[lamU[[m]]] untwHU[m]/(untwFactorsU[[m, 1]] untwFactorsU[[m, 2]]))/\n        (EformulaU[lamU[[1]]] untwHU[1]/(untwFactorsU[[1, 1]] untwFactorsU[[1, 2]]))/\n        psi0NormU[[m]] - 1], 3]}, {m, 6}];\n\nGrid[Prepend[relationTab, {\"hw weight\", \"log10 split residual, eps=1e-7\",\n    \"log10 split residual, eps=1e-8\", \"log10 |det A2_H(1e-8)/untwisted - 1|\",\n    \"E_lambda (formula)\", \"|E numeric/formula - 1|\", \"det A2_H untw / vac\",\n    \"<psi_0|psi_0> from formula vs numeric (rel.)\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
