  {
   "kind": 2,
   "value": "(* ---- 2. Untwisted highest-weight states and their Q-functions (exact). ---- *)\nClearAll[BaxDirU, BaxDualU, polyKernelU, qpolyU, wtU, hwMusU, hwBasisU, untwU,\n  psiRefLocU, cRefLocU];\n\n(* Twisted reduced Baxter operators for Q = z^u q (direct) and Q = z^-u q (dual);\n   unimodular twist, so the last term is qdet. z = 1 gives the untwisted ones. *)\nBaxDirU[T1_, T2_, z_][q_][x_] :=\n  z nu1U[x] nu1U[x - 1] nu1U[x - 2] q[x + 1]\n  - (T1 /. u -> x) nu1U[x - 1] nu1U[x - 2] q[x]\n  + (T2 /. u -> x) nu1U[x - 2] q[x - 1]/z\n  - qdetU[x] q[x - 2]/z^2;\nBaxDualU[T1_, T2_, y_][g_][x_] :=\n  nu3U[x + 1] nu3U[x + 2] nu3U[x + 3] g[x]\n  - y (T1 /. u -> x + 1) nu3U[x + 2] nu3U[x + 3] g[x + 1]\n  + y^2 (T2 /. u -> x + 2) nu3U[x + 3] g[x + 2]\n  - y^3 qdetU[x + 3] g[x + 3];\n(* Horner form: cl.y^Range[...] evaluates 0^0 when a pole sits at u = 0. *)\nqpolyU[cl_List, y_] := Fold[#1 y + #2 &, 0, Reverse[cl]];\n\n(* Exact polynomial kernel up to degree 12, row-reduced from the top\n   (staggering gauge), sorted by degree. *)\npolyKernelU[op_] := Module[{c, x, pf, eqs, ns, rr},\n   pf = Function[y, Evaluate[Sum[c[m] y^m, {m, 0, 12}]]];\n   eqs = CoefficientList[Expand[op[pf][x]], x];\n   ns = NullSpace[Table[D[e, c[m]], {e, eqs}, {m, 0, 12}]];\n   rr = DeleteCases[RowReduce[Reverse /@ ns], {0 ..}];\n   SortBy[Table[Reverse[r] /. {a___, 0 ..} :> {a}, {r, rr}], Length]];\n\nwtU = Transpose[Table[Diagonal[EtotU[i, i]], {i, 3}]];\nhwMusU = {{4, 2, 0}, {3, 3, 0}, {4, 1, 1}, {3, 2, 1}, {2, 2, 2}};\nhwBasisU[w_] := Module[{idx = Flatten@Position[wtU, w]},\n   Transpose@Table[ReplacePart[ConstantArray[0, dcU], Thread[idx -> nv]],\n     {nv, NullSpace[Join[EtotU[1, 2], EtotU[2, 3]][[All, idx]]]}]];\n\n(* Records: q = direct q_1,q_2,q_3 (deg (4-mu_i)+(i-1)); qd = q^1,q^2,q^3\n   (deg mu_j+3-j, q^3 lowest). Octets ordered by [u^0]T2. *)\nuntwU = Module[{recs},\n   recs = Flatten[Table[Module[{Bt = hwBasisU[w], r, Rk, evs, ev, p},\n       r = First@Select[Subsets[Range[dcU], {Length[Bt[[1]]]}],\n          Det[Bt[[#]]] =!= 0 &, 1];\n       Rk[a_, k_] := Inverse[Bt[[r]]].(TcoU[a, k, {1, 1, 1}].Bt)[[r]];\n       evs = Eigenvectors[Rk[2, 0]];\n       Table[ev = evs[[c]]; p = First@Flatten@Position[Unitize[ev], 1];\n        <|\"mu\" -> w, \"vec\" -> Bt.ev,\n          \"T1\" -> Sum[(Rk[1, k].ev)[[p]]/ev[[p]] u^k, {k, 0, 2}],\n          \"T2\" -> Sum[(Rk[2, k].ev)[[p]]/ev[[p]] u^k, {k, 0, 4}]|>,\n        {c, Length[evs]}]], {w, hwMusU}], 1];\n   recs = SortBy[recs, {First@Flatten@Position[hwMusU, #[\"mu\"]] &,\n      Coefficient[#[\"T2\"], u, 0] &}];\n   Table[Append[s, <|\n      \"q\" -> polyKernelU[BaxDirU[s[\"T1\"], s[\"T2\"], 1]],\n      \"qd\" -> Reverse[polyKernelU[BaxDualU[s[\"T1\"], s[\"T2\"], 1]]]|>],\n    {s, recs}]];\n\n(* Normalization factors for the row triple {(a,c),(a,d),(b,c)}, as functions of\n   callable Q's: Qd[i][x] direct, Qu[j][x] dual. *)\npsiRefLocU[Qd_, th_, a_, b_] :=\n  Qd[a][th + 1] (Qd[a][th] Qd[b][th - 1] - Qd[b][th] Qd[a][th - 1]);\ncRefLocU[Qu_, th_, c_, d_] :=\n  (Qu[c][th + 1] (Qu[c][th] Qu[d][th + 1] - Qu[d][th] Qu[c][th + 1])\n    - Qu[c][th] (Qu[c][th] Qu[d][th + 2] - Qu[d][th] Qu[c][th + 2]))/4;\n\nWith[{qd = Function[{s}, Function[{i}, Function[{x}, Evaluate[qpolyU[s[\"q\"][[i]], x]]]]],\n   qu = Function[{s}, Function[{j}, Function[{x}, Evaluate[qpolyU[s[\"qd\"][[j]], x]]]]]},\n Grid[Prepend[Table[{s[\"mu\"], Length /@ s[\"q\"] - 1, Length /@ s[\"qd\"] - 1,\n     And @@ Flatten[{\n        Expand[BaxDirU[s[\"T1\"], s[\"T2\"], 1][Function[y, Evaluate@qpolyU[#, y]]][u]] === 0 & /@ s[\"q\"],\n        Expand[BaxDualU[s[\"T1\"], s[\"T2\"], 1][Function[y, Evaluate@qpolyU[#, y]]][u]] === 0 & /@ s[\"qd\"]}],\n     Product[psiRefLocU[qd[s], th, 1, 2], {th, thetaU}],\n     Product[cRefLocU[qu[s], th, 3, 2], {th, thetaU}]}, {s, untwU}],\n   {\"mu\", \"deg q_i\", \"deg q^j\", \"Baxter exact\",\n    \"Psi^ref untwisted, (a,b)=(1,2)\", \"c^ref untwisted, (c,d)=(3,2)\"}],\n  Frame -> All, Alignment -> Left]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"26\" data-out-n=\"194\" data-sub-idx=\"16\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"2\" data-sub-start=\"61\" data-sub-end=\"71\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[194]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"26\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:8.4706em;vertical-align:-3.9653em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.5053em;\"><span style=\"top:-6.4653em;\"><span class=\"pstrut\" style=\"height:6.4653em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:8.4306em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.9653em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4653em;\"><span style=\"top:-6.6253em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">mu</span></span></span></span><span style=\"top:-5.4202em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">4</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span cla