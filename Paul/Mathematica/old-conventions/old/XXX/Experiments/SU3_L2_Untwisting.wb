       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"29\" data-out-n=\"222\" data-sub-idx=\"15\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"16\" data-sub-start=\"43\" data-sub-end=\"49\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[222]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"26\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.9044em;vertical-align:-4.7022em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.2022em;\"><span style=\"top:-7.2022em;\"><span class=\"pstrut\" style=\"height:5.7022em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.7022em;\"><span style=\"top:-5.6622em;\"><span class=\"pstrut\" style=\"height:5.6622em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6.8244em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.1622em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.6622em;\"><span style=\"top:-5.9311em;\"><span class=\"pstrut\" style=\"height:3.1089em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">hw weight</span></span></span></span><span style=\"top:-4.7311em;\"><span class=\"pstrut\" style=\"height:3.1089em;\"></span><span class=\"mord\"><span class=\"minner\"><span class