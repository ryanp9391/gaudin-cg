       "data": "Out[118]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{phi} & \\text{hw weight} & \\text{extrapolation error (rel.)} & \\text{X = lim eps\\^{}2k S\\_vec} & \\text{Cv D/(K P)/X - 1} & \\text{P/((phi1-phi2)\\^{}2 Psi\\^{}ref\\_untw)} & \\text{K/((phi2-phi3)\\^{}2 c\\^{}ref\\_untw)} & \\text{Cv = lim eps\\^{}8 C\\_vac}\\\\\\hline\\left\\{1,\\frac{1}{3},-\\frac{4}{3}\\right\\} & \\left\\{4,2,0\\right\\} & 0.\\times 10^{-189} & 1.\\, & 8.1\\times 10^{-20}+0.\\times 10^{-134}\\,\\mathrm{i} & 0.111111111111 & 0.111111111111 & -0.00183440827441+0.000464535264411\\,\\mathrm{i}\\\\\\hline\\left\\{1,\\frac{1}{3},-\\frac{4}{3}\\right\\} & \\left\\{3,3,0\\right\\} & 4.0\\times 10^{-16} & 16.5765306122 & 6.6\\times 10^{-20}+0.\\times 10^{-127}\\,\\mathrm{i} & 1.00000000000 & 0.0625000000000 & -0.00183440827441+0.000464535264411\\,\\mathrm{i}\\\\\\hline\\left\\{1,\\frac{1}{3},-\\frac{4}{3}\\right\\} & \\left\\{4,1,1\\right\\} & 3.0\\times 10^{-15} & 1.06089795918 & 1.1\\times 10^{-19}+0.\\times 10^{-122}\\,\\mathrm{i} & 0.0625000000000 & 1.00000000000 & -0.00183440827441+0.000464535264411\\,\\mathrm{i}\\\\\\hline\\left\\{1,\\frac{1}{3},-\\frac{4}{3}\\right\\} & \\left\\{3,2,1\\right\\} & 5.3\\times 10^{-15} & 17.6594286660 & 9.2\\times 10^{-20}+0.\\times 10^{-128}\\,\\mathrm{i} & 0.250000000000 & 0.25… [latex truncated: 4717 chars total]",
