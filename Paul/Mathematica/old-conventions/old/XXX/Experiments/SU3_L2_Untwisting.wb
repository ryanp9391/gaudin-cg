       "data": "Out[91]= \\begin{matrix}\\begin{array}{|c|c|c|c|}\\hline\\text{weight} & \\text{multiplet} & \\text{\\# states} & \\text{eps-power of \\{<0|R>, <L|0>, S\\_vec\\}}\\\\\\hline\\left\\{0,2,4\\right\\} & 27 & 1 & \\left\\{0,0,0\\right\\}\\\\\\hline\\left\\{0,3,3\\right\\} & 27 & 1 & \\left\\{0,0,0\\right\\}\\\\\\hline\\left\\{0,3,3\\right\\} & 10 & 1 & \\left\\{1,1,-2\\right\\}\\\\\\hline\\left\\{0,4,2\\right\\} & 27 & 1 & \\left\\{0,0,0\\right\\}\\\\\\hline\\left\\{1,1,4\\right\\} & 27 & 1 & \\left\\{0,0,0\\right\\}\\\\\\hline\\left\\{1,1,4\\right\\} & \\text{10b} & 1 & \\left\\{1,1,-2\\right\\}\\\\\\hline\\left\\{1,2,3\\right\\} & 27 & 2 & \\text{multiple}\\\\\\hline\\left\\{1,2,3\\right\\} & 10 & 1 & \\left\\{1,1,-2\\right\\}\\\\\\hline\\left\\{1,2,3\\right\\} & \\text{10b} & 1 & \\left\\{1,1,-2\\right\\}\\\\\\hline\\left\\{1,2,3\\right\\} & 8 & 1 & \\left\\{2,2,-4\\right\\}\\\\\\hline\\left\\{1,2,3\\right\\} & 8 & 1 & \\left\\{2,2,-4\\right\\}\\\\\\hline\\left\\{1,3,2\\right\\} & 27 & 2 & \\text{multiple}\\\\\\hline\\left\\{1,3,2\\right\\} & 10 & 1 & \\left\\{1,1,-2\\right\\}\\\\\\hline\\left\\{1,3,2\\right\\} & \\text{10b} & 1 & \\left\\{1,1,-2\\right\\}\\\\\\hline\\left\\{1,3,2\\right\\} & 8 & 1 & \\left\\{2,2,-4\\right\\}\\\\\\hline\\left\\{1,3,2\\right\\} & 8 & 1 & \\left\\{2,2,-4\\right\\}\\\\\\hline\\left\\{1,4,1\\right\\} & 27 & 1 & \\left\\{0,0,0\\right\\}\\\\\\hline\\left\\{1,4… [latex truncated: 3916 chars total]",
