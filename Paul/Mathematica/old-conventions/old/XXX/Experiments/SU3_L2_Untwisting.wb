  {
   "kind": 2,
   "value": "(* ---- 7. Twist structure of each factor; the untwisted limit. ---- *)\nClearAll[lamU, nU, ndU, DhatU, vandPhiU, D0U, kappaU, psi0NormU, rowUntwU, matUntwU,\n  structTab, resultTab, rankTab];\n\nlamU = untwU[[All, \"mu\"]];\n(* M_2+1-M_1 and its dual analogue: the leading coefficients of the untwisted\n   Casoratians, which fix Psi^ref and c^ref relative to the monic twisted ones. *)\nnU = {3, 1, 4, 2, 2, 1};\nndU = {3, 4, 1, 2, 2, 1};\nvandPhiU[phi_, lam_] := Product[(phi[[i]] - phi[[j]])^(lam[[i]] - lam[[j]]), {i, 3}, {j, i + 1, 3}];\n\n(* Regularized determinant: det N_raw with the two Vandermonde factors of Q_2, Q^2 stripped. *)\nDhatU[phi_, m_] := limDataU[phi][[m, \"D\"]][[1]] nU[[m]]^2 ndU[[m]]^2/\n   ((phi[[1]] - phi[[2]])^2 (phi[[2]] - phi[[3]])^2);\nD0U[m_] := Mean[Table[DhatU[phi, m]/vandPhiU[phi, lamU[[m]]], {phi, phiSetU}]];\nkappaU = Mean[Table[limDataU[phi][[1, \"Cv\"]][[1]] vandPhiU[phi, lamU[[1]]], {phi, phiSetU}]];\n\n(* <psi_0|psi_0>_A / <psi_0|psi_0>_vac = lim V S_vec(A,A) *)\npsi0NormU = Table[(D0U[m]/D0U[1]) (untwFactorsU[[1, 1]] untwFactorsU[[1, 2]])/\n     (untwFactorsU[[m, 1]] untwFactorsU[[m, 2]]), {m, 6}];\n\nstructTab = Table[{untwU[[m, \"mu\"]],\n    N[Max[Table[Abs[DhatU[phi, m]/vandPhiU[phi, lamU[[m]]]/D0U[m] - 1], {phi, phiSetU}]], 3],\n    N[Max[Table[Abs[limDataU[phi][[m, \"X\"]][[1]] vandPhiU[phi, lamU[[1]] - lamU[[m]]]/\n          (kappaU D0U[m]/(untwFactorsU[[m, 1]] untwFactorsU[[m, 2]])) - 1], {phi, phiSetU}]], 3],\n    Rationalize[Re[D0U[m]/D0U[1]], 10^-16], Rationalize[Re[psi0NormU[[m]]], 10^-16]}, {m, 6}];\n\n(* The untwisted 6x6 matrix with the untwisted (staggered) q_1, q_2, q^3, q^2. *)\nrowUntwU[s_, {alpha_, {i_, j_}}] := Sum[With[{x = polesU[[r]]},\n    weightsU[[r]] Exp[2 Pi I (alpha - 1) SetPrecision[x, precU]] *\n     Flatten@Table[x^beta {-qpolyU[s[\"qd\"][[j]], x] qpolyU[s[\"q\"][[i]], x],\n        qpolyU[s[\"qd\"][[j]], x] qpolyU[s[\"q\"][[i]], x - 1],\n        qpolyU[s[\"qd\"][[j]], x + 1] qpolyU[s[\"q\"][[i]], x]}, {beta, 0, 1}]], {r, 6}];\nmatUntwU[m_] := rowUntwU[untwU[[m]], #] & /@\n   Flatten[Table[{alpha, ij}, {alpha, 2}, {ij, tripleU}], 1];\nrankTab = Table[With[{sv = SingularValueList[N[matUntwU[m], 60], Tolerance -> 0]},\n    {untwU[[m, \"mu\"]], Count[sv/Max[sv], _?(# > 10^-40 &)],\n     Total[lamU[[m]][[{1, 1, 2}]] - lamU[[m]][[{2, 3, 3}]]]}], {m, 6}];\n\nColumn[{\n  Grid[Prepend[structTab, {\"hw weight\", \"D-hat/V_lambda(phi) phi-independent (rel. spread)\",\n     \"lim V_{lvac-lA} S_vec = kappa D0/(c Psi)_untw (rel. residual)\",\n     \"D0_A/D0_vac\", \"<psi_0|psi_0>_A/<psi_0|psi_0>_vac\"}], Frame -> All, Alignment -> Left],\n  Grid[{{\"kappa = lim eps^8 V_lvac(phi) C_vac\", N[kappaU, 15]},\n    {\"kappa = (c Psi)_untw,vac / D0_vac\",\n     N[Abs[kappaU D0U[1]/(untwFactorsU[[1, 1]] untwFactorsU[[1, 2]]) - 1], 3]},\n    {\"singlet: D0 = det of the untwisted 6x6 (rel. residual)\",\n     N[Abs[Det[matUntwU[6]]/D0U[6] - 1], 3]}}, Frame -> All, Alignment -> Left],\n  Grid[Prepend[rankTab, {\"hw weight\", \"rank of untwisted 6x6\",\n     \"vanishing order of det N_reg = sum_{i<j}(lambda_i-lambda_j)\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
