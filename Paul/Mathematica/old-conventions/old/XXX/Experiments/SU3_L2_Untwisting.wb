  {
   "kind": 2,
   "value": "(* ---- 5. Q side for the triple {(1,3),(1,2),(2,3)}: exact identity at small eps, and eps-powers of each factor. ---- *)\nClearAll[qRU, qLU, polesU, weightsU, rowU, tripleU, detNU, psiRefU, cRefU, qSideU, qTabU,\n  hwRecU, powU];\n\nqRU[s_, z_, i_, x_] := z[[i]]^x qpolyU[s[\"q\"][[i]], x];\nqLU[s_, z_, j_, x_] := z[[j]]^(-x) qpolyU[s[\"qd\"][[j]], x];\n\npolesU = Flatten@Table[th + n, {th, thetaU}, {n, 0, 2}];\nweightsU = Table[1/Times @@ (polesU[[r]] - Delete[polesU, r]), {r, 6}];\n\n(* Row (alpha,i,j) over all six poles of 1/(nu1 nu2 nu3), columns u^beta x\n   (-Q^j Q_i, Q^j Q_i^[-2], Q^j[2] Q_i). *)\nrowU[A_, B_, z_, {alpha_, {i_, j_}}] := Sum[\n   With[{x = polesU[[r]]},\n    weightsU[[r]] Exp[2 Pi I (alpha - 1) SetPrecision[x, precU]] *\n     Flatten@Table[x^beta {-qLU[A, z, j, x] qRU[B, z, i, x],\n        qLU[A, z, j, x] qRU[B, z, i, x - 1],\n        qLU[A, z, j, x + 1] qRU[B, z, i, x]}, {beta, 0, 1}]],\n   {r, 6}];\n\n(* Direct content {a,a,b} = {1,1,2}; dual content {c,c,d} = {3,3,2}. *)\ntripleU = {{1, 3}, {1, 2}, {2, 3}};\ndetNU[A_, B_, z_] := Det[rowU[A, B, z, #] & /@\n    Flatten[Table[{alpha, ij}, {alpha, 2}, {ij, tripleU}], 1]];\npsiRefU[B_, z_] := Product[psiRefLocU[Function[i, Function[x, qRU[B, z, i, x]]], th, 1, 2],\n   {th, thetaU}];\ncRefU[A_, z_] := Product[cRefLocU[Function[j, Function[x, qLU[A, z, j, x]]], th, 3, 2],\n   {th, thetaU}];\n\nhwRecU[eps_, m_Integer] := hwRecU[eps, phiU, m];\nhwRecU[eps_, phi_List, m_Integer] :=\n  SelectFirst[twU[eps, phi][\"recs\"], #[\"hwLimit\"] && #[\"mult\"] == m &];\n\n(* For each eps and hw-limit state: detN, c^ref, Psi^ref, S_vec, and C_vac from the vacuum\n   (S_vec(vac,vac) = 1 up to rounding, kept explicit). *)\nqSideU[eps_] := qSideU[eps, phiU];\nqSideU[eps_, phi_List] := qSideU[eps, phi] = Module[\n   {z = twU[eps, phi][\"z\"], vac = hwRecU[eps, phi, 1], cvac},\n   cvac = cRefU[vac, z] psiRefU[vac, z]/(detNU[vac, vac, z]\n       (1/(vac[\"braR\"] vac[\"Lket\"])));\n   <|\"Cvac\" -> cvac,\n    \"states\" -> Table[With[{s = hwRecU[eps, phi, m]},\n       <|\"detN\" -> detNU[s, s, z], \"cRef\" -> cRefU[s, z], \"psiRef\" -> psiRefU[s, z],\n        \"Svec\" -> 1/(s[\"braR\"] s[\"Lket\"])|>], {m, 6}]|>];\n\npowU[f_] := Log10[Abs[f[epsListU[[-2]]]/f[epsListU[[-1]]]]]/\n   Log10[epsListU[[-2]]/epsListU[[-1]]];\n\nqTabU = Table[Module[{st = Function[e, qSideU[e][\"states\"][[m]]]},\n    {untwU[[m, \"mu\"]], {27, 10, \"10b\", 8, 8, 1}[[m]],\n     N[Max[Table[Abs[qSideU[e][\"Cvac\"] st[e][\"detN\"]/(st[e][\"cRef\"] st[e][\"psiRef\"])/\n          st[e][\"Svec\"] - 1], {e, epsListU}]], 3],\n     Round[powU[st[#][\"detN\"] &], 1/100], Round[powU[st[#][\"cRef\"] &], 1/100],\n     Round[powU[st[#][\"psiRef\"] &], 1/100], Round[powU[st[#][\"Svec\"] &], 1/100]}],\n   {m, 6}];\n\nColumn[{\n  Grid[{{\"eps-power of C_vac\", Round[powU[qSideU[#][\"Cvac\"] &], 1/100]}},\n   Frame -> All, Alignment -> Left],\n  Grid[Prepend[qTabU, {\"hw weight\", \"multiplet\", \"max |S_Q/S_vec - 1| over eps\",\n     \"power det N\", \"power c^ref\", \"power Psi^ref\", \"power S_vec\"}],\n   Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"19\" data-out-n=\"108\" data-sub-idx=\"20\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"5\" data-sub-start=\"56\" data-sub-end=\"61\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[108]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"26\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.69em;vertical-align:-4.595em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.095em;\"><span style=\"top:-10.695em;\"><span class=\"pstrut\" style=\"height:6.49em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.89em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:1.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">eps-power of C_vac</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span cla