  {
   "kind": 2,
   "value": "(* ---- 10. Independent check at a second chain point, theta = (1/5, 46/55), phi = (3/2, 1/2, -2).\n   This cell REBUILDS the chain: after it, earlier cells refer to the new theta. ---- *)\nClearAll[phiP2, epsP2, checkP2];\n\nthetaU = {1/5, 46/55};\nDo[With[{m = qminorU[II]},\n   Do[qcoU[II, k] = Coefficient[m, u, k], {k, 0, 2 Length[II]}]],\n  {II, Join @@ (Subsets[Range[3], {#}] & /@ Range[3])}];\npolesU = Flatten@Table[th + n, {th, thetaU}, {n, 0, 2}];\nweightsU = Table[1/Times @@ (polesU[[r]] - Delete[polesU, r]), {r, 6}];\nuntwU = Module[{recs},\n   recs = Flatten[Table[Module[{Bt = hwBasisU[w], r, Rk, evs, ev, p},\n       r = First@Select[Subsets[Range[dcU], {Length[Bt[[1]]]}],\n          Det[Bt[[#]]] =!= 0 &, 1];\n       Rk[a_, k_] := Inverse[Bt[[r]]].(TcoU[a, k, {1, 1, 1}].Bt)[[r]];\n       evs = Eigenvectors[Rk[2, 0]];\n       Table[ev = evs[[c]]; p = First@Flatten@Position[Unitize[ev], 1];\n        <|\"mu\" -> w, \"vec\" -> Bt.ev,\n          \"T1\" -> Sum[(Rk[1, k].ev)[[p]]/ev[[p]] u^k, {k, 0, 2}],\n          \"T2\" -> Sum[(Rk[2, k].ev)[[p]]/ev[[p]] u^k, {k, 0, 4}]|>,\n        {c, Length[evs]}]], {w, hwMusU}], 1];\n   recs = SortBy[recs, {First@Flatten@Position[hwMusU, #[\"mu\"]] &,\n      Coefficient[#[\"T2\"], u, 0] &}];\n   Table[Append[s, <|\n      \"q\" -> polyKernelU[BaxDirU[s[\"T1\"], s[\"T2\"], 1]],\n      \"qd\" -> Reverse[polyKernelU[BaxDualU[s[\"T1\"], s[\"T2\"], 1]]]|>],\n    {s, recs}]];\n\n(* New phi, so no memoized twisted data from the first chain point is reused. *)\nphiP2 = {3/2, 1/2, -2};\nepsP2 = {10^-7, 10^-8};\n\ncheckP2 = Table[Module[{Ee, mat8 = matRegU[10^-8, phiP2, m], E0},\n    Ee = Table[Det[matRegU[e, phiP2, m][[1 ;; 3, 4 ;; 6]]]/\n       (e^dOrdU[[m]] vandPhiU[phiP2, untwU[[m, \"mu\"]]]), {e, epsP2}];\n    E0 = (10 Ee[[2]] - Ee[[1]])/9;\n    {untwU[[m, \"mu\"]],\n     Round[Log10[Abs[-Det[mat8[[1 ;; 3, 4 ;; 6]]] Det[mat8[[4 ;; 6, 1 ;; 3]]]/Det[mat8] - 1]], 1/10],\n     Round[Log10[Abs[Det[mat8[[4 ;; 6, 1 ;; 3]]]/untwHU[m] - 1]], 1/10],\n     EformulaU[untwU[[m, \"mu\"]]], N[Abs[E0/EformulaU[untwU[[m, \"mu\"]]] - 1], 3],\n     N[Max[Abs[Table[qSideU[e, phiP2][\"Cvac\"] qSideU[e, phiP2][\"states\"][[m, \"detN\"]]/\n          (qSideU[e, phiP2][\"states\"][[m, \"cRef\"]] qSideU[e, phiP2][\"states\"][[m, \"psiRef\"]])/\n          qSideU[e, phiP2][\"states\"][[m, \"Svec\"]] - 1, {e, epsP2}]]], 3]}], {m, 6}];\n\nGrid[Prepend[checkP2, {\"hw weight\", \"log10 split residual (eps=1e-8)\",\n    \"log10 |det A2_H - untwisted|\", \"E_lambda formula\",\n    \"|E extrapolated/formula - 1|\", \"exact identity S_Q/S_vec - 1\"}],\n  Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
