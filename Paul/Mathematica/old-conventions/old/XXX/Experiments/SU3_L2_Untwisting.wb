   "kind": 2,
   "value": "(* ---- 4. Step 1: how <0|R> and <L|0> vanish as eps -> 0, and where the eigenvectors go. ---- *)\nClearAll[epsListU, slopeU, divTab, hwIdx, limitCheck];\n\nepsListU = {10^-3, 10^-4, 10^-5, 10^-6};\nScan[twU, epsListU];\n\n(* Local power of eps between the last two eps values. States are matched\n   across eps by (weight, multiplet, T2 ordering inside the sector). *)\nkeyOf[s_] := {s[\"mu\"], s[\"mult\"]};\nslopeU[f_, key_] := Module[{vals},\n   vals = Table[Abs[f[SelectFirst[twU[e][\"recs\"], keyOf[#] == key &]]], {e, epsListU[[-2 ;;]]}];\n   Log10[vals[[1]]/vals[[2]]]/Log10[epsListU[[-2]]/epsListU[[-1]]]];\n\n(* Keys that are unique (weight, multiplet); the octet pair is split by multiplet already. *)\ndivTab = Table[Module[{recs = Select[twU[10^-6][\"recs\"], keyOf[#] == key &]},\n    {key[[1]], {27, 10, \"10b\", 8, 8, 1}[[key[[2]]]], Length[recs],\n     If[Length[recs] == 1,\n      Round[{slopeU[#[\"braR\"] &, key], slopeU[#[\"Lket\"] &, key],\n        slopeU[1/(#[\"braR\"] #[\"Lket\"]) &, key]}, 1/100], \"multiple\"]}],\n   {key, Union[keyOf /@ twU[10^-6][\"recs\"]]}];\n\n(* hw-limit states: does the pivot-normalized twisted eigenvector converge to the\n   untwisted hw vector? *)\nlimitCheck = Table[Module[{s = SelectFirst[twU[10^-6][\"recs\"], #[\"hwLimit\"] && #[\"mult\"] == m &],\n     v0 = untwU[[m, \"vec\"]], p},\n    p = First@Ordering[-Abs[N[v0]], 1];\n    {untwU[[m, \"mu\"]], m,\n     N[Max[Abs[s[\"vec\"]/s[\"vec\"][[p]] - v0/v0[[p]]]], 3]}], {m, 6}];\n\nColumn[{\n  Grid[Prepend[divTab, {\"weight\", \"multiplet\", \"# states\",\n     \"eps-power of {<0|R>, <L|0>, S_vec}\"}], Frame -> All, Alignment -> Left],\n  Grid[Prepend[limitCheck, {\"hw weight\", \"multiplet\",\n     \"max|R(1e-6) - r_0| (pivot-normalized)\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
