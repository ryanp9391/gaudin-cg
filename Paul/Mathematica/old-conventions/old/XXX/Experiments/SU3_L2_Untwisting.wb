  {
   "kind": 2,
   "value": "(* ---- 3. Twisted chain at z_j = Exp[eps phi_j]: all 64 states, Q-functions, physical references. ---- *)\nClearAll[precU, phiU, rhoU, zOf, solveMonicU, refBra1U, refKet1U, twU, multipletOf];\n\n(* 200 digits: at eps = 1e-8 the raw Q's diverge like eps^-6 and the near-degenerate\n   eigenvectors lose ~8 digits. *)\nprecU = 200;\nphiU = {1, 1/3, -4/3};\nrhoU[a_, k_] := Prime[7 a + k + 1]/(11 + 2 a + k);\nzOf[eps_, phi_] := N[Exp[eps phi], precU];\n\nsolveMonicU[op_, degree_] := Module[{c, x, q, eqs, aa, bb, sol, res, scale},\n  q = Function[y, Evaluate[y^degree + Sum[c[m] y^m, {m, 0, degree - 1}]]];\n  eqs = CoefficientList[Expand[op[q][x]], x];\n  aa = Table[Coefficient[e, c[m]], {e, eqs}, {m, 0, degree - 1}];\n  bb = eqs /. c[_] -> 0;\n  sol = If[degree == 0, {}, LeastSquares[aa, -bb]];\n  res = If[degree == 0, bb, aa.sol + bb];\n  scale = Max[Join[{1}, Abs@Flatten[{aa, bb}]]];\n  {Append[sol, 1], Max[Abs[res]]/scale}];\n\n(* One-site reference covector/vector on branch I, a13 = 3/5, a23 = 4/7. *)\nrefBra1U[z_] := With[{a13 = 3/5, a23 = 4/7,\n    a12 = -z[[2]] (z[[1]] - z[[3]])/(z[[1]] (z[[2]] - z[[3]])) (3/5)/(4/7)},\n   UnitVector[dsU, 1].MatrixExp[a12 EEU[1, 2]].MatrixExp[a13 EEU[1, 3]].\n    MatrixExp[a23 EEU[2, 3]]];\nrefKet1U[z_] := With[{a13 = 3/5, a23 = 4/7,\n    a12 = -z[[2]] (z[[1]] - z[[3]])/(z[[1]] (z[[2]] - z[[3]])) (3/5)/(4/7)},\n   MatrixExp[-z[[1]] (z[[1]] - z[[3]])/(a12 z[[2]] (z[[2]] - z[[3]])) EEU[2, 1]].\n    MatrixExp[-z[[1]]^2/(a13 z[[3]]^2) EEU[3, 1]].\n    MatrixExp[-z[[2]]^2 (z[[1]] - z[[3]])/(a23 (z[[1]] - z[[2]]) z[[3]]^2) EEU[3, 2]].\n    UnitVector[dsU, 1]];\n\n(* Multiplet of a twisted state: the untwisted record whose (T1,T2) is closest. *)\nmultipletOf[t1_, t2_] := First@Ordering[Table[\n     Total[Abs[CoefficientList[t1 - s[\"T1\"], u]]] +\n      Total[Abs[CoefficientList[t2 - s[\"T2\"], u]]], {s, untwU}], 1];\n\ntwU[eps_] := twU[eps, phiU];\ntwU[eps_, phi_List] := twU[eps, phi] = Module[{z = zOf[eps, phi], recs, R, L, bra, ket},\n   recs = Flatten[Table[\n      Module[{idx = Flatten@Position[wtU, wt], K, vals, vecs},\n       K = Sum[rhoU[a, k] TcoU[a, k, z][[idx, idx]], {a, 2}, {k, 0, 2 a}];\n       {vals, vecs} = Eigensystem[K];\n       Table[Module[{vv = vecs[[r]], p, t1, t2, full, m},\n         p = First@Ordering[-Abs[vv], 1];\n         vv = vv/vv[[p]];\n         t1 = Sum[(TcoU[1, k, z][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 2}];\n         t2 = Sum[(TcoU[2, k, z][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 4}];\n         full = ReplacePart[ConstantArray[SetPrecision[0, precU], dcU],\n           Thread[idx -> vv]];\n         m = multipletOf[t1, t2];\n         <|\"mu\" -> wt, \"vec\" -> full, \"T1\" -> Expand[t1], \"T2\" -> Expand[t2],\n          \"mult\" -> m, \"hwLimit\" -> (untwU[[m, \"mu\"]] == wt),\n          \"eigRes\" -> Max[Flatten@Table[Abs[TcoU[a, k, z].full -\n               Coefficient[{t1, t2}[[a]], u, k] full], {a, 2}, {k, 0, 2 a}]]|>],\n        {r, Length[vecs]}]],\n      {wt, Union[wtU]}], 1];\n   R = Transpose[recs[[All, \"vec\"]]];\n   L = Inverse[R];\n   bra = Flatten[KroneckerProduct[refBra1U[z], refBra1U[z]]];\n   ket = Flatten[KroneckerProduct[refKet1U[z], refKet1U[z]]];\n   recs = Table[With[{s = recs[[n]],\n       qs = Table[solveMonicU[BaxDirU[recs[[n, \"T1\"]], recs[[n, \"T2\"]], z[[i]]],\n          4 - recs[[n, \"mu\", i]]], {i, 3}],\n       qds = Table[solveMonicU[BaxDualU[recs[[n, \"T1\"]], recs[[n, \"T2\"]], 1/z[[j]]],\n          recs[[n, \"mu\", j]]], {j, 3}]},\n      Join[s, <|\"left\" -> L[[n]], \"q\" -> qs[[All, 1]], \"qd\" -> qds[[All, 1]],\n        \"bRes\" -> Max[Join[qs[[All, 2]], qds[[All, 2]]]],\n        \"braR\" -> bra.s[\"vec\"], \"Lket\" -> L[[n]].ket|>]], {n, dcU}];\n   <|\"eps\" -> eps, \"phi\" -> phi, \"z\" -> z, \"recs\" -> recs, \"bra\" -> bra, \"ket\" -> ket|>];\n\nWith[{t = twU[1/1000]},\n Grid[{\n   {\"eps, phi\", {t[\"eps\"], t[\"phi\"]}},\n   {\"number of states\", Length[t[\"recs\"]]},\n   {\"max eigen residual\", N[Max[t[\"recs\"][[All, \"eigRes\"]]], 3]},\n   {\"max Baxter residual\", N[Max[t[\"recs\"][[All, \"bRes\"]]], 3]},\n   {\"states per multiplet (27,10,10b,8,8,1)\", Counts[t[\"recs\"][[All, \"mult\"]]]},\n   {\"hw-limit states (multiplet -> weight)\",\n    {#[\"mult\"], #[\"mu\"]} & /@ Select[t[\"recs\"], #[\"hwLimit\"] &]}\n   }, Frame -> All, Alignment -> Left]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
