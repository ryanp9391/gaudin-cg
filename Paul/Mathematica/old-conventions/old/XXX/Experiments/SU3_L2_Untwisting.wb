      {
       "data": "Out[212]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{t} & \\text{B/B\\_vac: 27} & \\text{10} & \\text{10b} & \\text{8\\_1} & \\text{8\\_2} & \\text{1}\\\\\\hline\\frac{9}{19} & 1 & \\frac{361}{35} & \\frac{361}{35} & \\frac{17511884375}{163924992} & \\frac{5603803}{43200} & \\frac{16983563041}{10672200}\\\\\\hline-\\frac{3}{11} & 1 & \\frac{121}{14} & \\frac{121}{14} & \\frac{336743}{4800} & \\frac{1052321875}{3048192} & \\frac{214358881}{198450}\\\\\\hline\\frac{5}{31} & 1 & \\frac{961}{117} & \\frac{961}{117} & \\frac{2770563}{44800} & \\frac{8658009375}{9161152} & \\frac{852891037441}{883764882}\\\\\\hline\\frac{3}{11} & 1 & \\frac{121}{14} & \\frac{121}{14} & \\frac{336743}{4800} & \\frac{1052321875}{3048192} & \\frac{214358881}{198450}\\\\\\hline\\frac{21}{59} & 1 & \\frac{3481}{380} & \\frac{3481}{380} & \\frac{1538904847}{19051200} & \\frac{4809077646875}{22677777408} & \\frac{146830437604321}{119589841800}\\\\\\hline\\frac{8}{19} & 1 & \\frac{2888}{297} & \\frac{2888}{297} & \\frac{130321}{1400} & \\frac{407253125}{2576574} & \\frac{139129348431872}{99423549225}\\\\\\hline\\end{array}",
