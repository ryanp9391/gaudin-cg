m;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1153em;\"><span class=\"pstrut\" style=\"height:6.4653em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3204em;\"><span class=\"pstrut\" style=\"height:6.4653em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5255em;\"><span class=\"pstrut\" style=\"height:6.4653em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7306em;\"><span class=\"pstrut\" style=\"height:6.4653em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9306em;\"><span class=\"pstrut\" style=\"height:6.4653em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.9653em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[194]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{mu} & \\text{deg q\\_i} & \\text{deg q\\^{}j} & \\text{Baxter exact} & \\text{Psi\\^{}ref untwisted, (a,b)=(1,2)} & \\text{c\\^{}ref untwisted, (c,d)=(3,2)}\\\\\\hline\\left\\{4,2,0\\right\\} & \\left\\{0,3,6\\right\\} & \\left\\{6,3,0\\right\\} & \\mathrm{True} & \\frac{49068}{361} & \\frac{315}{722}\\\\\\hline\\left\\{3,3,0\\right\\} & \\left\\{1,2,6\\right\\} & \\left\\{5,4,0\\right\\} & \\mathrm{True} & \\frac{381640}{130321} & \\frac{19600}{130321}\\\\\\hline\\left\\{4,1,1\\right\\} & \\left\\{0,4,5\\right\\} & \\left\\{6,2,1\\right\\} & \\mathrm{True} & \\frac{6106240}{130321} & \\frac{1225}{130321}\\\\\\hline\\left\\{3,2,1\\right\\} & \\left\\{1,3,5\\right\\} & \\left\\{5,3,1\\right\\} & \\mathrm{True} & \\frac{60935390208}{29403675625} & \\frac{84998144}{5880735125}\\\\\\hline\\left\\{3,2,1\\right\\} & \\left\\{1,3,5\\right\\} & \\left\\{5,3,1\\right\\} & \\mathrm{True} & -\\frac{157017600}{47045881} & \\frac{9072000}{47045881}\\\\\\hline\\left\\{2,2,2\\right\\} & \\left\\{2,3,4\\right\\} & \\left\\{4,3,2\\right\\} & \\mathrm{True} & \\frac{1481068512000}{6131066257801} & \\frac{53787888000}{6131066257801}\\\\\\hline\\end{array}",
