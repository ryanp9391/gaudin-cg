lass=\"mord\"><span class=\"mord\">−</span><span class=\"mord\">4</span></span></span><span style=\"top:-0.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">−</span><span class=\"mord\">4</span></span></span><span style=\"top:0.59em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">−</span><span class=\"mord\">8</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:8.4em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.95em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9em;\"><span class=\"pstrut\" style=\"height:6.45em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.95em;\"><span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.595em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[108]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{eps-power of C\\_vac} & -8\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{hw weight} & \\text{multiplet} & \\text{max |S\\_Q/S\\_vec - 1| over eps} & \\text{power det N} & \\text{power c\\^{}ref} & \\text{power Psi\\^{}ref} & \\text{power S\\_vec}\\\\\\hline\\left\\{4,2,0\\right\\} & 27 & 0.\\times 10^{-151} & 12 & 2 & 2 & 0\\\\\\hline\\left\\{3,3,0\\right\\} & 10 & 3.60\\times 10^{-144} & 10 & 2 & 2 & -2\\\\\\hline\\left\\{4,1,1\\right\\} & \\text{10b} & 3.60\\times 10^{-144} & 10 & 2 & 2 & -2\\\\\\hline\\left\\{3,2,1\\right\\} & 8 & 3.60\\times 10^{-144} & 8 & 2 & 2 & -4\\\\\\hline\\left\\{3,2,1\\right\\} & 8 & 3.60\\times 10^{-144} & 8 & 2 & 2 & -4\\\\\\hline\\left\\{2,2,2\\right\\} & 1 & 3.60\\times 10^{-144} & 4 & 2 & 2 & -8\\\\\\hline\\end{array}\\end{matrix}",
       "mime": "text/plain"
      }
     ],
     "id": "dd46cd82-7716-4b73-be72-0c1454d508c7"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 6. Finite eps -> 0 limits of every factor, at three twist directions phi. ---- *)\nClearAll[epsLimU, phiSetU, kU, limU, limDataU, untwFactorsU, limTabU];\n\nepsLimU = {10^-6, 10^-7, 10^-8};\nphiSetU = {{1, 1/3, -4/3}, {2, -1/2, -3/2}, {1/2, 1, -3/2}};\n(* eps-power of <0|R>: height of lambda_vac - lambda_A. *)\nkU = {0, 1, 1, 2, 2, 4};\n\n(* f(eps) eps^-p is analytic at 0; quadratic extrapolation through three eps values\n   leaves an error O(eps^3) ~ 1e-18. The 2-point estimate is kept as an error bar. *)\nlimU[g_, p_] := Module[{pts = Table[{e, g[e] e^(-p)}, {e, epsLimU}]},\n   {InterpolatingPolynomial[pts, 0], InterpolatingPolynomial[pts[[2 ;;]], 0]}];\n\nlimDataU[phi_] := limDataU[phi] = Table[With[{st = Function[e, qSideU[e, phi][\"states\"][[m]]]},\n     <|\"X\" -> limU[st[#][\"Svec\"] &, -2 kU[[m]]],\n      \"D\" -> limU[st[#][\"detN\"] &, 12 - 2 kU[[m]]],\n      \"P\" -> limU[st[#][\"psiRef\"] &, 2],\n      \"K\" -> limU[st[#][\"cRef\"] &, 2],\n      \"Cv\" -> limU[qSideU[#, phi][\"Cvac\"] &, -8]|>], {m, 6}];\n\n(* Untwisted normalization factors with the staggered q_2 and q^2. *)\nuntwFactorsU = Table[With[{s = untwU[[m]]},\n    {Product[psiRefLocU[Function[i, Function[x, qpolyU[s[\"q\"][[i]], x]]], th, 1, 2], {th, thetaU}],\n     Product[cRefLocU[Function[j, Function[x, qpolyU[s[\"qd\"][[j]], x]]], th, 3, 2], {th, thetaU}]}],\n   {m, 6}];\n\nScan[limDataU, phiSetU];\n\nlimTabU = Flatten[Table[With[{d = limDataU[phi][[m]]},\n     {phi, untwU[[m, \"mu\"]],\n      N[Abs[d[\"X\"][[1]] - d[\"X\"][[2]]]/Abs[d[\"X\"][[1]]], 2],\n      N[d[\"X\"][[1]], 12],\n      N[d[\"Cv\"][[1]] d[\"D\"][[1]]/(d[\"K\"][[1]] d[\"P\"][[1]])/d[\"X\"][[1]] - 1, 2],\n      N[d[\"P\"][[1]]/((phi[[1]] - phi[[2]])^2 untwFactorsU[[m, 1]]), 12],\n      N[d[\"K\"][[1]]/((phi[[2]] - phi[[3]])^2 untwFactorsU[[m, 2]]), 12],\n      N[d[\"Cv\"][[1]], 12]}], {phi, phiSetU}, {m, 6}], 1];\n\nGrid[Prepend[limTabU, {\"phi\", \"hw weight\", \"extrapolation error (rel.)\",\n    \"X = lim eps^2k S_vec\", \"Cv D/(K P)/X - 1\",\n    \"P/((phi1-phi2)^2 Psi^ref_untw)\", \"K/((phi2-phi3)^2 c^ref_untw)\", \"Cv = lim eps^8 C_vac\"}],\n  Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"20\" data-out-n=\"118\" data-sub-idx=\"13\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"6\" data-sub-start=\"37\" data-sub-end=\"40\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[118]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"26\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:23.02em;vertical-align:-11.24em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:11.78em;\"><span style=\"top:-13.74em;\"><span class=\"pstrut\" style=\"height:13.74em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:22.98em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-11.24em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:11.74em;\"><span style=\"top:-13.9em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">phi</span></span></span></span><span style=\"top:-12.69em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">{</span></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"v