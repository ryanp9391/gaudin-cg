       "data": "Out[147]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{hw weight} & \\text{log10 split residual, eps=1e-7} & \\text{log10 split residual, eps=1e-8} & \\text{log10 |det A2\\_H(1e-8)/untwisted - 1|} & \\text{E\\_lambda (formula)} & \\text{|E numeric/formula - 1|} & \\text{det A2\\_H untw / vac} & \\text{<psi\\_0|psi\\_0> from formula vs numeric (rel.)}\\\\\\hline\\left\\{4,2,0\\right\\} & -\\frac{33}{5} & -\\frac{38}{5} & -\\frac{15}{2} & -\\frac{3}{160} & 3.61\\times 10^{-19} & 1 & 0.\\times 10^{-137}\\\\\\hline\\left\\{3,3,0\\right\\} & -\\frac{13}{2} & -\\frac{15}{2} & -\\frac{79}{10} & -\\frac{1}{36} & 2.91\\times 10^{-19} & \\frac{56}{1083} & 7.02\\times 10^{-20}\\\\\\hline\\left\\{4,1,1\\right\\} & -\\frac{31}{5} & -\\frac{36}{5} & -\\frac{73}{10} & -\\frac{1}{36} & 4.01\\times 10^{-19} & \\frac{56}{1083} & 3.95\\times 10^{-20}\\\\\\hline\\left\\{3,2,1\\right\\} & -\\frac{13}{2} & -\\frac{15}{2} & -\\frac{73}{10} & -\\frac{2}{3} & 3.28\\times 10^{-19} & \\frac{370832}{244351875} & 3.30\\times 10^{-20}\\\\\\hline\\left\\{3,2,1\\right\\} & -\\frac{32}{5} & -\\frac{37}{5} & -\\frac{69}{10} & -\\frac{2}{3} & 3.49\\times 10^{-19} & -\\frac{5160}{130321} & 1.27\\times 10^{-20}\\\\\\hline\\left\\{2,2,2\\right\\} & -\\frac{61}{10} & -\\frac{71}{10} & -\\frac{29}{5} & -1 & 3.20\\times 10… [latex truncated: 1276 chars total]",
