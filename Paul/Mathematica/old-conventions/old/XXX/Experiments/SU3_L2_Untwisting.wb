      {
       "data": "Out[132]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|}\\hline\\text{hw weight} & \\text{D-hat/V\\_lambda(phi) phi-independent (rel. spread)} & \\text{lim V\\_\\{lvac-lA\\} S\\_vec = kappa D0/(c Psi)\\_untw (rel. residual)} & \\text{D0\\_A/D0\\_vac} & \\text{<psi\\_0|psi\\_0>\\_A/<psi\\_0|psi\\_0>\\_vac}\\\\\\hline\\left\\{4,2,0\\right\\} & 5.66\\times 10^{-19} & 2.80\\times 10^{-19} & 1 & 1\\\\\\hline\\left\\{3,3,0\\right\\} & 4.36\\times 10^{-19} & 2.18\\times 10^{-19} & \\frac{2240}{29241} & \\frac{361}{35}\\\\\\hline\\left\\{4,1,1\\right\\} & 5.98\\times 10^{-19} & 3.29\\times 10^{-19} & \\frac{2240}{29241} & \\frac{361}{35}\\\\\\hline\\left\\{3,2,1\\right\\} & 4.67\\times 10^{-19} & 2.73\\times 10^{-19} & \\frac{3994979}{74036436} & \\frac{13810774219}{129279694}\\\\\\hline\\left\\{3,2,1\\right\\} & 5.68\\times 10^{-19} & 3.10\\times 10^{-19} & -\\frac{550400}{390963} & \\frac{5603803}{43200}\\\\\\hline\\left\\{2,2,2\\right\\} & 4.67\\times 10^{-19} & 4.60\\times 10^{-19} & \\frac{3080463}{54164911} & \\frac{16983563041}{10672200}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{kappa = lim eps\\^{}8 V\\_lvac(phi) C\\_vac} & -0.0671302281185605+0.0169996825156526\\,\\mathrm{i}\\\\\\hline\\text{kappa = (c Psi)\\_untw,vac / D0\\_vac} & 2.80\\times 10^{-19}\\\\\\hline\\text{singlet: D0 = d… [latex truncated: 1680 chars total]",
       "mime": "text/plain"
