      {
       "data": "Out[222]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|}\\hline\\text{hw weight} & \\text{B\\_A/B\\_vac(t), t = theta1-theta2 (h=1)} & \\text{component c = site1 hw (x) extremal site2} & \\text{||r\\_0||\\_S\\^{}2/c\\^{}2} & \\text{required N\\_R N\\_L}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & \\left\\{1,1\\right\\} & 1 & 1\\\\\\hline\\left\\{3,3,0\\right\\} & -\\frac{8}{\\left(t-1\\right)\\,\\left(t+1\\right)} & \\left\\{1,3\\right\\} & 2 & -\\frac{1}{4}\\,\\left(t-1\\right)\\,\\left(t+1\\right)\\\\\\hline\\left\\{4,1,1\\right\\} & -\\frac{8}{\\left(t-1\\right)\\,\\left(t+1\\right)} & \\left\\{1,2\\right\\} & 2 & -\\frac{1}{4}\\,\\left(t-1\\right)\\,\\left(t+1\\right)\\\\\\hline\\left\\{2,2,2\\right\\} & \\frac{73728}{\\left(t-3\\right)^2\\,\\left(t-1\\right)^2\\,\\left(t+1\\right)^2\\,\\left(t+3\\right)^2} & \\left\\{1,8\\right\\} & 72 & \\frac{\\left(t-3\\right)^2\\,\\left(t-1\\right)^2\\,\\left(t+1\\right)^2\\,\\left(t+3\\right)^2}{1024}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{octets: B/B\\_vac = (P + sigma Q s)/R, \\{P, Q, R\\}} & \\left\\{3\\,\\left(5\\,t^2+4\\right)\\,\\left(5\\,t^2-10\\,t+9\\right)\\,\\left(5\\,t^2+10\\,t+9\\right),6\\,\\left(125\\,t^4-350\\,t^2+81\\right),\\left(t-3\\right)^2\\,\\left(t-1\\right)^2\\,t^2\\,\\left(t+1\\right)^2\\,\\left(t+3\\right)^2\\right\\}\\\\\\hline\\text{number of t points (both octets… [latex truncated: 1260 chars total]",
       "mime": "text/plain"
      }
