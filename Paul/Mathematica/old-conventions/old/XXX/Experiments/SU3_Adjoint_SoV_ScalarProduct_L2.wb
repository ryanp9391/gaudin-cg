      {
       "data": "Out[66]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{rows vanishing identically on the diagonal, (s,i,j)} & \\{\\}\\\\\\hline\\text{triples with det N\\^{}\\{AA\\} $\\not=$ 0 for all 6 states} & 732\\text{ / }816\\\\\\hline\\text{distribution (\\#states with nonzero norm -> \\#triples)} & \\begin{pmatrix}0 & 84\\\\6 & 732\\end{pmatrix}\\\\\\hline\\text{triple used below, (s,i,j)} & \\begin{pmatrix}1 & 1 & 1\\\\1 & 1 & 2\\\\1 & 2 & 1\\end{pmatrix}\\\\\\hline\\text{norms det N\\^{}\\{AA\\} $\\not=$ 0} & 6\\text{ / }6\\\\\\hline\\text{cross det N\\^{}\\{AB\\} = 0} & 30\\text{ / }30\\\\\\hline\\text{cross N\\^{}\\{AB\\}$\\cdot$$\\Delta$ = 0} & 30\\text{ / }30\\\\\\hline\\text{cross pairs with N\\^{}\\{AB\\} $\\equiv$ 0 (no test)} & \\{\\}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{mu\\_A} & \\text{\\#} & \\text{mu\\_B} & \\text{\\#} & \\text{kind} & \\text{det N} & \\text{($\\Delta$t1, $\\Delta$t21, $\\Delta$t20)} & \\text{N.$\\Delta$ = 0} & \\text{rank N}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & \\left\\{4,2,0\\right\\} & 1 & \\text{norm} & \\frac{407426964785749967}{4435654662658800} & \\left\\{0,0,0\\right\\} & \\mathrm{True} & 3\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & \\left\\{3,3,0\\right\\} & 1 & \\text{cross} & 0 & \\left\\{2,-\\frac{22}{57},-\\frac{16}{171}\\right\\} & \\mathrm{T… [latex truncated: 6286 chars total]",
