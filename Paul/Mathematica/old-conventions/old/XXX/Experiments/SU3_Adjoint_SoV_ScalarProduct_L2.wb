      },
      {
       "data": "Out[56]= \\begin{array}{|c|c|}\\hline\\text{$\\Delta$T1 constant, $\\Delta$T2 = $\\Delta$T1 u\\^{}2 + $\\ldots$ (all pairs)} & \\mathrm{True}\\\\\\hline\\text{L\\_s[$\\mu$ q\\^{}j\\_A O\\^{}A q\\_i\\^{}B[2]] = 0 (A$\\not=$B, all s,i,j)} & 540\\text{ / }540\\\\\\hline\\text{R\\^{}\\{AB\\}\\_\\{s,i,j\\}$\\cdot$($\\Delta$t1, $\\Delta$t21, $\\Delta$t20) = 0 (A$\\not=$B, all s,i,j)} & 540\\text{ / }540\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "dbaf3504-d18e-4388-b4cb-4ae95dd18383"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 5. Which triples of rows (s,i,j) give a nonvanishing norm det N^{AA} for all 6 states? Then orthogonality at the first such triple. ---- *)\nClearAll[rowKeys, normRow, triples, normSurvey, goodTriples, Nmat, orthTab, orthSummary];\nrowKeys = Tuples[{Range[2], Range[3], Range[3]}];\nnormRow = Association[Flatten[Table[{k, st} -> Together[rowR[states[[st]], states[[st]], Sequence @@ rowKeys[[k]]]], {k, Length[rowKeys]}, {st, Length[states]}], 1]];\nzeroRows = Select[Range[Length[rowKeys]], And @@ Table[normRow[{#, st}] === {0, 0, 0}, {st, Length[states]}] &];\ntriples = Subsets[Range[Length[rowKeys]], {3}];\nnormSurvey = Table[{t, Count[Table[Det[normRow[{#, st}] & /@ t] =!= 0, {st, Length[states]}], True]}, {t, triples}];\ngoodTriples = Select[normSurvey, #[[2]] == Length[states] &][[All, 1]];\nNmat[A_, B_, t_] := Together[rowR[A, B, Sequence @@ rowKeys[[#]]] & /@ t];\northTab[t_] := Flatten[Table[With[{N = Nmat[A, B, t], d = dInv[A, B]}, {A[\"mu\"], A[\"copy\"], B[\"mu\"], B[\"copy\"], If[A === B, \"norm\", \"cross\"], Together[Det[N]], d, Together[N . d] === {0, 0, 0}, MatrixRank[N]}], {A, states}, {B, states}], 1];\nWith[{tab = orthTab[First[goodTriples]]},\n Column[{Grid[{{\"rows vanishing identically on the diagonal, (s,i,j)\", rowKeys[[zeroRows]]},\n     {\"triples with det N^{AA} ≠ 0 for all 6 states\", Row[{Length[goodTriples], \" / \", Length[triples]}]},\n     {\"distribution (#states with nonzero norm → #triples)\", Sort[Tally[normSurvey[[All, 2]]]]},\n     {\"triple used below, (s,i,j)\", rowKeys[[First[goodTriples]]]},\n     {\"norms det N^{AA} ≠ 0\", Row[{Count[tab, {__, \"norm\", x_, _, _, _} /; x =!= 0], \" / \", Count[tab, {__, \"norm\", __}]}]},\n     {\"cross det N^{AB} = 0\", Row[{Count[tab, {__, \"cross\", 0, _, _, _}], \" / \", Count[tab, {__, \"cross\", __}]}]},\n     {\"cross N^{AB}·Δ = 0\", Row[{Count[tab, {__, \"cross\", _, _, True, _}], \" / \", Count[tab, {__, \"cross\", __}]}]},\n     {\"cross pairs with N^{AB} ≡ 0 (no test)\", Cases[tab, {a_, ca_, b_, cb_, \"cross\", _, _, _, 0} :> {a, ca, b, cb}]}}, Frame -> All, Alignment -> Left],\n   Grid[Prepend[tab, {\"mu_A\", \"#\", \"mu_B\", \"#\", \"kind\", \"det N\", \"(Δt1, Δt21, Δt20)\", \"N.Δ = 0\", \"rank N\"}], Frame -> All]}]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
