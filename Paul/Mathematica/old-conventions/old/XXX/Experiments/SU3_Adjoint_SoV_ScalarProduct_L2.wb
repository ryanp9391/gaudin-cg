      {
       "data": "Out[33]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{k} & \\text{[u\\^{}k]T2 = a [u\\^{}0]T1 + b : \\{a,b\\}}\\\\\\hline4 & \\left\\{0,3\\right\\}\\\\\\hline3 & \\left\\{0,-6\\,\\left(3\\,h+\\theta1+\\theta2\\right)\\right\\}\\\\\\hline2 & \\left\\{1,3\\,\\left(10\\,h^2+8\\,h\\,\\left(\\theta1+\\theta2\\right)+\\theta1^2+3\\,\\theta1\\,\\theta2+\\theta2^2\\right)\\right\\}\\\\\\hline1 & \\text{not in span\\{[u\\^{}0]T1, 1\\}}\\\\\\hline0 & \\text{not in span\\{[u\\^{}0]T1, 1\\}}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{all records are eigenvectors of T1(u), T2(u)} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|}\\hline\\text{mu} & \\text{copy} & \\text{T1(u)} & \\text{T2(u)}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & 3\\,u^2-\\frac{125\\,u}{19}+\\frac{310}{57} & 3\\,u^4-\\frac{364\\,u^3}{19}+\\frac{14455\\,u^2}{361}-\\frac{98098\\,u}{3249}+\\frac{5272}{513}\\\\\\hline\\left\\{3,3,0\\right\\} & 1 & 3\\,u^2-\\frac{125\\,u}{19}+\\frac{196}{57} & 3\\,u^4-\\frac{364\\,u^3}{19}+\\frac{13733\\,u^2}{361}-\\frac{96844\\,u}{3249}+\\frac{280}{27}\\\\\\hline\\left\\{4,1,1\\right\\} & 1 & 3\\,u^2-\\frac{125\\,u}{19}+\\frac{196}{57} & 3\\,u^4-\\frac{364\\,u^3}{19}+\\frac{13733\\,u^2}{361}-\\frac{57856\\,u}{3249}-\\frac{4508}{513}\\\\\\hline\\left\\{3,2,1\\right\\} & 1 & 3\\,u^2-\\frac{125\\,u}{19}+\\frac{25}{57} &… [latex truncated: 1648 chars total]",
