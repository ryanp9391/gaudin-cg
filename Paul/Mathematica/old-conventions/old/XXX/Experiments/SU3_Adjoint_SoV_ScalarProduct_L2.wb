      },
      {
       "data": "Out[91]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{(i,j)} & \\text{\\# identically zero diagonal rows (of 18 = 6 states $\\times$ 3 points)}\\\\\\hline\\left\\{1,1\\right\\} & 0\\\\\\hline\\left\\{1,2\\right\\} & 18\\\\\\hline\\left\\{1,3\\right\\} & 18\\\\\\hline\\left\\{2,1\\right\\} & 0\\\\\\hline\\left\\{2,2\\right\\} & 0\\\\\\hline\\left\\{2,3\\right\\} & 18\\\\\\hline\\left\\{3,1\\right\\} & 0\\\\\\hline\\left\\{3,2\\right\\} & 0\\\\\\hline\\left\\{3,3\\right\\} & 0\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{triples with det $\\not=$ 0 for all 18} & 19\\text{ / }84\\\\\\hline\\text{distribution} & \\begin{pmatrix}0 & 65\\\\18 & 19\\end{pmatrix}\\\\\\hline\\text{good triples with all 30 cross det = 0 at P1} & 19\\\\\\hline\\end{array}\\end{matrix}",
       "mime": "text/plain"
      }
