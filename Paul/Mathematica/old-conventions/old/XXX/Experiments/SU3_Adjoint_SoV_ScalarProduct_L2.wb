       "data": "Out[136]= \\begin{matrix}\\begin{array}{|c|c|c|c|}\\hline\\text{mu} & \\text{N̂ (T\\_a), symbolic in t} & \\text{H = $\\Psi$\\_L$\\cdot$$\\Psi$\\_R} & \\text{H/N̂}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & 1 & 1\\\\\\hline\\left\\{3,3,0\\right\\} & -\\frac{20}{3\\,\\left(5\\,t-7\\right)\\,\\left(5\\,t+7\\right)} & 2 & -\\frac{3}{10}\\,\\left(5\\,t-7\\right)\\,\\left(5\\,t+7\\right)\\\\\\hline\\left\\{4,1,1\\right\\} & \\frac{160\\,\\left(t-1\\right)\\,\\left(t+1\\right)}{3\\,\\left(5\\,t-7\\right)\\,\\left(5\\,t+7\\right)} & 2 & \\frac{3\\,\\left(5\\,t-7\\right)\\,\\left(5\\,t+7\\right)}{80\\,\\left(t-1\\right)\\,\\left(t+1\\right)}\\\\\\hline\\left\\{2,2,2\\right\\} & -\\frac{20}{3\\,\\left(5\\,t-7\\right)\\,\\left(5\\,t+7\\right)} & 8 & -\\frac{6}{5}\\,\\left(5\\,t-7\\right)\\,\\left(5\\,t+7\\right)\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{N̂(t) reproduces P1 and P2} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{mu} & \\text{q\\_1} & \\text{q\\_12} & \\text{q\\^{}low} & \\text{q\\^{}low,12}\\\\\\hline\\left\\{4,2,0\\right\\} & 1 & -\\left(\\left(u-2\\right)\\,\\left(t-u+2\\right)\\right) & 1 & -\\left(u\\,\\left(t-u\\right)\\right)\\\\\\hline\\left\\{3,3,0\\right\\} & \\frac{1}{2}\\,\\left(-t+2\\,u-3\\right) & -\\left(\\left(u-2\\right)\\,\\left(t-u+2\\right)\\right) & 1 & \\frac{1}{2}\\,u\\,\\left(t-2\\,u+… [latex truncated: 2409 chars total]",
