       "data": "Out[98]= \\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{point} & \\text{mu} & \\text{\\#} & \\text{\\{sector dim, dim ker R, dim ker L\\}} & \\text{$\\Psi$\\_R = hw vector} & \\text{H = $\\Psi$\\_L$\\cdot$$\\Psi$\\_R} & \\text{N̂ (T\\_a)} & \\text{N̂ (T\\_b)} & \\text{H/N̂(T\\_a)}\\\\\\hline\\text{P1} & \\left\\{4,2,0\\right\\} & 1 & \\left\\{1,1,1\\right\\} & \\mathrm{True} & 1 & 1 & 1 & 1\\\\\\hline\\text{P1} & \\left\\{3,3,0\\right\\} & 1 & \\left\\{2,1,1\\right\\} & \\mathrm{True} & 2 & \\frac{1805}{11748} & -\\frac{2800}{2937} & \\frac{23496}{1805}\\\\\\hline\\text{P1} & \\left\\{4,1,1\\right\\} & 1 & \\left\\{2,1,1\\right\\} & \\mathrm{True} & 2 & \\frac{2800}{2937} & \\frac{1805}{11748} & \\frac{2937}{1400}\\\\\\hline\\text{P1} & \\left\\{3,2,1\\right\\} & 1 & \\left\\{6,1,1\\right\\} & \\mathrm{True} & \\frac{645}{128} & \\frac{4085}{5874} & -\\frac{4085}{5874} & \\frac{8811}{1216}\\\\\\hline\\text{P1} & \\left\\{3,2,1\\right\\} & 2 & \\left\\{6,1,1\\right\\} & \\mathrm{True} & \\frac{86}{3} & -\\frac{4085}{5874} & \\frac{4085}{5874} & -\\frac{3916}{95}\\\\\\hline\\text{P1} & \\left\\{2,2,2\\right\\} & 1 & \\left\\{10,1,1\\right\\} & \\mathrm{True} & 8 & \\frac{1805}{11748} & \\frac{1805}{11748} & \\frac{93984}{1805}\\\\\\hline\\text{P2} & \\left\\{4,2,0\\right\\} & 1 & \\left\\{1,1,1\\right\\} & \\mathrm{True… [latex truncated: 2848 chars total]",
       "mime": "text/plain"
