</span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:13.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-6.35em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.1em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-13.3em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-14.5em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-15.7em;\"><span class=\"pstrut\" style=\"height:8.85em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.35em;\"><span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.995em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[358]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{eps-power of C\\_vac} & -12\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{multiplet} & \\text{hw weight} & \\text{k} & \\text{max |S\\_Q/S\\_vec - 1| over eps} & \\text{power det N} & \\text{power c\\^{}ref} & \\text{power Psi\\^{}ref} & \\text{power S\\_vec}\\\\\\hline\\text{60} & 6,2,0 & 0 & 0.\\times 10^{-138} & 16 & 2 & 2 & 0\\\\\\hline\\text{42} & 5,3,0 & 1 & 1.60\\times 10^{-119} & 14 & 2 & 2 & -2\\\\\\hline\\text{21} & 6,1,1 & 1 & 1.53\\times 10^{-116} & 14 & 2 & 2 & -2\\\\\\hline\\text{24\\_1} & 5,2,1 & 2 & 1.60\\times 10^{-119} & 12 & 2 & 2 & -4\\\\\\hline\\text{24\\_2} & 5,2,1 & 2 & 1.60\\times 10^{-119} & 12 & 2 & 2 & -4\\\\\\hline\\text{15'} & 4,4,0 & 2 & 1.60\\times 10^{-119} & 12 & 2 & 2 & -4\\\\\\hline\\text{15b\\_1} & 4,3,1 & 3 & 1.60\\times 10^{-119} & 10 & 2 & 2 & -6\\\\\\hline\\text{15b\\_2} & 4,3,1 & 3 & 1.60\\times 10^{-119} & 10 & 2 & 2 & -6\\\\\\hline\\text{6} & 4,2,2 & 4 & 1.60\\times 10^{-119} & 8 & 2 & 2 & -8\\\\\\hline\\text{3b} & 3,3,2 & 5 & 1.60\\times 10^{-119} & 6 & 2 & 2 & -10\\\\\\hline\\end{array}\\end{matrix}",
       "mime": "text/plain"
      }
     ],
     "id": "9e2f6564-0a4d-4798-aef2-1726f12f2b54"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 7. Finite eps -> 0 limits of every factor, at three twist directions phi. ---- *)\nClearAll[epsLimF, phiSetF, limF, limDataF, untwFactorsF, limTabF, nF, ndF];\n\nepsLimF = {10^-6, 10^-7, 10^-8};\nphiSetF = {{1, 1/3, -4/3}, {2, -1/2, -3/2}, {1/2, 1, -3/2}};\n\n(* f(eps) eps^-p analytic at 0: quadratic extrapolation (error O(eps^3)); the 2-point value is an error bar.\n   Powers from section 6: S_vec -2k, det N 16-2k, Psi^ref and c^ref 2, C_vac -12. *)\nlimF[g_, p_] := Module[{pts = Table[{e, g[e] e^(-p)}, {e, epsLimF}]},\n   {InterpolatingPolynomial[pts, 0], InterpolatingPolynomial[pts[[2 ;;]], 0]}];\nlimDataF[phi_] := limDataF[phi] = Table[With[{st = Function[e, qSideF[e, phi][\"states\"][[m]]]},\n     <|\"X\" -> limF[st[#][\"Svec\"] &, -2 kPredF[[m]]],\n      \"D\" -> limF[st[#][\"detN\"] &, 16 - 2 kPredF[[m]]],\n      \"P\" -> limF[st[#][\"psiRef\"] &, 2],\n      \"K\" -> limF[st[#][\"cRef\"] &, 2],\n      \"Cv\" -> limF[qSideF[#, phi][\"Cvac\"] &, -12]|>], {m, 10}];\n\n(* Untwisted normalization factors with the staggered q_2 and q^2 (numeric; doublets carry radicals). *)\nuntwFactorsF = Table[With[{s = untwF[[m]]},\n    N[{Product[psiRefLocF[Function[i, Function[x, qpolyF[s[\"q\"][[i]], x]]], th, 1, 2], {th, thetaF}],\n      Product[cRefLocF[Function[j, Function[x, qpolyF[s[\"qd\"][[j]], x]]], th, 3, 2], {th, thetaF}]}, precF]], {m, 10}];\n\n(* Leading coefficients of the untwisted Casoratians q1^q2 and q^3^q^2: deg q_2 - deg q_1 and deg q^2 - deg q^3. *)\nlamF = untwF[[All, \"mu\"]];\nnF = Table[l[[1]] - l[[2]] + 1, {l, lamF}];\nndF = Table[l[[2]] - l[[3]] + 1, {l, lamF}];\n\nScan[limDataF, phiSetF];\n\nlimTabF = Flatten[Table[With[{d = limDataF[phi][[m]]},\n     {Row[phi, \",\"], nameF[[m]],\n      N[Abs[d[\"X\"][[1]] - d[\"X\"][[2]]]/Abs[d[\"X\"][[1]]], 2],\n      N[Abs[d[\"Cv\"][[1]] d[\"D\"][[1]]/(d[\"K\"][[1]] d[\"P\"][[1]])/d[\"X\"][[1]] - 1], 2],\n      N[Abs[d[\"P\"][[1]] nF[[m]]^2/((phi[[1]] - phi[[2]])^2 untwFactorsF[[m, 1]]) - 1], 3],\n      N[Abs[d[\"K\"][[1]] ndF[[m]]^2/((phi[[2]] - phi[[3]])^2 untwFactorsF[[m, 2]]) - 1], 3],\n      N[Re[d[\"Cv\"][[1]]], 12]}], {phi, phiSetF}, {m, 10}], 1];\n\nGrid[Prepend[limTabF, {\"phi\", \"multiplet\", \"extrapolation error (rel.)\", \"|Cv D/(K P)/X - 1|\",\n    \"|P n^2/((phi1-phi2)^2 Psi_untw) - 1|, n = l1-l2+1\", \"|K n'^2/((phi2-phi3)^2 c_untw) - 1|, n' = l2-l3+1\",\n    \"Cv = lim eps^12 C_vac\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
