  {
   "kind": 2,
   "value": "(* ---- 4. Does the twisted FSoV identity carry over to [3,1,0]? Test at eps = 1e-3 before untwisting. ---- *)\nClearAll[qRF, qLF, measureF, polesF, weightsF, setMeasureF, rowF, tripleF, detNF, psiRefF, cRefF, sampleF, orthoF, matchF];\n\nqRF[s_, z_, i_, x_] := z[[i]]^x qpolyF[s[\"q\"][[i]], x];\nqLF[s_, z_, j_, x_] := z[[j]]^(-x) qpolyF[s[\"qd\"][[j]], x];\n\n(* Candidate measures: \"nu\" = 1/(nu1 nu2 nu3), poles theta+{0,1,3} (the adjoint rule verbatim);\n   \"ladder\" = all of theta+{0,1,2,3}, i.e. theta+lambda3 .. theta+lambda1. For the adjoint the two coincide.\n   Brackets are one contour around every pole. *)\nsetMeasureF[type_] := (measureF = type;\n   polesF = Flatten@Table[th + n, {th, thetaF}, {n, If[type === \"nu\", {0, 1, 3}, Range[lamSiteF[[3]], lamSiteF[[1]]]]}];\n   weightsF = Table[1/Times @@ (polesF[[r]] - Delete[polesF, r]), {r, Length[polesF]}]);\n\n(* Row (alpha,i,j), columns u^beta x (-Q^j Q_i, Q^j Q_i^[-2], Q^j[2] Q_i), beta = 0,1. *)\nrowF[A_, B_, z_, {alpha_, {i_, j_}}] := Sum[\n   With[{x = polesF[[r]]},\n    weightsF[[r]] Exp[2 Pi I (alpha - 1) SetPrecision[x, precF]] *\n     Flatten@Table[x^beta {-qLF[A, z, j, x] qRF[B, z, i, x], qLF[A, z, j, x] qRF[B, z, i, x - 1],\n        qLF[A, z, j, x + 1] qRF[B, z, i, x]}, {beta, 0, 1}]], {r, Length[polesF]}];\ntripleF = {{1, 3}, {1, 2}, {2, 3}};\ndetNF[A_, B_, z_] := Det[rowF[A, B, z, #] & /@ Flatten[Table[{alpha, ij}, {alpha, 2}, {ij, tripleF}], 1]];\npsiRefF[B_, z_] := Product[psiRefLocF[Function[i, Function[x, qRF[B, z, i, x]]], th, 1, 2], {th, thetaF}];\ncRefF[A_, z_] := Product[cRefLocF[Function[j, Function[x, qLF[A, z, j, x]]], th, 3, 2], {th, thetaF}];\n\n(* Orthogonality: max |det N^{AB}| (A != B, weight-(4,2,2) sector, 14 states) over min |det N^{AA}|. *)\nsampleF = Select[twF[1/1000][\"recs\"], #[\"mu\"] == {4, 2, 2} &];\northoF[type_] := (setMeasureF[type];\n   With[{z = twF[1/1000][\"z\"], S = sampleF},\n    With[{dm = Table[detNF[S[[a]], S[[b]], z], {a, Length[S]}, {b, Length[S]}]},\n     {Length[S], N[Max[Abs[dm - DiagonalMatrix[Diagonal[dm]]]]/Min[Abs[Diagonal[dm]]], 3]}]]);\n\n(* Normalized match on all 225 states: det N/(c^ref Psi^ref) x <L|0><0|R> must be state-independent (= 1/C_vac). *)\nmatchF[type_] := (setMeasureF[type];\n   With[{z = twF[1/1000][\"z\"], recs = twF[1/1000][\"recs\"]},\n    With[{ratio = Table[detNF[s, s, z]/(cRefF[s, z] psiRefF[s, z]) (s[\"braR\"] s[\"Lket\"]), {s, recs}]},\n     {N[Max[Abs[ratio/ratio[[1]] - 1]], 3], N[Min[Abs[ratio]], 3], N[Max[Abs[ratio]], 3]}]]);\n\nWith[{oNu = orthoF[\"nu\"], oLad = orthoF[\"ladder\"], mLad = matchF[\"ladder\"]},\n setMeasureF[\"ladder\"];  (* the measure used everywhere below *)\n Grid[{{\"measure\", \"max|cross det|/min|diag det| (weight (4,2,2), 14 states)\", \"225 states: spread of C_vac^-1 (rel.)\"},\n   {\"1/(nu1 nu2 nu3): poles theta+{0,1,3}\", oNu[[2]], \"-\"},\n   {\"ladder: poles theta+{0,1,2,3}\", oLad[[2]], mLad[[1]]}}, Frame -> All, Alignment -> Left]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"36\" data-out-n=\"340\" data-sub-idx=\"17\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"4\" data-sub-start=\"37\" data-sub-end=\"41\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[340]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:3.64em;vertical-align:-1.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.09em;\"><span style=\"top:-4.05em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">measure</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">1/(nu1 nu2 nu3): poles theta+{0,1,3}</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">ladder: poles theta+{0,1,2,3}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max|cross det|/min|diag det| (weight (4,2,2), 14 states)</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1.09</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">34</span></span></span></span></span></span></span></span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1.49</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">126</span></span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">225 states: spread of C_vac</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">-1 (rel.)</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">-</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1.52</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">151</span></span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[340]= \\begin{array}{|c|c|c|}\\hline\\text{measure} & \\text{max|cross det|/min|diag det| (weight (4,2,2), 14 states)} & \\text{225 states: spread of C\\_vac\\^{}-1 (rel.)}\\\\\\hline\\text{1/(nu1 nu2 nu3): poles theta+\\{0,1,3\\}} & 1.09\\times 10^{34} & \\text{-}\\\\\\hline\\text{ladder: poles theta+\\{0,1,2,3\\}} & 1.49\\times 10^{-126} & 1.52\\times 10^{-151}\\\\\\hline\\end{array}",
