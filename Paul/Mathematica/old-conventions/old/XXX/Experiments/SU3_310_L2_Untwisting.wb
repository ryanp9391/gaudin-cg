  {
   "kind": 2,
   "value": "(* ---- 5. Step 1: how <0|R> and <L|0> vanish as eps -> 0, and where the eigenvectors go. ---- *)\nClearAll[epsListF, keyOfF, slopeF, divTabF, limitCheckF, htF, kPredF];\n\nepsListF = {10^-3, 10^-4, 10^-5, 10^-6};\nScan[twF, epsListF];\n\n(* Local eps-power between the last two eps values; states matched across eps by (weight, multiplet). *)\nkeyOfF[s_] := {s[\"mu\"], s[\"mult\"]};\nslopeF[f_, key_] := Module[{vals},\n   vals = Table[Abs[f[SelectFirst[twF[e][\"recs\"], keyOfF[#] == key &]]], {e, epsListF[[-2 ;;]]}];\n   Log10[vals[[1]]/vals[[2]]]/Log10[epsListF[[-2]]/epsListF[[-1]]]];\n\n(* Height of lambda_vac - lambda_A in simple roots: 2 d1 + d2. *)\nhtF[d_] := 2 d[[1]] + d[[2]];\nkPredF = Table[htF[untwF[[1, \"mu\"]] - untwF[[m, \"mu\"]]], {m, 10}];\n\n(* hw-limit states only (one per multiplet, unique key). *)\ndivTabF = Table[With[{key = {untwF[[m, \"mu\"]], m}},\n    {nameF[[m]], Row[key[[1]], \",\"], kPredF[[m]],\n     Round[slopeF[#[\"braR\"] &, key], 1/100], Round[slopeF[#[\"Lket\"] &, key], 1/100],\n     Round[slopeF[1/(#[\"braR\"] #[\"Lket\"]) &, key], 1/100]}], {m, 10}];\n\n(* Does the pivot-normalized twisted eigenvector converge to the untwisted hw vector? (O(eps) expected) *)\nlimitCheckF = Table[Module[{v0 = N[untwF[[m, \"vec\"]], 100], p,\n     res = Table[Module[{s = SelectFirst[twF[e][\"recs\"], #[\"hwLimit\"] && #[\"mult\"] == m &]},\n        With[{pp = First@Ordering[-Abs[N[untwF[[m, \"vec\"]], 30]], 1]},\n         Max[Abs[s[\"vec\"]/s[\"vec\"][[pp]] - N[untwF[[m, \"vec\"]], 100]/N[untwF[[m, \"vec\"]], 100][[pp]]]]]], {e, {10^-5, 10^-6}}]},\n    {nameF[[m]], N[res[[2]], 3], Round[Log10[res[[1]]/res[[2]]], 1/100]}], {m, 10}];\n\nColumn[{\n  Grid[Prepend[divTabF, {\"multiplet\", \"hw weight\", \"ht(lambda_vac - lambda_A)\", \"eps-power <0|R>\", \"eps-power <L|0>\", \"eps-power S_vec\"}],\n   Frame -> All, Alignment -> Left],\n  Grid[Prepend[limitCheckF, {\"multiplet\", \"max|R(1e-6) - r_0| (pivot-normalized)\", \"convergence order\"}],\n   Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
