  {
   "kind": 2,
   "value": "(* ---- 10. The precise relation: det N_reg = -det[A1]_O det[A2]_H (1+O(eps)), det[A1]_O -> V_lambda(z) E_lambda. ---- *)\nClearAll[splitResF, matUntwNF, untwHF, EformulaF, EnumF, relationTabF, rowPowPredF, a2ResF];\n\nsplitResF[eps_, m_] := With[{mat = matRegF[eps, phiF, m]},\n   Abs[-Det[mat[[1 ;; 3, 4 ;; 6]]] Det[mat[[4 ;; 6, 1 ;; 3]]]/Det[mat] - 1]];\n\n(* The untwisted minor: periodic rows of the triple, H columns, numeric untwisted q's (radicals evaluated first). *)\nmatUntwNF[m_] := rowUntwF[untwNF[[m]], #] & /@ Flatten[Table[{alpha, ij}, {alpha, 2}, {ij, tripleF}], 1];\nuntwHF[m_] := untwHF[m] = Det[(matUntwNF[m].colChangeF)[[4 ;; 6, 1 ;; 3]]];\na2ResF[eps_, m_] := Abs[Det[matRegF[eps, phiF, m][[4 ;; 6, 1 ;; 3]]]/untwHF[m] - 1];\n\n(* Residue-at-infinity power of bare row (i,j) in O1: max(0, 2(l1-l3)_site - d_ij), d_ij = deg q_i + deg q^j (untwisted);\n   when the difference is negative the residue at infinity is O(1). *)\nrowPowPredF[m_] := Table[Max[0, 2 (lamSiteF[[1]] - lamSiteF[[3]]) - (Length[untwF[[m, \"q\"]][[ij[[1]]]]] - 1) - (Length[untwF[[m, \"qd\"]][[ij[[2]]]]] - 1)], {ij, tripleF}];\n\n(* Adjoint formula, unchanged as a function of lambda. *)\nEformulaF[lam_] := -(lam[[1]] - lam[[2]] + 1) (lam[[2]] - lam[[3]] + 1)/\n   ((lam[[1]] - lam[[3]] + 1)! (lam[[1]] - lam[[2]])! (lam[[2]] - lam[[3]])!);\nEnumF[m_] := -D0F[m] Det[colChangeF]/untwHF[m];\n\nrelationTabF = Table[{nameF[[m]], Row[lamF[[m]], \",\"],\n    Row[rowPowPredF[m], \",\"], Row[entryPowF[phiF, m][[1 ;; 3, 4]], \",\"],\n    Round[Log10[splitResF[10^-7, m]], 1/10], Round[Log10[splitResF[10^-8, m]], 1/10],\n    Round[Log10[a2ResF[10^-7, m]], 1/10], Round[Log10[a2ResF[10^-8, m]], 1/10],\n    EformulaF[lamF[[m]]], N[Re[EnumF[m]], 12], N[Abs[EnumF[m]/EformulaF[lamF[[m]]] - 1], 3],\n    N[Abs[(EformulaF[lamF[[m]]] untwHF[m]/(untwFactorsF[[m, 1]] untwFactorsF[[m, 2]]))/\n        (EformulaF[lamF[[1]]] untwHF[1]/(untwFactorsF[[1, 1]] untwFactorsF[[1, 2]]))/psi0NormF[[m]] - 1], 3]}, {m, 10}];\n\nGrid[Prepend[relationTabF, {\"multiplet\", \"hw weight\", \"predicted O1 power, bare rows (1,13),(1,12),(1,23)\", \"measured\",\n    \"log10 split residual, eps=1e-7\", \"eps=1e-8\", \"log10 |det A2_H/untwisted - 1|, eps=1e-7\", \"eps=1e-8\",\n    \"E_lambda (adjoint formula)\", \"E numeric\", \"|E numeric/formula - 1|\",\n    \"<psi_0|psi_0> from boxed formula vs physical limit (rel.)\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
