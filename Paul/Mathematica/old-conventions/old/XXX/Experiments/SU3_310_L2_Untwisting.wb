  {
   "kind": 2,
   "value": "(* ---- 3. Twisted chain at z_j = Exp[eps phi_j]: all 225 states, Q-functions, physical references. ---- *)\nClearAll[precF, phiF, rhoF, zOfF, solveMonicF, nilExpF, refBra1F, refKet1F, twF, multipletOfF, sectorsF];\n\nprecF = 200;\nphiF = {1, 1/3, -4/3};\nrhoF[a_, k_] := Prime[7 a + k + 1]/(11 + 2 a + k);\nzOfF[eps_, phi_] := N[Exp[eps phi], precF];\nsectorsF = Union[wtF];\n\nsolveMonicF[op_, degree_] := Module[{c, x, q, eqs, aa, bb, sol, res, scale},\n  q = Function[y, Evaluate[y^degree + Sum[c[m] y^m, {m, 0, degree - 1}]]];\n  eqs = CoefficientList[Expand[op[q][x]], x];\n  aa = Table[Coefficient[e, c[m]], {e, eqs}, {m, 0, degree - 1}];\n  bb = eqs /. c[_] -> 0;\n  sol = If[degree == 0, {}, LeastSquares[aa, -bb]];\n  res = If[degree == 0, bb, aa.sol + bb];\n  scale = Max[Join[{1}, Abs@Flatten[{aa, bb}]]];\n  {Append[sol, 1], Max[Abs[res]]/scale}];\n\n(* exp of a nilpotent matrix as a finite series (no MatrixPower[., 0]). *)\nnilExpF[mat_, c_] := Module[{acc = IdentityMatrix[dsF], term = IdentityMatrix[dsF]},\n   Do[term = c term.mat/k; acc += term, {k, 1, 8}]; acc];\n(* One-site reference covector/vector on branch I, a13 = 3/5, a23 = 4/7 (adjoint formulas, carried over). *)\nrefBra1F[z_] := With[{a12 = -z[[2]] (z[[1]] - z[[3]])/(z[[1]] (z[[2]] - z[[3]])) (3/5)/(4/7)},\n   UnitVector[dsF, 1].nilExpF[Normal@EEF[1, 2], a12].nilExpF[Normal@EEF[1, 3], 3/5].nilExpF[Normal@EEF[2, 3], 4/7]];\nrefKet1F[z_] := With[{a12 = -z[[2]] (z[[1]] - z[[3]])/(z[[1]] (z[[2]] - z[[3]])) (3/5)/(4/7), a13 = 3/5, a23 = 4/7},\n   nilExpF[Normal@EEF[2, 1], -z[[1]] (z[[1]] - z[[3]])/(a12 z[[2]] (z[[2]] - z[[3]]))].\n    nilExpF[Normal@EEF[3, 1], -z[[1]]^2/(a13 z[[3]]^2)].\n    nilExpF[Normal@EEF[3, 2], -z[[2]]^2 (z[[1]] - z[[3]])/(a23 (z[[1]] - z[[2]]) z[[3]]^2)].UnitVector[dsF, 1]];\n\n(* Multiplet of a twisted state: the untwisted record whose (T1,T2) is closest. *)\nmultipletOfF[t1_, t2_] := First@Ordering[Table[\n     Total[Abs[CoefficientList[t1 - N[s[\"T1\"], 50], u]]] + Total[Abs[CoefficientList[t2 - N[s[\"T2\"], 50], u]]],\n     {s, untwF}], 1];\n\n(* Eigenvectors are computed per weight sector; the left eigenvectors are the rows of the blockwise inverse. *)\ntwF[eps_] := twF[eps, phiF];\ntwF[eps_, phi_List] := twF[eps, phi] = Module[{z = zOfF[eps, phi], recs, bra, ket, tco},\n   Do[tco[a, k] = Normal[TcoF[a, k, z]], {a, 2}, {k, 0, 2 a}];\n   bra = Flatten[KroneckerProduct[refBra1F[z], refBra1F[z]]];\n   ket = Flatten[KroneckerProduct[refKet1F[z], refKet1F[z]]];\n   recs = Flatten[Table[\n      Module[{idx = Flatten@Position[wtF, wt], K, vals, vecs, Linv},\n       K = Sum[rhoF[a, k] tco[a, k][[idx, idx]], {a, 2}, {k, 0, 2 a}];\n       {vals, vecs} = Eigensystem[K];\n       vecs = Table[vv/vv[[First@Ordering[-Abs[vv], 1]]], {vv, vecs}];\n       Linv = Inverse[Transpose[vecs]];\n       Table[Module[{vv = vecs[[r]], p, t1, t2, full, left, m, qs, qds},\n         p = First@Ordering[-Abs[vv], 1];\n         t1 = Expand@Sum[(tco[1, k][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 2}];\n         t2 = Expand@Sum[(tco[2, k][[idx, idx]].vv)[[p]]/vv[[p]] u^k, {k, 0, 4}];\n         full = ReplacePart[ConstantArray[SetPrecision[0, precF], dcF], Thread[idx -> vv]];\n         left = ReplacePart[ConstantArray[SetPrecision[0, precF], dcF], Thread[idx -> Linv[[r]]]];\n         m = multipletOfF[t1, t2];\n         qs = Table[solveMonicF[BaxDirF[t1, t2, z[[i]]], 6 - wt[[i]]], {i, 3}];\n         qds = Table[solveMonicF[BaxDualF[t1, t2, 1/z[[j]]], wt[[j]]], {j, 3}];\n         <|\"mu\" -> wt, \"vec\" -> full, \"left\" -> left, \"T1\" -> t1, \"T2\" -> t2,\n          \"mult\" -> m, \"hwLimit\" -> (untwF[[m, \"mu\"]] == wt),\n          \"eigRes\" -> Max[Flatten@Table[Abs[tco[a, k][[idx, idx]].vv - Coefficient[{t1, t2}[[a]], u, k] vv],\n              {a, 2}, {k, 0, 2 a}]],\n          \"q\" -> qs[[All, 1]], \"qd\" -> qds[[All, 1]], \"bRes\" -> Max[Join[qs[[All, 2]], qds[[All, 2]]]],\n          \"braR\" -> bra.full, \"Lket\" -> left.ket|>],\n        {r, Length[vecs]}]],\n      {wt, sectorsF}], 1];\n   <|\"eps\" -> eps, \"phi\" -> phi, \"z\" -> z, \"recs\" -> recs, \"bra\" -> bra, \"ket\" -> ket|>];\n\nWith[{t = AbsoluteTiming[twF[1/1000]]},\n Grid[{\n   {\"eps, phi\", Row[{1/1000, \"  \", Row[phiF, \",\"]}]},\n   {\"build time (s)\", Round[t[[1]], 0.1]},\n   {\"number of states\", Length[t[[2]][\"recs\"]]},\n   {\"max eigen residual\", N[Max[t[[2]][\"recs\"][[All, \"eigRes\"]]], 3]},\n   {\"max Baxter residual (deg 6-mu_i, mu_j)\", N[Max[t[[2]][\"recs\"][[All, \"bRes\"]]], 3]},\n   {\"states per multiplet (expected 60,42,21,24,24,15,15,15,6,3)\",\n    Row[Table[Count[t[[2]][\"recs\"][[All, \"mult\"]], m], {m, 10}], \",\"]},\n   {\"hw-limit states found per multiplet\", Row[Table[Count[t[[2]][\"recs\"], _?(#[\"hwLimit\"] && #[\"mult\"] == m &)], {m, 10}], \",\"]}\n   }, Frame -> All, Alignment -> Left]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"752601\" data-output-id=\"34\" data-out-n=\"314\" data-sub-idx=\"18\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"3\" data-sub-start=\"66\" data-sub-end=\"76\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[314]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:8.4451em;vertical-align:-3.9526em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4926em;\"><span style=\"top:-6.4526em;\"><span class=\"pstrut\" style=\"height:6.4526em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:8.4051em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.9526em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4526em;\"><span style=\"top:-6.6074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">eps, phi</span></span></span></span><span style=\"top:-5.4074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">build time (s)</span></span></span></span><span style=\"top:-4.2074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">number of states</span></span></span></span><span style=\"top:-3.0074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max eigen residual</span></span></span></span><span style=\"top:-1.8074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max Baxter residual (deg 6-mu_i, mu_j)</span></span></span></span><span style=\"top:-0.6074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">states per multiplet (expected 60,42,21,24,24,15,15,15,6,3)</span></span></span></span><span style=\"top:0.5926em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">hw-limit states found per multiplet</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.9526em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:8.4051em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.9526em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.4526em;\"><span style=\"top:-6.6074em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">1000</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">1</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mord text\"><span class=\"mord\"> </span></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">3</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">1</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">−</span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.65