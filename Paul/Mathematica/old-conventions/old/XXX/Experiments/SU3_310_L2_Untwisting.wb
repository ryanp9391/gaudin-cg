       "data": "Out[429]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{multiplet} & \\text{hw weight} & \\text{predicted O1 power, bare rows (1,13),(1,12),(1,23)} & \\text{measured} & \\text{log10 split residual, eps=1e-7} & \\text{eps=1e-8} & \\text{log10 |det A2\\_H/untwisted - 1|, eps=1e-7} & \\text{eps=1e-8} & \\text{E\\_lambda (adjoint formula)} & \\text{E numeric} & \\text{|E numeric/formula - 1|} & \\text{<psi\\_0|psi\\_0> from boxed formula vs physical limit (rel.)}\\\\\\hline\\text{60} & 6,2,0 & 6,3,1 & 6,3,1 & -\\frac{33}{5} & -\\frac{38}{5} & -\\frac{63}{10} & -\\frac{73}{10} & -\\frac{1}{16128} & -0.0000620039682540 & 8.64\\times 10^{-19} & 0.\\times 10^{-119}\\\\\\hline\\text{42} & 5,3,0 & 5,1,2 & 5,1,2 & -\\frac{33}{5} & -\\frac{38}{5} & -\\frac{37}{5} & -\\frac{42}{5} & -\\frac{1}{720} & -0.00138888888889 & 7.38\\times 10^{-19} & 1.26\\times 10^{-19}\\\\\\hline\\text{21} & 6,1,1 & 5,4,0 & 5,4,0 & -\\frac{31}{5} & -\\frac{36}{5} & -\\frac{31}{5} & -\\frac{36}{5} & -\\frac{1}{14400} & -0.0000694444444444 & 9.36\\times 10^{-19} & 7.17\\times 10^{-20}\\\\\\hline\\text{24\\_1} & 5,2,1 & 4,2,0 & 4,2,0 & -\\frac{33}{5} & -\\frac{38}{5} & -\\frac{13}{2} & -\\frac{15}{2} & -\\frac{1}{90} & -0.0111111111111 & 8.04\\times 10^{-19} & 5.99\\times 10^{-20}\\\\… [latex truncated: 2323 chars total]",
