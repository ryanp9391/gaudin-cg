  {
   "kind": 2,
   "value": "(* ---- 11. Independent check at a second chain point, theta = (1/5, 46/55), phi = (3/2, 1/2, -2).\n   This cell REBUILDS the chain, the measure poles and the untwisted states: after it, earlier cells refer to P2. ---- *)\nClearAll[phiP2F, epsP2F, checkP2F];\n\nbuildChainF[{1/5, 46/55}];\nsetMeasureF[\"ladder\"];\nuntwF = buildUntwF[];\nuntwNF = Table[Join[s, <|\"q\" -> N[s[\"q\"], 250], \"qd\" -> N[s[\"qd\"], 250]|>], {s, untwF}];\nClear[untwHF];\nuntwHF[m_] := untwHF[m] = Det[(matUntwNF[m].colChangeF)[[4 ;; 6, 1 ;; 3]]];\n\n(* New phi, so no memoized twisted data from P1 is reused. *)\nphiP2F = {3/2, 1/2, -2};\nepsP2F = {10^-7, 10^-8};\n\ncheckP2F = Table[Module[{Ee, mat8 = matRegF[10^-8, phiP2F, m], E0},\n    Ee = Table[Det[matRegF[e, phiP2F, m][[1 ;; 3, 4 ;; 6]]]/(e^dOrdF[[m]] vandPhiF[phiP2F, untwF[[m, \"mu\"]]]), {e, epsP2F}];\n    E0 = (10 Ee[[2]] - Ee[[1]])/9;\n    {nameF[[m]], Row[untwF[[m, \"mu\"]], \",\"],\n     Round[Log10[Abs[-Det[mat8[[1 ;; 3, 4 ;; 6]]] Det[mat8[[4 ;; 6, 1 ;; 3]]]/Det[mat8] - 1]], 1/10],\n     Round[Log10[Abs[Det[mat8[[4 ;; 6, 1 ;; 3]]]/untwHF[m] - 1]], 1/10],\n     EformulaF[untwF[[m, \"mu\"]]], N[Abs[E0/EformulaF[untwF[[m, \"mu\"]]] - 1], 3],\n     N[Max[Abs[Table[qSideF[e, phiP2F][\"Cvac\"] qSideF[e, phiP2F][\"states\"][[m, \"detN\"]]/\n          (qSideF[e, phiP2F][\"states\"][[m, \"cRef\"]] qSideF[e, phiP2F][\"states\"][[m, \"psiRef\"]])/\n          qSideF[e, phiP2F][\"states\"][[m, \"Svec\"]] - 1, {e, epsP2F}]]], 3]}], {m, 10}];\n\nGrid[Prepend[checkP2F, {\"multiplet\", \"hw weight\", \"log10 split residual (eps=1e-8)\",\n    \"log10 |det A2_H - untwisted| (rel.)\", \"E_lambda formula\", \"|E extrapolated/formula - 1|\",\n    \"exact identity S_Q/S_vec - 1\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
