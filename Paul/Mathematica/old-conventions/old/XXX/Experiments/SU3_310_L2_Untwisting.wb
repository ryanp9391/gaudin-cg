      {
       "data": "Out[440]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{multiplet} & \\text{hw weight} & \\text{log10 split residual (eps=1e-8)} & \\text{log10 |det A2\\_H - untwisted| (rel.)} & \\text{E\\_lambda formula} & \\text{|E extrapolated/formula - 1|} & \\text{exact identity S\\_Q/S\\_vec - 1}\\\\\\hline\\text{60} & 6,2,0 & -\\frac{37}{5} & -7 & -\\frac{1}{16128} & 1.20\\times 10^{-13} & 0.\\times 10^{-121}\\\\\\hline\\text{42} & 5,3,0 & -\\frac{37}{5} & -\\frac{37}{5} & -\\frac{1}{720} & 4.23\\times 10^{-14} & 3.06\\times 10^{-95}\\\\\\hline\\text{21} & 6,1,1 & -7 & -\\frac{73}{10} & -\\frac{1}{14400} & 8.17\\times 10^{-14} & 1.17\\times 10^{-89}\\\\\\hline\\text{24\\_1} & 5,2,1 & -\\frac{37}{5} & -\\frac{69}{10} & -\\frac{1}{90} & 1.62\\times 10^{-13} & 3.06\\times 10^{-95}\\\\\\hline\\text{24\\_2} & 5,2,1 & -\\frac{36}{5} & -\\frac{37}{5} & -\\frac{1}{90} & 6.28\\times 10^{-14} & 3.06\\times 10^{-95}\\\\\\hline\\text{15'} & 4,4,0 & -\\frac{73}{10} & -8 & -\\frac{1}{576} & 2.58\\times 10^{-14} & 3.06\\times 10^{-95}\\\\\\hline\\text{15b\\_1} & 4,3,1 & -\\frac{73}{10} & -\\frac{33}{5} & -\\frac{1}{8} & 3.95\\times 10^{-13} & 3.06\\times 10^{-95}\\\\\\hline\\text{15b\\_2} & 4,3,1 & -\\frac{37}{5} & -\\frac{69}{10} & -\\frac{1}{8} & 1.02\\times 10^{-13} & 3.06\\times 10^{-95}\\\\\\hline\\… [latex truncated: 1432 chars total]",
