       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[300]= \\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{multiplet} & \\text{hw weight} & \\text{deg q\\_i} & \\text{deg q\\^{}j} & \\text{predicted (6-l\\_i)+(i-1)} & \\text{predicted l\\_j+3-j} & \\text{Baxter exact} & \\text{[u\\^{}0] T2}\\\\\\hline\\text{60} & 6,2,0 & 0,5,8 & 8,3,0 & 0,5,8 & 8,3,0 & \\mathrm{True} & 18.1848773982\\\\\\hline\\text{42} & 5,3,0 & 1,4,8 & 7,4,0 & 1,4,8 & 7,4,0 & \\mathrm{True} & 18.3720119011\\\\\\hline\\text{21} & 6,1,1 & 0,6,7 & 8,2,1 & 0,6,7 & 8,2,1 & \\mathrm{True} & -15.2654149995\\\\\\hline\\text{24\\_1} & 5,2,1 & 1,5,7 & 7,3,1 & 1,5,7 & 7,3,1 & \\mathrm{True} & -11.8739703076\\\\\\hline\\text{24\\_2} & 5,2,1 & 1,5,7 & 7,3,1 & 1,5,7 & 7,3,1 & \\mathrm{True} & 4.84606428525\\\\\\hline\\text{15'} & 4,4,0 & 2,3,8 & 6,5,0 & 2,3,8 & 6,5,0 & \\mathrm{True} & 18.4655791526\\\\\\hline\\text{15b\\_1} & 4,3,1 & 2,4,7 & 6,4,1 & 2,4,7 & 6,4,1 & \\mathrm{True} & -8.83705717712\\\\\\hline\\text{15b\\_2} & 4,3,1 & 2,4,7 & 6,4,1 & 2,4,7 & 6,4,1 & \\mathrm{True} & 1.51090554072\\\\\\hline\\text{6} & 4,2,2 & 2,5,6 & 6,3,2 & 2,5,6 & 6,3,2 & \\mathrm{True} & -2.72740330358\\\\\\hline\\text{3b} & 3,3,2 & 3,4,6 & 5,4,2 & 3,4,6 & 5,4,2 & \\mathrm{True} & -5.01980096440\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
