      {
       "data": "Out[350]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{multiplet} & \\text{hw weight} & \\text{ht(lambda\\_vac - lambda\\_A)} & \\text{eps-power <0|R>} & \\text{eps-power <L|0>} & \\text{eps-power S\\_vec}\\\\\\hline\\text{60} & 6,2,0 & 0 & 0 & 0 & 0\\\\\\hline\\text{42} & 5,3,0 & 1 & 1 & 1 & -2\\\\\\hline\\text{21} & 6,1,1 & 1 & 1 & 1 & -2\\\\\\hline\\text{24\\_1} & 5,2,1 & 2 & 2 & 2 & -4\\\\\\hline\\text{24\\_2} & 5,2,1 & 2 & 2 & 2 & -4\\\\\\hline\\text{15'} & 4,4,0 & 2 & 2 & 2 & -4\\\\\\hline\\text{15b\\_1} & 4,3,1 & 3 & 3 & 3 & -6\\\\\\hline\\text{15b\\_2} & 4,3,1 & 3 & 3 & 3 & -6\\\\\\hline\\text{6} & 4,2,2 & 4 & 4 & 4 & -8\\\\\\hline\\text{3b} & 3,3,2 & 5 & 5 & 5 & -10\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{multiplet} & \\text{max|R(1e-6) - r\\_0| (pivot-normalized)} & \\text{convergence order}\\\\\\hline\\text{60} & 0.\\times 10^{-100} & \\mathrm{Indeterminate}\\\\\\hline\\text{42} & 2.54\\times 10^{-7} & 1\\\\\\hline\\text{21} & 4.39\\times 10^{-7} & 1\\\\\\hline\\text{24\\_1} & 2.57\\times 10^{-7} & 1\\\\\\hline\\text{24\\_2} & 5.33\\times 10^{-7} & 1\\\\\\hline\\text{15'} & 3.51\\times 10^{-7} & 1\\\\\\hline\\text{15b\\_1} & 8.73\\times 10^{-8} & 1\\\\\\hline\\text{15b\\_2} & 3.47\\times 10^{-7} & 1\\\\\\hline\\text{6} & 5.72\\times 10^{-7} & 1\\\\\\hline\\text{3b}… [latex truncated: 1256 chars total]",
