  {
   "kind": 2,
   "value": "(* ---- 2. Untwisted highest-weight states and their Q-functions (exact; doublets in Q(sqrt D)). ---- *)\nClearAll[BaxDirF, BaxDualF, polyKernelF, qpolyF, wtF, hwMusF, hwBasisF, hwRecsF, buildUntwF, untwF, nameF,\n  psiRefLocF, cRefLocF];\n\n(* Twisted reduced Baxter operators for Q = z^u q (direct, gauge nu1) and Q = z^-u q (dual, gauge nu3);\n   unimodular twist, so the last term is qdet. z = 1 gives the untwisted ones. Same form as the adjoint,\n   with nu_i shifted by lambda_i of [3,1,0]. *)\nBaxDirF[T1_, T2_, z_][q_][x_] :=\n  z nu1F[x] nu1F[x - 1] nu1F[x - 2] q[x + 1] - (T1 /. u -> x) nu1F[x - 1] nu1F[x - 2] q[x]\n  + (T2 /. u -> x) nu1F[x - 2] q[x - 1]/z - qdetF[x] q[x - 2]/z^2;\nBaxDualF[T1_, T2_, y_][g_][x_] :=\n  nu3F[x + 1] nu3F[x + 2] nu3F[x + 3] g[x] - y (T1 /. u -> x + 1) nu3F[x + 2] nu3F[x + 3] g[x + 1]\n  + y^2 (T2 /. u -> x + 2) nu3F[x + 3] g[x + 2] - y^3 qdetF[x + 3] g[x + 3];\n(* Horner form: a power list evaluates 0^0 when a pole sits at u = 0. *)\nqpolyF[cl_List, y_] := Fold[#1 y + #2 &, 0, Reverse[cl]];\n\n(* Exact polynomial kernel up to degree 14, row-reduced from the top (staggering gauge), sorted by degree. *)\npolyKernelF[op_] := Module[{c, x, pf, eqs, ns, rr},\n   pf = Function[y, Evaluate[Sum[c[m] y^m, {m, 0, 14}]]];\n   eqs = CoefficientList[Expand[op[pf][x]], x];\n   ns = NullSpace[Table[D[e, c[m]], {e, eqs}, {m, 0, 14}]];\n   rr = DeleteCases[RowReduce[Reverse /@ ns], {0 ..}];\n   SortBy[Table[RootReduce /@ (Reverse[r] /. {a___, 0 ..} :> {a}), {r, rr}], Length]];\n\nwtF = Transpose[Table[Diagonal[Normal@EtotF[i, i]], {i, 3}]];\nhwMusF = {{6, 2, 0}, {5, 3, 0}, {6, 1, 1}, {5, 2, 1}, {4, 4, 0}, {4, 3, 1}, {4, 2, 2}, {3, 3, 2}};\nhwBasisF[w_] := Module[{idx = Flatten@Position[wtF, w]},\n   Transpose@Table[ReplacePart[ConstantArray[0, dcF], Thread[idx -> nv]],\n     {nv, NullSpace[Normal[Join[EtotF[1, 2], EtotF[2, 3]]][[All, idx]]]}]];\n\n(* Joint eigenvectors in each hw space; the two doublets are split by [u^0]T2 (radicals). *)\nhwRecsF[w_] := Module[{Bt = hwBasisF[w], r, Rk, evs, ev, p},\n   r = First@Select[Subsets[Range[dcF], {Length[Bt[[1]]]}], Det[Bt[[#]]] =!= 0 &, 1];\n   Rk[a_, k_] := Inverse[Bt[[r]]].(Normal[TcoF[a, k, {1, 1, 1}]].Bt)[[r]];\n   evs = Eigenvectors[Rk[2, 0]];\n   Table[ev = evs[[c]]; p = First@Flatten@Position[Unitize[ev], 1];\n    <|\"mu\" -> w, \"vec\" -> Bt.ev,\n     \"T1\" -> Sum[RootReduce[(Rk[1, k].ev)[[p]]/ev[[p]]] u^k, {k, 0, 2}],\n     \"T2\" -> Sum[RootReduce[(Rk[2, k].ev)[[p]]/ev[[p]]] u^k, {k, 0, 4}]|>, {c, Length[evs]}]];\n\n(* Records: q = direct q_1,q_2,q_3; qd = q^1,q^2,q^3 (q^3 lowest). Doublets ordered by N[[u^0]T2]. *)\nbuildUntwF[] := Module[{recs},\n   recs = Flatten[hwRecsF /@ hwMusF, 1];\n   recs = SortBy[recs, {First@Flatten@Position[hwMusF, #[\"mu\"]] &, N[Coefficient[#[\"T2\"], u, 0], 30] &}];\n   Table[Append[s, <|\"q\" -> polyKernelF[BaxDirF[s[\"T1\"], s[\"T2\"], 1]],\n      \"qd\" -> Reverse[polyKernelF[BaxDualF[s[\"T1\"], s[\"T2\"], 1]]]|>], {s, recs}]];\nuntwF = buildUntwF[];\n(* SU(3) names (Dynkin labels (l1-l2, l2-l3)); index 1 = vacuum (6,2,0). *)\nnameF = {\"60\", \"42\", \"21\", \"24_1\", \"24_2\", \"15'\", \"15b_1\", \"15b_2\", \"6\", \"3b\"};\n\n(* Adjoint normalization factors for the triple {(a,c),(a,d),(b,c)}; whether they carry over to [3,1,0]\n   is tested against the physical side in section 5. *)\npsiRefLocF[Qd_, th_, a_, b_] := Qd[a][th + 1] (Qd[a][th] Qd[b][th - 1] - Qd[b][th] Qd[a][th - 1]);\ncRefLocF[Qu_, th_, c_, d_] := (Qu[c][th + 1] (Qu[c][th] Qu[d][th + 1] - Qu[d][th] Qu[c][th + 1])\n    - Qu[c][th] (Qu[c][th] Qu[d][th + 2] - Qu[d][th] Qu[c][th + 2]))/4;\n\nGrid[Prepend[Table[With[{s = untwF[[m]]}, {nameF[[m]], Row[s[\"mu\"], \",\"], Row[Length /@ s[\"q\"] - 1, \",\"],\n     Row[Length /@ s[\"qd\"] - 1, \",\"],\n     Row[(6 - s[\"mu\"]) + {0, 1, 2}, \",\"], Row[s[\"mu\"] + {2, 1, 0}, \",\"],\n     And @@ Flatten[{\n        RootReduce[Expand[BaxDirF[s[\"T1\"], s[\"T2\"], 1][Function[y, Evaluate@qpolyF[#, y]]][u]]] === 0 & /@ s[\"q\"],\n        RootReduce[Expand[BaxDualF[s[\"T1\"], s[\"T2\"], 1][Function[y, Evaluate@qpolyF[#, y]]][u]]] === 0 & /@ s[\"qd\"]}],\n     N[Coefficient[s[\"T2\"], u, 0], 12]}], {m, Length[untwF]}],\n   {\"multiplet\", \"hw weight\", \"deg q_i\", \"deg q^j\", \"predicted (6-l_i)+(i-1)\", \"predicted l_j+3-j\",\n    \"Baxter exact\", \"[u^0] T2\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
