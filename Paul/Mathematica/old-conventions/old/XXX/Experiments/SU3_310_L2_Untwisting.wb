  {
   "kind": 2,
   "value": "(* ---- 8. Twist structure of each factor; the untwisted limit. ---- *)\nClearAll[vandPhiF, DhatF, D0F, kappaF, psi0NormF, rowUntwF, matUntwF, structTabF, rankTabF, dOrdF];\n\nvandPhiF[phi_, lam_] := Product[(phi[[i]] - phi[[j]])^(lam[[i]] - lam[[j]]), {i, 3}, {j, i + 1, 3}];\ndOrdF = Table[Total[l[[{1, 1, 2}]] - l[[{2, 3, 3}]]], {l, lamF}];\n\n(* Regularized determinant: det N_raw with the Vandermonde factors of Q_2, Q^2 (and 1/n^2, 1/n'^2) stripped. *)\nDhatF[phi_, m_] := limDataF[phi][[m, \"D\"]][[1]] nF[[m]]^2 ndF[[m]]^2/((phi[[1]] - phi[[2]])^2 (phi[[2]] - phi[[3]])^2);\nD0F[m_] := Mean[Table[DhatF[phi, m]/vandPhiF[phi, lamF[[m]]], {phi, phiSetF}]];\nkappaF = Mean[Table[limDataF[phi][[1, \"Cv\"]][[1]] vandPhiF[phi, lamF[[1]]], {phi, phiSetF}]];\n\n(* <psi_0|psi_0>_A/<psi_0|psi_0>_vac = lim V_{lvac-lA} S_vec *)\npsi0NormF = Table[(D0F[m]/D0F[1]) (untwFactorsF[[1, 1]] untwFactorsF[[1, 2]])/(untwFactorsF[[m, 1]] untwFactorsF[[m, 2]]), {m, 10}];\n\nstructTabF = Table[{nameF[[m]], Row[lamF[[m]], \",\"], dOrdF[[m]],\n    N[Max[Table[Abs[DhatF[phi, m]/vandPhiF[phi, lamF[[m]]]/D0F[m] - 1], {phi, phiSetF}]], 3],\n    N[Max[Table[Abs[limDataF[phi][[m, \"X\"]][[1]] vandPhiF[phi, lamF[[1]] - lamF[[m]]]/\n          (kappaF D0F[m]/(untwFactorsF[[m, 1]] untwFactorsF[[m, 2]])) - 1], {phi, phiSetF}]], 3],\n    N[Re[psi0NormF[[m]]], 15]}, {m, 10}];\n\n(* The untwisted 6x6 matrix with the untwisted (staggered) q's, same ladder measure. *)\nrowUntwF[s_, {alpha_, {i_, j_}}] := Sum[With[{x = polesF[[r]]},\n    weightsF[[r]] Exp[2 Pi I (alpha - 1) SetPrecision[x, precF]] *\n     Flatten@Table[x^beta {-qpolyF[s[\"qd\"][[j]], x] qpolyF[s[\"q\"][[i]], x], qpolyF[s[\"qd\"][[j]], x] qpolyF[s[\"q\"][[i]], x - 1],\n        qpolyF[s[\"qd\"][[j]], x + 1] qpolyF[s[\"q\"][[i]], x]}, {beta, 0, 1}]], {r, Length[polesF]}];\nmatUntwF[m_] := N[rowUntwF[untwF[[m]], #], precF] & /@ Flatten[Table[{alpha, ij}, {alpha, 2}, {ij, tripleF}], 1];\nrankTabF = Table[With[{sv = SingularValueList[N[matUntwF[m], 150], Tolerance -> 0]},\n    {nameF[[m]], Count[sv/Max[sv], _?(# > 10^-60 &)], dOrdF[[m]]}], {m, 10}];\n\nColumn[{\n  Grid[Prepend[structTabF, {\"multiplet\", \"hw weight\", \"order of V_lambda = sum_{i<j}(l_i-l_j)\",\n     \"D-hat/V_lambda(phi) phi-independent (rel. spread)\",\n     \"lim V_{lvac-lA} S_vec = kappa D0/(c Psi)_untw (rel. residual)\", \"<psi_0|psi_0>_A/<psi_0|psi_0>_vac\"}],\n   Frame -> All, Alignment -> Left],\n  Grid[{{\"kappa = lim eps^12 V_lvac(phi) C_vac\", N[Re[kappaF], 15]},\n    {\"|kappa D0_vac/(c Psi)_untw,vac - 1|\", N[Abs[kappaF D0F[1]/(untwFactorsF[[1, 1]] untwFactorsF[[1, 2]]) - 1], 3]}},\n   Frame -> All, Alignment -> Left],\n  Grid[Prepend[rankTabF, {\"multiplet\", \"rank of untwisted 6x6\", \"vanishing order of det N_reg\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
