  {
   "kind": 2,
   "value": "(* ---- 6. Q side for the triple {(1,3),(1,2),(2,3)}: exact identity at small eps, and eps-powers of each factor. ---- *)\nClearAll[hwRecF, qSideF, powF, qTabF];\n\nhwRecF[eps_, m_Integer] := hwRecF[eps, phiF, m];\nhwRecF[eps_, phi_List, m_Integer] := SelectFirst[twF[eps, phi][\"recs\"], #[\"hwLimit\"] && #[\"mult\"] == m &];\n\n(* For each eps and hw-limit state: detN, c^ref, Psi^ref, S_vec; C_vac from the vacuum. *)\nqSideF[eps_] := qSideF[eps, phiF];\nqSideF[eps_, phi_List] := qSideF[eps, phi] = Module[{z = twF[eps, phi][\"z\"], vac = hwRecF[eps, phi, 1], cvac},\n   cvac = cRefF[vac, z] psiRefF[vac, z]/(detNF[vac, vac, z] (1/(vac[\"braR\"] vac[\"Lket\"])));\n   <|\"Cvac\" -> cvac,\n    \"states\" -> Table[With[{s = hwRecF[eps, phi, m]},\n       <|\"detN\" -> detNF[s, s, z], \"cRef\" -> cRefF[s, z], \"psiRef\" -> psiRefF[s, z],\n        \"Svec\" -> 1/(s[\"braR\"] s[\"Lket\"])|>], {m, 10}]|>];\n\npowF[f_] := Log10[Abs[f[epsListF[[-2]]]/f[epsListF[[-1]]]]]/Log10[epsListF[[-2]]/epsListF[[-1]]];\n\nqTabF = Table[Module[{st = Function[e, qSideF[e][\"states\"][[m]]]},\n    {nameF[[m]], Row[untwF[[m, \"mu\"]], \",\"], kPredF[[m]],\n     N[Max[Table[Abs[qSideF[e][\"Cvac\"] st[e][\"detN\"]/(st[e][\"cRef\"] st[e][\"psiRef\"])/st[e][\"Svec\"] - 1], {e, epsListF}]], 3],\n     Round[powF[st[#][\"detN\"] &], 1/100], Round[powF[st[#][\"cRef\"] &], 1/100],\n     Round[powF[st[#][\"psiRef\"] &], 1/100], Round[powF[st[#][\"Svec\"] &], 1/100]}], {m, 10}];\n\nColumn[{\n  Grid[{{\"eps-power of C_vac\", Round[powF[qSideF[#][\"Cvac\"] &], 1/100]}}, Frame -> All, Alignment -> Left],\n  Grid[Prepend[qTabF, {\"multiplet\", \"hw weight\", \"k\", \"max |S_Q/S_vec - 1| over eps\",\n     \"power det N\", \"power c^ref\", \"power Psi^ref\", \"power S_vec\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
