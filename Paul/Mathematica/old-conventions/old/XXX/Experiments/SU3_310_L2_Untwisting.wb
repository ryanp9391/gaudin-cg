      {
       "data": "Out[370]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{phi} & \\text{multiplet} & \\text{extrapolation error (rel.)} & \\text{|Cv D/(K P)/X - 1|} & \\text{|P n\\^{}2/((phi1-phi2)\\^{}2 Psi\\_untw) - 1|, n = l1-l2+1} & \\text{|K n'\\^{}2/((phi2-phi3)\\^{}2 c\\_untw) - 1|, n' = l2-l3+1} & \\text{Cv = lim eps\\^{}12 C\\_vac}\\\\\\hline1,\\frac{1}{3},-\\frac{4}{3} & \\text{60} & 0.\\times 10^{-189} & 1.5\\times 10^{-19} & 2.74\\times 10^{-22} & 2.62\\times 10^{-22} & -71.4191298164\\\\\\hline1,\\frac{1}{3},-\\frac{4}{3} & \\text{42} & 3.8\\times 10^{-16} & 1.3\\times 10^{-19} & 5.20\\times 10^{-22} & 4.58\\times 10^{-22} & -71.4191298164\\\\\\hline1,\\frac{1}{3},-\\frac{4}{3} & \\text{21} & 3.0\\times 10^{-15} & 2.1\\times 10^{-19} & 8.94\\times 10^{-22} & 5.96\\times 10^{-21} & -71.4191298164\\\\\\hline1,\\frac{1}{3},-\\frac{4}{3} & \\text{24\\_1} & 5.4\\times 10^{-15} & 1.8\\times 10^{-19} & 1.32\\times 10^{-21} & 7.25\\times 10^{-21} & -71.4191298164\\\\\\hline1,\\frac{1}{3},-\\frac{4}{3} & \\text{24\\_2} & 5.2\\times 10^{-14} & 3.1\\times 10^{-19} & 1.03\\times 10^{-20} & 2.89\\times 10^{-21} & -71.4191298164\\\\\\hline1,\\frac{1}{3},-\\frac{4}{3} & \\text{15'} & 1.8\\times 10^{-15} & 1.0\\times 10^{-19} & 8.67\\times 10^{-22} & 7.26\\times 10^{-22} & -71.4191298164\\\\\\… [latex truncated: 4857 chars total]",
