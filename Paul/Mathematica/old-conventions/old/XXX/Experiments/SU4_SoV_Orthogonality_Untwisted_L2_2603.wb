   "kind": 2,
   "value": "(* ---- 2. Verify the paper Baxter and dual Baxter equations. ---- *)\nClearAll[qLower26, qUpper26, transferRules26];\nqLower26[r_][k_][u_] := qpoly26[r[\"Q\"][[k]], u];\nqUpper26[r_][j_][u_] := qpoly26[r[\"Qu\"][j], u];\ntransferRules26[r_] := Thread[chargeVars -> r[\"charges\"]];\nbaxterChecks26 = Table[\n  {r[\"mu\"], degQ26[r[\"mu\"]], Table[degQu26[r[\"mu\"], j], {j, 4, 1, -1}],\n   And @@ Table[Expand[B26[qLower26[r][k]][x] /. transferRules26[r] /. θrules26] === 0, {k, 4}],\n   And @@ Table[Expand[Bd26[qUpper26[r][j]][x] /. transferRules26[r] /. θrules26] === 0, {j, 4}]},\n  {r, states26}];\nGrid[Prepend[baxterChecks26, {\"irrep\", \"deg Q_1..Q_4\", \"deg Q^4..Q^1\", \"B Q_j=0\", \"B† Q^j=0\"}], Frame -> All, Alignment -> Left]",
