       "data": "Out[359]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{shift} & \\text{k} & \\text{rank\\{c(z),c(z')\\}} & \\text{stab dim} & \\text{$\\sigma$₂/$\\sigma$₁ (8$\\times$3)} & \\text{site-1 (a,b,c)} & \\text{site-1 res} & \\text{site-2 (a,b,c)} & \\text{site-2 res} & \\text{cell} & \\text{global (a,b,c)} & \\text{global res} & \\text{|b-a(c-a)|}\\\\\\hline\\text{as written} & 0 & 2 & 1 & \\text{9.60}\\times 10^{\\text{-2}} & \\left\\{-0.69526143,0,-1.4560380\\right\\} & \\text{4.08}\\times 10^{\\text{-1}} & \\left\\{0,0.15226680,-0.82022216\\right\\} & \\text{0.}\\times 10^{\\text{-72}} & 1 & \\left\\{-0.69526143,0.15226680,-1.4560380\\right\\} & \\text{4.08}\\times 10^{\\text{-1}} & \\text{3.77}\\times 10^{\\text{-1}}\\\\\\hline\\text{as written} & \\frac{1}{2} & 2 & 1 & \\text{1.10}\\times 10^{\\text{-1}} & \\left\\{-0.70578408,0,-2.0398464\\right\\} & \\text{4.66}\\times 10^{\\text{-1}} & \\left\\{0,0.14055999,-0.84881372\\right\\} & \\text{0.}\\times 10^{\\text{-72}} & 1 & \\left\\{-0.70578408,0.14055999,-2.0398464\\right\\} & \\text{7.63}\\times 10^{\\text{-1}} & \\text{8.01}\\times 10^{\\text{-1}}\\\\\\hline\\text{as written} & -1 & 2 & 1 & \\text{3.12}\\times 10^{\\text{-2}} & \\left\\{-0.68303964,0,-0.85931846\\right\\} & \\text{2.17}\\times 10^{\\text{-1}} & \\left\\{0,0.… [latex truncated: 2678 chars total]",
