  {
   "kind": 2,
   "value": "(* ---- 26. Exactly what the product is, exactly why it is not <0|g1g2|Psi>, and the minimal correction. ---- *)\nClearAll[polyOf, Gpoly, Ppoly, prodPoly, diffPoly, corrPoly, monOrder, coefOf, cmpTab, cc, ccp, XX1, XX2];\n(* the per-site pattern of section 16 as a polynomial in X1, X2 (rows = X1 power, cols = X2 power) *)\npolyOf[c1_, c2_] := Sum[(psPat /. {cc1 -> c1, cc2 -> c2})[[i, j]] XX1^(i - 1) XX2^(j - 1), {i, 2}, {j, 2}];\nGpoly[c_] := polyOf[c, c];              (* the global 2x2 determinant of section 14 *)\nPpoly[c1_, c2_] := polyOf[c1, c2];      (* the per-site target *)\nprodPoly[c_, cp_] := Expand[Gpoly[c] (1 + cp XX1)];   (* Paul's object: global x one-site *)\ndiffPoly[c_, cp_] := Factor[Expand[prodPoly[c, cp] - Ppoly[c + cp, c]]];\ncorrPoly[c_, cp_] := Expand[Gpoly[c] + cp XX1 (1 + c XX2)];  (* the claim, corrected *)\nmonOrder = {{0, 0}, {1, 0}, {0, 1}, {1, 1}, {2, 0}, {2, 1}};\ncoefOf[poly_] := With[{cr = Association[CoefficientRules[Expand[poly], {XX1, XX2}]]}, Lookup[cr, monOrder, 0]];\ncmpTab = Table[With[{c = pTab[[n, \"cG\"]], cp = pTab[[n, \"cL\"]]},\n    {pTab[[n, \"k\"]], pTab[[n, \"kp\"]],\n     Max[Abs[N[coefOf[prodPoly[c, cp]], wpS] - pTab[[n, \"coef\"]]]],          (* fit vs algebra *)\n     Max[Abs[N[coefOf[Ppoly[c + cp, c]] - coefOf[corrPoly[c, cp]], wpS]]],   (* correction = target? *)\n     N[coefOf[prodPoly[c, cp]] - coefOf[Ppoly[c + cp, c]], 6]}],             (* the discrepancy *)\n   {n, Length[pTab]}];\nColumn[{\n  Grid[{{\"global object, as a polynomial in X1, X2\", Gpoly[cc]},\n     {\"one-site factor\", 1 + ccp XX1},\n     {\"Paul's product\", prodPoly[cc, ccp]},\n     {\"the per-site target <0|g1g2, with (c1,c2) = (c+c', c)\", Ppoly[cc + ccp, cc]},\n     {\"product - target\", diffPoly[cc, ccp]},\n     {\"corrected object: global + c' X1 (1 + c X2)\", corrPoly[cc, ccp]},\n     {\"corrected - target\", Factor[Expand[corrPoly[cc, ccp] - Ppoly[cc + ccp, cc]]]}},\n   Frame -> All, Alignment -> Left],\n  Grid[Prepend[Table[{r[[1]], r[[2]], sci[r[[3]]], sci[r[[4]]], r[[5]]}, {r, cmpTab}],\n    {\"k\", \"k'\", \"|fit - algebra| over the 6 monomials\", \"|corrected - target|\",\n     \"product - target, coefficients of {1, X1, X2, X1X2, X1^2, X1^2X2}\"}],\n   Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"24223\" data-output-id=\"25\" data-out-n=\"347\" data-sub-idx=\"12\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"62\" data-sub-start=\"17\" data-sub-end=\"29\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[347]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:14.6544em;vertical-align:-7.0772em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:7.5772em;\"><span style=\"top:-9.5772em;\"><span class=\"pstrut\" style=\"height:6.5572em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.5572em;\"><span style=\"top:-6.5172em;\"><span class=\"pstrut\" style=\"height:6.5172em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:8.5344em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.0172em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.5172em;\"><span style=\"top:-6.6449em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">global object, as a polynomial in X1, X2</span></span></span></span><span style=\"top:-5.4449em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\