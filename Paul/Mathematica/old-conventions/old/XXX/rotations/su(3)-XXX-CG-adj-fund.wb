      {
       "data": "Out[283]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|}\\hline\\text{shape \\{\\#i=1, \\#i=2 rows\\}} & \\text{minors} & \\text{not identically zero} & \\text{best twist mismatch (machine filter)} & \\text{survived mismatch < 10\\^{}-3}\\\\\\hline\\left\\{1,1\\right\\} & 540 & 532 & \\text{2.03894}\\times 10^{\\text{-1}} & 0\\\\\\hline\\left\\{2,1\\right\\} & 1800 & 880 & \\text{4.02117}\\times 10^{\\text{-1}} & 0\\\\\\hline\\left\\{3,1\\right\\} & 1800 & 9 & \\text{7.93536}\\times 10^{\\text{-1}} & 0\\\\\\hline\\left\\{2,2\\right\\} & 3375 & 64 & \\text{4.026}\\times 10^{\\text{-1}} & 0\\\\\\hline\\left\\{3,2\\right\\} & 1800 & 0 & \\infty  & 0\\\\\\hline\\end{array}\\\\\\begin{array}{|c|}\\hline\\text{no minor survived the loose filter -- none of these shapes is an SoV expansion}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{survey time (s)} & 1.875062\\\\\\hline\\end{array}\\end{matrix}",
       "mime": "text/plain"
      }
