       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"24223\" data-output-id=\"14\" data-out-n=\"183\" data-sub-idx=\"11\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"32\" data-sub-start=\"43\" data-sub-end=\"43\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[183]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:8.5em;vertical-align:-3.98em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.52em;\"><span style=\"top:-6.48em;\"><span class=\"pstrut\" style=\"height:6.48em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:8.46em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.98em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.48em;\"><span style=\"top:-6.64em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">σ</span><span class=\"mord\"> (t1 = Σ_i w_{</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">σ</span><span class=\"mord\">(i)} </span><span class=\"mord mathnormal\" style=\"margin-right:0.06366em;\">ν</span><span class=\"mord\">_i)</span></span></span></span><span style=\"top:-5.43em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style