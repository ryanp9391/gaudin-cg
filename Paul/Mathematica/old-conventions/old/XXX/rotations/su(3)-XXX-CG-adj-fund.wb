-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">72</span></span></span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.205787</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.0974781</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">−</span><span class=\"mord\">0.5</span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">}</span></span></span></span></span><span style=\"top:-0.59em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">{</span></span><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">73</span></span></span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">73</span></span></span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">72</span></span></span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.922274</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0.436867</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">−</span><span class=\"mord\">2.24084</span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">}</span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.77em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6.04em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.77em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.71em;\"><span class=\"pstrut\" style=\"height:5.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.92em;\"><span class=\"pstrut\" style=\"height:5.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.13em;\"><span class=\"pstrut\" style=\"height:5.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.34em;\"><span class=\"pstrut\" style=\"height:5.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.54em;\"><span class=\"pstrut\" style=\"height:5.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.77em;\"><span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:7.0772em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[347]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{global object, as a polynomial in X1, X2} & \\mathrm{cc}^2\\,XX1\\,XX2+\\frac{9\\,\\mathrm{cc}\\,XX1}{28}+\\frac{47\\,\\mathrm{cc}\\,XX2}{28}+1\\\\\\hline\\text{one-site factor} & \\mathrm{ccp}\\,XX1+1\\\\\\hline\\text{Paul's product} & \\mathrm{cc}^2\\,\\mathrm{ccp}\\,XX1^2\\,XX2+\\mathrm{cc}^2\\,XX1\\,XX2+\\frac{9}{28}\\,\\mathrm{cc}\\,\\mathrm{ccp}\\,XX1^2+\\frac{47}{28}\\,\\mathrm{cc}\\,\\mathrm{ccp}\\,XX1\\,XX2+\\frac{9\\,\\mathrm{cc}\\,XX1}{28}+\\frac{47\\,\\mathrm{cc}\\,XX2}{28}+\\mathrm{ccp}\\,XX1+1\\\\\\hline\\text{the per-site target <0|g1g2, with (c1,c2) = (c+c', c)} & \\mathrm{cc}\\,XX1\\,XX2\\,\\left(\\mathrm{cc}+\\mathrm{ccp}\\right)+XX1\\,\\left(\\frac{9\\,\\mathrm{cc}}{28}+\\mathrm{ccp}\\right)+\\frac{47\\,\\mathrm{cc}\\,XX2}{28}+1\\\\\\hline\\text{product - target} & \\frac{1}{28}\\,\\mathrm{cc}\\,\\mathrm{ccp}\\,XX1\\,\\left(28\\,\\mathrm{cc}\\,XX1\\,XX2+9\\,XX1+19\\,XX2\\right)\\\\\\hline\\text{corrected object: global + c' X1 (1 + c X2)} & \\mathrm{cc}^2\\,XX1\\,XX2+\\mathrm{cc}\\,\\mathrm{ccp}\\,XX1\\,XX2+\\frac{9\\,\\mathrm{cc}\\,XX1}{28}+\\frac{47\\,\\mathrm{cc}\\,XX2}{28}+\\mathrm{ccp}\\,XX1+1\\\\\\hline\\text{corrected - target} & 0\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{k} & \\text{k'} & \\text{|fit - algebra| o… [latex truncated: 2115 chars total]",
       "mime": "text/plain"
