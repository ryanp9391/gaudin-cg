      {
       "data": "{\n\t\"name\": \"WolframKernelMessage\",\n\t\"message\": \"Power::infy: Infinite expression -------- encountered.                                       -59                                  0. 10\\nInfinity::indet: Indeterminate expression 0. 10    ComplexInfinity encountered.\",\n\t\"stack\": \"\"\n}",
