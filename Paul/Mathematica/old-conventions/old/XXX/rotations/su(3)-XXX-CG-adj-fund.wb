class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">)</span></span></span></span></span><span style=\"top:-1.2em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">(</span></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">6</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">225</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">)</span></span></span></span></span><span style=\"top:0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">(</span></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">225</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">)</span></span></span></span></span><span style=\"top:1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.77em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:12.04em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-5.77em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.11em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.32em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.53em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.74em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.94em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.14em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-13.34em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-14.54em;\"><span class=\"pstrut\" style=\"height:8.27em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.77em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[142]= \\begin{array}{|c|c|}\\hline\\text{chains at z, z': any Baxter solve failed?} & \\left\\{\\mathrm{False},\\mathrm{False}\\right\\}\\\\\\hline\\text{normalised covectors: max |<x|\\_z - <x|\\_\\{z'\\}|} & \\text{0}\\\\\\hline\\text{control: rank\\{c(z), c(z')\\} for 3 single monomials (2 = fails)} & \\left\\{2,2,2\\right\\}\\\\\\hline\\text{class counts (225 minors)} & \\left\\{\\text{z-independent up to scale}\\to 225\\right\\}\\\\\\hline\\text{known scalar-product minor: stab / $\\propto$ $\\Omega$\\^{}L\\_w / c(z')/c(z)} & \\left\\{6,\\mathrm{True},0.755794856798+0.\\times 10^{-12}\\,\\mathrm{i}\\right\\}\\\\\\hline\\text{passing minors: c(z) = c(z') exactly (tally)} & \\begin{pmatrix}\\mathrm{False} & 225\\end{pmatrix}\\\\\\hline\\text{passing minors: stabiliser dims (tally)} & \\begin{pmatrix}6 & 225\\end{pmatrix}\\\\\\hline\\text{passing minors: $\\propto$ $\\Omega$\\^{}L\\_w (tally)} & \\begin{pmatrix}\\mathrm{True} & 225\\end{pmatrix}\\\\\\hline\\text{passing minors: span dim of all <V|} & 1\\\\\\hline\\text{passing minors: distinct scale ratios c(z')/c(z)} & 1\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "357c0adf-3ec9-4a81-b201-03bf7cf66ceb"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Result (80 digits; w = (5/2,7/3,6/35); chains at z = (2,3,1/6) and z' = (3/2,5/4,8/15))\n\n**The criterion discriminates.**\n- The normalised covectors are identical at both twists: $\\langle x|_z=\\langle x|_{z'}$ exactly.\n- A single per-site $Q_1^2Q_2$ monomial gives unrelated $c(z)$ and $c(z')$ (rank 2) for all 3 controls.\n\n**All 225 minors pass**, and they all give the **same** covector.\n- **Twist independence.** $c_x(z')=\\kappa\\,c_x(z)$ with one universal $\\kappa=0.755794856798\\ldots$. This is exactly $(z'^2_1z'_2/z_1^2z_2)^{\\theta_1+\\theta_2}$, a pure convention artefact: the determinant carries full exponentials $z_i^{x/h}$, while $\\Psi(x_0)$ was built with $z_i^{(x-\\theta)/h}$. With a consistent convention, $c_x$ is exactly twist-independent for every minor.\n- **Rotation test.** The line stabiliser has dimension 6 for all 225 minors, so each is a global rotation of $e_{24}$. All are $\\propto\\langle\\Omega^L_w|$, and the span of all 225 $\\langle V|$ is 1-dimensional.\n\n**Conclusion.**\n- With state B fixed to the twist-$w$ vacuum, every admissible 6×6 minor (four $i=1$ rows, two $i=2$ rows, any $\\alpha$, any $j$) is the same functional up to a constant.\n- It is the global rotation to $\\langle\\Omega^L_w|$. This generalises the 36-triple invariance of `SU3_L2_Baxter_Twisted_Final.wb`.\n- **No new rotations come from minors of this matrix.** New ones must change the dual side, the columns or the measure.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 10. Which global rotations are determinants of Q-integrals?\n\nTarget: $\\langle V_{abc}|=\\langle 0|e^{aE_{21}}e^{bE_{31}}e^{cE_{32}}$ (total generators, both sites), up to normalisation. Then $\\langle V_{abc}|\\Psi_A\\rangle=\\sum_x c_x(a,b,c)\\,\\Psi_A(x)/\\Psi_A(x_0)$.\n\n1. **Structure of the target.**\n   - $\\langle 0|E_{ij}\\neq0$ exactly for $i\\ge j$, so $E_{21},E_{31},E_{32}$ parametrise the open cell of the flag orbit.\n   - $\\langle V_{abc}|_{24}=1$, and three components are linear: $a$, $b/2$, $c/2$. So $(a,b,c)$ is read off any rotated covector directly, and substituting back tests that it really is a rotation.\n   - $c_x(a,b,c)$ is computed exactly. For each generator alone, the table lists which SoV coordinates move, as offsets of $(x_{11},x_{21},x_{22})$ per site from $x_0$.\n2. **Existing construction.** The scalar-product determinant against the vacuum dual Q's at unimodular twist $w$ gives $\\langle\\Omega^L_w|$. The table lists $(a,b,c)(w)$ for several $w$. This is a 2-parameter family.\n3. **A third parameter.** Dress every row integrand with $e^{ku}$, which is equivalent to a non-unimodular $w$.\n   - Test that it is still twist-independent up to scale and still a rotation.\n   - Compute the $3\\times3$ Jacobian of $(w_1,w_2,k)\\mapsto(a,b,c)$ with $w_3=1/(w_1w_2)$. If it is non-degenerate, every generic global rotation is (locally) a single $6\\times6$ determinant of this type.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 12. Global rotations <0| e^{aE21} e^{bE31} e^{cE32}: SoV coefficients, map from twist w, e^{ku}-dressed scalar product and its Jacobian. ---- *)\nClearAll[nilExpT, VrotSym, XN, cRotSym, idxA, idxB, idxC, abcOf, rotFit, labelOffset, genTab, wSamples, wTab, rowNk, dressedData, dTab, w0, wOf, del, delk, abc0, jac, aa, bb, cc];\nnilExpT[M_, t_] := Module[{acc = IdentityMatrix[dtot], term = IdentityMatrix[dtot], k = 0},\n   While[k < 30, k++; term = Expand[t term . M/k]; If[Union[Flatten[term]] === {0}, Break[]]; acc += term]; acc];\nVrotSym = Expand[UnitVector[dtot, dtot] . nilExpT[Normal@Etot[2, 1], aa] . nilExpT[Normal@Etot[3, 1], bb] . nilExpT[Normal@Etot[3, 2], cc]];\nidxA = First @ FirstPosition[VrotSym, aa, Missing[], {1}];\nidxB = First @ FirstPosition[VrotSym, bb/2, Missing[], {1}];\nidxC = First @ FirstPosition[VrotSym, cc/2, Missing[], {1}];\nabcOf[t_] := With[{tn = t/t[[dtot]]}, {tn[[idxA]], 2 tn[[idxB]], 2 tn[[idxC]]}];\n(* {(a,b,c), relative residual of <V_abc| against the normalised target}; residual 0 <=> rotation in the open cell *)\nrotFit[t_] := Module[{tn = t/t[[dtot]], abc = abcOf[t]}, {abc, Max[Abs[(VrotSym /. Thread[{aa, bb, cc} -> abc]) - tn]]/Max[Abs[tn]]}];\n\n(* 1. exact SoV coefficients; labels described by root offsets from x0 (units of h) *)\nXN = Table[xNorm[p], {p, patPairs}];\ncRotSym = Expand[VrotSym . Inverse[XN]];\nlabelOffset[p_] := Table[(xRoots[s, p[[s]]] - xRoots[s, x0[[s]]])/h, {s, 2}];\ngenTab = Flatten[Table[With[{c1 = cRotSym /. Thread[DeleteCases[{aa, bb, cc}, var] -> 0]},\n     Table[{var, labelOffset[patPairs[[x]]], Factor[c1[[x]]]}, {x, Flatten @ Position[c1, _?(# =!= 0&), {1}, Heads -> False]}]], {var, {aa, bb, cc}}], 1];\n\n(* 2. twist-w vacuum -> (a,b,c), exact *)\nwSamples = {{5/2, 7/3, 6/35}, {3, 1/2, 2/3}, {2, 3, 1/6}, {3/2, 5/4, 8/15}};\nwTab = Table[With[{fit = rotFit[vacAtTwist[w][\"OmegaL\"]]}, {w, Factor /@ fit[[1]], fit[[2]]}], {w, wSamples}];\n\n(* 3. e^{ku}-dressed scalar product (rows of knownSet), on-shell at z and z' *)\nrowNk[qs_, zz_, qd_, w_, k_, {α_, i_, j_}] := Sum[With[{p = polesSP[[r]]},\n    With[{QD = Function[x, Exp[N[x, wpS] Log[N[zz[[i]], wpS]]] (qs[[i]] /. u -> x)], QU = Function[x, Exp[-N[x, wpS] Log[N[w[[j]], wpS]]] (qd[[j]] /. u -> x)]},\n     wSP[[r]] Exp[N[k p, wpS]] Exp[2 Pi I (α - 1) N[p, wpS]/hX] Flatten @ Table[p^β {-QU[p] QD[p], QU[p] QD[p - hX], QU[p + hX] QD[p]}, {β, 0, 1}]]],\n   {r, Length[polesSP]}];\ndressedData[w_, k_] := dressedData[w, k] = Module[{qd = vacAtTwist[w][\"qd\"], cs, V},\n   cs = Table[With[{ch = chainM[zz]}, LinearSolve[ch[\"P\"], Table[Det[rowNk[s[\"q\"], zz, qd, w, k, #]& /@ knownSet]/psiG[s[\"q\"], zz][x0], {s, ch[\"states\"]}]]], {zz, {zX, zP}}];\n   V = cs[[1]] . chainM[zX][\"xNorm\"];\n   <|\"rankZ\" -> numRank[cs, 10^-40], \"stab\" -> stabDim[V/Max[Abs[V]]], \"fit\" -> rotFit[V]|>];\nw0 = {5/2, 7/3, 6/35};\ndTab = Table[With[{d = dressedData[w0, k]}, {k, d[\"rankZ\"], d[\"stab\"], N[d[\"fit\"][[1]], 12], sci[d[\"fit\"][[2]]]}], {k, {0, 1/2, -1/3, 1}}];\n\n(* Jacobian of (w1, w2, k) -> (a,b,c) at w0, k = 0 *)\nwOf[w1_, w2_] := {w1, w2, 1/(w1 w2)};\ndel = 10^-15; delk = 10^-15;\nabc0 = rotFit[vacAtTwist[w0][\"OmegaL\"]][[1]];\njac = N[Transpose[{\n     (rotFit[vacAtTwist[wOf[w0[[1]] + del, w0[[2]]]][\"OmegaL\"]][[1]] - abc0)/del,\n     (rotFit[vacAtTwist[wOf[w0[[1]], w0[[2]] + del]][\"OmegaL\"]][[1]] - abc0)/del,\n     (dressedData[w0, delk][\"fit\"][[1]] - dressedData[w0, 0][\"fit\"][[1]])/delk}], 30];\n\nColumn[{\n  Grid[Prepend[genTab, {\"generator\", \"SoV label: offsets {site1 (x11,x21,x22), site2 (x11,x21,x22)}\", \"c_x (only this generator on)\"}], Frame -> All, Alignment -> Left],\n  Grid[Prepend[wTab, {\"twist w\", \"(a, b, c) of <Ω^L_w|\", \"rotation fit residual\"}], Frame -> All, Alignment -> Left],\n  Grid[Prepend[dTab, {\"k (e^{ku} in all rows), w = w0\", \"rank{c(z), c(z')} (1 = twist-independent up to scale)\", \"stabiliser dim\", \"(a, b, c)\", \"rotation fit residual\"}], Frame -> All, Alignment -> Left],\n  Grid[{{\"Jacobian d(a,b,c)/d(w1,w2,k) at w0, k=0\", MatrixForm[N[jac, 8]]}, {\"det\", N[Det[jac], 8]}, {\"singular values\", N[SingularValueList[jac, Tolerance -> 0], 6]}}, Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
