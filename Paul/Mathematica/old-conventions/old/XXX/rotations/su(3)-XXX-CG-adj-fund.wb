      {
       "data": "Out[264]= \\begin{matrix}\\begin{array}{|c|c|c|}\\hline\\text{generator (site-1-local)} & \\text{SoV label offsets \\{site1, site2\\}} & \\text{c\\_x with only that generator on}\\\\\\hline\\mathrm{aa} & \\begin{pmatrix}0 & 1 & 0\\\\0 & 0 & 0\\end{pmatrix} & -\\frac{20\\,\\mathrm{aa}}{9}\\\\\\hline\\mathrm{aa} & \\begin{pmatrix}1 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix} & -\\frac{9\\,\\mathrm{aa}}{28}\\\\\\hline\\mathrm{aa} & \\begin{pmatrix}0 & 0 & 0\\\\1 & 0 & 0\\end{pmatrix} & \\frac{893\\,\\mathrm{aa}}{252}\\\\\\hline\\mathrm{aa} & \\begin{pmatrix}0 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix} & 1\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 2 & 1\\\\0 & 0 & 0\\end{pmatrix} & \\frac{5\\,\\mathrm{bb}^2}{7}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 1 & 1\\\\1 & 0 & 0\\end{pmatrix} & \\frac{95\\,\\mathrm{bb}^2}{63}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 1 & 0\\\\0 & 0 & 0\\end{pmatrix} & -\\frac{10\\,\\mathrm{bb}}{9}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}0 & 1 & 1\\\\0 & 0 & 0\\end{pmatrix} & \\frac{10\\,\\mathrm{bb}}{3}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 0 & 0\\\\1 & 0 & 0\\end{pmatrix} & \\frac{19\\,\\mathrm{bb}}{9}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}0 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix} & 1\\\\\\hline\\mathrm{cc} & \\begin{pmatrix}1 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix} & \\mathrm{cc}\\\\\\hline\\mathrm… [latex truncated: 2711 chars total]",
