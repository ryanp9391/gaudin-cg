      {
       "data": "Out[336]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{k} & \\text{k'} & \\text{c (global)} & \\text{c' (local)} & \\text{6-monomial fit residual} & \\text{coefficients of \\{1, X1, X2, X1X2, X1\\^{}2, X1\\^{}2X2\\}}\\\\\\hline0 & 0 & -1.\\, & -0.5 & \\text{0.}\\times 10^{\\text{-72}} & \\left\\{1.\\,,-0.82143,-1.6786,1.8393,0.16071,-0.5\\right\\}\\\\\\hline0 & \\frac{1}{2} & -1.\\, & -0.824361 & \\text{0.}\\times 10^{\\text{-72}} & \\left\\{1.\\,,-1.1458,-1.6786,2.3837,0.26497,-0.82436\\right\\}\\\\\\hline\\frac{1}{2} & -1 & -1.64872 & -0.183940 & \\text{0.}\\times 10^{\\text{-71}} & \\left\\{1.\\,,-0.71389,-2.7675,3.2273,0.097478,-0.5\\right\\}\\\\\\hline\\frac{1}{2} & \\frac{1}{2} & -1.64872 & -0.824361 & \\text{0.}\\times 10^{\\text{-71}} & \\left\\{1.\\,,-1.3543,-2.7675,4.9997,0.43687,-2.2408\\right\\}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{k} & \\text{k'} & \\text{rank\\{c(z),c(z')\\} (1 = SoV expansion)} & \\text{\\#SoV labels used} & \\text{stab dim} & \\text{sigma2/sigma1} & \\text{spread of D\\_A / <0|g1g2|Psi\\_A> over the 24 states} & \\text{deviation after the best constant}\\\\\\hline0 & 0 & 2 & 14 & 1 & \\text{6.49}\\times 10^{\\text{-2}} & \\text{1.00} & \\text{4.26}\\\\\\hline0 & \\frac{1}{2} & 2 & 14 & 1 & \\text{1.14}\\tim… [latex truncated: 1568 chars total]",
