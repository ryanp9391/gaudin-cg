       "data": "Out[165]= \\begin{matrix}\\begin{array}{|c|c|c|}\\hline\\text{generator} & \\text{SoV label: offsets \\{site1 (x11,x21,x22), site2 (x11,x21,x22)\\}} & \\text{c\\_x (only this generator on)}\\\\\\hline\\mathrm{aa} & \\begin{pmatrix}0 & 1 & 0\\\\0 & 0 & 0\\end{pmatrix} & -\\frac{20\\,\\mathrm{aa}}{9}\\\\\\hline\\mathrm{aa} & \\begin{pmatrix}1 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix} & -\\frac{9\\,\\mathrm{aa}}{28}\\\\\\hline\\mathrm{aa} & \\begin{pmatrix}0 & 0 & 0\\\\1 & 0 & 0\\end{pmatrix} & \\frac{893\\,\\mathrm{aa}}{252}\\\\\\hline\\mathrm{aa} & \\begin{pmatrix}0 & 0 & 0\\\\0 & 0 & 0\\end{pmatrix} & 1\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 2 & 1\\\\1 & 1 & 0\\end{pmatrix} & \\frac{20\\,\\mathrm{bb}^3}{9}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 2 & 1\\\\0 & 0 & 0\\end{pmatrix} & \\frac{261\\,\\mathrm{bb}^2}{392}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 2 & 0\\\\1 & 0 & 0\\end{pmatrix} & -\\frac{19\\,\\mathrm{bb}^2}{28}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 1 & 1\\\\1 & 0 & 0\\end{pmatrix} & -\\frac{5833\\,\\mathrm{bb}^2}{882}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 1 & 0\\\\1 & 1 & 0\\end{pmatrix} & \\frac{47\\,\\mathrm{bb}^2}{28}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}1 & 1 & 0\\\\0 & 0 & 0\\end{pmatrix} & -\\frac{5\\,\\mathrm{bb}}{14}\\\\\\hline\\mathrm{bb} & \\begin{pmatrix}0 & 1 & 1\\… [latex truncated: 4161 chars total]",
