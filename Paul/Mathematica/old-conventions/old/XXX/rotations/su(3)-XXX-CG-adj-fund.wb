      {
       "data": "Out[209]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{four labels (x11 offsets)} & \\begin{pmatrix}24 & 23\\\\21 & 20\\end{pmatrix}\\\\\\hline\\text{E32 rotation pattern} & \\begin{pmatrix}1 & \\frac{47\\,\\mathrm{cc}}{28}\\\\\\frac{9\\,\\mathrm{cc}}{28} & \\mathrm{cc}^2\\end{pmatrix}\\\\\\hline\\text{columns \\{1,u\\}, k=0: coefficient matrix (normalised)} & \\begin{pmatrix}1.\\, & -3.1111111\\\\1.1111111 & 1.\\,\\end{pmatrix}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{k} & \\text{solved c0} & \\text{rank\\{c(z),c(z')\\}} & \\text{stabiliser dim} & \\text{(a,b,c)} & \\text{rotation residual}\\\\\\hline0 & 0.7497448980-0.6617269739\\,\\mathrm{i} & 1 & 6 & \\left\\{2.5930775\\times 10^{-95}+5.7874484\\times 10^{-95}\\,\\mathrm{i},-3.9370443\\times 10^{-94}-6.3099784\\times 10^{-94}\\,\\mathrm{i},0.74974490-0.66172697\\,\\mathrm{i}\\right\\} & \\text{1.58}\\times 10^{\\text{-93}}\\\\\\hline\\frac{1}{2} & 1.236120361-1.091003337\\,\\mathrm{i} & 1 & 6 & \\left\\{-5.0403746\\times 10^{-95}+1.3043717\\times 10^{-94}\\,\\mathrm{i},-6.8547597\\times 10^{-94}-1.8367583\\times 10^{-93}\\,\\mathrm{i},1.2361204-1.0910033\\,\\mathrm{i}\\right\\} & \\text{4.22}\\times 10^{\\text{-93}}\\\\\\hline-1 & 0.2758157341-0.2434357494\\,\\mathrm{i} & 1 & 6 & \\left\\{7.2713161\\times 1… [latex truncated: 1414 chars total]",
