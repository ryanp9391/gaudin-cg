  {
   "kind": 2,
   "value": "(* ---- 16. When is the 2x2 two-site bracket determinant a rotation? Pattern matching in the four x11 labels. ---- *)\nClearAll[fourLabels, rotPattern, twoCoef, gSol, gFun, twoDetG, tunedData, tunedTab, γ2, δ2, c0];\n(* the four labels that this object can move, and the exact E32-rotation pattern on them *)\nfourLabels = Table[SelectFirst[Range[dtot], labelOffset[patPairs[[#]]] == {{o1, 0, 0}, {o2, 0, 0}}&], {o1, {0, 1}}, {o2, {0, 1}}];\nrotPattern[cval_] := Table[(cRotSym[[fourLabels[[i, j]]]] /. {aa -> 0, bb -> 0, cc -> cval}), {i, 2}, {j, 2}];\n(* coefficients produced by columns {1, g}: c(i,j) = w1(p_i) w2(p'_j) e^{k(p_i+p'_j)} (g(p'_j) - g(p_i)) *)\ntwoCoef[k_, gv_] := Table[wTwo[[1, i]] wTwo[[2, j]] Exp[k (polesTwo[[1, i]] + polesTwo[[2, j]])] (gv[[2, j]] - gv[[1, i]]), {i, 2}, {j, 2}];\n(* fix the affine freedom g -> alpha g + beta by g(p11) = 0, g(p21) = 1; solve for the rest *)\ngSol[k_] := gSol[k] = Module[{gv = {{0, γ2}, {1, δ2}}, cm, eqs},\n   cm = twoCoef[k, gv];\n   eqs = Thread[Flatten[cm/cm[[1, 1]]] == Flatten[rotPattern[c0]/rotPattern[c0][[1, 1]]]];\n   Solve[eqs, {γ2, δ2, c0}]];\ngFun[k_, sol_] := Module[{gv = {{0, γ2}, {1, δ2}} /. sol, pts},\n   pts = Flatten[Table[{polesTwo[[s, r]], gv[[s, r]]}, {s, 2}, {r, 2}], 1];\n   InterpolatingPolynomial[pts, u]];\n(* determinant with columns {1, g(u)}, per-site shift h*lambda2 *)\ntwoDetG[qs_, zz_, k_, g_] := Module[{QD = Function[x, Exp[N[x, wpS] Log[N[zz[[1]], wpS]]] (qs[[1]] /. u -> x)], sh = {hX, 0}},\n   Det[Table[brTwo[Function[p, Exp[N[k p, wpS]] (If[col == 1, 1, g /. u -> p]) QD[p + sh[[s]]]], s], {s, 2}, {col, 2}]]\n    /(QD[(θ1 /. prmX) + hX] QD[(θ2 /. prmX)])];\ntunedData[k_] := Module[{sols = gSol[k], sol, g, cs, V, Vn, f},\n   sol = SelectFirst[sols, (c0 /. #) =!= 0&, Missing[]];\n   If[MissingQ[sol], Return[<|\"k\" -> k, \"noSol\" -> True|>]];\n   g = gFun[k, sol];\n   cs = Table[With[{ch = chainM[zz]}, LinearSolve[ch[\"P\"], Table[twoDetG[st[\"q\"], zz, k, g], {st, ch[\"states\"]}]]], {zz, {zX, zP}}];\n   V = cs[[1]] . chainM[zX][\"xNorm\"]; Vn = V/V[[First @ Ordering[-Abs[V], 1]]]; f = fitCell[Vn];\n   <|\"k\" -> k, \"c0\" -> (c0 /. sol), \"g\" -> Expand[g], \"rankZ\" -> numRank[cs, 10^-40], \"stab\" -> stabDim[Vn],\n     \"cell\" -> Lookup[f, \"cell\", \"-\"], \"abc\" -> Lookup[f, \"abc\", {}], \"res\" -> f[\"res\"]|>];\ntunedTab = tunedData /@ {0, 1/2, -1};\nColumn[{\n  Grid[{{\"four labels (x11 offsets)\", MatrixForm[fourLabels]}, {\"E32 rotation pattern\", MatrixForm[rotPattern[cc]]},\n     {\"columns {1,u}, k=0: coefficient matrix (normalised)\", MatrixForm[N[twoCoef[0, {polesTwo[[1]], polesTwo[[2]]}]/twoCoef[0, {polesTwo[[1]], polesTwo[[2]]}][[1, 1]], 8]]}}, Frame -> All, Alignment -> Left],\n  Grid[Prepend[Table[If[KeyExistsQ[d, \"noSol\"], {d[\"k\"], \"no solution\", \"-\", \"-\", \"-\", \"-\"},\n      {d[\"k\"], N[d[\"c0\"], 10], d[\"rankZ\"], d[\"stab\"], N[d[\"abc\"], 8], sci[Abs[d[\"res\"]]]}], {d, tunedTab}],\n    {\"k\", \"solved c0\", \"rank{c(z),c(z')}\", \"stabiliser dim\", \"(a,b,c)\", \"rotation residual\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
