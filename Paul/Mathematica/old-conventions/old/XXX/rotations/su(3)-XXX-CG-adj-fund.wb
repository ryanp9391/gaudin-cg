      {
       "data": "Out[38]= \\begin{array}{|c|c|}\\hline\\text{charpoly G} & -\\chi3+zz\\$3014^3-\\chi1\\,zz\\$3014^2+\\chi2\\,zz\\$3014\\\\\\hline\\text{Cauchy-Binet = direct T$\\cdot$G minors (|I|=1,2,3, all I,J)} & \\mathrm{True}\\\\\\hline\\text{deg\\_u $\\tau$\\_1, $\\tau$\\_2, $\\tau$\\_3} & \\left\\{2,4,6\\right\\}\\\\\\hline\\text{$\\tau$\\_1 leading = $\\chi$1 Id} & \\mathrm{True}\\\\\\hline\\text{$\\tau$\\_2 leading = $\\chi$2 Id} & \\mathrm{True}\\\\\\hline\\text{$\\tau$\\_3 = $\\chi$3 $\\nu$1(u-2h)$\\nu$2(u-h)$\\nu$3(u) Id} & \\mathrm{True}\\\\\\hline\\end{array}",
