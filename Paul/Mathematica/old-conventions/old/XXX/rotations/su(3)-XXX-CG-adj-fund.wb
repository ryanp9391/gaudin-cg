      {
       "data": "Out[72]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{state} & \\text{deg q\\_1,q\\_2,q\\_3} & \\text{$\\tau$ eig. residual} & \\text{|<0|$\\Psi$>|/max} & \\text{max rel. dev. over 24 x}\\\\\\hline1 & \\left\\{1,1,3\\right\\} & \\text{0.}\\times 10^{\\text{-77}} & \\text{3.51}\\times 10^{\\text{-4}} & \\text{0.}\\times 10^{\\text{-75}}\\\\\\hline2 & \\left\\{3,1,1\\right\\} & \\text{0.}\\times 10^{\\text{-77}} & \\text{3.53}\\times 10^{\\text{-3}} & \\text{0.}\\times 10^{\\text{-74}}\\\\\\hline3 & \\left\\{2,2,1\\right\\} & \\text{0.}\\times 10^{\\text{-77}} & \\text{6.42}\\times 10^{\\text{-3}} & \\text{0.}\\times 10^{\\text{-73}}\\\\\\hline4 & \\left\\{1,3,1\\right\\} & \\text{0.}\\times 10^{\\text{-77}} & \\text{1.12}\\times 10^{\\text{-2}} & \\text{0.}\\times 10^{\\text{-74}}\\\\\\hline5 & \\left\\{2,1,2\\right\\} & \\text{0.}\\times 10^{\\text{-77}} & \\text{1.34}\\times 10^{\\text{-3}} & \\text{0.}\\times 10^{\\text{-74}}\\\\\\hline6 & \\left\\{1,2,2\\right\\} & \\text{0.}\\times 10^{\\text{-77}} & \\text{2.84}\\times 10^{\\text{-3}} & \\text{0.}\\times 10^{\\text{-74}}\\\\\\hline7 & \\left\\{0,2,3\\right\\} & \\text{0.}\\times 10^{\\text{-77}} & \\text{1.74}\\times 10^{\\text{-3}} & \\text{0.}\\times 10^{\\text{-76}}\\\\\\hline8 & \\left\\{1,1,3\\right\\} & \\text{0.}\\times 10^{\\text{-77}} & \\text{7.72}\\times 10^{\\te… [latex truncated: 3435 chars total]",
       "mime": "text/plain"
