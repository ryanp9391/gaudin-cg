  {
   "kind": 2,
   "value": "(* ---- 1. Site generators on the 24-dim space; gl(3) relations checked per site and for the total. ---- *)\nClearAll[λ1, λ2, d1, d2, dtot, E1g, E2g, Etot, glRelQ];\nλ1 = {2, 1, 0};\nλ2 = {1, 0, 0};\nd1 = dim[λ1];\nd2 = dim[λ2];\ndtot = d1 d2;\nE1g[i_, j_] := E1g[i, j] = SparseArray @ KroneckerProduct[JJ[i, j, λ1], IdentityMatrix[d2]];\nE2g[i_, j_] := E2g[i, j] = SparseArray @ KroneckerProduct[IdentityMatrix[d1], JJ[i, j, λ2]];\nEtot[i_, j_] := E1g[i, j] + E2g[i, j];\n(* [E_ij, E_kl] = δ_jk E_il − δ_il E_kj *)\nglRelQ[E_] :=\n    And\n    @@ Flatten\n    @ Table[\n        Normal[E[i, j].E[k, l] - E[k, l].E[i, j] - KroneckerDelta[j, k] E[i, l] + KroneckerDelta[i, l] E[k, j]] === ConstantArray[0, {dtot, dtot}],\n        {i, 3},\n        {j, 3},\n        {k, 3},\n        {l, 3}\n    ];\nGrid[\n    {\n        {\"dims (site1, site2, total)\", {d1, d2, dtot}},\n        {\"gl(3) relations site 1\", glRelQ[E1g]},\n        {\"gl(3) relations site 2\", glRelQ[E2g]},\n        {\"gl(3) relations total\", glRelQ[Etot]},\n        {\n            \"Casimir Σ E_ii site1, site2\",\n            {Normal[Sum[E1g[i, i], {i, 3}]] === Total[λ1] IdentityMatrix[dtot], Normal[Sum[E2g[i, i], {i, 3}]] === Total[λ2] IdentityMatrix[dtot]}\n        }\n    },\n    Frame → All,\n    Alignment → Left\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"24223\" data-output-id=\"1\" data-out-n=\"19\" data-sub-idx=\"12\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"2\" data-sub-start=\"21\" data-sub-end=\"34\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[19]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:6.04em;vertical-align:-2.75em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.29em;\"><span style=\"top:-5.25em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.25em;\"><span style=\"top:-5.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">dims (site1, site2, total)</span></span></span></span><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">gl(3) relations site 1</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">gl(3) relations site 2</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">gl(3) relations total</span></span></span></span><span style=\"top:-0.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">Casimir Σ E_ii site1, site2</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.25em;\"><span style=\"top:-5.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">8</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">24</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-0.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[19]= \\begin{array}{|c|c|}\\hline\\text{dims (site1, site2, total)} & \\left\\{8,3,24\\right\\}\\\\\\hline\\text{gl(3) relations site 1} & \\mathrm{True}\\\\\\hline\\text{gl(3) relations site 2} & \\mathrm{True}\\\\\\hline\\text{gl(3) relations total} & \\mathrm{True}\\\\\\hline\\text{Casimir $\\Sigma$ E\\_ii site1, site2} & \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\\\\\hline\\end{array}",
