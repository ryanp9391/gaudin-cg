      {
       "data": "Out[174]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|}\\hline\\text{twist w} & \\text{(a,b,c)} & \\text{(a,b,c) - (-w1w2, w1, -w1(w2+w3))} & \\text{rotation residual} & \\text{b - a(c-a)}\\\\\\hline\\left\\{\\frac{5}{2},\\frac{7}{3},\\frac{6}{35}\\right\\} & \\left\\{-\\frac{35}{6},\\frac{5}{2},-\\frac{263}{42}\\right\\} & \\left\\{0,0,0\\right\\} & 0 & 0\\\\\\hline\\left\\{3,\\frac{1}{2},\\frac{2}{3}\\right\\} & \\left\\{-\\frac{3}{2},3,-\\frac{7}{2}\\right\\} & \\left\\{0,0,0\\right\\} & 0 & 0\\\\\\hline\\left\\{2,3,\\frac{1}{6}\\right\\} & \\left\\{-6,2,-\\frac{19}{3}\\right\\} & \\left\\{0,0,0\\right\\} & 0 & 0\\\\\\hline\\left\\{\\frac{3}{2},\\frac{5}{4},\\frac{8}{15}\\right\\} & \\left\\{-\\frac{15}{8},\\frac{3}{2},-\\frac{107}{40}\\right\\} & \\left\\{0,0,0\\right\\} & 0 & 0\\\\\\hline\\left\\{\\frac{7}{2},\\frac{2}{7},1\\right\\} & \\left\\{-1,\\frac{7}{2},-\\frac{9}{2}\\right\\} & \\left\\{0,0,0\\right\\} & 0 & 0\\\\\\hline\\left\\{5,\\frac{2}{5},\\frac{1}{2}\\right\\} & \\left\\{-2,5,-\\frac{9}{2}\\right\\} & \\left\\{0,0,0\\right\\} & 0 & 0\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|}\\hline\\text{target (a, b, a+b/a) on the surface} & \\text{w = (b, -a/b, -1/a)} & \\text{w1 w2 w3} & \\text{(a,b,c) of <$\\Omega$\\^{}L\\_w| minus target}\\\\\\hline\\left\\{-2,5,-\\frac{9}{2}\\right\\} & \\left\\{5,\\frac{2}{5},\\frac{1}{2}\\… [latex truncated: 2094 chars total]",
