      },
      {
       "data": "Out[251]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{support of the per-site rotation covector} & \\left\\{20,21,23,24\\right\\}\\\\\\hline\\text{is it inside the four x11 labels?} & \\mathrm{True}\\\\\\hline\\text{per-site pattern on the four x11 labels} & \\begin{pmatrix}1 & \\frac{47\\,cc2}{28}\\\\cc1-\\frac{19\\,cc2}{28} & cc1\\,cc2\\end{pmatrix}\\\\\\hline\\text{det of that pattern (rank-one condition = 0)} & -\\frac{19}{784}\\,cc2\\,\\left(28\\,cc1-47\\,cc2\\right)\\\\\\hline\\text{rank-one locus: \\{r1, r2, c2\\} in terms of c1} & \\left\\{\\left\\{rr1\\to cc1,rr2\\to 0,cc2\\to 0\\right\\},\\left\\{rr1\\to \\frac{28\\,cc1}{47},rr2\\to cc1,cc2\\to \\frac{28\\,cc1}{47}\\right\\}\\right\\}\\\\\\hline\\text{(t-2h)/(t-h), (t-h)/(t-2h)} & \\left\\{\\frac{47}{28},\\frac{28}{47}\\right\\}\\\\\\hline\\text{natural residue ratios \\{r1, r2\\} of 1/(nu1 nu2)} & \\left\\{-\\frac{9}{47},-\\frac{47}{9}\\right\\}\\\\\\hline\\text{k2 - k1 on the locus, = log[(t-2h)/(t-h)]/h} & \\left\\{\\log\\left(\\frac{47}{28}\\right),0.517943091535\\right\\}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{case} & \\text{\\{r1, r2\\}} & \\text{rank\\{c(z),c(z')\\}} & \\text{stab dim} & \\text{sigma2/sigma1 (8x3)} & \\text{verdict} & \\text{global rotation residual}\\\\\\hline\\text{site 1 only (r2 = 0)} &… [latex truncated: 3099 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "f15b7ef9-3a1b-4442-80e8-9822b179ed6a"
    }
