       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"24223\" data-output-id=\"10\" data-out-n=\"128\" data-sub-idx=\"16\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"22\" data-sub-start=\"34\" data-sub-end=\"44\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[128]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:10.2017em;vertical-align:-4.8509em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.3509em;\"><span style=\"top:-8.33em;\"><span class=\"pstrut\" style=\"height:5.31em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.3309em;\"><span style=\"top:-4.2909em;\"><span class=\"pstrut\" style=\"height:4.2909em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:4.0817em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.7909em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.2909em;\"><span style=\"top:-4.2909em;\"><span class=\"pstrut\" style=\"height:3.1617em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">formal bracket (abstract qq)</span></span></span></span><span style=\"top:-2.9308em;\"><span class=\"pstrut\" style=\"height:3.1617em;\"></span><span class=\"mord\"><span class=\"mord 