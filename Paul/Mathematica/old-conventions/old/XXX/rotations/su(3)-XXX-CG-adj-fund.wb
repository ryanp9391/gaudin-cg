      {
       "data": "Out[115]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{twist w} & \\text{vacuum null dims (R,L)} & \\text{\\#monomials (det, det∪$\\Psi$)} & \\text{formal fit over 24 $\\Psi$(x): rel. residual} & \\text{weight of det in $\\Psi$-type monomials} & \\text{on-shell <V|R\\_A> = D\\_A residual} & \\text{$\\sigma$₂/$\\sigma$₁ of V as 8$\\times$3} & \\text{line-stabiliser dim of <V| (6 $\\Leftrightarrow$ rotation of e\\_24)} & \\text{rank\\{V, $\\Omega$\\^{}L\\_w\\}} & \\text{rank\\{V, L\\_vac(z)\\}} & \\text{rank\\{V, e\\_24\\}}\\\\\\hline\\left\\{\\frac{5}{2},\\frac{7}{3},\\frac{6}{35}\\right\\} & \\left\\{1,1\\right\\} & \\left\\{242,242\\right\\} & \\text{1.00} & \\text{3.03}\\times 10^{\\text{-2}} & \\text{0.}\\times 10^{\\text{-60}} & \\text{4.25}\\times 10^{\\text{-68}} & 6 & 1 & 2 & 2\\\\\\hline\\left\\{2,3,\\frac{1}{6}\\right\\} & \\left\\{1,1\\right\\} & \\left\\{242,242\\right\\} & \\text{1.00} & \\text{2.72}\\times 10^{\\text{-2}} & \\text{0.}\\times 10^{\\text{-60}} & \\text{4.40}\\times 10^{\\text{-78}} & 6 & 1 & 1 & 2\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "2631bbad-e889-48bf-8f6b-c56311d22fbc"
