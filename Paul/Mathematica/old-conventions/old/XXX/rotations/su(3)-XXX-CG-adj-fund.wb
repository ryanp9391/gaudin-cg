r-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.7576em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.2576em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.71em;\"><span class=\"pstrut\" style=\"height:5.2576em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.91em;\"><span class=\"pstrut\" style=\"height:5.2576em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1151em;\"><span class=\"pstrut\" style=\"height:5.2576em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3151em;\"><span class=\"pstrut\" style=\"height:5.2576em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5151em;\"><span class=\"pstrut\" style=\"height:5.2576em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.7576em;\"><span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.4276em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[225]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{$\\nu$1 zeros} & \\left\\{\\frac{7}{3},\\frac{49}{57}\\right\\}\\\\\\hline\\text{$\\nu$2 zeros} & \\left\\{\\frac{4}{3},-\\frac{8}{57}\\right\\}\\\\\\hline\\text{site-1 contour poles} & \\left\\{\\frac{4}{3},\\frac{7}{3}\\right\\}\\\\\\hline\\text{site-2 contour poles} & \\left\\{-\\frac{8}{57},\\frac{49}{57}\\right\\}\\\\\\hline\\text{residue ratios \\{b1/a1, b2/a2\\} at k = 0} & \\left\\{-\\frac{9}{47},-\\frac{47}{9}\\right\\}\\\\\\hline\\text{section-13 prediction with c = -1} & \\left\\{-\\frac{9}{47},-\\frac{47}{9}\\right\\}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{k} & \\text{rank\\{c(z),c(z')\\}} & \\text{stabiliser dim} & \\text{(a,b,c) achieved} & \\text{predicted c = -e\\^{}\\{kh\\}} & \\text{rotation residual}\\\\\\hline0 & 1 & 6 & \\left\\{0,0,-1.\\,\\right\\} & -1.\\, & \\text{7.25}\\times 10^{\\text{-95}}\\\\\\hline\\frac{1}{2} & 1 & 6 & \\left\\{0,0,-1.648721271\\right\\} & -1.648721271 & \\text{1.79}\\times 10^{\\text{-94}}\\\\\\hline-1 & 1 & 6 & \\left\\{0,0,-0.3678794412\\right\\} & -0.3678794412 & \\text{8.65}\\times 10^{\\text{-96}}\\\\\\hline\\mathrm{i}\\,\\pi  & 1 & 6 & \\left\\{0,0,1.\\,+0.\\times 10^{-10}\\,\\mathrm{i}\\right\\} & 1.\\, & \\text{8.05}\\times 10^{\\text{-94}}\\\\\\hline\\end{array}\\end{matrix}",
       "mime": "text/plain"
      }
     ],
     "id": "4413227e-5c22-4a34-8bb7-9d524af24ce3"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Result: plain residues of $e^{ku}/(\\nu_1\\nu_2)$ do it\n\nThe residue ratios of $1/(\\nu_1\\nu_2)$ are exactly the section-13 weights at $c=-1$:\n$$\\Big\\{\\frac{b_1}{a_1},\\frac{b_2}{a_2}\\Big\\}_{\\rm residues}=\\Big\\{-\\frac{9}{47},\\,-\\frac{47}{9}\\Big\\}=\\Big\\{-\\frac{t}{t-2h},\\,-\\frac{t-2h}{t}\\Big\\}.$$\n\nWith $\\langle f\\rangle_s=\\oint_{C_s}\\frac{du}{2\\pi i}\\frac{e^{ku}f(u)}{\\nu_1(u)\\nu_2(u)}$ (80 digits, all twist-independent, all in the big cell):\n\n| $k$ | stabiliser | $(a,b,c)$ | $-e^{kh}$ | residual |\n|---|---|---|---|---|\n| $0$ | **6** | $(0,0,-1)$ | $-1$ | $7\\times10^{-95}$ |\n| $1/2$ | **6** | $(0,0,-1.64872)$ | $-1.64872$ | $2\\times10^{-94}$ |\n| $-1$ | **6** | $(0,0,-0.36788)$ | $-0.36788$ | $9\\times10^{-96}$ |\n| $i\\pi/h$ | **6** | $(0,0,1)$ | $1$ | $8\\times10^{-94}$ |\n\nSo the whole one-parameter family of global $E_{32}$ rotations is\n$$\\frac{\\langle 0|e^{cE_{32}}|\\Psi_A\\rangle}{\\langle 0|\\Psi_A\\rangle}\\;\\propto\\;\\det_{2\\times2}\\Big[\\oint_{C_s}\\frac{du}{2\\pi i}\\frac{e^{ku}u^{\\,{\\rm col}-1}q_1(u)}{\\nu_1(u)\\nu_2(u)}\\Big]\\Big/\\big(q_1(\\theta_1+h)q_1(\\theta_2)\\big),\\qquad c=-e^{kh},$$\nwith $C_1$ around $\\{\\theta_1+h,\\theta_1+2h\\}$ and $C_2$ around $\\{\\theta_2,\\theta_2+h\\}$. No free weights are needed: the measure supplies them.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 15. The $2\\times2$ object is a minor of the scalar product with one pole cancelled\n\nTwo identifications:\n\n1. **Measure.** The scalar-product ladder measure has the five poles $\\theta_1+\\{0,h,2h\\},\\ \\theta_2+\\{0,h\\}$. Inserting the polynomial factor $(u-\\theta_1)$ — the site-1 half of $\\nu_3$, since $\\nu_3(u)/(u-\\theta_2)=u-\\theta_1$ — cancels the pole at $\\theta_1$ and leaves exactly $1/(\\nu_1\\nu_2)$, the measure of section 14.\n2. **Rows.** The per-site contours need not be introduced by hand: the rows $\\alpha=1,2$ are *full* contours with ladder weights $(1,1)$ and $(e^{2\\pi i\\theta_1/h},e^{2\\pi i\\theta_2/h})$, and that $2\\times2$ matrix is invertible for $\\theta_1-\\theta_2\\notin h\\mathbb Z$. So $\\mathrm{span}\\{\\text{row}_{\\alpha=1},\\text{row}_{\\alpha=2}\\}=\\mathrm{span}\\{\\text{row}_{\\rm site\\,1},\\text{row}_{\\rm site\\,2}\\}$ and the two determinants agree up to the constant $e^{2\\pi i\\theta_2/h}-e^{2\\pi i\\theta_1/h}$.\n3. **Dual index.** For the twist-$w$ vacuum $q^3$ has degree 0, so $Q^3(u)=w_3^{-u/h}$ is itself an $e^{ku}$ insertion with $k=-\\log w_3/h$.\n\nSo the object should be the minor of the scalar-product matrix on rows $\\{(\\alpha,i,j)=(1,1,3),(2,1,3)\\}$ and columns $\\{(r{=}1,\\beta{=}0),(r{=}1,\\beta{=}1)\\}$ — i.e. only the first column type $-Q^jQ_i$ — with the measure dressed by $(u-\\theta_1)$. The cell checks this against section 14.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 19. Minor of the scalar product with the (u-θ1) insertion = the two-site bracket determinant. ---- *)\nClearAll[ladderPoles, ladderW, rowMinor, detMinor, minorRun, minorTab, spanChk];\nladderPoles = polesSP;   (* θ1+{0,h,2h}, θ2+{0,h} *)\nladderW = wSP;\n(* row (α): full contour over the 5 ladder poles, integrand (u-θ1) e^{ku} u^{β} q1(u); the (u-θ1) factor kills the θ1 pole *)\nrowMinor[qs_, zz_, k_, α_] := Sum[With[{p = ladderPoles[[r]]},\n    ladderW[[r]] (p - (θ1 /. prmX)) Exp[N[k p, wpS]] Exp[2 Pi I (α - 1) N[p, wpS]/hX]\n     Table[p^β Exp[N[p, wpS] Log[N[zz[[1]], wpS]]] (qs[[1]] /. u -> p), {β, 0, 1}]], {r, Length[ladderPoles]}];\ndetMinor[qs_, zz_, k_] := Module[{QD = Function[x, Exp[N[x, wpS] Log[N[zz[[1]], wpS]]] (qs[[1]] /. u -> x)]},\n   Det[Table[rowMinor[qs, zz, k, α], {α, 2}]]/(QD[nu12Poles[[1, 1]]] QD[nu12Poles[[2, 1]]])];\nminorRun[k_] := Module[{cs, V, Vn, f},\n   cs = Table[With[{ch = chainM[zz]}, LinearSolve[ch[\"P\"], Table[detMinor[stt[\"q\"], zz, k], {stt, ch[\"states\"]}]]], {zz, {zX, zP}}];\n   V = cs[[1]] . chainM[zX][\"xNorm\"]; Vn = V/V[[First @ Ordering[-Abs[V], 1]]]; f = fitCell[Vn];\n   {k, numRank[cs, 10^-40], stabDim[Vn], Chop[N[Lookup[f, \"abc\", {}], 10], 10^-30], N[-Exp[k hX], 10], sci[Abs[f[\"res\"]]]}];\nminorTab = minorRun /@ {0, 1/2, I Pi/hX};\n(* ratio of the two determinants: should be the constant e^{2πiθ2/h} - e^{2πiθ1/h}, state-independent *)\nspanChk = With[{ch = chainM[zX]},\n   With[{rt = Table[detMinor[stt[\"q\"], zX, 0]/detCont[stt[\"q\"], zX, 0], {stt, ch[\"states\"]}]},\n    {N[rt[[1]], 12], N[Max[Abs[rt/rt[[1]] - 1]], 3], N[Exp[2 Pi I (θ2 /. prmX)/hX] - Exp[2 Pi I (θ1 /. prmX)/hX], 12]}]];\nColumn[{\n  Grid[Prepend[minorTab, {\"k\", \"rank{c(z),c(z')}\", \"stabiliser dim\", \"(a,b,c) achieved\", \"predicted -e^{kh}\", \"rotation residual\"}], Frame -> All, Alignment -> Left],\n  Grid[{{\"det(minor)/det(section 14), first state\", spanChk[[1]]}, {\"state-independence of that ratio\", sci[spanChk[[2]]]},\n     {\"predicted constant e^{2πiθ2/h} - e^{2πiθ1/h}\", spanChk[[3]]}}, Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"24223\" data-output-id=\"18\" data-out-n=\"234\" data-sub-idx=\"11\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"45\" data-sub-start=\"19\" data-sub-end=\"22\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[234]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:8.51em;vertical-align:-4.005em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.505em;\"><span style=\"top:-6.505em;\"><span class=\"pstrut\" style=\"height:4.705em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.705em;\"><span style=\"top:-4.665em;\"><span class=\"pstrut\" style=\"height:4.665em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:4.83em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.165em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.665em;\"><span style=\"top:-4.825em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">k</span></span></span></span><span style=\"top:-3.615em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-2.405e