  {
   "kind": 2,
   "value": "(* ---- 4. Exact checks at a rational point: commutativity, spectrum = diagonal twist, simple spectrum. ---- *)\nClearAll[prmX, zX, τCoX, τDiagCoX, genX];\nzX = {2, 3, 1/6};\nprmX = {θ1 -> 1/3, θ2 -> -8/57, h -> 1, χ1 -> Total[zX], χ2 -> zX[[1]] zX[[2]] + zX[[1]] zX[[3]] + zX[[2]] zX[[3]], χ3 -> Times @@ zX};\nτCoX[a_, k_] := τCoX[a, k] = τCo[a, k] /. prmX;\n(* diagonal twist with the same eigenvalues: τ^D_a = Σ_I z_I qmin_{I,I}; companion G = S diag(z) S^-1 and T is gl(3)-covariant, so the spectra must agree *)\nτDiagCoX[a_, k_] := τDiagCoX[a, k] = Sum[(Times @@ zX[[II]]) Coefficient[qmin[II, II], u, k], {II, subsetsA[a]}] /. prmX;\n(* generic combination of all non-scalar coefficients *)\ngenX[co_] := Sum[Prime[3 + 2 a + k] co[a, k], {a, 2}, {k, 0, 2 a - 1}];\nModule[{zero = ConstantArray[0, {dtot, dtot}], tt, cp1, cp2},\n cp1 = CharacteristicPolynomial[genX[τCoX], tt];\n cp2 = CharacteristicPolynomial[genX[τDiagCoX], tt];\n Grid[{\n   {\"[τ_a coeff, τ_b coeff] = 0 (all a,b ≤ 2, all k,l)\", And @@ Flatten @ Table[τCoX[a, k].τCoX[b, l] - τCoX[b, l].τCoX[a, k] === zero, {a, 2}, {b, 2}, {k, 0, 2 a}, {l, 0, 2 b}]},\n   {\"companion twist breaks Cartan: [τ_1, E_11] ≠ 0\", Normal[τCoX[1, 1].Etot[1, 1] - Etot[1, 1].τCoX[1, 1]] =!= zero},\n   {\"charpoly(generic τ comb.) companion = diagonal twist\", Expand[cp1 - cp2] === 0},\n   {\"simple spectrum (squarefree charpoly, 24 distinct states)\", Exponent[PolynomialGCD[cp1, D[cp1, tt]], tt] == 0}\n  }, Frame -> All, Alignment -> Left]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"24223\" data-output-id=\"4\" data-out-n=\"45\" data-sub-idx=\"9\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"7\" data-sub-start=\"9\" data-sub-end=\"17\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[45]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.84em;vertical-align:-2.15em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.69em;\"><span style=\"top:-4.65em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:4.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.65em;\"><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">[</span><span class=\"mord mathnormal\" style=\"margin-right:0.1132em;\">τ</span><span class=\"mord\">_a coeff, </span><span class=\"mord mathnormal\" style=\"margin-right:0.1132em;\">τ</span><span class=\"mord\">_b coeff] = 0 (all a,b </span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">≤</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"> 2, all k,l)</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">companion twist breaks Cartan: [</span><span class=\"mord mathnormal\" style=\"margin-right:0.1132em;\">τ</span><span class=\"mord\">_1, E_11] </span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\"><span class=\"mord vbox\"><span class=\"thinbox\"><span class=\"rlap\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"inner\"><span class=\"mord\"><span class=\"mrel\"></span></span></span><span class=\"fix\"></span></span></span></span></span><span class=\"mspace nobreak\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"> 0</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">charpoly(generic </span><span class=\"mord mathnormal\" style=\"margin-right:0.1132em;\">τ</span><span class=\"mord\"> comb.) companion = diagonal twist</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">simple spectrum (squarefree charpoly, 24 distinct states)</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.15em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:4.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.15em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.65em;\"><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.15em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:4.8em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.15em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:4.65em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.15em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[45]= \\begin{array}{|c|c|}\\hline\\text{[$\\tau$\\_a coeff, $\\tau$\\_b coeff] = 0 (all a,b $\\le$ 2, all k,l)} & \\mathrm{True}\\\\\\hline\\text{companion twist breaks Cartan: [$\\tau$\\_1, E\\_11] $\\not=$ 0} & \\mathrm{True}\\\\\\hline\\text{charpoly(generic $\\tau$ comb.) companion = diagonal twist} & \\mathrm{True}\\\\\\hline\\text{simple spectrum (squarefree charpoly, 24 distinct states)} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "6b079061-03d1-4d4f-b50d-14291be40e3a"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "## 3. SoV B operator (built from the untwisted T, G = 1)\n\n$$\\mathbf B(u) = T_{11}(u)\\,\\mathrm{qmin}_{12,12}(u+h) + T_{21}(u)\\,\\mathrm{qmin}_{12,13}(u+h),$$\n\nwith $T$ the **untwisted** monodromy. The expected spectrum is $\\mathbf B = \\prod_\\alpha\\prod_{k=1}^{2}\\prod_{j=1}^{k}(u-x^\\alpha_{kj})$ with $x^\\alpha_{kj}=\\theta_\\alpha+h(\\mu^\\alpha_{kj}-j+1)$. The dual diagonals for gl(3) are $\\mu_{11}=\\lambda_{21}$, $\\mu_{21}=\\lambda_{11}$, $\\mu_{22}=\\lambda_{22}$, so per site $(x_{11},x_{21},x_{22}) = \\theta + h(\\lambda_{21},\\ \\lambda_{11},\\ \\lambda_{22}-1)$.\n\n`xCov[p]` is the left eigen-covector for the GT pattern pair `p`, taken as the exact joint null space of $\\mathbf B^T$ minus the predicted eigenvalue over all $u$-coefficients (exact point `prmX`). The minimal one should be $\\langle 0| = e_{24}$.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 5. B operator from the UNTWISTED monodromy; spectrum = root formula, non-degenerate; covectors <x|. ---- *)\nClearAll[Bop, BCoX, patPairs, xRoots, bLead, bPoly, xCov];\nBop = Expand[qmin[{1}, {1}] . (qmin[{1, 2}, {1, 2}] /. u -> u + h) + qmin[{2}, {1}] . (qmin[{1, 2}, {1, 3}] /. u -> u + h)];\nBCoX[k_] := BCoX[k] = Coefficient[Bop, u, k] /. prmX;\n(* site pattern pat = {{λ11},{λ21,λ22},{ν1,ν2,ν3}}; returns {x11, x21, x22} *)\nxRoots[α_, pat_] := {θ1, θ2}[[α]] + h {pat[[2, 1]], pat[[1, 1]], pat[[2, 2]] - 1};\npatPairs = Tuples[{ps[{λ1}], ps[{λ2}]}];   (* same order as the Kronecker basis *)\nbLead = Coefficient[Bop, u, 6][[1, 1]];\nbPoly[p_][y_] := bLead Times @@ (y - Join[xRoots[1, p[[1]]], xRoots[2, p[[2]]]]);\nxCov[p_] := xCov[p] = NullSpace[Join @@ Table[Transpose[BCoX[k]] - (Coefficient[bPoly[p][u], u, k] /. prmX) IdentityMatrix[dtot], {k, 0, 6}]];\nModule[{zero = ConstantArray[0, {dtot, dtot}], e24 = UnitVector[dtot, dtot]},\n Grid[{\n   {\"deg_u B\", Max[Exponent[Flatten[Bop], u]]},\n   {\"leading coeff (symbolic, ∝ Id?)\", {bLead, Expand[Coefficient[Bop, u, 6] - bLead IdentityMatrix[dtot]] === zero}},\n   {\"[B coeff, B coeff] = 0\", And @@ Flatten @ Table[BCoX[k].BCoX[l] - BCoX[l].BCoX[k] === zero, {k, 0, 6}, {l, 0, 6}]},\n   {\"null-space dims over 24 pattern pairs\", Union[Length /@ (xCov /@ patPairs)]},\n   {\"covectors span (rank)\", MatrixRank[First /@ (xCov /@ patPairs)]},\n   {\"minimal x pattern pair\", Last[patPairs]},\n   {\"<0| = e_24 is the minimal covector (symbolic check: e_24.B = b_0(u) e_24)\", Expand[e24 . Bop - bPoly[Last[patPairs]][u] e24] === ConstantArray[0, dtot]}\n  }, Frame -> All, Alignment -> Left]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"24223\" data-output-id=\"5\" data-out-n=\"54\" data-sub-idx=\"10\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"9\" data-sub-start=\"10\" data-sub-end=\"19\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[54]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.64em;vertical-align:-4.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.09em;\"><span style=\"top:-7.05em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:9.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.66em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">deg_u B</span></span></span></span><span style=\"top:-6.46em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">leading coeff (symbolic, </span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∝</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"> Id?)</span></span></span></span><span style=\"top:-5.26em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">[B coeff, B coeff] = 0</span></span></span></span><span style=\"top:-4.06em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">null-space dims over 24 pattern pairs</span></span></span></span><span style=\"top:-2.86em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">covectors span (rank)</span></span></span></span><span style=\"top:-1.05em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">minimal x pattern pair</span></span></span></span><span style=\"top:0.74em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">&lt;0| = e_24 is the minimal covector (symbolic check: e_24.B = b_0(u) e_24)</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:9.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.66em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">6</span></span></span><span style=\"top:-6.46em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-5.26em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-4.06em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-2.86em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\">24</span></span></span><span style=\"top:-1.05em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">(</span></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span>