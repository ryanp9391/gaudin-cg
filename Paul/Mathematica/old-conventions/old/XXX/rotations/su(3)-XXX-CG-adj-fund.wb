  {
   "kind": 2,
   "value": "(* ---- 13. The reachable set: (a,b,c) from twist w, the surface b = a(c-a), its inverse map, and non-vacuum dual Q's. ---- *)\nClearAll[abcOfW, wOfABC, surfTab, invTab, qdState, nonVacTab, wRand];\nabcOfW[w_] := {-w[[1]] w[[2]], w[[1]], -w[[1]] (w[[2]] + w[[3]])};\nwOfABC[{a_, b_, c_}] := {b, -a/b, -1/a};\nwRand = {{5/2, 7/3, 6/35}, {3, 1/2, 2/3}, {2, 3, 1/6}, {3/2, 5/4, 8/15}, {7/2, 2/7, 1}, {5, 2/5, 1/2}};\n(* (i) closed form for (a,b,c)(w) and the surface relation *)\nsurfTab = Table[With[{fit = rotFit[vacAtTwist[w][\"OmegaL\"]]},\n    {w, fit[[1]], fit[[1]] - abcOfW[w], fit[[2]], fit[[1, 2]] - fit[[1, 1]] (fit[[1, 3]] - fit[[1, 1]])}], {w, wRand}];\n(* (ii) inverse: any (a,b,c) on the surface comes from w = (b, -a/b, -1/a), automatically unimodular *)\ninvTab = Table[With[{abc = {a, b, a + b/a}}, With[{w = wOfABC[abc]},\n     {abc, w, Times @@ w, rotFit[vacAtTwist[w][\"OmegaL\"]][[1]] - abc}]], {a, {-2, 3/2}}, {b, {5, -7/3}}];\n(* (iii) dual Q's of a NON-vacuum eigenstate at twist w0 *)\nqdState[w_, n_] := qdState[w, n] = Module[{pz = prmOf[w], coT, eig, v},\n   coT = Table[Coefficient[τ[a], u, k] /. pz, {a, 2}, {k, 0, 4}];\n   eig[vv_, a_] := With[{i = First @ Ordering[Abs[N[vv]], -1]}, Sum[(coT[[a, k + 1]] . vv)[[i]]/vv[[i]] u^k, {k, 0, 2 a}]];\n   v = Eigenvectors[N[Sum[Prime[3 + 2 a + k] coT[[a, k + 1]], {a, 2}, {k, 0, 2 a - 1}], wpS]][[n]];\n   Table[baxSolveDual[eig[v, 1], eig[v, 2], 1/w[[j]]], {j, 3}]];\nnonVacTab = Table[Module[{qd = qdState[w0, n], cs, V, f},\n    cs = Table[With[{ch = chainM[zz]}, LinearSolve[ch[\"P\"], Table[Det[rowNk[s[\"q\"], zz, qd, w0, 0, #]& /@ knownSet]/psiG[s[\"q\"], zz][x0], {s, ch[\"states\"]}]]], {zz, {zX, zP}}];\n    V = cs[[1]] . chainM[zX][\"xNorm\"]; f = rotFit[V];\n    {n, numRank[cs, 10^-40], stabDim[V/Max[Abs[V]]], sci[Abs[f[[2]]]]}], {n, {1, 2, 5, 9, 20}}];\nColumn[{\n  Grid[Prepend[surfTab, {\"twist w\", \"(a,b,c)\", \"(a,b,c) - (-w1w2, w1, -w1(w2+w3))\", \"rotation residual\", \"b - a(c-a)\"}], Frame -> All, Alignment -> Left],\n  Grid[Prepend[Flatten[invTab, 1], {\"target (a, b, a+b/a) on the surface\", \"w = (b, -a/b, -1/a)\", \"w1 w2 w3\", \"(a,b,c) of <Ω^L_w| minus target\"}], Frame -> All, Alignment -> Left],\n  Grid[Prepend[nonVacTab, {\"dual Q's from eigenstate n at w0 (n = 9 is the vacuum)\", \"rank{c(z),c(z')}\", \"stabiliser dim\", \"rotation residual\"}], Frame -> All, Alignment -> Left]}]",
   "languageId": "wolfram",
   "outputs": [
    {
