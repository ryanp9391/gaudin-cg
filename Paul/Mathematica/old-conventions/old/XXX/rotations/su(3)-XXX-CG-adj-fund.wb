       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"24223\" data-output-id=\"15\" data-out-n=\"209\" data-sub-idx=\"14\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"36\" data-sub-start=\"28\" data-sub-end=\"33\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[209]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:12.1203em;vertical-align:-5.8101em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:6.3101em;\"><span style=\"top:-8.3101em;\"><span class=\"pstrut\" style=\"height:5.8951em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.8951em;\"><span style=\"top:-5.8551em;\"><span class=\"pstrut\" style=\"height:5.8551em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:7.2103em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.3551em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.8551em;\"><span style=\"top:-5.8602em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">four labels (x11 offsets)</span></span></span></span><span style=\"top:-3.4551em;\"><span class=\"pstrut\" style=\"height:3.4551em;\"></span><span class=\"mord\"><span class=\"mord