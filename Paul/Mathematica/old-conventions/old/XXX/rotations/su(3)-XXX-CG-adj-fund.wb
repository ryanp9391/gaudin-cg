       "data": "Out[217]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{t = $\\theta$2 - $\\theta$1} & -\\frac{9}{19}\\\\\\hline\\text{site x11 points} & \\begin{pmatrix}\\frac{4}{3} & \\frac{7}{3}\\\\-\\frac{8}{57} & \\frac{49}{57}\\end{pmatrix}\\\\\\hline\\text{cross-ratio of the four points} & \\frac{784}{423}\\\\\\hline\\text{value required by the E32 pattern} & \\frac{784}{423}\\\\\\hline\\text{pattern constants vs pole ratios} & \\left\\{\\frac{47}{28},\\frac{47}{28}\\right\\}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|c|}\\hline\\text{case} & \\text{\\{b1/a1, b2/a2\\}} & \\text{k} & \\text{rank\\{c(z),c(z')\\}} & \\text{stabiliser dim} & \\text{cell} & \\text{(a,b,c) achieved} & \\text{rotation residual}\\\\\\hline\\text{target c = 1} & \\left\\{0.1914893617,5.222222222\\right\\} & 0 & 1 & 6 & 1 & \\left\\{0,0,1.\\,\\right\\} & \\text{8.95}\\times 10^{\\text{-94}}\\\\\\hline\\text{target c = -3/7} & \\left\\{-0.08206686930,-2.238095238\\right\\} & 0 & 1 & 6 & 1 & \\left\\{0,0,-0.4285714286\\right\\} & \\text{4.51}\\times 10^{\\text{-95}}\\\\\\hline\\text{target c = 2} & \\left\\{0.3829787234,10.44444444\\right\\} & 0 & 1 & 6 & 1 & \\left\\{0,0,2.\\,\\right\\} & \\text{2.63}\\times 10^{\\text{-93}}\\\\\\hline\\text{target c = 1, k = 1/2} & \\left\\{0.1161441689,3.167437890\\right\\} & \\frac{1}{2}… [latex truncated: 1455 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "6d5272fd-1e2b-4359-b382-289ab27dab68"
