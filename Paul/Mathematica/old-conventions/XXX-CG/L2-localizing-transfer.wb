  {
   "kind": 2,
   "value": "(* ---- 6. Does the lemma iterate? <vacL (x) vacL| t_{2,1}(θ1)^2 at point 1 (p1 = 3/5, p2 = 4/7, p3 by the vacL relation). After one step the sites carry\n   different rotations (u^G (x) u), and R12 is no longer a scalar on that, so no: the result is not site-1-only and not <e1 G^-2 g0 G^2 (x) vacL|. ---- *)\nClearAll[iterLc];\niterLc = Module[{g0, vL, t, M2, Grep, pred2},\n    g0 = MatrixExp[3/5 Normal[ElLc[1, 2]]] . MatrixExp[4/7 Normal[ElLc[1, 3]]] . MatrixExp[(4/7 (zLc[[3]] - zLc[[1]]) / (3/5 (zLc[[2]] - zLc[[3]]))) Normal[ElLc[2, 3]]];\n    vL = UnitVector[dsLc, 1] . g0; t = tfLc[{2, 1}, thLc[[1]]];\n    M2 = Partition[Flatten[KroneckerProduct[vL, vL]] . t . t, dsLc];\n    Grep = DiagonalMatrix[Table[Product[zLc[[i]]^Normal[ElLc[i, i]][[n, n]], {i, 3}], {n, dsLc}]];\n    pred2 = UnitVector[dsLc, 1] . MatrixPower[Inverse[Grep], 2] . g0 . MatrixPower[Grep, 2];\n    {MatrixRank[M2], MatrixRank[Prepend[M2, vL]] == 1, MatrixRank[{Flatten[M2], Flatten[KroneckerProduct[pred2, vL]]}] == 1}\n];\nGrid[{\n    {\"rank of <vacL (x) vacL| t_{2,1}(θ1)^2 as a site-1 x site-2 matrix\", iterLc[[1]]},\n    {\"site 1 only?\", iterLc[[2]]},\n    {\"= <e1 G^-2 g0 G^2 (x) vacL| up to a constant?\", iterLc[[3]]}\n}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"389651\" data-output-id=\"87\" data-out-n=\"1073\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"7\" data-sub-start=\"11\" data-sub-end=\"15\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1073]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:3.64em;vertical-align:-1.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.09em;\"><span style=\"top:-4.05em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">rank of &lt;vacL (x) vacL| t_{2,1}(</span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord\">1)</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">2 as a site-1 x site-2 matrix</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">site 1 only?</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">= &lt;e1 G</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">-2 g0 G</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">2 (x) vacL| up to a constant?</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.05em;\"><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">4</span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">False</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">False</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:3.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-1.55em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:4.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.55em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[1073]= \\begin{array}{|c|c|}\\hline\\text{rank of <vacL (x) vacL| t\\_\\{2,1\\}($\\theta$1)\\^{}2 as a site-1 x site-2 matrix} & 4\\\\\\hline\\text{site 1 only?} & \\mathrm{False}\\\\\\hline\\text{= <e1 G\\^{}-2 g0 G\\^{}2 (x) vacL| up to a constant?} & \\mathrm{False}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "a2736eb7-0529-42c9-9bf7-227d265e2ead"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### Result ($[2,1,0]^{\\otimes2}$, exact)\n\nWrite-up: `L2-localizing-transfer.tex` / `.pdf`.\n\n- **Yes (cells 5–7).** For a global rotation $\\langle u|=e_1^Tg$, $g=e^{aE_{12}}e^{bE_{13}}e^{cE_{23}}$:\n$$\\langle u\\otimes u|\\,t_{\\{2,1\\}}(\\theta_1)=\\tau^{\\rm vac}_{\\{2,1\\}}(\\theta_1)\\,\\langle u^G\\otimes u|,\\qquad \\langle u^G|=e_1^T\\,G^{-1}gG,$$\n  i.e. $(a,b,c)\\to(a\\,z_2/z_1,\\;b\\,z_3/z_1,\\;c\\,z_3/z_2)$ on site 1 only, and site 2 keeps $\\langle u|$. The constant is the eigenvalue of $t_{\\{2,1\\}}(\\theta_1)$ on $\\langle e_1\\otimes e_1|$ ($210000/6859$ at point 1).\n  - Point 1 ($h=1$, $\\theta=(1/3,-8/57)$, $z=(5/2,7/3,6/35)$): exact with $a,b,c$ symbolic (cell 6).\n  - Point 2 ($h=1/2$, $\\theta=(2/7,-3/11)$, $z=(3/2,5/4,8/15)$): exact with $u=\\mathrm{vacL}$, $p_1,p_2$ symbolic (cell 7), $\\tau=1585575/467489792$.\n  - Mechanism: if the fused Lax at $x=\\theta_1$ is $\\propto P_{a1}$, then $t(\\theta_1)=R_{12}(\\theta_{12})\\,G_1$ (for $T=L_1L_2G$), and $R_{12}$ is a scalar on $\\langle u\\otimes u|\\in V_{2\\lambda}$. This is an explanation, not a proof: the regularity of the fused Lax is not checked separately.\n- **Scan (cell 4).** Over $x=\\theta_s+nh$, $n=-5..5$, for $t_{\\{1,0\\}},t_{\\{1,1\\}},t_{\\{2,0\\}},t_{\\{2,1\\}},t_{\\{2,2\\}}$ (generic $a,b,c=3/5,4/7,-2/9$), the only one-site actions are:\n  - $t_{\\{2,1\\}}(\\theta_1)$ on site 1; the result is again a rotation (above).\n  - $t_{\\{1,1\\}}(\\theta_1)$ on site 1; rank 1, but $w$ is **not** a rotation of $e_1$ (the fit has no solution).\n  - $t_{\\{1,1\\}}(\\theta_2+3h)$ on site 2.\n  - $t_{\\{2,2\\}}$ vanishes on $\\langle u\\otimes u|$ at $\\theta_s\\pm h$.\n  \n  No $t_{\\{2,1\\}}(\\theta_2+nh)$ acts on site 2 alone; the asymmetry comes from the ordering $T=L_1L_2G$.\n- **No iteration (cell 8).** $\\langle\\mathrm{vacL}\\otimes\\mathrm{vacL}|t_{\\{2,1\\}}(\\theta_1)^2$ has rank 4 as a (site 1 × site 2) matrix. After one step the sites carry different rotations, and the lemma needs the same rotation on both.\n- **CG use.** The family is counted in `xxx-210-cg-test.wb` cells 11–15. Undoing $g_0\\otimes g_0$ gives $v_t=e_1^TG^{-1}g_0Gg_0^{-1}=e_1^Te^{yE_{23}}e^{xE_{12}}$. It reaches 4/6 highest-weight states and nothing new; the singlet is missed.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 1,
   "value": "### For which product covectors $\\langle v\\otimes w|$ does $t_\\lambda(\\theta_1)$ act on site 1 only? (Paul, 2026-09-23)\n\nFor fixed $w$, the condition $\\langle v\\otimes w|\\,t(\\theta_1)=\\langle v'\\otimes w|$ is **linear in $v$**. Every row of the reshaped $8\\times8$ result must be proportional to $w$, i.e. it must annihilate $\\{q: w\\cdot q=0\\}$. So each $w$ has a localizing subspace $V_{\\rm loc}(w)$, which we compute exactly at point 1.\n\nCandidates for $w$:\n- a generic covector;\n- a generic **local highest-weight state** $e_1^Tg$ with $g=n_-hn_+$ generic, i.e. the hw vector of a generic Borel;\n- $e_8^Tg$, the lowest weight rotated;\n- the bare $e_1^T$ and $e_8^T$;\n- the $N_+$ rotations $u=e_1^Te^{aE_{12}}e^{bE_{13}}e^{cE_{23}}$ used before.\n\nMechanism check: if $t_\\lambda(\\theta_1)\\,(\\hat G^{-1}\\otimes1)$ commutes with the global $\\mathfrak{gl}(3)$, then $t_\\lambda(\\theta_1)$ behaves like $R_{12}(\\theta_{12})\\,G_1$. Localization then means $\\langle v\\otimes w|R_{12}\\in V\\otimes w$.",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 7. Localizing subspace V_loc(w) = {v : <v (x) w| t(θ1) = <v' (x) w|}, exact at point 1, for t_{1,0}, t_{1,1}, t_{2,0}, t_{2,1}. ---- *)\nClearAll[tAtLc, GhatLc, EtotLc, invarLc, vlocLc, expNLc, gGenLc, wListLc, locTabLc, uRotLc];\ntAtLc = Association[Table[lab -> Normal[tfLc[lab, thLc[[1]]]], {lab, {{1, 0}, {1, 1}, {2, 0}, {2, 1}}}]];\nGhatLc = DiagonalMatrix[Table[Product[zLc[[i]]^Normal[ElLc[i, i]][[n, n]], {i, 3}], {n, dsLc}]];\nEtotLc[i_, j_] := Normal[E1Lc[i, j] + E2Lc[i, j]];\n(* does t(θ1).(Ghat^-1 (x) 1) commute with the global gl(3)? *)\ninvarLc[lab_] := With[{m = tAtLc[lab] . KroneckerProduct[Inverse[GhatLc], IdentityMatrix[dsLc]]}, And @@ Flatten @ Table[m . EtotLc[i, j] == EtotLc[i, j] . m, {i, 3}, {j, 3}]];\n(* V_loc(w): unknown v; the rows of Partition[(v (x) w).t, ds] must kill every q with w.q = 0 *)\nvlocLc[lab_, w_] := Module[{Q = NullSpace[{w}], K}, K = Table[Partition[Flatten[KroneckerProduct[UnitVector[dsLc, a], w]] . tAtLc[lab], dsLc] . Transpose[Q], {a, dsLc}]; NullSpace[Transpose[Flatten /@ K]]];\nexpNLc[M_] := IdentityMatrix[dsLc] + Sum[MatrixPower[M, n] / n!, {n, 1, dsLc}];\n(* generic group element n_- h n_+ in the rep, rational *)\ngGenLc[pp_List, hh_List] := expNLc[pp[[1]] Normal[ElLc[2, 1]]] . expNLc[pp[[2]] Normal[ElLc[3, 1]]] . expNLc[pp[[3]] Normal[ElLc[3, 2]]] . DiagonalMatrix[Table[Product[hh[[i]]^Normal[ElLc[i, i]][[n, n]], {i, 3}], {n, dsLc}]] . expNLc[pp[[4]] Normal[ElLc[1, 2]]] . expNLc[pp[[5]] Normal[ElLc[1, 3]]] . expNLc[pp[[6]] Normal[ElLc[2, 3]]];\nuRotLc = UnitVector[dsLc, 1] . expNLc[3/5 Normal[ElLc[1, 2]]] . expNLc[4/7 Normal[ElLc[1, 3]]] . expNLc[-2/9 Normal[ElLc[2, 3]]];\nwListLc = {\n    \"generic w\" -> {3, -1, 4, 1, -5, 9, 2, -6} / 7,\n    \"e1 (bare hw)\" -> UnitVector[dsLc, 1],\n    \"e8 (bare lw)\" -> UnitVector[dsLc, dsLc],\n    \"u = e1 N+ rotation (as before)\" -> uRotLc,\n    \"e1 g, g generic (local hw, generic Borel)\" -> UnitVector[dsLc, 1] . gGenLc[{2/3, -1/4, 3/5, 1/2, -2/7, 5/3}, {2, 3/2, 5/7}],\n    \"e8 g, g generic\" -> UnitVector[dsLc, dsLc] . gGenLc[{2/3, -1/4, 3/5, 1/2, -2/7, 5/3}, {2, 3/2, 5/7}]\n};\n(* per w and t: dim V_loc(w), and whether v = w lies in it *)\nlocTabLc = Table[With[{w = Last[wr]}, Prepend[Table[With[{V = vlocLc[lab, w]}, Row[{Length[V], If[V === {}, \"\", If[MatrixRank[Append[V, w]] == Length[V], \"  (∋ w)\", \"  (∌ w)\"]]}]], {lab, Keys[tAtLc]}], First[wr]]], {wr, wListLc}];\nColumn[{\n    Grid[Prepend[Table[{Row[lab, \",\"], invarLc[lab]}, {lab, Keys[tAtLc]}], {\"t_λ(θ1)\", \"t(θ1)(Ghat^-1 ⊗ 1) commutes with global gl(3)\"}], Frame -> All, Alignment -> Left],\n    Grid[Prepend[locTabLc, Prepend[Row[#, \",\"] & /@ Keys[tAtLc], \"w\"]], Frame -> All, Alignment -> Left]\n}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"928082\" data-output-id=\"2\" data-out-n=\"52\" data-sub-idx=\"16\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"10\" data-sub-start=\"23\" data-sub-end=\"26\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[52]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"13\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:14.48em;vertical-align:-6.99em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:7.49em;\"><span style=\"top:-10.69em;\"><span class=\"pstrut\" style=\"height:6.49em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.29em;\"><span style=\"top:-5.25em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.25em;\"><span style=\"top:-5.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">t_</span><span class=\"mord mathnormal\">λ</span><span class=\"mord\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord\">1)</span></span></span></span><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-0.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.25em;\"><span style=\"top:-5.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">t(</span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord\">1)(Ghat</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">-1 </span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">⊗</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"> 1) commutes with global gl(3)</span></span></span></span><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">False</span></span></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">False</span></span></span></span><span style=\"top:-1.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">False</span></span></span></span><span style=\"top:-0.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.75em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"hline\" style=\"border-bottom-wi