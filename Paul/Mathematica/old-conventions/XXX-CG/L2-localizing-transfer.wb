  {
   "kind": 2,
   "value": "(* ---- 5. Same statement at point 2 of L2-det-mathcalA (h = 1/2, θ = (2/7, -3/11), z = (3/2, 5/4, 8/15)), with u = vacL (p1, p2 free, p3 by the vacL relation):\n   <vacL (x) vacL| t_{2,1}(θ1) = τ <e1 G^-1 g0 G (x) vacL|, G acting in the rep as diag(z^μ). Point 1 is restored at the end. ---- *)\nClearAll[chkPt2Lc];\nchkPt2Lc = Module[{pt1 = {hLc, thLc, zLc}, g0, vL, Grep, M, pred, r, res},\n    {hLc, thLc, zLc} = {1/2, {2/7, -3/11}, {3/2, 5/4, 8/15}};\n    Clear[tGLc]; tGLc[a_, x_] := tGLc[a, x] = Sum[(Times @@ zLc[[II]]) qminLc[II, x], {II, Subsets[Range[3], {a}]}];\n    g0 = MatrixExp[pS1 Normal[ElLc[1, 2]]] . MatrixExp[pS2 Normal[ElLc[1, 3]]] . MatrixExp[(pS2 (zLc[[3]] - zLc[[1]]) / (pS1 (zLc[[2]] - zLc[[3]]))) Normal[ElLc[2, 3]]];\n    vL = Expand[UnitVector[dsLc, 1] . g0];\n    Grep = DiagonalMatrix[Table[Product[zLc[[i]]^Normal[ElLc[i, i]][[n, n]], {i, 3}], {n, dsLc}]];\n    M = Expand[Partition[Flatten[KroneckerProduct[vL, vL]] . tfLc[{2, 1}, thLc[[1]]], dsLc]];\n    pred = Expand[UnitVector[dsLc, 1] . Inverse[Grep] . g0 . Grep];\n    r = Together[M[[1, 1]] / pred[[1]]];\n    res = Together[M - r KroneckerProduct[pred, vL]];\n    {hLc, thLc, zLc} = pt1;\n    Clear[tGLc]; tGLc[a_, x_] := tGLc[a, x] = Sum[(Times @@ zLc[[II]]) qminLc[II, x], {II, Subsets[Range[3], {a}]}];\n    {Union[Flatten[res]] === {0}, r}\n];\nGrid[{{\"point 2: <vacL (x) vacL| t_{2,1}(θ1) = τ <e1 G^-1 g0 G (x) vacL|, exact in p1, p2\", chkPt2Lc[[1]]}, {\"τ (constant, p-independent)\", chkPt2Lc[[2]]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"389651\" data-output-id=\"77\" data-out-n=\"988\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"6\" data-sub-start=\"17\" data-sub-end=\"17\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[988]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:2.4451em;vertical-align:-0.9526em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.4926em;\"><span style=\"top:-3.4526em;\"><span class=\"pstrut\" style=\"height:3.4526em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:2.4051em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.9526em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.4526em;\"><span style=\"top:-3.6126em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">point 2: &lt;vacL (x) vacL| t_{2,1}(</span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord\">1) = </span><span class=\"mord mathnormal\" style=\"margin-right:0.1132em;\">τ</span><span class=\"mord\"> &lt;e1 G</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class