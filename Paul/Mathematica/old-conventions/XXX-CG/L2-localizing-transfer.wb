      {
       "data": "Out[78]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{single labels acting on site 1 only} & \\text{100|100}\\text{, }\\text{111|100}\\text{, }\\text{200|100}\\text{, }\\text{211|100}\\\\\\hline\\text{single labels acting on site 2 only} & \\text{100|100}\\\\\\hline\\text{dim C2 (site-2 localizing combinations)} & 8\\\\\\hline\\text{labels that ever appear in C2} & 35\\\\\\hline\\text{minimal supports found (size $\\le$ 3)} & 4\\\\\\hline\\text{they span C2} & \\mathrm{False}\\\\\\hline\\text{rank of their site-2 covectors w g0\\^{}-1} & 3\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{minimal support (site1|site2 labels n21 n11 n12)} & \\text{coefficients} & \\text{site-2 weights of w g0\\^{}-1}\\\\\\hline\\text{100|100} & \\left\\{1\\right\\} & \\begin{pmatrix}2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{100|200}\\text{ , }\\text{200|100} & \\left\\{-\\frac{10}{19},1\\right\\} & \\begin{pmatrix}1 & 2 & 0\\\\2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{100|110}\\text{ , }\\text{100|200}\\text{ , }\\text{110|100} & \\left\\{-\\frac{10}{19},-\\frac{9}{19},1\\right\\} & \\begin{pmatrix}2 & 0 & 1\\\\2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{100|110}\\text{ , }\\text{110|100}\\text{ , }\\text{200|100} & \\left\\{\\frac{100}{171},-\\frac{10}{9},1\\right\\} & \\begin{pmatrix}1 & 2 & 0\\\\2 & 0… [latex truncated: 1259 chars total]",
