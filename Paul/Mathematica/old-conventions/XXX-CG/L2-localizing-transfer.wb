       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[52]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{t\\_$\\lambda$($\\theta$1)} & \\text{t($\\theta$1)(Ghat\\^{}-1 $\\otimes$ 1) commutes with global gl(3)}\\\\\\hline1,0 & \\mathrm{False}\\\\\\hline1,1 & \\mathrm{False}\\\\\\hline2,0 & \\mathrm{False}\\\\\\hline2,1 & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|}\\hline\\text{w} & 1,0 & 1,1 & 2,0 & 2,1\\\\\\hline\\text{generic w} & 0 & 0 & 0 & 0\\\\\\hline\\text{e1 (bare hw)} & 1\\text{  ($\\owns$ w)} & 2\\text{  ($\\owns$ w)} & 1\\text{  ($\\owns$ w)} & 1\\text{  ($\\owns$ w)}\\\\\\hline\\text{e8 (bare lw)} & 1\\text{  ($\\owns$ w)} & 2\\text{  ($\\owns$ w)} & 1\\text{  ($\\owns$ w)} & 1\\text{  ($\\owns$ w)}\\\\\\hline\\text{u = e1 N+ rotation (as before)} & 0 & 2\\text{  ($\\owns$ w)} & 0 & 1\\text{  ($\\owns$ w)}\\\\\\hline\\text{e1 g, g generic (local hw, generic Borel)} & 0 & 2\\text{  ($\\owns$ w)} & 0 & 1\\text{  ($\\owns$ w)}\\\\\\hline\\text{e8 g, g generic} & 0 & 2\\text{  ($\\owns$ w)} & 0 & 1\\text{  ($\\owns$ w)}\\\\\\hline\\end{array}\\end{matrix}",
       "mime": "text/plain"
      }
     ],
     "id": "7c48e9ca-658c-44da-ad5a-914407e7cd26"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 8. The extra direction of t_{1,1}(θ1), covariance of V_loc, and v' for t_{2,1}(θ1). g = the generic group element of cell 11. ---- *)\nModule[{g = gGenLc[{2/3, -1/4, 3/5, 1/2, -2/7, 5/3}, {2, 3/2, 5/7}], w, Vbare, wts, e1E12},\n    w = UnitVector[dsLc, 1] . g;\n    Vbare = vlocLc[{1, 1}, UnitVector[dsLc, 1]];\n    wts = Transpose[Table[Diagonal[Normal[ElLc[i, i]]], {i, 3}]];\n    e1E12 = UnitVector[dsLc, 1] . Normal[ElLc[1, 2]];\n    Grid[{\n        {\"V_loc(e1) for t_{1,1}(θ1)\", Vbare},\n        {\"= span{e1, e1 E12}, i.e. v = e1 e^{a E12}\", MatrixRank[Join[Vbare, {UnitVector[dsLc, 1], e1E12}]] == 2},\n        {\"weights in V_loc(e1)\", Union[Flatten[Table[If[v[[n]] != 0, {wts[[n]]}, {}], {v, Vbare}, {n, dsLc}], 2]]},\n        {\"covariance: V_loc(e1 g) = V_loc(e1) . g for t_{1,1}\", MatrixRank[Join[vlocLc[{1, 1}, w], Vbare . g]] == 2},\n        {\"t_{2,1}: V_loc(e1 g) = span{e1 g}\", MatrixRank[Join[vlocLc[{2, 1}, w], {w}]] == 1 && Length[vlocLc[{2, 1}, w]] == 1},\n        {\"t_{2,1}: v' ∝ w . Ghat (twist on site 1)\", Module[{M = Partition[Flatten[KroneckerProduct[w, w]] . tAtLc[{2, 1}], dsLc]}, MatrixRank[{M[[All, 1]] / w[[1]], w . GhatLc}] == 1]}\n    }, Frame -> All, Alignment -> Left]\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"282043\" data-output-id=\"17\" data-out-n=\"143\" data-sub-idx=\"1\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"11\" data-sub-start=\"1\" data-sub-end=\"14\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[143]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.6401em;vertical-align:-4.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.09em;\"><span style=\"top:-7.05em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:9.6001em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.05em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">V_loc(e1) for t_{1,1}(</span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord\">1)</span></span></span></span><span style=\"top:-5.26em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">= span{e1, e1 E12}, i.e. v = e1 e</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"accent-body\" style=\"left:-0.25em;\"><span class=\"mord\">ˆ</span></span></span></span></span></span></span><span class=\"mord\">{a E12}</span></span></span></span><span style=\"top:-3.45em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">weights in V_loc(e1)</span></span></span></span><span style=\"top:-1.66em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">covariance: V_loc(e1 g) = V_loc(e1) . g for t_{1,1}</span></span></span></span><span style=\"top:-0.46em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">t_{2,1}: V_loc(e1 g) = span{e1 g}</span></span></span></span><span style=\"top:0.74em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">t_{2,1}: v’ </span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∝</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"> w . Ghat (twist on site 1)</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:9.6001em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.05em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">(</span></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.95em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.45em;\"><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0</span></span></span><s