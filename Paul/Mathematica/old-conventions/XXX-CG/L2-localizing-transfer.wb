  {
   "kind": 2,
   "value": "(* ---- 11. Site-2 minimal supports beyond size 3: search subsets of the 35 labels that appear in C2, up to size 5 (~40 s). ---- *)\nClearAll[labs2Lc, circ2bLc, span2Lc];\nlabs2Lc = Union @@ (Flatten[Position[#, _?(# != 0 &)]] & /@ C2Lc);\ncirc2bLc = Module[{found = {}},\n    Do[Do[If[NoneTrue[found, SubsetQ[S, #] &] && MatrixRank[A2Lc[[S]]] < Length[S], AppendTo[found, S]], {S, Subsets[labs2Lc, {k}]}], {k, 1, 5}];\n    found];\nspan2Lc[k_] := MatrixRank[Table[ReplacePart[ConstantArray[0, 64], Thread[S -> First[NullSpace[Transpose[A2Lc[[S]]]]]]], {S, Select[circ2bLc, Length[#] <= k &]}]];\nGrid[Prepend[Table[{k, Count[circ2bLc, _?(Length[#] == k &)], span2Lc[k]}, {k, 1, 5}], {\"support size k\", \"# minimal supports of size k\", \"dim of C2 spanned by supports of size ≤ k\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
