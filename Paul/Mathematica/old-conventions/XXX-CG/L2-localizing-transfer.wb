  {
   "kind": 2,
   "value": "(* ---- 2. <u (x) u| t(x) for a generic global rotation u = e1 e^{a E12} e^{b E13} e^{c E23} (no p3 relation), x = θ1 + n h.\n   M = the result reshaped as (site-1 index, site-2 index). Site 1 only: every row of M is proportional to u, i.e. M = w (x) u.\n   Codes: \"1\" = site 1 only, \"2\" = site 2 only, \"12\" = proportional to u (x) u, \"0\" = zero, \"-\" = neither; then rank M. ---- *)\nClearAll[uLc, uuLc, locLc, scanLc, labelsLc, nsLc];\nuLc = UnitVector[dsLc, 1] . MatrixExp[3/5 Normal[ElLc[1, 2]]] . MatrixExp[4/7 Normal[ElLc[1, 3]]] . MatrixExp[-2/9 Normal[ElLc[2, 3]]];\nuuLc = Flatten[KroneckerProduct[uLc, uLc]];\nlocLc[t_] := Module[{M = Partition[uuLc . t, dsLc], s1, s2},\n    If[Max[Abs[M]] == 0, Return[\"0\"]];\n    s1 = MatrixRank[Prepend[M, uLc]] == 1;\n    s2 = MatrixRank[Prepend[Transpose[M], uLc]] == 1;\n    Row[{Which[s1 && s2, \"12\", s1, \"1\", s2, \"2\", True, \"-\"], \" (rk \", MatrixRank[M], \")\"}]\n];\nlabelsLc = {{1, 0}, {1, 1}, {2, 0}, {2, 1}, {2, 2}};\nnsLc = Range[-3, 3];\nscanLc[th_] := Table[locLc[tfLc[lab, th + n hLc]], {lab, labelsLc}, {n, nsLc}];\nColumn[{\n    \"x = θ1 + n h\",\n    Grid[Prepend[MapThread[Prepend, {scanLc[thLc[[1]]], Row[#, \",\"] & /@ labelsLc}], Prepend[nsLc, \"t_λ \\\\ n\"]], Frame -> All],\n    \"x = θ2 + n h\",\n    Grid[Prepend[MapThread[Prepend, {scanLc[thLc[[2]]], Row[#, \",\"] & /@ labelsLc}], Prepend[nsLc, \"t_λ \\\\ n\"]], Frame -> All]\n}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"389651\" data-output-id=\"73\" data-out-n=\"968\" data-sub-idx=\"8\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"3\" data-sub-start=\"15\" data-sub-end=\"20\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[968]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:16.88em;vertical-align:-8.19em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.69em;\"><span style=\"top:-13.74em;\"><span class=\"pstrut\" style=\"height:5.89em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">x = </span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"mord\">1 + n h</span></span></span></span><span style=\"top:-9.49em;\"><span class=\"pstrut\" style=\"height:5.89em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.89em;\"><span style=\"top:-5.85em;\"><span class=\"pstrut\" style=\"height:5.85em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:7.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.85em;\"><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">t_</span><span class=\"mord mathnormal\">λ</span><span class=\"mord\"> </span><span class=\"mspace newline\"></span><span class=\"mord\"> n</span></span></span></span><span style=\"top:-4.81em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-1.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:7.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-3.35em;\"></span><span class=\"arraycolsep\" style=\"w