      {
       "data": "Out[69]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{rank of the 64 SoV covectors} & 64\\\\\\hline\\text{dim C (localizing combinations)} & 8\\\\\\hline\\text{labels that ever appear in C} & 12\\\\\\hline\\text{the 8 minimal combinations span C} & \\mathrm{True}\\\\\\hline\\text{rank of their site-1 covectors v g0\\^{}-1} & 8\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{minimal support (site1|site2 labels n21 n11 n12)} & \\text{coefficients} & \\text{site-1 weights of v g0\\^{}-1}\\\\\\hline\\text{100|100} & \\left\\{1\\right\\} & \\begin{pmatrix}2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{111|100} & \\left\\{1\\right\\} & \\begin{pmatrix}1 & 1 & 1\\\\2 & 0 & 1\\\\2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{200|100} & \\left\\{1\\right\\} & \\begin{pmatrix}1 & 2 & 0\\\\2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{211|100} & \\left\\{1\\right\\} & \\begin{pmatrix}0 & 2 & 1\\\\1 & 1 & 1\\\\1 & 2 & 0\\\\2 & 0 & 1\\\\2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{100|200}\\text{ , }\\text{110|100} & \\left\\{-\\frac{19}{9},1\\right\\} & \\begin{pmatrix}1 & 2 & 0\\\\2 & 0 & 1\\\\2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{200|200}\\text{ , }\\text{210|100} & \\left\\{-\\frac{19}{14},1\\right\\} & \\begin{pmatrix}1 & 1 & 1\\\\1 & 2 & 0\\\\2 & 0 & 1\\\\2 & 1 & 0\\end{pmatrix}\\\\\\hline\\text{210|200}\\text{ , }\\text{2… [latex truncated: 1554 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "b8853cee-d4e1-436d-b9c5-c644d737789a"
