      {
       "data": "Out[982]= \\begin{array}{|c|c|}\\hline\\text{<u (x) u| t\\_\\{2,1\\}($\\theta$1) = <w (x) u| for all a, b, c} & \\mathrm{True}\\\\\\hline\\text{w = C e1 e\\^{}\\{a' E12\\} e\\^{}\\{b' E13\\} e\\^{}\\{c' E23\\}} & \\left\\{\\left\\{cc\\$30366\\to \\frac{210000}{6859},a2\\$30366\\to \\frac{14\\,\\mathrm{aS}}{15},b2\\$30366\\to \\frac{12\\,\\mathrm{bS}}{175},c2\\$30366\\to \\frac{18\\,\\mathrm{cS}}{245}\\right\\}\\right\\}\\\\\\hline\\text{(a'/a, b'/b, c'/c) vs (z2/z1, z3/z1, z3/z2)} & \\mathrm{True}\\\\\\hline\\text{vacuum eigenvalue of t\\_\\{2,1\\}($\\theta$1), <e1 (x) e1| eigen?} & \\left\\{\\frac{210000}{6859},\\mathrm{True}\\right\\}\\\\\\hline\\text{C = vacuum eigenvalue} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "ef86cd5e-39ec-4725-a71e-acaf96f730a7"
    }
