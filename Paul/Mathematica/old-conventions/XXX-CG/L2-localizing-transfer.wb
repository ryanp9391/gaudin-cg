      {
       "data": "Out[973]= \\begin{array}{|c|c|}\\hline\\text{M = w (x) u exactly, t\\_\\{2,1\\}} & \\mathrm{True}\\\\\\hline\\text{M = w (x) u exactly, t\\_\\{1,1\\}} & \\mathrm{True}\\\\\\hline\\text{u (a, b, c) = (3/5, 4/7, -2/9)} & \\left\\{1,-\\frac{2}{9},\\frac{3}{5},-\\frac{74}{105},\\frac{46}{35},-\\frac{92}{315},-\\frac{24}{35},-\\frac{184}{245}\\right\\}\\\\\\hline\\text{w for t\\_\\{2,1\\}($\\theta$1)} & \\left\\{\\frac{210000}{6859},-\\frac{24000}{48013},\\frac{117600}{6859},-\\frac{71040}{48013},\\frac{132480}{48013},-\\frac{105984}{2352637},-\\frac{9216}{6859},-\\frac{1271808}{11763185}\\right\\}\\\\\\hline\\text{rotation fit of w, t\\_\\{2,1\\}} & \\left\\{\\left\\{cc\\$30310\\to \\frac{210000}{6859},a2\\$30310\\to \\frac{14}{25},b2\\$30310\\to \\frac{48}{1225},c2\\$30310\\to -\\frac{4}{245}\\right\\}\\right\\}\\\\\\hline\\text{w for t\\_\\{1,1\\}($\\theta$1)} & \\left\\{\\frac{8400}{361},-\\frac{960}{2527},\\frac{5040}{361},-\\frac{2880}{2527},\\frac{53248}{2527},-\\frac{8832}{17689},-\\frac{13824}{12635},-\\frac{105984}{88445}\\right\\}\\\\\\hline\\text{rotation fit of w, t\\_\\{1,1\\}} & \\{\\}\\\\\\hline\\text{w\\_\\{2,1\\} / w\\_\\{1,1\\} (componentwise)} & \\left\\{\\frac{25}{19},\\frac{25}{19},\\frac{70}{57},\\frac{74}{57},\\frac{1035}{7904},\\frac{12}{133},\\frac{70}{57},\\frac{12}{133}\\right\\}\\\\\\hline\\end{ar… [latex truncated: 1204 chars total]",
