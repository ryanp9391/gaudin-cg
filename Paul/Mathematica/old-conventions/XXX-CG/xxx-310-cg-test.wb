      {
       "data": "Out[920]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{site-1 weight of basis vector} & \\text{v\\_new component identically 0}\\\\\\hline\\left\\{4,2,0\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{4,1,1\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{4,0,2\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{3,3,0\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{3,2,1\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{3,1,2\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{3,2,1\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{3,1,2\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{3,0,3\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{2,4,0\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{2,3,1\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{2,2,2\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{2,3,1\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{2,2,2\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{2,1,3\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{2,2,2\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{2,1,3\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{2,0,4\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{1,4,1\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{1,3,2\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{1,3,2\\right\\} & \\mathrm{False}\\\\\\hline\\left\\{1,2,3\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{1,2,3\\right\\} & \\mathrm{True}\\\\\\hline\\left\\{1,1,4\\right\\} & \\mathrm{True}\\\\\\hline\\le… [latex truncated: 2083 chars total]",
       "mime": "text/plain"
