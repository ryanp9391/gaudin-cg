  {
   "kind": 2,
   "value": "(* ---- 2. Untwisting z_k = Exp[φ_k ε], leading order in ε separately in each weight space of V.\n   Series to ε^10; a component that is not identically zero but has no term through ε^10 is flagged (truncTooLowC).\n   Span of a family c(params): clear a common scalar denominator, then the coefficient vectors of all monomials in the free\n   parameters (k1, k2, p1, p2, φ, θ[1], h) span exactly the span of the values; its rank is compared with the dimension. ---- *)\nClearAll[wtC, sectorsC, leadWOf, leadWC, coefMatC, rankC, sampleRankC, truncTooLowC, nSerC];\nnSerC = 10;\nwtC = Transpose[Table[Diagonal[EC[i, i]], {i, 3}]];\nsectorsC = GatherBy[Range[dC], wtC[[#]] &];\n(* per-weight-space leading order of a family; returns <|weight -> {order, leading vector embedded in dC}|> and sets truncTooLowC *)\nleadWOf[vec_] := Module[{ser, ord},\n    ser = Table[Normal[Series[c /. z[k_] :> Exp[φ[k] ε], {ε, 0, nSerC}]], {c, vec}];\n    ord = Table[With[{cl = CoefficientList[Together[s], ε]}, With[{nz = Flatten @ Position[Simplify /@ cl, _?(# =!= 0 &), {1}, Heads -> False]}, If[nz === {}, Infinity, First[nz] - 1]]], {s, ser}];\n    truncTooLowC = Or @@ Table[ord[[n]] === Infinity && Simplify[vec[[n]]] =!= 0, {n, Length[vec]}];\n    Association @ Table[\n        With[{nW = Min[ord[[sec]]]},\n            wtC[[First[sec]]] -> {nW, Table[If[MemberQ[sec, n] && nW < Infinity, Simplify[Coefficient[ser[[n]], ε, nW]], 0], {n, dC}]}\n        ],\n        {sec, sectorsC}\n    ]\n];\ncoefMatC[vec_] := Module[{num = Together /@ vec, den, poly, vars, rules},\n    If[AllTrue[num, # === 0 &], Return[{ConstantArray[0, Length[vec]]}]];\n    den = PolynomialLCM @@ (Denominator /@ num);\n    poly = Expand[Together[# den]] & /@ num;\n    vars = Variables[poly];\n    If[vars === {}, Return[{poly}]];\n    rules = CoefficientRules[#, vars] & /@ poly;\n    With[{mons = Union @@ (Keys /@ rules)}, Transpose @ Table[Lookup[Association[r], mons, 0], {r, rules}]]\n];\nrankC[vec_] := MatrixRank[coefMatC[vec]];\nsampleRankC[vec_] := If[Variables[vec] === {}, MatrixRank[{vec}], MatrixRank[Table[vec /. Thread[Variables[vec] -> RandomInteger[{1, 97}, Length[Variables[vec]]] / RandomInteger[{1, 13}, Length[Variables[vec]]]], {25}]]];\n\nleadWC = leadWOf[vnewC];\nGrid[\n    Join[\n        {{\"weight μ\", \"dim V_μ\", \"leading ε order of v_new in V_μ\", \"rank\", \"sample-rank check\"}},\n        Table[\n            With[{w = wtC[[First[sec]]], lw = leadWC[wtC[[First[sec]]]]},\n                {w, Length[sec], lw[[1]], rankC[lw[[2]]], sampleRankC[lw[[2]]]}\n            ],\n            {sec, sectorsC}\n        ],\n        {{\"series order too low somewhere?\", truncTooLowC}}\n    ],\n    Frame -> All, Alignment -> Left\n]",
   "languageId": "wolfram",
   "outputs": [
