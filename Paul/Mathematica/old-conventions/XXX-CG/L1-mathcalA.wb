      {
       "data": "Out[3098]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{rep} & \\text{point} & \\text{r\\_n (coefficient of t[\\{1,1\\}], t[\\{2,2\\}], ...)} & \\text{max |second factor - 1 - sum r tau| over states} & \\text{max |v\\_old (1 + sum r t) - vTot|}\\\\\\hline2,1,0 & 1 & \\left\\{-k2\\right\\} & 0.\\times 10^{-88} & 0.\\times 10^{-88}\\\\\\hline3,1,0 & 1 & \\left\\{-k2\\right\\} & 0.\\times 10^{-87} & 0.\\times 10^{-86}\\\\\\hline3,2,0 & 1 & \\left\\{-2\\,k2,k2^2\\right\\} & 0.\\times 10^{-85} & 0.\\times 10^{-85}\\\\\\hline2,2,0 & 1 & \\left\\{-2\\,k2,k2^2\\right\\} & 0.\\times 10^{-87} & 0.\\times 10^{-87}\\\\\\hline4,2,0 & 1 & \\left\\{-2\\,k2,k2^2\\right\\} & 0.\\times 10^{-84} & 0.\\times 10^{-83}\\\\\\hline\\end{array}",
