       "data": "Out[3052]= \\begin{array}{|c|c|}\\hline\\text{GT pattern} & \\text{component of v . g0\\^{}-1}\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{2,1\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & 1-\\frac{5\\,k1}{2}\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{2,1\\right\\},\\left\\{2,1,0\\right\\}\\right\\} & \\frac{k1}{10}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "e21ca4ff-a612-476b-8ac0-e4f8c730696a"
    }
