  {
   "kind": 2,
   "value": "(* ---- 12. Any rep: vTot = P(ell(k1), pi(k2)) ?  P = equivariant projection of ell^(λ1-λ2) (x) pi^λ2 onto V_λ, with\n   V_λ embedded in W = V[d,0,0] (x) V[λ2,λ2,0] by equivariance (multiplicity one) and the complement removed with the Casimir.\n   vacL = P(ell0, pi0) is the flag of g0; the conjecture (read off from the adjoint, cell 19) is\n     ell(k1) = ell0 . (1 - k1 G),   pi(k2) = pi0 . (1 - kappa k2 Lambda^2 G),   G = diag(z),\n   i.e. k1 moves only the line and k2 only the plane. kappa is fit; resultsC is NOT cleared. ---- *)\nClearAll[dLA, repAA, repBA, EWA, PsiEmbA, casWA, casVA, projWA, g0RepA, diagRepA, omegaA, Pcov, kappaFitA, conjVecA, conjResA];\nIf[! AssociationQ[resultsC], resultsC = <||>];\ndLA = lamO[[1]] - lamO[[2]];\nrepAA = {dLA, 0, 0}; repBA = {lamO[[2]], lamO[[2]], 0};\n(* generators on W = A (x) B *)\nEWA[i_, j_] := KroneckerProduct[JJ[i, j, repAA], IdentityMatrix[dim[repBA]]] + KroneckerProduct[IdentityMatrix[dim[repAA]], JJ[i, j, repBA]];\n(* rows of V map to rows of W: E^V . Psi = Psi . E^W for all nine generators *)\nPsiEmbA = Quiet @ Module[{vars = Array[psiv, {dsO, dim[repAA] dim[repBA]}], sol},\n    sol = Solve[Thread[Flatten[Table[Ee[1][i, j] . vars - vars . EWA[i, j], {i, 3}, {j, 3}]] == 0], Flatten[vars]];\n    With[{P = vars /. First[sol]}, P /. Thread[Variables[P] -> 1]]];\ncasWA = Sum[EWA[i, j] . EWA[j, i], {i, 3}, {j, 3}];\ncasVA = First[Diagonal[Sum[Ee[1][i, j] . Ee[1][j, i], {i, 3}, {j, 3}]]];\n(* projector on rows of W onto the V_λ component (right action) *)\nprojWA = Module[{others = DeleteCases[Union[Eigenvalues[casWA]], casVA]},\n    Fold[#1 . (casWA - #2 IdentityMatrix[Length[casWA]]) / (casVA - #2) &, IdentityMatrix[Length[casWA]], others]];\n\n(* rep matrices of g0 (vacL's rotation) and of diagonal group elements *)\ng0RepA[rr_] := MatrixExp[p1 JJ[1, 2, rr]] . MatrixExp[p2 JJ[1, 3, rr]] . MatrixExp[p3 JJ[2, 3, rr]] /. rotparams /. ptO;\ndiagRepA[rr_, f_] := DiagonalMatrix[Table[f[Diagonal[JJ[1, 1, rr]][[n]], Diagonal[JJ[2, 2, rr]][[n]], Diagonal[JJ[3, 3, rr]][[n]]], {n, dim[rr]}]];\n(* covector ell^d (x) pi^λ2; line deformed by (1 - k1 z_i), plane by (1 - kap k2 z_j z_k) on the Lambda^2 weight e_j + e_k *)\nomegaA[kap_] := Module[{zz = {z[1], z[2], z[3]} /. ptO, a},\n    a[i_, j_] := 1 - kap k2 zz[[i]] zz[[j]];\n    KroneckerProduct[\n        {UnitVector[dim[repAA], 1] . g0RepA[repAA] . diagRepA[repAA, Function[{m1, m2, m3}, Times @@ ((1 - k1 zz)^{m1, m2, m3})]]},\n        {UnitVector[dim[repBA], 1] . g0RepA[repBA] . diagRepA[repBA, Function[{m1, m2, m3},\n            a[1, 2]^(lamO[[2]] - m3) a[1, 3]^(lamO[[2]] - m2) a[2, 3]^(lamO[[2]] - m1)]]}] // Flatten];\n(* P(ell, pi): the V_λ covector v with v . Psi = omega . proj *)\nPcov[kap_] := LinearSolve[Transpose[PsiEmbA], omegaA[kap] . projWA];\n\n(* fit kappa at one (k1, k2) by requiring vTot parallel to P, then test all orders *)\nkappaFitA = Module[{pv = Pcov[kap] /. {k1 -> 1/7, k2 -> 2/9}, tv = ratPolyA /@ vTotA /. {k1 -> 1/7, k2 -> 2/9}, sols},\n    sols = Solve[Thread[Flatten[Minors[{pv, tv}, 2]] == 0], kap];\n    If[sols === {}, \"none\", kap /. sols]];\nconjVecA = If[ListQ[kappaFitA], Pcov[First[kappaFitA]], 0];\n(* compare up to the overall scalar, fixed by the first component *)\nconjResA = If[ListQ[kappaFitA], Union[Flatten[Together[conjVecA / conjVecA[[1]] - (ratPolyA /@ vTotA) / (ratPolyA /@ vTotA)[[1]]]]], \"-\"];\nresultsC[lamO] = {kappaFitA, conjResA === {0}, If[ListQ[kappaFitA], Factor[(ratPolyA /@ vTotA)[[1]] / conjVecA[[1]]], \"-\"]};\n\nGrid[\n    Prepend[\n        Join[\n            {{\"V_λ embeds in W (Psi rank)\", MatrixRank[PsiEmbA] == dsO}, {\"vacL = P(ell0, pi0) (k1 = k2 = 0, up to scale)\",\n                MatrixRank[{Pcov[0] /. {k1 -> 0, k2 -> 0}, ratPolyA /@ vacLO}] == 1}},\n            KeyValueMap[{Row[#1, \",\"], #2} &, resultsC]],\n        {\"\", \"{kappa, vTot = P(ell(k1), pi(k2)) exactly (all k1, k2), scalar vTot/P}\"}\n    ],\n    Frame -> All, Alignment -> Left\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"557203\" data-output-id=\"276\" data-out-n=\"3130\" data-sub-idx=\"26\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"20\" data-sub-start=\"43\" data-sub-end=\"52\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[3130]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"26\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.66em;vertical-align:-4.56em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.1em;\"><span style=\"top:-7.06em;\"><span class=\"pstrut\" style=\"height:7.06em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:9.62em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.56em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.06em;\"><span style=\"top:-7.22em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span style=\"top:-6.02em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">V_</span><span class=\"mord mathnormal\">λ</span><span class=\"mord\"> embeds in W (Psi rank)</span></span></span></span><span style=\"top:-4.82em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">vacL = P(ell0, pi0) (k1 = k2 = 0, up to scale)</span></span></span></span><span style=\"top:-3.61em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-2.4em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:-1.2em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:0em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span><span style=\"top:1.2em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">4</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class