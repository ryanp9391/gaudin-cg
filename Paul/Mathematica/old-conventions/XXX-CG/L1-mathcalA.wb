      {
       "data": "Out[3112]= \\begin{array}{|c|c|}\\hline\\text{intertwiner unique up to scale} & \\mathrm{True}\\\\\\hline\\text{vacL: \\{Tr M, rank M, M.M = 0\\}  (coherent: nilpotent rank 1)} & \\left\\{0,1,\\mathrm{True}\\right\\}\\\\\\hline\\text{v (Q\\_1 part only) at k1 = 1/7: \\{Tr M, rank M, M.M = 0\\}} & \\left\\{0,1,\\mathrm{True}\\right\\}\\\\\\hline\\text{vTot at k1 = 1/7, k2 = 2/9: \\{c, rank(M + c Id)\\}} & \\left\\{\\frac{326}{19845},1\\right\\}\\\\\\hline\\text{vTot at k1 = -3/5, k2 = 5/4: \\{c, rank(M + c Id)\\}} & \\left\\{\\frac{163}{1764},1\\right\\}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
