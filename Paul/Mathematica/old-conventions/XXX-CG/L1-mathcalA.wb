      {
       "data": "Out[3047]= \\begin{array}{|c|c|}\\hline\\text{rep $\\Lambda$[1]} & 2,1,0\\\\\\hline\\text{poles ($\\theta$ + n h)} & \\left\\{\\frac{4}{3},\\frac{7}{3}\\right\\}\\\\\\hline\\text{residues of mu} & \\left\\{-1,1\\right\\}\\\\\\hline\\text{Nn} & -1\\\\\\hline\\text{c\\_m = f-ratio coefficients} & \\left\\{1,-1\\right\\}\\\\\\hline\\text{degree of A\\_A in k1} & \\left\\{1\\right\\}\\\\\\hline\\text{k1\\^{}0 part of v = vacL} & 0.\\times 10^{-94}\\\\\\hline\\text{max |v . Psi\\_A - A\\_A|} & 0.\\times 10^{-93}\\\\\\hline\\end{array}",
