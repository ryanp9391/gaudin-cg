      {
       "data": "Out[3071]= \\begin{array}{|c|c|}\\hline\\text{rep $\\Lambda$[1]} & 2,1,0\\\\\\hline\\text{poles of mu\\_2 (first = $\\theta$)} & \\left\\{\\frac{1}{3},\\frac{4}{3}\\right\\}\\\\\\hline\\text{residues of mu\\_2} & \\left\\{-1,1\\right\\}\\\\\\hline\\text{Nn2} & -1\\\\\\hline\\text{c\\_m (second factor)} & \\left\\{1,-1\\right\\}\\\\\\hline\\text{min |Q\\_12($\\theta$)| over states (must be nonzero)} & 0.103\\\\\\hline\\text{degree of second factor in k2} & \\left\\{1\\right\\}\\\\\\hline\\text{k2\\^{}0 part of vTot = previous v} & 0.\\times 10^{-90}\\\\\\hline\\text{max |vTot . Psi\\_A - A\\_A|} & 0.\\times 10^{-89}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
