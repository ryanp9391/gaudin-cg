       "data": "Out[3171]= \\begin{array}{|c|c|}\\hline\\text{tG[2]($\\theta$) = h\\^{}2 sum z\\_i z\\_j [E\\_ii(1+E\\_jj) - E\\_ij E\\_ji]  (symbolic)} & \\mathrm{True}\\\\\\hline\\text{vacL (p1, p2, p3) at this point} & \\left\\{\\frac{3}{5},\\frac{4}{7},-\\frac{1630}{1589}\\right\\}\\\\\\hline\\text{vacL itself: \\{C, a, b, c\\} (sanity: C = 1, a = p1, b = p2, c = p3)} & \\left\\{1,\\frac{3}{5},\\frac{4}{7},-\\frac{1630}{1589}\\right\\}\\\\\\hline\\text{vTot (k1, k2 symbolic): \\{C, a, b, c\\}} & \\text{not coherent}\\\\\\hline\\text{vTot at k1 = 0: \\{C, a, b, c\\}} & \\text{not coherent}\\\\\\hline\\text{vacL . t[\\{1,1\\}]($\\theta$): \\{C, a, b, c\\}} & \\text{not coherent}\\\\\\hline\\text{v . t[\\{1,1\\}]($\\theta$) (k1 symbolic): \\{C, a, b, c\\}} & \\text{not coherent}\\\\\\hline\\end{array}",
