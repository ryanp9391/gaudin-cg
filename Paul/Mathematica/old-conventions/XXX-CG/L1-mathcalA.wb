  {
   "kind": 2,
   "value": "(* ---- 2. Twisted Q's of every state from the direct and dual Baxter equations. ---- *)\nClearAll[nuO, BaxDirO, BaxDualO, qpolyO, solveMonicO, QsO, QDO, QUO];\nnuO[i_][x_] := ν[i][x] /. ptO;\n\n(* t1, t2, t3 are the polynomial eigenvalues of tG[a]; the ν factors make every term polynomial *)\nBaxDirO[{t1_, t2_, t3_}, zz_][q_][x_] :=\n    zz nuO[1][x] nuO[1][x - hO] nuO[1][x - 2 hO] q[x + hO] - (t1 /. u -> x) nuO[1][x - hO] nuO[1][x - 2 hO] q[x]\n    + (t2 /. u -> x) nuO[1][x - 2 hO] q[x - hO] / zz - (t3 /. u -> x) q[x - 2 hO] / zz^2;\nBaxDualO[{t1_, t2_, t3_}, y_][g_][x_] :=\n    nuO[3][x + hO] nuO[3][x + 2 hO] nuO[3][x + 3 hO] g[x] - y (t1 /. u -> x + hO) nuO[3][x + 2 hO] nuO[3][x + 3 hO] g[x + hO]\n    + y^2 (t2 /. u -> x + 2 hO) nuO[3][x + 3 hO] g[x + 2 hO] - y^3 (t3 /. u -> x + 3 hO) g[x + 3 hO];\n\nqpolyO[cl_List, y_] := Fold[#1 y + #2 &, 0, Reverse[cl]];\n(* monic polynomial solution of op[q] = 0 by least squares; returns {coefficients, relative residual} *)\nsolveMonicO[op_, degree_] := Module[{c, x, q, eqs, aa, bb, sol, res, scale},\n    q = Function[y, Evaluate[y^degree + Sum[c[m] y^m, {m, 0, degree - 1}]]];\n    eqs = CoefficientList[Expand[op[q][x]], x];\n    aa = Table[Coefficient[e, c[m]], {e, eqs}, {m, 0, degree - 1}];\n    bb = eqs /. c[_] -> 0;\n    sol = If[degree == 0, {}, LeastSquares[aa, -bb]];\n    res = If[degree == 0, bb, aa . sol + bb];\n    scale = Max[Join[{1}, Abs @ Flatten[{aa, bb}]]];\n    {Append[sol, 1], Max[Abs[res]] / scale}\n];\n\nQsO = Table[\n    With[{qs = Table[solveMonicO[BaxDirO[s[\"t\"], zO[[i]]], lamO[[1]] - s[\"mu\"][[i]]], {i, 3}],\n          qds = Table[solveMonicO[BaxDualO[s[\"t\"], 1 / zO[[j]]], s[\"mu\"][[j]]], {j, 3}]},\n        <|\"q\" -> qs[[All, 1]], \"qd\" -> qds[[All, 1]], \"bRes\" -> Max[Join[qs[[All, 2]], qds[[All, 2]]]]|>\n    ],\n    {s, statesO}\n];\n\n(* full twisted Q's, exponentials kept *)\nQDO[A_, i_, x_] := zO[[i]]^(x / hO) qpolyO[QsO[[A, \"q\", i]], x];\nQUO[A_, j_, x_] := zO[[j]]^(-x / hO) qpolyO[QsO[[A, \"qd\", j]], x];\n\nGrid[{{\"max Baxter residual (direct deg λ1-μi, dual deg μj)\", N[Max[QsO[[All, \"bRes\"]]], 3]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"557203\" data-output-id=\"266\" data-out-n=\"3034\" data-sub-idx=\"13\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"9\" data-sub-start=\"37\" data-sub-end=\"37\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[3034]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"26\" data-latex-b64=\"XGJlZ2lue2FycmF5fXt8Y3xjfH1caGxpbmVcdGV4dHttYXggQmF4dGVyIHJlc2lkdWFsIChkaXJlY3QgZGVnICRcbGFtYmRhJDEtJFxtdSRpLCBkdWFsIGRlZyAkXG11JGopfSAmIDAuXHRpbWVzIDEwXnstOTN9XFxcaGxpbmVcZW5ke2FycmF5fQ==\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.24em;vertical-align:-0.35em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.89em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:1.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">max Baxter residual (direct deg </span><span class=\"mord mathnormal\">λ</span><span class=\"mord\">1-</span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">i, dual deg </span><span class=\"mord mathnormal\">μ</span><span class=\"mord\">j)</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:1.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.35em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.85em;\"><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">0.</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">93</span></span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:1.2em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-0.35em;\"></span></span></span><span style=\"top:-2.65em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.85em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.35em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[3034]= \\begin{array}{|c|c|}\\hline\\text{max Baxter residual (direct deg $\\lambda$1-$\\mu$i, dual deg $\\mu$j)} & 0.\\times 10^{-93}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "7f245e50-2d76-4aab-9878-b1627042d21f"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 3. A_A = <k1^{u/h} Q_1^A> with mu = 1/(ν1(u) ν1(u+h) ... ν1(u+(λ1-λ2)h)): poles at θ + n h, n = λ2..λ1, normalized by f at the\n   lowest pole θ + λ2 h, with Nn making the constant term 1. Then the unique covector v with v . Psi_A = A_A. ---- *)\nClearAll[muA, polesA, resMuA, NnA, cA, fA, calA, PsiMatA, vA, v0A, degA];\ndegA = lamO[[1]] - lamO[[2]];\nmuA[x_] := 1 / Product[nuO[1][x + k hO], {k, 0, degA}];\npolesA = thO + hO Range[lamO[[2]], lamO[[1]]];\nresMuA = Table[Residue[muA[x], {x, p}], {p, polesA}];\nNnA = 1 / resMuA[[1]];\ncA = resMuA / resMuA[[1]];\n\nfA[A_, x_] := k1^(x / hO) QDO[A, 1, x];\ncalA = Table[Expand[NnA / fA[A, polesA[[1]]] Sum[resMuA[[m]] fA[A, polesA[[m]]], {m, Length[polesA]}]], {A, Length[statesO]}];\n\n(* columns are the kets; v . PsiMat = A row *)\nPsiMatA = Transpose[statesO[[All, \"ket\"]]];\nvA = Expand[calA . Inverse[PsiMatA]];\nv0A = Coefficient[vA, k1, 0];\n\nGrid[\n    {\n        {\"rep Λ[1]\", Row[lamO, \",\"]},\n        {\"poles (θ + n h)\", polesA},\n        {\"residues of mu\", resMuA},\n        {\"Nn\", NnA},\n        {\"c_m = f-ratio coefficients\", cA},\n        {\"degree of A_A in k1\", Union[Exponent[#, k1] & /@ calA]},\n        {\"k1^0 part of v = vacL\", N[Max[Abs[v0A - vacLO]], 3]},\n        {\"max |v . Psi_A - A_A|\", N[Max[Abs[Flatten[CoefficientList[vA . PsiMatA - calA, k1]]]], 3]}\n    },\n    Frame -> All, Alignment -> Left\n]",
   "languageId": "wolfram",
   "outputs": [
    {
