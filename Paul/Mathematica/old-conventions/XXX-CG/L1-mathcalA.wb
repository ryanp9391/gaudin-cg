       "data": "Out[3164]= \\begin{array}{|c|c|}\\hline\\text{(a) Cauchy-Binet: t2\\^{}G(u) = tG[2](u)} & \\mathrm{True}\\\\\\hline\\text{(b) rho(g1) t2\\^{}G rho(g1)\\^{}-1 = t2\\^{}\\{G1\\} for G1 = \\{g G g\\^{}-1, g\\^{}-1 G g, g\\^{}T G g\\^{}-T, g\\^{}-T G g\\^{}T\\}} & \\left\\{\\mathrm{True},\\mathrm{False},\\mathrm{False},\\mathrm{False}\\right\\}\\\\\\hline\\text{<v1| = c e1\\^{}T rho(g1) at k1 = 1/7} & \\mathrm{True}\\\\\\hline\\text{(c) <v1| t2\\^{}G($\\theta$) = c e1\\^{}T t2\\^{}\\{G1\\}($\\theta$) rho(g1)} & \\mathrm{True}\\\\\\hline\\text{(c') e1\\^{}T t2\\^{}\\{G1\\}($\\theta$) = sum\\_I det G1[\\{1,2\\}, I] e1\\^{}T qminor\\_\\{I,\\{1,2\\}\\}($\\theta$)} & \\mathrm{True}\\\\\\hline\\text{G1 = g1 G g1\\^{}-1 (upper triangular, diagonal = z)} & \\begin{pmatrix}\\frac{5}{2} & -\\frac{14}{135} & \\frac{326}{6615}\\\\0 & \\frac{7}{3} & \\frac{326}{147}\\\\0 & 0 & \\frac{6}{35}\\end{pmatrix}\\\\\\hline\\end{array}",
