  {
   "kind": 2,
   "value": "(* ---- 3. Twisted Q's of every state: direct deg 2 lambda1 - mu_i, dual deg mu_j, monic; same Baxter operators as L1-mathcalA with the L = 2 nu's. ---- *)\nClearAll[BaxDirT, BaxDualT, qpolyT, solveMonicT, QsT, QdT, QuT];\nBaxDirT[{t1_, t2_, t3_}, zz_][q_][x_] :=\n    zz nuT[1][x] nuT[1][x - hT] nuT[1][x - 2 hT] q[x + hT] - (t1 /. u -> x) nuT[1][x - hT] nuT[1][x - 2 hT] q[x]\n    + (t2 /. u -> x) nuT[1][x - 2 hT] q[x - hT] / zz - (t3 /. u -> x) q[x - 2 hT] / zz^2;\nBaxDualT[{t1_, t2_, t3_}, y_][g_][x_] :=\n    nuT[3][x + hT] nuT[3][x + 2 hT] nuT[3][x + 3 hT] g[x] - y (t1 /. u -> x + hT) nuT[3][x + 2 hT] nuT[3][x + 3 hT] g[x + hT]\n    + y^2 (t2 /. u -> x + 2 hT) nuT[3][x + 3 hT] g[x + 2 hT] - y^3 (t3 /. u -> x + 3 hT) g[x + 3 hT];\nqpolyT[cl_List, y_] := Fold[#1 y + #2 &, 0, Reverse[cl]];\nsolveMonicT[op_, degree_] := Module[{c, x, q, eqs, aa, bb, sol, res, scale},\n    q = Function[y, Evaluate[y^degree + Sum[c[m] y^m, {m, 0, degree - 1}]]];\n    eqs = CoefficientList[Expand[op[q][x]], x];\n    aa = Table[Coefficient[e, c[m]], {e, eqs}, {m, 0, degree - 1}];\n    bb = eqs /. c[_] -> 0;\n    sol = If[degree == 0, {}, LeastSquares[aa, -bb]];\n    res = If[degree == 0, bb, aa . sol + bb];\n    scale = Max[Join[{1}, Abs @ Flatten[{aa, bb}]]];\n    {Append[sol, 1], Max[Abs[res]] / scale}\n];\nQsT = Table[\n    With[{qs = Table[solveMonicT[BaxDirT[s[\"t\"], N[zT[[i]], precT]], 2 repT[[1]] - s[\"mu\"][[i]]], {i, 3}],\n          qds = Table[solveMonicT[BaxDualT[s[\"t\"], 1 / N[zT[[j]], precT]], s[\"mu\"][[j]]], {j, 3}]},\n        <|\"q\" -> qs[[All, 1]], \"qd\" -> qds[[All, 1]], \"bRes\" -> Max[Join[qs[[All, 2]], qds[[All, 2]]]]|>\n    ],\n    {s, statesT}\n];\n(* full twisted Q's, exponentials kept *)\nQdT[A_, i_, x_] := N[zT[[i]], precT]^(x / hT) qpolyT[QsT[[A, \"q\", i]], x];\nQuT[A_, j_, x_] := N[zT[[j]], precT]^(-x / hT) qpolyT[QsT[[A, \"qd\", j]], x];\n\nGrid[{{\"max relative Baxter residual (direct and dual, 64 states)\", N[Max[QsT[[All, \"bRes\"]]], 3]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
