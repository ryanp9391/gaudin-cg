       "data": "Out[470]= \\begin{array}{|c|c|}\\hline\\text{quantity} & \\text{value}\\\\\\hline\\text{best shift s (all states)} & \\left\\{-3,0\\right\\}\\\\\\hline\\text{max relative remainder} & 0\\\\\\hline\\text{leading coefficient of F (all states)} & \\left\\{\\frac{28571}{1000000}\\right\\}\\\\\\hline\\text{deg F (all states)} & \\left\\{2\\right\\}\\\\\\hline\\end{array}",
