       "data": "Out[1422]= \\begin{array}{|c|c|}\\hline\\text{site rep} & \\left\\{3,2,0\\right\\}\\\\\\hline\\text{Omega is an eigenvector of t1..t3} & \\mathrm{True}\\\\\\hline\\text{exact kappa2 at the current point vs numeric kappa2 (cell 7)} & 0.\\times 10^{-90}\\\\\\hline\\text{point }1\\text{ (h = }1\\text{): Z's cancel, kappa2 / shape} & \\left\\{\\mathrm{True},1\\right\\}\\\\\\hline\\text{point }2\\text{ (h = }\\frac{1}{2}\\text{): Z's cancel, kappa2 / shape} & \\left\\{\\mathrm{True},\\frac{1}{262144}\\right\\}\\\\\\hline\\text{point }3\\text{ (h = }\\frac{3}{4}\\text{): Z's cancel, kappa2 / shape} & \\left\\{\\mathrm{True},\\frac{387420489}{68719476736}\\right\\}\\\\\\hline\\end{array}",
