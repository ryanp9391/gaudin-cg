      },
      {
       "data": "Out[1409]= \\begin{array}{|c|c|}\\hline\\text{\\# poles} & 8\\\\\\hline\\text{det N: max|offdiag| / min|diag|} & 1.17\\times 10^{-62}\\\\\\hline\\text{min |c\\^{}ref|, min |Psi\\^{}ref|} & \\left\\{0.252,0.0396\\right\\}\\\\\\hline\\text{kappa2} & 28.82448921976436731-536.22843212821339109\\,\\mathrm{i}\\\\\\hline\\text{max |S\\_Q - <Psi\\_A|Psi\\_B>| / max|<Psi\\_A|Psi\\_A>|} & 1.03\\times 10^{-96}\\\\\\hline\\text{max relative diagonal residual} & 0.\\times 10^{-83}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "b76649dd-1160-41f3-b5fa-f8758edc1d3d"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 5. Exact kappa2 = c^ref_Omega Psi^ref_Omega / det N^{Omega Omega} (since <Omega|Omega> = 1). Only Omega = e1 (x) e1 enters.\n   Its transfer-matrix eigenvalues are computed with symbolic z, θ[1], θ[2], h; its Baxter Q's are solved exactly at each rational point.\n   Exponentials stay symbols, z_i^(θ_s/h) -> Z[i, s] and Exp[2 Pi I θ_s/h] -> e[s], with the integer part n of a pole θ_s + n h explicit.\n   Closed form: kappa2 = sgn h^a kappa1^2 [prod_{n=-λ1..λ1} (θ12 - n h)]^3 / (e[1] - e[2])^3; sgn, a read off per rep (last rows). ---- *)\nClearAll[OmS, TvS, qminVS, tauS, nuS, BaxDirS, BaxDualS, solveExactS, kappa2At, kappa2Shape, ptsS];\nOmS = UnitVector[dcT, 1];\n(* T_ij(x) vec = sum_k L1_ik(x - θ1) L2_kj(x - θ2) vec *)\nTvS[i_, j_, x_, vec_] := Sum[\n    With[{w = (x - θ[2]) KroneckerDelta[k, j] vec - h E2T[j, k] . vec}, (x - θ[1]) KroneckerDelta[i, k] w - h E1T[k, i] . w],\n    {k, 3}\n];\n(* principal quantum minor on a vector: rows permuted, k-th column at u - (k-1) h, rightmost factor acts first *)\nqminVS[II_, vec_] := Sum[\n    Signature[s] Fold[Function[{acc, k}, TvS[II[[s[[k]]]], II[[k]], u - (k - 1) h, acc]], vec, Reverse @ Range[Length[II]]],\n    {s, Permutations[Range[Length[II]]]}\n];\ntauS = Table[\n    With[{vs = Expand @ Sum[(Times @@ (z /@ II)) qminVS[II, OmS], {II, Subsets[Range[3], {a}]}]},\n        If[Expand[vs - vs[[1]] OmS] =!= ConstantArray[0, dcT], $Failed, Factor[vs[[1]]]]\n    ],\n    {a, 3}\n];\nnuS[n_][x_] := Product[x - θ[s] - h repT[[n]], {s, 2}];\nBaxDirS[zz_][q_][x_] :=\n    zz nuS[1][x] nuS[1][x - h] nuS[1][x - 2 h] q[x + h] - (tauS[[1]] /. u -> x) nuS[1][x - h] nuS[1][x - 2 h] q[x]\n    + (tauS[[2]] /. u -> x) nuS[1][x - 2 h] q[x - h] / zz - (tauS[[3]] /. u -> x) q[x - 2 h] / zz^2;\nBaxDualS[y_][g_][x_] :=\n    nuS[3][x + h] nuS[3][x + 2 h] nuS[3][x + 3 h] g[x] - y (tauS[[1]] /. u -> x + h) nuS[3][x + 2 h] nuS[3][x + 3 h] g[x + h]\n    + y^2 (tauS[[2]] /. u -> x + 2 h) nuS[3][x + 3 h] g[x + 2 h] - y^3 (tauS[[3]] /. u -> x + 3 h) g[x + 3 h];\n(* monic exact solution at the point given by rules r; the system is overdetermined, so Solve also certifies existence *)\nsolveExactS[op_, degree_, r_] := Module[{c, x, q, sol},\n    q = Function[y, Evaluate[y^degree + Sum[c[m] y^m, {m, 0, degree - 1}]]];\n    sol = If[degree == 0, {{}}, Solve[Thread[CoefficientList[Numerator[Together[op[q][x] /. r]], x] == 0], Table[c[m], {m, 0, degree - 1}]]];\n    If[sol === {}, $Failed, Function[y, Evaluate[q[y] /. First[sol]]]]\n];\n\n(* exact kappa2 at a point {z, {θ1, θ2}, h}; Z and e stay symbolic *)\nkappa2At[pt_] := Module[{r, zz = pt[[1]], th = pt[[2]], hh = pt[[3]], lam = repT, qP, gP, Qd, Qu, poles, w, row, psiRef, cRef},\n    r = {z[i_] :> pt[[1, i]], θ[s_] :> pt[[2, s]], h -> pt[[3]]};\n    qP = Table[solveExactS[BaxDirS[z[i]], 2 lam[[1]] - 2 lam[[i]], r], {i, 3}];\n    gP = Table[solveExactS[BaxDualS[1 / z[j]], 2 lam[[j]], r], {j, 3}];\n    If[! FreeQ[{qP, gP}, $Failed], Return[$Failed]];\n    (* Q at θ_s + n h *)\n    Qd[i_, s_, n_] := Z[i, s] zz[[i]]^n qP[[i]][th[[s]] + n hh];\n    Qu[j_, s_, n_] := zz[[j]]^(-n) / Z[j, s] gP[[j]][th[[s]] + n hh];\n    poles = Flatten[Table[{s, n}, {s, 2}, {n, lam[[3]], lam[[1]]}], 1];\n    w[{s_, n_}] := 1 / Times @@ ((th[[s]] + n hh) - (th[[#[[1]]]] + #[[2]] hh) & /@ DeleteCases[poles, {s, n}]);\n    row[{alpha_, {i_, j_}}] := Sum[\n        With[{s = p[[1]], n = p[[2]]}, With[{x = th[[s]] + n hh},\n            w[p] e[s]^(alpha - 1) Flatten @ Table[x^beta {-Qu[j, s, n] Qd[i, s, n], Qu[j, s, n] Qd[i, s, n - 1], Qu[j, s, n + 1] Qd[i, s, n]}, {beta, 0, 1}]\n        ]],\n        {p, poles}\n    ];\n    psiRef = Product[Qd[1, s, lam[[2]]] (Qd[1, s, 0] Qd[2, s, -1] - Qd[2, s, 0] Qd[1, s, -1]), {s, 2}];\n    cRef = Product[Qu[3, s, lam[[2]]] (Qu[3, s, lam[[1]]] Qu[2, s, lam[[1]] + 1] - Qu[2, s, lam[[1]]] Qu[3, s, lam[[1]] + 1]), {s, 2}];\n    Factor[Together[psiRef cRef / Det[Map[Together, row /@ rowKeysT, {2}]]]]\n];\n(* the conjectured shape without sgn h^a *)\nkappa2Shape[zz_, {t1_, t2_}, hh_] := With[{t12 = t1 - t2, l = repT},\n    (l[[1]]!^3 / ((zz[[2]] - zz[[1]])^(l[[1]] - l[[2]]) (zz[[1]] - zz[[3]])^(l[[1]] - l[[3]]) (zz[[2]] - zz[[3]])^(l[[2]] - l[[3]])))^2\n    Product[t12 - n hh, {n, -l[[1]], l[[1]]}]^3 / (e[1] - e[2])^3\n];\nptsS = Table[{p[[3]], p[[2]], p[[1]]}, {p, ptListT}];\n\nGrid[\n    Join[\n        {\n            {\"site rep\", repT},\n            {\"Omega is an eigenvector of t1..t3\", FreeQ[tauS, $Failed]},\n            {\"exact kappa2 at the current point vs numeric kappa2 (cell 7)\", N[Abs[(kappa2At[{zT, thT, hT}] /. e[s_] :> Exp[2 Pi I thT[[s]] / hT]) / kappa2T - 1], 3]}\n        },\n        Table[With[{k2 = kappa2At[ptsS[[k]]]}, {Row[{\"point \", k, \" (h = \", ptsS[[k, 3]], \"): Z's cancel, kappa2 / shape\"}], {FreeQ[k2, Z], Factor[k2 / kappa2Shape @@ ptsS[[k]]]}}], {k, 3}]\n    ],\n    Frame -> All, Alignment -> Left\n]",
   "languageId": "wolfram",
   "outputs": [
