      {
       "data": "Out[476]= \\begin{array}{|c|c|c|c|}\\hline\\text{(a, b, c)} & \\text{max rel. remainder} & \\text{quotient / F (all states)} & \\text{1/z\\_b - 1/z\\_a}\\\\\\hline\\left\\{1,2,3\\right\\} & 0 & \\left\\{\\frac{28571428571428571428571428571}{1000000000000000000000000000000}\\right\\} & \\frac{1}{35}\\\\\\hline\\left\\{1,3,2\\right\\} & 0 & \\left\\{\\frac{5433333333333333333333333333333}{1000000000000000000000000000000}\\right\\} & \\frac{163}{30}\\\\\\hline\\left\\{2,3,1\\right\\} & 2\\times 10^{-93} & \\left\\{\\frac{2702380952380952380952380952381}{500000000000000000000000000000}\\right\\} & \\frac{227}{42}\\\\\\hline\\end{array}",
