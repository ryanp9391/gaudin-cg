      {
       "data": "Out[106]= \\begin{array}{|c|c|c|}\\hline\\text{target  (times A\\_A = <k1 Q1>)} & \\text{max |ratio|} & \\text{span residual per k1-order}\\\\\\hline\\text{Q12($\\theta$1+h)/Q12($\\theta$1)  [known: in span]} & 1.15 & \\left\\{0.\\times 10^{-81},0.\\times 10^{-81}\\right\\}\\\\\\hline\\text{Q12($\\theta$1+2h)/Q12($\\theta$1)} & 0.\\times 10^{-84} & \\left\\{0,0\\right\\}\\\\\\hline\\text{Q\\^{}3($\\theta$1+h)/Q\\^{}3($\\theta$1)} & 6.68 & \\left\\{0.\\times 10^{-86},0.\\times 10^{-86}\\right\\}\\\\\\hline\\text{Q\\^{}3($\\theta$1+2h)/Q\\^{}3($\\theta$1)} & 112 & \\left\\{0.589,0.0566\\right\\}\\\\\\hline\\text{Q\\^{}3($\\theta$1+2h)/Q\\^{}3($\\theta$1+h)} & 5620 & \\left\\{0.0698,0.137\\right\\}\\\\\\hline\\text{Q\\^{}3($\\theta$1+2h)/Q\\^{}3($\\theta$1) + a Q\\^{}3($\\theta$1+h)/Q\\^{}3($\\theta$1) + b} & \\text{-} & 0.589\\\\\\hline\\text{Q\\^{}3($\\theta$1+2h)/Q\\^{}3($\\theta$1+h) + a Q\\^{}3($\\theta$1)/Q\\^{}3($\\theta$1+h) + b} & \\text{-} & 0.0684\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
