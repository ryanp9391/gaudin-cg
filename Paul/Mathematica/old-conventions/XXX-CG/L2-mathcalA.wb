       "data": "Out[86]= \\begin{array}{|c|c|}\\hline\\text{site rep, point} & \\left\\{\\left\\{2,1,0\\right\\},1\\right\\}\\\\\\hline\\text{min |Q\\_12($\\theta$1)| over states} & 0.0732\\\\\\hline\\text{c\\_m, m = 0..$\\lambda$2 (fitted)} & \\left\\{1,\\frac{29}{10}\\right\\}\\\\\\hline\\text{spread of c\\_m over states and k1} & \\left\\{0.\\times 10^{-86},0.\\times 10^{-83}\\right\\}\\\\\\hline\\text{rho\\_m = p($\\theta$1 + m h)/p($\\theta$1)} & \\left\\{1,\\frac{29}{10}\\right\\}\\\\\\hline\\text{max |A\\_A F\\_A - <v1 vacL| sum\\_m (-1)\\^{}m binom k2\\^{}m t\\_mm (x) 1 |Psi\\_A>|, all orders in k1, k2} & 0.\\times 10^{-84}\\\\\\hline\\end{array}",
