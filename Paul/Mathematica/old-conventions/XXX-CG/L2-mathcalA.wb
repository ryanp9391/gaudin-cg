  {
   "kind": 2,
   "value": "(* ---- 8. Relation Q_12 <-> Q^3. Q_12 = (z1 z2)^{u/h} p12(u) = z3^{-u/h} p12(u), p12 = q1(u) q2(u-h)/z2 - q2(u) q1(u-h)/z1 (polynomial).\n   Test p12(u) = F(u) q^3(u + s h) with a state-independent F: for each shift s find the one where q^3(u + s h) divides p12, and read off F. ---- *)\nClearAll[p12Poly, q3Poly, divTest, relTable];\np12Poly[A_] := Expand[qpolyT[QsT[[A, \"q\", 1]], u] (qpolyT[QsT[[A, \"q\", 2]], u - hT] / N[zT[[2]], precT]) - qpolyT[QsT[[A, \"q\", 2]], u] (qpolyT[QsT[[A, \"q\", 1]], u - hT] / N[zT[[1]], precT])];\nq3Poly[A_, s_] := Expand[qpolyT[QsT[[A, \"qd\", 3]], u + s hT]];\ndivTest[A_, s_] := With[{pr = PolynomialQuotientRemainder[p12Poly[A], q3Poly[A, s], u]}, {Max[Join[{0}, Abs[CoefficientList[pr[[2]], u]]]] / Max[Abs[CoefficientList[p12Poly[A], u]]], pr[[1]]}];\n(* for every state: remainder at s = -3..3, then the quotient F at the best shift, normalized monic, and its roots in units (u - θ_s)/h *)\nrelTable = Table[Module[{res = Table[divTest[A, s], {s, -3, 3}], best, F},\n    best = First @ Ordering[res[[All, 1]], 1];\n    F = res[[best, 2]];\n    {statesT[[A, \"mu\"]], best - 4, N[res[[best, 1]], 3], N[Coefficient[F, u, Exponent[F, u]], 8], Sort @ Chop[N[Flatten[Table[(x - thT[[s]]) / hT, {s, 2}, {x, u /. NSolve[F == 0, u]}]], 6], 10^-20]}], {A, dcT}];\nGrid[Prepend[{\n    {\"best shift s (all states)\", Union[relTable[[All, 2]]]},\n    {\"max relative remainder\", Max[relTable[[All, 3]]]},\n    {\"leading coefficient of F (all states)\", Union[Round[relTable[[All, 4]], 10^-6]]},\n    {\"deg F (all states)\", Union[Table[Exponent[divTest[A, relTable[[A, 2]]][[2]], u], {A, dcT}]]}\n}, {\"quantity\", \"value\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
