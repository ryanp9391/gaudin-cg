       "data": "Out[1458]= \\begin{array}{|c|c|c|c|c|c|c|c|c|c|}\\hline\\text{rep} & \\text{point} & \\text{dim} & \\text{eig/Baxter res.} & \\text{SP: |S\\_Q - <Psi|Psi>|} & \\text{kappa2 / shape} & \\text{|v - v1 (x) vacL|} & \\text{c\\_m} & \\text{c\\_m spread} & \\text{final 2nd-factor res.}\\\\\\hline2,1,0 & 1 & 64 & 0.\\times 10^{-90} & 1.90\\times 10^{-92} & -1 & 0.\\times 10^{-92} & \\left\\{1,\\frac{29}{10}\\right\\} & 0.\\times 10^{-83} & 0.\\times 10^{-84}\\\\\\hline3,1,0 & 1 & 225 & 1\\times 10^{-95} & 8.27\\times 10^{-86} & 1 & 0.\\times 10^{-90} & \\left\\{1,\\frac{24}{5}\\right\\} & 0.\\times 10^{-80} & 0.\\times 10^{-81}\\\\\\hline3,2,0 & 1 & 225 & 7.07023182451018233493\\times 10^{-95} & 9.49\\times 10^{-84} & 1 & 0.\\times 10^{-88} & \\left\\{1,\\frac{48}{29},\\frac{24}{5}\\right\\} & 0.\\times 10^{-77} & 0.\\times 10^{-79}\\\\\\hline2,1,0 & 2 & 64 & 0.\\times 10^{-90} & 7.92\\times 10^{-97} & -\\frac{1}{4096} & 0.\\times 10^{-92} & \\left\\{1,-\\frac{68}{9}\\right\\} & 0.\\times 10^{-86} & 0.\\times 10^{-86}\\\\\\hline2,1,0 & 3 & 64 & 0.\\times 10^{-90} & 5.72\\times 10^{-98} & -\\frac{531441}{16777216} & 0.\\times 10^{-91} & \\left\\{1,\\frac{574}{223}\\right\\} & 0.\\times 10^{-88} & 0.\\times 10^{-88}\\\\\\hline3,1,0 & 2 & 225 & 4\\times 10^{-97} & 1.08\\times 10^{-94} & \\… [latex truncated: 1921 chars total]",
