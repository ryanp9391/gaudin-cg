"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.5em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-9.7em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-10.9em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-12.1em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[1022]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{weight $\\mu$} & \\text{dim V\\_$\\mu$} & \\text{leading $\\varepsilon$ order in V\\_$\\mu$} & \\text{rank (per-weight leading order)} & \\text{sample-rank check} & \\text{rank (global $\\varepsilon$\\^{}0 part)}\\\\\\hline\\left\\{2,1,0\\right\\} & 1 & 0 & 1 & 1 & 1\\\\\\hline\\left\\{2,0,1\\right\\} & 1 & 1 & 1 & 1 & 0\\\\\\hline\\left\\{1,2,0\\right\\} & 1 & 1 & 1 & 1 & 0\\\\\\hline\\left\\{1,1,1\\right\\} & 2 & 2 & 2 & 2 & 0\\\\\\hline\\left\\{1,0,2\\right\\} & 1 & \\infty  & 0 & 0 & 0\\\\\\hline\\left\\{0,2,1\\right\\} & 1 & 3 & 1 & 1 & 0\\\\\\hline\\left\\{0,1,2\\right\\} & 1 & \\infty  & 0 & 0 & 0\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "f8cdcd3f-6259-4899-bef6-89efbcfcd595"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 3. V (x) V. The covectors are c (x) e1^T, so total weight nu = mu + λ with mu the site-1 weight.\n   (i) all states: dim of each weight space of V (x) V vs the rank reached;\n   (ii) highest-weight states only: hw vectors of weight nu = common kernel of the total raising E12, E23 (E13 follows) in (V (x) V)_nu;\n   the pairing <c (x) e1| w> = sum_a c_a w_{a,1} needs rank = #hw states of weight nu. Per-weight leading orders of cell 2 are used. ---- *)\nClearAll[idC, Etot2C, wt2C, hwC, exactZeroC, pairRankC, rowsVVC, rowsHWC];\nidC = IdentityMatrix[dC];\nEtot2C[i_, j_] := KroneckerProduct[EC[i, j], idC] + KroneckerProduct[idC, EC[i, j]];\nwt2C = Transpose[Table[Diagonal[Etot2C[i, i]], {i, 3}]];\n(* hw vectors of weight nu, as 64-vectors *)\nhwC[nu_] := With[{idx = Flatten @ Position[wt2C, nu]},\n    With[{ns = NullSpace[Join[Etot2C[1, 2][[All, idx]], Etot2C[2, 3][[All, idx]]]]}, Table[ReplacePart[ConstantArray[0, dC^2], Thread[idx -> w]], {w, ns}]]\n];\n(* components of v_new that vanish identically (exactly, before any ε expansion) *)\nexactZeroC = Table[{wtC[[n]], Simplify[vnewC[[n]]] === 0}, {n, dC}];\n\n(* rank of the pairing of the site-1 family in weight mu with the hw vectors of weight mu + λ *)\npairRankC[mu_] := With[{hw = hwC[mu + lamC], lw = leadWC[mu][[2]]},\n    If[hw === {}, 0, MatrixRank[coefMatC[lw] . Transpose[Table[Partition[w, dC][[All, 1]], {w, hw}]]]]\n];\n\nrowsVVC = Table[With[{nu = nu0, mu = nu0 - lamC}, {nu, Count[wt2C, nu], If[KeyExistsQ[leadWC, mu], rankC[leadWC[mu][[2]]], 0]}], {nu0, Union[wt2C]}];\nrowsHWC = Table[With[{mu = nu - lamC}, {nu, Length[hwC[nu]], If[KeyExistsQ[leadWC, mu], pairRankC[mu], 0]}], {nu, Select[Union[wt2C], hwC[#] =!= {} &]}];\n\nColumn[{\n    Grid[Prepend[exactZeroC, {\"site-1 weight of basis vector\", \"v_new component identically 0\"}], Frame -> All, Alignment -> Left],\n    Grid[\n        {\n            {\"(i) all of V (x) V: total dim, reached\", {dC^2, Total[rowsVVC[[All, 3]]]}},\n            {\"(ii) highest-weight states: total, reached\", {Total[rowsHWC[[All, 2]]], Total[rowsHWC[[All, 3]]]}}\n        },\n        Frame -> All, Alignment -> Left\n    ],\n    Grid[Prepend[rowsHWC, {\"hw weight nu (irrep of V (x) V)\", \"# hw states\", \"rank reached\"}], Frame -> All, Alignment -> Left]\n}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
