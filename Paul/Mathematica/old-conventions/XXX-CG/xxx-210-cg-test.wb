      {
       "data": "Out[1053]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{v1 . g1\\^{}-1 = (1 - k1 z1) e1\\^{}T} & \\mathrm{True}\\\\\\hline\\text{g1 (x) g1 fixes all hw vectors of V (x) V} & \\mathrm{True}\\\\\\hline\\text{v'\\_new = (1 - k1 z1) v\\_new . e\\^{}\\{-a E12\\}} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{site-1 weight} & \\text{v\\_new component $\\equiv$ 0} & \\text{v'\\_new component $\\equiv$ 0}\\\\\\hline\\left\\{2,1,0\\right\\} & \\mathrm{False} & \\mathrm{False}\\\\\\hline\\left\\{2,0,1\\right\\} & \\mathrm{False} & \\mathrm{False}\\\\\\hline\\left\\{1,2,0\\right\\} & \\mathrm{False} & \\mathrm{True}\\\\\\hline\\left\\{1,1,1\\right\\} & \\mathrm{False} & \\mathrm{False}\\\\\\hline\\left\\{1,1,1\\right\\} & \\mathrm{False} & \\mathrm{False}\\\\\\hline\\left\\{1,0,2\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\left\\{0,2,1\\right\\} & \\mathrm{False} & \\mathrm{True}\\\\\\hline\\left\\{0,1,2\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|}\\hline\\text{weight of V} & \\text{leading order of v'\\_new} & \\text{nonzero components} & \\text{rank}\\\\\\hline\\left\\{2,1,0\\right\\} & \\varepsilon ^0 & \\left\\{-\\frac{1}{2}\\,\\left(k1-1\\right)^2\\,\\left(k2-2\\right)\\right\\} & 1\\\\\\hline\\left\\{2,0,1\\right\\} & \\varepsilon ^1 & \\left\\{… [latex truncated: 2345 chars total]",
       "mime": "text/plain"
      }
