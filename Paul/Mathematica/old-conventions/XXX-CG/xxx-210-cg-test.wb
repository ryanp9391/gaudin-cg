      {
       "data": "Out[1060]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{G\\^{}-1 g0 G g0\\^{}-1 (3x3)} & \\begin{pmatrix}1 & p1\\,\\left(\\frac{z\\left(2\\right)}{z\\left(1\\right)}-1\\right) & 0\\\\0 & 1 & \\frac{p2\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)}{p1\\,z\\left(2\\right)}\\\\0 & 0 & 1\\end{pmatrix}\\\\\\hline\\text{<v\\_t | singlet (x)>: pairing of v\\_t (x) e1 with the singlet} & 0\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|}\\hline\\text{site-1 weight} & \\text{v\\_new $\\equiv$ 0} & \\text{v'\\_new $\\equiv$ 0} & \\text{v\\_t $\\equiv$ 0}\\\\\\hline\\left\\{2,1,0\\right\\} & \\mathrm{False} & \\mathrm{False} & \\mathrm{False}\\\\\\hline\\left\\{2,0,1\\right\\} & \\mathrm{False} & \\mathrm{False} & \\mathrm{False}\\\\\\hline\\left\\{1,2,0\\right\\} & \\mathrm{False} & \\mathrm{True} & \\mathrm{False}\\\\\\hline\\left\\{1,1,1\\right\\} & \\mathrm{False} & \\mathrm{False} & \\mathrm{False}\\\\\\hline\\left\\{1,1,1\\right\\} & \\mathrm{False} & \\mathrm{False} & \\mathrm{True}\\\\\\hline\\left\\{1,0,2\\right\\} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\left\\{0,2,1\\right\\} & \\mathrm{False} & \\mathrm{True} & \\mathrm{False}\\\\\\hline\\left\\{0,1,2\\right\\} & \\mathrm{True} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|}\\hline\\text{weight of V} & \\text{le… [latex truncated: 2507 chars total]",
