      {
       "data": "Out[1079]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{(a) weights where e1\\^{}T e\\^{}\\{a E12\\} t\\^{}M\\_2($\\theta$1) $\\equiv$ 0, M a general 3x3 twist} & \\begin{pmatrix}1 & 0 & 2\\\\0 & 1 & 2\\end{pmatrix}\\\\\\hline\\text{(b) (G\\^{}-n g0 G\\^{}n g0\\^{}-1)\\_\\{13\\}, n = 1, 2} & \\left\\{0,-\\frac{p2\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)}{z\\left(1\\right)^2}\\right\\}\\\\\\hline\\text{<v\\^{}(n) (x) e1 | singlet>, n = 1, 2} & \\left\\{0,\\frac{3\\,p2^2\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)^2\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)^2\\,\\left(z\\left(1\\right)\\,z\\left(2\\right)+z\\left(3\\right)\\,z\\left(2\\right)+z\\left(1\\right)\\,z\\left(3\\right)\\right)}{z\\left(1\\right)^4\\,z\\left(2\\right)^2}\\right\\}\\\\\\hline\\text{v\\^{}(2): leading order at site-1 weight (0,1,2)} & \\left\\{4,\\left\\{0,0,0,0,0,0,0,9\\,p2^2\\,\\left(\\varphi \\left(1\\right)-\\varphi \\left(2\\right)\\right)^2\\,\\left(\\varphi \\left(1\\right)-\\varphi \\left(3\\right)\\right)^2\\right\\}\\right\\}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|}\\hline\\text{hw weight nu} & \\text{\\# hw states} & \\text{rank: v\\^{}(2) alone (hypothetical)} & \\text{rank: all families + v\\^{}(2)}\\\\\\hline\\left\\{2,2,2\\right\\} & 1 & 1 & 1\\\\\\hline\\… [latex truncated: 1414 chars total]",
