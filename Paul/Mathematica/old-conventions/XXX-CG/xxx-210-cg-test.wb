  {
   "kind": 2,
   "value": "(* ---- 2. Untwisting z_k = Exp[φ_k ε], leading order in ε (a) for the whole vector, (b) separately in each weight space of V.\n   Span of a family c(params): clear a common scalar denominator, then the coefficient vectors of all monomials in the free\n   parameters (k1, k2, p1, p2, φ, θ[1], h) span exactly the span of the values; its rank is compared with the dimension. ---- *)\nClearAll[vnewEpsC, serC, ordC, wtC, sectorsC, lead0C, nOC, leadWC, coefMatC, rankC, sampleRankC];\nvnewEpsC = vnewC /. z[k_] :> Exp[φ[k] ε];\nserC = Table[Normal[Series[c, {ε, 0, 4}]], {c, vnewEpsC}];\n(* lowest ε power of each component (Infinity if zero through ε^4) *)\nordC = Table[With[{cl = CoefficientList[Together[s], ε]}, With[{nz = Flatten @ Position[Simplify /@ cl, _?(# =!= 0 &), {1}, Heads -> False]}, If[nz === {}, Infinity, First[nz] - 1]]], {s, serC}];\nwtC = Transpose[Table[Diagonal[EC[i, i]], {i, 3}]];\nsectorsC = GatherBy[Range[dC], wtC[[#]] &];\n\n(* (a) global leading order; (b) per-weight-space leading order, embedded in the 8-dim space *)\nnOC = Min[ordC];\nlead0C = Table[Simplify[Coefficient[serC[[n]], ε, nOC]], {n, dC}];\nleadWC = Association @ Table[\n    With[{nW = Min[ordC[[sec]]]},\n        wtC[[First[sec]]] -> {nW, Table[If[MemberQ[sec, n] && nW < Infinity, Simplify[Coefficient[serC[[n]], ε, nW]], 0], {n, dC}]}\n    ],\n    {sec, sectorsC}\n];\n\ncoefMatC[vec_] := Module[{num = Together /@ vec, den, poly, vars, rules},\n    den = PolynomialLCM @@ (Denominator /@ num);\n    poly = Expand[Together[# den]] & /@ num;\n    vars = Variables[poly];\n    If[vars === {}, Return[{poly}]];\n    rules = CoefficientRules[#, vars] & /@ poly;\n    With[{mons = Union @@ (Keys /@ rules)}, Transpose @ Table[Lookup[Association[r], mons, 0], {r, rules}]]\n];\nrankC[vec_] := MatrixRank[coefMatC[vec]];\n(* independent cross-check: rank of the values at 25 random rational parameter points *)\nsampleRankC[vec_] := MatrixRank[Table[vec /. Thread[Variables[vec] -> RandomInteger[{1, 97}, Length[Variables[vec]]] / RandomInteger[{1, 13}, Length[Variables[vec]]]], {25}]];\n\nGrid[\n    Join[\n        {{\"weight μ\", \"dim V_μ\", \"leading ε order in V_μ\", \"rank (per-weight leading order)\", \"sample-rank check\", \"rank (global ε^\" <> ToString[nOC] <> \" part)\"}},\n        Table[\n            With[{w = wtC[[First[sec]]], lw = leadWC[wtC[[First[sec]]]]},\n                {w, Length[sec], lw[[1]], rankC[lw[[2]]], sampleRankC[lw[[2]]], rankC[Table[If[MemberQ[sec, n], lead0C[[n]], 0], {n, dC}]]}\n            ],\n            {sec, sectorsC}\n        ]\n    ],\n    Frame -> All, Alignment -> Left\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"389651\" data-output-id=\"79\" data-out-n=\"1022\" data-sub-idx=\"16\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"3\" data-sub-start=\"33\" data-sub-end=\"44\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[1022]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:9.64em;vertical-align:-4.55em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.09em;\"><span style=\"top:-7.05em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:9.6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-4.55em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-7.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">weight </span><span class=\"mord mathnormal\">μ</span></span></span></span><span style=\"top:-6.01em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.