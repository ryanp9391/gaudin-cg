      {
       "data": "Out[95]= \\begin{array}{|c|c|}\\hline\\text{E\\_ij (i<j) raise: e1 is annihilated by E12, E13, E23} & \\mathrm{True}\\\\\\hline\\text{v1 . g0\\^{}-1 = (1 - k1 z1) e1\\^{}T exp((p1' - p1) E12)} & \\mathrm{True}\\\\\\hline\\text{GT patterns (basis order)} & \\begin{pmatrix}\\left\\{2\\right\\} & \\left\\{2,1\\right\\} & \\left\\{2,1,0\\right\\}\\\\\\left\\{2\\right\\} & \\left\\{2,0\\right\\} & \\left\\{2,1,0\\right\\}\\\\\\left\\{1\\right\\} & \\left\\{2,1\\right\\} & \\left\\{2,1,0\\right\\}\\\\\\left\\{1\\right\\} & \\left\\{2,0\\right\\} & \\left\\{2,1,0\\right\\}\\\\\\left\\{1\\right\\} & \\left\\{1,1\\right\\} & \\left\\{2,1,0\\right\\}\\\\\\left\\{1\\right\\} & \\left\\{1,0\\right\\} & \\left\\{2,1,0\\right\\}\\\\\\left\\{0\\right\\} & \\left\\{2,0\\right\\} & \\left\\{2,1,0\\right\\}\\\\\\left\\{0\\right\\} & \\left\\{1,0\\right\\} & \\left\\{2,1,0\\right\\}\\end{pmatrix}\\\\\\hline\\text{v\\_new (exact)} & \\left\\{\\frac{1}{2}\\,\\left(k1\\,z\\left(1\\right)-1\\right)\\,\\left(k2\\,z\\left(1\\right)\\,z\\left(2\\right)-2\\right),\\frac{k2\\,p2\\,z\\left(1\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)\\,\\left(k1\\,z\\left(1\\right)-1\\right)}{2\\,p1},-\\frac{1}{2}\\,k1\\,p1\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,\\left(k2\\,z\\left(1\\right)\\,z\\left(2\\right)-2\\right),-\\frac{1}{2}\\,k2\\,p2\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\… [latex truncated: 1537 chars total]",
