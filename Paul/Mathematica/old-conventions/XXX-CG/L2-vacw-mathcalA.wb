       "data": "Out[498]= \\begin{array}{|c|c|}\\hline\\text{\\# states} & 64\\\\\\hline\\text{max relative eigen residual (t1, t2)} & 0.\\times 10^{-94}\\\\\\hline\\text{min |<vacL vacL|Psi>| / max|Psi| before normalization} & 0.00556\\\\\\hline\\text{max |<vacL vacL|Psi\\_A> - 1|, max |<Psi\\_A|vacR vacR> - 1|} & \\left\\{0.\\times 10^{-91},0.\\times 10^{-91}\\right\\}\\\\\\hline\\text{<Psi\\_A|Psi\\_B>: max|offdiag| / min|diag|} & 0.\\times 10^{-87}\\\\\\hline\\text{Omega = e1 (x) e1: index, |ket - e\\_1|, <Omega|Omega>} & \\left\\{1,0.\\times 10^{-98},1.\\,\\right\\}\\\\\\hline\\end{array}",
