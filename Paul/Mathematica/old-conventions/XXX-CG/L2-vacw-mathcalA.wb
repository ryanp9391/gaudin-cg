"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">7</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">3</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">6</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">7</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">}</span></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">{</span></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">5</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">3</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8451em;\"><span style=\"top:-2.655em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">7</span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.394em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">4</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.345em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">}</span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">}</span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">}</span></span></span></span></span><span style=\"top:-4.205em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">64</span></span></span><span style=\"top:-3.005em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-1.805em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span><span style=\"top:-0.605em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">True</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.755em;\"><span></span></span></span></span></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"vertical-separator\" style=\"height:6.01em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.755em;\"></span></span></span><span style=\"top:-2.5em;\"><span class=\"pstrut\" style=\"height:5.255em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.7em;\"><span class=\"pstrut\" style=\"height:5.255em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-4.9em;\"><span class=\"pstrut\" style=\"height:5.255em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-6.1em;\"><span class=\"pstrut\" style=\"height:5.255em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-7.3em;\"><span class=\"pstrut\" style=\"height:5.255em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-8.51em;\"><span class=\"pstrut\" style=\"height:5.255em;\"></span><span class=\"hline\" style=\"border-bottom-width:0.04em;\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.755em;\"><span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[479]= \\begin{array}{|c|c|}\\hline\\text{site rep, point index, \\{h, $\\theta$, z, p\\}} & \\left\\{\\left\\{2,1,0\\right\\},3,\\left\\{\\frac{3}{4},\\left\\{\\frac{5}{13},\\frac{1}{9}\\right\\},\\left\\{2,\\frac{3}{7},\\frac{7}{6}\\right\\},\\left\\{\\frac{3}{5},\\frac{4}{7}\\right\\}\\right\\}\\right\\}\\\\\\hline\\text{chain dimension} & 64\\\\\\hline\\text{twist unimodular} & \\mathrm{True}\\\\\\hline\\text{coefficients of t1, t2 commute} & \\mathrm{True}\\\\\\hline\\text{t3 = z1 z2 z3 qdet} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "cb2104d6-08d2-40db-b1a5-3f9384ce635e"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* ---- 2. Product references and the right/left eigenstates, normalized <vacL (x) vacL|Psi_A> = 1 = <Psi_A|vacR (x) vacR>. ---- *)\nClearAll[r1T, r2T, r3T, vacL1T, vacR1T, vacLT, vacRT, wtListT, rhoT, tcoefNT, statesT, ketMatT, braMatT, ovT, iOmT];\n(* rotparams of L1-mathcalA *)\nr1T = p1T (zT[[2]] - zT[[3]]) / (p2T (zT[[1]] - zT[[2]]));\nr2T = (zT[[2]] - zT[[3]]) / (p2T (zT[[1]] - zT[[2]]));\nr3T = (zT[[1]] - zT[[3]]) / (p1T (zT[[3]] - zT[[2]]));\nvacL1T = UnitVector[dsT, 1] . MatrixExp[p1T Normal[ElT[1, 2]]] . MatrixExp[p2T Normal[ElT[1, 3]]] . MatrixExp[p3T Normal[ElT[2, 3]]];\nvacR1T = MatrixExp[r1T Normal[ElT[3, 2]]] . MatrixExp[r2T Normal[ElT[3, 1]]] . MatrixExp[r3T Normal[ElT[2, 1]]] . UnitVector[dsT, 1];\n(* KroneckerProduct of vectors is a matrix; flatten row-major = the E1T/E2T ordering *)\nvacLT = N[Flatten[KroneckerProduct[vacL1T, vacL1T]], precT];\nvacRT = N[Flatten[KroneckerProduct[vacR1T, vacR1T]], precT];\n\n(* diagonalize a generic combination of t1, t2 coefficients sector by sector (weight multiplicities > 1) *)\ntcoefNT[a_, k_] := tcoefNT[a, k] = N[tcoefT[a, k], precT];\nwtListT = Transpose[Table[Normal[Diagonal[EtotT[i, i]]], {i, 3}]];\nrhoT[a_, k_] := Prime[7 a + k + 1] / (11 + 2 a + k);\nstatesT = Flatten[\n    Table[\n        Module[{idx, K, vecs},\n            idx = Flatten @ Position[wtListT, wt];\n            K = Normal[Sum[rhoT[a, k] tcoefNT[a, k][[idx, idx]], {a, 2}, {k, 0, 2 a}]];\n            vecs = Eigenvectors[K];\n            Table[\n                Module[{full, p, tau},\n                    full = ReplacePart[ConstantArray[SetPrecision[0, precT], dcT], Thread[idx -> vv]];\n                    p = First @ Ordering[-Abs[full], 1];\n                    tau = Table[Sum[(tcoefNT[a, k] . full)[[p]] / full[[p]] u^k, {k, 0, 2 a}], {a, 3}];\n                    <|\"mu\" -> wt, \"ket0\" -> full, \"t\" -> Expand[tau],\n                      \"eigRes\" -> Max[Flatten @ Table[Abs[tcoefNT[a, k] . full - Coefficient[tau[[a]], u, k] full] / Max[Abs[full]], {a, 2}, {k, 0, 2 a}]]|>\n                ],\n                {vv, vecs}\n            ]\n        ],\n        {wt, Union[wtListT]}\n    ],\n    1\n];\nstatesT = SortBy[statesT, {-#[\"mu\"][[1]] &, -#[\"mu\"][[2]] &, -#[\"mu\"][[3]] &}];\n\n(* left eigenvectors = rows of the inverse (joint spectrum is simple); then normalize both against the product references *)\nModule[{R = Transpose[statesT[[All, \"ket0\"]]], Linv, ovl},\n    Linv = Inverse[R];\n    ovl = vacLT . R;\n    statesT = Table[\n        Append[statesT[[A]], <|\"vacLov\" -> ovl[[A]] / Max[Abs[statesT[[A, \"ket0\"]]]], \"ket\" -> statesT[[A, \"ket0\"]] / ovl[[A]], \"bra\" -> Linv[[A]] / (Linv[[A]] . vacRT)|>],\n        {A, dcT}\n    ]\n];\nketMatT = Transpose[statesT[[All, \"ket\"]]];\nbraMatT = statesT[[All, \"bra\"]];\novT = braMatT . ketMatT;\niOmT = First @ FirstPosition[statesT[[All, \"mu\"]], 2 repT];\n\nGrid[\n    {\n        {\"# states\", Length[statesT]},\n        {\"max relative eigen residual (t1, t2)\", N[Max[statesT[[All, \"eigRes\"]]], 3]},\n        {\"min |<vacL vacL|Psi>| / max|Psi| before normalization\", N[Min[Abs[statesT[[All, \"vacLov\"]]]], 3]},\n        {\"max |<vacL vacL|Psi_A> - 1|, max |<Psi_A|vacR vacR> - 1|\", N[{Max[Abs[vacLT . ketMatT - 1]], Max[Abs[braMatT . vacRT - 1]]}, 3]},\n        {\"<Psi_A|Psi_B>: max|offdiag| / min|diag|\", N[Max[Abs[ovT - DiagonalMatrix[Diagonal[ovT]]]] / Min[Abs[Diagonal[ovT]]], 3]},\n        {\"Omega = e1 (x) e1: index, |ket - e_1|, <Omega|Omega>\", {iOmT, N[Max[Abs[statesT[[iOmT, \"ket\"]] - UnitVector[dcT, 1]]], 3], N[ovT[[iOmT, iOmT]], 10]}}\n    },\n    Frame -> All, Alignment -> Left\n]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
