      {
       "data": "Out[567]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{w} & \\text{flag (y = 1)} & \\text{vacL relation, y = z} & \\text{y = 1/(z - w2)} & \\text{y = 1/(z - w3)} & \\text{y = 1/(z - w1)}\\\\\\hline\\left\\{\\frac{3}{2},\\frac{5}{4},\\frac{8}{15}\\right\\} & 0 & -\\frac{190}{441} & 0 & -\\frac{5375}{1694} & -\\frac{38}{63}\\\\\\hline\\left\\{2,\\frac{3}{7},\\frac{7}{6}\\right\\} & 0 & 0 & \\mathrm{Indeterminate} & \\mathrm{Indeterminate} & \\mathrm{Indeterminate}\\\\\\hline\\left\\{\\frac{7}{2},\\frac{2}{5},\\frac{5}{7}\\right\\} & 0 & -\\frac{5225}{31752} & 0 & \\frac{605}{1944} & \\frac{32395}{682668}\\\\\\hline\\end{array}",
