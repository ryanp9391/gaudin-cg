       "data": "{\n\t\"name\": \"WolframKernelMessage\",\n\t\"message\": \"Power::infy: Infinite expression - encountered.                                  0\\nInfinity::indet: Indeterminate expression 0 ComplexInfinity encountered.\",\n\t\"stack\": \"\"\n}",
