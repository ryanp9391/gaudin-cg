      {
       "data": "Out[555]= \\begin{array}{|c|c|}\\hline\\text{w (unimodular)} & \\left\\{\\left\\{\\frac{3}{2},\\frac{5}{4},\\frac{8}{15}\\right\\},1\\right\\}\\\\\\hline\\text{Omega eigen residual at twist w} & 0.\\times 10^{-98}\\\\\\hline\\text{dual Baxter residuals of the w-vacuum} & \\left\\{0.\\times 10^{-94},0.\\times 10^{-96},0.\\times 10^{-95}\\right\\}\\\\\\hline\\text{min |det\\_B|, max |det\\_B|} & \\left\\{2.60,7.66\\times 10^{9}\\right\\}\\\\\\hline\\text{V: sigma2/sigma1, asymmetry of M} & \\left\\{0,0.\\times 10^{-89}\\right\\}\\\\\\hline\\text{u = row 1 of M / M11; fit (a, b, c), residual} & \\left\\{\\left\\{0.0469387755102,0.246753246753,-6.50048875855\\right\\},0.\\times 10^{-59}\\right\\}\\\\\\hline\\end{array}",
