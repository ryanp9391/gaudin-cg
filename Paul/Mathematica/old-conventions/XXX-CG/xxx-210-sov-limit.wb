      {
       "data": "Out[109]= \\begin{matrix}\\begin{array}{|c|c|c|c|c|c|}\\hline\\text{family: rank(80) / rank(120) / sector dim} & 2,2,2 & 3,2,1 & 3,3,0 & 4,1,1 & 4,2,0\\\\\\hline\\text{base} & 4\\text{ / }4\\text{ / }10 & 4\\text{ / }4\\text{ / }6 & 2\\text{ / }2\\text{ / }2 & 2\\text{ / }2\\text{ / }2 & 1\\text{ / }1\\text{ / }1\\\\\\hline\\left\\{1,0\\right\\} & 7\\text{ / }7\\text{ / }10 & 5\\text{ / }5\\text{ / }6 & 2\\text{ / }2\\text{ / }2 & 2\\text{ / }2\\text{ / }2 & 1\\text{ / }1\\text{ / }1\\\\\\hline\\left\\{1,1\\right\\} & 9\\text{ / }9\\text{ / }10 & 6\\text{ / }6\\text{ / }6 & 2\\text{ / }2\\text{ / }2 & 2\\text{ / }2\\text{ / }2 & 1\\text{ / }1\\text{ / }1\\\\\\hline\\left\\{2,0\\right\\} & 10\\text{ / }10\\text{ / }10 & 6\\text{ / }6\\text{ / }6 & 2\\text{ / }2\\text{ / }2 & 2\\text{ / }2\\text{ / }2 & 1\\text{ / }1\\text{ / }1\\\\\\hline\\left\\{2,1\\right\\} & 10\\text{ / }10\\text{ / }10 & 6\\text{ / }6\\text{ / }6 & 2\\text{ / }2\\text{ / }2 & 2\\text{ / }2\\text{ / }2 & 1\\text{ / }1\\text{ / }1\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|}\\hline\\text{samples sufficient everywhere} & \\mathrm{True}\\\\\\hline\\text{time for all limits (s)} & 0.736466\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{family} & 2,2,2 & 3,2,1 & 3,3,0 & 4,1,1 & 4,2,0 & \\text{hw total (of 6)… [latex truncated: 1549 chars total]",
       "mime": "text/plain"
      }
     ],
     "id": "6d149374-b56d-4693-8378-b22562637359"
