      {
       "data": "Out[262]= \\begin{pmatrix}1 & \\frac{p2\\,\\left(\\phi \\left(3\\right)-\\phi \\left(1\\right)\\right)}{p1\\,\\left(\\phi \\left(2\\right)-\\phi \\left(3\\right)\\right)} & p1 & \\frac{p2\\,\\left(\\phi \\left(1\\right)+\\phi \\left(2\\right)-2\\,\\phi \\left(3\\right)\\right)}{\\phi \\left(3\\right)-\\phi \\left(2\\right)} & -\\frac{3\\,p2\\,\\left(\\phi \\left(1\\right)-\\phi \\left(2\\right)\\right)}{\\phi \\left(2\\right)-\\phi \\left(3\\right)} & \\frac{3\\,p2^2\\,\\left(\\phi \\left(1\\right)-\\phi \\left(2\\right)\\right)\\,\\left(\\phi \\left(1\\right)-\\phi \\left(3\\right)\\right)}{p1\\,\\left(\\phi \\left(2\\right)-\\phi \\left(3\\right)\\right)^2} & -2\\,p1\\,p2 & \\frac{3\\,p2^2\\,\\left(\\phi \\left(1\\right)-\\phi \\left(2\\right)\\right)}{\\phi \\left(2\\right)-\\phi \\left(3\\right)}\\end{pmatrix}",
