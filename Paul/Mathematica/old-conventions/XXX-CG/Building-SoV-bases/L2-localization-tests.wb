  {
   "kind": 2,
   "value": "setPoint[pts4[[1]]];\nwr[f_, g_] := Function[{A, x}, f[A, x] g[A, x - hh] - g[A, x] f[A, x - hh]];\nallFams = <|\"Q_1\" -> (QlowA[#1, 1, #2] &), \"Q_2\" -> (QlowA[#1, 2, #2] &), \"Q_3\" -> (QlowA[#1, 3, #2] &),\n   \"Q^1\" -> (QupA[#1, 1, #2] &), \"Q^2\" -> (QupA[#1, 2, #2] &), \"Q^3\" -> (QupA[#1, 3, #2] &)|>;\nallFams = Join[allFams, <|\"Q_12\" -> wr[allFams[\"Q_1\"], allFams[\"Q_2\"]], \"Q_13\" -> wr[allFams[\"Q_1\"], allFams[\"Q_3\"]], \"Q_23\" -> wr[allFams[\"Q_2\"], allFams[\"Q_3\"]],\n    \"Q^12\" -> wr[allFams[\"Q^1\"], allFams[\"Q^2\"]], \"Q^13\" -> wr[allFams[\"Q^1\"], allFams[\"Q^3\"]], \"Q^23\" -> wr[allFams[\"Q^2\"], allFams[\"Q^3\"]]|>];\nnPts = Range[-1, 3];\n(* values table: fam -> 64 x npts, low precision for the scan *)\nvalTab = Association@KeyValueMap[#1 -> N[Table[#2[A, th[1] + n hh], {A, 64}, {n, nPts}], 30] &, allFams];\n(* all single ratios with nonvanishing denominators *)\nratios = Flatten[KeyValueMap[Function[{f, v}, Table[If[Min[Abs[v[[All, j]]]] > 10^-20 && i != j, {{f, nPts[[i]], nPts[[j]]}, v[[All, i]]/v[[All, j]]}, Nothing], {i, Length[nPts]}, {j, Length[nPts]}]], valTab], 2];\nspreadOf[r_] := Max[Abs[r - Mean[r]]]/Abs[Mean[r]];\nprodScan[e_] := Module[{eN = N[e, 30], best = {}, s},\n   Do[s = spreadOf[eN/ratios[[i, 2]]]; If[s < 10^-12, AppendTo[best, {ratios[[i, 1]], s}]], {i, Length[ratios]}];\n   If[best =!= {}, Return[{\"single\", best}]];\n   Do[s = spreadOf[eN/(ratios[[i, 2]] ratios[[j, 2]])]; If[s < 10^-12, AppendTo[best, {ratios[[i, 1]], ratios[[j, 1]], s}]], {i, Length[ratios]}, {j, i, Length[ratios]}];\n   {\"product\", best}];\n{\"# single ratios\" -> Length[ratios]}",
   "languageId": "wolfram",
   "outputs": [
