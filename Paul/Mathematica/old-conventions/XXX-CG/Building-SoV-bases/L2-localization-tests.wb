       "data": "Out[732]= \\begin{array}{|c|c|c|}\\hline\\text{GT basis weight} & \\text{x (site 2, after g0\\^{}-1)} & \\text{y = <new vec| (site 1)}\\\\\\hline\\left\\{2,1,0\\right\\} & -\\frac{\\left(11\\,k1-4\\right)\\,\\left(1155\\,k2+3776\\right)}{15104} & -\\frac{\\left(11\\,k1-4\\right)\\,\\left(1155\\,k2+3776\\right)}{15104}\\\\\\hline\\left\\{2,0,1\\right\\} & \\frac{k1\\,\\left(1155\\,k2+3776\\right)}{9440} & -\\frac{k1\\,\\left(1155\\,k2+3776\\right)}{9440}\\\\\\hline\\left\\{1,2,0\\right\\} & \\frac{2145\\,\\left(11\\,k1-4\\right)\\,k2}{15104} & -\\frac{2145\\,\\left(11\\,k1-4\\right)\\,k2}{15104}\\\\\\hline\\left\\{1,1,1\\right\\} & -\\frac{429\\,k1\\,k2}{1888} & -\\frac{39}{944}\\,\\left(11\\,k1-2\\right)\\,k2\\\\\\hline\\left\\{1,1,1\\right\\} & -\\frac{39\\,\\left(33\\,k1-8\\right)\\,k2}{1888} & -\\frac{39\\,k2}{472}\\\\\\hline\\left\\{1,0,2\\right\\} & \\frac{117\\,k1\\,k2}{1180} & \\frac{117\\,k1\\,k2}{1180}\\\\\\hline\\left\\{0,2,1\\right\\} & 0 & 0\\\\\\hline\\left\\{0,1,2\\right\\} & 0 & 0\\\\\\hline\\text{PBW monomial E12\\^{}a E13\\^{}b E23\\^{}c} & \\text{N (x = e1\\^{}T N)} & \\text{y = e1\\^{}T (...)}\\\\\\hline\\left\\{0,0,0\\right\\} & -\\frac{\\left(11\\,k1-4\\right)\\,\\left(1155\\,k2+3776\\right)}{15104} & -\\frac{\\left(11\\,k1-4\\right)\\,\\left(1155\\,k2+3776\\right)}{15104}\\\\\\hline\\left\\{0,0,1\\right\\} & \\frac{k1\\,\\left(1155\\,… [latex truncated: 1778 chars total]",
