  {
   "kind": 2,
   "value": "(* is the localized eigenvalue a combination of transfer-matrix eigenvalues at SITE-1 points only? *)\ntauVal[a_, x_] := Table[tauPoly[[A, a]] /. u -> x, {A, 64}];\ndict1 = Join[{\"1\" -> ConstantArray[1, 64], \"R(th1)\" -> targets[\"single 200 (R)\"], \"t11(th1)\" -> targets[\"single 111 (t11)\"]},\n   Table[\"tau1(th1+\" <> ToString[n] <> \"h)\" -> tauVal[1, th[1] + n hh], {n, -1, 3}],\n   Table[\"tau2(th1+\" <> ToString[n] <> \"h)\" -> tauVal[2, th[1] + n hh], {n, -1, 3}]];\ndictFit[e_, dict_] := Module[{M = Transpose[Values[dict]], c}, c = LeastSquares[M, e];\n   {N[Max[Abs[M . c - e]]/Max[Abs[e]], 3], Select[Thread[Keys[dict] -> Chop[N[c, 10], 10^-20]], #[[2]] != 0 &]}];\n(* sparsest: try all subsets of size <= 3 of the dictionary *)\nsparseFit[e_, dict_] := Module[{keys = Keys[dict], res},\n   res = Flatten[Table[With[{sub = KeyTake[dict, s]}, {s, dictFit[e, sub][[1]]}], {k, 1, 3}, {s, Subsets[keys, {k}]}], 1];\n   Take[SortBy[res, #[[2]] &], 3]];\n{\"full dictionary fit\" -> Map[dictFit[#, dict1][[1]] &, KeyTake[targets, {\"clean 110\", \"clean 210\", \"clean 221\", \"X1\"}]],\n \"sparsest (<= 3 terms)\" -> Map[sparseFit[#, dict1] &, KeyTake[targets, {\"clean 110\", \"X1\"}]]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
