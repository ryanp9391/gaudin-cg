      {
       "data": "Out[795]= \\begin{array}{|c|c|c|}\\hline\\text{site} & \\text{localized combination} & \\text{proportional to single-site state}\\\\\\hline1 & \\begin{pmatrix}\\text{100} & \\text{100}\\end{pmatrix} & \\left\\{\\text{100}\\right\\}\\\\\\hline1 & \\begin{pmatrix}\\text{111} & \\text{100}\\end{pmatrix} & \\left\\{\\text{111}\\right\\}\\\\\\hline1 & \\begin{pmatrix}\\text{200} & \\text{100}\\end{pmatrix} & \\left\\{\\text{200}\\right\\}\\\\\\hline1 & \\begin{pmatrix}\\text{211} & \\text{100}\\end{pmatrix} & \\left\\{\\text{211}\\right\\}\\\\\\hline1 & \\begin{pmatrix}\\text{100} & \\text{110}\\\\\\text{100} & \\text{200}\\\\\\text{110} & \\text{100}\\end{pmatrix} & \\{\\}\\\\\\hline1 & \\begin{pmatrix}\\text{200} & \\text{110}\\\\\\text{200} & \\text{200}\\\\\\text{210} & \\text{100}\\end{pmatrix} & \\{\\}\\\\\\hline1 & \\begin{pmatrix}\\text{211} & \\text{110}\\\\\\text{211} & \\text{200}\\\\\\text{221} & \\text{100}\\end{pmatrix} & \\{\\}\\\\\\hline2 & \\begin{pmatrix}\\text{100} & \\text{100}\\end{pmatrix} & \\left\\{\\text{100}\\right\\}\\\\\\hline2 & \\begin{pmatrix}\\text{100} & \\text{111}\\end{pmatrix} & \\left\\{\\text{111}\\right\\}\\\\\\hline2 & \\begin{pmatrix}\\text{100} & \\text{200}\\end{pmatrix} & \\left\\{\\text{200}\\right\\}\\\\\\hline2 & \\begin{pmatrix}\\text{100} & \\text{211}\\end{pmatrix} & \\left\\{\\text{211}\\right\\… [latex truncated: 1580 chars total]",
