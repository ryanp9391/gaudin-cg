   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* rerun the SoV-basis pipeline at a given point and return the pair ratios alpha2/alpha1 *)\nsovPipeline[p_] := Module[{},\n   setPoint[p]; computeSpectrum[];\n   Gd = DiagonalMatrix[zs]; chis = {Total[zs], -(zs[[1]] zs[[2]] + zs[[1]] zs[[3]] + zs[[2]] zs[[3]]), Times @@ zs};\n   Gc = {chis, {1, 0, 0}, {0, 1, 0}}; Pv = Transpose[{#^2, #, 1} & /@ zs];\n   PP = N[KroneckerProduct[PiSite[1, Pv], PiSite[2, Pv]], prec]; psiC = Table[PP . evecs[[A]], {A, 64}];\n   Bu0 = Bop[2/9]; Bev = Eigenvalues[Transpose[Bu0]];\n   xB = Table[First@NullSpace[Transpose[Bu0] - lam IdentityMatrix[d1 d2]], {lam, Bev}];\n   Bvals = Table[With[{Bx = Bop[x]}, Table[With[{r = xB[[k]] . Bx, j = First@FirstPosition[xB[[k]], _?(# != 0 &)]}, r[[j]]/xB[[k, j]]], {k, 64}]], {x, uB}];\n   Bpoly = Table[Factor@InterpolatingPolynomial[Transpose[{uB, Bvals[[All, k]]}], u], {k, 64}];\n   Blabels = labelOf /@ Bpoly; site1Lab = Map[Cases[#, {1, n_} :> n] &, Blabels]; site2Lab = Map[Cases[#, {2, n_} :> n] &, Blabels];\n   sovSt = AssociationThread[Transpose[{site1Lab, site2Lab}], xB];\n   rankB = Table[MatrixRank[ArrayReshape[xB[[k]], {d1, d2}]], {k, 64}];\n   wSoV = fact[2, xB[[First@Select[Range[64], site2Lab[[#]] == {-1, 0, 1} && rankB[[#]] == 1 &]]]];\n   minSoV = minimalSoV[wSoV, 2];\n   {(th[1] - th[2])/hh, Table[With[{f = rvFit[c]}, {f[[1]], f[[2]], f[[3, 2]]/f[[3, 1]]}], {c, Select[minSoV[[2]], Length[#[[1]]] == 2 &]}]}];\npt2SoV = sovPipeline[pts4[[2]]];\nT2 = pt2SoV[[1]];\n{\"T (point 2)\" -> T2, \"pair ratios\" -> pt2SoV[[2, All, {1, 3}]], \"predictions 2/(T-2), 1/(T-2), (T+1)/(2T(T-2)), 1/(T-1)\" -> {2/(T2 - 2), 1/(T2 - 2), (T2 + 1)/(2 T2 (T2 - 2)), 1/(T2 - 1)}}",
   "languageId": "wolfram",
   "outputs": [
    {
