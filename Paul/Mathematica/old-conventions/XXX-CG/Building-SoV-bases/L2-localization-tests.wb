      {
       "data": "Out[741]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{O1 \\\\ O2} & \\text{1} & \\text{R\\^{}S} & \\text{tS11} & \\text{R\\^{}S.tS11}\\\\\\hline\\text{1} & 0 & 0 & 0 & 0\\\\\\hline\\text{R} & 0 & 0 & 0 & -\\frac{3812751}{1806726272}\\\\\\hline\\text{t11} & 0 & 0 & -\\frac{2184003}{903363136} & 0\\\\\\hline\\text{R.t11} & 0 & -\\frac{3812751}{1806726272} & 0 & -\\frac{6603475030695}{1411877085612032}\\\\\\hline\\end{array}",
