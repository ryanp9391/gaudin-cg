      {
       "data": "Out[599]= \\begin{array}{|c|c|c|c|}\\hline\\text{max Baxter residual q\\^{}2} & 0.\\times 10^{-52} &  & \\\\\\hline\\text{zeros of Q\\^{}23 at th2 + n h, n =} & \\left\\{0\\right\\} &  & \\\\\\hline\\text{a} & \\text{b} & \\text{rel. spread of C} & \\text{C}\\\\\\hline1 & 2 & 0.\\times 10^{-49} & 1.\\,+0.\\times 10^{-12}\\,\\mathrm{i}\\\\\\hline2 & 1 & 12.2 & 534.262879663+0.\\times 10^{-9}\\,\\mathrm{i}\\\\\\hline4 & 1 & 12.3 & 15312.1290878+0.\\times 10^{-8}\\,\\mathrm{i}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
