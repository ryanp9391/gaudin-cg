      {
       "data": "Out[536]= \\begin{pmatrix}4 & \\begin{pmatrix}\\text{1}\\\\\\text{R}\\\\\\text{t11}\\\\\\text{R.t11}\\end{pmatrix}\\\\4 & \\begin{pmatrix}\\text{1}\\\\\\text{R}\\\\\\text{t11}\\\\\\text{R.t11}\\end{pmatrix}\\end{pmatrix}",
