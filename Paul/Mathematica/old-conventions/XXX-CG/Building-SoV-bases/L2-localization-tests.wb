      {
       "data": "Out[735]= \\begin{array}{|c|c|}\\hline\\text{highest weight of irrep in V (x) V} & \\text{<y| (x) e1\\^{}T . h}\\\\\\hline\\left\\{2,2,2\\right\\} & 0\\\\\\hline\\left\\{3,2,1\\right\\} & -\\frac{39\\,k2}{472}\\\\\\hline\\left\\{3,2,1\\right\\} & -\\frac{39}{944}\\,\\left(11\\,k1-2\\right)\\,k2\\\\\\hline\\left\\{3,3,0\\right\\} & -\\frac{2145\\,\\left(11\\,k1-4\\right)\\,k2}{15104}\\\\\\hline\\left\\{4,1,1\\right\\} & -\\frac{k1\\,\\left(1155\\,k2+3776\\right)}{9440}\\\\\\hline\\left\\{4,2,0\\right\\} & -\\frac{\\left(11\\,k1-4\\right)\\,\\left(1155\\,k2+3776\\right)}{15104}\\\\\\hline\\end{array}",
       "mime": "text/plain"
