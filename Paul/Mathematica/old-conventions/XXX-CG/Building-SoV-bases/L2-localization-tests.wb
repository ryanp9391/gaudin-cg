  {
   "kind": 2,
   "value": "KP = -1/120;\n(* tau2(x) = sum_a c_a(x) Q^a(x + al h) Q_a(x + be h): scan shifts, then the x-dependence of c_a *)\ntau2At[x_] := Table[tauPoly[[A, 2]] /. u -> x, {A, 64}];\nbilinFit2[x_, al_, be_] := Module[{M = Table[QupA[A, a, x + al hh] QlowA[A, a, x + be hh], {A, 64}, {a, 3}], rhs = tau2At[x], c},\n   c = LeastSquares[M, rhs]; {al, be, N[Max[Abs[M . c - rhs]]/Max[Abs[rhs]], 3], c}];\nbil2 = SortBy[Flatten[Table[bilinFit2[xg, al, be], {al, -2, 2}, {be, -2, 2}], 1], #[[3]] &];\n{al2, be2} = bil2[[1, 1 ;; 2]];\nkap2 = Rationalize[Re[bil2[[1, 4]]/bil2[[1, 4, 1]]], 10^-20];\n(* P2(x) = c_1(x)/kap2_1: check it is K2/(nu-type product) *)\nP2s = Table[Re[bilinFit2[x, al2, be2][[4, 1]]], {x, xsR}];\nP2times = Table[{nm, Max[Abs[Differences[P2s Table[f[x], {x, xsR}]]]]}, {nm, {\"nu1\", \"nu2\", \"nu3\"}}, {f, {nu[1], nu[2], nu[3]}}];\n{\"best shifts\" -> bil2[[1, 1 ;; 3]], \"next\" -> bil2[[2, 1 ;; 3]], \"kappa2 ratios\" -> kap2}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"677717\" data-output-id=\"90\" data-out-n=\"863\" data-sub-idx=\"10\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"94\" data-sub-start=\"11\" data-sub-end=\"11\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[863]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"22\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:4.2241em;vertical-align:-1.8621em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.3621em;\"><span style=\"top:-4.948em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"></span></span><span style=\"top:-2.838em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.8621em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.3621em;\"><span style=\"top:-4.948em;\"><span class=\"pstrut\" style=\"height:3.45em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size1\">{</span></span><span class=\"mord text\"><span class=\"mord\">best shifts</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→<