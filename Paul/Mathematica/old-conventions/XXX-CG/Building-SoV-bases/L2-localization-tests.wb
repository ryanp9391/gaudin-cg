      {
       "data": "Out[628]= \\begin{array}{|c|c|c|c|}\\hline & \\text{degree} & \\text{leading coeff} & \\text{roots as (u - th\\_s)/h, s = 1, 2}\\\\\\hline\\text{G = Q12/Q\\^{}3 / (z1z2z3)\\^{}(u/h)} & 2 & -0.8333333333+0.\\times 10^{-10}\\,\\mathrm{i} & \\left\\{-0.22077922,2.\\,,2.\\,,4.2207792\\right\\}\\\\\\hline\\text{G' = Q\\^{}23/Q\\_1 / (z1z2z3)\\^{}(-u/h)} & 2 & 0.5333333333+0.\\times 10^{-10}\\,\\mathrm{i} & \\left\\{-2.2207792,0,0,2.2207792\\right\\}\\\\\\hline\\text{compare: 1/z2 - 1/z1, 1/z3 - 1/z2} &  & \\left\\{-\\frac{5}{6},\\frac{8}{15}\\right\\} & \\\\\\hline\\end{array}",
