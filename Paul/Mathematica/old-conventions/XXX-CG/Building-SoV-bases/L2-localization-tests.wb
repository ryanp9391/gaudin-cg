  {
   "kind": 2,
   "value": "(* single-ratio scan: eig = C F(p)/F(q) with C state-independent, over all families and special points *)\nfams2 = Join[fams, <|\"Q^2\" -> (Qup[#1, 2, #2] &), \"Q_2\" -> (Qlow[#1, 2, #2] &)|>];\nscanPts = Flatten[Table[th[s] + n hh, {s, 2}, {n, -1, 4}]];\nratioScan[e_] := Module[{res = {}},\n   Do[With[{vals = Table[fams2[f][A, p], {A, 64}, {p, scanPts}]},\n     Do[If[Min[Abs[vals[[All, j]]]] > 10^-30 && i != j,\n       With[{cs = e vals[[All, j]]/vals[[All, i]]}, AppendTo[res, {f, (scanPts[[i]] - th[1])/hh, (scanPts[[j]] - th[1])/hh, N[Max[Abs[cs - Mean[cs]]]/Abs[Mean[cs]], 3], N[Mean[cs], 8]}]]],\n      {i, Length[scanPts]}, {j, Length[scanPts]}]], {f, Keys[fams2]}];\n   Take[SortBy[res, #[[4]] &], 2]];\npieces = <|\"t10(th1)\" -> Oof[{\"110\", \"100\"}], \"t11(th1)\" -> Oof[{\"111\", \"100\"}], \"t10S(th2+2h)\" -> Oof[{\"100\", \"110\"}], \"t11S(th2+2h)\" -> Oof[{\"100\", \"111\"}]|>;\npieceScan = KeyValueMap[{#1, ratioScan[eigOf[#2]]} &, pieces];\n{\"(th2 - th1)/h\" -> (th[2] - th[1])/hh}",
   "languageId": "wolfram",
   "outputs": [
    {
