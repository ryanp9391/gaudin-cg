       "data": "Out[881]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{site-2 w \\\\ site-1 op: \\{dim V\\_loc, invariant\\}} & \\text{t10} & \\text{t11} & \\text{R} & \\text{R.t11} & \\text{t20} & \\text{t21}\\\\\\hline\\text{e1 \\{2, 1, 0\\}} & \\left\\{1,\\mathrm{True}\\right\\} & \\left\\{2,\\mathrm{True}\\right\\} & \\left\\{2,\\mathrm{True}\\right\\} & \\left\\{1,\\mathrm{True}\\right\\} & \\left\\{1,\\mathrm{True}\\right\\} & \\left\\{1,\\mathrm{True}\\right\\}\\\\\\hline\\text{e2 \\{2, 0, 1\\}} & \\left\\{1,\\mathrm{True}\\right\\} & \\left\\{2,\\mathrm{True}\\right\\} & \\left\\{2,\\mathrm{True}\\right\\} & \\left\\{1,\\mathrm{True}\\right\\} & \\left\\{1,\\mathrm{True}\\right\\} & \\left\\{1,\\mathrm{True}\\right\\}\\\\\\hline\\text{e3 \\{1, 2, 0\\}} & \\left\\{1,\\mathrm{True}\\right\\} & \\left\\{2,\\mathrm{True}\\right\\} & \\left\\{2,\\mathrm{True}\\right\\} & \\left\\{1,\\mathrm{True}\\right\\} & \\left\\{1,\\mathrm{True}\\right\\} & \\left\\{1,\\mathrm{True}\\right\\}\\\\\\hline\\text{e4 \\{1, 1, 1\\}} & \\left\\{0,\\text{-}\\right\\} & \\left\\{0,\\text{-}\\right\\} & \\left\\{0,\\text{-}\\right\\} & \\left\\{0,\\text{-}\\right\\} & \\left\\{0,\\text{-}\\right\\} & \\left\\{0,\\text{-}\\right\\}\\\\\\hline\\text{e5 \\{1, 1, 1\\}} & \\left\\{0,\\text{-}\\right\\} & \\left\\{0,\\text{-}\\right\\} & \\left\\{0,\\text{-}\\right\\} & \\left\\{0,\\text{-}\\right\\} & \\left\\{0,… [latex truncated: 3026 chars total]",
