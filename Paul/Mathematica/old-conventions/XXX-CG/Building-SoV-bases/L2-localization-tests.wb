      {
       "data": "Out[951]= \\begin{aligned}\n  &\\left\\{\\text{separability error}\\to 17.4 \\right. \\\\\n  &\\left. ,\\text{reference labels}\\to \\begin{pmatrix}-1 & 1 & 1\\\\-1 & 1 & 1\\end{pmatrix}\\right\\}\n\\end{aligned}",
