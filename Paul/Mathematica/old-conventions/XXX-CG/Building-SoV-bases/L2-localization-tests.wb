  {
   "kind": 2,
   "value": "(* x = e1^T N with N a combination of PBW monomials E12^a E13^b E23^c; y = e1^T S(N) *)\n(* explicit powers: MatrixPower[nilpotent, 0] is not the identity *)\nmpow[m_, 0] := IdentityMatrix[Length[m]]; mpow[m_, n_Integer?Positive] := Nest[m . # &, m, n - 1];\nmono = Flatten[Table[{a, b, c}, {a, 0, 2}, {b, 0, 2}, {c, 0, 2}], 2];\nmonoMat[{a_, b_, c_}] := mpow[Ee[2][1, 2], a] . mpow[Ee[2][1, 3], b] . mpow[Ee[2][2, 3], c];\nantiMat[{a_, b_, c_}] := (-1)^(a + b + c) mpow[Ee[1][2, 3], c] . mpow[Ee[1][1, 3], b] . mpow[Ee[1][1, 2], a];\nrowsM = ext[2, True] . monoMat[#] & /@ mono;\n(* pick an independent spanning set of 8 monomials *)\nbasisIdx = Module[{sel = {}}, Do[If[MatrixRank[rowsM[[Append[sel, i]]]] > Length[sel], AppendTo[sel, i]], {i, Length[mono]}]; sel];\ncoefN = Together[LinearSolve[Transpose[rowsM[[basisIdx]]], xk]];\nyk = Together[Sum[coefN[[j]] ext[1, True] . antiMat[mono[[basisIdx[[j]]]]], {j, Length[basisIdx]}]];\n(* check on the highest-weight states of V (x) V: kernel of the global raising generators *)\nhws = NullSpace[Join[EE[1, 2], EE[2, 3]]];\nhwCheck = Simplify[(kron[ext[1, True], xk] - kron[yk, ext[2, True]]) . Transpose[hws]];\n{\"monomials used\" -> mono[[basisIdx]], \"# highest-weight states\" -> Length[hws], \"(e1 (x) x - y (x) e1).h = 0 for all h\" -> (hwCheck === ConstantArray[0, Length[hws]])}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"677717\" data-output-id=\"69\" data-out-n=\"728\" data-sub-idx=\"14\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"64\" data-sub-start=\"14\" data-sub-end=\"14\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[728]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-line-broken=\"1\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:15.9001em;vertical-align:-7.7em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.2em;\"><span style=\"top:-14.41em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"></span></span><span style=\"top:-8.7em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"></span></span><span style=\"top:-3.01em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"></span></span><span style=\"top:-1.51em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"></span></span><span style=\"top:-0.01em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:7.7em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:8.2em;\"><span style=\"top:-14.41em;\"><span class=\"pstrut\" style=\"height:7.05em;\"></span><span class=\"mord\"><span class=\"mord\"></span><s