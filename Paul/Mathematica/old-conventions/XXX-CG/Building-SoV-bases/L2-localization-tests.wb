  {
   "kind": 2,
   "value": "zprod = N[Times @@ zs, prec];\ngPts[f_, g_, sgn_] := Table[{x, f[1, x]/g[1, x]/zprod^(sgn x/hh)}, {x, Range[0, 8]/9 + 1/10}];\nGpoly = Expand@InterpolatingPolynomial[gPts[Q12, Q3, 1], u];\nGppoly = Expand@InterpolatingPolynomial[gPts[Q23, Qlow[#1, 1, #2] &, -1], u];\nrootsIn[p_] := Sort@Chop[N[Flatten[Table[(x - th[s])/hh, {s, 2}, {x, u /. NSolve[Chop[p, 10^-40] == 0, u]}]], 8], 10^-20];\nGrid[{{\"\", \"degree\", \"leading coeff\", \"roots as (u - th_s)/h, s = 1, 2\"},\n  {\"G = Q12/Q^3 / (z1z2z3)^(u/h)\", Exponent[Chop[Gpoly, 10^-40], u], N[Coefficient[Gpoly, u, Exponent[Chop[Gpoly, 10^-40], u]], 10], rootsIn[Gpoly]},\n  {\"G' = Q^23/Q_1 / (z1z2z3)^(-u/h)\", Exponent[Chop[Gppoly, 10^-40], u], N[Coefficient[Gppoly, u, Exponent[Chop[Gppoly, 10^-40], u]], 10], rootsIn[Gppoly]},\n  {\"compare: 1/z2 - 1/z1, 1/z3 - 1/z2\", \"\", {1/zs[[2]] - 1/zs[[1]], 1/zs[[3]] - 1/zs[[2]]}, \"\"}}, Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
