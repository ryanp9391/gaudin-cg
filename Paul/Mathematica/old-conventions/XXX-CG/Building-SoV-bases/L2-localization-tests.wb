  {
   "kind": 2,
   "value": "Oof[{g1_, g2_}] := Og[towers[Gd, \"t\", th[1]]][g1] . Og[towers[Gd, \"tS\", th[2] + 2 hh]][g2];\ncomboOp[{labs_, cs_}] := Sum[cs[[i]] Oof[labs[[i]]], {i, Length[labs]}];\nfams = <|\"Q_1\" -> (Qlow[#1, 1, #2] &), \"Q^3\" -> (Q3[#1, #2] &), \"Q_12\" -> (Q12[#1, #2] &), \"Q^23\" -> (Q23[#1, #2] &)|>;\nfitPts = Flatten[Table[th[s] + n hh, {s, 2}, {n, 0, 3}]];\n(* e_A F(p0) = sum_p c_p F(p), c state-independent; residual relative *)\nfitOne[e_, F_, p0_] := Module[{M, rhs, cols, c},\n   M = Table[F[A, p], {A, 64}, {p, fitPts}];\n   cols = Select[Range[Length[fitPts]], Max[Abs[M[[All, #]]]] > 10^-30 &];\n   rhs = Table[e[[A]] F[A, p0], {A, 64}];\n   c = LeastSquares[M[[All, cols]], rhs];\n   {N[Max[Abs[M[[All, cols]] . c - rhs]]/Max[Abs[rhs]], 3], Thread[fitPts[[cols]] -> Chop[c, 10^-30]]}];\nbestFit[e_] := First@SortBy[Flatten[Table[{f, p0, Sequence @@ fitOne[e, fams[f], p0]}, {f, Keys[fams]}, {p0, fitPts}], 1], #[[3]] &];\ncombos1 = Select[minB1, Length[#[[1]]] > 1 &]; combos2 = Select[minB2, Length[#[[1]]] > 1 &];\nfitRes = Join[{{\"control R(th1)\", bestFit[eigOf[Oof[{\"200\", \"100\"}]]]}},\n   Table[{\"site-1 loc: \" <> ToString[c[[1]]], bestFit[eigOf[comboOp[c]]]}, {c, combos1}],\n   Table[{\"site-2 loc: \" <> ToString[c[[1]]], bestFit[eigOf[comboOp[c]]]}, {c, combos2}]];\nGrid[Prepend[{#[[1]], #[[2, 1]], #[[2, 2]], #[[2, 3]]} & /@ fitRes, {\"combination\", \"family\", \"normaliser point\", \"rel. residual\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<details class=\"vscode-wolfram-message-output\" style=\"color:#f44;border-left:3px solid #f44;background:rgba(255,68,68,0.08);padding:2px 6px;margin:1px 0;border-radius:0 3px 3px 0;font-family:monospace;font-size:0.85em\"><summary style=\"cursor:pointer\">8 warnings</summary><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression -------- encountered.                                       -50                                  0. 10</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0. 10    ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression -------- encountered.                                       -52                                  0. 10</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0. 10    ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Power::infy: Infinite expression -------- encountered.                                       -52                                  0. 10</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">General::stop: Further output of Power::infy will be suppressed during this calculation.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">Infinity::indet: Indeterminate expression 0. 10    ComplexInfinity encountered.</div><div style=\"padding:2px 0 2px 4px;border-top:1px solid rgba(255,68,68,0.15)\">General::stop: Further output of Infinity::indet will be suppressed during this calculation.</div></details>",
       "mime": "x-application/wolfram-language-html"
