      {
       "data": "Out[978]= \\begin{aligned}\n  &\\left\\{\\text{\\# ratios used}\\to 72,\\text{site-1 unmatched} \\right. \\\\\n  &\\left. \\to \\begin{pmatrix}\\left\\{-1,0,1\\right\\} & \\{\\}\\\\\\left\\{-1,0,2\\right\\} & \\{\\}\\\\\\left\\{0,1,1\\right\\} & \\{\\}\\\\\\left\\{0,1,2\\right\\} & \\{\\}\\\\\\left\\{0,2,2\\right\\} & \\{\\}\\end{pmatrix}\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
