  {
   "kind": 2,
   "value": "(* does X1 compose with the site-1 singles and stay localized? which single-site state, singlet overlap *)\ncomposeTest[] := Module[{P = normPieces[], X1, o1 = towers[Gd, \"t\", th[1]], R1, sing1},\n   X1 = P[\"tS10n\"] - 1/2 P[\"RSn\"] + (1 - (th[1] - th[2])/hh) P[\"t10n\"];\n   R1 = o1[\"t20\"] . Inverse[o1[\"t10\"]];\n   sing1 = Map[f1 . # &, OgSite[1, \"t\", th[1]]];\n   Table[With[{v = kron[f1, f2] . X1 . op[[2]]}, {op[[1]], MatrixRank[ArrayReshape[v, {d1, d2}]],\n      If[MatrixRank[ArrayReshape[v, {d1, d2}]] == 1, Pick[Keys[sing1], Unitize[Chop[N[LinearSolve[Transpose[Values[sing1]], fact[1, v]]], 10^-12]], 1], \"-\"], v . sing}],\n    {op, {\"1\" -> IdentityMatrix[d1 d2], \"R\" -> R1, \"t11\" -> o1[\"t11\"], \"R.t11\" -> R1 . o1[\"t11\"]}}]];\ncompRes = Table[setPoint[p]; composeTest[], {p, pts4}];\nGrid[Prepend[Join[Prepend[#, 1] & /@ compRes[[1]], Prepend[#, 2] & /@ compRes[[2]]], {\"point\", \"X1 . O\", \"rank\", \"single-site content\", \"singlet\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
