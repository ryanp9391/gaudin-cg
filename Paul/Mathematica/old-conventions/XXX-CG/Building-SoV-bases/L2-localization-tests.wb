  {
   "kind": 2,
   "value": "(* clean each site-1 triple so that its one-body factor is exactly one single-site state (110, 210, 221) *)\nsingleOps1 = <|\"100\" -> Oof[{\"100\", \"100\"}], \"111\" -> Oof[{\"111\", \"100\"}], \"200\" -> Oof[{\"200\", \"100\"}], \"211\" -> Oof[{\"211\", \"100\"}]|>;\n(* scale of each direct single: factor of <Omega|O_{g|100}> = lam_g single1[g] *)\nlamS = Association@KeyValueMap[#1 -> (fact[1, kron[f1, f2] . #2] . single1[#1])/(single1[#1] . single1[#1]) &, singleOps1];\ncleanOp[c_, target_] := Module[{op = comboOp[c], v, coef},\n   v = fact[1, kron[f1, f2] . op];\n   coef = AssociationThread[Keys[single1], LinearSolve[Transpose[Values[single1]], v]];\n   (op - Sum[coef[g]/lamS[g] singleOps1[g], {g, Keys[singleOps1]}])/coef[target]];\ncleaned1 = <|\"110\" -> cleanOp[minB1[[5]], \"110\"], \"210\" -> cleanOp[minB1[[6]], \"210\"], \"221\" -> cleanOp[minB1[[7]], \"221\"]|>;\n(* check: factor is exactly the single-site state, site 2 in vacuum *)\ncleanCheck = KeyValueMap[{#1, MatrixRank[ArrayReshape[kron[f1, f2] . #2, {d1, d2}]], MatrixRank[{fact[1, kron[f1, f2] . #2], single1[#1]}], fact[2, kron[f1, f2] . #2] . f2 != 0} &, cleaned1];\ncleanScan = KeyValueMap[{#1, ratioScan[eigOf[#2]][[1, 1 ;; 4]]} &, cleaned1];\n{cleanCheck, cleanScan}",
   "languageId": "wolfram",
   "outputs": [
