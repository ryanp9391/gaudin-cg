       "data": "Out[775]= \\begin{array}{|c|c|c|c|}\\hline\\text{combination} & \\text{family} & \\text{normaliser point} & \\text{rel. residual}\\\\\\hline\\text{control R(th1)} & \\text{Q\\_1} & \\frac{13}{21} & 0.\\times 10^{-51}\\\\\\hline\\text{site-1 loc: \\{\\{100, 110\\}, \\{100, 200\\}, \\{110, 100\\}\\}} & \\text{Q\\_1} & \\frac{20}{21} & 0.681\\\\\\hline\\text{site-1 loc: \\{\\{200, 110\\}, \\{200, 200\\}, \\{210, 100\\}\\}} & \\text{Q\\_1} & \\frac{13}{21} & 0.664\\\\\\hline\\text{site-1 loc: \\{\\{211, 110\\}, \\{211, 200\\}, \\{221, 100\\}\\}} & \\text{Q\\_1} & \\frac{13}{21} & 0.641\\\\\\hline\\text{site-2 loc: \\{\\{100, 110\\}, \\{110, 100\\}, \\{200, 100\\}\\}} & \\text{Q\\_12} & -\\frac{4}{33} & 0.532\\\\\\hline\\text{site-2 loc: \\{\\{100, 210\\}, \\{110, 200\\}, \\{200, 200\\}\\}} & \\text{Q\\_12} & -\\frac{5}{11} & 0.756\\\\\\hline\\text{site-2 loc: \\{\\{100, 221\\}, \\{110, 211\\}, \\{200, 211\\}\\}} & \\text{Q\\_1} & -\\frac{4}{33} & 0.776\\\\\\hline\\end{array}",
