      {
       "data": "Out[698]= \\begin{array}{|c|c|}\\hline\\text{check (point 2)} & \\text{result}\\\\\\hline\\text{Baxter residual (q1, q2, q\\^{}2, q\\^{}3)} & 0.\\times 10^{-48}\\\\\\hline\\text{localized: site 1 (t at th1), site 2 (tS at th2+2h)} & \\begin{pmatrix}\\left\\{\\text{1}\\right\\} & \\left\\{\\text{R}\\right\\} & \\left\\{\\text{t11}\\right\\} & \\left\\{\\text{R.t11}\\right\\}\\\\\\left\\{\\text{1}\\right\\} & \\left\\{\\text{R}\\right\\} & \\left\\{\\text{t11}\\right\\} & \\left\\{\\text{R.t11}\\right\\}\\end{pmatrix}\\\\\\hline\\text{<Omega| tS11 = c12 <Omega1| (x) <Omega2| tS11\\^{}(2)} & \\mathrm{True}\\\\\\hline\\text{eig R(th1) = Q1(th1+2h)/Q1(th1+h)} & 0.\\times 10^{-49}\\\\\\hline\\text{eig R\\^{}S(th2+2h) = Q\\^{}3(th2)/Q\\^{}3(th2+h)} & 0.\\times 10^{-48}\\\\\\hline\\text{eig tS11(th2+2h) = Q\\^{}23(th2+h)/Q\\^{}23(th2+2h)} & 0.\\times 10^{-48}\\\\\\hline\\text{Q\\^{}3 bracket (k\\^{}(-u/h), Res at th2+h) vs <Omega|(1-kR\\^{}S)|Psi>} & 0.\\times 10^{-47}\\\\\\hline\\text{Q\\^{}23 bracket (k\\^{}(-u/h), Res at th2+2h) vs <Omega|(1-k tS11)|Psi>} & 0.\\times 10^{-48}\\\\\\hline\\text{Q12 form vs <Omega|(1-kR\\^{}S)|Psi>} & 0.\\times 10^{-47}\\\\\\hline\\text{Q1 form vs <Omega|(1-k tS11)|Psi>} & 0.\\times 10^{-48}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
