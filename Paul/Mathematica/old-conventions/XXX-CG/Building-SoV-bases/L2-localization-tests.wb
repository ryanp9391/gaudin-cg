  {
   "kind": 2,
   "value": "(* nu-normalised pieces; localizing coefficients of X = tS10n(th2+2h) + a RSn + b t10n(th1) (site 1) and its mirror (site 2) *)\nnormPieces[] := Module[{o1 = towers[Gd, \"t\", th[1]], o2 = towers[Gd, \"tS\", th[2] + 2 hh], x2 = th[2] + 2 hh},\n   <|\"t10n\" -> o1[\"t10\"]/nu[1][th[1]], \"Rn\" -> o1[\"t20\"] . Inverse[o1[\"t10\"]]/nu[1][th[1] + hh],\n     \"tS10n\" -> o2[\"t10\"]/nu[3][x2], \"RSn\" -> o2[\"t20\"] . Inverse[o2[\"t10\"]]/nu[3][x2 - hh]|>];\nlocCoefs[ops_, site_] := Module[{S = kron[f1, f2] . # & /@ ops, V, ns},\n   V = If[site == 1, Table[kron[UnitVector[d1, k], f2], {k, d1}], Table[kron[f1, UnitVector[d2, k]], {k, d2}]];\n   ns = NullSpace[Transpose[Join[S, V]]]; ns[[1, 1 ;; Length[ops]]]/ns[[1, 1]]];\ncoefAt[p_] := (setPoint[p]; With[{P = normPieces[]},\n    {p, (th[1] - th[2])/hh, locCoefs[{P[\"tS10n\"], P[\"RSn\"], P[\"t10n\"]}, 1], locCoefs[{P[\"t10n\"], P[\"Rn\"], P[\"tS10n\"]}, 2]}]);\ncoefTab = coefAt /@ pts4;\nGrid[Prepend[{#[[1, 1 ;; 3]], #[[2]], #[[3]], #[[4]]} & /@ coefTab, {\"point (h, th1, th2)\", \"th12/h\", \"site 1: {tS10n, RSn, t10n}\", \"site 2: {t10n, Rn, tS10n}\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
