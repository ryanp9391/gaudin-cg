      {
       "data": "Out[466]= \\begin{array}{|c|c|c|c|c|c|c|c|c|}\\hline\\text{vacuum} & \\text{tower} & \\text{at site} & \\text{op} & \\text{rank} & \\text{f1\\textasciitilde{}hw1} & \\text{f1\\textasciitilde{}lw1} & \\text{f2\\textasciitilde{}hw2} & \\text{f2\\textasciitilde{}lw2}\\\\\\hline\\text{hw} & \\text{t} & 1 & \\text{t10} & 2 & \\text{-} & \\text{-} & \\text{-} & \\text{-}\\\\\\hline\\text{hw} & \\text{t} & 1 & \\text{t11} & 1 & \\text{no} & \\text{no} & \\text{yes} & \\text{no}\\\\\\hline\\text{hw} & \\text{t} & 1 & \\text{t20} & 2 & \\text{-} & \\text{-} & \\text{-} & \\text{-}\\\\\\hline\\text{hw} & \\text{t} & 1 & \\text{t21} & 1 & \\text{no} & \\text{no} & \\text{yes} & \\text{no}\\\\\\hline\\text{hw} & \\text{t} & 1 & \\text{t20.t10\\^{}-1} & 7 & \\text{-} & \\text{-} & \\text{-} & \\text{-}\\\\\\hline\\text{hw} & \\text{tS} & 2 & \\text{t10} & 2 & \\text{-} & \\text{-} & \\text{-} & \\text{-}\\\\\\hline\\text{hw} & \\text{tS} & 2 & \\text{t11} & 1 & \\text{yes} & \\text{no} & \\text{no} & \\text{no}\\\\\\hline\\text{hw} & \\text{tS} & 2 & \\text{t20} & 2 & \\text{-} & \\text{-} & \\text{-} & \\text{-}\\\\\\hline\\text{hw} & \\text{tS} & 2 & \\text{t21} & 1 & \\text{yes} & \\text{no} & \\text{no} & \\text{no}\\\\\\hline\\text{hw} & \\text{tS} & 2 & \\text{t20.t10\\^{}-1} & 7 & \\text{-} & \\text{-} & \\text… [latex truncated: 2208 chars total]",
