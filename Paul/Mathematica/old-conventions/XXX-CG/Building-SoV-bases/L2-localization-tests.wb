       "data": "Out[871]= \\begin{array}{|c|c|}\\hline\\text{check (point 1)} & \\text{rel. error}\\\\\\hline\\text{tau1(x) = (-1/120) / nu2(x) sum\\_a kappa\\_a Q\\_a(x+h) Q\\^{}a(x-h), kappa = (16, 9, -25)} & 0.\\times 10^{-50}\\\\\\hline\\text{tau2(x) = -120 sum\\_a kappa2\\_a Q\\^{}a(x+h) Q\\_a(x-2h), kappa2 = (1, 9/16, -25/16)} & 0.\\times 10^{-50}\\\\\\hline\\text{eig X1 (site-1 one-body, span\\{100,110,200\\}) from Q's} & 0.\\times 10^{-50}\\\\\\hline\\text{eig Y1 (site-1 one-body, reaches singlet) from Q's} & 1.11\\times 10^{-30}\\\\\\hline\\end{array}",
