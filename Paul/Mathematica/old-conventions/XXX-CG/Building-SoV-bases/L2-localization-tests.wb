       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[1055]= \\begin{array}{|c|c|}\\hline\\text{one-body operator on site 1} & \\text{singlet overlap of (w0 M) (x) e1}\\\\\\hline\\text{t22(th1+-2h)} & 0\\\\\\hline\\text{t22(th1+-1h)} & 0\\\\\\hline\\text{t22(th1+0h)} & 0\\\\\\hline\\text{t22(th1+1h)} & 0\\\\\\hline\\text{t22(th1+2h)} & 0\\\\\\hline\\text{t11(th1+-1h) t11(th1+-1h)} & 0\\\\\\hline\\text{t11(th1+-1h) t11(th1+0h)} & 0\\\\\\hline\\text{t11(th1+-1h) t11(th1+1h)} & 0\\\\\\hline\\text{t11(th1+-1h) t11(th1+2h)} & 0\\\\\\hline\\text{t11(th1+0h) t11(th1+0h)} & 0\\\\\\hline\\text{t11(th1+0h) t11(th1+1h)} & 0\\\\\\hline\\text{t11(th1+0h) t11(th1+2h)} & 0\\\\\\hline\\text{t11(th1+1h) t11(th1+1h)} & 0\\\\\\hline\\text{t11(th1+1h) t11(th1+2h)} & 0\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
