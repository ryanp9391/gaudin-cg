  {
   "kind": 2,
   "value": "(* site-2 candidates: tS at theta_2 + 2h; control: t at theta_1 (site-1 localization) *)\nptsAA = {{\"t\", 1, th[1]}, {\"tS\", 2, th[2] + hh \\[CapitalLambda][2][[1]]}};\nsurveyAA = Flatten[Table[rowOf[hwQ, p[[1]], p[[2]], #] & /@ Quiet[opsOf[p[[1]], p[[3]]]], {hwQ, {True, False}}, {p, ptsAA}], 2];\nGrid[Prepend[surveyAA, {\"vacuum\", \"tower\", \"at site\", \"op\", \"rank\", \"f1~hw1\", \"f1~lw1\", \"f2~hw2\", \"f2~lw2\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
