  {
   "kind": 2,
   "value": "(* h = 1, th1 = T, th2 = 0; weights = products of simple-pole residues times the insertions *)\nClear[TT, uu, vv];\nresW[{p_, q_}, Nf_, f_] := With[{u0 = TT + p, v0 = q}, (Nf /. {uu -> u0, vv -> v0}) (f /. {uu -> u0, vv -> v0}) (1/(u0 - TT - Complement[{1, 2}, {p}][[1]])) (1/(v0 - Complement[{1, 2}, {q}][[1]]))];\nfacs1 = Flatten[Table[{(uu - a)^e}, {a, -2, 3}, {e, {1, -1}}], 1];\nfacs2 = Flatten[Table[{(vv - TT - b)^e}, {b, -3, 3}, {e, {1, -1}}], 1];\nfacsX = Flatten[Table[{(uu - vv - TT - s)^e}, {s, -3, 3}, {e, {1, -1}}], 1];\ncands = Union@Flatten[{1, Sequence @@ (First /@ facs1), Sequence @@ (First /@ facs2), Sequence @@ (First /@ facsX),\n     Flatten@Outer[Times, First /@ facs1, First /@ facs2], Flatten@Outer[Times, First /@ facsX, First /@ Join[facs1, facs2]]}];\ntarget = 1/(TT - 1);\nhitsInt = Select[Flatten[Table[With[{r = Simplify[resW[{1, 2}, Nf, f]/resW[{2, 1}, Nf, f]]}, {Nf, f, r}], {Nf, {(uu - vv - TT), (uu - vv - TT)^2}}, {f, cands}], 1],\n   Quiet[Simplify[#[[3]] - target] === 0] && Quiet[(#[[1]] #[[2]] /. {uu -> TT + 1, vv -> 1}) === 0] && Quiet[(#[[1]] #[[2]] /. {uu -> TT + 2, vv -> 2}) === 0] &];\n{\"# candidate insertions\" -> Length[cands], \"hits (N, f)\" -> hitsInt[[All, 1 ;; 2]]}",
   "languageId": "wolfram",
   "outputs": [
    {
