  {
   "kind": 2,
   "value": "(* final Q-only assembly (point 1): tau2 bilinear (no division), tau1 at the nu2 zero th1+h by the limit S'/nu2' *)\ntau2Q[A_, x_] := -120 Sum[kap2[[a]] QupA[A, a, x + hh] QlowA[A, a, x - 2 hh], {a, 3}];\ntau2atTh1Q[A_] := tau2Q[A, th[1]];\nSbil[A_, x_] := Sum[kap[[a]] QlowA[A, a, x + hh] QupA[A, a, x - hh], {a, 3}];\ntau1QL[A_, r_] := Module[{y}, KP (D[Sbil[A, y], y] /. y -> r)/(D[nu[2][y], y] /. y -> r)];\nt21nQ[A_] := (tau2atTh1Q[A] tau1QL[A, x1 + hh] - First[tau3Common])/(nu[1][x1] nu[1][x1 + hh] nu[1][x1 - hh]);\neigX1Q = Table[tS10nQ[A] - 1/2 rhoSQ[A] + (1 - T12) t10nQ[A], {A, 64}];\neigY1Q = Table[rho1Q[A] t11nQ[A] (tS10nQ[A] - 1/2 (T12 - 1)^2/(T12 (T12 - 2)) rhoSQ[A]) - 1/2 T12 (T12 - 1)/(T12 - 2) rho1Q[A] t21nQ[A], {A, 64}];\nGrid[{{\"check (point 1)\", \"rel. error\"},\n  {\"tau1(x) = (-1/120) / nu2(x) sum_a kappa_a Q_a(x+h) Q^a(x-h), kappa = (16, 9, -25)\", relErr[Table[tau1Q[A, 3/7], {A, 64}], Table[tauPoly[[A, 1]] /. u -> 3/7, {A, 64}]]},\n  {\"tau2(x) = -120 sum_a kappa2_a Q^a(x+h) Q_a(x-2h), kappa2 = (1, 9/16, -25/16)\", relErr[Table[tau2Q[A, 3/7], {A, 64}], Table[tauPoly[[A, 2]] /. u -> 3/7, {A, 64}]]},\n  {\"eig X1 (site-1 one-body, span{100,110,200}) from Q's\", relErr[eigX1Q, eigOf[X1op]]},\n  {\"eig Y1 (site-1 one-body, reaches singlet) from Q's\", relErr[eigY1Q, eigOf[Y1op]]}}, Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"677717\" data-output-id=\"91\" data-out-n=\"871\" data-sub-idx=\"8\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"95\" data-sub-start=\"8\" data-sub-end=\"12\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[871]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:6.04em;vertical-align:-2.75em;\"></span><span class=\"mord\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.29em;\"><span style=\"top:-5.25em;\"><span class=\"pstrut\" style=\"height:5.25em;\"></span><span class=\"mtable\"><span class=\"vertical-separator\" style=\"height:6em;border-right-width:0.04em;border-right-style:solid;margin:0 -0.02em;vertical-align:-2.75em;\"></span><span class=\"arraycolsep\" style=\"width:0.5em;\"></span><span class=\"col-align-c\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:3.25em;\"><span style=\"top:-5.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">check (point 1)</span></span></span></span><span style=\"top:-4.21em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord text\"><span class=\"mord\">tau1(x) = (-1/120) / nu2(x) sum_a kappa_a Q_a(x+h) Q</span><span class=\"mord accent\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.6944em;\"><span style=\"top:-3em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"></span></span><span 