  {
   "kind": 2,
   "value": "(* minimal localized combinations in the mixed basis: smallest label subsets whose span meets the localized space *)\nminimalCombos[st_, site_] := Module[{keys = Keys[st], V, inv, found = {}, newFound, labs},\n   V = If[site == 1, Table[kron[UnitVector[d1, k], f2], {k, d1}], Table[kron[f1, UnitVector[d2, k]], {k, d2}]];\n   inv = Union@Flatten[Position[#, _?(# != 0 &)] & /@ locSpan[st, site][[3]]];\n   labs = keys[[inv]];\n   Do[\n    newFound = Select[Subsets[labs, {n}], Function[sub, Not@AnyTrue[found, SubsetQ[sub, #[[1]]] &] &&\n        Length[NullSpace[Transpose[Join[st /@ sub, V]]]] > 0]];\n    found = Join[found, Table[{sub, First[NullSpace[Transpose[Join[st /@ sub, V]]]][[1 ;; n]]}, {sub, newFound}]],\n    {n, 1, 3}];\n   found];\nminB1 = minimalCombos[stB, 1]; minB2 = minimalCombos[stB, 2];\n{Length[minB1], Length[minB2]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"677717\" data-output-id=\"76\" data-out-n=\"762\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"79\" data-sub-start=\"12\" data-sub-end=\"12\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[762]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"XGxlZnRcezcsN1xyaWdodFx9\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">7</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">7</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span></span></div></div></div>",
