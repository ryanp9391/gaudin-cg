       "data": "Out[834]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{point} & \\text{X1 . O} & \\text{rank} & \\text{single-site content} & \\text{singlet}\\\\\\hline1 & \\text{1} & 1 & \\left\\{\\text{100},\\text{110},\\text{200}\\right\\} & 0\\\\\\hline1 & \\text{R} & 2 & \\text{-} & 0\\\\\\hline1 & \\text{t11} & 2 & \\text{-} & 0\\\\\\hline1 & \\text{R.t11} & 2 & \\text{-} & -\\frac{586379520}{35153041}\\\\\\hline2 & \\text{1} & 1 & \\left\\{\\text{100},\\text{110},\\text{200}\\right\\} & 0\\\\\\hline2 & \\text{R} & 2 & \\text{-} & 0\\\\\\hline2 & \\text{t11} & 2 & \\text{-} & 0\\\\\\hline2 & \\text{R.t11} & 2 & \\text{-} & \\frac{130904451}{2258407840}\\\\\\hline\\end{array}",
