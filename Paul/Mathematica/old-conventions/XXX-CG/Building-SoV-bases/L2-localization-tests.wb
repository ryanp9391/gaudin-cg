       "data": "Out[759]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{span} & \\text{localized on site} & \\text{rank of 64} & \\text{dim localized} & \\text{\\# labels involved}\\\\\\hline\\text{original basis (t at th1, t at th2)} & 1 & 64 & 8 & 12\\\\\\hline\\text{original basis} & 2 & 64 & 8 & 35\\\\\\hline\\text{mixed (t at th1, tS at th2+2h)} & 1 & 64 & 8 & 18\\\\\\hline\\text{mixed} & 2 & 64 & 8 & 18\\\\\\hline\\end{array}",
