  {
   "kind": 2,
   "value": "singletFromQ[p_] := Module[{T, x1, x2, tp, rho, Eop, D, EQ, ratio},\n   setPoint[p]; computeSpectrum[];\n   T = (th[1] - th[2])/hh; x1 = th[1]; x2 = th[2];\n   tp[A_, a_, x_] := tauPoly[[A, a]] /. u -> x;\n   rho[A_, x_] := (tp[A, 1, x] tp[A, 1, x + hh] - tp[A, 2, x + hh])/tp[A, 1, x];\n   Eop = Table[rho[A, x1] ((tp[A, 2, x1] tp[A, 1, x1 + hh] - tp[A, 3, x1 + hh]) - 1/(T + 1) tp[A, 2, x1] rho[A, x2]), {A, 64}];\n   D[A_, a_, b_] := QlowA[A, 1, x1 + a hh] QlowA[A, 2, x1 + b hh] - QlowA[A, 2, x1 + a hh] QlowA[A, 1, x1 + b hh];\n   EQ = Table[QlowA[A, 1, x1 + 2 hh]/QlowA[A, 1, x1 + hh] (QlowA[A, 1, x2 + hh] D[A, 0, 2] + 1/(T - 1) QlowA[A, 1, x2 + 2 hh] D[A, 0, 1])/(QlowA[A, 1, x2 + hh] D[A, -1, 0]), {A, 64}];\n   ratio = Eop/EQ;\n   {p[[1 ;; 3]], T, N[spreadOf[ratio], 3], N[Mean[ratio], 12]}];\nsingQ = singletFromQ /@ pts4;\nGrid[Prepend[singQ, {\"point (h, th1, th2)\", \"T\", \"spread of E^op / E^Q over 64 states\", \"constant\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
