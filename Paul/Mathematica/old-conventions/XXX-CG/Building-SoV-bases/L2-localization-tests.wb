   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* point 1: assemble eig(X1) and eig(Y1) purely from Q's and compare with the operator eigenvalues *)\nsetPoint[pts4[[1]]];\nKP = Coefficient[firstRat[[3, 1]], u, 0]/Coefficient[firstRat[[3, 2]], u, 2];  (* P(x) = KP / nu2(x) *)\ntau1Q[A_, x_] := KP/nu[2][x] Sum[kap[[a]] QlowA[A, a, x + hh] QupA[A, a, x - hh], {a, 3}];\nC11 = t11sc[[1, 5]];\ntau2atTh1Q[A_] := C11 nu[1][th[1]] nu[1][th[1] - hh] QupA[A, 2, th[1] + hh]/QupA[A, 2, th[1]];\ntau3Common = Union[Round[Table[tauPoly[[A, 3]] /. u -> th[1] + hh, {A, 64}], 10^-30]];\nT12 = (th[1] - th[2])/hh; x1 = th[1]; x2 = th[2] + 2 hh;\nrho1Q[A_] := Qlow[A, 1, x1 + 2 hh]/Qlow[A, 1, x1 + hh];\nrhoSQ[A_] := Q3[A, th[2]]/Q3[A, th[2] + hh];\ntS10nQ[A_] := tau1Q[A, x2]/nu[3][x2];\nt10nQ[A_] := tau1Q[A, x1]/nu[1][x1];\nt11nQ[A_] := tau2atTh1Q[A]/(nu[1][x1] nu[1][x1 - hh]);\nt21nQ[A_] := (tau2atTh1Q[A] tau1Q[A, x1 + hh] - First[tau3Common])/(nu[1][x1] nu[1][x1 + hh] nu[1][x1 - hh]);\neigX1Q = Table[tS10nQ[A] - 1/2 rhoSQ[A] + (1 - T12) t10nQ[A], {A, 64}];\neigY1Q = Table[rho1Q[A] t11nQ[A] (tS10nQ[A] - 1/2 (T12 - 1)^2/(T12 (T12 - 2)) rhoSQ[A]) - 1/2 T12 (T12 - 1)/(T12 - 2) rho1Q[A] t21nQ[A], {A, 64}];\nWith[{P = normPieces[], o1 = towers[Gd, \"t\", th[1]]}, With[{Rn = P[\"Rn\"], t11n = o1[\"t11\"]/(nu[1][x1] nu[1][x1 - hh]), t21n = o1[\"t21\"]/(nu[1][x1] nu[1][x1 + hh] nu[1][x1 - hh])},\n   X1op = P[\"tS10n\"] - 1/2 P[\"RSn\"] + (1 - T12) P[\"t10n\"];\n   Y1op = Rn . t11n . (P[\"tS10n\"] - 1/2 (T12 - 1)^2/(T12 (T12 - 2)) P[\"RSn\"]) - 1/2 T12 (T12 - 1)/(T12 - 2) Rn . t21n]];\n{\"tau3 state-independent\" -> (Length[tau3Common] == 1), \"X1: rel |Q-form - eig|\" -> relErr[eigX1Q, eigOf[X1op]], \"Y1: rel |Q-form - eig|\" -> relErr[eigY1Q, eigOf[Y1op]],\n \"Y1 one-body\" -> MatrixRank[ArrayReshape[kron[f1, f2] . Y1op, {d1, d2}]], \"Y1 singlet\" -> N[kron[f1, f2] . Y1op . sing, 6]}",
   "languageId": "wolfram",
   "outputs": [
