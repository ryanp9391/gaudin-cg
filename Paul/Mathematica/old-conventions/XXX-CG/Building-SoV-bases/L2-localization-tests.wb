  {
   "kind": 2,
   "value": "qDual1 = Table[solveMonic[baxDual[tauPoly[[A]], 1/N[zs[[1]], prec]], muOf[[A, 1]]], {A, 64}];\nQupA[A_, j_, x_] := N[zs[[j]], prec]^(-x/hh) {qDual1, qDual2, qDual3}[[j]][[A, 1]][x];\nQlowA[A_, i_, x_] := N[zs[[i]], prec]^(x/hh) {qDir, qDir2, qDir3}[[i]][[A, 1]][x];\nqDir3 = Table[solveMonic[baxDir[tauPoly[[A]], N[zs[[3]], prec]], 2 lam1 - muOf[[A, 3]]], {A, 64}];\ntau1At[x_] := Table[tauPoly[[A, 1]] /. u -> x, {A, 64}];\nbilinFit[x_, al_, be_] := Module[{M = Table[QlowA[A, a, x + al hh] QupA[A, a, x + be hh], {A, 64}, {a, 3}], rhs = tau1At[x], c},\n   c = LeastSquares[M, rhs]; {al, be, N[Max[Abs[M . c - rhs]]/Max[Abs[rhs]], 3], N[c, 10]}];\nxg = 37/100;\nbil = SortBy[Flatten[Table[bilinFit[xg, al, be], {al, -2, 2}, {be, -2, 2}], 1], #[[3]] &];\n{\"Baxter residuals (q^1, q_3)\" -> N[Max[Join[qDual1[[All, 2]], qDir3[[All, 2]]]], 3], \"best 3 (alpha, beta, residual, c)\" -> Take[bil, 3]}",
   "languageId": "wolfram",
   "outputs": [
    {
