       "data": "Out[122]= \\begin{aligned}\n  &\\left\\{0.04148 \\right. \\\\\n  &\\left. ,\\left\\{2, \\right. \\right. \\\\\n  &\\left. \\left. \\left\\{\\left(\\mathrm{uu}-\\mathrm{vv}\\right)\\,\\left(7\\,\\mathrm{vv}-2\\right)\\,\\left(11\\,\\mathrm{vv}+5\\right), \\right. \\right. \\right. \\\\\n  &\\left. \\left. \\left. \\left(\\mathrm{uu}-\\mathrm{vv}\\right)\\,\\left(77\\,\\mathrm{uu}+77\\,\\mathrm{vv}+13\\right)\\right\\}\\right\\}\\right\\}\n\\end{aligned}",
