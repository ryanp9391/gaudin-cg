      {
       "data": "Out[707]= \\begin{aligned}\n  &\\left\\{\\text{rank of <Omega|Op(k1,k2) (4 k-points), exact product} \\right. \\\\\n  &\\left. \\to \\left\\{\\begin{pmatrix}1 & 1\\\\1 & 1\\end{pmatrix},\\mathrm{True}\\right\\} \\right. \\\\\n  &\\left. ,\\text{f\\_n == e1.g0}\\to \\left\\{\\mathrm{True},\\mathrm{True}\\right\\}\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
