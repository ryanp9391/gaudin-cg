       "data": "Out[811]= \\begin{aligned}\n  &\\left\\{\\left\\{\\text{degree}\\to 10,\\text{degree}\\to 10,\\text{degree}\\to 10\\right\\} \\right. \\\\\n  &\\left. ,\\text{leading coeff}\\to \\left\\{-1.63145937\\times 10^{7} \\right. \\right. \\\\\n  &\\left. \\left. ,-9.17695895\\times 10^{6},2.54915526\\times 10^{7}\\right\\} \\right. \\\\\n  &\\left. ,\\text{roots (u-th\\_s)/h} \\right. \\\\\n  &\\left. \\to \\begin{pmatrix}-0.42923093 & -0.15075811 & 0.10017401 & 0.43454037 & 0.60231126 & 1 & 2 & 2 & 1.7915483 & 2 & 2.0700211 & 2.2985517 & 2.3209532 & 2.6553196 & 2.8230905 & 3.4 & 4 & 4 & 4 & 4.5193309\\\\-0.42923093 & -0.15075811 & 0.10017401 & 0.43454037 & 0.60231126 & 1 & 2 & 2 & 1.7915483 & 2 & 2.0700211 & 2.2985517 & 2.3209532 & 2.6553196 & 2.8230905 & 3.4 & 4 & 4 & 4 & 4.5193309\\\\-0.42923093 & -0.15075811 & 0.10017401 & 0.43454037 & 0.60231126 & 1 & 2 & 2 & 1.7915483 & 2 & 2.0700211 & 2.2985517 & 2.3209532 & 2.6553196 & 2.8230905 & 3.4 & 4 & 4 & 4 & 4.5193309\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\text{check at fresh x}\\to \\left\\{0.\\times 10^{-49},1.09\\times 10^{8}\\right\\}\\right\\}\n\\end{aligned}",
