      {
       "data": "Out[524]= \\begin{aligned}\n  &\\left\\{\\mathrm{True} \\right. \\\\\n  &\\left. ,\\langle\\! \\right. \\\\\n  &\\left. \\lvert \\text{P}\\to \\mathrm{True},\\text{P\\^{}-1}\\to \\mathrm{False} \\right. \\\\\n  &\\left. ,\\text{P\\^{}T}\\to \\mathrm{False},\\text{P\\^{}-T}\\to \\mathrm{False}\\rvert\\!\\rangle \\right\\}\n\\end{aligned}",
