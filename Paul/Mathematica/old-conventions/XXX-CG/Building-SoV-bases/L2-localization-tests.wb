  {
   "kind": 2,
   "value": "(* companion-frame Bethe states: Psi^c = Pi(P) Psi^d (same Q's) *)\nPP = N[KroneckerProduct[PiSite[1, Pv], PiSite[2, Pv]], prec];\npsiC = Table[PP . evecs[[A]], {A, 64}];\npsiCcheck = Max@Table[With[{v = N[tGp[Gc][1][1/5], prec] . psiC[[A]]}, Max[Abs[v - (v . Conjugate[psiC[[A]]]/(psiC[[A]] . Conjugate[psiC[[A]]])) psiC[[A]]]]/Max[Abs[v]]], {A, 64}];\n(* wavefunctions W_k(A) = <x_k|Psi_A>, relative to a reference label k0 *)\nWf = Table[N[xB[[k]], prec] . psiC[[A]], {k, 64}, {A, 64}];\nk0 = First@FirstPosition[Blabels, {{1, -1}, {1, 1}, {1, 1}, {2, -1}, {2, 1}, {2, 1}}];\nroots[k_] := Flatten[Table[th[s] + n hh, {s, 2}, {n, Cases[Blabels[[k]], {s, m_} :> m]}]];\nqFams = <|\"Q_1\" -> (QlowA[#1, 1, #2] &), \"Q_2\" -> (QlowA[#1, 2, #2] &), \"Q_3\" -> (QlowA[#1, 3, #2] &), \"Q^1\" -> (QupA[#1, 1, #2] &), \"Q^2\" -> (QupA[#1, 2, #2] &), \"Q^3\" -> (QupA[#1, 3, #2] &)|>;\n(* factorization test: W_k/W_k0 = C_k prod_{r in x_k} Q(r) / prod_{r in x_k0} Q(r); worst spread over k *)\nfactTest[f_] := Max@Table[With[{r = Table[(Wf[[k, A]]/Wf[[k0, A]])/((Times @@ (qFams[f][A, #] & /@ roots[k]))/(Times @@ (qFams[f][A, #] & /@ roots[k0]))), {A, 64}]}, spreadOf[r]], {k, 64}];\n{\"Psi^c eigenvector check\" -> N[psiCcheck, 3], \"worst spread per Q family\" -> Association@Table[f -> N[factTest[f], 3], {f, Keys[qFams]}]}",
   "languageId": "wolfram",
   "outputs": [
