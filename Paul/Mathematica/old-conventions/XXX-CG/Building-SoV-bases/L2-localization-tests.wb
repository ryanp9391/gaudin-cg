      {
       "data": "Out[784]= \\begin{array}{|c|c|c|c|}\\hline\\text{localized on site} & \\text{combination (labels)} & \\text{rank (1 = one-body)} & \\text{<Omega|O|singlet>}\\\\\\hline1 & \\text{\\{\\{100, 100\\}\\}} & 1 & 0\\\\\\hline1 & \\text{\\{\\{111, 100\\}\\}} & 1 & 0\\\\\\hline1 & \\text{\\{\\{200, 100\\}\\}} & 1 & 0\\\\\\hline1 & \\text{\\{\\{211, 100\\}\\}} & 1 & 0\\\\\\hline1 & \\text{\\{\\{100, 110\\}, \\{100, 200\\}, \\{110, 100\\}\\}} & 1 & 0\\\\\\hline1 & \\text{\\{\\{200, 110\\}, \\{200, 200\\}, \\{210, 100\\}\\}} & 1 & 0\\\\\\hline1 & \\text{\\{\\{211, 110\\}, \\{211, 200\\}, \\{221, 100\\}\\}} & 1 & -\\frac{11959056}{11201095}\\\\\\hline2 & \\text{\\{\\{100, 100\\}\\}} & 1 & 0\\\\\\hline2 & \\text{\\{\\{100, 111\\}\\}} & 1 & 0\\\\\\hline2 & \\text{\\{\\{100, 200\\}\\}} & 1 & 0\\\\\\hline2 & \\text{\\{\\{100, 211\\}\\}} & 1 & 0\\\\\\hline2 & \\text{\\{\\{100, 110\\}, \\{110, 100\\}, \\{200, 100\\}\\}} & 1 & 0\\\\\\hline2 & \\text{\\{\\{100, 210\\}, \\{110, 200\\}, \\{200, 200\\}\\}} & 1 & 0\\\\\\hline2 & \\text{\\{\\{100, 221\\}, \\{110, 211\\}, \\{200, 211\\}\\}} & 1 & -\\frac{7474410}{648367}\\\\\\hline\\end{array}",
