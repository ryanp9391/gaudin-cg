      {
       "data": "Out[933]= \\begin{aligned}\n  &\\left\\{\\text{eigenvalue degree}\\to \\left\\{6\\right\\} \\right. \\\\\n  &\\left. ,\\text{\\# distinct labels}\\to 64,\\text{sample labels} \\right. \\\\\n  &\\left. \\to \\begin{pmatrix}\\left\\{1,-1\\right\\} & \\left\\{1,2\\right\\} & \\left\\{1,2\\right\\} & \\left\\{2,-1\\right\\} & \\left\\{2,0\\right\\} & \\left\\{2,1\\right\\}\\\\\\left\\{1,-1\\right\\} & \\left\\{1,1\\right\\} & \\left\\{1,2\\right\\} & \\left\\{2,-1\\right\\} & \\left\\{2,0\\right\\} & \\left\\{2,1\\right\\}\\\\\\left\\{1,-1\\right\\} & \\left\\{1,2\\right\\} & \\left\\{1,2\\right\\} & \\left\\{2,-1\\right\\} & \\left\\{2,1\\right\\} & \\left\\{2,1\\right\\}\\\\\\left\\{1,-1\\right\\} & \\left\\{1,2\\right\\} & \\left\\{1,2\\right\\} & \\left\\{2,0\\right\\} & \\left\\{2,1\\right\\} & \\left\\{2,1\\right\\}\\end{pmatrix}\\right\\}\n\\end{aligned}",
