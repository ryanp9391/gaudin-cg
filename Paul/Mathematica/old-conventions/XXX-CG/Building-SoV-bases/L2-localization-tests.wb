       "data": "Out[531]= \\begin{array}{|c|c|c|}\\hline\\text{diagonal frame, vacuum <lw|Pi(P)} & \\text{\\# localized} & \\text{localized states}\\\\\\hline\\text{site 1, t at th1} & 4 & \\begin{pmatrix}\\text{1}\\\\\\text{R}\\\\\\text{t11}\\\\\\text{R.t11}\\end{pmatrix}\\\\\\hline\\text{site 2, tS at th2+2h} & 4 & \\begin{pmatrix}\\text{1}\\\\\\text{R}\\\\\\text{t11}\\\\\\text{R.t11}\\end{pmatrix}\\\\\\hline\\end{array}",
