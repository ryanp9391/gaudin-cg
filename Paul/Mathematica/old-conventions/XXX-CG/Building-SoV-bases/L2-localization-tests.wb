      {
       "data": "Out[831]= \\begin{array}{|c|c|c|c|}\\hline\\text{point (h, th1, th2)} & \\text{th12/h} & \\text{site 1: \\{tS10n, RSn, t10n\\}} & \\text{site 2: \\{t10n, Rn, tS10n\\}}\\\\\\hline\\left\\{\\frac{1}{3},\\frac{2}{7},-\\frac{5}{11}\\right\\} & \\frac{171}{77} & \\left\\{1,-\\frac{1}{2},-\\frac{94}{77}\\right\\} & \\left\\{1,-\\frac{1}{2},-\\frac{94}{77}\\right\\}\\\\\\hline\\left\\{\\frac{1}{2},\\frac{3}{13},-\\frac{4}{17}\\right\\} & \\frac{206}{221} & \\left\\{1,-\\frac{1}{2},\\frac{15}{221}\\right\\} & \\left\\{1,-\\frac{1}{2},\\frac{15}{221}\\right\\}\\\\\\hline\\end{array}",
