  {
   "kind": 2,
   "value": "(* rerun the scan at point 2 and express solutions via th1, th2, h *)\npbRescan[h_, th_] := (pbh = h; pbth = th; Clear[pbT, pbP, pbW, pbSols];\n   pbT[i_, j_][u_] := pbT[i, j][u] = Sum[KroneckerProduct[pbL[i, k][u - pbth[[1]]], pbL[k, j][u - pbth[[2]]]], {k, 3}];\n   pbP[a_, 0][u_] := pbP[a, 0][u] = Expand[pbt[a, {0, 0, 0}][u]];\n   pbP[a_, r_][u_] := pbP[a, r][u] = Expand[pbt[a, UnitVector[3, r]][u] - pbP[a, 0][u]];\n   pbW[a_, b_, r_, s_] := pbW[a, b, r, s] = ArrayReshape[Expand[(pbvac . pbP[a, r][uu]) . pbP[b, s][vv] - (pbvac . pbP[b, r][vv]) . pbP[a, s][uu]], {8, 8}];\n   pbSols[a_, b_, r_, s_] := pbSols[a, b, r, s] = Module[{off = pbOff[a, b, r, s], sols}, sols = If[off === {}, {{}}, Solve[Thread[off == 0], {uu, vv}]]; Select[sols, (pbKeep[a, b, r, s] /. #) =!= {} && Simplify[pbKeep[a, b, r, s] /. #] =!= ConstantArray[0, Length[pbKeep[a, b, r, s] /. #]] &]];\n   Flatten[Table[If[pbSols[a, b, r, s] === {}, Nothing, {{a, b, r, s}, pbSols[a, b, r, s] /. (x_ -> val_) :> (x -> Which[val == th[[1]], \"th1\", val == th[[1]] + 2 h, \"th1+2h\", val == th[[2]], \"th2\", True, val])}], {a, 2}, {b, 2}, {r, 0, 3}, {s, 0, 3}], 3]);\npbScan1 = pbRescan[1/3, {2/7, -5/11}]; pbScan2 = pbRescan[1/2, {3/13, -4/17}];\n{Length[pbScan2], pbScan1 === pbScan2}",
   "languageId": "wolfram",
