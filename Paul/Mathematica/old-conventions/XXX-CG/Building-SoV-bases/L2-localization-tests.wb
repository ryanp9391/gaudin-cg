      {
       "data": "Out[145]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{point} & \\text{localized state} & \\text{rank (companion)} & \\text{rank after Pi(P), g0\\^{}-1} & \\text{site 2 = e1?} & \\text{reached hw sectors \\{\\{2, 2, 2\\} -> 1, \\{3, 2, 1\\} -> 2, \\{3, 3, 0\\} -> 1, \\{4, 1, 1\\} -> 1, \\{4, 2, 0\\} -> 1\\}} & \\text{singlet overlap}\\\\\\hline1 & \\text{(1,2,0,1) v=th1} & 1 & 1 & \\mathrm{True} & \\left\\{0,1,0,1,1\\right\\} & 0\\\\\\hline1 & \\text{(2,2,0,2) u=th1} & 1 & 1 & \\mathrm{True} & \\left\\{0,1,0,1,1\\right\\} & 0\\\\\\hline1 & \\text{(2,2,1,2) u=th1+2h} & 1 & 1 & \\mathrm{True} & \\left\\{0,0,1,0,1\\right\\} & 0\\\\\\hline1 & \\text{(2,2,0,1) (th1+2h,th1)} & 1 & 1 & \\mathrm{True} & \\left\\{0,1,1,1,1\\right\\} & 0\\\\\\hline1 & \\text{reference: e1 (x) e8 (companion)} & 1 & 1 & \\mathrm{True} & \\left\\{1,1,1,1,1\\right\\} & 14400\\\\\\hline2 & \\text{(1,2,0,1) v=th1} & 1 & 1 & \\mathrm{True} & \\left\\{0,1,0,1,1\\right\\} & 0\\\\\\hline2 & \\text{(2,2,0,2) u=th1} & 1 & 1 & \\mathrm{True} & \\left\\{0,1,0,1,1\\right\\} & 0\\\\\\hline2 & \\text{(2,2,1,2) u=th1+2h} & 1 & 1 & \\mathrm{True} & \\left\\{0,0,1,0,1\\right\\} & 0\\\\\\hline2 & \\text{(2,2,0,1) (th1+2h,th1)} & 1 & 1 & \\mathrm{True} & \\left\\{0,1,1,1,1\\right\\} & 0\\\\\\hline2 & \\text{reference: e1 (x) e8 (companion)} & 1… [latex truncated: 1288 chars total]",
