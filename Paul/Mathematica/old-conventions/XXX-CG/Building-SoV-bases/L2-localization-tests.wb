\}\\}, \\{\\{1, 2, 1, 2\\}, \\{\\{\\{\\}, \\{8\\}\\}\\}\\}, \\{\\{1, 2, 2, 1\\}, \\{\\{\\{\\}, \\{8\\}\\}\\}\\}, \\{\\{2, 1, 0, 1\\}, \\{\\{\\{\\u\\ -&gt; 2/7\\}, \\{5\\}\\}\\}\\}, \\{\\{2, 1, 1, 0\\}, \\{\\{\\{\\u\\ -&gt; 2/7\\}, \\{5\\}\\}\\}\\}, \\{\\{2, 1, 1, 2\\}, \\{\\{\\{\\}, \\{8\\}\\}\\}\\}, \\{\\{2, 1, 2, 1\\}, \\{\\{\\{\\}, \\{8\\}\\}\\}\\}, \\{\\{2, 2, 0, 1\\}, \\{\\{\\{\\u\\ -&gt; 20/21, \\v\\ -&gt; 2/7\\}, \\{3\\}\\}, \\{\\{\\u\\ -&gt; 2/7, \\v\\ -&gt; 20/21\\}, \\{3\\}\\}\\}\\}, \\{\\{2, 2, 0, 2\\}, \\{\\{\\{\\u\\ -&gt; 2/7\\}, \\{5\\}\\}, \\{\\{\\v\\ -&gt; 2/7\\}, \\{5\\}\\}\\}\\}, \\{\\{2, 2, 1, 0\\}, \\{\\{\\{\\u\\ -&gt; 20/21, \\v\\ -&gt; 2/7\\}, \\{3\\}\\}, \\{\\{\\u\\ -&gt; 2/7, \\v\\ -&gt; 20/21\\}, \\{3\\}\\}\\}\\}, \\{\\{2, 2, 1, 2\\}, \\{\\{\\{\\u\\ -&gt; 20/21\\}, \\{7\\}\\}, \\{\\{\\v\\ -&gt; 20/21\\}, \\{7\\}\\}\\}\\}, \\{\\{2, 2, 2, 0\\}, \\{\\{\\{\\u\\ -&gt; 2/7\\}, \\{5\\}\\}, \\{\\{\\v\\ -&gt; 2/7\\}, \\{5\\}\\}\\}\\}, \\{\\{2, 2, 2, 1\\}, \\{\\{\\{\\u\\ -&gt; 20/21\\}, \\{7\\}\\}, \\{\\{\\v\\ -&gt; 20/21\\}, \\{7\\}\\}\\}\\}\\}\\}}</small></span></div></div></div>",
