  {
   "kind": 2,
   "value": "setPoint[pts4[[1]]];\n(* V_loc(O; w): v1 with every row of reshape((v1 (x) w) O) proportional to w  <=>  (v1 (x) w).O.(e_i (x) q) = 0 for q _|_ w *)\nvlocSite1[O_, w_] := Module[{qs = NullSpace[{w}], vs, eqs, c},\n   vs = Array[c, d1];\n   eqs = Flatten@Table[(kron[vs, w] . O) . kron[UnitVector[d1, i], q], {i, d1}, {q, qs}];\n   NullSpace[Table[Coefficient[e, c[k]], {e, eqs}, {k, d1}]]];\nvlocSite2[O_, w_] := Module[{qs = NullSpace[{w}], vs, eqs, c},\n   vs = Array[c, d2];\n   eqs = Flatten@Table[(kron[w, vs] . O) . kron[q, UnitVector[d2, i]], {i, d2}, {q, qs}];\n   NullSpace[Table[Coefficient[e, c[k]], {e, eqs}, {k, d2}]]];\n(* invariance: is V_loc mapped into itself (site-1 factor) *)\ninvQ1[O_, w_, B_] := If[B === {}, \"-\", MatrixRank[Join[B, Table[fact[1, kron[b, w] . O], {b, B}]]] == Length[B]];\ninvQ2[O_, w_, B_] := If[B === {}, \"-\", MatrixRank[Join[B, Table[fact[2, kron[w, b] . O], {b, B}]]] == Length[B]];\n(* probe covectors w *)\ngRand[s_] := Module[{L = {{1, 0, 0}, {s, 1, 0}, {2 s, -s/3, 1}}, U = {{1, 3/s, -1/2}, {0, 1, s/5}, {0, 0, 1}}, D = DiagonalMatrix[{2, -1/3, 3/2}]}, L . D . U];\nprobeW = Join[\n   Table[\"e\" <> ToString[k] <> \" \" <> ToString[wtsV[[k]]] -> UnitVector[8, k], {k, 8}],\n   {\"rotparams vacuum\" -> f2, \"e1.g (random Borel hw)\" -> ext[2, True] . PiSite[2, gRand[2]], \"e8.g (random Borel lw)\" -> ext[2, False] . PiSite[2, gRand[2]],\n    \"e4.g (weight (1,1,1) rotated)\" -> UnitVector[8, 4] . PiSite[2, gRand[2]], \"random\" -> {3, -1, 2, 5, -4, 1, 7, -2}/3}];\nsite1Ops = With[{o = towers[Gd, \"t\", th[1]]}, <|\"t10\" -> o[\"t10\"], \"t11\" -> o[\"t11\"], \"R\" -> o[\"t20\"] . Inverse[o[\"t10\"]], \"R.t11\" -> o[\"t20\"] . Inverse[o[\"t10\"]] . o[\"t11\"], \"t20\" -> o[\"t20\"], \"t21\" -> o[\"t21\"]|>];\nclass1 = Table[{w[[1]], Sequence @@ Table[With[{B = vlocSite1[site1Ops[k], w[[2]]]}, {Length[B], invQ1[site1Ops[k], w[[2]], B]}], {k, Keys[site1Ops]}]}, {w, probeW}];\nGrid[Prepend[class1, Prepend[Keys[site1Ops], \"site-2 w \\\\ site-1 op: {dim V_loc, invariant}\"]], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
