       "data": "Out[997]= \\begin{aligned}\n  &\\left\\{\\text{rank distribution} \\right. \\\\\n  &\\left. \\to \\begin{pmatrix}2 & 24\\\\5 & 4\\\\4 & 9\\\\3 & 9\\\\1 & 11\\\\6 & 5\\\\8 & 2\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\text{site-2 labels: \\# product states, common site-2 factor} \\right. \\\\\n  &\\left. \\to \\begin{pmatrix}\\left\\{-1,0,1\\right\\} & 4 & \\mathrm{True}\\\\\\left\\{-1,0,2\\right\\} & 3 & \\mathrm{True}\\\\\\left\\{-1,1,1\\right\\} & 0 & \\text{-}\\\\\\left\\{-1,1,2\\right\\} & 0 & \\text{-}\\\\\\left\\{-1,2,2\\right\\} & 0 & \\text{-}\\\\\\left\\{0,1,1\\right\\} & 1 & \\text{-}\\\\\\left\\{0,1,2\\right\\} & 2 & \\mathrm{True}\\\\\\left\\{0,2,2\\right\\} & 1 & \\text{-}\\end{pmatrix}\\right\\}\n\\end{aligned}",
