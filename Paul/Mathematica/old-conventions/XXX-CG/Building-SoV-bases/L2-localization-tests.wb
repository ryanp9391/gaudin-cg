  {
   "kind": 2,
   "value": "(* map a site label {r1, r2, r3} (sorted roots in units of h) to {x11, x21, x22} *)\nxVars[lab_] := Module[{x22 = lab[[1]], rest = Rest[lab]}, With[{x21 = Max[rest]}, {First@DeleteCases[rest, x21, 1, 1], x21, x22}]];\nrvF[a_, b_][s_, lab_][A_] := With[{x = th[s] + hh xVars[lab]},\n   QlowA[A, a, x[[1]]] (QlowA[A, a, x[[2]]] QlowA[A, b, x[[3]]] - QlowA[A, b, x[[2]]] QlowA[A, a, x[[3]]])];\nrvTest[a_, b_] := Max@Join[\n   Table[spreadOf[Table[F1[l][[A]]/(rvF[a, b][1, l][A]/rvF[a, b][1, ref1][A]), {A, 64}]], {l, l1s}],\n   Table[spreadOf[Table[F2[l][[A]]/(rvF[a, b][2, l][A]/rvF[a, b][2, ref2][A]), {A, 64}]], {l, l2s}]];\nrvRes = Table[{a, b, N[rvTest[a, b], 3]}, {a, 3}, {b, 3}] // Flatten[#, 1] & // Select[#, #[[1]] != #[[2]] &] &;\nGrid[Prepend[rvRes, {\"a = sigma(1)\", \"b = sigma(2)\", \"worst spread over all 16 site labels\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
