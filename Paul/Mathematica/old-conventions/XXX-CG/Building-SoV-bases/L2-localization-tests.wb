  {
   "kind": 2,
   "value": "(* single-site towers for site alpha: monodromy L_alpha(u - th_alpha) G only *)\nTGsite[\\[Alpha]_][{i_, j_}][x_] := Sum[\\[ScriptCapitalL][\\[Alpha]][i, k][x - th[\\[Alpha]]] Gd[[k, j]], {k, 3}];\nqmSite[\\[Alpha]_][II_][x_] := Sum[Signature[Permutations[II][[\\[Sigma]]]] (Dot @@ Table[TGsite[\\[Alpha]][{Permutations[II][[\\[Sigma]]][[m]], II[[m]]}][x - (m - 1) hh], {m, Length[II]}]), {\\[Sigma], Length[Permutations[II]]}];\ntGsite[\\[Alpha]_][a_][x_] := Sum[qmSite[\\[Alpha]][II][x], {II, Subsets[Range[3], {a}]}];\ntowersSite[\\[Alpha]_, \"t\", u_] := <|\"t10\" -> tGsite[\\[Alpha]][1][u], \"t11\" -> tGsite[\\[Alpha]][2][u], \"t20\" -> tGsite[\\[Alpha]][1][u] . tGsite[\\[Alpha]][1][u + hh] - tGsite[\\[Alpha]][2][u + hh], \"t21\" -> tGsite[\\[Alpha]][2][u] . tGsite[\\[Alpha]][1][u + hh] - tGsite[\\[Alpha]][3][u + hh]|>;\ntowersSite[\\[Alpha]_, \"tS\", u_] := <|\"t10\" -> tGsite[\\[Alpha]][1][u], \"t11\" -> tGsite[\\[Alpha]][2][u + hh], \"t20\" -> tGsite[\\[Alpha]][1][u - hh] . tGsite[\\[Alpha]][1][u] - tGsite[\\[Alpha]][2][u], \"t21\" -> tGsite[\\[Alpha]][2][u + hh] . tGsite[\\[Alpha]][1][u - hh] - tGsite[\\[Alpha]][3][u + hh]|>;\nOgSite[\\[Alpha]_, tw_, u_] := Module[{o = towersSite[\\[Alpha], tw, u], R, Id = IdentityMatrix[dim[\\[CapitalLambda][\\[Alpha]]]]}, R = o[\"t20\"] . Inverse[o[\"t10\"]];\n   <|\"100\" -> Id, \"110\" -> o[\"t10\"], \"111\" -> o[\"t11\"], \"200\" -> R, \"210\" -> o[\"t20\"], \"211\" -> R . o[\"t11\"], \"220\" -> R . o[\"t20\"], \"221\" -> R . o[\"t21\"]|>];\n(* single-site L=1 SoV states on each site *)\nsingle1 = Map[f1 . # &, OgSite[1, \"t\", th[1]]];\nsingle2 = Map[f2 . # &, OgSite[2, \"tS\", th[2] + 2 hh]];\n(* which single-site state is each localized factor proportional to? *)\nmatchSingle[v_, singles_] := Select[Keys[singles], MatrixRank[{v, singles[#]}] == 1 &];\nlocFactors = Join[\n   Table[{1, c[[1]], matchSingle[fact[1, kron[f1, f2] . comboOp[c]], single1]}, {c, minB1}],\n   Table[{2, c[[1]], matchSingle[fact[2, kron[f1, f2] . comboOp[c]], single2]}, {c, minB2}]];\nGrid[Prepend[locFactors, {\"site\", \"localized combination\", \"proportional to single-site state\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
