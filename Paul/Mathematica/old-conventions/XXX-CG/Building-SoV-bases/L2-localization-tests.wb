      {
       "data": "Out[612]= \\begin{aligned}\n  &\\left\\{\\text{rank of <Omega| tS11}\\to 1 \\right. \\\\\n  &\\left. ,\\text{site-2 factor \\textasciitilde{} <Omega2| t2\\^{}(2)(th2+3h)}\\to 1 \\right. \\\\\n  &\\left. ,\\text{ratio}\\to \\left\\{-\\frac{1880}{17787}\\right\\}\\right\\}\n\\end{aligned}",
