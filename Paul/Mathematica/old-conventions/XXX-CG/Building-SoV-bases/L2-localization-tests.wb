      {
       "data": "Out[903]= \\begin{aligned}\n  &\\left\\{\\text{singles: R, t11, R t11}\\to \\langle\\! \\right. \\\\\n  &\\left. \\lvert \\text{single 200 (R)}\\to \\left\\{\\text{Q\\_1},2,1\\right\\},\\text{single 111 (t11)}\\to \\left\\{\\text{Q\\^{}1},1,0\\right\\},\\text{single 211 (R t11)}\\to \\left\\{\\text{Q\\_1},2,1\\right\\}\\rvert\\!\\rangle \\right. \\\\\n  &\\left. ,\\text{bilinear fits (alpha, beta, residual)}\\to \\langle\\! \\right. \\\\\n  &\\left. \\lvert \\text{clean 110 (th1)}\\to \\begin{pmatrix}0 & -2 & 0.881\\\\1 & 3 & 0.906\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\text{X1 (th1)}\\to \\begin{pmatrix}0 & -2 & 0.823\\\\2 & 2 & 0.881\\end{pmatrix}\\rvert\\!\\rangle \\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
