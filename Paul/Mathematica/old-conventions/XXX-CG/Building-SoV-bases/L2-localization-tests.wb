      {
       "data": "Out[837]= \\begin{array}{|c|c|}\\hline\\text{th12/h} & \\text{coefficients of \\{R t11 tS10, R t11 RS, R t21\\}}\\\\\\hline\\frac{171}{77} & \\left\\{1,-\\frac{4418}{2907},-\\frac{8037}{1309}\\right\\}\\\\\\hline\\frac{206}{221} & \\left\\{1,\\frac{225}{97232},-\\frac{1545}{52156}\\right\\}\\\\\\hline\\end{array}",
