       "data": "Out[1028]= \\begin{array}{|c|c|}\\hline\\text{rank of 8x8 reshaping} & 1\\\\\\hline\\text{site-2 factor proportional to e8} & \\mathrm{True}\\\\\\hline\\text{singlet overlap} & -0.000393070\\\\\\hline\\text{same without the site-2 term (t21 alone): rank} & 2\\\\\\hline\\end{array}",
