       "data": "Out[472]= \\begin{array}{|c|c|c|}\\hline & \\text{rank of 8 recipe states} & \\text{\\# localized combinations}\\\\\\hline\\text{site 1 (t at th1)} & 8 & 3\\\\\\hline\\text{site 2 (tS at th2+2h)} & 8 & 3\\\\\\hline\\end{array}",
