  {
   "kind": 2,
   "value": "(* all solution components of the off-column conditions; keep those where <0|X is not identically zero there *)\npbSols[a_, b_, r_, s_] := pbSols[a, b, r, s] = Module[{off = pbOff[a, b, r, s], sols},\n   sols = If[off === {}, {{}}, Solve[Thread[off == 0], {uu, vv}]];\n   Select[sols, Simplify[pbKeep[a, b, r, s] /. #] =!= ConstantArray[0, Length[pbKeep[a, b, r, s] /. #]] && (pbKeep[a, b, r, s] /. #) =!= {} &]];\npbScan = Flatten[Table[If[pbSols[a, b, r, s] === {}, Nothing, {{a, b, r, s}, pbSols[a, b, r, s]}], {a, 2}, {b, 2}, {r, 0, 3}, {s, 0, 3}], 3];\nLength[pbScan]",
