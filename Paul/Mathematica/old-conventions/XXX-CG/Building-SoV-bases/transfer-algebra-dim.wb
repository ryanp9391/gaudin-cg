      {
       "data": "Out[72]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{t11 at r} & \\left\\{4,2,0\\right\\} & \\left\\{3,3,0\\right\\} & \\left\\{4,1,1\\right\\} & \\left\\{3,2,1\\right\\} & \\left\\{2,2,2\\right\\}\\\\\\hline0 & \\left\\{-\\frac{1880}{53361}\\right\\} & \\left\\{-\\frac{1880}{53361}\\right\\} & \\left\\{-\\frac{4960}{53361}\\right\\} & \\left\\{\\frac{7123-77\\,\\sqrt{169921}}{320166},\\frac{7123+77\\,\\sqrt{169921}}{320166}\\right\\} & \\left\\{\\frac{23312}{160083}\\right\\}\\\\\\hline1 & \\left\\{-\\frac{31744}{480249}\\right\\} & \\left\\{-\\frac{23312}{160083}\\right\\} & \\left\\{-\\frac{8836}{160083}\\right\\} & \\left\\{\\frac{-7123-77\\,\\sqrt{169921}}{320166},\\frac{77\\,\\sqrt{169921}-7123}{320166}\\right\\} & \\left\\{\\frac{4960}{53361}\\right\\}\\\\\\hline3 & \\left\\{\\frac{33232}{53361}\\right\\} & \\left\\{\\frac{12596}{53361}\\right\\} & \\left\\{\\frac{33232}{53361}\\right\\} & \\left\\{\\frac{86125-77\\,\\sqrt{169921}}{320166},\\frac{86125+77\\,\\sqrt{169921}}{320166}\\right\\} & \\left\\{\\frac{23312}{160083}\\right\\}\\\\\\hline\\end{array}",
