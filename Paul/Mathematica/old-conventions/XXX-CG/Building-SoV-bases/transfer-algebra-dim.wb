       "data": "Out[202]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{g1|g2} & \\text{roots 1} & \\text{roots 2} & \\text{(T+k)\\^{}e} & \\text{leftover}\\\\\\hline\\text{211|221} & \\left\\{0,1,2\\right\\} & \\left\\{0,2,2\\right\\} & \\left\\{-2\\to -1,-1\\to -1,1\\to -2,2\\to -1,3\\to -1\\right\\} & \\frac{804257527126440729573}{13054190153348484640}\\\\\\hline\\text{220|221} & \\left\\{-1,2,2\\right\\} & \\left\\{0,2,2\\right\\} & \\left\\{-2\\to -2,-1\\to -2,1\\to -2,2\\to -1,3\\to -1\\right\\} & \\frac{8489936679072570243}{511286030347218140}\\\\\\hline\\text{221|211} & \\left\\{0,2,2\\right\\} & \\left\\{0,1,2\\right\\} & \\left\\{-2\\to -1,-1\\to -2,1\\to -1,2\\to -2,3\\to -1\\right\\} & \\frac{16351173747098017245}{165895622006823616}\\\\\\hline\\text{221|220} & \\left\\{0,2,2\\right\\} & \\left\\{-1,2,2\\right\\} & \\left\\{-1\\to -2,1\\to -2,2\\to -1\\right\\} & \\frac{1249715369172464410293}{19152360462394436960}\\\\\\hline\\text{221|221} & \\left\\{0,2,2\\right\\} & \\left\\{0,2,2\\right\\} & \\left\\{-2\\to -1,-1\\to -2,1\\to -2,2\\to -1,3\\to -1\\right\\} & \\frac{248591525949487144809}{3305247551136719464}\\\\\\hline\\end{array}",
