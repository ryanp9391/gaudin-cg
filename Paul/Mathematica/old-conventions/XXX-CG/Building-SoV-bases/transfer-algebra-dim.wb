      {
       "data": "Out[365]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{rep} & \\text{vacuum} & \\text{operator} & \\text{one-body} & \\text{irreps reached (hw weights)}\\\\\\hline\\text{[2,1,0]} & \\text{generic r} & \\text{t11} & \\mathrm{True} & \\begin{pmatrix}3 & 2 & 1\\\\4 & 1 & 1\\\\4 & 2 & 0\\end{pmatrix}\\\\\\hline\\text{[2,1,0]} & \\text{generic r} & \\text{t21} & \\mathrm{True} & \\begin{pmatrix}2 & 2 & 2\\\\3 & 2 & 1\\\\3 & 3 & 0\\\\4 & 1 & 1\\\\4 & 2 & 0\\end{pmatrix}\\\\\\hline\\text{[2,1,0]} & \\text{generic r} & \\text{R t11} & \\mathrm{True} & \\begin{pmatrix}2 & 2 & 2\\\\3 & 2 & 1\\\\3 & 3 & 0\\\\4 & 1 & 1\\\\4 & 2 & 0\\end{pmatrix}\\\\\\hline\\text{[2,1,0]} & \\text{r = 0} & \\text{t11} & \\mathrm{True} & \\begin{pmatrix}3 & 2 & 1\\\\4 & 1 & 1\\\\4 & 2 & 0\\end{pmatrix}\\\\\\hline\\text{[2,1,0]} & \\text{r = 0} & \\text{t21} & \\mathrm{True} & \\begin{pmatrix}3 & 2 & 1\\\\3 & 3 & 0\\\\4 & 1 & 1\\\\4 & 2 & 0\\end{pmatrix}\\\\\\hline\\text{[2,1,0]} & \\text{r = 0} & \\text{R} & \\mathrm{True} & \\begin{pmatrix}3 & 3 & 0\\\\4 & 2 & 0\\end{pmatrix}\\\\\\hline\\text{[2,1,0]} & \\text{r = 0} & \\text{R t11} & \\mathrm{True} & \\begin{pmatrix}3 & 2 & 1\\\\3 & 3 & 0\\\\4 & 1 & 1\\\\4 & 2 & 0\\end{pmatrix}\\\\\\hline\\text{[3,1,0]} & \\text{generic r} & \\text{t11} & \\mathrm{True} & \\begin{pmatrix}5 & 2 & 1\\\\6 & 1… [latex truncated: 2384 chars total]",
