  {
   "kind": 2,
   "value": "(* r such that g Gc(w) g^-1 is upper triangular (lower-left entries vanish) *)\nconjW = gS . Gw . Inverse[gS];\nsolsW = Solve[Thread[Extract[conjW, {{2, 1}, {3, 1}, {3, 2}}] == 0], {r1, r2, r3}];\neigTest2[sol_] := Module[{v = vg /. sol, a, b, j},\n   a = v . M10; b = v . M11; j = First@FirstPosition[v, x_ /; x != 0];\n   {{r1, r2, r3} /. sol, Diagonal[conjW /. sol], MatrixRank[{v, a}] == 1 && MatrixRank[{v, b}] == 1, a[[j]]/v[[j]],\n    Factor[(P1s P2s /. {c1 -> 4, c2 -> 11, c3 -> -30}) /. sol]}];\neigRows2 = eigTest2 /@ solsW;\nGrid[Prepend[eigRows2, {\"{r1, r2, r3}\", \"diag of g Gc(w) g^-1\", \"<v_g| left eigenvector of t10, t11 (twist w)\", \"t10 eigenvalue at u\", \"P1 P2 (chain twist z)\"}], Frame -> All]",
   "languageId": "wolfram",
