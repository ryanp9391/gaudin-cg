  {
   "kind": 2,
   "value": "(* wider search: M = A . G . B with A, B in {1, g, g^-1, g^T, g^-T}, G in {Gc, Gc^T}, r -> +-r; entries and 2x2 minors, up to a constant *)\ngOpts = <|\"1\" -> IdentityMatrix[3], \"g\" -> g3, \"gi\" -> Inverse[g3], \"gT\" -> Transpose[g3], \"giT\" -> Inverse[Transpose[g3]]|>;\nGOpts = <|\"Gc\" -> Gcs, \"GcT\" -> Transpose[Gcs]|>;\nsearchHits[P_, sgn_] := Module[{out = {}, M, Pn = P /. {r1 -> sgn r1, r2 -> sgn r2, r3 -> sgn r3}},\n   Do[M = Expand[gOpts[a] . GOpts[G] . gOpts[b]];\n    Do[With[{q = Together[M[[i, j]]/Pn]}, If[FreeQ[q, r1 | r2 | r3] && q =!= 0, AppendTo[out, {a, G, b, \"entry\", {i, j}, q}]]], {i, 3}, {j, 3}];\n    Do[With[{q = Together[Det[M[[rs, cs]]]/Pn]}, If[FreeQ[q, r1 | r2 | r3] && q =!= 0, AppendTo[out, {a, G, b, \"minor\", {rs, cs}, q}]]], {rs, Subsets[Range[3], {2}]}, {cs, Subsets[Range[3], {2}]}],\n    {a, Keys[gOpts]}, {G, Keys[GOpts]}, {b, Keys[gOpts]}];\n   out];\nwide = <|\"P1 (+r)\" -> searchHits[P1s, 1], \"P1 (-r)\" -> searchHits[P1s, -1], \"P2 (+r)\" -> searchHits[P2s, 1], \"P2 (-r)\" -> searchHits[P2s, -1]|>;\nLength /@ wide",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"790499\" data-output-id=\"43\" data-out-n=\"266\" data-sub-idx=\"5\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"53\" data-sub-start=\"10\" data-sub-end=\"10\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[266]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"33\" data-latex-b64=\"XGxhbmdsZVwhXGx2ZXJ0IFx0ZXh0e1AxICgrcil9XHRvIDAsXHRleHR7UDEgKC1yKX1cdG8gMCxcdGV4dHtQMiAoK3IpfVx0byAwLFx0ZXh0e1AyICgtcil9XHRvIDBccnZlcnRcIVxyYW5nbGU=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">⟨</span><span class=\"mspace\" style=\"margin-right:-0.1667em;\"></span><span class=\"mopen\">∣</span><span class=\"mord text\"><span class=\"mord\">P1 (+r)</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord\">P1 (-r)</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord\">P2 (+r)</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord\">P2 (-r)</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">0</span><span class=\"mclose\">∣</span><span class=\"mspace\" style=\"margin-right:-0.1667em;\"></span><span class=\"mclose\">⟩</span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
