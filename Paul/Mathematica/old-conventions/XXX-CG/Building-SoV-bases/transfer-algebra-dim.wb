     ],
     "id": "807282f0-ea53-48e9-983c-33d0d76755e7"
    }
   ],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* summary: one-body operators and the irreps each reaches (hw weight: rank reached / multiplicity) *)\nsumRow[key_] := Module[{R = runs[key], mult},\n   mult = R[\"irreps (hw weight -> multiplicity)\"];\n   Table[{key[[1]], key[[2]], op, R[\"ops\"][op][[1]], Select[Keys[mult], R[\"ops\"][op][[2]][#] > 0 &]}, {op, Keys[R[\"ops\"]]}]];\nsummary = Flatten[sumRow /@ Keys[runs], 1];\nGrid[Prepend[Select[summary, #[[4]] &], {\"rep\", \"vacuum\", \"operator\", \"one-body\", \"irreps reached (hw weights)\"}], Frame -> All, Alignment -> Left]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
