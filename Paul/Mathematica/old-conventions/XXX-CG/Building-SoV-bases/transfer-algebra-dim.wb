      {
       "data": "Out[219]= \\begin{array}{|c|c|c|}\\hline\\text{g1|g2} & \\text{actual/guess, point 1 (h=1/3)} & \\text{actual/guess, point 2 (h=1/2)}\\\\\\hline\\text{100|100} & 1 & 1\\\\\\hline\\text{100|200} & 1 & 1\\\\\\hline\\text{110|100} & 1 & 1\\\\\\hline\\text{111|100} & 1 & 1\\\\\\hline\\text{200|100} & 1 & 1\\\\\\hline\\text{200|200} & 1 & 1\\\\\\hline\\text{210|100} & 1 & 1\\\\\\hline\\text{210|200} & 1 & 1\\\\\\hline\\text{211|100} & \\frac{30\\,r1\\,r2-17\\,r1\\,r3^2+17\\,r2\\,r3}{60\\,r1\\,r2-17\\,r1\\,r3^2+17\\,r2\\,r3} & \\frac{457\\,r1\\,r2+472\\,r1\\,r3^2-472\\,r2\\,r3}{2\\,\\left(457\\,r1\\,r2+236\\,r1\\,r3^2-236\\,r2\\,r3\\right)}\\\\\\hline\\text{211|200} & 1 & 1\\\\\\hline\\text{220|100} & 1 & 1\\\\\\hline\\text{221|100} & 1 & 1\\\\\\hline\\end{array}",
