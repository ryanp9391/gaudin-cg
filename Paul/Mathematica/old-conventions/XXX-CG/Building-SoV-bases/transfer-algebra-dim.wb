  {
   "kind": 2,
   "value": "(* standard matrix units for the 3x3 twist index *)\nunit[i_, j_] := ReplacePart[ConstantArray[0, {3, 3}], {i, j} -> 1];\ngS = MatrixExp[r1 unit[2, 1]] . MatrixExp[r2 unit[3, 1]] . MatrixExp[r3 unit[3, 2]];\ngSN = gS /. rN;\nGcands2 = <|\"g G g^-1\" -> gSN . Gtest . Inverse[gSN], \"g^-1 G g\" -> Inverse[gSN] . Gtest . gSN, \"g^T G g^-T\" -> Transpose[gSN] . Gtest . Inverse[Transpose[gSN]], \"g^-T G g^T\" -> Inverse[Transpose[gSN]] . Gtest . Transpose[gSN]|>;\nintertw2 = Map[tw10[#][uT] == lhs10 &, Gcands2];\n(* also the other direction Pi(g)^-1 t Pi(g) *)\nlhs10b = Inverse[Pig] . tw10[Gtest][uT] . Pig;\nintertw2b = Map[tw10[#][uT] == lhs10b &, Gcands2];\n{\"Pi t Pi^-1\", intertw2, \"Pi^-1 t Pi\", intertw2b}",
   "languageId": "wolfram",
   "outputs": [
