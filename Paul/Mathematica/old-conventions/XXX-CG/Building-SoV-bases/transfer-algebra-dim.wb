      {
       "data": "Out[161]= \\begin{aligned}\n  &\\left\\{\\text{\\# terms},2,\\text{labels},\\begin{pmatrix}\\text{211} & \\text{200}\\\\\\text{221} & \\text{100}\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\text{ratios to first},\\left\\{1,-\\frac{248}{77}\\right\\} \\right. \\\\\n  &\\left. ,\\text{compare -1/(T+1)},-\\frac{77}{248}\\right\\}\n\\end{aligned}",
