  {
   "kind": 2,
   "value": "bSets = {{0}, {1}, {2}, {3}, {-1}, {-2}, {-3}, {0, 1}, {0, 1, 2}, {-1, 0, 1}, {-3, -2, -1, 0, 1, 2, 3}};\nbTab = Table[{S, closureDim[keysOf[{\"t10\"}, S], First@aPrimes], closureDim[keysOf[{\"t11\"}, S], First@aPrimes], closureDim[keysOf[{\"t10\", \"t11\"}, S], First@aPrimes]}, {S, bSets}];\nGrid[Prepend[bTab, {\"r set S\", \"t10 only\", \"t11 only\", \"both\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
