.3,\n63,95c96.7,156.7,172.8,332.5,228.5,527.5c55.7,195,92.8,416.5,111.5,664.5\nc11.3,139.3,17,290.7,17,454c0,28,1.7,43,3.3,45l0,6009\nc-3,4,-3.3,16.7,-3.3,38c0,162,-5.7,313.7,-17,455c-18.7,248,-55.8,469.3,-111.5,664\nc-55.7,194.7,-131.8,370.3,-228.5,527c-20.7,34.7,-41.7,66.3,-63,95c-2,3.3,-4,7,-6,11\nc0,7.3,5.7,11,17,11c0,0,11,0,11,0c9.3,0,14.3,-0.3,15,-1c5.3,-5.3,10.3,-11,15,-17\nc242.7,-294.7,395.3,-681.7,458,-1161c21.3,-164.7,33.3,-350.7,36,-558\nl0,-6144c-2,-159.3,-10,-310.7,-24,-454c-53.3,-528,-210,-949.7,\n-470,-1265c-4.7,-6,-9.7,-11.7,-15,-17c-0.7,-0.7,-6.7,-1,-18,-1z\"/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.5501em;\"><span></span></span></span></span></span></span></span><span class=\"mclose\"><span class=\"delimsizing mult\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:5.05em;\"><span style=\"top:-1.366em;\"><span class=\"pstrut\" style=\"height:5.016em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎭</span></span></span><span style=\"top:-1.358em;\"><span class=\"pstrut\" style=\"height:5.016em;\"></span><span style=\"height:3.016em;width:0.8889em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.8889em\" height=\"3.016em\" style=\"width:0.8889em\" viewBox=\"0 0 888.89 3016\" preserveAspectRatio=\"xMinYMin\"><path d=\"M384 0 H504 V3016 H384z M384 0 H504 V3016 H384z\"/></svg></span></span><span style=\"top:-5.016em;\"><span class=\"pstrut\" style=\"height:5.016em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎬</span></span></span><span style=\"top:-6.158em;\"><span class=\"pstrut\" style=\"height:5.016em;\"></span><span style=\"height:3.016em;width:0.8889em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.8889em\" height=\"3.016em\" style=\"width:0.8889em\" viewBox=\"0 0 888.89 3016\" preserveAspectRatio=\"xMinYMin\"><path d=\"M384 0 H504 V3016 H384z M384 0 H504 V3016 H384z\"/></svg></span></span><span style=\"top:-9.166em;\"><span class=\"pstrut\" style=\"height:5.016em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎫</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:4.55em;\"><span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:13.1001em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[251]= \\begin{aligned}\n  &\\left\\{\\text{point 1: localize at r=0},\\mathrm{True},\\text{one-body (symbolic r)} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}\\text{1} & \\mathrm{True}\\\\\\text{t11} & \\mathrm{True}\\\\\\text{R t11} & \\mathrm{True}\\end{pmatrix},\\text{ranks} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}\\text{1} & 1\\\\\\text{t11} & 1\\\\\\text{R} & 7\\\\\\text{R t11} & 1\\\\\\text{t10 - R2/T} & 8\\\\\\text{t20 - 2/(T+1) R R2} & 8\\\\\\text{R t20 - c t20 R2} & 8\\\\\\text{R [t21 - t11 R2/(T+1)]} & 8\\end{pmatrix} \\right. \\\\\n  &\\left. ,\\text{singlet nonzero} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}\\text{1} & \\mathrm{False}\\\\\\text{t11} & \\mathrm{False}\\\\\\text{R} & \\mathrm{True}\\\\\\text{R t11} & \\mathrm{True}\\\\\\text{t10 - R2/T} & \\mathrm{True}\\\\\\text{t20 - 2/(T+1) R R2} & \\mathrm{True}\\\\\\text{R t20 - c t20 R2} & \\mathrm{True}\\\\\\text{R [t21 - t11 R2/(T+1)]} & \\mathrm{True}\\end{pmatrix}\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
     ],
     "id": "2105f2e9-efd3-4bc2-b814-14b1100e0c81"
    }
