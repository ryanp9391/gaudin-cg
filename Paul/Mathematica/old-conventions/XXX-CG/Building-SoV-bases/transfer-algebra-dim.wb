  {
   "kind": 2,
   "value": "(* point-2 rerun of the expansion with a self-contained companion-frame build (non-memoized) *)\nsovExpansion[h_, th_, zz_] := Module[{chi, Gm, L, TT2, QMg, t, t20, t21, R, ops, states, co, nz},\n   chi = {Total[zz], -(zz[[1]] zz[[2]] + zz[[1]] zz[[3]] + zz[[2]] zz[[3]]), Times @@ zz};\n   Gm = {chi, {1, 0, 0}, {0, 1, 0}};\n   L[i_, j_][u_] := u IdentityMatrix[aD] KroneckerDelta[i, j] - h aE[j, i];\n   TT2[{i_, j_}][u_] := TT2[{i, j}][u] = Sum[KroneckerProduct[L[i, k][u - th[[1]]], L[k, l][u - th[[2]]]] Gm[[l, j]], {k, 3}, {l, 3}];\n   (* quantum minor, same convention as cQM: k-th factor at u + h - k h *)\n   QMg[Ii_][u_] := Sum[Signature[p] (Dot @@ Table[TT2[{p[[k]], Ii[[k]]}][u + h - k h], {k, Length[Ii]}]), {p, Permutations[Ii]}];\n   t[a_][u_] := t[a][u] = Sum[QMg[Ii][u], {Ii, Subsets[Range[3], {a}]}];\n   t20[u_] := t[1][u] . t[1][u + h] - t[2][u + h];\n   t21[u_] := t[2][u] . t[1][u + h] - t[3][u + h];\n   R[u_] := R[u] = t20[u] . Inverse[t[1][u]];\n   ops[u_] := AssociationThread[sovLabels -> {IdentityMatrix[64], t[1][u], t[2][u], R[u], t20[u], R[u] . t[2][u], R[u] . t20[u], R[u] . t21[u]}];\n   states = With[{o1 = ops[th[[1]]], o2 = ops[th[[2]]]}, Association@Flatten@Table[{g1, g2} -> vac0 . o1[g1] . o2[g2], {g1, sovLabels}, {g2, sovLabels}]];\n   co = AssociationThread[Keys[states] -> LinearSolve[Transpose[Values[states]], UnitVector[64, 8]]];\n   nz = Select[co, # != 0 &];\n   {Keys[nz], Values[nz]/nz[{\"221\", \"100\"}], -1/((th[[1]] - th[[2]])/h + 1)}];\n{\"point 1 (rebuilt)\", sovExpansion[ah, ath, {2, -3, 5}], \"point 2\", sovExpansion[1/2, {3/13, -4/17}, {3, -7/2, 11/4}]}",
   "languageId": "wolfram",
   "outputs": [
