   "value": "(* repeat at point 1: reset the companion-frame operators (runPoint also redoes Q's), rebuild locOps, redo the checks *)\ngRows2 = gRows; symCheck2 = symCheck;\nrunPoint[{1/3, {2/7, -5/11}, {2, -3, 5}}];\nTTc = (ath[[1]] - ath[[2]])/ah;\nlocOps = <|\"1\" -> IdentityMatrix[64], \"t11\" -> ct[{1, 1}][ath[[1]]], \"R\" -> cR[ath[[1]]], \"R t11\" -> cR[ath[[1]]] . ct[{1, 1}][ath[[1]]],\n   \"t10 - R2/T\" -> ct[{1, 0}][ath[[1]]] - 1/TTc cR[ath[[2]]],\n   \"t20 - 2/(T+1) R R2\" -> ct20[ath[[1]]] - 2/(TTc + 1) cR[ath[[1]]] . cR[ath[[2]]],\n   \"R t20 - c t20 R2\" -> cR[ath[[1]]] . ct20[ath[[1]]] - 2 (TTc - 1)/((TTc + 1) (TTc - 2)) ct20[ath[[1]]] . cR[ath[[2]]],\n   \"R [t21 - t11 R2/(T+1)]\" -> cR[ath[[1]]] . (ct21[ath[[1]]] - 1/(TTc + 1) ct[{1, 1}][ath[[1]]] . cR[ath[[2]]])|>;\ngRows1 = rowG /@ Keys[locOps];\nsymCheck1 = Table[{n, oneBodySym[n]}, {n, {\"1\", \"t11\", \"R t11\"}}];\n{\"point 1: localize at r=0\", AllTrue[Values[locOps], isLoc[vac0 . #] &], \"one-body (symbolic r)\", symCheck1, \"ranks\", gRows1[[All, {1, 3}]], \"singlet nonzero\", Table[{g[[1]], g[[2]] =!= 0}, {g, gRows1}]}",
