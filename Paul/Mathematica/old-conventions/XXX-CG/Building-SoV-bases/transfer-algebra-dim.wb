  {
   "kind": 2,
   "value": "mQl[A_, i_, x_] := N[mzs[[i]], mprec]^(x/ah) mQ[[A, i, 2]][x];\n(* recipe label -> sorted SoV roots (units of h), from the B-eigenvalue identification in main-notes *)\nrootsOf = <|\"100\" -> {-1, 0, 1}, \"200\" -> {-1, 0, 2}, \"110\" -> {-1, 1, 1}, \"210\" -> {-1, 1, 2}, \"220\" -> {-1, 2, 2}, \"111\" -> {0, 1, 1}, \"211\" -> {0, 1, 2}, \"221\" -> {0, 2, 2}|>;\nmD[A_, s_, a_, b_] := mQl[A, 1, ath[[s]] + a ah] mQl[A, 2, ath[[s]] + b ah] - mQl[A, 2, ath[[s]] + a ah] mQl[A, 1, ath[[s]] + b ah];\nmPhiSite[A_, s_, g_] := With[{r = rootsOf[g]}, mQl[A, 1, ath[[s]] + r[[3]] ah] mD[A, s, r[[1]], r[[2]]]];\nmPhi[A_, {g1_, g2_}] := mPhiSite[A, 1, g1] mPhiSite[A, 2, g2];\n(* overlaps of the raw recipe states with the right eigenvectors *)\nmOv = Table[N[sovStates[k], mprec] . mEvecs[[A]], {A, 64}, {k, Keys[sovStates]}];\nrefK = First@FirstPosition[Keys[sovStates], {\"100\", \"100\"}];\nnRaw = Table[(mOv[[A, k]]/mOv[[A, refK]])/(mPhi[A, Keys[sovStates][[k]]]/mPhi[A, {\"100\", \"100\"}]), {A, 64}, {k, 64}];\nspreadN = Table[With[{c = nRaw[[All, k]]}, Max[Abs[c - Mean[c]]]/Abs[Mean[c]]], {k, 64}];\nnx = AssociationThread[Keys[sovStates] -> Rationalize[Chop[Mean /@ Transpose[nRaw], 10^-40], 10^-35]];\n{\"max state-spread of n_x\", N[Max[spreadN], 3], \"all n_x rational\", AllTrue[Values[nx], Head[#] === Rational || IntegerQ[#] &]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
