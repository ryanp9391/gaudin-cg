      {
       "data": "Out[210]= \\begin{array}{|c|c|c|c|}\\hline\\text{g1|g2} & \\text{site-1 roots} & \\text{site-2 roots} & \\text{RV coefficient / vacuum}\\\\\\hline\\text{100|100} & \\left\\{-1,0,1\\right\\} & \\left\\{-1,0,1\\right\\} & 1\\\\\\hline\\text{100|200} & \\left\\{-1,0,1\\right\\} & \\left\\{-1,0,2\\right\\} & \\frac{9548\\,r1}{8037}\\\\\\hline\\text{110|100} & \\left\\{-1,1,1\\right\\} & \\left\\{-1,0,1\\right\\} & \\frac{17\\,r1}{47}\\\\\\hline\\text{111|100} & \\left\\{0,1,1\\right\\} & \\left\\{-1,0,1\\right\\} & -\\frac{51}{94}\\,\\left(r2-r1\\,r3\\right)\\\\\\hline\\text{200|100} & \\left\\{-1,0,2\\right\\} & \\left\\{-1,0,1\\right\\} & \\frac{1}{171}\\,\\left(171\\,r3-94\\,r1\\right)\\\\\\hline\\text{200|200} & \\left\\{-1,0,2\\right\\} & \\left\\{-1,0,2\\right\\} & \\frac{77}{94}\\,\\left(r1\\,r3+r2\\right)\\\\\\hline\\text{210|100} & \\left\\{-1,1,2\\right\\} & \\left\\{-1,0,1\\right\\} & \\frac{17}{94}\\,\\left(r1\\,r3+r2\\right)\\\\\\hline\\text{210|200} & \\left\\{-1,1,2\\right\\} & \\left\\{-1,0,2\\right\\} & \\frac{154\\,r1\\,r2}{171}\\\\\\hline\\text{211|100} & \\left\\{0,1,2\\right\\} & \\left\\{-1,0,1\\right\\} & \\frac{1}{47}\\,\\left(-30\\,r1\\,r2+17\\,r1\\,r3^2-17\\,r2\\,r3\\right)\\\\\\hline\\text{211|200} & \\left\\{0,1,2\\right\\} & \\left\\{-1,0,2\\right\\} & -\\frac{1309\\,r2\\,\\left(r2-r1\\,r3\\right)}{8037}\\\\\\hline\\text{220|100} & \\left… [latex truncated: 1399 chars total]",
