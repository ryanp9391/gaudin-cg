      {
       "data": "Out[299]= \\begin{aligned}\n  &\\left\\{\\text{Pi t Pi\\^{}-1},\\langle\\!\\lvert \\text{g G g\\^{}-1}\\to \\mathrm{True},\\text{g\\^{}-1 G g}\\to \\mathrm{False},\\text{g\\^{}T G g\\^{}-T}\\to \\mathrm{False},\\text{g\\^{}-T G g\\^{}T}\\to \\mathrm{False}\\rvert\\!\\rangle \\right. \\\\\n  &\\left. ,\\text{Pi\\^{}-1 t Pi} \\right. \\\\\n  &\\left. ,\\langle\\! \\right. \\\\\n  &\\left. \\lvert \\text{g G g\\^{}-1}\\to \\mathrm{False},\\text{g\\^{}-1 G g}\\to \\mathrm{True} \\right. \\\\\n  &\\left. ,\\text{g\\^{}T G g\\^{}-T}\\to \\mathrm{False},\\text{g\\^{}-T G g\\^{}T}\\to \\mathrm{False}\\rvert\\!\\rangle \\right\\}\n\\end{aligned}",
