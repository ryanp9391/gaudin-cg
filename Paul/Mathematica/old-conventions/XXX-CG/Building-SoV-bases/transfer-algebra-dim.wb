  {
   "kind": 2,
   "value": "(* explicit localized combinations: exact rational version of W_d on the rank-increasing monomial basis, then null combinations of the off-V1 coordinates *)\nlocCombos[keys_, d_] := Module[{basis = Last@growW[keys, d], labs, W, ns},\n   labs = basis[[All, 1]];\n   W = Table[Fold[#1 . cGen[#2] &, vac0, l], {l, labs}];\n   ns = RowReduce@NullSpace[Transpose[W[[All, nonV1]]]];\n   <|\"monomials\" -> labs, \"combos\" -> ns, \"site1 factors\" -> Table[ArrayReshape[c . W, {8, 8}][[All, 8]], {c, ns}]|>];\nlc01 = locCombos[keysOf[{\"t10\", \"t11\"}, {0, 1}], 2];\n(* print each localized combination as sum of coefficient * monomial *)\nfmtCombo[labs_, c_] := Total@MapThread[#1 (Times @@ (Subscript[#[[1]], #[[2]]] & /@ #2) /. {} -> 1) &, {c, labs /. {} -> {}}];\nGrid[Table[{fmtCombo[lc01[\"monomials\"], lc01[\"combos\"][[i]]], lc01[\"site1 factors\"][[i]]}, {i, Length[lc01[\"combos\"]]}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
