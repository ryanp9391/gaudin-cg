      {
       "data": "Out[150]= \\begin{aligned}\n  &\\left\\{\\text{support sizes by round},\\left\\{55,55,55,55,55,55,55,55\\right\\} \\right. \\\\\n  &\\left. ,\\text{exact on final support},\\mathrm{True} \\right. \\\\\n  &\\left. ,\\text{degree histogram of support} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}1 & 2\\\\2 & 7\\\\3 & 13\\\\4 & 33\\end{pmatrix}\\right\\}\n\\end{aligned}",
