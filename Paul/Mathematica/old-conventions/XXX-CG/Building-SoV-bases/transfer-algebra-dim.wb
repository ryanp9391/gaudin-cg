      {
       "data": "Out[48]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{weight} & \\text{sector dim} & \\text{t10 (all r)} & \\text{t11(th1)} & \\text{t11(th1+3h)} & \\text{all}\\\\\\hline\\left\\{4,1,1\\right\\} & 2 & 2 & 2 & 1 & 2\\\\\\hline\\left\\{3,3,0\\right\\} & 2 & 2 & 1 & 2 & 2\\\\\\hline\\left\\{3,2,1\\right\\} & 6 & 6 & 6 & 6 & 6\\\\\\hline\\left\\{3,1,2\\right\\} & 6 & 6 & 6 & 6 & 6\\\\\\hline\\left\\{2,3,1\\right\\} & 6 & 6 & 6 & 6 & 6\\\\\\hline\\left\\{2,2,2\\right\\} & 10 & 9 & 10 & 10 & 10\\\\\\hline\\left\\{3,0,3\\right\\} & 2 & 2 & 1 & 2 & 2\\\\\\hline\\left\\{2,1,3\\right\\} & 6 & 6 & 6 & 6 & 6\\\\\\hline\\left\\{1,4,1\\right\\} & 2 & 2 & 2 & 1 & 2\\\\\\hline\\left\\{1,3,2\\right\\} & 6 & 6 & 6 & 6 & 6\\\\\\hline\\left\\{1,2,3\\right\\} & 6 & 6 & 6 & 6 & 6\\\\\\hline\\left\\{1,1,4\\right\\} & 2 & 2 & 2 & 1 & 2\\\\\\hline\\left\\{0,3,3\\right\\} & 2 & 2 & 1 & 2 & 2\\\\\\hline\\end{array}",
