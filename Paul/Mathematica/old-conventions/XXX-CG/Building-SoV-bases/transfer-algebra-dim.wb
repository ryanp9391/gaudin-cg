       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"790499\" data-output-id=\"58\" data-out-n=\"371\" data-sub-idx=\"8\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"81\" data-sub-start=\"49\" data-sub-end=\"49\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[371]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"33\" data-latex-b64=\"Mi42MzAwMDk=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">2.630009</span></span></span></span></span></div></div></div>",
