  {
   "kind": 2,
   "value": "(* which one-body covectors reach the target irreps; names with points in units (x - th1)/h *)\nnmFmt[B_, {nm_, x_}] := {nm, (x - B[\"th1\"])/B[\"h\"]};\nnmFmt[B_, {a : {_, _}, b : {_, _}}] := {nmFmt[B, a], nmFmt[B, b]};\nnmFmt[B_, other_] := other;\nwho[B_, sc_, target_] := Join[\n   Select[sc[\"one-body singles\"], MemberQ[#[[2]], target] &][[All, 1]] /. p : {_, _?NumericQ} :> nmFmt[B, p],\n   (nmFmt[B, #] & /@ Select[sc[\"one-body products\"], MemberQ[#[[2]], target] &][[All, 1]]),\n   Select[sc[\"one-body bilinears\"], MemberQ[#[[2]], target] &][[All, 1, 1]]];\nwho433 = who[B320, sc320, {4, 3, 3}];\n(* [3,1,0]: one level deeper, O1 O2 O3 with O1 O2 one-body *)\ndeeper[B_, sc_] := Module[{x0 = B[\"th1\"], h = B[\"h\"], names, starts, out},\n   names = Join[Flatten[Table[{nm, x0 + n h}, {nm, {\"t10\", \"t11\", \"t20\", \"t21\", \"t22\", \"R\"}}, {n, -1, 4}], 1], Flatten[Table[{{\"P\", a, r}, x0 + n h}, {a, 2}, {r, 0, 3}, {n, -1, 4}], 2]];\n   starts = Table[{p[[1]], Fold[B[\"act\"][#2[[1]], #2[[2]]][#1] &, B[\"vac\"], p[[1]]]}, {p, sc[\"one-body products\"]}];\n   out = Flatten[Table[With[{w3 = B[\"act\"][n3[[1]], n3[[2]]][s[[2]]]}, If[oneBodyR[B, w3], {Append[s[[1]], n3], reachR[B, w3]}, Nothing]], {s, starts}, {n3, names}], 1];\n   <|\"# one-body triples\" -> Length[out], \"union reach\" -> Union[Flatten[out[[All, 2]], 1]]|>];\nAbsoluteTiming[deep310 = deeper[B310, sc310];][[1]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"790499\" data-output-id=\"61\" data-out-n=\"380\" data-sub-idx=\"8\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"84\" data-sub-start=\"15\" data-sub-end=\"15\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[380]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"33\" data-latex-b64=\"MzcuODQ2MzUy\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">37.846352</span></span></span></span></span></div></div></div>",
