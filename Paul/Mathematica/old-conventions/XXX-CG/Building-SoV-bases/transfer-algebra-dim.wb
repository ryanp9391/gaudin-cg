      {
       "data": "Out[291]= \\begin{aligned}\n  &\\left\\{\\text{intertwiner},\\langle\\!\\lvert \\text{g G g\\^{}-1}\\to \\mathrm{False},\\text{g\\^{}-1 G g}\\to \\mathrm{False},\\text{g\\^{}T G g\\^{}-T}\\to \\mathrm{False},\\text{g\\^{}-T G g\\^{}T}\\to \\mathrm{False}\\rvert\\!\\rangle \\right. \\\\\n  &\\left. ,\\text{vacuum eigen for twist shape} \\right. \\\\\n  &\\left. ,\\langle\\!\\lvert \\text{diagonal}\\to \\mathrm{True},\\text{upper}\\to \\mathrm{True},\\text{lower}\\to \\mathrm{False}\\rvert\\!\\rangle \\right\\}\n\\end{aligned}",
