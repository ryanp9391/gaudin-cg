n><span style=\"top:-1.358em;\"><span class=\"pstrut\" style=\"height:11.616em;\"></span><span style=\"height:9.616em;width:0.8889em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.8889em\" height=\"9.616em\" style=\"width:0.8889em\" viewBox=\"0 0 888.89 9616\" preserveAspectRatio=\"xMinYMin\"><path d=\"M384 0 H504 V9616 H384z M384 0 H504 V9616 H384z\"/></svg></span></span><span style=\"top:-11.616em;\"><span class=\"pstrut\" style=\"height:11.616em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎬</span></span></span><span style=\"top:-12.758em;\"><span class=\"pstrut\" style=\"height:11.616em;\"></span><span style=\"height:9.616em;width:0.8889em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"0.8889em\" height=\"9.616em\" style=\"width:0.8889em\" viewBox=\"0 0 888.89 9616\" preserveAspectRatio=\"xMinYMin\"><path d=\"M384 0 H504 V9616 H384z M384 0 H504 V9616 H384z\"/></svg></span></span><span style=\"top:-22.366em;\"><span class=\"pstrut\" style=\"height:11.616em;\"></span><span class=\"delimsizinginner delim-size4\"><span>⎫</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:11.15em;\"><span></span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:12.8122em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
