      {
       "data": "Out[277]= \\begin{aligned}\n  &\\left\\{\\text{tw reproduces ct},\\left\\{\\mathrm{True},\\mathrm{True}\\right\\},\\text{\\# solutions} \\right. \\\\\n  &\\left. ,\\langle\\! \\right. \\\\\n  &\\left. \\lvert \\left\\{\\text{g G g\\^{}-1},\\text{lower}\\right\\}\\to 0,\\left\\{\\text{g G g\\^{}-1},\\text{upper}\\right\\}\\to 6, \\right. \\\\\n  &\\left. \\left\\{\\text{g\\^{}-1 G g},\\text{lower}\\right\\}\\to 0,\\left\\{\\text{g\\^{}-1 G g},\\text{upper}\\right\\}\\to 6\\rvert\\!\\rangle \\right\\}\n\\end{aligned}",
