       "data": "Out[282]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{conjugation (upper-triangular)} & \\text{\\{r1, r2, r3\\}} & \\text{diagonal} & \\text{<v\\_g| left eigenvector of t10, t11 (twist w)} & \\text{P1 P2 (chain twist z)}\\\\\\hline\\text{g G g\\^{}-1} & \\left\\{-\\frac{3}{7},-\\frac{12}{7},\\frac{22}{7}\\right\\} & \\left\\{\\frac{7}{3},-\\frac{1}{2},4\\right\\} & \\mathrm{False} & \\frac{15359531}{117649}\\\\\\hline\\text{g G g\\^{}-1} & \\left\\{-\\frac{3}{7},\\frac{3}{14},-\\frac{19}{14}\\right\\} & \\left\\{\\frac{7}{3},4,-\\frac{1}{2}\\right\\} & \\mathrm{False} & \\frac{1246352}{117649}\\\\\\hline\\text{g G g\\^{}-1} & \\left\\{-\\frac{1}{4},-1,\\frac{7}{2}\\right\\} & \\left\\{4,-\\frac{1}{2},\\frac{7}{3}\\right\\} & \\mathrm{False} & \\frac{21}{4}\\\\\\hline\\text{g G g\\^{}-1} & \\left\\{-\\frac{1}{4},\\frac{3}{14},-\\frac{19}{14}\\right\\} & \\left\\{4,\\frac{7}{3},-\\frac{1}{2}\\right\\} & \\mathrm{False} & \\frac{767}{784}\\\\\\hline\\text{g G g\\^{}-1} & \\left\\{2,-\\frac{12}{7},\\frac{22}{7}\\right\\} & \\left\\{-\\frac{1}{2},\\frac{7}{3},4\\right\\} & \\mathrm{False} & \\frac{20340512}{49}\\\\\\hline\\text{g G g\\^{}-1} & \\left\\{2,-1,\\frac{7}{2}\\right\\} & \\left\\{-\\frac{1}{2},4,\\frac{7}{3}\\right\\} & \\mathrm{False} & \\frac{508101}{2}\\\\\\hline\\text{g\\^{}-1 G g} & \\left\\{-2,8,-\\frac{7}{2}\\righ… [latex truncated: 2115 chars total]",
