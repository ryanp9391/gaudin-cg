   "value": "(* cross-site part of the normalisation: site-local factors cancel *)\ncrossN = Table[nTab[[i, j]] nTab[[1, 1]]/(nTab[[i, 1]] nTab[[1, j]]), {i, 8}, {j, 8}];\n(* at point 1, T + k = (171 + 77 k)/77; read exponents of the distinct primes of 171 + 77k *)\nkPrime = <|-4 -> 137, -2 -> 17, -1 -> 47, 0 -> 19, 1 -> 31, 2 -> 13, 3 -> 67, 4 -> 479|>;\nexpo[q_, p_] := IntegerExponent[Numerator[q], p] - IntegerExponent[Denominator[q], p];\ncrossExp[q_] := DeleteCases[KeyValueMap[#1 -> expo[q, #2] &, kPrime], _ -> 0];\n(* leftover after removing the identified (T+k) factors: should be a pure number from h's *)\nleftover[q_] := q/Times @@ ((TT1 + #[[1]])^#[[2]] & /@ crossExp[q]);\nGrid[Prepend[Flatten[Table[If[crossN[[i, j]] == 1, Nothing, {sovLabels[[i]] <> \"|\" <> sovLabels[[j]], rootsOf[sovLabels[[i]]], rootsOf[sovLabels[[j]]], crossExp[crossN[[i, j]]], leftover[crossN[[i, j]]]}], {i, 8}, {j, 8}], 1], {\"g1|g2\", \"roots 1\", \"roots 2\", \"(T+k)^e\", \"leftover\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
