      {
       "data": "Out[179]= \\begin{aligned}\n  &\\left\\{\\text{max Baxter residual} \\right. \\\\\n  &\\left. ,0.\\times 10^{-52},\\text{degree tally (q1, q2)} \\right. \\\\\n  &\\left. ,\\begin{pmatrix}\\left\\{3,3\\right\\} & 2\\\\\\left\\{3,2\\right\\} & 6\\\\\\left\\{2,3\\right\\} & 6\\\\\\left\\{2,4\\right\\} & 1\\\\\\left\\{2,2\\right\\} & 10\\\\\\left\\{1,3\\right\\} & 6\\\\\\left\\{3,1\\right\\} & 6\\\\\\left\\{1,4\\right\\} & 2\\\\\\left\\{1,2\\right\\} & 6\\\\\\left\\{0,3\\right\\} & 2\\\\\\left\\{0,4\\right\\} & 1\\\\\\left\\{2,1\\right\\} & 6\\\\\\left\\{4,2\\right\\} & 1\\\\\\left\\{3,0\\right\\} & 2\\\\\\left\\{4,1\\right\\} & 2\\\\\\left\\{4,0\\right\\} & 1\\\\\\left\\{0,2\\right\\} & 1\\\\\\left\\{2,0\\right\\} & 1\\\\\\left\\{1,1\\right\\} & 2\\end{pmatrix}\\right\\}\n\\end{aligned}",
