      {
       "data": "Out[95]= \\begin{array}{|c|c|c|c|}\\hline\\text{d} & \\text{dim W} & \\text{dim W cap V1} & \\text{with v1=0}\\\\\\hline0 & 1 & 1 & 1\\\\\\hline1 & 5 & 2 & 2\\\\\\hline2 & 15 & 3 & 3\\\\\\hline3 & 34 & 3 & 3\\\\\\hline4 & 61 & 6 & 5\\\\\\hline5 & 64 & 8 & 7\\\\\\hline\\end{array}",
