       "data": "Out[229]= \\begin{array}{|c|c|c|c|}\\hline\\text{operator} & \\text{<v\\_g|O|singlet>} & \\text{rank (generic r)} & \\text{rows prop. to e8.g (one-body, site 2 = rotated vacuum)}\\\\\\hline\\text{1} & \\left\\{\\frac{r2^4}{9}-\\frac{2}{9}\\,r1\\,r3\\,r2^3+\\frac{1}{9}\\,r1^2\\,r3^2\\,r2^2,\\frac{1}{9}\\,r1^2\\,r2^2\\,r3-\\frac{r1\\,r2^3}{9},\\frac{r3\\,r2^3}{9}-\\frac{2}{9}\\,r1\\,r3^2\\,r2^2+\\frac{1}{9}\\,r1^2\\,r3^3\\,r2,\\frac{1}{9}\\,r1^2\\,r2\\,r3^2-\\frac{r2^3}{9},\\frac{r2^3}{3}-\\frac{2}{3}\\,r1\\,r3\\,r2^2+\\frac{1}{3}\\,r1^2\\,r3^2\\,r2,\\frac{1}{3}\\,r1^2\\,r2\\,r3-\\frac{r1\\,r2^2}{3},\\frac{2}{9}\\,r1\\,r2\\,r3^2-\\frac{2\\,r2^2\\,r3}{9},\\frac{r1\\,r2\\,r3}{3}-\\frac{r2^2}{3},\\frac{1}{9}\\,r1^2\\,r2^2\\,r3-\\frac{r1\\,r2^3}{9},\\frac{r1^2\\,r2^2}{9},\\frac{1}{9}\\,r1^2\\,r2\\,r3^2-\\frac{1}{9}\\,r1\\,r2^2\\,r3,\\frac{1}{9}\\,r2\\,r3\\,r1^2+\\frac{r2^2\\,r1}{9},\\frac{1}{3}\\,r1^2\\,r2\\,r3-\\frac{r1\\,r2^2}{3},\\frac{r1^2\\,r2}{3},\\frac{2\\,r1\\,r2\\,r3}{9},\\frac{r1\\,r2}{3},\\frac{r3\\,r2^3}{9}-\\frac{2}{9}\\,r1\\,r3^2\\,r2^2+\\frac{1}{9}\\,r1^2\\,r3^3\\,r2,\\frac{1}{9}\\,r1^2\\,r2\\,r3^2-\\frac{1}{9}\\,r1\\,r2^2\\,r3,\\frac{r1^2\\,r3^4}{9}-\\frac{2}{9}\\,r1\\,r2\\,r3^3+\\frac{r2^2\\,r3^2}{9},\\frac{r1^2\\,r3^3}{9}-\\frac{r2^2\\,r3}{9},\\frac{r1^2\\,r3^3}{3}-\\frac{2}{3}\\,r1\\,r2\\,r3^2+\\frac{r2^2\\,r3}{3},\\fra… [latex truncated: 1364799 chars total]",
