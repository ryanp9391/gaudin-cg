  {
   "kind": 2,
   "value": "(* the {0,3} anomaly: 6 localized at degree 4 before W is everything *)\nWith[{o = First@growW[keysOf[{\"t10\", \"t11\"}, {0, 3}], 5]}, Grid[Prepend[o, {\"d\", \"dim W\", \"dim W cap V1\", \"with v1=0\"}], Frame -> All]]",
