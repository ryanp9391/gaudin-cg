      {
       "data": "Out[43]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{r set S} & \\text{t10 only} & \\text{t11 only} & \\text{both} & \\text{lin span}\\\\\\hline\\left\\{0\\right\\} & 63 & 55 & 64 & 3\\\\\\hline\\left\\{0,1\\right\\} & 63 & 64 & 64 & 5\\\\\\hline\\left\\{0,1,2\\right\\} & 63 & 64 & 64 & 6\\\\\\hline\\left\\{0,1,2,3\\right\\} & 63 & 64 & 64 & 7\\\\\\hline\\left\\{-1,0\\right\\} & 63 & 64 & 64 & 5\\\\\\hline\\left\\{-2,-1,0\\right\\} & 63 & 64 & 64 & 6\\\\\\hline\\left\\{-3,-2,-1,0\\right\\} & 63 & 64 & 64 & 7\\\\\\hline\\left\\{-1,0,1\\right\\} & 63 & 64 & 64 & 6\\\\\\hline\\left\\{-2,-1,0,1,2\\right\\} & 63 & 64 & 64 & 7\\\\\\hline\\left\\{1,2\\right\\} & 63 & 64 & 64 & 5\\\\\\hline\\left\\{1,2,3\\right\\} & 63 & 64 & 64 & 6\\\\\\hline\\left\\{-1,1\\right\\} & 63 & 64 & 64 & 5\\\\\\hline\\left\\{-3,-2,-1,0,1,2,3\\right\\} & 63 & 64 & 64 & 7\\\\\\hline\\end{array}",
