      {
       "data": "Out[60]= \\begin{array}{|c|c|c|c|}\\hline\\text{r set S} & \\text{t10 only} & \\text{t11 only} & \\text{both}\\\\\\hline\\left\\{0\\right\\} & 4 & 5 & 6\\\\\\hline\\left\\{1\\right\\} & 4 & 6 & 6\\\\\\hline\\left\\{2\\right\\} & 4 & 6 & 6\\\\\\hline\\left\\{3\\right\\} & 4 & 5 & 6\\\\\\hline\\left\\{-1\\right\\} & 4 & 6 & 6\\\\\\hline\\left\\{-2\\right\\} & 4 & 6 & 6\\\\\\hline\\left\\{-3\\right\\} & 4 & 6 & 6\\\\\\hline\\left\\{0,1\\right\\} & 4 & 6 & 6\\\\\\hline\\left\\{0,1,2\\right\\} & 4 & 6 & 6\\\\\\hline\\left\\{-1,0,1\\right\\} & 4 & 6 & 6\\\\\\hline\\left\\{-3,-2,-1,0,1,2,3\\right\\} & 4 & 6 & 6\\\\\\hline\\end{array}",
