  {
   "kind": 2,
   "value": "(* six generators whose linear span with 1 is the full 7-dim span: t10 at r=0,1 and t11 at r=0..3 *)\ng6 = Join[keysOf[{\"t10\"}, {0, 1}], keysOf[{\"t11\"}, {0, 1, 2, 3}]];\n(* all monomials of degree <= 4 in g6 and their covectors <0|m, exact *)\nmons = DeleteDuplicates[Sort /@ Flatten[Table[Tuples[g6, d], {d, 0, 4}], 1]];\nClearAll[covOf];\ncovOf[{}] = vac0;\ncovOf[l_List] := covOf[l] = covOf[Most[l]] . cGen[Last[l]];\nWall = covOf /@ mons;\n{linDim[g6], Length[mons], MatrixRank[Wall, Modulus -> cp]}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"790499\" data-output-id=\"20\" data-out-n=\"131\" data-sub-idx=\"8\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"21\" data-sub-start=\"8\" data-sub-end=\"8\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[131]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-latex-b64=\"XGxlZnRcezcsMjEwLDY0XHJpZ2h0XH0=\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">7</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">210</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">64</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[131]= \\left\\{7,210,64\\right\\}",
       "mime": "text/plain"
