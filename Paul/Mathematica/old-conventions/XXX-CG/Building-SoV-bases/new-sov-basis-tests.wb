   "kind": 2,
   "value": "(* full <x_A|y_B>, normalised by the common twist factor; HW (original) vs LW *)\nzfac = (z[1] - z[2]) (z[1] - z[3])^2 (z[2] - z[3]);\novHW = Table[Simplify[(xHW[A] . yHW[B])[[1, 1]]/zfac], {A, gtpats}, {B, gtpats}];\novLW = Table[Simplify[(xLW[A] . yLW[B])[[1, 1]]/zfac /. solLW[[1]]], {A, gtpats}, {B, gtpats}];\nGrid[{{\"HW (rotparams)\", \"LW (solLW)\"}, {MatrixForm[ovHW], MatrixForm[ovLW]}}, Frame -> All]",
