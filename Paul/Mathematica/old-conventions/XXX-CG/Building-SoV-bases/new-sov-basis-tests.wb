      {
       "data": "Out[382]= \\begin{array}{|c|c|c|}\\hline\\text{branch} & \\text{angles} & \\text{$\\langle$x\\_\\{(2),(2,1)\\}|vacR$\\rangle$}\\\\\\hline1 & \\left\\{c1\\to \\frac{c2\\,d1\\,\\left(z\\left(2\\right)-z\\left(1\\right)\\right)}{z\\left(2\\right)-z\\left(3\\right)},c3\\to \\frac{z\\left(3\\right)-z\\left(1\\right)}{d1\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)},d2\\to \\frac{z\\left(2\\right)-z\\left(3\\right)}{c2\\,z\\left(1\\right)-c2\\,z\\left(2\\right)},d3\\to \\frac{z\\left(1\\right)-z\\left(3\\right)}{c2\\,d1\\,z\\left(1\\right)-c2\\,d1\\,z\\left(2\\right)}\\right\\} & \\frac{1}{2}\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)^2\\,\\left(z\\left(2\\right)-z\\left(3\\right)\\right)\\\\\\hline\\end{array}",
