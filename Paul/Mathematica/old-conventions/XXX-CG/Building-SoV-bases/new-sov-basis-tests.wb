adius:3px;color:var(--vscode-foreground,inherit);\" title=\"Show +20 more lines\">&#43;&#8230;</button>\n  <button data-action=\"open-text\" style=\"padding:1px 6px;font-size:12px;cursor:pointer;line-height:1.5;background:transparent;border:1px solid rgba(128,128,128,0.3);border-radius:3px;color:var(--vscode-foreground,inherit);\" title=\"Open as text file\">&#128196;</button>\n</div>",
