      {
       "data": "Out[371]= \\left\\{\\begin{pmatrix}0 & 0 & 0 & -\\frac{z\\left(1\\right)^2\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,z\\left(2\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)^2\\,\\left(z\\left(2\\right)-z\\left(3\\right)\\right)}{2\\,z\\left(3\\right)\\,\\left(z\\left(1\\right)+z\\left(2\\right)+z\\left(3\\right)\\right)} & -\\frac{z\\left(1\\right)^2\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,z\\left(2\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)^2\\,\\left(z\\left(2\\right)-z\\left(3\\right)\\right)}{2\\,z\\left(3\\right)} & 0 & -\\frac{z\\left(1\\right)^2\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,z\\left(2\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)^2\\,\\left(z\\left(2\\right)-z\\left(3\\right)\\right)\\,\\left(z\\left(1\\right)^2+3\\,\\left(z\\left(2\\right)+z\\left(3\\right)\\right)\\,z\\left(1\\right)+z\\left(2\\right)^2+z\\left(3\\right)^2+3\\,z\\left(2\\right)\\,z\\left(3\\right)\\right)}{2\\,z\\left(3\\right)\\,\\left(z\\left(1\\right)+z\\left(2\\right)+z\\left(3\\right)\\right)} & -\\frac{z\\left(1\\right)^3\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,z\\left(2\\right)^2\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)^2\\,\\left(z\\left(2\\right)-z\\left(3\\right)\\right)}{4\\,\\left(z\\left(1\\right)+z\\left(2\\right)+z\\left(3\\right)\\right)}\\\\0 &… [latex truncated: 30114 chars total]",
