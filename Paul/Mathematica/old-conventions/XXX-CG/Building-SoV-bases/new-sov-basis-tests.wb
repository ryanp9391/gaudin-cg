      {
       "data": "Out[377]= \\begin{array}{|c|c|c|}\\hline\\text{A} & \\text{$\\langle$x\\_A|vacR$\\rangle$} & \\text{$\\langle$vacL|y\\_A$\\rangle$}\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{0,0\\right\\}\\right\\} & 0 & \\frac{1}{2}\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)^2\\,\\left(z\\left(2\\right)-z\\left(3\\right)\\right)\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{1,0\\right\\}\\right\\} & 0 & 0\\\\\\hline\\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\}\\right\\} & 0 & 0\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{0,0\\right\\}\\right\\} & 0 & 0\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{1,0\\right\\}\\right\\} & 0 & 0\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{1,1\\right\\}\\right\\} & 0 & 0\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{2,0\\right\\}\\right\\} & 0 & 0\\\\\\hline\\left\\{\\left\\{2\\right\\},\\left\\{2,1\\right\\}\\right\\} & \\frac{1}{2}\\,\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)^2\\,\\left(z\\left(2\\right)-z\\left(3\\right)\\right) & 0\\\\\\hline\\end{array}",
