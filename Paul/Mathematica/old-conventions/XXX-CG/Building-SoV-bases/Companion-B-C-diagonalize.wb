  {
   "kind": 1,
   "value": "## SoV bases $\\langle x_A|$ and $|y_B\\rangle$",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "gtpats = {{{1}, {0, 0}}, {{1}, {1, 0}}, {{1}, {1, 1}}, {{2}, {0, 0}}, {{2}, {1, 0}}, {{2}, {1, 1}}, {{2}, {2, 0}}, {{2}, {2, 1}}};\ngtpairs = Flatten[Table[{A1, A2}, {A1, gtpats}, {A2, gtpats}], 1];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "y[{{2}, {2, 1}}] = vacR;\ny[{{2}, {2, 0}}] = tS[{2, 0}][\\[Theta][1] + 2 h] . Inverse[t[{1, 0}][\\[Theta][1] + 2 h]] . vacR // Simplify;\ny[{{2}, {1, 1}}] = tS[{1, 0}][\\[Theta][1] + 2 h] . vacR;\ny[{{2}, {1, 0}}] = tS[{1, 0}][\\[Theta][1] + 2 h] . y[{{2}, {2, 0}}];\ny[{{2}, {0, 0}}] = tS[{2, 0}][\\[Theta][1] + 2 h] . y[{{2}, {2, 0}}];\ny[{{1}, {1, 1}}] = tS[{1, 1}][\\[Theta][1] + 2 h] . vacR;\ny[{{1}, {1, 0}}] = tS[{1, 1}][\\[Theta][1] + 2 h] . y[{{2}, {2, 0}}];\ny[{{1}, {0, 0}}] = tS[{2, 1}][\\[Theta][1] + 2 h] . y[{{2}, {2, 0}}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "x[{{1}, {0, 0}}] = vacL;\nx[{{2}, {0, 0}}] = \n  vacL . t[{2, 0}][\\[Theta][1]] . Inverse[t[{1, 0}][\\[Theta][1]]] // Simplify;\nx[{{1}, {1, 0}}] = vacL . t[{1, 0}][\\[Theta][1]];\nx[{{1}, {1, 1}}] = vacL . t[{1, 1}][\\[Theta][1]];\nx[{{2}, {1, 0}}] = x[{{2}, {0, 0}}] . t[{1, 0}][\\[Theta][1]];\nx[{{2}, {1, 1}}] = x[{{2}, {0, 0}}] . t[{1, 1}][\\[Theta][1]];\nx[{{2}, {2, 0}}] = x[{{2}, {0, 0}}] . t[{2, 0}][\\[Theta][1]];\nx[{{2}, {2, 1}}] = x[{{2}, {0, 0}}] . t[{2, 1}][\\[Theta][1]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {}
  },
  {
   "kind": 2,
   "value": "(* rebuild <x_A| from the general rule  vacL . T_{mu11,0}(th1) . T_{1,0}(th1)^-1 . T_{mu21,mu12}(th1)  using CBR, with label {{mu11},{mu21,mu12}} *)\nxCBR[{{m11_}, {m21_, m12_}}] := vacL . tCBR[{m11, 0}][\\[Theta][1]] . Inverse[tCBR[{1, 0}][\\[Theta][1]]] . tCBR[{m21, m12}][\\[Theta][1]];\n(* at a random numeric point: does xCBR agree with x, is it a left eigenvector of B(u) (rank of {x, x.B} = 1), and are the 8 states independent? *)\nWith[{pt = {u -> 3/7, h -> 2/5, \\[Theta][1] -> 1/3, \\[Chi][1] -> 5/11, \\[Chi][2] -> -2/7, \\[Chi][3] -> 3/13}},\n {\"xCBR==x\" -> AllTrue[gtpats, Simplify[(xCBR[#] - x[#]) /. pt] == {ConstantArray[0, 8]} &],\n  \"rank{x,x.B} per state\" -> Table[MatrixRank[Join[xCBR[A], xCBR[A] . B[u]] /. pt], {A, gtpats}],\n  \"rank of all x\" -> MatrixRank[Join @@ (xCBR /@ gtpats) /. pt]}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wl-output-block\"><div class=\"wl-output-header\" style=\"display:flex;align-items:center;gap:6px;width:100%;min-height:22px;\" data-session-epoch=\"790499\" data-output-id=\"69\" data-out-n=\"449\" data-sub-idx=\"3\" data-output-format=\"WLLatex\" data-output-is-graphics=\"0\" data-cell-idx=\"20\" data-sub-start=\"3\" data-sub-end=\"6\"><span style=\"font-size:10px;color:#888;margin-right:8px;\">Out[449]=</span></div><div class=\"wl-output-content\"><div class=\"vscode-wolfram-wllatex-prerendered\" data-page-width-em=\"21\" data-line-broken=\"1\" data-latex-b64=\"XGJlZ2lue2FsaWduZWR9CiAgJlxsZWZ0XHtcdGV4dHt4Q0JSPT14fVx0byBcbWF0aHJte1RydWV9LFx0ZXh0e3Jhbmtce3gseC5CXH0gcGVyIHN0YXRlfSBccmlnaHQuIFxcCiAgJlxsZWZ0LiBcdG8gXGxlZnRcezEsMSwxLDEsMSwxLDEsMVxyaWdodFx9LFx0ZXh0e3Jhbmsgb2YgYWxsIHh9XHRvIDhccmlnaHRcfQpcZW5ke2FsaWduZWR9\"><span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:3em;vertical-align:-1.25em;\"></span><span class=\"mord\"><span class=\"mtable\"><span class=\"col-align-r\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.75em;\"><span style=\"top:-3.75em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span><span style=\"top:-2.25em;\"><span class=\"pstrut\" style=\"height:2.84em;\"></span><span class=\"mord\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.25em;\"><span></span></span></span></span></span><span class=\"col-align-l\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.75em;\"><span style=\"top:-3.91em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord text\"><span class=\"mord\">xCBR==x</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">True</span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord\">rank{x,x.B} per state</span></span><span class=\"mclose nulldelimiter\"></span></span></span></span><span style=\"top:-2.41em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen nulldelimiter\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\">{</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord text\"><span class=\"mord\">rank of all x</span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">→</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\">8</span><span class=\"mclose delimcenter\" style=\"top:0em;\">}</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.25em;\"><span></span></span></span></span></span></span></span></span></span></span></span></div></div></div>",
       "mime": "x-application/wolfram-language-html"
      },
      {
       "data": "Out[449]= \\begin{aligned}\n  &\\left\\{\\text{xCBR==x}\\to \\mathrm{True},\\text{rank\\{x,x.B\\} per state} \\right. \\\\\n  &\\left. \\to \\left\\{1,1,1,1,1,1,1,1\\right\\},\\text{rank of all x}\\to 8\\right\\}\n\\end{aligned}",
       "mime": "text/plain"
      }
     ],
     "id": "5c9e1e7a-2508-4f88-9d12-ae0fd6b9851f"
    }
   ],
