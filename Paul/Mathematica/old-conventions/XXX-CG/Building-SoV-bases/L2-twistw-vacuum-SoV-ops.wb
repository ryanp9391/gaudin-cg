      {
       "data": "Out[111]= \\begin{array}{|c|c|c|c|c|}\\hline\\text{rep} & \\text{point} & \\text{n} & \\text{T\\_\\{n,0\\}T\\_\\{l2,l2\\} = c T\\_\\{l2,0\\}T\\_\\{n,l2\\} (theta1)} & \\text{c}\\\\\\hline\\left\\{2,1,0\\right\\} & 1 & 1 & \\mathrm{True} & 1\\\\\\hline\\left\\{2,1,0\\right\\} & 1 & 2 & \\mathrm{True} & 1\\\\\\hline\\left\\{2,1,0\\right\\} & 2 & 1 & \\mathrm{True} & 1\\\\\\hline\\left\\{2,1,0\\right\\} & 2 & 2 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,1,0\\right\\} & 1 & 1 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,1,0\\right\\} & 1 & 2 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,1,0\\right\\} & 1 & 3 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,1,0\\right\\} & 2 & 1 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,1,0\\right\\} & 2 & 2 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,1,0\\right\\} & 2 & 3 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,2,0\\right\\} & 1 & 2 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,2,0\\right\\} & 1 & 3 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,2,0\\right\\} & 2 & 2 & \\mathrm{True} & 1\\\\\\hline\\left\\{3,2,0\\right\\} & 2 & 3 & \\mathrm{True} & 1\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
