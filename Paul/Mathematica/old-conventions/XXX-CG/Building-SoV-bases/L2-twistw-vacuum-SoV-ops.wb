  {
   "kind": 2,
   "value": "ClearAll[ratioC];\n(* operator level, all at th1: T_{n,0} T_{l2,l2} = c T_{l2,0} T_{n,l2}?  returns {rep, point, n, proportional?, c, c compared with a guess} *)\nratioC[rep_, pt_, n_] := Module[{l2 = rep[[2]], u, A, B, pos},\n   setPoint2[pts[pt]]; setRep2[rep]; u = th[[1]];\n   A = Normal[tLamMat[Gz][{n, 0}, u] . tLamMat[Gz][{l2, l2}, u]]; B = Normal[tLamMat[Gz][{l2, 0}, u] . tLamMat[Gz][{n, l2}, u]];\n   pos = First@Position[B, x_ /; x != 0, {2}, 1];\n   {rep, pt, n, B =!= 0 A && MatrixRank[{Flatten[A], Flatten[B]}] == 1, Factor[Extract[A, pos]/Extract[B, pos]]}];\nrc = Join[Table[ratioC[{2, 1, 0}, pt, n], {pt, {1, 2}}, {n, {1, 2}}], Table[ratioC[{3, 1, 0}, pt, n], {pt, {1, 2}}, {n, {1, 2, 3}}], Table[ratioC[{3, 2, 0}, pt, n], {pt, {1, 2}}, {n, {2, 3}}]] ~Flatten~ 1;\nGrid[Prepend[rc, {\"rep\", \"point\", \"n\", \"T_{n,0}T_{l2,l2} = c T_{l2,0}T_{n,l2} (theta1)\", \"c\"}], Frame -> All]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
