      {
       "data": "Out[70]= \\begin{array}{|c|c|c|c|}\\hline\\text{rep} & \\text{mu} & \\text{one-body} & \\text{a = c\\_gen s.O\\^{}(1)}\\\\\\hline\\text{[3,2,0] exact} & \\left\\{\\left\\{2\\right\\},\\left\\{0,0\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{[3,2,0] exact} & \\left\\{\\left\\{2\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{[3,2,0] exact} & \\left\\{\\left\\{2\\right\\},\\left\\{2,2\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{[3,2,0] exact} & \\left\\{\\left\\{3\\right\\},\\left\\{2,2\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{[4,2,0] mod p} & \\left\\{\\left\\{2\\right\\},\\left\\{0,0\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{[4,2,0] mod p} & \\left\\{\\left\\{2\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{[4,2,0] mod p} & \\left\\{\\left\\{2\\right\\},\\left\\{2,2\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{[4,2,0] mod p} & \\left\\{\\left\\{3\\right\\},\\left\\{2,2\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\text{[4,2,0] mod p} & \\left\\{\\left\\{4\\right\\},\\left\\{2,2\\right\\}\\right\\} & \\mathrm{True} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
