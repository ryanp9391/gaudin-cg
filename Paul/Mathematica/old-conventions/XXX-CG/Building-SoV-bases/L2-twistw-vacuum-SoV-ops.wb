      {
       "data": "Out[66]= \\begin{array}{|c|c|c|c|c|c|}\\hline\\text{rep} & \\text{\\{point, w\\}} & \\text{mu} & \\text{a = c s.O\\^{}(1)} & \\text{c} & \\text{c = formula}\\\\\\hline\\left\\{2,1,0\\right\\} & \\left\\{1,\\left\\{\\frac{7}{3},-\\frac{1}{2},4\\right\\}\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{0,0\\right\\}\\right\\} & \\mathrm{True} & 1 & \\mathrm{True}\\\\\\hline\\left\\{2,1,0\\right\\} & \\left\\{1,\\left\\{\\frac{7}{3},-\\frac{1}{2},4\\right\\}\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\mathrm{True} & -\\frac{1880}{17787} & \\mathrm{True}\\\\\\hline\\left\\{2,1,0\\right\\} & \\left\\{1,\\left\\{\\frac{7}{3},-\\frac{1}{2},4\\right\\}\\right\\} & \\left\\{\\left\\{2\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\mathrm{True} & -\\frac{176720}{4108797} & \\mathrm{True}\\\\\\hline\\left\\{2,1,0\\right\\} & \\left\\{1,\\left\\{-\\frac{5}{2},3,\\frac{1}{5}\\right\\}\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{0,0\\right\\}\\right\\} & \\mathrm{True} & 1 & \\mathrm{True}\\\\\\hline\\left\\{2,1,0\\right\\} & \\left\\{1,\\left\\{-\\frac{5}{2},3,\\frac{1}{5}\\right\\}\\right\\} & \\left\\{\\left\\{1\\right\\},\\left\\{1,1\\right\\}\\right\\} & \\mathrm{True} & -\\frac{1880}{17787} & \\mathrm{True}\\\\\\hline\\left\\{2,1,0\\right\\} & \\left\\{1,\\left\\{-\\frac{5}{2},3,\\frac{1}{5}\\right\\}\\right\\} & \\left\\{\\left\\{2\\right\\},… [latex truncated: 4217 chars total]",
