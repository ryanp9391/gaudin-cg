       "data": "Out[857]= \\begin{array}{|c|c|}\\hline\\text{poles \\{s, n\\}} & \\begin{pmatrix}1 & 2\\\\1 & 3\\\\1 & 4\\\\2 & 2\\\\2 & 3\\\\2 & 4\\end{pmatrix}\\\\\\hline\\text{D\\_A polynomial in k1, degrees} & \\left\\{\\mathrm{True},\\left\\{4\\right\\}\\right\\}\\\\\\hline\\text{\\# components of v1 (x) v1 nonzero / zero} & \\left\\{729,0\\right\\}\\\\\\hline\\text{max |v| on the zero components of v1 (x) v1 (k1 = 1/7)} & -\\infty \\\\\\hline\\text{ratio v/(v1 (x) v1): spread over components, per k1} & \\left\\{0.\\times 10^{-86},0.\\times 10^{-85},0.\\times 10^{-85}\\right\\}\\\\\\hline\\text{ratio (mean), per k1} & \\left\\{0.180223581851,0.180223581851,0.180223581851\\right\\}\\\\\\hline\\end{array}",
