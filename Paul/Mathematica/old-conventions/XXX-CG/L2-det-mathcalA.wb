      {
       "data": "Out[862]= \\begin{array}{|c|c|c|c|c|c|c|}\\hline\\text{rep} & \\text{point} & \\text{dim} & \\text{spread of C (components, k1)} & \\text{|v - C v1 (x) v1|, all orders in k1} & \\text{C} & \\text{C / guess}\\\\\\hline2,1,0 & 1 & 64 & 9.999999999999999\\times 10^{-90} & 1\\times 10^{-90} & \\frac{6859}{2520} & 1\\\\\\hline2,1,0 & 2 & 64 & 9.999999999999999\\times 10^{-90} & 9.999999999999999\\times 10^{-90} & -\\frac{7304528}{63081} & 1\\\\\\hline2,1,0 & 3 & 64 & 9.999999999999999\\times 10^{-90} & 9.999999999999998\\times 10^{-89} & \\frac{1423656}{106817} & 1\\\\\\hline3,1,0 & 1 & 225 & 9.999999999999998\\times 10^{-89} & 1\\times 10^{-90} & \\frac{2476099}{13739040} & 1\\\\\\hline3,1,0 & 2 & 225 & 1\\times 10^{-87} & 9.999999999999999\\times 10^{-87} & -\\frac{2706784157}{16085655} & 1\\\\\\hline3,2,0 & 1 & 225 & 1\\times 10^{-87} & 1\\times 10^{-87} & \\frac{6859}{2520} & 1\\\\\\hline3,2,0 & 3 & 225 & 9.999999999999999\\times 10^{-87} & 9.999999999999999\\times 10^{-87} & \\frac{1423656}{106817} & 1\\\\\\hline4,2,0 & 1 & 729 & 0.\\times 10^{-85} & 0.\\times 10^{-85} & \\frac{2476099}{13739040} & 1\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "7919f119-d8b7-46e4-8be8-c67adcd0f901"
    }
