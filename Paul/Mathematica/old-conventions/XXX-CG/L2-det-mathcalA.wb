      {
       "data": "Out[803]= \\begin{array}{|c|c|}\\hline\\text{site rep, point index, \\{h, $\\theta$, z, p\\}} & \\left\\{\\left\\{4,2,0\\right\\},1,\\left\\{1,\\left\\{\\frac{1}{3},-\\frac{8}{57}\\right\\},\\left\\{\\frac{5}{2},\\frac{7}{3},\\frac{6}{35}\\right\\},\\left\\{\\frac{3}{5},\\frac{4}{7}\\right\\}\\right\\}\\right\\}\\\\\\hline\\text{chain dimension} & 729\\\\\\hline\\text{twist unimodular} & \\mathrm{True}\\\\\\hline\\text{coefficients of t1, t2 commute} & \\mathrm{True}\\\\\\hline\\text{t3 = z1 z2 z3 qdet} & \\mathrm{True}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
     "id": "d8bbedcd-1ef9-4b10-b87d-f8616c0c3783"
