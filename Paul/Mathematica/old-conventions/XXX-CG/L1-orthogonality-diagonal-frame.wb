  {
   "kind": 2,
   "value": "(* ---- 4. Norm relation <Psi_A|Psi_A> = kappa det N^{AA}/(c^ref_A Psi^ref_A), kappa fixed by <Omega|Omega> = 1, |Omega> = e_1.\n   Labels (a;b,c) are shifts of theta in units of h:\n   Psi^ref_B = Q_1(a)[Q_1(b) Q_2(c-1) - Q_2(b) Q_1(c-1)] at x_ref = (lambda2; 0, 0),\n   c^ref_A = Q^3(a)[Q^3(b) Q^2(c+1) - Q^2(b) Q^3(c+1)] at y_ref = (lambda2; lambda1, lambda1). ---- *)\nClearAll[OmegaO, iOmO, xRefO, yRefO, psiRefO, cRefO, sovNormO, kappaO, sovRatioO];\nOmegaO = UnitVector[dsO, 1];\n(* |Omega> is the highest-weight vector, alone in its weight sector, so it is one of the eigenstates *)\niOmO = First @ FirstPosition[statesO[[All, \"mu\"]], lamO];\n\nxRefO = {lamO[[2]], 0, 0};\nyRefO = {lamO[[2]], lamO[[1]], lamO[[1]]};\npsiRefO[B_] := With[{x = thO + xRefO hO},\n    QDO[B, 1, x[[1]]] (QDO[B, 1, x[[2]]] QDO[B, 2, x[[3]] - hO] - QDO[B, 2, x[[2]]] QDO[B, 1, x[[3]] - hO])];\ncRefO[A_] := With[{y = thO + yRefO hO},\n    QUO[A, 3, y[[1]]] (QUO[A, 3, y[[2]]] QUO[A, 2, y[[3]] + hO] - QUO[A, 2, y[[2]]] QUO[A, 3, y[[3]] + hO])];\n\nsovNormO = Table[detMatO[[A, A]] / (cRefO[A] psiRefO[A]), {A, Length[statesO]}];\nkappaO = 1 / sovNormO[[iOmO]];\nsovRatioO = kappaO sovNormO / Diagonal[ovMatO];\n\nColumn[{\n    Grid[\n        {\n            {\"x_ref | y_ref\", Row[{Row[xRefO, \",\"], \"  |  \", Row[yRefO, \",\"]}]},\n            {\"|Omega> is eigenstate iOmO (ket = e1)\", {iOmO, N[Max[Abs[statesO[[iOmO, \"ket\"]] - OmegaO]], 3]}},\n            {\"<Omega|Omega> from the eigenvectors\", N[ovMatO[[iOmO, iOmO]], 10]},\n            {\"kappa = c^ref Psi^ref / det N at Omega\", N[kappaO, 10]},\n            {\"max |kappa det N/(c^ref Psi^ref) / <Psi|Psi> - 1| over states\", N[Max[Abs[sovRatioO - 1]], 3]}\n        },\n        Frame -> All, Alignment -> Left\n    ],\n    Grid[\n        Prepend[\n            Table[{A, Row[statesO[[A, \"mu\"]], \",\"], N[ovMatO[[A, A]], 10], N[kappaO sovNormO[[A]], 10], N[sovRatioO[[A]], 10]}, {A, Length[statesO]}],\n            {\"A\", \"weight μ\", \"<Psi_A|Psi_A>\", \"kappa det N/(c^ref Psi^ref)\", \"ratio\"}\n        ],\n        Frame -> All, Alignment -> Left\n    ]\n}]",
   "languageId": "wolfram",
   "outputs": [
