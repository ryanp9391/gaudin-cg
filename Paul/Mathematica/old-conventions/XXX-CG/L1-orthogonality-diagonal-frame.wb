       "data": "Out[1195]= \\begin{array}{|c|c|}\\hline\\text{rep $\\Lambda$[1]} & 2,1,0\\\\\\hline\\text{\\# states} & 8\\\\\\hline\\text{tG[1..3] polynomial in u} & \\mathrm{True}\\\\\\hline\\text{min relative eigenvalue gap of the mixed matrix} & 0.00123\\\\\\hline\\text{max eigen residual (kets and bras, t1..t3)} & 0.\\times 10^{-95}\\\\\\hline\\text{max weight residual} & 0.\\,\\\\\\hline\\end{array}",
