  {
   "kind": 2,
   "value": "(* ---- 3. det N^{AB} (3x3 det of Q's) vs the eigenvector overlaps <Psi_A|Psi_B>. ---- *)\nClearAll[polesO, wO, rowO, detNO, detMatO, ovMatO, offRatioO];\npolesO = Range[lamO[[3]], lamO[[1]]];\nwO[n_] := 1 / Times @@ (n - DeleteCases[polesO, n]);\nrowO[A_, B_, {i_, j_}] := Sum[\n    With[{x = thO + n hO}, wO[n] {-QUO[A, j, x] QDO[B, i, x], QUO[A, j, x] QDO[B, i, x - hO], QUO[A, j, x + hO] QDO[B, i, x]}],\n    {n, polesO}\n];\ndetNO[A_, B_] := Det[rowO[A, B, #] & /@ {{1, 3}, {1, 2}, {2, 3}}];\n\ndetMatO = Table[detNO[A, B], {A, Length[statesO]}, {B, Length[statesO]}];\novMatO = Table[statesO[[A, \"bra\"]] . statesO[[B, \"ket\"]], {A, Length[statesO]}, {B, Length[statesO]}];\noffRatioO[m_] := N[Max[Abs[m - DiagonalMatrix[Diagonal[m]]]] / Min[Abs[Diagonal[m]]], 3];\n\nColumn[{\n    Grid[\n        {\n            {\"det N orthogonality: max|offdiag| / min|diag|\", offRatioO[detMatO]},\n            {\"<Psi_A|Psi_B> orthogonality: max|offdiag| / min|diag|\", offRatioO[ovMatO]}\n        },\n        Frame -> All, Alignment -> Left\n    ],\n    Grid[\n        Prepend[\n            Table[{A, Row[statesO[[A, \"mu\"]], \",\"], N[ovMatO[[A, A]], 10], N[detMatO[[A, A]], 10]}, {A, Length[statesO]}],\n            {\"A\", \"weight μ\", \"<Psi_A|Psi_A>\", \"det N^{AA}\"}\n        ],\n        Frame -> All, Alignment -> Left\n    ]\n}]",
   "languageId": "wolfram",
   "outputs": [
