      {
       "data": "Out[1245]= \\begin{array}{|c|c|}\\hline\\text{rep} & 2,1,0\\\\\\hline\\text{Omega is an eigenvector of tG[1..3]} & \\mathrm{True}\\\\\\hline\\text{exact Baxter solutions exist} & \\mathrm{True}\\\\\\hline\\text{exact kappa vs numeric kappaO} & 0.\\times 10^{-92}\\\\\\hline\\text{kappa} & -\\frac{8}{\\left(z\\left(1\\right)-z\\left(2\\right)\\right)\\,\\left(z\\left(1\\right)-z\\left(3\\right)\\right)^2\\,\\left(z\\left(2\\right)-z\\left(3\\right)\\right)}\\\\\\hline\\end{array}",
       "mime": "text/plain"
      }
     ],
