      {
       "data": "Out[1214]= \\begin{matrix}\\begin{array}{|c|c|}\\hline\\text{det N orthogonality: max|offdiag| / min|diag|} & 3.43\\times 10^{-91}\\\\\\hline\\text{<Psi\\_A|Psi\\_B> orthogonality: max|offdiag| / min|diag|} & 0.\\times 10^{-95}\\\\\\hline\\end{array}\\\\\\begin{array}{|c|c|c|c|}\\hline\\text{A} & \\text{weight $\\mu$} & \\text{<Psi\\_A|Psi\\_A>} & \\text{det N\\^{}\\{AA\\}}\\\\\\hline1 & 2,0,1 & -0.07157464213 & 0.5027248795\\\\\\hline2 & 1,1,1 & 0.03574870050 & -196.5506862\\\\\\hline3 & 0,2,1 & -0.07157464213 & 76842.89302\\\\\\hline4 & 1,0,2 & -0.9284253579 & 5.384698561\\\\\\hline5 & 0,1,2 & 1.\\, & -1068.288348\\\\\\hline6 & 1,2,0 & -0.9284253579 & 16001.12828\\\\\\hline7 & 2,1,0 & 1.\\, & -82.06997826\\\\\\hline8 & 1,1,1 & 8.064686598 & -583.4750711\\\\\\hline\\end{array}\\end{matrix}",
