   "value": "(* ---- 5. Results per site rep. resultsO is deliberately NOT cleared: change Λ[1] in cell 2, re-run the notebook, and each rep adds its row. ---- *)\nIf[! AssociationQ[resultsO], resultsO = <||>];\nresultsO[lamO] = {\n    Length[statesO],\n    N[Max[Join[statesO[[All, \"eigRes\"]], QsO[[All, \"bRes\"]]]], 3],\n    offRatioO[detMatO],\n    N[Max[Abs[sovRatioO - 1]], 3]\n};\nGrid[\n    Prepend[KeyValueMap[Prepend[#2, Row[#1, \",\"]] &, resultsO],\n        {\"rep\", \"# states\", \"max eigen/Baxter residual\", \"det N offdiag/diag\", \"max |norm relation - 1|\"}],\n    Frame -> All, Alignment -> Left\n]",
   "languageId": "wolfram",
