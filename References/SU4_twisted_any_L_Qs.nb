                    RowBox[{"f", "[", "u_", "]"}], "->", 
                    RowBox[{"qs", "[", 
                    RowBox[{"[", "r", "]"}], "]"}]}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"r", ",", "4"}], "}"}]}], "]"}], ",", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   FractionBox[
                    RowBox[{
                    RowBox[{"dualBax", "[", 
                    RowBox[{"L", ",", 
                    RowBox[{"{", 
                    RowBox[{"M", ",", "S", ",", "Nn"}], "}"}]}], "]"}], "[", 
                    "f", "]"}], 
                    RowBox[{
                    SuperscriptBox[
                    SubscriptBox["z", 
                    RowBox[{"5", "-", "r"}]], 
                    RowBox[{
                    RowBox[{"-", "u"}], "/", "h"}]], 
                    RowBox[{"u", "^", 
                    RowBox[{"(", 
                    RowBox[{"exps", "[", 
