                   RowBox[{"r", ",", "2"}], "}"}]}], "]"}]}], "]"}], "//", 
              "ExpandAll"}], "//", "Together"}], "//", "Numerator"}], ",", 
           "u"}], "]"}], "==", "0"}], ",", "vars", ",", "WP"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
