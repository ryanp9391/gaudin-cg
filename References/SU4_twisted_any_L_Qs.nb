 RowBox[{
  RowBox[{"ClearAll", "[", "solveQs", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solveQs", "[", 
   RowBox[{"L_", ",", 
    RowBox[{"{", 
     RowBox[{"M_", ",", "S_", ",", "Nn_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"exps", ",", "qs", ",", "vars", ",", "qds", ",", "qsolns"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"exps", "=", 
      RowBox[{"{", 
       RowBox[{"M", ",", 
        RowBox[{"S", "-", "M"}], ",", 
        RowBox[{"L", "+", "Nn", "-", "S"}], ",", 
        RowBox[{"L", "-", "Nn"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expds", "=", 
      RowBox[{"{", 
       RowBox[{"Nn", ",", 
        RowBox[{"S", "-", "Nn"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          SubscriptBox["z", "i"], 
          RowBox[{"u", "/", "h"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "^", 
            RowBox[{"exps", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "+", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"c", "[", "k", "]"}], "[", "i", "]"}], 
              RowBox[{"u", "^", "k"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "0", ",", 
               RowBox[{
                RowBox[{"exps", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", "1"}]}], "}"}]}], 
            "]"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "4"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
